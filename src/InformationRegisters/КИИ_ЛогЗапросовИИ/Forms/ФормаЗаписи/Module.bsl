#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущаяЗапись, ПараметрыЗаписи)

	Перем ТекстСообщения;

	Отказ = Истина;
	ТекстСообщения = НСтр("ru = 'Журнал запросов доступен для просмотра. Изменение записи не выполняется.'");
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СвязанныеЗапросы(Команда)

	Перем ТекстСообщения;
	Перем ПараметрыВызова;

	Если ПустаяСтрока(Запись.КорреляцияАгента) Тогда
		ТекстСообщения = НСтр(
			"ru = 'У запроса нет идентификатора общей операции. Связанные вызовы определить нельзя.'");
		ПоказатьПредупреждение(, ТекстСообщения);
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыВызова = Новый Структура("КорреляцияАгента", Запись.КорреляцияАгента);
	ПараметрыФормы.Вставить("Отбор", ПараметрыВызова);
	ОткрытьФорму(
		"РегистрСведений.КИИ_ЛогЗапросовИИ.Форма.ФормаСписка",
		ПараметрыФормы,
		ЭтотОбъект,
		Истина, , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

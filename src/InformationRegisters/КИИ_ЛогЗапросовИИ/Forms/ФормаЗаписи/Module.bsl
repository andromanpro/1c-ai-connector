#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущаяЗапись, ПараметрыЗаписи)

	Отказ = Истина;
	ОбщегоНазначения.СообщитьПользователю(НСтр(
		"ru = 'Журнал запросов доступен для просмотра. Изменение записи не выполняется.'"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СвязанныеЗапросы(Команда)

	Если ПустаяСтрока(Запись.КорреляцияАгента) Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'У запроса нет идентификатора общей операции. Связанные вызовы определить нельзя.'"));
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Новый Структура("КорреляцияАгента", Запись.КорреляцияАгента));
	ОткрытьФорму("РегистрСведений.КИИ_ЛогЗапросовИИ.Форма.ФормаСписка", ПараметрыФормы, ЭтотОбъект,
		Истина, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

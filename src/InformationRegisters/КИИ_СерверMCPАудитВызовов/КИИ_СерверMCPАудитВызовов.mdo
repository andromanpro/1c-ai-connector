    <name>Метод</name>
    <synonym>
      <key>ru</key>
      <value>MCP метод</value>
    </synonym>
    <comment>Имя MCP-метода (tools/list, tools/call, ...).</comment>
    <type>
      <types>String</types>
      <stringQualifiers>
        <length>50</length>
      </stringQualifiers>
    </type>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fillValue xsi:type="core:StringValue"/>

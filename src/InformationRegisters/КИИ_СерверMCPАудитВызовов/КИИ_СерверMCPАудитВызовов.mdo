    <synonym>
      <key>ru</key>
      <value>Хеш параметров</value>
    </synonym>
    <comment>SHA-256 от каноничного JSON параметров (без secrets).</comment>
    <type>
      <types>String</types>
      <stringQualifiers>
        <length>64</length>
        <fixed>true</fixed>
      </stringQualifiers>
    </type>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>

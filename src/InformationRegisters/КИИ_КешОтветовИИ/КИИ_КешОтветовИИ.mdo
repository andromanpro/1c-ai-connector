<?xml version="1.0" encoding="UTF-8"?>
<mdclass:InformationRegister xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="4037f25b-3de1-4c9a-b434-75b91941a2de">
  <producedTypes>
    <selectionType typeId="514f999f-c12b-4c6a-87f3-339938ae71f0" valueTypeId="c6adaa85-f3cf-4b80-a846-1307309e579f"/>
    <listType typeId="7100226a-e51f-4cb8-b277-bfd38e4e86c0" valueTypeId="ee5f81bc-9c08-430a-ba6b-f1da535f960e"/>
    <managerType typeId="6b5bf819-76d6-4793-a3a2-5e5d11900067" valueTypeId="b42b1948-5ce1-45b6-992d-04024903e191"/>
    <recordSetType typeId="86fc182d-6b3b-4def-91c7-f644ac50bc50" valueTypeId="0b8d065a-8d9f-4e33-9f1e-1fa1a179d156"/>
    <recordKeyType typeId="a7cb68bb-b5db-4ea6-86c1-28492ff44043" valueTypeId="d127479d-9a4c-4489-aaac-be40d2787ef7"/>

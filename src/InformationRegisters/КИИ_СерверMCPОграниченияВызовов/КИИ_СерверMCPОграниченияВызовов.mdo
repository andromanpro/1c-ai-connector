<?xml version="1.0" encoding="UTF-8"?>
<mdclass:InformationRegister xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="7c55a7ea-76bc-463a-8724-784205fbcbb5">
  <producedTypes>
    <selectionType typeId="d6e08990-4700-44af-88bc-36e93b4008a2" valueTypeId="0b05eab1-b397-450e-b75f-9bd2187f00bc"/>

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

// Показывает в панели анализа разбор ИИ, сохраненный в активной записи журнала.
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	Данные = Элементы.Список.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		РезультатАнализа = "";
		Возврат;
	КонецЕсли;

	РезультатАнализа = Данные.ОписаниеОтИИ;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Глубокий инструментальный анализ выбранной записи журнала (агент с MCP-инструментами).
&НаКлиенте
Процедура ГлубокийАнализ(Команда)

	Данные = Элементы.Список.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Выберите запись для анализа'"));
		Возврат;
	КонецЕсли;

	РезультатАнализа = ГлубокийАнализНаСервере(Данные.ХешОшибки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ГлубокийАнализНаСервере(Знач ХешОшибки)

	Возврат КИИ_МониторингОшибокАнализ.ВыполнитьГлубокийАнализОшибки(ХешОшибки).Текст;

КонецФункции

#КонецОбласти

// Аудитор кода - тонкий клиент к внешнему rlm-шиму (D3).
// Механика анализа кода вынесена во внешний сервис (rlm-tools-bsl через REST-шим):
// 1С отправляет координату из стека ошибки и получает метод с телом и графом вызовов.
// Ум (диагноз) ставит LLM через КИИ_КоннекторИИ (gateway ИИконы), отчет сохраняется внутри 1С.

#Область ПрограммныйИнтерфейс

// Анализирует место ошибки по координате из стека (имя модуля и номер строки).
// Отправляет запрос внешнему rlm-шиму и возвращает найденный метод с телом и вызовами.
//
// Параметры:
//  ИмяМодуля - Строка - имя модуля из стека, например "КИИ_HTTPКлиент"
//  НомерСтроки - Число - номер строки из стека
//  АдресШима - Строка - базовый URL rlm-шима; пусто - берется адрес по умолчанию
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - десериализованный ответ шима:
//   * Ключ - Строка - ok, module, method или error.
//   * Значение - Произвольный - значение JSON: ok - Булево, module/error - Строка,
//                 method - Соответствие с name, line_range, is_export, loc, body, callers, callers_count.
//  При недоступности шима ok = Ложь, error содержит причину.
//
Функция ПроанализироватьМестоОшибки(ИмяМодуля, НомерСтроки, АдресШима = "") Экспорт

	Перем РезультатФункции;

	Если Не ЗначениеЗаполнено(АдресШима) Тогда
		АдресШима = АдресШимаПоУмолчанию();
	КонецЕсли;

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("module", ИмяМодуля);
	ТелоЗапроса.Вставить("line", НомерСтроки);

	// Прокси = Неопределено: шим локальный (127.0.0.1), идем напрямую, минуя прокси ИИконы.
	Результат = КИИ_HTTPКлиент.ВыполнитьЗапрос("POST", АдресШима + "/audit", ТелоЗапроса, , 30, Неопределено);

	Если Не Результат.Успешно Тогда
		Ответ = Новый Соответствие;
		Ответ.Вставить("ok", Ложь);
		Ответ.Вставить("error", "Шим недоступен, код состояния: " + Результат.КодСостояния);
		Возврат Ответ;
	КонецЕсли;

	РезультатФункции = КИИ_HTTPКлиент.JsonВСтруктуру(Результат.Тело);
	Возврат РезультатФункции;

КонецФункции

// Ставит диагноз по ошибке: получает код места ошибки от rlm-шима и отправляет
// его вместе с текстом ошибки в модель ИИ через коннектор. Инструменты не нужны -
// контекст кода уже получен от rlm.
//
// Параметры:
//  ТекстОшибки - Строка - текст ошибки (из стека или журнала регистрации)
//  ИмяМодуля - Строка - имя модуля из стека
//  НомерСтроки - Число - номер строки из стека
//  Модель - СправочникСсылка.КИИ_МоделиИИ - модель ИИ; Неопределено - берется из настроек мониторинга
//
// Возвращаемое значение:
//  Структура:
//   * ЭтоОшибка - Булево - не удалось получить диагноз
//   * Диагноз - Строка - текст диагноза от модели
//   * ТекстОшибки - Строка - причина, если ЭтоОшибка = Истина
//
Функция ДиагностироватьОшибку(ТекстОшибки, ИмяМодуля, НомерСтроки, Знач Модель = Неопределено) Экспорт

	Перем РезультатСистемныйПромптДиагноза;

	Итог = Новый Структура("ЭтоОшибка, Диагноз, ТекстОшибки", Истина, "", "");

	Если Модель = Неопределено Тогда
		Настройки = КИИ_МониторингОшибок.ПолучитьНастройкиМониторинга();
		Модель = Настройки.МодельДляАнализа;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Модель) Тогда
		Итог.ТекстОшибки = НСтр("ru = 'Модель для анализа не настроена'");
		Возврат Итог;
	КонецЕсли;

	Контекст = ПроанализироватьМестоОшибки(ИмяМодуля, НомерСтроки);

	Промпт = Новый Структура;
	РезультатСистемныйПромптДиагноза = СистемныйПромптДиагноза();
	Промпт.Вставить("СистемныйПромпт", РезультатСистемныйПромптДиагноза);
	КонтекстДляПромпта = ФорматироватьКонтекстДляПромпта(Контекст, ИмяМодуля, НомерСтроки);
	ТекстПромпта = СтрШаблон(
		НСтр("ru = 'Текст ошибки:
			|%1
			|
			|%2'"),
		ТекстОшибки, КонтекстДляПромпта);
	Промпт.Вставить("ПользовательскийПромпт", ТекстПромпта);

	// Ум только через коннектор ИИконы (gateway), не мимо него.
	Ответ = КИИ_КоннекторИИ.ЗапросКМодели(Модель, Промпт);
	Если Ответ.ЭтоОшибка Тогда
		Итог.ТекстОшибки = Ответ.ТекстОшибки;
		Возврат Итог;
	КонецЕсли;

	Итог.ЭтоОшибка = Ложь;
	Итог.Диагноз = Ответ.ТекстОтвета;
	Возврат Итог;

КонецФункции

// Диагностирует ошибку из журнала мониторинга по её хешу и сохраняет диагноз обратно
// в журнал (поле ОписаниеОтИИ). Замыкает цикл: ошибка внутри 1С -> код от rlm -> диагноз -> внутрь 1С.
//
// Параметры:
//  ХешОшибки - Строка - хеш записи регистра КИИ_МониторингОшибокЖурнал
//  Модель - СправочникСсылка.КИИ_МоделиИИ - модель ИИ; Неопределено - из настроек мониторинга
//
// Возвращаемое значение:
//  Структура:
//   * ЭтоОшибка - Булево - диагноз не получен
//   * Диагноз - Строка - текст диагноза
//   * ТекстОшибки - Строка - причина отказа
//   * Сохранено - Булево - диагноз записан в журнал
//
Функция ДиагностироватьИСохранить(ХешОшибки, Знач Модель = Неопределено) Экспорт

	Перем РезультатЗапроса;

	Итог = Новый Структура;
	Итог.Вставить("ЭтоОшибка", Истина);
	Итог.Вставить("Диагноз", "");
	Итог.Вставить("ТекстОшибки", "");
	Итог.Вставить("Сохранено", Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Журнал.ТекстОшибки КАК ТекстОшибки
		|ИЗ
		|	РегистрСведений.КИИ_МониторингОшибокЖурнал КАК Журнал
		|ГДЕ
		|	Журнал.ХешОшибки = &ХешОшибки";
	Запрос.УстановитьПараметр("ХешОшибки", ХешОшибки);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Не Выборка.Следующий() Тогда
		Итог.ТекстОшибки = НСтр("ru = 'Запись журнала по хешу не найдена'");
		Возврат Итог;
	КонецЕсли;

	Координата = ИзвлечьКоординатуИзСтека(Выборка.ТекстОшибки);
	Если Координата = Неопределено Тогда
		Итог.ТекстОшибки = НСтр("ru = 'В тексте ошибки нет координаты модуль:строка - аудитор кода неприменим'");
		Возврат Итог;
	КонецЕсли;

	Результат = ДиагностироватьОшибку(Выборка.ТекстОшибки, Координата.Модуль, Координата.Строка, Модель);
	Итог.ЭтоОшибка = Результат.ЭтоОшибка;
	Итог.Диагноз = Результат.Диагноз;
	Итог.ТекстОшибки = Результат.ТекстОшибки;

	Если Не Результат.ЭтоОшибка Тогда
		СохранитьДиагнозВЖурнал(ХешОшибки, Результат.Диагноз);
		Итог.Сохранено = Истина;
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Автономный анализ новых ошибок с координатой в стеке (для регламентного задания).
// Берет новые ошибки журнала, для тех, где стек содержит координату модуль:строка,
// ставит диагноз через аудитор кода, сохраняет в журнал и отправляет в Telegram.
// Ошибки без координаты не трогает - их разбирает обычный пакетный анализ.
//
// Параметры:
//  МаксимумОшибок - Число - предел ошибок на один запуск
//  Модель - СправочникСсылка.КИИ_МоделиИИ - модель ИИ; Неопределено - из настроек мониторинга
//
// Возвращаемое значение:
//  Число - количество проанализированных ошибок
//
Функция АвтоанализНовыхОшибок(МаксимумОшибок = 10, Знач Модель = Неопределено) Экспорт

	Перем РезультатЗапроса;

	Перем РезультатФункции;

	Настройки = КИИ_МониторингОшибок.ПолучитьНастройкиМониторинга();
	Если Модель = Неопределено Тогда
		Модель = Настройки.МодельДляАнализа;
	КонецЕсли;

	// ПЕРВЫЕ требует числовой литерал (параметр недопустим) - подставляем число в текст.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(МаксимумОшибок, "ЧГ=0") + "
		|	Журнал.ХешОшибки            КАК ХешОшибки,
		|	Журнал.ТекстОшибки          КАК ТекстОшибки,
		|	Журнал.Событие              КАК Событие,
		|	Журнал.Пользователь         КАК Пользователь,
		|	Журнал.Компьютер            КАК Компьютер,
		|	Журнал.ПерваяДатаВремя       КАК ПерваяДатаВремя,
		|	Журнал.КоличествоПовторений  КАК КоличествоПовторений
		|ИЗ
		|	РегистрСведений.КИИ_МониторингОшибокЖурнал КАК Журнал
		|ГДЕ
		|	Журнал.ТребуетАнализа = ИСТИНА
		|	И Журнал.Игнорировать = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Журнал.ПерваяДатаВремя";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	МассивРезультатов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Координата = ИзвлечьКоординатуИзСтека(Выборка.ТекстОшибки);
		Если Координата = Неопределено Тогда
			Продолжить; // нет координаты - оставляем обычному пакетному анализу
		КонецЕсли;

		Результат = ДиагностироватьОшибку(Выборка.ТекстОшибки, Координата.Модуль, Координата.Строка, Модель);
		Если Результат.ЭтоОшибка Тогда
			Продолжить;
		КонецЕсли;

		СохранитьДиагнозВЖурнал(Выборка.ХешОшибки, Результат.Диагноз);

		ДанныеОшибки = Новый Структура;
		ДанныеОшибки.Вставить("ХешОшибки", Выборка.ХешОшибки);
		ДанныеОшибки.Вставить("ТекстОшибки", Выборка.ТекстОшибки);
		ДанныеОшибки.Вставить("Событие", Выборка.Событие);
		ДанныеОшибки.Вставить("Пользователь", Выборка.Пользователь);
		ДанныеОшибки.Вставить("Компьютер", Выборка.Компьютер);
		ДанныеОшибки.Вставить("ПерваяДатаВремя", Выборка.ПерваяДатаВремя);
		ДанныеОшибки.Вставить("КоличествоПовторений", Выборка.КоличествоПовторений);
		РезультатАнализа = Новый Структура(
			"ДанныеОшибки, Критичность, Описание",
			ДанныеОшибки,
			Перечисления.КИИ_УровниКритичности.Средняя,
			Результат.Диагноз);
		МассивРезультатов.Добавить(РезультатАнализа);
	КонецЦикла;

	Если МассивРезультатов.Количество() > 0 Тогда
		КИИ_МониторингОшибокTelegram.ОтправитьРезультатыВТелеграм(Настройки, МассивРезультатов);
	КонецЕсли;

	РезультатФункции = МассивРезультатов.Количество();
	Возврат РезультатФункции;

КонецФункции

// Точка входа регламентного задания КИИ_АудиторКодаАвтоанализ.
// Регламент вызывает процедуру без параметров; логика - в АвтоанализНовыхОшибок.
//
Процедура ВыполнитьАвтоанализ() Экспорт

	АвтоанализНовыхОшибок();

КонецПроцедуры

// Проверяет доступность rlm-шима через эндпоинт health.
//
// Параметры:
//  АдресШима - Строка - базовый URL rlm-шима; пусто - берется адрес по умолчанию
//
// Возвращаемое значение:
//  Булево - Истина, если шим ответил успешно
//
Функция ШимДоступен(АдресШима = "") Экспорт

	Если Не ЗначениеЗаполнено(АдресШима) Тогда
		АдресШима = АдресШимаПоУмолчанию();
	КонецЕсли;

	Результат = КИИ_HTTPКлиент.ВыполнитьЗапрос("GET", АдресШима + "/health", , , 10, Неопределено);
	Возврат Результат.Успешно;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Адрес rlm-шима по умолчанию.
// MVP: локальный порт 9001. В дальнейшем вынести в константу настройки аудитора.
//
// Возвращаемое значение:
//  Строка - базовый URL шима без завершающего слеша
//
Функция АдресШимаПоУмолчанию()

	Перем РезультатФункции;

	Хост = Константы.КИИ_АдресХостаШимаАудитора.Получить();
	Если Не ЗначениеЗаполнено(Хост) Тогда
		Хост = ХостШимаПоТипуБазы();
	КонецЕсли;
	Порт = Константы.КИИ_ПортШимаАудитора.Получить();
	Если Не ЗначениеЗаполнено(Порт) Или Порт = 0 Тогда
		Порт = 9001;
	КонецЕсли;
	РезультатФункции = "http://" + Хост + ":" + Формат(Порт, "ЧГ=0");
	Возврат РезультатФункции;

КонецФункции

// Хост шима по типу базы: файловая - локально (127.0.0.1);
// серверная - хост сервера кластера 1С (где rphost, там же логично держать шим).
//
// Возвращаемое значение:
//  Строка - хост шима
//
// Осмысленный дефолт, а не конфигурационная ошибка: шим аудитора живет рядом с базой,
// 127.0.0.1 - фолбэк, переопределяется константой КИИ_АдресХостаШимаАудитора.
// BSLLS:UsingHardcodeNetworkAddress-off
Функция ХостШимаПоТипуБазы()

	Перем РезультатФункции;

	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		Возврат "127.0.0.1";
	КонецЕсли;

	ХостСервера = ИзвлечьХостСервераБазы();
	РезультатФункции = ?(ЗначениеЗаполнено(ХостСервера), ХостСервера, "127.0.0.1");
	Возврат РезультатФункции;
	// BSLLS:UsingHardcodeNetworkAddress-on

КонецФункции

// Извлекает хост сервера 1С из строки соединения серверной базы (Srvr="хост:порт").
// Берет первый сервер списка, отбрасывает порт кластера.
//
// Возвращаемое значение:
//  Строка - хост сервера 1С; пусто, если не серверная или не распознано
//
Функция ИзвлечьХостСервераБазы()

	Перем РезультатСократитьДвойныеКавычки;

	Перем РезультатСтрокаСоединенияИнформационнойБазы;

	Перем РезультатФункции;

	РезультатСтрокаСоединенияИнформационнойБазы = СтрокаСоединенияИнформационнойБазы();
	Параметры = СтроковыеФункцииКлиентСервер.ПараметрыИзСтроки(РезультатСтрокаСоединенияИнформационнойБазы);
	Если Не Параметры.Свойство("Srvr") Тогда
		Возврат "";
	КонецЕсли;

	РезультатСократитьДвойныеКавычки = СтроковыеФункцииКлиентСервер.СократитьДвойныеКавычки(Параметры.Srvr);
	ПерваяЧасть = СтрРазделить(РезультатСократитьДвойныеКавычки, ",")[0];
	ХостИПорт = СтрРазделить(ПерваяЧасть, ":");
	РезультатФункции = СокрЛП(ХостИПорт[0]);
	Возврат РезультатФункции;

КонецФункции

// Извлекает координату места ошибки (имя модуля и номер строки) из первого кадра
// стека вида "{[Расширение ]ОбщийМодуль.ИмяМодуля.Модуль(НомерСтроки)}".
//
// Параметры:
//  ТекстСтека - Строка - текст ошибки со стеком вызовов
//
// Возвращаемое значение:
//  Неопределено - координата не найдена.
//  Структура - координата первого кадра стека:
//   * Модуль - Строка - имя общего модуля.
//   * Строка - Число - номер строки.
//
Функция ИзвлечьКоординатуИзСтека(ТекстСтека)

	Перем ДлинаТекста;
	Перем НачалоТекста;
	Перем РезультатФункции;

	Маркер = "ОбщийМодуль.";
	Поз = СтрНайти(ТекстСтека, Маркер);
	Если Поз = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДлинаТекста = СтрДлина(Маркер);
	Хвост = Сред(ТекстСтека, Поз + ДлинаТекста);
	ПозРазделитель = СтрНайти(Хвост, ".Модуль(");
	Если ПозРазделитель = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяМодуля = Лев(Хвост, ПозРазделитель - 1);
	ДлинаТекста = СтрДлина(".Модуль(");
	Остаток = Сред(Хвост, ПозРазделитель + ДлинаТекста);
	ПозСкобка = СтрНайти(Остаток, ")");
	Если ПозСкобка = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	НачалоТекста = Лев(Остаток, ПозСкобка - 1);
	НомерСтроки = КИИ_HTTPКлиент.ПолучитьЧислоБезопасно(НачалоТекста, 0);
	Если НомерСтроки = 0 Или Не ЗначениеЗаполнено(ИмяМодуля) Тогда
		Возврат Неопределено;
	КонецЕсли;

	РезультатФункции = Новый Структура("Модуль, Строка", ИмяМодуля, НомерСтроки);
	Возврат РезультатФункции;

КонецФункции

// Сохраняет диагноз аудитора в запись журнала мониторинга и снимает флаг ТребуетАнализа,
// чтобы обычный пакетный анализ не разбирал эту ошибку повторно.
//
// Параметры:
//  ХешОшибки - Строка - хеш записи регистра КИИ_МониторингОшибокЖурнал
//  Диагноз - Строка - текст диагноза от аудитора
//
Процедура СохранитьДиагнозВЖурнал(ХешОшибки, Диагноз)

	ПоляОбновления = Новый Структура;
	ПоляОбновления.Вставить("ТребуетАнализа",     Ложь);
	ПоляОбновления.Вставить("ПроанализированаИИ", Истина);
	ПоляОбновления.Вставить("ОшибкаАнализаИИ",    Ложь);
	ПоляОбновления.Вставить("ОписаниеОтИИ",       Диагноз);
	КИИ_МониторингОшибокРегистры.ОбновитьЗаписьРегистраОшибки(ХешОшибки, ПоляОбновления);

КонецПроцедуры

// Оформляет контекст кода от шима в текст для промпта модели.
//
// Параметры:
//  Контекст - См. ПроанализироватьМестоОшибки
//  ИмяМодуля - Строка - имя модуля (для сообщения при отсутствии кода)
//  НомерСтроки - Число - номер строки
//
// Возвращаемое значение:
//  Строка - текст с кодом метода и списком вызывающих
//
Функция ФорматироватьКонтекстДляПромпта(Контекст, ИмяМодуля, НомерСтроки)

	Перем КонтекстНеПодходитДляПромпта;
	Перем ПризнакУспехаКонтекста;
	Перем РезультатФункции;
	Перем МетодЗначение;
	Перем ВызовЗначение;

	КонтекстНеПодходитДляПромпта = Контекст = Неопределено;
	Если Не КонтекстНеПодходитДляПромпта Тогда
		ПризнакУспехаКонтекста = Контекст.Получить("ok");
		КонтекстНеПодходитДляПромпта = Не КИИ_HTTPКлиент.ПолучитьБулевоБезопасно(ПризнакУспехаКонтекста);
	КонецЕсли;
	Если КонтекстНеПодходитДляПромпта Тогда
		РезультатФункции = СтрШаблон(
			НСтр("ru = 'Код места ошибки недоступен (модуль %1, строка %2).'"), ИмяМодуля, НомерСтроки);
		Возврат РезультатФункции;
	КонецЕсли;

	Метод = Контекст.Получить("method");
	Если Метод = Неопределено Тогда
		РезультатФункции = СтрШаблон(
			НСтр("ru = 'Метод по координате не найден (модуль %1, строка %2).'"), ИмяМодуля, НомерСтроки);
		Возврат РезультатФункции;
	КонецЕсли;

	МетодЗначение = Метод.Получить("name");
	ИмяМетода = КИИ_HTTPКлиент.ПолучитьСтрокуБезопасно(МетодЗначение);
	МетодЗначение = Метод.Получить("body");
	Тело = КИИ_HTTPКлиент.ПолучитьСтрокуБезопасно(МетодЗначение);

	СтрокиВызовов = Новый Массив;
	Вызовы = Метод.Получить("callers");
	Если ТипЗнч(Вызовы) = Тип("Массив") Тогда
		Для Каждого Вызов Из Вызовы Цикл
			ВызовЗначение = Вызов.Получить("file");
			Файл = КИИ_HTTPКлиент.ПолучитьСтрокуБезопасно(ВызовЗначение);
			ВызовЗначение = Вызов.Получить("line");
			НомерВызова = КИИ_HTTPКлиент.ПолучитьЧислоБезопасно(ВызовЗначение);
			ТекстВызова = СтрШаблон(НСтр("ru = '- %1:%2%3'"), Файл, НомерВызова, Символы.ПС);
			СтрокиВызовов.Добавить(ТекстВызова);
		КонецЦикла;
	КонецЕсли;

	ТекстВызовов = СтрСоединить(СтрокиВызовов, "");
	ОписаниеВызовов = ?(ПустаяСтрока(ТекстВызовов), НСтр("ru = '(нет данных)'"), ТекстВызовов);
	РезультатФункции = СтрШаблон(
			НСтр("ru = 'Код места ошибки (%1):
				|%2
				|
				|Вызывается из:
				|%3'"),
			ИмяМетода, Тело, ОписаниеВызовов);
	Возврат РезультатФункции;

КонецФункции

// Системный промпт для диагноза ошибки.
//
// Возвращаемое значение:
//  Строка - системная инструкция модели
//
Функция СистемныйПромптДиагноза()

	Перем РезультатФункции;

	РезультатФункции = НСтр("ru = 'Ты эксперт по 1С:Предприятие. По тексту ошибки и коду места ошибки
			|определи вероятную причину и предложи конкретное исправление.
			|Отвечай кратко и по делу, на русском языке.'");
	Возврат РезультатФункции;

КонецФункции

#КонецОбласти

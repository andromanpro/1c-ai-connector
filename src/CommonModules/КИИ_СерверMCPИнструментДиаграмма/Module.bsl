#Область ПрограммныйИнтерфейс

// Декларация инструмента generate_diagram для container-pattern.
// Вызывается из КИИ_СерверMCPРеестр.ПолучитьРеестрИнструментов() через рефлексию.
//
// Параметры:
//  Таблица - ТаблицаЗначений - реестр инструментов (см. КИИ_СерверMCPРеестр):
//   * Имя - Строка - имя инструмента
//   * Описание - Строка - человекочитаемое описание
//   * Схема - Структура - JSON-схема аргументов инструмента
//
Процедура ДобавитьИнструменты(Таблица) Экспорт

	Свойства = Новый Структура;
	ОписаниеСвойства = Новый Структура("type, description", "string",
		"Diagram kind: graphviz | plantuml | mermaid | c4plantuml | erd | и другие виды kroki");
	Свойства.Вставить("kind", ОписаниеСвойства);
	ОписаниеСвойства = Новый Структура("type, description", "string",
		"Исходный код диаграммы на языке выбранного вида");
	Свойства.Вставить("code", ОписаниеСвойства);
	ОписаниеСвойства = Новый Структура("type, description", "string",
		"Формат вывода: svg (по умолчанию, текст в ответе) или png (base64 в ответе)");
	Свойства.Вставить("format", ОписаниеСвойства);

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	МассивОбязательных = Новый Массив;
	МассивОбязательных.Добавить("kind");
	МассивОбязательных.Добавить("code");
	Схема.Вставить("required", МассивОбязательных);
	Схема.Вставить("additionalProperties", Ложь);

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Имя = "generate_diagram";
	НоваяСтрока.Описание = НСтр(
		"ru = 'Рендерит диаграмму через kroki (graphviz, plantuml, mermaid и др.). Вход: kind + code.
		|Возвращает svg-текст (или png в base64). Используй для визуализации схем конфигурации и связей.'");
	НоваяСтрока.Схема = Схема;

КонецПроцедуры

// Выполнение инструмента generate_diagram: рендер кода диаграммы через генератор (Kroki).
// Данные базы НЕ читает - безопасен без дополнительных разрешений.
//
// Параметры:
//  ИмяИнструмента - Строка - всегда "generate_diagram" в этом ОМ.
//  Аргументы      - Структура - {kind, code, format}.
//
// Возвращаемое значение:
//  Структура:
//   * success - Булево - рендер выполнен.
//   * kind    - Строка - вид диаграммы.
//   * format  - Строка - фактический формат вывода.
//   * svg     - Строка - SVG-текст (для format=svg при успехе).
//   * png_base64 - Строка - PNG в base64 (для format=png при успехе).
//   * error   - Строка - текст ошибки рендера (при success=Ложь).
//
Функция ВыполнитьИнструмент(Знач ИмяИнструмента, Знач Аргументы) Экспорт

	Если ИмяИнструмента <> "generate_diagram" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Неподдерживаемый инструмент %1 для модуля КИИ_СерверMCPИнструментДиаграмма'"),
			ИмяИнструмента);
	КонецЕсли;

	ВидДиаграммы = "";
	КодДиаграммы = "";
	Формат = "svg";
	Аргументы.Свойство("kind", ВидДиаграммы);
	Аргументы.Свойство("code", КодДиаграммы);
	Аргументы.Свойство("format", Формат);

	Если ПустаяСтрока(ВидДиаграммы) Или ПустаяСтрока(КодДиаграммы) Тогда
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(
			НСтр("ru = 'Параметры kind и code обязательны для generate_diagram.'"));
	КонецЕсли;
	Если Формат <> "svg" И Формат <> "png" Тогда
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(
			НСтр("ru = 'Параметр format поддерживает только svg или png.'"));
	КонецЕсли;

	Генератор = Обработки.КИИ_ГенераторДиаграмм.Создать();
	ПараметрыРендеринга = Генератор.НовыеПараметрыРендеринга();
	ПараметрыРендеринга.Формат = Формат;

	Итог = Генератор.РендеритьЧерезKroki(КодДиаграммы, ВидДиаграммы, ПараметрыРендеринга);

	Результат = Новый Структура;
	Результат.Вставить("success", Итог.Успех);
	Результат.Вставить("kind", ВидДиаграммы);
	Результат.Вставить("format", Формат);

	Если Не Итог.Успех Тогда
		Результат.Вставить("error", Итог.ТекстОшибки);
		Возврат Результат;
	КонецЕсли;

	Если Формат = "svg" Тогда
		Результат.Вставить("svg", Итог.SVGТекст);
	Иначе
		Результат.Вставить("png_base64", Base64Строка(Итог.ДвоичныеДанные));
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет наличие блока error в JSON-ответе провайдера и заполняет ЭтоОшибка/ТекстОшибки.
// Вызывается до диспетчеризации по ТипФорматаAPI - общая для всех провайдеров.
//
// Параметры:
//  ОтветJSON - Структура, Соответствие из КлючИЗначение - распарсенный JSON-ответ:
//   * Ключ - Строка - имя поля JSON
//   * Значение - Произвольный - значение поля
//  Результат - Структура - выходной параметр (см. КИИ_КоннекторИИ.НовыйПараметрыОтветаИИ)
//
// Возвращаемое значение:
//  Булево - Истина, если ответ содержит ошибку (диспетчер должен прервать обработку)
//
Функция ЕстьОшибкаВОтветеAPI(ОтветJSON, Результат) Экспорт

	Если ТипЗнч(ОтветJSON) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ОтветJSON.Свойство("error") Тогда
		Возврат Ложь;
	КонецЕсли;

	Результат.ЭтоОшибка = Истина;

	Если ТипЗнч(ОтветJSON.error) = Тип("Структура") 
		И ОтветJSON.error.Свойство("message") Тогда
		Результат.ТекстОшибки = ОтветJSON.error.message;
	Иначе
		Результат.ТекстОшибки = Строка(ОтветJSON.error);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Проверка типа значения на Структуру.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСтруктура(Знач Значение) Экспорт

	Перем РезультатФункции;
	РезультатФункции = ТипЗнч(Значение) = Тип("Структура");
	Возврат РезультатФункции;
КонецФункции

// Проверка типа значения на Массив.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоМассив(Знач Значение) Экспорт

	Перем РезультатФункции;
	РезультатФункции = ТипЗнч(Значение) = Тип("Массив");
	Возврат РезультатФункции;
КонецФункции

// Приводит пользовательский промпт к строке для провайдеров без приема вложений (Yandex text)
// и для промптов без вложений у Anthropic и Google. Массив (мультимодальный формат) → конкатенация
// его text-элементов; строку возвращает как есть. Сырой 1С-Массив ушел бы в JSON
// сериализованным массивом → малформед-запрос (аудит P1). Массив с вложениями
// (см. ЕстьВложения) Anthropic, Google и GigaChat разбирают сами.
//
// Параметры:
//  ПользовательскийПромпт - Строка, Массив из Структура, Произвольный - промпт пользователя
//
// Возвращаемое значение:
//  Строка, Произвольный - текст (для Массива) либо исходное значение
//
Функция ТекстПользовательскогоПромпта(Знач ПользовательскийПромпт) Экспорт

	Перем ПредставлениеЗначения;
	Перем РезультатФункции;

	Если ТипЗнч(ПользовательскийПромпт) <> Тип("Массив") Тогда
		Возврат ПользовательскийПромпт;
	КонецЕсли;

	ЧастиТекста = Новый Массив;
	Для Каждого Элемент Из ПользовательскийПромпт Цикл
		ЭтоТекстовыйЭлемент = ТипЗнч(Элемент) = Тип("Структура")
			И Элемент.Свойство("Тип")
			И Элемент.Тип = "text"
			И Элемент.Свойство("Текст");
		Если ЭтоТекстовыйЭлемент Тогда
			ПредставлениеЗначения = Строка(Элемент.Текст);
			ЧастиТекста.Добавить(ПредставлениеЗначения);
		КонецЕсли;
	КонецЦикла;

	РезультатФункции = СтрСоединить(ЧастиТекста, Символы.ПС);
	Возврат РезультатФункции;

КонецФункции

// Сериализует значение (Структура/Соответствие/Массив/примитив) в строку JSON.
// Используется коннекторами для унификации аргументов вызовов инструментов: контракт
// петли агент-анализа хранит аргументы СТРОКОЙ (как OpenAI), а Gemini/Yandex/GigaChat
// отдают и принимают их объектом.
//
// Параметры:
//  Значение - Произвольный - сериализуемое значение.
//
// Возвращаемое значение:
//  Строка - JSON-представление значения.
//
Функция ЗначениеВСтрокуJSON(Знач Значение) Экспорт

	Перем РезультатФункции;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	РезультатФункции = Запись.Закрыть();
	Возврат РезультатФункции;

КонецФункции

// Читает JSON средствами платформы без зависимости от версии JSON-функций БСП.
// Невалидный JSON вызывает исключение; ошибка не подменяется пустым объектом.
//
// Параметры:
//  СтрокаJSON - Строка - JSON-представление значения.
//  ПрочитатьВСоответствие - Булево - Истина для Соответствия, Ложь для Структуры.
//
// Возвращаемое значение:
//  Произвольный - значение JSON; даты остаются строками.
//
Функция ЗначениеИзСтрокиJSON(Знач СтрокаJSON, Знач ПрочитатьВСоответствие = Истина) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(Чтение, ПрочитатьВСоответствие);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Разбирает строку JSON аргументов вызова инструмента в значение для тела запроса.
// Пустая или битая строка дает пустое Соответствие: провайдеры ждут объект аргументов,
// и пустой объект для них валиден, а исключение сорвало бы весь раунд петли.
//
// Параметры:
//  СтрокаJSON - Строка - JSON-текст аргументов.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - разобранное значение (ключи могут быть не-идентификаторами).
//
Функция СтрокаJSONВЗначение(Знач СтрокаJSON) Экспорт

	Перем РезультатФункции;

	Если Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		РезультатФункции = Новый Соответствие;
		Возврат РезультатФункции;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СтрокаJSON);
		Значение = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		РезультатФункции = Новый Соответствие;
		Возврат РезультатФункции;
	КонецПопытки;

	// Аргументы вызова инструмента обязаны быть ОБЪЕКТОМ: провайдеры кладут их в input /
	// args / arguments, где массив, null или примитив дали бы 400 от API вместо ответа
	// модели. Валидный, но не-объектный JSON приравниваем к пустым аргументам (fail-soft).
	Если ТипЗнч(Значение) <> Тип("Соответствие") И ТипЗнч(Значение) <> Тип("Структура") Тогда
		РезультатФункции = Новый Соответствие;
		Возврат РезультатФункции;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Признак вложений в пользовательском промпте: массив контента с элементом image или document.
// Массив из одних текстовых элементов вложений не содержит: коннекторы отдают его строкой,
// как до появления вложений (контракт закреплен тестами ядра).
//
// Параметры:
//  ПользовательскийПромпт - Строка, Массив из Структура - промпт пользователя.
//
// Возвращаемое значение:
//  Булево - Истина, если в массиве есть изображение или документ.
//
Функция ЕстьВложения(Знач ПользовательскийПромпт) Экспорт

	Если ТипЗнч(ПользовательскийПромпт) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Элемент Из ПользовательскийПромпт Цикл
		ЭтоВложение = Ложь;
		Если ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство("Тип") Тогда
			ЭтоВложение = Элемент.Тип = "image" Или Элемент.Тип = "document";
		КонецЕсли;
		Если ЭтоВложение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет, что значение является внутренним массивом контента фасада.
// Массивы готовых частей API с полем type не меняются.
//
// Параметры:
//  Контент - Произвольный - содержимое сообщения.
//
// Возвращаемое значение:
//  Булево - все элементы непустого массива являются структурами с полем Тип.
//
Функция ЭтоМассивКонтентаПромпта(Знач Контент) Экспорт
	Если ТипЗнч(Контент) <> Тип("Массив") Или Контент.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Часть Из Контент Цикл
		Если ТипЗнч(Часть) <> Тип("Структура") Или Не Часть.Свойство("Тип") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Адрес изображения из элемента контента: заполненная строка URL (внешняя ссылка или data-URI).
// Критерий тот же, что у валидатора фасада: нестроковое значение URL адресом не считается,
// и элемент с пригодной парой ДвоичныеДанные + MIME уходит данными. Этим же адресом ключ кеша
// выбирает источник картинки, иначе кеш и запрос разошлись бы на элементе с URL и данными сразу.
//
// Параметры:
//  ЭлементКонтента - Структура - элемент image фасада.
//
// Возвращаемое значение:
//  Строка - адрес изображения; пустая строка, если адреса нет.
//
Функция АдресИзображения(Знач ЭлементКонтента) Экспорт

	URL = "";
	Если ЭлементКонтента.Свойство("URL", URL) И ТипЗнч(URL) = Тип("Строка") И ЗначениеЗаполнено(URL) Тогда
		Возврат URL;
	КонецЕсли;

	Возврат "";

КонецФункции

// Кодирует двоичные данные в Base64 одной строкой. Base64Строка платформы разбивает результат
// переводами строк каждые 76 символов, а JSON-поля провайдеров ждут сплошную строку.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - кодируемое содержимое.
//
// Возвращаемое значение:
//  Строка - Base64 без переводов строк.
//
Функция Base64БезПереводовСтрок(Знач ДвоичныеДанные) Экспорт

	Перем РезультатФункции;

	Результат = Base64Строка(ДвоичныеДанные);
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	РезультатФункции = СтрЗаменить(Результат, Символы.ВК, "");
	Возврат РезультатФункции;

КонецФункции

// Приводит MIME-тип к виду для сравнения со списками форматов провайдера: нижний регистр,
// без пробелов и параметров, распространенный псевдоним image/jpg заменяется на image/jpeg.
// Фасад принимает MIME без учета регистра, поэтому коннекторы сверяют только нормализованное значение.
//
// Параметры:
//  MIME - Строка, Неопределено - исходный MIME-тип.
//
// Возвращаемое значение:
//  Строка - нормализованный MIME-тип; пустая строка, если значение не строка.
//
Функция НормализованныйMIME(Знач MIME) Экспорт

	Перем ЗначениеБезПробелов;
	Перем РезультатФункции;

	Если ТипЗнч(MIME) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	ПозицияПараметров = СтрНайти(MIME, ";");
	Если ПозицияПараметров > 0 Тогда
		MIME = Лев(MIME, ПозицияПараметров - 1);
	КонецЕсли;

	ЗначениеБезПробелов = СокрЛП(MIME);
	MIME = НРег(ЗначениеБезПробелов);
	РезультатФункции = ?(MIME = "image/jpg", "image/jpeg", MIME);
	Возврат РезультатФункции;

КонецФункции

// Разбирает data-URI с содержимым в Base64 (data:image/png;base64,...). Контракт элемента
// изображения допускает data-URI в поле URL, а провайдеры без приема ссылок ждут MIME-тип
// и данные отдельно.
//
// Параметры:
//  URL - Строка - ссылка из элемента контента.
//
// Возвращаемое значение:
//  Неопределено, Структура - Неопределено, если строка не data-URI в Base64:
//   * MIME   - Строка - нормализованный MIME-тип.
//   * Base64 - Строка - содержимое в Base64 без переводов строк.
//
Функция РазобратьDataURI(Знач URL) Экспорт

	Перем ФактическийТипURL;
	Перем ОжидаемыйТипURL;
	Перем URLНеСодержитДанные;
	Перем ПрефиксДанныхURL;
	Перем ПрефиксДанныхВНижнемРегистре;
	Перем РезультатНормализованныйMIME;
	Перем ДлинаТекста3;
	Перем ФрагментТекста;
	Перем ДлинаТекста;
	Перем ДлинаТекста2;

	ФактическийТипURL = ТипЗнч(URL);
	ОжидаемыйТипURL = Тип("Строка");
	URLНеСодержитДанные = ФактическийТипURL <> ОжидаемыйТипURL;
	Если Не URLНеСодержитДанные Тогда
		ПрефиксДанныхURL = Лев(URL, 5);
		ПрефиксДанныхВНижнемРегистре = НРег(ПрефиксДанныхURL);
		URLНеСодержитДанные = ПрефиксДанныхВНижнемРегистре <> "data:";
	КонецЕсли;
	Если URLНеСодержитДанные Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозицияЗапятой = СтрНайти(URL, ",");
	Если ПозицияЗапятой = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ФрагментТекста = Сред(URL, 6, ПозицияЗапятой - 6);
	ОписаниеДанных = НРег(ФрагментТекста);
	ПризнакBase64 = ";base64";
	ДлинаТекста3 = СтрДлина(ПризнакBase64);
	Если Прав(ОписаниеДанных, ДлинаТекста3) <> ПризнакBase64 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ФрагментТекста = Сред(URL, ПозицияЗапятой + 1);
	ДанныеBase64 = СокрЛП(ФрагментТекста);
	ДанныеBase64 = СтрЗаменить(ДанныеBase64, Символы.ПС, "");
	ДанныеBase64 = СтрЗаменить(ДанныеBase64, Символы.ВК, "");
	Если СтрНайти(ДанныеBase64, "%") > 0 Тогда
		// data-URI допускает URL-кодирование (RFC 2397): любой символ может прийти как %HH.
		ДанныеBase64 = РаскодироватьПроцентнуюЗапись(ДанныеBase64);
	КонецЕсли;

	ДлинаТекста = СтрДлина(ОписаниеДанных);
	ДлинаТекста2 = СтрДлина(ПризнакBase64);
	ТипДанных = Лев(ОписаниеДанных, ДлинаТекста - ДлинаТекста2);
	Результат = Новый Структура;
	РезультатНормализованныйMIME = НормализованныйMIME(ТипДанных);
	Результат.Вставить("MIME", РезультатНормализованныйMIME);
	Результат.Вставить("Base64", ДанныеBase64);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Раскодирует последовательности %HH (RFC 3986) в символы. Base64 состоит из символов ASCII, поэтому
// многобайтовые последовательности не нужны; «+» остается плюсом (это не кодирование HTML-форм).
// Знак % без двух шестнадцатеричных цифр за ним остается как есть.
Функция РаскодироватьПроцентнуюЗапись(Знач Текст)

	Перем НачалоТекста;
	Перем ФрагментТекста;
	Перем ЗначениеВНижнемРегистре;
	Перем СимволТекста;
	Перем РезультатФункции;

	ШестнадцатеричныеЦифры = "0123456789abcdef";
	Части = Новый Массив;
	Позиция = СтрНайти(Текст, "%");
	Пока Позиция > 0 Цикл
		НачалоТекста = Лев(Текст, Позиция - 1);
		Части.Добавить(НачалоТекста);
		Старшая = 0;
		Младшая = 0;
		Если СтрДлина(Текст) >= Позиция + 2 Тогда
			ФрагментТекста = Сред(Текст, Позиция + 1, 1);
			ЗначениеВНижнемРегистре = НРег(ФрагментТекста);
			Старшая = СтрНайти(ШестнадцатеричныеЦифры, ЗначениеВНижнемРегистре);
			ФрагментТекста = Сред(Текст, Позиция + 2, 1);
			ЗначениеВНижнемРегистре = НРег(ФрагментТекста);
			Младшая = СтрНайти(ШестнадцатеричныеЦифры, ЗначениеВНижнемРегистре);
		КонецЕсли;
		Если Старшая > 0 И Младшая > 0 Тогда
			СимволТекста = Символ((Старшая - 1) * 16 + Младшая - 1);
			Части.Добавить(СимволТекста);
			Текст = Сред(Текст, Позиция + 3);
		Иначе
			Части.Добавить("%");
			Текст = Сред(Текст, Позиция + 1);
		КонецЕсли;
		Позиция = СтрНайти(Текст, "%");
	КонецЦикла;
	Части.Добавить(Текст);

	РезультатФункции = СтрСоединить(Части);
	Возврат РезультатФункции;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет наличие блока error в JSON-ответе провайдера и заполняет ЭтоОшибка/ТекстОшибки.
// Вызывается до диспетчеризации по ТипФорматаAPI - общая для всех провайдеров.
//
// Параметры:
//  ОтветJSON - Структура, Соответствие из КлючИЗначение - распарсенный JSON-ответ:
//   * Ключ - Строка - имя поля JSON
//   * Значение - Произвольный - значение поля
//  Результат - Структура - выходной параметр (см. КИИ_КоннекторИИ.НовыйПараметрыОтветаИИ)
//
// Возвращаемое значение:
//  Булево - Истина, если ответ содержит ошибку (диспетчер должен прервать обработку)
//
Функция ЕстьОшибкаВОтветеAPI(ОтветJSON, Результат) Экспорт

	Если ТипЗнч(ОтветJSON) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ОтветJSON.Свойство("error") Тогда
		Возврат Ложь;
	КонецЕсли;

	Результат.ЭтоОшибка = Истина;

	Если ТипЗнч(ОтветJSON.error) = Тип("Структура") 
		И ОтветJSON.error.Свойство("message") Тогда
		Результат.ТекстОшибки = ОтветJSON.error.message;
	Иначе
		Результат.ТекстОшибки = Строка(ОтветJSON.error);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Проверка типа значения на Структуру.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСтруктура(Знач Значение) Экспорт
	Возврат ТипЗнч(Значение) = Тип("Структура");
КонецФункции

// Проверка типа значения на Массив.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоМассив(Знач Значение) Экспорт
	Возврат ТипЗнч(Значение) = Тип("Массив");
КонецФункции

// Приводит пользовательский промпт к строке для провайдеров без структурного текстового
// контента (Anthropic content / Google parts.text / Yandex text). Массив (мультимодальный
// формат) → конкатенация его text-элементов; строку возвращает как есть. Эти провайдеры для
// НЕмультимодальных форматов ждут строку, а сырой 1С-Массив ушел бы как сериализованный
// массив → малформед-запрос (аудит P1).
//
// Параметры:
//  ПользовательскийПромпт - Строка, Массив из Структура, Произвольный - промпт пользователя
//
// Возвращаемое значение:
//  Строка, Произвольный - текст (для Массива) либо исходное значение
//
Функция ТекстПользовательскогоПромпта(Знач ПользовательскийПромпт) Экспорт

	Если ТипЗнч(ПользовательскийПромпт) <> Тип("Массив") Тогда
		Возврат ПользовательскийПромпт;
	КонецЕсли;

	ЧастиТекста = Новый Массив;
	Для Каждого Элемент Из ПользовательскийПромпт Цикл
		ЭтоТекстовыйЭлемент = ТипЗнч(Элемент) = Тип("Структура")
			И Элемент.Свойство("Тип") И Элемент.Тип = "text"
			И Элемент.Свойство("Текст");
		Если ЭтоТекстовыйЭлемент Тогда
			ЧастиТекста.Добавить(Строка(Элемент.Текст));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(ЧастиТекста, Символы.ПС);

КонецФункции

// Сериализует значение (Структура/Соответствие/Массив/примитив) в строку JSON.
// Используется коннекторами для унификации аргументов вызовов инструментов: контракт
// петли агент-анализа хранит аргументы СТРОКОЙ (как OpenAI), а Gemini/Yandex/GigaChat
// отдают и принимают их объектом.
//
// Параметры:
//  Значение - Произвольный - сериализуемое значение.
//
// Возвращаемое значение:
//  Строка - JSON-представление значения.
//
Функция ЗначениеВСтрокуJSON(Знач Значение) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

// Разбирает строку JSON аргументов вызова инструмента в значение для тела запроса.
// Пустая или битая строка дает пустое Соответствие: провайдеры ждут объект аргументов,
// и пустой объект для них валиден, а исключение сорвало бы весь раунд петли.
//
// Параметры:
//  СтрокаJSON - Строка - JSON-текст аргументов.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - разобранное значение (ключи могут быть не-идентификаторами).
//
Функция СтрокаJSONВЗначение(Знач СтрокаJSON) Экспорт

	Если Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СтрокаJSON);
		Значение = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Новый Соответствие;
	КонецПопытки;

	// Аргументы вызова инструмента обязаны быть ОБЪЕКТОМ: провайдеры кладут их в input /
	// args / arguments, где массив, null или примитив дали бы 400 от API вместо ответа
	// модели. Валидный, но не-объектный JSON приравниваем к пустым аргументам (fail-soft).
	Если ТипЗнч(Значение) <> Тип("Соответствие") И ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти

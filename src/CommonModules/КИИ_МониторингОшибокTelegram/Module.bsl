////////////////////////////////////////////////////////////////////////////////
// Общий модуль: КИИ_МониторингОшибокTelegram
// Назначение: Отправка уведомлений мониторинга ошибок в Telegram (индивидуально/дайджест)
//             и хранение токена/ChatID в безопасном хранилище.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет включение канала. Старые вызывающие модули без переключателя
// сохраняют прежнее поведение; явное Ложь отключает все автоматические отправки.
// Параметры:
//  Настройки - Структура - настройки мониторинга.
// Возвращаемое значение:
//  Булево - отправка включена и заданы токен и чат.
Функция ОтправкаВТелеграмВключена(Настройки) Экспорт

	Включено = Истина;
	Если Настройки.Свойство("ВключитьОтправкуВТелеграм") Тогда
		Включено = Настройки.ВключитьОтправкуВТелеграм;
		Если ТипЗнч(Включено) <> Тип("Булево") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Не Включено Тогда
		Возврат Ложь;
	КонецЕсли;
	Токен = "";
	Чат = "";
	Настройки.Свойство("ТокенБотаТелеграм", Токен);
	Настройки.Свойство("ChatIDТелеграм", Чат);
	Результат = ЗначениеЗаполнено(Токен) И ЗначениеЗаполнено(Чат);
	Возврат Результат;

КонецФункции

// Отправляет результаты анализа в Telegram: дайджестом (если включен и >1) или по одному.
// Параметры:
//  Настройки - Структура - настройки мониторинга (ТокенБотаТелеграм, ChatIDТелеграм, РежимДайджеста).
//  МассивРезультатов - Массив из Структура - результаты анализа ошибок (ДанныеОшибки, Критичность, Описание).
Процедура ОтправитьРезультатыВТелеграм(Настройки, МассивРезультатов) Экспорт

	Если Не ОтправкаВТелеграмВключена(Настройки) Тогда
		Возврат;
	КонецЕсли;

	ТокенТелеграм = Настройки.ТокенБотаТелеграм;
	ChatID = Настройки.ChatIDТелеграм;

	Если НЕ ЗначениеЗаполнено(ТокенТелеграм) ИЛИ НЕ ЗначениеЗаполнено(ChatID) Тогда
		Возврат;
	КонецЕсли;

	Если Настройки.РежимДайджеста И МассивРезультатов.Количество() > 1 Тогда
		ОтправитьДайджестВТелеграм(ТокенТелеграм, ChatID, МассивРезультатов);
	Иначе
		ОтправитьРезультатыПоОтдельностиВТелеграм(ТокенТелеграм, ChatID, МассивРезультатов);
	КонецЕсли;

КонецПроцедуры

// Отправляет одно текстовое сообщение в Telegram (с обрезкой до лимита). Возвращает Булево - успех.
// Параметры:
//  ТокенТелеграм - Строка - токен бота Telegram.
//  ChatID - Строка - идентификатор чата Telegram.
//  ТекстСообщения - Строка - текст сообщения (обрезается до лимита).
// Возвращаемое значение:
//  Булево - Истина, если сообщение отправлено успешно.
Функция ОтправитьСообщениеВТелеграм(ТокенТелеграм, ChatID, ТекстСообщения) Экспорт

	Если НЕ КИИ_TelegramУведомления.ПроверитьДлинуСообщения(ТекстСообщения) Тогда
		ТекстСообщения = КИИ_TelegramУведомления.ОбрезатьСообщениеДоЛимита(ТекстСообщения);
	КонецЕсли;

	Результат = КИИ_TelegramУведомления.ОтправитьТекстовоеСообщение(
		ТокенТелеграм, ChatID, ТекстСообщения);

	СообщениеОтправлено = Результат["ok"] = Истина;
	Возврат СообщениеОтправлено;

КонецФункции

// Конвертирует Markdown-описание модели в Telegram HTML с балансировкой тегов.
//
// Параметры:
//  Текст - Строка - описание в Markdown.
//
// Возвращаемое значение:
//  Строка - описание в Telegram HTML.
Функция ФорматироватьОписаниеHTML(Знач Текст) Экспорт

	БезопасныйТекст = ЗащититьHTML(Текст);
	СтрокиТекста = СтрРазделить(БезопасныйТекст, Символы.ПС);
	СтрокиРезультата = Новый Массив;
	ВБлокеКода = Ложь;
	Для Каждого СтрокаОписания Из СтрокиТекста Цикл
		СтрокаБезЛевыхПробелов = СокрЛ(СтрокаОписания);
		Если СтрНачинаетсяС(СтрокаБезЛевыхПробелов, "```") Тогда
			ТегБлокаКода = ?(ВБлокеКода, "</pre>", "<pre>");
			СтрокиРезультата.Добавить(ТегБлокаКода);
			ВБлокеКода = Не ВБлокеКода;
			Продолжить;
		КонецЕсли;
		Если Не ВБлокеКода Тогда
			СтрокаОписания = ЗаменитьПарныеМаркеры(СтрокаОписания, "**", "<b>", "</b>");
			СтрокаОписания = ЗаменитьПарныеМаркеры(СтрокаОписания, "`", "<code>", "</code>");
		КонецЕсли;
		СтрокиРезультата.Добавить(СтрокаОписания);
	КонецЦикла;
	Если ВБлокеКода Тогда
		СтрокиРезультата.Добавить("</pre>");
	КонецЕсли;
	Результат = СтрСоединить(СтрокиРезультата, Символы.ПС);
	Возврат Результат;

КонецФункции

// Собирает текст уведомления об ошибке в разметке Telegram HTML: заголовок с эмодзи по
// критичности, событие, счетчик повторений, текст ошибки и совет модели.
//
// Параметры:
//  ДанныеОшибки    - Структура, ВыборкаИзРезультатаЗапроса - поля записи журнала мониторинга
//                    (ТекстОшибки, Событие, КоличествоПовторений, Пользователь, Компьютер и пр.).
//  РезАнализа      - Структура:
//   * Критичность  - Строка - нормализованная критичность (определяет эмодзи).
//   * Описание     - Строка - совет модели (Markdown конвертируется в Telegram HTML).
//  ЭтоПовтор       - Булево - Истина для повторного уведомления (иной заголовок).
//  ОбрезатьОписание - Булево - Истина для дайджеста: описание урезается до лимита.
//
// Возвращаемое значение:
//  Строка - готовое к отправке сообщение (parse_mode=HTML).
//
Функция СформироватьСообщениеДляТелеграм(ДанныеОшибки, РезАнализа, ЭтоПовтор, ОбрезатьОписание = Ложь) Экспорт

	Значок = ПолучитьЭмодзиПоКритичности(РезАнализа.Критичность);
	Заголовок = СтрШаблон("%1 %2 Ошибка в 1С", Значок, РезАнализа.Критичность);
	Если ЭтоПовтор Тогда
		Заголовок = Заголовок + " ⟳ ПОВТОРНО";
	КонецЕсли;

	ТекстОшибки = ДанныеОшибки.ТекстОшибки;
	// Убрать хвост [Категория, ...] - внутренние категории ошибки, читателю шум.
	МаркерКатегорий = Символы.ПС + "[";
	ПозицияКатегорий = СтрНайти(ТекстОшибки, МаркерКатегорий);
	Если ПозицияКатегорий > 0 Тогда
		ТекстБезКатегорий = Лев(ТекстОшибки, ПозицияКатегорий - 1);
		ТекстОшибки = СокрП(ТекстБезКатегорий);
	КонецЕсли;
	Если СтрДлина(ТекстОшибки) > 500 Тогда
		СокращенныйТекстОшибки = Лев(ТекстОшибки, 300);
		ТекстОшибки = СокращенныйТекстОшибки + "...";
	КонецЕсли;

	Описание = РезАнализа.Описание;
	Если ОбрезатьОписание И СтрДлина(Описание) > 300 Тогда
		СокращенноеОписание = Лев(Описание, 297);
		Описание = СокращенноеОписание + "...";
	КонецЕсли;

	Строки = Новый Массив;
	БезопасныйЗаголовок = ЗащититьHTML(Заголовок);
	СтрокаЗаголовка = СтрШаблон("<b>%1</b>", БезопасныйЗаголовок);
	Строки.Добавить(СтрокаЗаголовка);
	Строки.Добавить("");
	ПредставлениеДаты = Формат(ДанныеОшибки.ПерваяДатаВремя, "ДЛФ=DT");
	СтрокаДаты = СтрШаблон("📅 %1", ПредставлениеДаты);
	Строки.Добавить(СтрокаДаты);
	БезопасныйТекстПользователя = ЗащититьHTML(ДанныеОшибки.Пользователь);
	СтрокаПользователя = СтрШаблон("👤 %1", БезопасныйТекстПользователя);
	Строки.Добавить(СтрокаПользователя);
	БезопасныйТекстКомпьютера = ЗащититьHTML(ДанныеОшибки.Компьютер);
	СтрокаКомпьютера = СтрШаблон("💻 %1", БезопасныйТекстКомпьютера);
	Строки.Добавить(СтрокаКомпьютера);
	БезопасныйТекстСобытия = ЗащититьHTML(ДанныеОшибки.Событие);
	СтрокаСобытия = СтрШаблон("📂 %1", БезопасныйТекстСобытия);
	Строки.Добавить(СтрокаСобытия);
	Строки.Добавить("");
	Строки.Добавить("🤖 <b>Анализ ИИ:</b>");
	ОписаниеHTML = ФорматироватьОписаниеHTML(Описание);
	Строки.Добавить(ОписаниеHTML);
	Строки.Добавить("");
	Строки.Добавить("📝 <b>Текст ошибки:</b>");
	БезопасныйТекстОшибки = ЗащититьHTML(ТекстОшибки);
	СтрокаТекстаОшибки = СтрШаблон("<code>%1</code>", БезопасныйТекстОшибки);
	Строки.Добавить(СтрокаТекстаОшибки);

	Если ЭтоПовтор Тогда
		Строки.Добавить("");
		СтрокаПовторов = СтрШаблон("🔄 Повторилась <b>%1</b> раз", ДанныеОшибки.КоличествоПовторений);
		Строки.Добавить(СтрокаПовторов);
	КонецЕсли;

	Результат = СтрСоединить(Строки, Символы.ПС);
	Возврат Результат;

КонецФункции

// Подсчет количеств по уровням критичности для дайджеста.
// Параметры:
//  МассивРезультатов - Массив из Структура - результаты анализа ошибок.
// Возвращаемое значение:
//  Структура - счетчики по уровням критичности:
//   * Критическая - Число - число критических ошибок.
//   * Высокая - Число - число высоких ошибок.
//   * Средняя - Число - число средних ошибок.
//   * Низкая - Число - число низких ошибок.
Функция ПодсчитатьКритичностиДляДайджеста(Знач МассивРезультатов) Экспорт

	Счетчики = Новый Структура("Критическая, Высокая, Средняя", 0, 0, 0);
	Счетчики.Вставить("Низкая", 0);
	Для Каждого Элемент Из МассивРезультатов Цикл
		ИмяКритичности = ИмяКритичностиДляСчетчика(Элемент.Критичность);
		Если Не ПустаяСтрока(ИмяКритичности) И Счетчики.Свойство(ИмяКритичности) Тогда
			Счетчики[ИмяКритичности] = Счетчики[ИмяКритичности] + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Счетчики;

КонецФункции

// Сохраняет токен Telegram в безопасное хранилище; пустое значение - удаляет ключ.
// Параметры:
//  Токен - Строка - токен бота Telegram (пустой - удалить ключ).
Процедура СохранитьТокенТелеграмВХранилище(Токен) Экспорт

	// Проверяем прикладное право до повышения режима и первой записи секрета.
	ВыполнитьПроверкуПравДоступа("Изменение", Метаданные.Константы.КИИ_МониторингОшибокНастройки);

	// Безопасное хранилище БСП пишется только в привилегированном режиме: без него запись под
	// ролью «КИИ полные права» падала, и настройка Telegram работала только у полного администратора.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Если Не ЗначениеЗаполнено(Токен) Тогда
			ВладелецХранилища = ВладелецБезопасногоХранилища();
			ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецХранилища, "ТокенТелеграм");
		Иначе
			ВладелецХранилища = ВладелецБезопасногоХранилища();
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
				ВладелецХранилища, Токен, "ТокенТелеграм");
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		СведенияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(СведенияОбОшибке);
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка сохранения токена Telegram: %1'"), ОписаниеОшибки);
		СобытиеЖурнала = НСтр("ru = 'КИИ.МониторингОшибок'");
		ЗаписьЖурналаРегистрации(
			СобытиеЖурнала, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Сохраняет ChatID Telegram в безопасное хранилище; пустое значение - удаляет ключ.
// Параметры:
//  ChatID - Строка - идентификатор чата Telegram (пустой - удалить ключ).
Процедура СохранитьChatIDТелеграмВХранилище(ChatID) Экспорт

	// Проверяем прикладное право до повышения режима и первой записи секрета.
	ВыполнитьПроверкуПравДоступа("Изменение", Метаданные.Константы.КИИ_МониторингОшибокНастройки);

	// Безопасное хранилище БСП пишется только в привилегированном режиме: без него запись под
	// ролью «КИИ полные права» падала, и настройка Telegram работала только у полного администратора.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Если Не ЗначениеЗаполнено(ChatID) Тогда
			ВладелецХранилища = ВладелецБезопасногоХранилища();
			ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецХранилища, "ChatIDТелеграм");
		Иначе
			ВладелецХранилища = ВладелецБезопасногоХранилища();
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
				ВладелецХранилища, ChatID, "ChatIDТелеграм");
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		СведенияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(СведенияОбОшибке);
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка сохранения ChatID Telegram: %1'"), ОписаниеОшибки);
		СобытиеЖурнала = НСтр("ru = 'КИИ.МониторингОшибок'");
		ЗаписьЖурналаРегистрации(
			СобытиеЖурнала, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Выполняет миграцию токенов Telegram из ХранилищаОбщихНастроек в БезопасноеХранилище.
// При первом чтении: если токены есть в настройках, но отсутствуют в безопасном хранилище,
// они переносятся. Значения в структуре настроек заменяются на данные из безопасного хранилища.
// Параметры:
//  Настройки - Структура - настройки мониторинга (ТокенБотаТелеграм, ChatIDТелеграм);
//              значения обновляются из хранилища.
Процедура ВыполнитьМиграциюТокеновТелеграм(Настройки) Экспорт

	// Проверяем прикладное право до повышения режима и первой записи секрета.
	ВыполнитьПроверкуПравДоступа("Изменение", Метаданные.Константы.КИИ_МониторингОшибокНастройки);

	ТокенИзХранилища = ПолучитьТокенТелеграмИзХранилища();
	ChatIDИзХранилища = ПолучитьChatIDТелеграмИзХранилища();

	Если ЗначениеЗаполнено(ТокенИзХранилища) Тогда
		Настройки.ТокенБотаТелеграм = ТокенИзХранилища;
	ИначеЕсли ЗначениеЗаполнено(Настройки.ТокенБотаТелеграм) Тогда
		СохранитьТокенТелеграмВХранилище(Настройки.ТокенБотаТелеграм);
	Иначе
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		СобытиеЖурнала = НСтр("ru = 'ИИКона.МониторингОшибок'", КодОсновногоЯзыка);
		ТекстДляЖурнала = НСтр("ru = 'Токен Telegram не задан - требуется настройка'");
		ЗаписьЖурналаРегистрации(
			СобытиеЖурнала, УровеньЖурналаРегистрации.Информация, , , ТекстДляЖурнала);
	КонецЕсли;

	Если ЗначениеЗаполнено(ChatIDИзХранилища) Тогда
		Настройки.ChatIDТелеграм = ChatIDИзХранилища;
	ИначеЕсли ЗначениеЗаполнено(Настройки.ChatIDТелеграм) Тогда
		СохранитьChatIDТелеграмВХранилище(Настройки.ChatIDТелеграм);
	Иначе
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		СобытиеЖурнала = НСтр("ru = 'ИИКона.МониторингОшибок'", КодОсновногоЯзыка);
		ТекстДляЖурнала = НСтр("ru = 'ChatID Telegram не задан - требуется настройка'");
		ЗаписьЖурналаРегистрации(
			СобытиеЖурнала, УровеньЖурналаРегистрации.Информация, , , ТекстДляЖурнала);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заменяет парные маркеры (** или `) на открывающий/закрывающий HTML-тег; висячий маркер закрывается.
Функция ЗаменитьПарныеМаркеры(Знач ТекстСтроки, Знач Маркер, Знач ОткрывающийТег, Знач ЗакрывающийТег)

	Результат = "";
	Открыто = Ложь;
	ДлинаМаркера = СтрДлина(Маркер);
	Позиция = 1;
	Пока Позиция <= СтрДлина(ТекстСтроки) Цикл
		Если Сред(ТекстСтроки, Позиция, ДлинаМаркера) = Маркер Тогда
			Результат = Результат + ?(Открыто, ЗакрывающийТег, ОткрывающийТег);
			Открыто = Не Открыто;
			Позиция = Позиция + ДлинаМаркера;
		Иначе
			СимволТекста = Сред(ТекстСтроки, Позиция, 1);
			Результат = Результат + СимволТекста;
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Если Открыто Тогда
		Результат = Результат + ЗакрывающийТег;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Отправить дайджест + критические ошибки отдельными сообщениями.
Процедура ОтправитьДайджестВТелеграм(Знач ТокенТелеграм, Знач ChatID, МассивРезультатов)

	ТекстДайджеста = СформироватьДайджестСообщение(МассивРезультатов);
	ДайджестОтправлен = ОтправитьСообщениеВТелеграм(ТокенТелеграм, ChatID, ТекстДайджеста);

	Если ДайджестОтправлен Тогда
		Для Каждого Элемент Из МассивРезультатов Цикл
			КИИ_МониторингОшибокРегистры.ОбновитьФлагОтправкиТелеграм(Элемент.ДанныеОшибки.ХешОшибки);
		КонецЦикла;

		// Критические ошибки - отдельным сообщением, ТОЛЬКО если дайджест доставлен: иначе тот же
		// недоступный канал дает лишние попытки и спам ошибок в ЖР (аудит P2).
		Для Каждого Элемент Из МассивРезультатов Цикл
			Если Элемент.Критичность = Перечисления.КИИ_УровниКритичности.Критическая Тогда
				ОтправитьКритическуюОшибкуВТелеграм(ТокенТелеграм, ChatID, Элемент);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Отправить каждую ошибку отдельным сообщением, обновив флаг отправки при успехе.
Процедура ОтправитьРезультатыПоОтдельностиВТелеграм(Знач ТокенТелеграм, Знач ChatID, МассивРезультатов)

	Для Каждого Элемент Из МассивРезультатов Цикл
		Отправлено = ОтправитьОдинРезультатВТелеграм(ТокенТелеграм, ChatID, Элемент);
		Если Отправлено Тогда
			КИИ_МониторингОшибокРегистры.ОбновитьФлагОтправкиТелеграм(Элемент.ДанныеОшибки.ХешОшибки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Отправить одно сообщение об ошибке в Телеграм.
Функция ОтправитьОдинРезультатВТелеграм(Знач ТокенТелеграм, Знач ChatID, Знач Элемент)

	РезультатАнализа = Новый Структура("Критичность, Описание", Элемент.Критичность, Элемент.Описание);
	ТекстСообщения = СформироватьСообщениеДляТелеграм(Элемент.ДанныеОшибки, РезультатАнализа, Ложь);
	Результат = ОтправитьСообщениеВТелеграм(ТокенТелеграм, ChatID, ТекстСообщения);
	Возврат Результат;

КонецФункции

// Отправить критическую ошибку отдельным сообщением (без обновления флага).
Процедура ОтправитьКритическуюОшибкуВТелеграм(Знач ТокенТелеграм, Знач ChatID, Знач Элемент)

	РезультатАнализа = Новый Структура("Критичность, Описание", Элемент.Критичность, Элемент.Описание);
	ТекстСообщения = СформироватьСообщениеДляТелеграм(Элемент.ДанныеОшибки, РезультатАнализа, Ложь);
	ОтправитьСообщениеВТелеграм(ТокенТелеграм, ChatID, ТекстСообщения);

КонецПроцедуры

Функция СформироватьДайджестСообщение(МассивРезультатов)

	Счетчики = ПодсчитатьКритичностиДляДайджеста(МассивРезультатов);

	Строки = Новый Массив;
	Строки.Добавить("<b>📊 Дайджест ошибок 1С</b>");
	Строки.Добавить("");
	КоличествоРезультатов = МассивРезультатов.Количество();
	СтрокаКоличества = СтрШаблон("📈 Обработано: <b>%1</b> ошибок", КоличествоРезультатов);
	Строки.Добавить(СтрокаКоличества);
	ДобавитьСтрокиСчетчиковДайджеста(Строки, Счетчики);
	ДобавитьСтрокиТопОшибокДайджеста(Строки, МассивРезультатов);

	Строки.Добавить("");
	Строки.Добавить("ℹ️ Подробности - в регистре КИИ_МониторингОшибокЖурнал");

	Результат = СтрСоединить(Строки, Символы.ПС);
	Возврат Результат;

КонецФункции

// Строковый ключ счетчика дайджеста по значению перечисления критичности.
// Ключи Структуры обязаны быть строками - перечисление напрямую давало краш.
Функция ИмяКритичностиДляСчетчика(Знач Критичность)

	Если Критичность = Перечисления.КИИ_УровниКритичности.Критическая Тогда
		Возврат "Критическая";
	ИначеЕсли Критичность = Перечисления.КИИ_УровниКритичности.Высокая Тогда
		Возврат "Высокая";
	ИначеЕсли Критичность = Перечисления.КИИ_УровниКритичности.Средняя Тогда
		Возврат "Средняя";
	ИначеЕсли Критичность = Перечисления.КИИ_УровниКритичности.Низкая Тогда
		Возврат "Низкая";
	Иначе
		// Пустая ссылка либо новое значение перечисления: счетчик по такой критичности
		// не ведем (пустой ключ вызывающий пропускает).
		Возврат "";
	КонецЕсли;

КонецФункции

// Добавить строки-счетчики в дайджест.
Процедура ДобавитьСтрокиСчетчиковДайджеста(Строки, Знач Счетчики)

	Если Счетчики.Критическая > 0 Тогда
		СтрокаСчетчика = СтрШаблон("🚨 Критических: <b>%1</b>", Счетчики.Критическая);
		Строки.Добавить(СтрокаСчетчика);
	КонецЕсли;
	Если Счетчики.Высокая > 0 Тогда
		СтрокаСчетчика = СтрШаблон("🔴 Высоких: <b>%1</b>", Счетчики.Высокая);
		Строки.Добавить(СтрокаСчетчика);
	КонецЕсли;
	Если Счетчики.Средняя > 0 Тогда
		СтрокаСчетчика = СтрШаблон("⚠️ Средних: <b>%1</b>", Счетчики.Средняя);
		Строки.Добавить(СтрокаСчетчика);
	КонецЕсли;
	Если Счетчики.Низкая > 0 Тогда
		СтрокаСчетчика = СтрШаблон("ℹ️ Низких: <b>%1</b>", Счетчики.Низкая);
		Строки.Добавить(СтрокаСчетчика);
	КонецЕсли;

КонецПроцедуры

// Добавить строки топ-3 ошибок в дайджест.
Процедура ДобавитьСтрокиТопОшибокДайджеста(Строки, Знач МассивРезультатов)

	ТопОшибки = ВыбратьТопОшибки(МассивРезультатов, 3);
	Если ТопОшибки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("<b>Топ ошибки:</b>");
	Для Номер = 0 По ТопОшибки.ВГраница() Цикл
		СтрокаОшибки = СформироватьСтрокуТопОшибки(Номер, ТопОшибки[Номер]);
		Строки.Добавить(СтрокаОшибки);
	КонецЦикла;

КонецПроцедуры

// Сформировать строку одной ошибки в топе.
Функция СформироватьСтрокуТопОшибки(Знач Номер, Знач Элемент)

	Значок = ПолучитьЭмодзиПоКритичности(Элемент.Критичность);
	Описание = Элемент.Описание;
	Если СтрДлина(Описание) > 100 Тогда
		СокращенноеОписание = Лев(Описание, 97);
		Описание = СокращенноеОписание + "...";
	КонецЕсли;
	Повторы = "";
	Если Элемент.ДанныеОшибки.КоличествоПовторений > 1 Тогда
		Повторы = СтрШаблон(" (×%1)", Элемент.ДанныеОшибки.КоличествоПовторений);
	КонецЕсли;
	ПозицияВТопе = Номер + 1;
	БезопасноеОписание = ЗащититьHTML(Описание);
	Результат = СтрШаблон("%1. %2 %3%4", ПозицияВТопе, Значок, БезопасноеОписание, Повторы);
	Возврат Результат;

КонецФункции

Функция ВыбратьТопОшибки(МассивРезультатов, МаксимумОшибок)

	Результат = Новый Массив;

	ПорядокКритичности = Новый Массив;
	ПорядокКритичности.Добавить(Перечисления.КИИ_УровниКритичности.Критическая);
	ПорядокКритичности.Добавить(Перечисления.КИИ_УровниКритичности.Высокая);
	ПорядокКритичности.Добавить(Перечисления.КИИ_УровниКритичности.Средняя);
	ПорядокКритичности.Добавить(Перечисления.КИИ_УровниКритичности.Низкая);

	Для Каждого ТекущаяКритичность Из ПорядокКритичности Цикл
		Для Каждого Элемент Из МассивРезультатов Цикл
			Если Элемент.Критичность = ТекущаяКритичность Тогда
				Результат.Добавить(Элемент);
				Если Результат.Количество() >= МаксимумОшибок Тогда
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьЭмодзиПоКритичности(Критичность)

	Таблица = Новый Соответствие;
	Таблица.Вставить(Перечисления.КИИ_УровниКритичности.Низкая,       "ℹ️");
	Таблица.Вставить(Перечисления.КИИ_УровниКритичности.Средняя,      "⚠️");
	Таблица.Вставить(Перечисления.КИИ_УровниКритичности.Высокая,      "🔴");
	Таблица.Вставить(Перечисления.КИИ_УровниКритичности.Критическая,  "🚨");

	Результат = Таблица[Критичность];
	Значок = ?(Результат = Неопределено, "⚠️", Результат);
	Возврат Значок;

КонецФункции

Функция ЗащититьHTML(Текст)

	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "&",  "&amp;");
	Результат = СтрЗаменить(Результат, "<",  "&lt;");
	Результат = СтрЗаменить(Результат, ">",  "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Возврат Результат;

КонецФункции

Функция ПолучитьТокенТелеграмИзХранилища()

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ВладелецХранилища = ВладелецБезопасногоХранилища();
		Результат = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			ВладелецХранилища, "ТокенТелеграм");
		Возврат Результат;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ПолучитьChatIDТелеграмИзХранилища()

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ВладелецХранилища = ВладелецБезопасногоХранилища();
		Результат = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			ВладелецХранилища, "ChatIDТелеграм");
		Возврат Результат;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ВладелецБезопасногоХранилища()

	Возврат "КИИ_МониторингОшибок";

КонецФункции

#КонецОбласти

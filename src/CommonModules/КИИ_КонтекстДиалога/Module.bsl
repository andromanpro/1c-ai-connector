#Область ПрограммныйИнтерфейс

// Возвращаемое значение:
//  Структура:
//   * ИспользоватьИсторию - Булево - включать предыдущие сообщения.
//   * ИспользоватьЗнания - Булево - разрешить подбор знаний эксперта.
//   * ИспользоватьВложения - Булево - включать отмеченные вложения.
//   * РазмерКонтекста - Число - количество сообщений; ноль означает всю историю.
Функция НастройкиПоУмолчанию() Экспорт
	СтруктураЗначений3 = Новый Структура;
	СтруктураЗначений3.Вставить("ИспользоватьИсторию", Истина);
	СтруктураЗначений3.Вставить("ИспользоватьЗнания", Истина);
	СтруктураЗначений3.Вставить("ИспользоватьВложения", Истина);
	СтруктураЗначений3.Вставить("РазмерКонтекста", 5);
	Возврат СтруктураЗначений3;
КонецФункции

// Нормализует старые пользовательские настройки, сохраняя прежние значения по умолчанию.
// Параметры:
//  Настройки - Структура, Неопределено - сохранённые значения.
// Возвращаемое значение:
//  См. НастройкиПоУмолчанию
Функция НормализоватьНастройки(Знач Настройки = Неопределено) Экспорт
	Итог = НастройкиПоУмолчанию();
	Если Настройки <> Неопределено Тогда
		Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
			ВызватьИсключение НСтр("ru = 'Настройки контекста должны быть структурой.'");
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Итог, Настройки);
	КонецЕсли;
	НеверныеФлажки = ТипЗнч(Итог.ИспользоватьИсторию) <> Тип("Булево")
		Или ТипЗнч(Итог.ИспользоватьЗнания) <> Тип("Булево")
		Или ТипЗнч(Итог.ИспользоватьВложения) <> Тип("Булево");
	Если НеверныеФлажки Или ТипЗнч(Итог.РазмерКонтекста) <> Тип("Число") Тогда
		ВызватьИсключение НСтр("ru = 'Неверный тип настройки контекста.'");
	КонецЕсли;
	Итог.РазмерКонтекста = Макс(0, Цел(Итог.РазмерКонтекста));
	Возврат Итог;
КонецФункции

// Собирает содержимое без обращения к моделям, знаниям и временным хранилищам.
// Параметры:
//  Данные - Структура:
//   * Вопрос - Строка - текущий вопрос.
//   * Инструкция - Строка - системная инструкция эксперта.
//   * Знания - Строка - предварительно подобранная справка.
//   * История - Массив из Структура - сообщения с полями Роль и Текст.
//   * Вложения - Массив из Структура - отмеченные элементы контента.
//   * ПоследнийВопросДобавлен - Булево - текущий вопрос уже находится в истории.
//  Настройки - Структура, Неопределено - настройки включения контекста.
// Возвращаемое значение:
//  Структура:
//   * СистемныйПромпт - Строка - инструкция и разрешённые знания.
//   * ПользовательскийПромпт - Строка, Массив из Структура - вопрос или контент с вложениями.
//   * ИсторияСообщений - Массив из Структура - выбранные предыдущие сообщения.
Функция СобратьПромпт(Знач Данные, Знач Настройки = Неопределено) Экспорт
	Настройки = НормализоватьНастройки(Настройки);
	Инструкция = Данные.Инструкция;
	Если Настройки.ИспользоватьЗнания Тогда
		Инструкция = Инструкция + Данные.Знания;
	КонецЕсли;
	Результат = Новый Структура(
		"СистемныйПромпт,ПользовательскийПромпт,ИсторияСообщений", Инструкция, Данные.Вопрос, Новый Массив);
	Если Настройки.ИспользоватьВложения И Данные.Вложения.Количество() > 0 Тогда
		Контент = Новый Массив;
		Если Не ПустаяСтрока(Данные.Вопрос) Тогда
			Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентТекст(Данные.Вопрос));
		КонецЕсли;
		Для Каждого Вложение Из Данные.Вложения Цикл
			Контент.Добавить(ОбщегоНазначения.СкопироватьРекурсивно(Вложение));
		КонецЦикла;
		Результат.ПользовательскийПромпт = Контент;
	КонецЕсли;
	Если Настройки.ИспользоватьИсторию Тогда
		Результат.ИсторияСообщений = ИсторияПромпта(Данные, Настройки.РазмерКонтекста);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Выполняет подготовку или отправку в фоновом задании. Секретный пакет остаётся в серверном хранилище.
// Параметры:
//  Данные - Структура - данные общего сборщика и Эксперт.
//  Параметры - Структура - Настройки, ИспользоватьИнструменты, Базы, Диалог, ВладелецФормы, АдресПодготовки.
//  Режим - Строка - Просмотр, Знания или Отправка.
// Возвращаемое значение:
//  Структура:
//   * Представление - Структура - обработанный предварительный просмотр.
//   * Ответ - Структура, Неопределено - ответ модели; до отправки Неопределено.
Функция ВыполнитьОперацию(Знач Данные, Знач Параметры, Знач Режим) Экспорт
	Если Режим <> "Просмотр" И Режим <> "Знания" И Режим <> "Отправка" Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестная операция контекста диалога.'");
	КонецЕсли;
	Модель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Эксперт, "Модель");
	Настройки = НормализоватьНастройки(Параметры.Настройки);
	КлючВхода = ОтпечатокВхода(Модель, Данные, Параметры);
	Среда = ОтпечатокСреды(Модель, Параметры);
	Пакет = СохраненныйПакетДиалога(Параметры, Режим, КлючВхода, Среда);
	Если Пакет = Неопределено Тогда
		Пакет = СоздатьПакетДиалога(Модель, Данные, Параметры, Режим, КлючВхода, Среда, Настройки);
	КонецЕсли;
	Если Режим = "Отправка" И Не Пакет.ЗнанияГотовы Тогда
		// Неполный предварительный просмотр не выдаём за снимок с уже подобранными знаниями.
		ПоместитьВоВременноеХранилище(Неопределено, Параметры.АдресПодготовки);
		Возврат ВыполнитьОперацию(Данные, Параметры, "Отправка");
	КонецЕсли;
	ПоместитьВоВременноеХранилище(Пакет, Параметры.АдресПодготовки);
	Итог = Новый Структура("Представление,Ответ", Пакет.Представление, Неопределено);
	Если Режим <> "Отправка" Тогда
		Возврат Итог;
	КонецЕсли;
	Если Не Пакет.Разрешено Тогда
		ВызватьИсключение Пакет.ТекстОтказа;
	КонецЕсли;
	Пакет.Отправлен = Истина;
	ПоместитьВоВременноеХранилище(Пакет, Параметры.АдресПодготовки);
	Если Параметры.ИспользоватьИнструменты Тогда
		Итог.Ответ = КИИ_КоннекторИИ.ЗапросКМоделиСИнструментами(Модель, Пакет.Промпт, Пакет.Контекст, Параметры.Базы);
	Иначе
		Итог.Ответ = КИИ_КоннекторИИ.ЗапросКМодели(Модель, Пакет.Промпт, Пакет.Контекст);
	КонецЕсли;
	Восстановление = КИИ_КонтрольПерсональныхДанных.ВосстановитьДляЧеловека(Итог.Ответ.ТекстОтвета, Пакет.Контекст);
	Итог.Ответ.Вставить("ТекстОтветаДляЧеловека", Восстановление.Текст);
	Итог.Ответ.Вставить("СтатусВосстановления", Восстановление.Статус);
	Итог.Ответ.Вставить("ДиалогЧата", Пакет.Диалог);
	Итог.Ответ.Вставить("ЗапросЧата", Пакет.Запрос);
	Возврат Итог;
КонецФункции

// Читает только собственные записи точно указанного диалога; старые записи не реконструирует.
// Параметры:
//  Диалог - Строка - идентификатор диалога.
// Возвращаемое значение:
//  ТаблицаЗначений - записи раундов с их исходными ключами и обработанным контекстом.
Функция ЖурналДиалога(Знач Диалог) Экспорт
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.КИИ_ЛогЗапросовИИ) Тогда
		ВызватьИсключение НСтр("ru = 'Нет права чтения журнала запросов к ИИ.'");
	КонецЕсли;
	Запрос = Новый Запрос;
	// Явный владелец обязателен и для администратора; RLS продолжает действовать.
	Запрос.Текст =
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |   Лог.УниверсальнаяДатаВМиллисекундах КАК УниверсальнаяДатаВМиллисекундах,
        |   Лог.Идентификатор КАК Идентификатор,
        |   Лог.ДатаЗапроса КАК ДатаЗапроса,
        |   Лог.ЗапросЧата КАК ЗапросЧата,
        |   Лог.РаундЧата КАК РаундЧата,
        |   Лог.Модель КАК Модель,
        |   Лог.ЭтоОшибка КАК ЭтоОшибка,
        |   Лог.ИзКеша КАК ИзКеша,
        |   Лог.ИнструментыРаунда КАК ИнструментыРаунда,
        |   Лог.ТекстОшибки КАК ТекстОшибки,
        |   Лог.ВремяОтветаСекунд КАК ВремяОтветаСекунд,
        |   Лог.ВсегоТокенов КАК ВсегоТокенов,
        |   Лог.СтоимостьОтвета КАК СтоимостьОтвета,
        |   Лог.ВалютаСтоимости КАК ВалютаСтоимости,
        |   Лог.ПользовательскийПромпт КАК ПользовательскийПромпт,
        |   Лог.СистемныйПромпт КАК СистемныйПромпт,
        |   Лог.ИсторияСообщенийJSON КАК ИсторияСообщенийJSON,
        |   Лог.ТекстОтвета КАК ТекстОтвета
        |ИЗ
        |   РегистрСведений.КИИ_ЛогЗапросовИИ КАК Лог
        |ГДЕ
        |   Лог.ДиалогЧата = &Диалог
        |   И Лог.ДиалогЧата <> """"
        |   И Лог.ПользовательИБ = &Пользователь
        |УПОРЯДОЧИТЬ ПО
        |   Лог.УниверсальнаяДатаВМиллисекундах, Лог.Идентификатор";
	Запрос.УстановитьПараметр("Диалог", Диалог);
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.КИИ_ПользовательЖурналаИИ);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйПредпросмотр()
	СтруктураЗначений2 = Новый Структура;
	СтруктураЗначений2.Вставить("Статус", "");
	СтруктураЗначений2.Вставить("Получатель", "");
	СтруктураЗначений2.Вставить("Инструкция", "");
	СтруктураЗначений2.Вставить("Вопрос", "");
	СтруктураЗначений2.Вставить("Знания", "");
	СтруктураЗначений2.Вставить("Сообщения", "");
	СтруктураЗначений2.Вставить("Инструменты", "");
	СтруктураЗначений2.Вставить("Вложения", "");
	СтруктураЗначений2.Вставить("Готово", Ложь);
	Возврат СтруктураЗначений2;
КонецФункции

Процедура ПроверитьВладельца(Знач Пакет, Знач Параметры)
	Если Пакет.Пользователь <> ПараметрыСеанса.КИИ_ПользовательЖурналаИИ
		Или Пакет.ВладелецФормы <> Строка(Параметры.ВладелецФормы)
		Или Пакет.Диалог <> Параметры.Диалог Тогда
		ВызватьИсключение НСтр("ru = 'Подготовленный контекст принадлежит другому диалогу.'");
	КонецЕсли;
КонецПроцедуры

Функция ОтпечатокВхода(Знач Модель, Знач Данные, Знач Параметры)
	// Знания формируются в фоне и хранятся в пакете; ключ относится к исходному выбору.
	Копия = ОбщегоНазначения.СкопироватьРекурсивно(Данные);
	Копия.Знания = "";
	Промпт = СобратьПромпт(Копия, Параметры.Настройки);
	СтруктураЗначений1 = Новый Структура;
	СтруктураЗначений1.Вставить("Модель", Модель);
	СтруктураЗначений1.Вставить("Эксперт", Данные.Эксперт);
	СтруктураЗначений1.Вставить("Промпт", Промпт);
	СтруктураЗначений1.Вставить("Настройки", НормализоватьНастройки(Параметры.Настройки));
	СтруктураЗначений1.Вставить("Инструменты", Параметры.ИспользоватьИнструменты);
	СтруктураЗначений1.Вставить("Базы", Параметры.Базы);
	Значение = СтруктураЗначений1;
	Возврат Хеш(Значение);
КонецФункции

Функция ОтпечатокСреды(Знач Модель, Знач Параметры)
	Сведения = КИИ_КоннекторИИ.ПараметрыМодели(Модель);
	Правила = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Модель, "РежимКонтроляПерсональныхДанных,МаршрутДоверенный,ОтпечатокДоверенногоМаршрута");
	СтруктураЗначений = Новый Структура;
	СтруктураЗначений.Вставить("Модель", Сведения);
	СтруктураЗначений.Вставить("Правила", Правила);
	СтруктураЗначений.Вставить("Режим", Константы.КИИ_РежимКонтроляЗапросовКМоделям.Получить());
	СтруктураЗначений.Вставить("Типы", Константы.КИИ_ВключенныеПравилаПерсональныхДанных.Получить());
	СтруктураЗначений.Вставить("Стиль", Константы.КИИ_СтильПодстановокПерсональныхДанных.Получить());
	СтруктураЗначений.Вставить("Имена", Константы.КИИ_АдресСервисаРаспознаванияИмен.Получить());
	СтруктураЗначений.Вставить("ИменаОбязательны", Константы.КИИ_СервисРаспознаванияИменОбязателен.Получить());
	Значение = СтруктураЗначений;
	Если Параметры.ИспользоватьИнструменты Тогда
		Начало = КИИ_АгентАнализа.ПодготовитьНачалоАнализа(Модель, "", Новый Структура("Базы", Параметры.Базы));
		Значение.Вставить("Каталог", Начало);
	КонецЕсли;
	Возврат Хеш(Значение);
КонецФункции

Функция Хеш(Знач Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ЗначениеВСтрокуВнутр(Данные));
	Возврат Base64Строка(Хеширование.ХешСумма);
КонецФункции

Функция ПредставлениеПромпта(Знач Модель, Знач Данные, Знач Параметры, Знач Пакет)
	Просмотр = НовыйПредпросмотр();
	Просмотр.Готово = Пакет.ЗнанияГотовы;
	Если Просмотр.Готово Тогда
		Просмотр.Статус = НСтр("ru = 'Контекст подготовлен. Изменение входов требует обновления просмотра.'");
	Иначе
		Просмотр.Статус = СтрШаблон("%1 %2",
			НСтр("ru = 'Просмотр неполный: знания ещё не подобраны.'"),
			НСтр("ru = 'Команда «Подобрать знания» выполняет поиск через модель эмбеддингов.'"));
	КонецЕсли;
	Получатель = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Модель, "Наименование,НаименованиеПровайдера,Адрес,АдресЗапроса");
	Просмотр.Получатель = СтрШаблон(
		"%1; %2; %3%4",
		Получатель.Наименование,
		Получатель.НаименованиеПровайдера,
		Получатель.Адрес,
		Получатель.АдресЗапроса);
	Если Не ПустаяСтрока(Пакет.ДиагностикаЗнаний) Тогда
		Просмотр.Статус = СтрШаблон(
			НСтр("ru = 'Поиск знаний не выполнен; в этот запрос знания не включены: %1'"), Пакет.ДиагностикаЗнаний);
	КонецЕсли;
	Просмотр.Инструкция = Пакет.Промпт.СистемныйПромпт;
	Просмотр.Вопрос = КИИ_КоннекторИИ.ТекстПромптаДляПредпросмотра(Пакет.Промпт.ПользовательскийПромпт);
	СтрокиЗнаний = Новый Массив;
	СтрокиЗнаний.Добавить(ТекстДляПросмотра(Модель, Данные.Знания, Пакет.Контекст));
	Для Каждого Источник Из Пакет.ИсточникиЗнаний Цикл
		СтрокиЗнаний.Добавить(ТекстДляПросмотра(Модель, Источник, Пакет.Контекст));
	КонецЦикла;
	Просмотр.Знания = СтрСоединить(СтрокиЗнаний, Символы.ПС);
	Если Параметры.ИспользоватьИнструменты Тогда
		Начало = КИИ_АгентАнализа.ПодготовитьНачалоАнализа(
			Модель, Пакет.Промпт, Новый Структура("Базы", Параметры.Базы));
		Сырой = Новый Структура("СырыеСообщения,Инструменты", Начало.Сообщения, Начало.Инструменты);
		Обработанный = КИИ_КоннекторИИ.ПодготовитьПромптДиалога(Модель, Сырой, Пакет.Контекст);
		Если Не Обработанный.Разрешено Тогда
			Пакет.Разрешено = Ложь;
			Пакет.ТекстОтказа = Обработанный.ТекстОтказа;
			Просмотр.Готово = Ложь;
			Просмотр.Статус = Пакет.ТекстОтказа;
			Возврат Просмотр;
		КонецЕсли;
		Просмотр.Сообщения = ОбщегоНазначения.ЗначениеВJSON(
			СообщенияДляПросмотра(Обработанный.СтруктураПромпта.СырыеСообщения));
		Просмотр.Инструменты = ОбщегоНазначения.ЗначениеВJSON(Начало.Инструменты);
	Иначе
		Просмотр.Сообщения = ОбщегоНазначения.ЗначениеВJSON(Пакет.Промпт.ИсторияСообщений);
		Просмотр.Инструменты = "[]";
	КонецЕсли;
	ШаблонВложения = НСтр("ru = 'Выключено: %1'");
	Если Параметры.Настройки.ИспользоватьВложения Тогда
		ШаблонВложения = НСтр("ru = 'Включено: %1'");
	КонецЕсли;
	СтрокиВложений = Новый Массив;
	СтрокиВложений.Добавить(Просмотр.Вложения);
	Для Каждого Вложение Из Данные.Вложения Цикл
		ТекстВложения = ТекстДляПросмотра(Модель, ОписаниеВложения(Вложение), Пакет.Контекст);
		СтрокиВложений.Добавить(СтрШаблон(ШаблонВложения, ТекстВложения));
	КонецЦикла;
	Просмотр.Вложения = СтрСоединить(СтрокиВложений, Символы.ПС);
	Возврат Просмотр;
КонецФункции

Функция ТекстДляПросмотра(Знач Модель, Знач Текст, Контекст)
	СтруктураПромпта = Новый Структура("ПользовательскийПромпт", Текст);
	Подготовка = КИИ_КоннекторИИ.ПодготовитьПромптДиалога(Модель, СтруктураПромпта, Контекст);
	Если Не Подготовка.Разрешено Тогда
		Возврат Подготовка.ТекстОтказа;
	КонецЕсли;
	Возврат Подготовка.СтруктураПромпта.ПользовательскийПромпт;
КонецФункции

Функция ОписаниеВложения(Знач Вложение)
	ТипВложения = "";
	Если Вложение.Свойство("Тип", ТипВложения) Тогда
		Если ТипВложения = "text" Тогда
			Возврат Вложение.Текст;
		КонецЕсли;
		Если ТипВложения = "image" Тогда
			Адрес = "";
			Если Вложение.Свойство("URL", Адрес) Тогда
				Возврат СтрШаблон(НСтр("ru = 'Изображение по ссылке: %1'"), Адрес);
			КонецЕсли;
			Возврат СтрШаблон(
				НСтр("ru = 'Изображение: %1; %2 байт; двоичное содержимое не отображается текстом.'"),
				Вложение.MIME, Строка(Вложение.ДвоичныеДанные.Размер()));
		КонецЕсли;
		Если ТипВложения = "document" Тогда
			Возврат СтрШаблон(НСтр("ru = 'Документ: %1; %2'"), Вложение.ИмяФайла, Вложение.MIME);
		КонецЕсли;
	КонецЕсли;
	Если Вложение.type = "image_url" Тогда
		Адрес = Вложение.image_url.url;
		Если СтрНачинаетсяС(Адрес, "data:") Тогда
			Возврат НСтр("ru = 'Изображение: двоичное содержимое передаётся в запросе.'");
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'Изображение по ссылке: %1'"), Адрес);
	КонецЕсли;
	Если Вложение.type = "file" Тогда
		Имя = "";
		Вложение.file.Свойство("filename", Имя);
		СведенияОЗагрузке = НСтр(
			"ru = 'Двоичное содержимое не отображается текстом; загрузка провайдеру выполняется при отправке.'");
		Возврат СтрШаблон(НСтр("ru = 'Файл: %1. %2'"), Имя, СведенияОЗагрузке);
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеВJSON(Вложение);
КонецФункции

Функция СообщенияДляПросмотра(Знач Сообщения)
	Итог = ОбщегоНазначения.СкопироватьРекурсивно(Сообщения);
	Для Каждого Сообщение Из Итог Цикл
		Если ТипЗнч(Сообщение.content) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Индекс = 0 По Сообщение.content.Количество() - 1 Цикл
			Сообщение.content[Индекс] = ЧастьСообщенияДляПросмотра(Сообщение.content[Индекс]);
		КонецЦикла;
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция ИсторияПромпта(Знач Данные, Знач РазмерКонтекста)
	ИсторияКонтекста = Новый Массив;
	История = Новый Массив;
	Для Индекс = 0 По Данные.История.Количество() - 1 Цикл
		Сообщение = Данные.История[Индекс];
		Если Сообщение.Роль <> "user" И Сообщение.Роль <> "assistant" Тогда
			Продолжить;
		КонецЕсли;
		Если Данные.ПоследнийВопросДобавлен
			И Индекс = Данные.История.Количество() - 1
			И Сообщение.Роль = "user" Тогда
			Продолжить;
		КонецЕсли;
		История.Добавить(Новый Структура("Роль,Текст", Сообщение.Роль, Сообщение.Текст));
	КонецЦикла;
	Начало = 0;
	Если РазмерКонтекста > 0 Тогда
		Начало = Макс(0, История.Количество() - РазмерКонтекста);
	КонецЕсли;
	Для Индекс = Начало По История.Количество() - 1 Цикл
		ИсторияКонтекста.Добавить(История[Индекс]);
	КонецЦикла;
	Возврат ИсторияКонтекста;
КонецФункции

Функция СоздатьПакетДиалога(Модель, Данные, Параметры, Режим, КлючВхода, Среда, Настройки)
	Пакет = Новый Структура;
	Пакет.Вставить("Пользователь", ПараметрыСеанса.КИИ_ПользовательЖурналаИИ);
	Пакет.Вставить("ВладелецФормы", Строка(Параметры.ВладелецФормы));
	Пакет.Вставить("Диалог", Параметры.Диалог);
	Пакет.Вставить("Запрос", Строка(Новый УникальныйИдентификатор));
	Пакет.Вставить("ОтпечатокВхода", КлючВхода);
	Пакет.Вставить("ОтпечатокСреды", Среда);
	Пакет.Вставить("Отправлен", Ложь);
	Пакет.Вставить(
		"ЗнанияГотовы", Не Настройки.ИспользоватьЗнания Или Не КИИ_RAG.ЕстьКатегорииЗнанийЭксперта(Данные.Эксперт));
	Пакет.Вставить("ИсточникиЗнаний", Новый Массив);
	Пакет.Вставить("ДиагностикаЗнаний", "");
	Если Не Пакет.ЗнанияГотовы И Режим <> "Просмотр" Тогда
		Знания = КИИ_RAG.ЗнанияЭкспертаДляДиалога(Данные.Эксперт, Данные.Вопрос, Данные.Инструкция);
		Данные.Знания = Знания.Дополнение;
		Пакет.ИсточникиЗнаний = Знания.Источники;
		Пакет.ДиагностикаЗнаний = Знания.Диагностика;
		Пакет.ЗнанияГотовы = Истина;
	КонецЕсли;
	Пакет.Вставить("Контекст", КИИ_КонтрольПерсональныхДанных.НовыйКонтекст());
	Пакет.Контекст.Вставить("ДиалогЧата", Пакет.Диалог);
	Пакет.Контекст.Вставить("ЗапросЧата", Пакет.Запрос);
	Пакет.Контекст.Вставить("РаундЧата", 1);
	Пакет.Вставить("Промпт", СобратьПромпт(Данные, Настройки));
	Подготовка = КИИ_КоннекторИИ.ПодготовитьПромптДиалога(Модель, Пакет.Промпт, Пакет.Контекст);
	Пакет.Вставить("Разрешено", Подготовка.Разрешено);
	Пакет.Вставить("ТекстОтказа", Подготовка.ТекстОтказа);
	Пакет.Промпт = Подготовка.СтруктураПромпта;
	Пакет.Вставить("Представление", НовыйПредпросмотр());
	Если Пакет.Разрешено Тогда
		Пакет.Представление = ПредставлениеПромпта(Модель, Данные, Параметры, Пакет);
	Иначе
		Пакет.Представление.Статус = Пакет.ТекстОтказа;
	КонецЕсли;
	Возврат Пакет;
КонецФункции

Функция СохраненныйПакетДиалога(Параметры, Знач Режим, Знач КлючВхода, Знач Среда)
	Пакет = ПолучитьИзВременногоХранилища(Параметры.АдресПодготовки);
	Если ТипЗнч(Пакет) = Тип("Структура") Тогда
		ПроверитьВладельца(Пакет, Параметры);
		Если Пакет.ОтпечатокВхода <> КлючВхода Или Пакет.Отправлен Тогда
			Пакет = Неопределено;
		Иначе
			Пакет = ПакетСАктуальнойСредой(Пакет, Режим, Среда);
		КонецЕсли;
	КонецЕсли;
	Если Режим = "Знания" Тогда
		Пакет = Неопределено;
	КонецЕсли;
	Возврат Пакет;
КонецФункции

Функция ПакетСАктуальнойСредой(Пакет, Знач Режим, Знач Среда)
	Если Пакет.ОтпечатокСреды = Среда Тогда
		Возврат Пакет;
	КонецЕсли;
	Если Режим = "Отправка" Тогда
		ВызватьИсключение НСтр(
			"ru = 'Маршрут, права или правила обработки изменились. Обновите просмотр перед отправкой.'");
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЧастьСообщенияДляПросмотра(Знач Часть)
	ТипЧасти = "";
	Если Часть.Свойство("Тип", ТипЧасти) Тогда
		Если ТипЧасти = "text" Тогда
			Возврат Новый Структура("type,text", "text", Часть.Текст);
		КонецЕсли;
		Адрес = "";
		Если ТипЧасти = "image" И Часть.Свойство("URL", Адрес) И Не СтрНачинаетсяС(Адрес, "data:") Тогда
			АдресИзображения = Новый Структура("url", Адрес);
			Возврат Новый Структура("type,image_url", "image_url", АдресИзображения);
		КонецЕсли;
	Иначе
		Часть.Свойство("type", ТипЧасти);
	КонецЕсли;
	Если ТипЧасти <> "text" Тогда
		Возврат Новый Структура("type,text", "text", ОписаниеВложения(Часть));
	КонецЕсли;
	Возврат Часть;
КонецФункции

#КонецОбласти

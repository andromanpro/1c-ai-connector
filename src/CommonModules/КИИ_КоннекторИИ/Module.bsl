#Область ПрограммныйИнтерфейс

// Выполняет синхронный запрос к модели ИИ
//
// Параметры:
//  Модель - СправочникСсылка.КИИ_МоделиИИ - модель для запроса
//  Промпт - Строка, Структура - запрос к модели:
//    * Строка - Строка - простой текст запроса
//    * СистемныйПромпт - Строка - системное сообщение
//    * ПользовательскийПромпт - Строка, Массив - запрос пользователя
//    * ИсторияСообщений - Массив - предыдущие ответы (необязательно)
//
// Возвращаемое значение:
//  Структура - результат запроса со свойствами:
//    * ЭтоОшибка - Булево - признак ошибки выполнения запроса
//    * ТекстОшибки - Строка - текст ошибки (если ЭтоОшибка = Истина)
//    * ТекстОтвета - Строка - текст ответа от модели ИИ
//    * ВходныеТокены - Число - количество токенов во входном запросе
//    * ВыходныеТокены - Число - количество токенов в ответе
//    * ВсегоТокенов - Число - общее количество использованных токенов
//    * ВыходныеТокеныВКеше - Число - количество закэшированных токенов
//    * ВремяОтветаСекунд - Число - время выполнения запроса в секундах
//    * СтоимостьОтвета - Число - стоимость запроса (если поддерживается провайдером)
//    * Модель - СправочникСсылка.КИИ_МоделиИИ, Неопределено - использованная модель
//    * МодельОтвета - Строка - фактическое имя модели из ответа
//    * ДатаЗапроса - Дата, Неопределено - дата и время начала запроса
//    * ДатаСоздания - Дата, Неопределено - дата создания ответа по данным провайдера
//    * ПричинаЗавершения - Строка - причина завершения генерации (stop, length и т.д.)
//    * Идентификатор - УникальныйИдентификатор - уникальный идентификатор записи лога
//    * УниверсальнаяДатаВМиллисекундах - Число - универсальное время в миллисекундах
//    * IDЗапроса - Строка - идентификатор запроса от провайдера
//    * ТипОбъекта - Строка - тип объекта ответа
//    * ТарифСервиса - Строка - использованный тариф сервиса
//    * ХэшМодели - Строка - отпечаток версии модели
//
// Пример:
//  Модель = Справочники.КИИ_МоделиИИ.НайтиПоНаименованию("GPT-4o");
//  Ответ = КИИ_КоннекторИИ.ЗапросКМодели(Модель, "Привет!");
//  
//  Если Не Ответ.ЭтоОшибка Тогда
//      Сообщить(Ответ.ТекстОтвета);
//  КонецЕсли;
//
//@skip-check doc-comment-collection-item-type
//@skip-check doc-comment-collection-item-type
Функция ЗапросКМодели(Модель, Промпт) Экспорт

	Результат = НовыйПараметрыОтветаИИ();
	ДатаНачала = ТекущаяДатаСеанса();

	Если Не ЗначениеЗаполнено(Модель) Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнена модель ИИ'");
		Возврат Результат;
	КонецЕсли;

	СтруктураПромпта = ПодготовитьПромпт(Промпт);

	// === Локальный кеш: проверка перед HTTP-вызовом (§9.1-9.3) ===
	ПараметрыМоделиЛокально = Неопределено;
	ХешЗапросаКеша = "";
	// Prefetch параметров модели для кеша: сбой осознанно игнорируем - основной поток
	// ниже повторно вызовет ПараметрыМодели(Модель) и штатно обработает ее отсутствие.
	// BSLLS:MissingCodeTryCatchEx-off
	Попытка
		ПараметрыМоделиЛокально = ПараметрыМодели(Модель);
	Исключение
		// модель не найдена - пусть основной поток отработает ошибку
	КонецПопытки;
	// BSLLS:MissingCodeTryCatchEx-on
	Если ПараметрыМоделиЛокально <> Неопределено
		И КешироватьЗапрос(ПараметрыМоделиЛокально, СтруктураПромпта) Тогда
		ХешЗапросаКеша = ВычислитьХешЗапроса(Модель, СтруктураПромпта, ПараметрыМоделиЛокально);
		КешПопадание = ПолучитьИзКеша(ХешЗапросаКеша, Модель, ПараметрыМоделиЛокально.ВерсияСхемыКеша);
		Если ТипЗнч(КешПопадание) = Тип("Структура") Тогда
			ЗаписатьЛогИИ(Модель, СтруктураПромпта, КешПопадание, Истина);
			Возврат КешПопадание;
		КонецЕсли;
	КонецЕсли;
	// === END кеш-проверка ===

	Попытка

		ВыполнитьЗапросКМодели(Модель, Промпт, Результат, ДатаНачала);

	Исключение

		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

	КонецПопытки;

	// === Локальный кеш: сохранение после успеха ===
	Если Не ПустаяСтрока(ХешЗапросаКеша) И Не Результат.ЭтоОшибка Тогда
		Попытка
			СохранитьВКеш(ХешЗапросаКеша, Модель, ПараметрыМоделиЛокально, Результат);
		Исключение
			// Сбой кеша не влияет на результат (ответ модели уже получен и будет возвращен),
			// поэтому уровень "Предупреждение", а не "Ошибка": мониторинг собирает ЖР строго
			// по уровню "Ошибка" и поднял бы этот некритичный сбой в анализ и телеграм.
			// BSLLS:UsageWriteLogEvent-off
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'КИИ.Кеш'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			// BSLLS:UsageWriteLogEvent-on
		КонецПопытки;
	КонецЕсли;
	// === END кеш-сохранение ===

	ЗаписатьЛогИИ(Модель, СтруктураПромпта, Результат);

	Возврат Результат;

КонецФункции

// Выполняет асинхронный запрос к модели ИИ через длительные операции
//
// Параметры:
//  Модель - СправочникСсылка.КИИ_МоделиИИ
//  Промпт - Строка, Структура - см. ЗапросКМодели
//
// Возвращаемое значение:
//  См. ДлительныеОперации.ВыполнитьВФоне
//
Функция ЗапросКМоделиВФоне(Модель, Промпт) Экспорт
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Запрос к модели ИИ'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("Модель", Модель);
	ПараметрыМетода.Вставить("Промпт", Промпт);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"КИИ_КоннекторИИ.ЗапросКМоделиФоновоеЗадание",
		ПараметрыМетода,
		ПараметрыВыполнения);
	
КонецФункции

// Возвращает параметры модели ИИ для выполнения HTTP-запроса
//
// Параметры:
//  Модель - СправочникСсылка.КИИ_МоделиИИ - модель ИИ
//
// Возвращаемое значение: 
//  Структура:
//    * Адрес - Строка - адрес API сервера (api.openai.com)
//    * АдресЗапроса - Строка - путь к endpoint (/v1/chat/completions)
//    * ИспользоватьЗащищенноеСоединение - Булево - использовать HTTPS
//    * ТипФорматаAPI - ПеречислениеСсылка.КИИ_ТипыФорматовAPI, Неопределено - формат API
//    * ТипАвторизации - ПеречислениеСсылка.КИИ_ТипыАвторизации, Неопределено - тип авторизации
//    * НаименованиеПровайдера - Строка - провайдер (OpenAI, GigaChat и т.д.)
//    * НаименованиеПолное - Строка - полное имя модели для API (gpt-4o)
//    * Температура - Число - температура генерации (0.0-2.0)
//    * МаксимумТокенов - Число - максимальное количество токенов ответа
//    * Таймаут - Число - таймаут HTTP запроса в секундах
//    * Заголовки - Массив из Структура - дополнительные HTTP заголовки

//
// Возвращает параметры модели ИИ для выполнения HTTP-запроса.
//
// Параметры:
//  Модель - СправочникСсылка.КИИ_МоделиИИ - модель ИИ
//
// Возвращаемое значение:
//  Структура:
//    * Адрес                            - Строка
//    * АдресЗапроса                     - Строка
//    * ИспользоватьЗащищенноеСоединение - Булево
//    * ИспользоватьПрокси - Булево - Истина: через прокси из константы КИИ_АдресПроксиИнтернет; Ложь: прямое
//    * ТипФорматаAPI    - ПеречислениеСсылка.КИИ_ТипыФорматовAPI, Неопределено - формат API
//    * ТипАвторизации   - ПеречислениеСсылка.КИИ_ТипыАвторизации, Неопределено - тип авторизации
//    * НаименованиеПровайдера  - Строка
//    * НаименованиеПолное      - Строка
//    * Температура      - Число
//    * МаксимумТокенов  - Число
//    * Таймаут          - Число
//    * СрокЖизниКеша    - Число - TTL кеша ответов модели
//    * ВерсияСхемыКеша  - Число - версия схемы кеша
//    * Заголовки        - Массив из Структура - HTTP заголовки, каждый элемент: Структура {Ключ, Значение}
//
// Один раунд диалога по готовому массиву messages (для петли агент-анализа с инструментами).
// В отличие от ЗапросКМодели: НЕ кеширует (каждый раунд уникален), НЕ ведет лог ИИ,
// принимает сырые messages (включая assistant+tool_calls и tool-результаты). Только OpenAI-формат.
//
// Параметры:
//  Модель      - СправочникСсылка.КИИ_МоделиИИ - модель ИИ (должна поддерживать function-calling).
//  Сообщения   - Массив из Структура - готовый массив messages в формате OpenAI.
//  Инструменты - Массив из Структура, Неопределено - OpenAI tools; Неопределено/пусто - без инструментов.
//
// Возвращаемое значение:
//  Структура - см. НовыйПараметрыОтветаИИ (ТекстОтвета, ВызовыИнструментов, токены, ЭтоОшибка...).
//
Функция ЗапросКМоделиСообщениями(Модель, Сообщения, Инструменты = Неопределено, КорреляцияАгента = "") Экспорт

	Результат = НовыйПараметрыОтветаИИ();
	ДатаНачала = ТекущаяДатаСеанса();
	СтруктураПромпта = Неопределено;

	Если Не ЗначениеЗаполнено(Модель) Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнена модель ИИ'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		Параметры = ПараметрыМодели(Модель);
		ПараметрыПромпта = Новый Структура("СырыеСообщения, Инструменты",
			Сообщения, ?(Инструменты = Неопределено, Новый Массив, Инструменты));
		СтруктураПромпта = ПодготовитьПромпт(ПараметрыПромпта);
		ТелоЗапроса = СформироватьТелоПоМодели(Параметры, СтруктураПромпта);
		ОтветОбертки = ВыполнитьHTTPЗапросМодели(Модель, Параметры.АдресЗапроса, ТелоЗапроса, "chat");
		Если ОтветОбертки.ЭтоОшибка Тогда
			Результат.ЭтоОшибка = Истина;
			Результат.ТекстОшибки = ОтветОбертки.ТекстОшибки;
		Иначе
			ЗаполнитьЗначенияСвойств(Результат, ОтветОбертки.Разобранное);
		КонецЕсли;
	Исключение
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Результат.ВремяОтветаСекунд = (ТекущаяДатаСеанса() - ДатаНачала);
	Результат.Модель = Модель;
	Результат.ДатаЗапроса = ДатаНачала;

	// Кост-трекинг раундов петли: без кеша, но С логом (токены и стоимость каждого раунда
	// видны в КИИ_ЛогЗапросовИИ, раунды одного анализа связаны КорреляциейАгента).
	Если СтруктураПромпта <> Неопределено Тогда
		Попытка
			ЗаписатьЛогИИ(Модель, СтруктураПромпта, Результат, Ложь, КорреляцияАгента);
		Исключение
			// Сбой записи лога вторичен: ответ модели уже получен и возвращается вызывающему.
			// Уровень "Ошибка" здесь поднял бы некритичный сбой в мониторинг (он собирает ЖР
			// строго по этому уровню) и превратил бы его в телеграм-уведомление.
			// BSLLS:UsageWriteLogEvent-off
			ЗаписьЖурналаРегистрации(НСтр("ru = 'КИИ.Логирование'"),
				УровеньЖурналаРегистрации.Предупреждение, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			// BSLLS:UsageWriteLogEvent-on
		КонецПопытки;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Читает реквизиты модели ИИ в структуру параметров запроса: транспорт (адрес, эндпоинт,
// защищенное соединение, прокси, таймаут), формат API и авторизацию, параметры генерации
// (температура, максимум токенов) и дополнительные HTTP-заголовки из табличной части.
//
// Параметры:
//  Модель - СправочникСсылка.КИИ_МоделиИИ - модель, чьи параметры нужны.
//
// Возвращаемое значение:
//  Структура:
//   * Адрес                            - Строка - хост API.
//   * АдресЗапроса                     - Строка - путь эндпоинта.
//   * ИспользоватьЗащищенноеСоединение - Булево.
//   * ИспользоватьПрокси               - Булево.
//   * Таймаут                          - Число - секунды.
//   * ТипФорматаAPI                    - ПеречислениеСсылка.КИИ_ТипыФорматовAPI.
//   * ТипАвторизации                   - ПеречислениеСсылка.КИИ_ТипыАвторизации.
//   * НаименованиеПолное               - Строка - идентификатор модели в API.
//   * НаименованиеПровайдера           - Строка.
//   * Температура                      - Число.
//   * МаксимумТокенов                  - Число.
//   * Заголовки                        - Массив из Структура - дополнительные заголовки:
//    ** Ключ     - Строка - имя заголовка.
//    ** Значение - Строка - значение заголовка.
//
Функция ПараметрыМодели(Модель) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КИИ_МоделиИИ.Ссылка КАК Ссылка,
		|	КИИ_МоделиИИ.Наименование КАК Наименование,
		|	КИИ_МоделиИИ.НаименованиеПолное КАК НаименованиеПолное,
		|	КИИ_МоделиИИ.Адрес КАК Адрес,
		|	КИИ_МоделиИИ.АдресЗапроса КАК АдресЗапроса,
		|	КИИ_МоделиИИ.ИспользоватьЗащищенноеСоединение КАК ИспользоватьЗащищенноеСоединение,
		|	КИИ_МоделиИИ.ИспользоватьПрокси КАК ИспользоватьПрокси,
		|	КИИ_МоделиИИ.ПоддерживаетИнструменты КАК ПоддерживаетИнструменты,
		|	КИИ_МоделиИИ.ТипФорматаAPI КАК ТипФорматаAPI,
		|	КИИ_МоделиИИ.ТипАвторизации КАК ТипАвторизации,
		|	КИИ_МоделиИИ.НаименованиеПровайдера КАК НаименованиеПровайдера,
		|	КИИ_МоделиИИ.Температура КАК Температура,
		|	КИИ_МоделиИИ.МаксимумТокенов КАК МаксимумТокенов,
		|	КИИ_МоделиИИ.Таймаут КАК Таймаут,
		|	КИИ_МоделиИИ.СрокЖизниКеша КАК СрокЖизниКеша,
		|	КИИ_МоделиИИ.ВерсияСхемыКеша КАК ВерсияСхемыКеша
		|ИЗ
		|	Справочник.КИИ_МоделиИИ КАК КИИ_МоделиИИ
		|ГДЕ
		|	КИИ_МоделиИИ.Ссылка = &Модель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КИИ_МоделиИИЗаголовки.Ключ КАК Ключ,
		|	КИИ_МоделиИИЗаголовки.Значение КАК Значение
		|ИЗ
		|	Справочник.КИИ_МоделиИИ.Заголовки КАК КИИ_МоделиИИЗаголовки
		|ГДЕ
		|	КИИ_МоделиИИЗаголовки.Ссылка = &Модель";
	
	Запрос.УстановитьПараметр("Модель", Модель);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[0].Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение НСтр("ru = 'Модель ИИ не найдена'");
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Адрес", "");
	Результат.Вставить("АдресЗапроса", "");
	Результат.Вставить("ИспользоватьЗащищенноеСоединение", Ложь);
	Результат.Вставить("ИспользоватьПрокси", Ложь);
	Результат.Вставить("ПоддерживаетИнструменты", Ложь);
	Результат.Вставить("ТипФорматаAPI", Неопределено);
	Результат.Вставить("ТипАвторизации", Неопределено);
	Результат.Вставить("НаименованиеПровайдера", "");
	Результат.Вставить("НаименованиеПолное", "");
	Результат.Вставить("Температура", 0);
	Результат.Вставить("Таймаут", 0);
	Результат.Вставить("МаксимумТокенов", 0);
	Результат.Вставить("СрокЖизниКеша", 0);
	Результат.Вставить("ВерсияСхемыКеша", 0);
	Результат.Вставить("Заголовки", Новый Массив);
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	
	ВыборкаЗаголовки = РезультатЗапроса[1].Выбрать();
	Пока ВыборкаЗаголовки.Следующий() Цикл
		Заголовок = Новый Структура("Ключ, Значение");
		ЗаполнитьЗначенияСвойств(Заголовок, ВыборкаЗаголовки);
		Результат.Заголовки.Добавить(Заголовок);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


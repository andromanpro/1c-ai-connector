// Проверяет, поддерживает ли провайдер мультимодальный ввод для подготовленного промпта.
//
// Параметры:
//  Параметры        - Структура - параметры модели (см. ПараметрыМодели)
//  СтруктураПромпта - Структура - результат ПодготовитьПромпт
//
Процедура ПроверитьПоддержкуМультимодала(Знач Параметры, Знач СтруктураПромпта) Экспорт
	
	Если Не СтруктураПромпта.Свойство("ЕстьИзображения") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СтруктураПромпта.ЕстьИзображения Тогда
		Возврат;
	КонецЕсли;
	
	Модуль = ПолучитьМодульПровайдера(Параметры.ТипФорматаAPI);
	Если Не Модуль.ПоддерживаетМультимодал() Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Провайдер %1 не поддерживает мультимодальный ввод (изображения)'"),
			Параметры.НаименованиеПровайдера);
	КонецЕсли;
	
КонецПроцедуры

// Единая точка выполнения HTTP-запроса к модели ИИ: прокси, таймаут, авторизация,
// повтор при 401, разбор ответа выбранным парсером. chat- и embedding-пути -
// тонкие клиенты этой обертки.
//
// Параметры:
//  Модель     - СправочникСсылка.КИИ_МоделиИИ - модель ИИ
//  Endpoint   - Строка - путь к endpoint ("/v1/chat/completions" | "/v1/embeddings")
//  ТелоЗапроса - Структура - тело запроса (сериализуется в JSON)
//  ИмяПарсера - Строка - "chat" | "embedding" - выбор разбора ответа
//
// Возвращаемое значение:
//  Структура:
//    * ЭтоОшибка    - Булево - транспортная/HTTP-ошибка
//    * ТекстОшибки  - Строка
//    * КодСостояния - Число - HTTP-код ответа
//    * ОтветJSON    - Соответствие, Неопределено - разобранный JSON (при коде 200)
//    * Разобранное  - Произвольный, Неопределено - результат парсера: для "chat" структура НовыйПараметрыОтветаИИ;
//                     для "embedding" Массив Число (сырой) либо Неопределено
//
//@skip-check doc-comment-field-type
//@skip-check doc-comment-collection-item-type
Функция ВыполнитьHTTPЗапросМодели(Модель, Endpoint, ТелоЗапроса, ИмяПарсера) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ЭтоОшибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("ОтветJSON", Неопределено);
	Результат.Вставить("Разобранное", Неопределено);

	Параметры = ПараметрыМодели(Модель);
	КлючAPI = ПолучитьКлючAPI(Модель, Параметры);

	// Сетевой I/O изолирован: любое исключение (таймаут, обрыв соединения, DNS,
	// сбой парсинга ответа) возвращается как ЭтоОшибка, а не бросается наружу.
	// Иначе фоновое ОбновитьЭмбеддинги падает на первой же сетевой ошибке и не
	// индексирует ни одного фрагмента, а клиентский вызов получает голое исключение.
	Попытка

		Соединение = СоздатьHTTPСоединение(Параметры);
		Запрос = Новый HTTPЗапрос(Endpoint);

		Заголовки = СформироватьЗаголовкиПоМодели(Параметры, КлючAPI);
		Для Каждого Заголовок Из Заголовки Цикл
			Запрос.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
		КонецЦикла;

		ТелоJSON = ОбщегоНазначения.ЗначениеВJSON(ТелоЗапроса);
		Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);

		Ответ = ОтправитьЗапросСРетраем(Соединение, Запрос, Модель, Параметры, КлючAPI);
		Результат.КодСостояния = Ответ.КодСостояния;

		Если Ответ.КодСостояния <> 200 Тогда
			ТелоОшибки = Ответ.ПолучитьТелоКакСтроку();
			Результат.ЭтоОшибка = Истина;
			Результат.ТекстОшибки = РасшифровкаКодаОшибки(Ответ.КодСостояния, ТелоОшибки);
			Возврат Результат;
		КонецЕсли;

		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		Результат.ОтветJSON = ОбщегоНазначения.JSONВЗначение(ТелоОтвета, , Ложь);

		РазобратьОтветПоИмени(ИмяПарсера, Параметры, Результат.ОтветJSON, Результат);

	Исключение
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

#Область ИнтерфейсДляТестов

// Формирует HTTP-тело и заголовки без отправки запроса.
// Используется только для модульных тестов ядра.
//
// Параметры:
//  Параметры - Структура - аналог результата ПараметрыМодели (можно собрать руками)
//  Промпт    - Строка, Структура - см. ПодготовитьПромпт
//  КлючAPI   - Строка - тестовый ключ
//
// Возвращаемое значение:
//  Структура:
//    * Заголовки   - Соответствие из КлючИЗначение
//    * ТелоЗапроса - Структура
//
Функция СформироватьЗапросДляТестов(Знач Параметры, Знач Промпт, Знач КлючAPI = "TEST_KEY") Экспорт
	
	СтруктураПромпта = ПодготовитьПромпт(Промпт);
	ПроверитьПоддержкуМультимодала(Параметры, СтруктураПромпта);
	Заголовки = Новый Соответствие;
	Если Параметры.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_ImageGen Тогда
		КИИ_КоннекторOpenAI.СформироватьЗаголовки(Параметры, КлючAPI, Заголовки);
		ЗапросГенерации = Новый Структура;
		ЗапросГенерации.Вставить("Заголовки",  Заголовки);
		ЗапросГенерации.Вставить("ТелоЗапроса", ТелоЗапросаГенерацииOpenAI(Параметры, СтруктураПромпта));
		Возврат ЗапросГенерации;
	КонецЕсли;
	ТелоЗапроса = Новый Структура;
	СформироватьЗаголовкиИТелоПоМодели(Параметры, КлючAPI, СтруктураПромпта, Заголовки, ТелоЗапроса);
	Возврат Новый Структура("Заголовки, ТелоЗапроса", Заголовки, ТелоЗапроса);
	
КонецФункции

// Разбирает JSON-ответ провайдера в стандартный результат.
// Используется только для модульных тестов ядра.
//
// Параметры:
//  Параметры - Структура - с полем ТипФорматаAPI
//  ОтветJSON - Соответствие из КлючИЗначение - уже распарсенный JSON-ответ
//
// Возвращаемое значение:
//  Структура - результат разбора (как у ЗапросКМодели):
//   * ЭтоОшибка - Булево - признак ошибки
//   * ТекстОшибки - Строка - текст ошибки
//   * ТекстОтвета - Строка - текст ответа
//   * ВходныеТокены - Число - входные токены
//   * ВыходныеТокены - Число - выходные токены
//   * ВсегоТокенов - Число - всего токенов
//   * ВыходныеТокеныВКеше - Число - токены в кеше
//   * ВремяОтветаСекунд - Число - время ответа в секундах
//   * СтоимостьОтвета - Число - стоимость
//   * Модель - СправочникСсылка.КИИ_МоделиИИ, Неопределено - модель
//   * МодельОтвета - Строка - имя модели из ответа
//   * Идентификатор - УникальныйИдентификатор - идентификатор лога
//   * IDЗапроса - Строка - идентификатор запроса провайдера
//   * ДатаЗапроса - Дата, Неопределено - дата запроса
//   * ДатаСоздания - Дата, Неопределено - дата создания ответа
//   * УниверсальнаяДатаВМиллисекундах - Число - универсальное время
//   * ПричинаЗавершения - Строка - причина завершения
//   * ТипОбъекта - Строка - тип объекта ответа
//   * ТарифСервиса - Строка - тариф сервиса
//   * ХэшМодели - Строка - отпечаток версии модели
//
Функция РазобратьОтветДляТестов(Знач Параметры, Знач ОтветJSON) Экспорт
	
	Результат = НовыйПараметрыОтветаИИ();
	Если Параметры.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_ImageGen Тогда
		РазобратьОтветГенерацииOpenAI(ОтветJSON, Результат);
		Возврат Результат;
	КонецЕсли;
	ОбработатьОтветПоТипуМодели(Параметры, ОтветJSON, Результат);
	Возврат Результат;
	
КонецФункции

// Разбирает embedding-ответ провайдера (Структура либо Соответствие) в обертку результата.
// Используется только для модульных тестов парсера эмбеддингов.
//
// Параметры:
//  ОтветJSON - Структура, Соответствие из КлючИЗначение - разобранный JSON-ответ embedding-API
//
// Возвращаемое значение:
//  Структура - обертка результата эмбеддинга:
//   * Разобранное - Массив, Неопределено - вектор чисел либо Неопределено
//   * ЭтоОшибка - Булево - признак ошибки
//   * ТекстОшибки - Строка - текст ошибки
//
//@skip-check doc-comment-collection-item-type
Функция РазобратьЭмбеддингДляТестов(Знач ОтветJSON) Экспорт
	
	РезультатОбертки = Новый Структура("Разобранное, ЭтоОшибка, ТекстОшибки", Неопределено, Ложь, "");
	РазобратьЭмбеддингОтвет(ОтветJSON, РезультатОбертки);
	Возврат РезультатОбертки;
	
КонецФункции

// Тестовый хелпер: парсит строку "host:port" в ИнтернетПрокси.
// Используется только в модульных тестах ядра. Не читает константу.
//
// Параметры:
//  АдресПрокси - Строка - адрес в формате "host:port" или пустая строка
//
// Возвращаемое значение:

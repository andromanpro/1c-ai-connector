//                                 либо Неопределено если строка пустая или невалидная
//
Функция СформироватьПроксиДляТестов(Знач АдресПрокси) Экспорт
	
	Возврат КИИ_HTTPКлиент.СформироватьПроксиДляТестов(АдресПрокси);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Процедура для выполнения запроса к модели ИИ в фоновом задании
// Используется подсистемой ДлительныеОперации
//
// Параметры:
//  ПараметрыМетода - Структура:
//    * Модель - СправочникСсылка.КИИ_МоделиИИ
//    * Промпт - Строка, Структура - запрос к модели (см. ЗапросКМодели)
//  АдресРезультата - Строка - адрес временного хранилища
//
Процедура ЗапросКМоделиФоновоеЗадание(ПараметрыМетода, АдресРезультата) Экспорт
	
	Модель = ПараметрыМетода.Модель;
	Промпт = ПараметрыМетода.Промпт;
	
	Результат = ЗапросКМодели(Модель, Промпт);
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьЗапросКМодели(Модель, Промпт, Результат, ДатаНачала)

	Параметры = ПараметрыМодели(Модель);
	СтруктураПромпта = ПодготовитьПромпт(Промпт);
	ПроверитьПоддержкуМультимодала(Параметры, СтруктураПромпта);

	Если Параметры.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_ImageGen Тогда
		КлючAPI = ПолучитьКлючAPI(Модель, Параметры);
		ВыполнитьГенерациюИзображенияOpenAI(Модель, Параметры, КлючAPI, СтруктураПромпта, Результат, ДатаНачала);
		Возврат;
	КонецЕсли;

	ТелоЗапроса = СформироватьТелоПоМодели(Параметры, СтруктураПромпта);
	ОтветОбертки = ВыполнитьHTTPЗапросМодели(Модель, Параметры.АдресЗапроса, ТелоЗапроса, "chat");

	Если ОтветОбертки.ЭтоОшибка Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = ОтветОбертки.ТекстОшибки;
		Возврат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(Результат, ОтветОбертки.Разобранное);
	Результат.ВремяОтветаСекунд = (ТекущаяДатаСеанса() - ДатаНачала);
	Результат.Модель = Модель;
	Результат.ДатаЗапроса = ДатаНачала;

КонецПроцедуры

// Разбирает ответ обертки выбранным парсером.
//
// Параметры:
//  ИмяПарсера       - Строка - "chat" | "embedding"
//  Параметры        - Структура - параметры модели (см. ПараметрыМодели)
//  ОтветJSON        - Соответствие из КлючИЗначение - разобранный JSON-ответ
//  РезультатОбертки - Структура - результат ВыполнитьHTTPЗапросМодели (мутируется)
//
Процедура РазобратьОтветПоИмени(ИмяПарсера, Параметры, ОтветJSON, РезультатОбертки)

	Если ИмяПарсера = "chat" Тогда
		Разобранное = НовыйПараметрыОтветаИИ();
		ОбработатьОтветПоТипуМодели(Параметры, ОтветJSON, Разобранное);
		РезультатОбертки.Разобранное = Разобранное;
	ИначеЕсли ИмяПарсера = "embedding" Тогда
		РазобратьЭмбеддингОтвет(ОтветJSON, РезультатОбертки);
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный парсер ответа: %1'"), ИмяПарсера);
	КонецЕсли;

КонецПроцедуры

// Извлекает вектор эмбеддинга из ответа embedding-API (OpenAI-совместимый формат).
//
// Параметры:
//  ОтветJSON        - Соответствие из КлючИЗначение - разобранный JSON-ответ
//  РезультатОбертки - Структура - результат ВыполнитьHTTPЗапросМодели (мутируется)
//
Процедура РазобратьЭмбеддингОтвет(ОтветJSON, РезультатОбертки)

	Вектор = Неопределено;
	Данные = Неопределено;
	// JSON парсится в Структуру (JSONВЗначение(..., Ложь)), а не в Соответствие - принимаем оба типа.
	Если ТипЗнч(ОтветJSON) = Тип("Соответствие") Тогда
		Данные = ОтветJSON.Получить("data");
	ИначеЕсли ТипЗнч(ОтветJSON) = Тип("Структура") Тогда
		ОтветJSON.Свойство("data", Данные);
	Иначе
		// Ответ не JSON-объект (строка/массив/Неопределено): Данные остаются Неопределено,
		// проверка вектора ниже вернет ошибку "ответ не содержит вектора".
		Данные = Неопределено;
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("Массив") И Данные.Количество() > 0 Тогда
		Элемент = Данные[0];
		Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
			Вектор = Элемент.Получить("embedding");
		ИначеЕсли ТипЗнч(Элемент) = Тип("Структура") Тогда
			Элемент.Свойство("embedding", Вектор);
		Иначе
			// Элемент data[0] не JSON-объект - вектор извлечь неоткуда.
			Вектор = Неопределено;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(Вектор) = Тип("Массив") И Вектор.Количество() > 0 Тогда
		РезультатОбертки.Разобранное = Вектор;
	Иначе
		РезультатОбертки.ЭтоОшибка = Истина;
		РезультатОбертки.ТекстОшибки = НСтр("ru = 'Ответ embedding-API не содержит вектора'");
	КонецЕсли;

КонецПроцедуры

// Формирует HTTP-заголовки по модели (заголовки провайдера + дополнительные).
//
// Параметры:
//  Параметры - Структура - параметры модели (см. ПараметрыМодели)
//  КлючAPI   - Строка - ключ API / токен авторизации
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - заголовки запроса
//
Функция СформироватьЗаголовкиПоМодели(Параметры, КлючAPI)

	Модуль = ПолучитьМодульПровайдера(Параметры.ТипФорматаAPI);
	Заголовки = Новый Соответствие;
	Модуль.СформироватьЗаголовки(Параметры, КлючAPI, Заголовки);

	Для Каждого Заголовок Из Параметры.Заголовки Цикл
		Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;

	Возврат Заголовки;

КонецФункции

// Формирует тело запроса генерации (chat) по модели через провайдер-модуль.
//
// Параметры:
//  Параметры        - Структура - параметры модели (см. ПараметрыМодели)
//  СтруктураПромпта - Структура - результат ПодготовитьПромпт
//
// Возвращаемое значение:
//  Структура - тело запроса
//
Функция СформироватьТелоПоМодели(Параметры, СтруктураПромпта)

	Модуль = ПолучитьМодульПровайдера(Параметры.ТипФорматаAPI);
	ТелоЗапроса = Новый Структура;
	Модуль.СформироватьТелоЗапроса(Параметры, СтруктураПромпта, ТелоЗапроса);
	Возврат ТелоЗапроса;

КонецФункции

// Возвращает объект ИнтернетПрокси для исходящих HTTP-запросов на основании
// значения константы КИИ_АдресПроксиИнтернет ("host:port" либо пусто).
//
// Возвращаемое значение:
//  ИнтернетПрокси, Неопределено - прокси для исходящих запросов либо Неопределено (прямое соединение)
//
Функция ПолучитьПрокси()

	Возврат КИИ_HTTPКлиент.ПроксиПоУмолчанию();

КонецФункции

Функция СоздатьHTTPСоединение(Параметры)

	Если Параметры.ИспользоватьЗащищенноеСоединение Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
	Иначе
		ЗащищенноеСоединение = Неопределено;
	КонецЕсли;

	// ИспользоватьПрокси=Истина - ходим через прокси из константы КИИ_АдресПроксиИнтернет
	// (у него уже настроен обход локальных адресов, так что LiteLLM-шлюз и Ollama идут напрямую).
	// ИспользоватьПрокси=Ложь - Неопределено, то есть поведение платформы по умолчанию.
	// ⚠ Здесь НЕЛЬЗЯ ставить Новый ИнтернетПрокси(Ложь): реквизит новый, у всех существующих
	// моделей он Ложь, и принудительно прямое соединение отрезало бы клиентов, у которых
	// интернет доступен ТОЛЬКО через прокси платформы (регрессия при обновлении).
	Прокси = ?(Параметры.ИспользоватьПрокси, ПолучитьПрокси(), Неопределено);

	Возврат Новый HTTPСоединение(Параметры.Адрес, , , , Прокси, Параметры.Таймаут, ЗащищенноеСоединение);

КонецФункции

Функция ОтправитьЗапросСПовторомПриОшибке401(Соединение, Запрос, Модель, Параметры, КлючAPI)

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);

	Если Ответ.КодСостояния = 401
		И Параметры.ТипАвторизации = Перечисления.КИИ_ТипыАвторизации.OAuth2ClientCredentials Тогда

		КлючAPI = ОбновитьOAuth2Токен(Модель, Параметры);
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

	КонецЕсли;

	Возврат Ответ;

КонецФункции

// Отправляет запрос с ретраем транзиентных сбоев (429/5xx) и сетевых исключений (таймаут/обрыв).
// Обертка над ОтправитьЗапросСПовторомПриОшибке401 (401-рефреш токена сохранен). Контракт тот же:
// возвращает HTTPОтвет либо пробрасывает исключение на финальной сетевой неудаче - оба вызывателя
// (основной путь и генерация изображений) exception-safe. Раньше транзиентный сбой сразу становился
// ошибкой без повтора (аудит P2 #5). Backoff - КИИ_HTTPКлиент.Пауза (аудит P2 #9).
Функция ОтправитьЗапросСРетраем(Соединение, Запрос, Модель, Параметры, КлючAPI)

	МаксимумПопыток = 3;
	Задержка = 1;
	Ответ = Неопределено;

	Для НомерПопытки = 1 По МаксимумПопыток Цикл

		ЕстьЕщеПопытки = (НомерПопытки < МаксимумПопыток);

		Попытка
			Ответ = ОтправитьЗапросСПовторомПриОшибке401(Соединение, Запрос, Модель, Параметры, КлючAPI);
		Исключение
			// Сетевой сбой: повторяем с backoff, пока есть попытки; иначе пробрасываем наружу.
			Если Не ЕстьЕщеПопытки Тогда
				ВызватьИсключение;
			КонецЕсли;
			КИИ_HTTPКлиент.Пауза(Задержка);
			Задержка = Задержка * 2;
			Продолжить;
		КонецПопытки;

		Если Не КИИ_HTTPКлиент.ЭтоПовторяемыйКодОтвета(Ответ.КодСостояния) Или Не ЕстьЕщеПопытки Тогда
			Возврат Ответ;
		КонецЕсли;

		// Транзиентный код (429/5xx) и попытки остались - ждем и повторяем.
		КИИ_HTTPКлиент.Пауза(Задержка);
		Задержка = Задержка * 2;

	КонецЦикла;

	Возврат Ответ;

КонецФункции

Процедура ОбработатьОшибкуОтвета(Ответ, Результат)

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	ТекстОшибки = РасшифровкаКодаОшибки(Ответ.КодСостояния, ТелоОтвета);

	Результат.ЭтоОшибка = Истина;
	Результат.ТекстОшибки = ТекстОшибки;

КонецПроцедуры

#Область Авторизация

Функция ПолучитьКлючAPI(Модель, Параметры) 
	
	Попытка

		КлючAPI = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			Модель,
			"APIКлюч");
			
		Если КлючAPI = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Если Параметры.ТипАвторизации = Перечисления.КИИ_ТипыАвторизации.OAuth2ClientCredentials Тогда
			Возврат ПолучитьOAuth2ТокенСКешем(Модель, КлючAPI, Параметры);
		КонецЕсли;
		
		Возврат КлючAPI;
		
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка чтения API ключа из безопасного хранилища: %1'"),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КИИ.APIКлюч'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		
		Возврат "";
		
	КонецПопытки;
	
КонецФункции

// Возвращает структуру OAuth2-токена провайдера: {ТокенДоступа, ВремяИстеченияMС}.
Функция ПолучитьСтруктуруOAuth2Токена(УчетныеДанные, Параметры)

	Если Параметры.НаименованиеПровайдера = "GigaChat" Тогда
		Возврат ПолучитьGigaChatТокенДоступа(УчетныеДанные, Параметры);
	КонецЕсли;

	ВызватьИсключение НСтр("ru = 'Неподдерживаемый OAuth2 провайдер'");

КонецФункции

// Возвращает OAuth2-токен доступа, переиспользуя кешированный (безопасное хранилище модели,
// TTL из ответа провайдера). Раньше полный OAuth-хендшейк выполнялся на КАЖДЫЙ запрос к ИИ (аудит P2 #4).
Функция ПолучитьOAuth2ТокенСКешем(Модель, УчетныеДанные, Параметры)

	Кеш = ПрочитатьOAuth2ТокенИзКеша(Модель);
	Если OAuth2ТокенКешаДействителен(Кеш, ТекущаяУниверсальнаяДатаВМиллисекундах()) Тогда
		Возврат Кеш.ТокенДоступа;
	КонецЕсли;

	СтруктураТокена = ПолучитьСтруктуруOAuth2Токена(УчетныеДанные, Параметры);
	СохранитьOAuth2ТокенВКеш(Модель, СтруктураТокена);

	Возврат СтруктураТокена.ТокенДоступа;

КонецФункции

// Читает кеш OAuth2-токена из безопасного хранилища модели. Неопределено, если нет записи/ошибка.
Функция ПрочитатьOAuth2ТокенИзКеша(Модель)

	Если Не ЗначениеЗаполнено(Модель) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Возврат ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Модель, "КИИ_OAuth2ТокенКеш");
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Сохраняет кеш OAuth2-токена в безопасное хранилище модели.
// Сбой записи не роняет запрос к ИИ (кеш - оптимизация, а не критичный путь).
Процедура СохранитьOAuth2ТокенВКеш(Модель, СтруктураТокена)

	Токен = Неопределено;
	НетДанныхДляКеша = Не ЗначениеЗаполнено(Модель)
		Или ТипЗнч(СтруктураТокена) <> Тип("Структура")
		Или Не СтруктураТокена.Свойство("ТокенДоступа", Токен)
		Или Не ЗначениеЗаполнено(Токен);
	Если НетДанныхДляКеша Тогда
		Возврат;
	КонецЕсли;

	ВремяИстечения = 0;
	СтруктураТокена.Свойство("ВремяИстеченияMС", ВремяИстечения);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Данные = Новый Структура("ТокенДоступа, ВремяИстеченияMС", Токен, ВремяИстечения);
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Модель, Данные, "КИИ_OAuth2ТокенКеш");
	Исключение
		// Кеш токена - оптимизация: при сбое записи следующий запрос просто получит токен заново.
		// Уровень "Ошибка" поднял бы это в мониторинг (он собирает ЖР строго по нему) и в телеграм.
		// BSLLS:UsageWriteLogEvent-off
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КИИ.OAuth2.Кеш'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		// BSLLS:UsageWriteLogEvent-on
	КонецПопытки;

КонецПроцедуры

// Действителен ли кешированный OAuth2-токен: валидная структура, заполненный токен,
// и до истечения осталось больше запаса (проактивное обновление до фактического истечения).
// Чистая функция - точка тестирования (аудит P2 #4).
// Параметры:
//  СтруктураКеша - Структура - кеш OAuth2-токена (ТокенДоступа, ВремяИстеченияMС).
//  ТекущееВремяMС - Число - текущее время в миллисекундах.
//  ЗапасMС - Число - запас до истечения в миллисекундах для проактивного обновления.
// Возвращаемое значение:
//  Булево - Истина, если кешированный токен действителен.
Функция OAuth2ТокенКешаДействителен(Знач СтруктураКеша, Знач ТекущееВремяMС, Знач ЗапасMС = 60000) Экспорт

	Если ТипЗнч(СтруктураКеша) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Токен = Неопределено;
	Если Не СтруктураКеша.Свойство("ТокенДоступа", Токен) Или Не ЗначениеЗаполнено(Токен) Тогда
		Возврат Ложь;
	КонецЕсли;

	ВремяИстечения = Неопределено;
	Если Не СтруктураКеша.Свойство("ВремяИстеченияMС", ВремяИстечения)
		Или ТипЗнч(ВремяИстечения) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат (ВремяИстечения - ТекущееВремяMС) > ЗапасMС;

КонецФункции

// Нормализует expires_at провайдера (Unix-время в секундах ИЛИ миллисекундах) к абсолютным
// миллисекундам. Порог 10^12 мс (≈ 2001 год): меньше - трактуем как секунды (×1000).
// Не число / ≤ 0 → 0 (токен считается истекшим → безопасно перезапрашивается).
// Чистая функция - точка тестирования (аудит P2 #4).
// Параметры:
//  ЗначениеИстечения - Число - expires_at провайдера (секунды или миллисекунды).
// Возвращаемое значение:
//  Число - абсолютное время истечения в миллисекундах (0, если некорректно).
Функция НормализоватьВремяИстеченияВMС(Знач ЗначениеИстечения) Экспорт

	Если ТипЗнч(ЗначениеИстечения) <> Тип("Число") Или ЗначениеИстечения <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Если ЗначениеИстечения < 1000000000000 Тогда
		Возврат ЗначениеИстечения * 1000;
	КонецЕсли;

	Возврат ЗначениеИстечения;

КонецФункции

Функция ОбновитьOAuth2Токен(Модель, Параметры)
	
	Попытка
		УчетныеДанные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			Модель,
			"APIКлюч");
			
		Если УчетныеДанные = Неопределено Тогда
			УчетныеДанные = "";
		КонецЕсли;
		
	Исключение
		УчетныеДанные = "";
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КИИ.OAuth2'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	СтруктураТокена = ПолучитьСтруктуруOAuth2Токена(УчетныеДанные, Параметры);
	СохранитьOAuth2ТокенВКеш(Модель, СтруктураТокена);

	Возврат СтруктураТокена.ТокенДоступа;

КонецФункции

Функция ПолучитьGigaChatТокенДоступа(УчетныеДанные, Параметры)

	Попытка

		Base64Auth = ПодготовитьBase64АвторизациюGigaChat(УчетныеДанные);
		ОтветJSON = ВыполнитьGigaChatOAuth2Запрос(Base64Auth, Параметры);

		Возврат СформироватьСтруктуруТокенаGigaChat(ОтветJSON);

	Исключение

		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка получения GigaChat OAuth токена: %1'"),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КИИ.OAuth'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);

		ВызватьИсключение ТекстОшибки;

	КонецПопытки;

КонецФункции

Функция ПодготовитьBase64АвторизациюGigaChat(УчетныеДанные)

	УчетныеДанные = СокрЛП(УчетныеДанные);

	Если СтрНайти(УчетныеДанные, ":") > 0 Тогда
		Base64Auth = КодироватьУчетныеДанныеВBase64(УчетныеДанные);
	Иначе
		Base64Auth = УчетныеДанные;
	КонецЕсли;

	Возврат ОчиститьBase64ОтПробелов(Base64Auth);

КонецФункции

Функция КодироватьУчетныеДанныеВBase64(УчетныеДанные)

	Части = СтрРазделить(УчетныеДанные, ":", Ложь);

	Если Части.Количество() <> 2 Тогда
		ВызватьИсключение НСтр("ru = 'Неверный формат ClientId:ClientSecret'");
	КонецЕсли;

	СтрокаАвторизации = Части[0] + ":" + Части[1];
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(СтрокаАвторизации, КодировкаТекста.UTF8);

	Возврат Base64Строка(ДвоичныеДанные);

КонецФункции

Функция ОчиститьBase64ОтПробелов(Base64Строка)

	Результат = Base64Строка;
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.ВТаб, "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	Результат = СтрЗаменить(Результат, " ", "");

	Возврат Результат;

КонецФункции

Функция ВыполнитьGigaChatOAuth2Запрос(Base64Auth, Параметры)

	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);

	// Тот же выбор прокси, что и у основного соединения модели (СоздатьHTTPСоединение):
	// флаг модели ИспользоватьПрокси теперь доезжает и до OAuth-вызова GigaChat.
	Если Параметры.ИспользоватьПрокси Тогда
		Прокси = ПолучитьПрокси();
	Иначе
		Прокси = Неопределено;
	КонецЕсли;

	Соединение = Новый HTTPСоединение("ngw.devices.sberbank.ru", 9443, , , Прокси, 30, ЗащищенноеСоединение);

	Запрос = СформироватьGigaChatOAuth2Запрос(Base64Auth);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'GigaChat OAuth ошибка %1: %2'"),
			Ответ.КодСостояния,
			Ответ.ПолучитьТелоКакСтроку());
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Возврат ОбщегоНазначения.JSONВЗначение(ТелоОтвета);

КонецФункции

Функция СформироватьGigaChatOAuth2Запрос(Base64Auth)

	Запрос = Новый HTTPЗапрос("/api/v2/oauth");

	Запрос.Заголовки.Вставить("Authorization", "Basic " + Base64Auth);
	Запрос.Заголовки.Вставить("RqUID", XMLСтрока(Новый УникальныйИдентификатор));
	Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Запрос.Заголовки.Вставить("Accept", "application/json");

	ТелоЗапроса = "scope=GIGACHAT_API_PERS";
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);

	Возврат Запрос;

КонецФункции

Функция СформироватьСтруктуруТокенаGigaChat(ОтветJSON)

	СтруктураТокена = Новый Структура;
	СтруктураТокена.Вставить("ТокенДоступа", ОтветJSON["access_token"]);
	// expires_at провайдера - абсолютное Unix-время; нормализуем к мс (аудит P2 #4).
	// Прежняя формула «мс - мс/1000» была размерно битой и все равно отбрасывалась вызывателем.
	СтруктураТокена.Вставить("ВремяИстеченияMС",
		НормализоватьВремяИстеченияВMС(ОтветJSON["expires_at"]));

	Возврат СтруктураТокена;

КонецФункции

#КонецОбласти

#Область ФормированиеЗапроса

Функция ПодготовитьПромпт(Промпт)
	
	СтруктураПромпта = Новый Структура;
	СтруктураПромпта.Вставить("ЕстьИзображения", Ложь);
	СтруктураПромпта.Вставить("СистемныйПромпт", "");
	СтруктураПромпта.Вставить("ПользовательскийПромпт", "");
	СтруктураПромпта.Вставить("ИсторияСообщений", Новый Массив);
	// Function-calling: массив OpenAI tool-деклараций. Пусто - обычный запрос без инструментов.
	// Заполняется вызывающим кодом (петля агент-анализа) через Промпт-структуру.
	СтруктураПромпта.Вставить("Инструменты", Новый Массив);
	// Многоходовый режим: готовый массив messages (system/user/assistant+tool_calls/tool).
	// Пусто - messages собираются из СистемныйПромпт/ПользовательскийПромпт/ИсторияСообщений.
	// Непусто - используется дословно (петля агент-анализа сама ведет диалог с инструментами).
	СтруктураПромпта.Вставить("СырыеСообщения", Новый Массив);
	
	Если ТипЗнч(Промпт) = Тип("Строка") Тогда
		СтруктураПромпта.ПользовательскийПромпт = Промпт;
	ИначеЕсли ТипЗнч(Промпт) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(СтруктураПромпта, Промпт);
	Иначе
		ВызватьИсключение НСтр("ru = 'Неверный тип параметра Промпт. Ожидается Строка или Структура'");
	КонецЕсли;
	
	СтруктураПромпта.ЕстьИзображения = Ложь;
	Если ТипЗнч(СтруктураПромпта.ПользовательскийПромпт) = Тип("Массив") Тогда
		ВалидироватьМассивКонтентаПромпта(СтруктураПромпта);
	КонецЕсли;
	
	Возврат СтруктураПромпта;
	
КонецФункции

Процедура ВалидироватьМассивКонтентаПромпта(СтруктураПромпта)
	
	НомерЭлемента = 0;
	Для Каждого ЭлементКонтента Из СтруктураПромпта.ПользовательскийПромпт Цикл
		НомерЭлемента = НомерЭлемента + 1;
		ВалидироватьЭлементКонтентаПромпта(ЭлементКонтента, НомерЭлемента, СтруктураПромпта);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВалидироватьЭлементКонтентаПромпта(ЭлементКонтента, НомерЭлемента, СтруктураПромпта)
	
	Если ТипЗнч(ЭлементКонтента) <> Тип("Структура") Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Элемент мультимодального промпта №%1 должен быть структурой'"),
			НомерЭлемента);
	КонецЕсли;
	
	ТипКонтента = "";
	Если Не ЭлементКонтента.Свойство("Тип", ТипКонтента) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Элемент мультимодального промпта №%1 должен содержать строковое поле Тип'"),
			НомерЭлемента);
	КонецЕсли;
	
	Если ТипЗнч(ТипКонтента) <> Тип("Строка") Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Элемент мультимодального промпта №%1 должен содержать строковое поле Тип'"),
			НомерЭлемента);
	КонецЕсли;
	
	Если ТипКонтента = "text" Тогда
		ВалидироватьТекстовыйЭлементКонтента(ЭлементКонтента, НомерЭлемента);
	ИначеЕсли ТипКонтента = "image" Тогда
		ВалидироватьЭлементИзображенияКонтента(ЭлементКонтента, НомерЭлемента);
		СтруктураПромпта.ЕстьИзображения = Истина;
	ИначеЕсли ТипКонтента = "document" Тогда
		ВалидироватьЭлементДокументаКонтента(ЭлементКонтента, НомерЭлемента);
		СтруктураПромпта.ЕстьИзображения = Истина;
	Иначе
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Недопустимый тип элемента мультимодального промпта №%1: %2.
				|Ожидается text, image или document'"),
			НомерЭлемента,
			ТипКонтента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВалидироватьТекстовыйЭлементКонтента(ЭлементКонтента, НомерЭлемента)
	
	Текст = "";
	Если Не ЭлементКонтента.Свойство("Текст", Текст) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Текстовый элемент мультимодального промпта №%1 должен содержать строковое поле Текст'"),
			НомерЭлемента);
	КонецЕсли;
	
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Текстовый элемент мультимодального промпта №%1 должен содержать строковое поле Текст'"),
			НомерЭлемента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВалидироватьЭлементИзображенияКонтента(ЭлементКонтента, НомерЭлемента)
	
	URL = "";
	ЕстьURL = Ложь;
	Если ЭлементКонтента.Свойство("URL", URL) Тогда
		Если ТипЗнч(URL) = Тип("Строка") Тогда
			ЕстьURL = ЗначениеЗаполнено(URL);
		КонецЕсли;
	КонецЕсли;
	
	ДвоичныеДанные = Неопределено;
	ЕстьДвоичныеДанные = Ложь;
	Если ЭлементКонтента.Свойство("ДвоичныеДанные", ДвоичныеДанные) Тогда
		ЕстьДвоичныеДанные = ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные");
	КонецЕсли;
	
	MIME = "";
	ЕстьMIME = Ложь;
	Если ЭлементКонтента.Свойство("MIME", MIME) Тогда
		ЕстьMIME = ЭтоMIMEИзображения(MIME);
	КонецЕсли;
	
	Если Не ЕстьURL И Не (ЕстьДвоичныеДанные И ЕстьMIME) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Элемент изображения мультимодального промпта №%1 должен содержать URL
				|либо ДвоичныеДанные и MIME image/*'"),
			НомерЭлемента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВалидироватьЭлементДокументаКонтента(ЭлементКонтента, НомерЭлемента)
	
	ДвоичныеДанные = Неопределено;
	ЕстьДвоичныеДанные = Ложь;
	Если ЭлементКонтента.Свойство("ДвоичныеДанные", ДвоичныеДанные) Тогда
		ЕстьДвоичныеДанные = ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные");
	КонецЕсли;
	
	MIME = "";
	ЕстьMIME = Ложь;
	Если ЭлементКонтента.Свойство("MIME", MIME) Тогда
		ЕстьMIME = ТипЗнч(MIME) = Тип("Строка") И ЗначениеЗаполнено(MIME);
	КонецЕсли;
	
	Если Не (ЕстьДвоичныеДанные И ЕстьMIME) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Элемент документа мультимодального промпта №%1 должен содержать ДвоичныеДанные и MIME'"),
			НомерЭлемента);
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоMIMEИзображения(Знач MIME)
	
	Если ТипЗнч(MIME) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрДлина(MIME) <= 6 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Лев(НРег(MIME), 6) = "image/";
	
КонецФункции

Процедура СформироватьЗаголовкиИТелоПоМодели(Параметры, КлючAPI, СтруктураПромпта, Заголовки, ТелоЗапроса)
	
	Модуль = ПолучитьМодульПровайдера(Параметры.ТипФорматаAPI);
	Модуль.СформироватьЗаголовки(Параметры, КлючAPI, Заголовки);
	Модуль.СформироватьТелоЗапроса(Параметры, СтруктураПромпта, ТелоЗапроса);
	
	Для Каждого Заголовок Из Параметры.Заголовки Цикл
		Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает CommonModule провайдера по типу формата API.
// Регистрация новых провайдеров - добавлением ветки в эту функцию.
//
// Параметры:
//  ТипФорматаAPI - ПеречислениеСсылка.КИИ_ТипыФорматовAPI
//
// Возвращаемое значение:
//  CommonModule - провайдер-модуль с контрактом ИмяФормата / ПоддерживаетМультимодал /
//                 СформироватьЗаголовки / СформироватьТелоЗапроса / РазобратьОтвет
//
Функция ПолучитьМодульПровайдера(ТипФорматаAPI)
	
	Если ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible Тогда
		Возврат КИИ_КоннекторOpenAI;
	ИначеЕсли ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.Anthropic Тогда
		Возврат КИИ_КоннекторAnthropic;
	ИначеЕсли ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.Google Тогда
		Возврат КИИ_КоннекторGoogle;
	ИначеЕсли ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.Yandex Тогда
		Возврат КИИ_КоннекторYandex;
	ИначеЕсли ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.GigaChat Тогда
		Возврат КИИ_КоннекторGigaChat;
	Иначе
		ВызватьИсключение НСтр("ru = 'Неподдерживаемый формат API'");
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОбработкаОтвета

Процедура ОбработатьОтветПоТипуМодели(Параметры, ОтветJSON, Результат)

	Если КИИ_КоннекторИИОбщий.ЕстьОшибкаВОтветеAPI(ОтветJSON, Результат) Тогда
		Возврат;
	КонецЕсли;

	Модуль = ПолучитьМодульПровайдера(Параметры.ТипФорматаAPI);
	Модуль.РазобратьОтвет(ОтветJSON, Результат);
	ПометитьНевалидныйОтвет(Результат);

КонецПроцедуры

// Пустой/заблокированный ответ провайдера = ошибка, не успех: (а) текст не строка (напр.
// content=null у OpenAI); (б) пустая строка при причине завершения, сигналящей фильтр/обрыв
// (content_filter/SAFETY/RECITATION/length/max_tokens/truncated). Иначе потребитель
// (RAG/диагностика ошибок) примет пустышку за валидный анализ (аудит P1/P2).
Процедура ПометитьНевалидныйОтвет(Результат)

	Если Результат.ЭтоОшибка Тогда
		Возврат;
	КонецЕсли;

	// Function-calling: при вызове инструментов content приходит null (finish_reason="tool_calls").
	// Это ВАЛИДНЫЙ ответ - модель просит выполнить инструмент, а не пустышка. Нормализуем текст в "".
	Если Результат.Свойство("ВызовыИнструментов") И Результат.ВызовыИнструментов.Количество() > 0 Тогда
		Если ТипЗнч(Результат.ТекстОтвета) <> Тип("Строка") Тогда
			Результат.ТекстОтвета = "";
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ТекстОтвета = Результат.ТекстОтвета;
	Если ТипЗнч(ТекстОтвета) = Тип("Строка") И ЗначениеЗаполнено(ТекстОтвета) Тогда
		Возврат;
	КонецЕсли;

	НетСтроки = (ТипЗнч(ТекстОтвета) <> Тип("Строка"));

	// Пустая строка без tool_calls - тоже потеря ответа: "пустой успешный совет" бесполезен
	// и маскирует сбой (напр. reasoning-модель съела весь бюджет токенов на размышления).
	Если НетСтроки Или ПустаяСтрока(ТекстОтвета) Или ПричинаСигналитОбрыв(Результат.ПричинаЗавершения) Тогда
		Результат.ЭтоОшибка = Истина;
		Если НетСтроки Тогда
			Результат.ТекстОтвета = "";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
			Результат.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Пустой ответ модели (причина завершения: %1)'"),
				Строка(Результат.ПричинаЗавершения));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Причина завершения сигналит фильтр/обрыв контента (пустой текст при ней = потеря ответа,
// а не валидный пустой результат).
Функция ПричинаСигналитОбрыв(Знач ПричинаЗавершения)

	ПричинаНРег = НРег(Строка(ПричинаЗавершения));
	Если Не ЗначениеЗаполнено(ПричинаНРег) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Сигнал Из СтрРазделить("content_filter,safety,recitation,length,max_tokens,truncated", ",", Ложь) Цикл
		Если СтрНайти(ПричинаНРег, Сигнал) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область Логирование

Процедура ЗаписатьЛогИИ(Модель, СтруктураПромпта, Результат, ИзКеша = Ложь, КорреляцияАгента = "")
	
	МенеджерЗаписи = РегистрыСведений.КИИ_ЛогЗапросовИИ.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Заполнить(Неопределено); 
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Результат);
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураПромпта);
	МенеджерЗаписи.ИзКеша = ИзКеша;
	МенеджерЗаписи.КорреляцияАгента = КорреляцияАгента;
	
	Если СтруктураПромпта.Свойство("ИсторияСообщений") 
		И СтруктураПромпта.ИсторияСообщений.Количество() > 0 Тогда
		
		Попытка
			МенеджерЗаписи.ИсторияСообщенийJSON = ОбщегоНазначения.ЗначениеВJSON(СтруктураПромпта.ИсторияСообщений);
		Исключение
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Ошибка сериализации истории сообщений: %1'"),
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'КИИ.Логирование'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеФункции

// Создает новую структуру параметров ответа от модели ИИ
//
// Возвращаемое значение:
//  Структура - параметры ответа с полями:
//    * ЭтоОшибка - Булево - признак ошибки выполнения запроса
//    * ТекстОшибки - Строка - текст ошибки (пустая строка при успехе)
//    * ТекстОтвета - Строка - текст ответа от модели ИИ
//    * ВходныеТокены - Число - количество токенов во входном запросе
//    * ВыходныеТокены - Число - количество токенов в ответе
//    * ВсегоТокенов - Число - общее количество использованных токенов
//    * ВыходныеТокеныВКеше - Число - количество закэшированных токенов
//    * ВремяОтветаСекунд - Число - время выполнения запроса в секундах
//    * СтоимостьОтвета - Число - стоимость запроса (если поддерживается провайдером)
//    * Модель - СправочникСсылка.КИИ_МоделиИИ, Неопределено - использованная модель
//    * МодельОтвета - Строка - фактическое имя модели из ответа провайдера
//    * ДатаЗапроса - Дата, Неопределено - дата и время начала запроса
//    * ДатаСоздания - Дата, Неопределено - дата создания ответа по данным провайдера
//    * ПричинаЗавершения - Строка - причина завершения генерации (stop, length и т.д.)
//    * Идентификатор - УникальныйИдентификатор - уникальный идентификатор записи лога
//    * УниверсальнаяДатаВМиллисекундах - Число - универсальное время в миллисекундах
//    * IDЗапроса - Строка - идентификатор запроса от провайдера
//    * ТипОбъекта - Строка - тип объекта ответа
//    * ТарифСервиса - Строка - использованный тариф сервиса
//    * ХэшМодели - Строка - отпечаток версии модели (system_fingerprint)
//
Функция НовыйПараметрыОтветаИИ()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ЭтоОшибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТекстОтвета", "");
	
	Результат.Вставить("ВходныеТокены", 0);
	Результат.Вставить("ВыходныеТокены", 0);
	Результат.Вставить("ВсегоТокенов", 0);
	Результат.Вставить("ВыходныеТокеныВКеше", 0);
	Результат.Вставить("ВремяОтветаСекунд", 0);
	Результат.Вставить("СтоимостьОтвета", 0);
	
	Результат.Вставить("Модель", Неопределено);
	Результат.Вставить("МодельОтвета", "");
	Результат.Вставить("Идентификатор", Новый УникальныйИдентификатор());
	Результат.Вставить("IDЗапроса", "");
	
	Результат.Вставить("ДатаЗапроса", Неопределено);
	Результат.Вставить("ДатаСоздания", Неопределено);
	Результат.Вставить("УниверсальнаяДатаВМиллисекундах", ТекущаяУниверсальнаяДатаВМиллисекундах());
	
	Результат.Вставить("ПричинаЗавершения", "");
	Результат.Вставить("ТипОбъекта", "");
	Результат.Вставить("ТарифСервиса", "");
	Результат.Вставить("ХэшМодели", "");
	
	Результат.Вставить("ВложенияОтвета", Новый Массив);

	// Function-calling: массив запрошенных моделью вызовов инструментов. Каждый элемент -
	// Структура {Идентификатор, Имя, Аргументы (Строка JSON)}. Пусто, если модель ответила текстом.
	Результат.Вставить("ВызовыИнструментов", Новый Массив);

	Возврат Результат;

КонецФункции

// Конструктор элемента вложения ОТВЕТА ИИ (картинка/документ, возвращенные моделью).
//
// Параметры:
//    ТипВложения   - Строка - "image" либо "document"
//    MIME          - Строка - MIME-тип
//    ДвоичныеДанные - ДвоичныеДанные - содержимое
//    ИмяФайла      - Строка - имя для представления
//    URL           - Строка - опционально, если провайдер вернул ссылку
//
// Возвращаемое значение:
//  Структура - элемент массива ВложенияОтвета:
//   * Тип - Строка - "image" | "document"
//   * MIME - Строка - MIME-тип
//   * ДвоичныеДанные - ДвоичныеДанные - содержимое
//   * ИмяФайла - Строка - имя файла
//   * URL - Строка - ссылка (если провайдер вернул)
//   * РазмерБайт - Число - размер содержимого в байтах
//
Функция НовоеВложениеОтвета(Знач ТипВложения, Знач MIME, Знач ДвоичныеДанные, Знач ИмяФайла, Знач URL = "") Экспорт
	
	Если ТипВложения <> "image" И ТипВложения <> "document" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Недопустимый тип вложения ответа: %1'"), ТипВложения);
	КонецЕсли;
	
	РазмерБайт = 0;
	Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
		РазмерБайт = ДвоичныеДанные.Размер();
	КонецЕсли;
	
	Стр = Новый Структура;
	Стр.Вставить("Тип", ТипВложения);
	Стр.Вставить("MIME", MIME);
	Стр.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	Стр.Вставить("ИмяФайла", ИмяФайла);
	Стр.Вставить("URL", URL);
	Стр.Вставить("РазмерБайт", РазмерБайт);
	Возврат Стр;
	
КонецФункции

Функция ТелоЗапросаГенерацииЧерезChat(Знач Параметры, Знач СтруктураПромпта)
	
	ТекстПромпта = СтруктураПромпта.ПользовательскийПромпт;
	Если ТипЗнч(ТекстПромпта) <> Тип("Строка") Тогда
		ТекстПромпта = "";
	КонецЕсли;
	
	СообщениеПользователя = Новый Структура;
	СообщениеПользователя.Вставить("role", "user");
	СообщениеПользователя.Вставить("content", ТекстПромпта);
	
	Сообщения = Новый Массив;
	Сообщения.Добавить(СообщениеПользователя);
	
	Модальности = Новый Массив;
	Модальности.Добавить("image");
	Модальности.Добавить("text");
	
	Тело = Новый Структура;
	Тело.Вставить("model", Параметры.НаименованиеПолное);
	Тело.Вставить("messages", Сообщения);
	Тело.Вставить("modalities", Модальности);
	Возврат Тело;
	
КонецФункции

Функция ТелоЗапросаГенерацииOpenAI(Знач Параметры, Знач СтруктураПромпта)
	
	Если СтрНайти(НРег(Параметры.АдресЗапроса), "chat/completions") > 0 Тогда
		Возврат ТелоЗапросаГенерацииЧерезChat(Параметры, СтруктураПромпта);
	КонецЕсли;
	
	ТекстПромпта = СтруктураПромпта.ПользовательскийПромпт;
	Если ТипЗнч(ТекстПромпта) <> Тип("Строка") Тогда
		ТекстПромпта = "";
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("model", Параметры.НаименованиеПолное);
	Тело.Вставить("prompt", ТекстПромпта);
	Тело.Вставить("n", 1);
	Тело.Вставить("size", "auto");
	Возврат Тело;
	
КонецФункции

Процедура РазобратьОтветГенерацииЧерезChat(Знач ОтветJSON, Результат)
	
	Сообщение = СообщениеГенерацииИзОтвета(ОтветJSON, Результат);
	Если Сообщение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементИзображения Из Сообщение.images Цикл
		ДобавитьИзображениеИзЭлемента(ЭлементИзображения, Результат);
	КонецЦикла;
	
	Если Результат.ВложенияОтвета.Количество() = 0 Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось извлечь изображение из ответа'");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьМетаданныеГенерации(ОтветJSON, Сообщение, Результат);
	
КонецПроцедуры

// Возвращает message первого choice с массивом картинок либо Неопределено,
// взводя признак и текст ошибки в Результат.
Функция СообщениеГенерацииИзОтвета(Знач ОтветJSON, Результат)

	ОтветБезВыборок = Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON)
		Или Не ОтветJSON.Свойство("choices")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(ОтветJSON.choices)
		Или ОтветJSON.choices.Количество() = 0;
	Если ОтветБезВыборок Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Ответ генерации изображения не содержит choices'");
		Возврат Неопределено;
	КонецЕсли;

	Сообщение = ОтветJSON.choices[0].message;
	СообщениеБезКартинок = Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Сообщение)
		Или Не Сообщение.Свойство("images")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(Сообщение.images)
		Или Сообщение.images.Количество() = 0;
	Если СообщениеБезКартинок Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Ответ генерации изображения не содержит images'");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Сообщение;

КонецФункции

// Извлекает картинку из элемента images (data-URL с base64-полезной нагрузкой)
// и добавляет во вложения ответа. Элементы неожиданной формы молча пропускаются.
Процедура ДобавитьИзображениеИзЭлемента(Знач ЭлементИзображения, Результат)

	ЭлементБезСсылки = Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ЭлементИзображения)
		Или Не ЭлементИзображения.Свойство("image_url")
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ЭлементИзображения.image_url)
		Или Не ЭлементИзображения.image_url.Свойство("url");
	Если ЭлементБезСсылки Тогда
		Возврат;
	КонецЕсли;

	URLИзображения = ЭлементИзображения.image_url.url;
	Если ТипЗнч(URLИзображения) <> Тип("Строка") Или СтрНайти(URLИзображения, "base64,") = 0 Тогда
		Возврат;
	КонецЕсли;

	ПозицияБаза64 = СтрНайти(URLИзображения, "base64,");
	ПрефиксDataURL = Лев(URLИзображения, ПозицияБаза64 - 1);
	ТипКонтента = "image/png";
	ПозицияТочкаЗапятая = СтрНайти(ПрефиксDataURL, ";");
	Если Лев(ПрефиксDataURL, 5) = "data:" И ПозицияТочкаЗапятая > 6 Тогда
		ТипКонтента = Сред(ПрефиксDataURL, 6, ПозицияТочкаЗапятая - 6);
	КонецЕсли;

	ПолезнаяНагрузка = Сред(URLИзображения, ПозицияБаза64 + 7);
	ДвоичныеИзображения = Base64Значение(ПолезнаяНагрузка);
	Вложение = НовоеВложениеОтвета("image", ТипКонтента, ДвоичныеИзображения, "generated-image");
	Результат.ВложенияОтвета.Добавить(Вложение);

КонецПроцедуры

// Заполняет текст ответа и метаданные генерации (модель, учет токенов).
Процедура ЗаполнитьМетаданныеГенерации(Знач ОтветJSON, Знач Сообщение, Результат)

	ТекстСообщения = "";
	Если Сообщение.Свойство("content") И ТипЗнч(Сообщение.content) = Тип("Строка") Тогда
		ТекстСообщения = Сообщение.content;
	КонецЕсли;
	Если ПустаяСтрока(ТекстСообщения) Тогда
		ТекстСообщения = НСтр("ru = 'Изображение сгенерировано'");
	КонецЕсли;
	Результат.ТекстОтвета = ТекстСообщения;

	Если ОтветJSON.Свойство("model") Тогда
		Результат.МодельОтвета = ОтветJSON.model;
	КонецЕсли;
	ЕстьУчетТокенов = ОтветJSON.Свойство("usage") И КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON.usage)
		И ОтветJSON.usage.Свойство("total_tokens");
	Если ЕстьУчетТокенов Тогда
		Результат.ВсегоТокенов = ОтветJSON.usage.total_tokens;
	КонецЕсли;

КонецПроцедуры

Процедура РазобратьОтветГенерацииOpenAI(Знач ОтветJSON, Результат)
	
	Если КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON) И ОтветJSON.Свойство("choices") Тогда
		РазобратьОтветГенерацииЧерезChat(ОтветJSON, Результат);
		Возврат;
	КонецЕсли;
	
	ОтветБезДанных = Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON)
		Или Не ОтветJSON.Свойство("data")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(ОтветJSON.data)
		Или ОтветJSON.data.Количество() = 0;
	Если ОтветБезДанных Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Ответ генерации изображения не содержит data'");
		Возврат;
	КонецЕсли;
	
	ПервыйЭлемент = ОтветJSON.data[0];
	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ПервыйЭлемент) Или Не ПервыйЭлемент.Свойство("b64_json") Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Ответ генерации изображения не содержит b64_json'");
		Возврат;
	КонецЕсли;
	
	ДвоичныеИзображения = Base64Значение(ПервыйЭлемент.b64_json);
	Результат.ВложенияОтвета.Добавить(
		НовоеВложениеОтвета("image", "image/png", ДвоичныеИзображения, "generated-image"));
	Результат.ТекстОтвета = НСтр("ru = 'Изображение сгенерировано'");
	
КонецПроцедуры

Процедура ВыполнитьГенерациюИзображенияOpenAI(Знач Модель, Знач Параметры, Знач КлючAPI,
	Знач СтруктураПромпта, Результат, Знач ДатаНачала)
	
	Заголовки = Новый Соответствие;
	КИИ_КоннекторOpenAI.СформироватьЗаголовки(Параметры, КлючAPI, Заголовки);
	
	Запрос = Новый HTTPЗапрос(Параметры.АдресЗапроса);
	Для Каждого Заголовок Из Заголовки Цикл
		Запрос.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;
	ТелоJSON = ОбщегоНазначения.ЗначениеВJSON(ТелоЗапросаГенерацииOpenAI(Параметры, СтруктураПромпта));
	Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);
	
	Соединение = СоздатьHTTPСоединение(Параметры);
	Ответ = ОтправитьЗапросСРетраем(Соединение, Запрос, Модель, Параметры, КлючAPI);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвета(Ответ, Результат);
		Возврат;
	КонецЕсли;
	
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	ОтветJSON = ОбщегоНазначения.JSONВЗначение(ТелоОтвета, , Ложь);
	РазобратьОтветГенерацииOpenAI(ОтветJSON, Результат);
	Результат.ВремяОтветаСекунд = (ТекущаяДатаСеанса() - ДатаНачала);
	Результат.Модель = Модель;
	Результат.ДатаЗапроса = ДатаНачала;
	
КонецПроцедуры

#КонецОбласти

Функция РасшифровкаКодаОшибки(КодHTTP, СтрОшибкаJSON = "")

	КодAPI = ИзвлечьКодОшибкиAPI(СтрОшибкаJSON);
	ТекстОшибки = ПолучитьОписаниеHTTPОшибки(КодHTTP);

	Если Не ПустаяСтрока(КодAPI) Тогда
		ОписаниеAPIОшибки = ПолучитьОписаниеAPIОшибки(КодAPI);

		Если ОписаниеAPIОшибки <> Неопределено Тогда
			ТекстОшибки = СтрШаблон("%1, %2", ТекстОшибки, ОписаниеAPIОшибки);
		КонецЕсли;
	КонецЕсли;

	Возврат ТекстОшибки;

КонецФункции

Функция ИзвлечьКодОшибкиAPI(СтрОшибкаJSON) Экспорт

	Если ПустаяСтрока(СтрОшибкаJSON) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		// Без 3-го аргумента JSONВЗначение вернул бы Соответствие, и проверка на Структуру молча
		// проваливалась - расшифровка кода была мертва (аудит P2). Читаем в Структуру рекурсивно.
		СтруктураОшибки = ОбщегоНазначения.JSONВЗначение(СтрОшибкаJSON, , Ложь);

		Если ТипЗнч(СтруктураОшибки) <> Тип("Структура") Тогда
			Возврат "";
		КонецЕсли;

		// Код API-ошибки вложен в error.code (OpenAI/совместимые), с fallback на верхнеуровневый code.
		Блок = СтруктураОшибки;
		Если СтруктураОшибки.Свойство("error") И ТипЗнч(СтруктураОшибки.error) = Тип("Структура") Тогда
			Блок = СтруктураОшибки.error;
		КонецЕсли;

		Если Блок.Свойство("code") И ЗначениеЗаполнено(Блок.code) Тогда
			Возврат Строка(Блок.code);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КИИ.HTTPОшибка'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат "";

КонецФункции

Функция ПолучитьОписаниеHTTPОшибки(КодHTTP)

	КартаHTTP = Новый Соответствие;
	КартаHTTP.Вставить(400, НСтр("ru = 'Неверный запрос (400)'"));
	КартаHTTP.Вставить(401, НСтр("ru = 'Ключ API отсутствует или недействителен (401)'"));
	КартаHTTP.Вставить(403, НСтр("ru = 'Доступ запрещен (403)'"));
	КартаHTTP.Вставить(404, НСтр("ru = 'Ресурс не найден (404)'"));
	КартаHTTP.Вставить(429, НСтр("ru = 'Превышен лимит запросов или квота (429)'"));
	КартаHTTP.Вставить(500, НСтр("ru = 'Внутренняя ошибка сервера (500)'"));
	КартаHTTP.Вставить(502, НСтр("ru = 'Bad Gateway (502)'"));
	КартаHTTP.Вставить(503, НСтр("ru = 'Сервис временно недоступен (503)'"));
	КартаHTTP.Вставить(504, НСтр("ru = 'Gateway Timeout (504)'"));

	ОписаниеКодаОшибки = КартаHTTP.Получить(КодHTTP);

	Если ОписаниеКодаОшибки = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'Неизвестная ошибка: %1'"), КодHTTP);
	КонецЕсли;

	Возврат ОписаниеКодаОшибки;

КонецФункции

Функция ПолучитьОписаниеAPIОшибки(КодAPI)

	КартаAPI = Новый Соответствие;
	КартаAPI.Вставить("invalid_api_key",         НСтр("ru = 'Ключ API недействителен или отозван'"));
	КартаAPI.Вставить("insufficient_quota",      НСтр("ru = 'Недостаточная квота для операции'"));
	КартаAPI.Вставить("context_length_exceeded", НСтр("ru = 'Превышена максимальная длина контекста'"));
	КартаAPI.Вставить("rate_limit_reached",      НСтр("ru = 'Достигнут предел скорости запросов'"));
	КартаAPI.Вставить("model_not_found",         НСтр("ru = 'Запрошенная модель не найдена'"));
	КартаAPI.Вставить("server_overloaded",       НСтр("ru = 'Сервер перегружен, попробуйте позже'"));
	КартаAPI.Вставить("timeout",                 НСтр("ru = 'Превышено время ожидания операции'"));

	Возврат КартаAPI.Получить(КодAPI);

КонецФункции

// ===== Локальный 1С-кеш ответов ИИ (Phase 1) =====
// См. _meta/план-кеш-rag-post-v1.0.md §9 (ревизия 2026-05-19).

// Gate: можно ли закешировать запрос. См. §9.1.
//
// Параметры:
//  Параметры        - Структура - параметры модели (см. ПараметрыМодели)
//  СтруктураПромпта - Структура - результат ПодготовитьПромпт
//
// Возвращаемое значение:
//  Булево - Истина если запрос допустимо кешировать
//
Функция КешироватьЗапрос(Параметры, СтруктураПромпта) Экспорт

	Если Не Параметры.Свойство("СрокЖизниКеша") Или Параметры.СрокЖизниКеша <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не Параметры.Свойство("ВерсияСхемыКеша") Или Параметры.ВерсияСхемыКеша <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_ImageGen Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Температура <> 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(СтруктураПромпта.ПользовательскийПромпт) = Тип("Массив") Тогда
		Возврат ЭлементыПромптаКешируемы(СтруктураПромпта.ПользовательскийПромпт);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Истина, если каждый элемент массива промпта кешируем: структура с полем Тип
// одного из известных видов контента (text/image/document).
Функция ЭлементыПромптаКешируемы(Знач ЭлементыПромпта)

	Для Каждого Элемент Из ЭлементыПромпта Цикл
		Если ТипЗнч(Элемент) <> Тип("Структура") Или Не Элемент.Свойство("Тип") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Элемент.Тип <> "text" И Элемент.Тип <> "image" И Элемент.Тип <> "document" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// SHA256-Base64 ключ кеша. См. §9.2.
//
// Параметры:
//  Модель           - СправочникСсылка.КИИ_МоделиИИ - модель ИИ
//  СтруктураПромпта - Структура - результат ПодготовитьПромпт
//  Параметры        - Структура - параметры модели (см. ПараметрыМодели)
//
// Возвращаемое значение:
//  Строка - Base64 от SHA256 канонической строки запроса
//
Функция ВычислитьХешЗапроса(Модель, СтруктураПромпта, Параметры) Экспорт

	Компоненты = Новый Массив;
	Компоненты.Добавить("v=" + Формат(Параметры.ВерсияСхемыКеша, "ЧГ=0"));
	Компоненты.Добавить("м=" + Строка(Модель.УникальныйИдентификатор()));
	Компоненты.Добавить("апи=" + Строка(Параметры.ТипФорматаAPI));
	Компоненты.Добавить("сис=" + Строка(СтруктураПромпта.СистемныйПромпт));
	Компоненты.Добавить("польз=" + СериализоватьПользовательскийПромпт(СтруктураПромпта.ПользовательскийПромпт));
	Компоненты.Добавить("ист=" + ОбщегоНазначения.ЗначениеВJSON(СтруктураПромпта.ИсторияСообщений));
	Компоненты.Добавить("t=" + Формат(Параметры.Температура, "ЧГ=0"));
	Компоненты.Добавить("max=" + Формат(Параметры.МаксимумТокенов, "ЧГ=0"));

	// Длина-префикс каждого компонента (netstring): разделитель Символы.ПС сам встречается
	// внутри значений (сис=/польз= многострочны), поэтому простое соединение через ПС давало
	// коллизии ключа кеша - разные запросы → одинаковый хеш → чужой ответ из кеша (аудит P1).
	// Длина делает кодирование биективным, коллизия невозможна.
	КанонСтрока = "";
	Для Каждого Компонент Из Компоненты Цикл
		КанонСтрока = КанонСтрока + Формат(СтрДлина(Компонент), "ЧГ=0") + ":" + Компонент + Символы.ПС;
	КонецЦикла;

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(КанонСтрока);

	Возврат Base64Строка(Хеширование.ХешСумма);

КонецФункции

// Стабильная сериализация ПользовательскийПромпт (для хеша).
// Мультимодал: image/document с ДвоичнымиДанными хешируются побайтно.
Функция СериализоватьПользовательскийПромпт(Промпт)

	Если ТипЗнч(Промпт) = Тип("Строка") Тогда
		Возврат "s|" + Промпт;
	КонецЕсли;

	Если ТипЗнч(Промпт) <> Тип("Массив") Тогда
		Возврат "?|" + Строка(Промпт);
	КонецЕсли;

	ХешиЭлементов = Новый Массив;
	Для Каждого Элемент Из Промпт Цикл
		Если Элемент.Тип = "text" Тогда
			ХешиЭлементов.Добавить("t|" + Элемент.Текст);
		ИначеЕсли Элемент.Тип = "image" Тогда
			Если Элемент.Свойство("ДвоичныеДанные") Тогда
				Х = Новый ХешированиеДанных(ХешФункция.SHA256);
				Х.Добавить(Элемент.ДвоичныеДанные);
				ХешиЭлементов.Добавить("ib|" + Элемент.MIME + "|" + Base64Строка(Х.ХешСумма));
			Иначе
				ХешиЭлементов.Добавить("iu|" + Элемент.URL);
			КонецЕсли;
		ИначеЕсли Элемент.Тип = "document" Тогда
			Х = Новый ХешированиеДанных(ХешФункция.SHA256);
			Х.Добавить(Элемент.ДвоичныеДанные);
			ХешиЭлементов.Добавить("d|" + Элемент.MIME + "|" + Элемент.ИмяФайла + "|" + Base64Строка(Х.ХешСумма));
		Иначе
			// Неизвестный тип элемента: включаем его тип в ключ кеша, иначе два разных
			// промпта с непонятным контентом схлопнулись бы в один кеш-ключ.
			ХешиЭлементов.Добавить("?|" + Строка(Элемент.Тип));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(ХешиЭлементов, ";");

КонецФункции

// Получить ответ из кеша; Неопределено если miss / expired / stale.
//
// Параметры:
//  ХешЗапроса             - Строка - ключ кеша (SHA256-Base64)
//  Модель                 - СправочникСсылка.КИИ_МоделиИИ - модель ИИ
//  ВерсияСхемыКешаТекущая - Число - текущая версия схемы кеша (для инвалидации)
//
// Возвращаемое значение:
//  Структура, Неопределено - кешированный результат ответа ИИ либо Неопределено при промахе
//
Функция ПолучитьИзКеша(ХешЗапроса, Модель, ВерсияСхемыКешаТекущая) Экспорт

	// Кеш - общая инфраструктура; регистр КИИ_КешОтветовИИ не входит в роль КИИ_БазовыеПрава,
	// а чтение шло ВЫШЕ основного Попытка → базовый пользователь падал «Недостаточно прав»
	// на любом запросе к ИИ (аудит P1). Читаем в привилегированном режиме; выборка строго по
	// (ХешЗапроса, Модель), поэтому перечислить чужой кеш нельзя - безопаснее blanket-Read роли.
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Кеш.Ответ КАК Ответ,
		|	Кеш.ВерсияСхемыКеша КАК ВерсияСхемыКеша,
		|	Кеш.ДатаДо КАК ДатаДо
		|ИЗ
		|	РегистрСведений.КИИ_КешОтветовИИ КАК Кеш
		|ГДЕ
		|	Кеш.ХешЗапроса = &ХешЗапроса
		|	И Кеш.Модель = &Модель";
	Запрос.УстановитьПараметр("ХешЗапроса", ХешЗапроса);
	Запрос.УстановитьПараметр("Модель", Модель);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЗначениеЗаполнено(Выборка.ДатаДо) И Выборка.ДатаДо < ТекущаяДатаСеанса() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Выборка.ВерсияСхемыКеша <> ВерсияСхемыКешаТекущая Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Результат = Выборка.Ответ.Получить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сохранить ответ в кеш (только если не ошибка). Идемпотентная перезапись.
// Race-стратегия: без блокировки вокруг HTTP. Параллельные miss → оба пишут
// идентичный ответ; second-write замещает first (одинаков). См. §9.3.
//
// Параметры:
//  ХешЗапроса - Строка - ключ кеша
//  Модель     - СправочникСсылка.КИИ_МоделиИИ - модель ИИ
//  Параметры  - Структура - параметры модели (см. ПараметрыМодели)
//  Результат  - Структура - результат ответа ИИ для сохранения
//
Процедура СохранитьВКеш(ХешЗапроса, Модель, Параметры, Результат) Экспорт

	Если Результат.ЭтоОшибка Тогда
		Возврат;
	КонецЕсли;

	// Запись под привилегированным режимом: регистр КИИ_КешОтветовИИ вне роли КИИ_БазовыеПрава,
	// иначе базовый пользователь молча не кеширует свои ответы (аудит P2/PLAUSIBLE).
	УстановитьПривилегированныйРежим(Истина);

	МенеджерЗаписи = РегистрыСведений.КИИ_КешОтветовИИ.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ХешЗапроса = ХешЗапроса;
	МенеджерЗаписи.Ответ = Новый ХранилищеЗначения(Результат);
	МенеджерЗаписи.Модель = Модель;
	МенеджерЗаписи.ДатаСоздания = ТекущаяДатаСеанса();
	МенеджерЗаписи.РазмерБайт = 0;
	МенеджерЗаписи.ВерсияСхемыКеша = Параметры.ВерсияСхемыКеша;
	МенеджерЗаписи.ДатаДо = ТекущаяДатаСеанса() + Параметры.СрокЖизниКеша;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Регламентное задание: удаляет просроченные записи кеша (ДатаДо < ТекущаяДатаСеанса()).
Процедура ОчиститьКешПросроченных() Экспорт

	Граница = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Кеш.ХешЗапроса КАК ХешЗапроса
		|ИЗ
		|	РегистрСведений.КИИ_КешОтветовИИ КАК Кеш
		|ГДЕ
		|	Кеш.ДатаДо < &Граница";
	Запрос.УстановитьПараметр("Граница", Граница);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.КИИ_КешОтветовИИ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ХешЗапроса.Установить(Выборка.ХешЗапроса);
		НаборЗаписей.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

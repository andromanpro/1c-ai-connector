#Область ПрограммныйИнтерфейс

// Проверяет реальную HTTP-публикацию MCP с введенными учетными данными API.
// Выполняется в фоновом задании; проверка ping не вызывает модель ИИ.
// Параметры:
//  Адрес - Строка - полный HTTP/HTTPS адрес /hs/iikona-mcp/rpc.
//  ПользовательAPI - Строка - имя пользователя API ИИконы.
//  ПарольAPI - Строка - пароль API ИИконы.
// Возвращаемое значение:
//  Строка - результат проверки без раскрытия пароля.
Функция ПроверитьПубликациюMCP(Знач Адрес, Знач ПользовательAPI, Знач ПарольAPI) Экспорт

	Если Не ЗначениеЗаполнено(Адрес) Или СтрНайти(Адрес, "<") > 0 Тогда
		Возврат НСтр("ru = 'Укажите настоящий адрес HTTP-публикации вместо шаблона.'");
	КонецЕсли;
	ПараметрыURL = ОбщегоНазначенияКлиентСервер.СтруктураURI(Адрес);
	НекорректныйАдресПубликации = (ПараметрыURL.Схема <> "http" И ПараметрыURL.Схема <> "https")
		Или Не ЗначениеЗаполнено(ПараметрыURL.Хост)
		Или Не ЗначениеЗаполнено(ПараметрыURL.ПутьНаСервере)
		Или ЗначениеЗаполнено(ПараметрыURL.Логин);
	Если НекорректныйАдресПубликации Тогда
		Возврат НСтр("ru = 'Введите полный адрес HTTP/HTTPS. Пользователь и пароль задаются в отдельных полях API.'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПользовательAPI) Или Не ЗначениеЗаполнено(ПарольAPI) Тогда
		Возврат НСтр("ru = 'Заполните пользователя и пароль API для проверки публикации.'");
	КонецЕсли;
	ЗащищенноеСоединение = Неопределено;
	Если ПараметрыURL.Схема = "https" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;
	Попытка
		Соединение = Новый HTTPСоединение(ПараметрыURL.Хост, ПараметрыURL.Порт, , , ,
			15, ЗащищенноеСоединение);
		ЗапросHTTP = Новый HTTPЗапрос("/" + ПараметрыURL.ПутьНаСервере);
		ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ДанныеАвторизации = ПолучитьДвоичныеДанныеИзСтроки(
			ПользовательAPI + ":" + ПарольAPI, КодировкаТекста.UTF8);
		ЗапросHTTP.Заголовки.Вставить("Authorization", "Basic " + Base64Строка(ДанныеАвторизации));
		ПараметрыВызова = Новый Структура;
		ПараметрыВызова.Вставить("name", "ping");
		ПараметрыВызова.Вставить("arguments", Новый Структура);
		Тело = Новый Структура;
		Тело.Вставить("jsonrpc", "2.0");
		Тело.Вставить("id", "ui-ping");
		Тело.Вставить("method", "tools/call");
		Тело.Вставить("params", ПараметрыВызова);
		ЗапросHTTP.УстановитьТелоИзСтроки(ОбщегоНазначения.ЗначениеВJSON(Тело), КодировкаТекста.UTF8);
		ОтветHTTP = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
		Возврат РазобратьОтветПроверкиПубликации(ОтветHTTP.КодСостояния, ОтветHTTP.ПолучитьТелоКакСтроку());
	Исключение
		Возврат НСтр("ru = 'HTTP-сервис недоступен. Проверьте адрес публикации, сеть и сертификат сервера.'");
	КонецПопытки;

КонецФункции

// Различает отказ авторизации, отсутствие публикации и успешный вызов ping.
// Параметры:
//  КодHTTP - Число - код состояния HTTP.
//  Тело - Строка - JSON-RPC ответ сервера.
// Возвращаемое значение:
//  Строка - описание результата проверки публикации.
Функция РазобратьОтветПроверкиПубликации(Знач КодHTTP, Знач Тело) Экспорт

	Если КодHTTP = 401 Или КодHTTP = 403 Тогда
		Возврат НСтр("ru = 'Отказ авторизации HTTP. Проверьте пользователя и пароль API, а также доступ к публикации.'");
	КонецЕсли;
	Если КодHTTP = 404 Тогда
		Возврат НСтр("ru = 'Публикация MCP не найдена (HTTP 404). Проверьте имя базы и путь /hs/iikona-mcp/rpc.'");
	КонецЕсли;
	Если КодHTTP <> 200 Тогда
		Возврат СтрШаблон(НСтр("ru = 'HTTP-сервис вернул код %1. Проверка MCP не завершена.'"), КодHTTP);
	КонецЕсли;
	Попытка
		Ответ = ОбщегоНазначения.JSONВЗначение(Тело, , Ложь);
		Если ПодтвержденОтветPing(Ответ) Тогда
			Возврат НСтр("ru = 'Публикация доступна: HTTP, авторизация API и MCP ping проверены. Модель ИИ не вызывалась.'");
		КонецЕсли;
	Исключение
		Возврат НСтр("ru = 'По адресу получен ответ, который не является JSON-RPC ответом MCP.'");
	КонецПопытки;
	Возврат НСтр("ru = 'HTTP отвечает, но MCP ping не подтвержден. Проверьте адрес и настройки сервиса.'");

КонецФункции

// Проверяет HTTP Basic Authorization header.
//
// Параметры:
//  ЗаголовокАвторизации - Строка - значение HTTP-заголовка Authorization
//
// Возвращаемое значение:
//  Структура:
//    * Авторизован  - Булево - результат проверки
//    * Пользователь - Строка - извлеченное имя пользователя
//    * Причина      - Строка - код причины результата проверки
//
Функция ПроверитьBasicAuth(Знач ЗаголовокАвторизации) Экспорт

	Пользователь = "";

	Если Не ЗначениеЗаполнено(ЗаголовокАвторизации) Тогда
		Возврат РезультатПроверки(Ложь, Пользователь, "no_header");
	КонецЕсли;

	Если НРег(Лев(ЗаголовокАвторизации, 6)) <> "basic " Тогда
		Возврат РезультатПроверки(Ложь, Пользователь, "invalid_format");
	КонецЕсли;

	Попытка
		Base64Часть = СокрЛП(Сред(ЗаголовокАвторизации, 7));
		Декодировано = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Base64Часть), КодировкаТекста.UTF8);
	Исключение
		Возврат РезультатПроверки(Ложь, Пользователь, "invalid_format");
	КонецПопытки;

	ПозицияРазделителя = СтрНайти(Декодировано, ":");
	Если ПозицияРазделителя = 0 Тогда
		Возврат РезультатПроверки(Ложь, Пользователь, "invalid_format");
	КонецЕсли;

	Пользователь = Лев(Декодировано, ПозицияРазделителя - 1);
	Пароль = Сред(Декодировано, ПозицияРазделителя + 1);

	Попытка
		ОжидаемыйПользователь = Константы.КИИ_СерверMCPПользовательAPI.Получить();
		ОжидаемыйПароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			"КИИ_СерверMCPПользовательAPI",
			"Пароль");
	Исключение
		Возврат РезультатПроверки(Ложь, Пользователь, "credentials_not_configured");
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ОжидаемыйПользователь)
		Или Не ЗначениеЗаполнено(ОжидаемыйПароль) Тогда

		Возврат РезультатПроверки(Ложь, Пользователь, "credentials_not_configured");

	КонецЕсли;

	ПользовательСовпал = СтрокиРавны_БезРаннихВыходов(Пользователь, ОжидаемыйПользователь);
	ПарольСовпал = СтрокиРавны_БезРаннихВыходов(Пароль, ОжидаемыйПароль);

	Если ПользовательСовпал И ПарольСовпал Тогда
		Возврат РезультатПроверки(Истина, Пользователь, "ok");
	КонецЕсли;

	Возврат РезультатПроверки(Ложь, Пользователь, "wrong_password");

КонецФункции

// Извлекает значение HTTP-заголовка из соответствия заголовков HTTPСервисЗапрос
// case-insensitive по имени (RFC 7230 §3.2 - field names are case-insensitive).
// Соответствие в 1С case-sensitive по ключу, а WHATWG fetch / Node.js / Python
// requests шлют header keys в нижнем регистре.
//
// Параметры:
//  Заголовки    - Соответствие из КлючИЗначение - заголовки HTTPСервисЗапрос
//  ИмяЗаголовка - Строка       - искомое имя заголовка
//
// Возвращаемое значение:
//  Строка - значение заголовка или пустая строка, если не найден
//
Функция ПолучитьЗаголовокЗапроса(Знач Заголовки, Знач ИмяЗаголовка) Экспорт

	Если Заголовки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ИмяНРег = НРег(ИмяЗаголовка);
	Для Каждого Заголовок Из Заголовки Цикл
		Если НРег(Заголовок.Ключ) = ИмяНРег Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РезультатПроверки(Знач Авторизован, Знач Пользователь, Знач Причина)

	Результат = Новый Структура;
	Результат.Вставить("Авторизован", Авторизован);
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Причина", Причина);
	Возврат Результат;

КонецФункции

Функция СтрокиРавны_БезРаннихВыходов(Знач ПерваяСтрока, Знач ВтораяСтрока)

	// Сравнение по SHA-256-хешам: фиксированная длина (64 hex) убирает утечку длины
	// секрета по таймингу (прежний ранний выход при разной длине выдавал длину пароля).
	// Побайтовое сравнение без ранних выходов.
	ХешПервый = ХешСтроки(ПерваяСтрока);
	ХешВторой = ХешСтроки(ВтораяСтрока);

	Расхождения = 0;

	Для Индекс = 1 По СтрДлина(ХешПервый) Цикл
		Если КодСимвола(ХешПервый, Индекс) <> КодСимвола(ХешВторой, Индекс) Тогда
			Расхождения = Расхождения + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Расхождения = 0;

КонецФункции

Функция ХешСтроки(Знач Значение)

	Хешировщик = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хешировщик.Добавить(Строка(Значение));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хешировщик.ХешСумма));

КонецФункции

Функция ПодтвержденОтветPing(Знач Ответ)

	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Версия = Неопределено;
	Идентификатор = Неопределено;
	Ответ.Свойство("jsonrpc", Версия);
	Ответ.Свойство("id", Идентификатор);
	Если Версия <> "2.0" Или Идентификатор <> "ui-ping" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Ответ.Свойство("error") Тогда
		Возврат Ложь;
	КонецЕсли;
	Результат = Неопределено;
	Если Не Ответ.Свойство("result", Результат) Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Успех = Неопределено;
	Инструмент = Неопределено;
	Результат.Свойство("ok", Успех);
	Результат.Свойство("tool", Инструмент);
	Если Успех <> Истина Или Инструмент <> "ping" Тогда
		Возврат Ложь;
	КонецЕсли;
	Данные = Неопределено;
	Если Не Результат.Свойство("data", Данные) Или ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Pong = Ложь;
	Возврат Данные.Свойство("pong", Pong) И Pong = Истина;

КонецФункции

#КонецОбласти

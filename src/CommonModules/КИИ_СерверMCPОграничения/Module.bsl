#Область ПрограммныйИнтерфейс

// Возвращает НЕспуфабельный ключ бакета ограничений из результата аутентификации.
// Аутентифицированный запрос → per-user бакет (по имени пользователя). Неаутенти-
// фицированный → единый глобальный бакет: атакующий НЕ может получить свежий бакет
// ротацией заявленного username / заголовка X-Forwarded-For (закрывает обход
// rate-limit перебором пароля, дефект D8). Заявленный идентификатор пригоден только
// для аудита (форензика), но НЕ как ключ ограничения.
//
// Параметры:
//  РезультатAuth - Структура - результат КИИ_СерверMCPAuth.ПроверитьBasicAuth:
//    * Авторизован  - Булево - прошла ли аутентификация
//    * Пользователь - Строка - имя пользователя
//
// Возвращаемое значение:
//  Строка - ключ бакета ограничений (не длиннее 100 символов)
//
Функция ПолучитьКлючОграничения(Знач РезультатAuth) Экспорт

	АвторизованныйПользователь = ТипЗнч(РезультатAuth) = Тип("Структура")
		И РезультатAuth.Свойство("Авторизован")
		И РезультатAuth.Авторизован = Истина
		И ЗначениеЗаполнено(РезультатAuth.Пользователь);

	Если АвторизованныйПользователь Тогда
		Возврат "user:" + Лев(Строка(РезультатAuth.Пользователь), 90);
	КонецЕсли;

	Возврат КлючНеаутентифицированных();

КонецФункции

// Проверяет лимит вызовов 60/мин для одного caller.
// Не модифицирует регистр, только читает текущий счетчик.
//
// Параметры:
//  Вызывающий - Строка - идентификатор клиента
//  ДатаПроверки - Дата, Неопределено - момент проверки в UTC; Неопределено - текущее время.
//
// Возвращаемое значение:
//  Структура:
//    * Разрешено       - Булево - можно ли продолжить
//    * ОставшийсяЛимит - Число - сколько осталось до конца минуты
//    * ПовторитьЧерез  - Число - секунд до сброса счетчика
//
Функция ПроверитьЛимит(Знач Вызывающий, Знач ДатаПроверки = Неопределено) Экспорт
	
	// ДатаПроверки - сеам для детерминированных тестов (граница минуты давала флап);
	// прод не передает параметр и живет по текущему времени.
	Если ДатаПроверки = Неопределено Тогда
		ДатаПроверки = ТекущаяУниверсальнаяДата();
	КонецЕсли;
	КодМинуты = ПолучитьКодМинуты(ДатаПроверки);
	ТекущееКоличество = ПолучитьКоличествоВызовов(Вызывающий, КодМинуты);
	ТекущийЛимит = Лимит();
	
	Результат = Новый Структура;
	Результат.Вставить("Разрешено", ТекущееКоличество < ТекущийЛимит);
	ОстатокЛимита = ТекущийЛимит - ТекущееКоличество;
	Результат.Вставить("ОставшийсяЛимит", ?(ОстатокЛимита > 0, ОстатокЛимита, 0));
	Результат.Вставить("ПовторитьЧерез", 60 - Секунда(ДатаПроверки));
	Возврат Результат;

КонецФункции

// Атомарно проверяет и фиксирует лимит: под блокировкой (Вызывающий, КодМинуты)
// читает счетчик и, если он ниже лимита, инкрементит - все в ОДНОЙ транзакции.
// Закрывает гонку check→increment (несколько параллельных запросов проходили проверку
// по старому значению до инкремента). Отклоненный запрос счетчик НЕ трогает.
// При сбое учета запрос не выполняется; HTTP-обработчик возвращает временный отказ503.
//
// Параметры:
//  Вызывающий - Строка - идентификатор клиента
//  ДатаПроверки - Дата, Неопределено - момент проверки в UTC; Неопределено - текущее время.
//
// Возвращаемое значение:
//  Структура:
//    * Разрешено       - Булево - можно ли продолжить (и слот уже зафиксирован)
//    * ОставшийсяЛимит - Число - сколько осталось до конца минуты
//    * ПовторитьЧерез  - Число - секунд до сброса счетчика
//
//   * ОшибкаУчета - Булево - учет не выполнен из-за ошибки инфраструктуры.
//
Функция ПроверитьИЗафиксироватьЛимит(Знач Вызывающий) Экспорт

	ДатаПроверки = ТекущаяУниверсальнаяДата();
	КодМинуты = ПолучитьКодМинуты(ДатаПроверки);
	ТекущийЛимит = Лимит();

	Результат = Новый Структура;
	Результат.Вставить("Разрешено", Ложь);
	Результат.Вставить("ОставшийсяЛимит", 0);
	Результат.Вставить("ПовторитьЧерез", 60 - Секунда(ДатаПроверки));
	Результат.Вставить("ОшибкаУчета", Ложь);

	СобственнаяТранзакция = Не ТранзакцияАктивна();
	Попытка

		Если СобственнаяТранзакция Тогда
			НачатьТранзакцию();
		КонецЕсли;
		Попытка

			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КИИ_СерверMCPОграниченияВызовов");
			ЭлементБлокировки.УстановитьЗначение("Вызывающий", Вызывающий);
			ЭлементБлокировки.УстановитьЗначение("КодМинуты", КодМинуты);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();

			НаборЗаписей = РегистрыСведений.КИИ_СерверMCPОграниченияВызовов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Вызывающий.Установить(Вызывающий);
			НаборЗаписей.Отбор.КодМинуты.Установить(КодМинуты);
			НаборЗаписей.Прочитать();

			ТекущееКоличество = 0;
			Если НаборЗаписей.Количество() > 0 Тогда
				ТекущееКоличество = НаборЗаписей[0].Количество;
			КонецЕсли;

			Если ТекущееКоличество < ТекущийЛимит Тогда
				НаборЗаписей.Очистить();
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Вызывающий = Вызывающий;
				НоваяЗапись.КодМинуты = КодМинуты;
				НоваяЗапись.Количество = ТекущееКоличество + 1;
				НаборЗаписей.Записать();
				Результат.Разрешено = Истина;
				Результат.ОставшийсяЛимит = ТекущийЛимит - (ТекущееКоличество + 1);
			КонецЕсли;

			Если СобственнаяТранзакция Тогда
				ЗафиксироватьТранзакцию();
			КонецЕсли;
		Исключение
			Если СобственнаяТранзакция Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ВызватьИсключение;
		КонецПопытки;

	Исключение

		Если Не СобственнаяТранзакция Тогда
			ВызватьИсключение;
		КонецЕсли;

		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КИИ.СерверMCP.Ограничения'"), УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Результат.Разрешено = Ложь;
		Результат.ОставшийсяЛимит = 0;
		Результат.ОшибкаУчета = Истина;

	КонецПопытки;

	Возврат Результат;

КонецФункции

// Увеличивает счетчик вызовов на 1 для текущей минуты.
//
// Параметры:
//  Вызывающий - Строка - идентификатор клиента
//  ДатаПроверки - Дата, Неопределено - момент проверки в UTC; Неопределено - текущее время.
//
Процедура ЗафиксироватьВызов(Знач Вызывающий, Знач ДатаПроверки = Неопределено) Экспорт
	
	// ДатаПроверки - сеам для детерминированных тестов (см. ПроверитьЛимит).
	Если ДатаПроверки = Неопределено Тогда
		ДатаПроверки = ТекущаяУниверсальнаяДата();
	КонецЕсли;
	КодМинуты = ПолучитьКодМинуты(ДатаПроверки);
	
	СобственнаяТранзакция = Не ТранзакцияАктивна();
	Попытка
		
		Если СобственнаяТранзакция Тогда
			НачатьТранзакцию();
		КонецЕсли;
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КИИ_СерверMCPОграниченияВызовов");
			ЭлементБлокировки.УстановитьЗначение("Вызывающий", Вызывающий);
			ЭлементБлокировки.УстановитьЗначение("КодМинуты", КодМинуты);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			НаборЗаписей = РегистрыСведений.КИИ_СерверMCPОграниченияВызовов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Вызывающий.Установить(Вызывающий);
			НаборЗаписей.Отбор.КодМинуты.Установить(КодМинуты);
			НаборЗаписей.Прочитать();
			
			ТекущееКоличество = 0;
			Если НаборЗаписей.Количество() > 0 Тогда
				ТекущееКоличество = НаборЗаписей[0].Количество;
			КонецЕсли;
			
			НаборЗаписей.Очистить();
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Вызывающий = Вызывающий;
			НоваяЗапись.КодМинуты = КодМинуты;
			НоваяЗапись.Количество = ТекущееКоличество + 1;
			НаборЗаписей.Записать();
			
			Если СобственнаяТранзакция Тогда
				ЗафиксироватьТранзакцию();
			КонецЕсли;
		Исключение
			Если СобственнаяТранзакция Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ВызватьИсключение;
		КонецПопытки;
		
	Исключение
		
		Если Не СобственнаяТранзакция Тогда
			ВызватьИсключение;
		КонецЕсли;

		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КИИ.СерверMCP.Ограничения'"), УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

// Регламентный запуск; не вызывается из обработки каждого HTTP-запроса.
Процедура ВыполнитьОчисткуОграничений() Экспорт
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.КИИ_СерверMCPОграниченияОчистка);
	ОчиститьУстаревшиеЗаписи();
КонецПроцедуры

// Одна ограниченная порция служебных счетчиков старше прежнего пятиминутного окна.
// Транзакция вызывающего кода сохраняется; исключительная блокировка ставится до чтения.
// Возвращаемое значение:
//  Число - количество удаленных счетчиков в порции.
Функция ОчиститьУстаревшиеЗаписи() Экспорт
	ПорогМинуты = ПолучитьКодМинуты(ТекущаяУниверсальнаяДата() - 300);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500
		| Ограничения.Вызывающий КАК Вызывающий, Ограничения.КодМинуты КАК КодМинуты
		|ИЗ РегистрСведений.КИИ_СерверMCPОграниченияВызовов КАК Ограничения
		|ГДЕ Ограничения.КодМинуты < &ПорогМинуты
		|УПОРЯДОЧИТЬ ПО Ограничения.КодМинуты, Ограничения.Вызывающий";
	Запрос.УстановитьПараметр("ПорогМинуты", ПорогМинуты);
	Порция = Запрос.Выполнить().Выгрузить();
	Удалено = 0;
	СобственнаяТранзакция = Не ТранзакцияАктивна();
	Если СобственнаяТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Для Каждого КлючЗаписи Из Порция Цикл
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КИИ_СерверMCPОграниченияВызовов");
			ЭлементБлокировки.УстановитьЗначение("Вызывающий", КлючЗаписи.Вызывающий);
			ЭлементБлокировки.УстановитьЗначение("КодМинуты", КлючЗаписи.КодМинуты);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			НаборЗаписей = РегистрыСведений.КИИ_СерверMCPОграниченияВызовов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Вызывающий.Установить(КлючЗаписи.Вызывающий);
			НаборЗаписей.Отбор.КодМинуты.Установить(КлючЗаписи.КодМинуты);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 И КлючЗаписи.КодМинуты < ПорогМинуты Тогда
				НаборЗаписей.Очистить();
				НаборЗаписей.Записать();
				Удалено = Удалено + 1;
			КонецЕсли;
		КонецЦикла;
		Если СобственнаяТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СобственнаяТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Удалено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьКоличествоВызовов(Знач Вызывающий, Знач КодМинуты)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ограничения.Количество КАК Количество
	|ИЗ
	|	РегистрСведений.КИИ_СерверMCPОграниченияВызовов КАК Ограничения
	|ГДЕ
	|	Ограничения.Вызывающий = &Вызывающий
	|	И Ограничения.КодМинуты = &КодМинуты";
	
	Запрос.УстановитьПараметр("Вызывающий", Вызывающий);
	Запрос.УстановитьПараметр("КодМинуты", КодМинуты);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьКодМинуты(Знач ДатаМинуты)
	
	Возврат Формат(ДатаМинуты, "ДФ='yyyy-MM-dd-HH-mm'");
	
КонецФункции

Функция КлючНеаутентифицированных()

	Возврат "anon:global";

КонецФункции

Функция Лимит()

	Возврат 60;

КонецФункции

#КонецОбласти

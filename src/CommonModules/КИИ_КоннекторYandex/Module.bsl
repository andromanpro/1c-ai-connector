#Область ПрограммныйИнтерфейс

// Возвращает значение перечисления типа формата API, который покрывает данный провайдер.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.КИИ_ТипыФорматовAPI
//
Функция ИмяФормата() Экспорт
	Возврат Перечисления.КИИ_ТипыФорматовAPI.Yandex;
КонецФункции

// Признак поддержки мультимодального ввода (изображения, файлы и т.п.).
// На текущем этапе разноса - Ложь, расширяется отдельной задачей.
//
// Возвращаемое значение:
//  Булево
//
Функция ПоддерживаетМультимодал() Экспорт
	Возврат Ложь;
КонецФункции

// Заполняет соответствие HTTP-заголовков в соответствии с форматом YandexGPT.
//
// Параметры:
//  Параметры  - Структура - параметры модели (см. КИИ_КоннекторИИ.ПараметрыМодели)
//  КлючAPI    - Строка    - значение для заголовка Authorization (Api-Key <ключ>)
//  Заголовки  - Соответствие из КлючИЗначение - выходной параметр, HTTP-заголовки (имя → значение):
//   * Ключ - Строка - имя заголовка
//   * Значение - Строка - значение заголовка
//
Процедура СформироватьЗаголовки(Параметры, КлючAPI, Заголовки) Экспорт
	
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Api-Key " + КлючAPI);
	
КонецПроцедуры

// Формирует тело HTTP-запроса в формате YandexGPT completion.
//
// Параметры:
//  Параметры        - Структура - параметры модели
//  СтруктураПромпта - Структура - системный/пользовательский промпт + опционально история сообщений
//  ТелоЗапроса      - Структура - выходной параметр (modelUri, completionOptions, messages)
//
Процедура СформироватьТелоЗапроса(Параметры, СтруктураПромпта, ТелоЗапроса) Экспорт

	// Многоходовый режим (петля агент-анализа): диалог с tool-вызовами конвертируется
	// из OpenAI-формата сырых сообщений в messages YandexGPT (toolCallList/toolResultList).
	Если СтруктураПромпта.Свойство("СырыеСообщения")
		И КИИ_КоннекторИИОбщий.ЭтоМассив(СтруктураПромпта.СырыеСообщения)
		И СтруктураПромпта.СырыеСообщения.Количество() > 0 Тогда
		СформироватьТелоИзСырыхСообщений(Параметры, СтруктураПромпта, ТелоЗапроса);
		Возврат;
	КонецЕсли;

	МассивСообщений = СформироватьМассивСообщений(СтруктураПромпта);
	ПараметрыВызова = СформироватьПараметрыВызова(Параметры);

	ТелоЗапроса.Вставить("modelUri", Параметры.НаименованиеПолное);
	ТелоЗапроса.Вставить("completionOptions", ПараметрыВызова);
	ТелоЗапроса.Вставить("messages", МассивСообщений);

	// Инструменты нужны и в одноходовом режиме (первый ход диалога без сырых сообщений).
	ДобавитьИнструментыYandex(СтруктураПромпта, ТелоЗапроса);

КонецПроцедуры

// Разбирает JSON-ответ YandexGPT API и заполняет структуру результата.
// Не обрабатывает блок error - это делает общий КИИ_КоннекторИИОбщий.ЕстьОшибкаВОтветеAPI до диспетчеризации.
//
// Параметры:
//  ОтветJSON - Соответствие из КлючИЗначение - распарсенный JSON-ответ:
//   * Ключ - Строка - имя поля JSON
//   * Значение - Произвольный - значение поля
//  Результат - Структура    - выходной параметр (см. КИИ_КоннекторИИ.НовыйПараметрыОтветаИИ)
//
Процедура РазобратьОтвет(ОтветJSON, Результат) Экспорт

	ИзвлечьТекстОтвета(ОтветJSON, Результат);
	ИзвлечьМетаданные(ОтветJSON, Результат);
	ИзвлечьТокены(ОтветJSON, Результат);
	ИзвлечьВызовыИнструментов(ОтветJSON, Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ФормированиеЗапроса

Функция СформироватьМассивСообщений(СтруктураПромпта)

	МассивСообщений = Новый Массив;

	Если ЗначениеЗаполнено(СтруктураПромпта.СистемныйПромпт) Тогда
		СообщениеСистема = Новый Структура("role, text", "system", СтруктураПромпта.СистемныйПромпт);
		МассивСообщений.Добавить(СообщениеСистема);
	КонецЕсли;

	Если СтруктураПромпта.Свойство("ИсторияСообщений") Тогда
		ДобавитьИсториюСообщений(МассивСообщений, СтруктураПромпта.ИсторияСообщений);
	КонецЕсли;

	СообщениеПользователь = Новый Структура("role, text", "user",
		КИИ_КоннекторИИОбщий.ТекстПользовательскогоПромпта(СтруктураПромпта.ПользовательскийПромпт));
	МассивСообщений.Добавить(СообщениеПользователь);

	Возврат МассивСообщений;

КонецФункции

Процедура ДобавитьИсториюСообщений(МассивСообщений, ИсторияСообщений)

	Для Каждого Сообщение Из ИсторияСообщений Цикл
		СообщениеИстории = Новый Структура("role, text", Сообщение.Роль, Сообщение.Текст);
		МассивСообщений.Добавить(СообщениеИстории);
	КонецЦикла;

КонецПроцедуры

Функция СформироватьПараметрыВызова(Параметры)

	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("stream", Ложь);
	// Температуру шлем только если задана - как OpenAI/Anthropic/Google. Безусловная вставка
	// при незаполненном значении давала "temperature": null в теле запроса.
	Если ЗначениеЗаполнено(Параметры.Температура) Тогда
		ПараметрыВызова.Вставить("temperature", Параметры.Температура);
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.МаксимумТокенов) Тогда
		ПараметрыВызова.Вставить("maxTokens", Параметры.МаксимумТокенов);
	КонецЕсли;

	Возврат ПараметрыВызова;

КонецФункции

#КонецОбласти

#Область ОбработкаОтвета

// Тело многоходового запроса из сырых сообщений OpenAI-формата (петля инструментов).
// Сообщение YandexGPT несет ровно одно из: text, toolCallList, toolResultList; текст
// ассистента при наличии вызовов опускается (совмещение форматом не предусмотрено).
Процедура СформироватьТелоИзСырыхСообщений(Параметры, СтруктураПромпта, ТелоЗапроса)

	МассивСообщений = Новый Массив;
	ИменаВызововПоИдентификатору = Новый Соответствие;

	Для Каждого Сообщение Из СтруктураПромпта.СырыеСообщения Цикл

		Если Сообщение.role = "assistant" Тогда
			МассивСообщений.Добавить(СообщениеАссистентаYandex(Сообщение, ИменаВызововПоИдентификатору));
		ИначеЕсли Сообщение.role = "tool" Тогда
			ДобавитьРезультатИнструментаYandex(МассивСообщений, Сообщение, ИменаВызововПоИдентификатору);
		Иначе
			МассивСообщений.Добавить(Новый Структура("role, text", Сообщение.role, Строка(Сообщение.content)));
		КонецЕсли;

	КонецЦикла;

	ТелоЗапроса.Вставить("modelUri", Параметры.НаименованиеПолное);
	ТелоЗапроса.Вставить("completionOptions", СформироватьПараметрыВызова(Параметры));
	ТелоЗапроса.Вставить("messages", МассивСообщений);

	ДобавитьИнструментыYandex(СтруктураПромпта, ТелоЗапроса);

КонецПроцедуры

Функция СообщениеАссистентаYandex(Сообщение, ИменаВызововПоИдентификатору)

	ЕстьВызовы = Сообщение.Свойство("tool_calls")
		И КИИ_КоннекторИИОбщий.ЭтоМассив(Сообщение.tool_calls)
		И Сообщение.tool_calls.Количество() > 0;

	Если Не ЕстьВызовы Тогда
		Возврат Новый Структура("role, text", "assistant", Строка(Сообщение.content));
	КонецЕсли;

	СписокВызовов = Новый Массив;
	Для Каждого Вызов Из Сообщение.tool_calls Цикл
		ИменаВызововПоИдентификатору.Вставить(Строка(Вызов.id), Строка(Вызов.function.name));
		ОписаниеВызова = Новый Структура;
		ОписаниеВызова.Вставить("name", Вызов.function.name);
		ОписаниеВызова.Вставить("arguments", КИИ_КоннекторИИОбщий.СтрокаJSONВЗначение(Вызов.function.arguments));
		СписокВызовов.Добавить(Новый Структура("functionCall", ОписаниеВызова));
	КонецЦикла;

	СписокВызововМодели = Новый Структура;
	СписокВызововМодели.Вставить("toolCalls", СписокВызовов);

	Сообщение = Новый Структура;
	Сообщение.Вставить("role",         "assistant");
	Сообщение.Вставить("toolCallList", СписокВызововМодели);
	Возврат Сообщение;

КонецФункции

// Результаты инструментов, идущие подряд, складываются в один toolResultList.
Процедура ДобавитьРезультатИнструментаYandex(МассивСообщений, Сообщение, ИменаВызововПоИдентификатору)

	ИмяФункции = ИменаВызововПоИдентификатору[Строка(Сообщение.tool_call_id)];
	Если ИмяФункции = Неопределено Тогда
		ИмяФункции = "";
	КонецЕсли;

	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("name", ИмяФункции);
	РезультатФункции.Вставить("content", Строка(Сообщение.content));
	ЭлементРезультата = Новый Структура("functionResult", РезультатФункции);

	КоличествоСообщений = МассивСообщений.Количество();
	Если КоличествоСообщений > 0 Тогда
		Последнее = МассивСообщений[КоличествоСообщений - 1];
		Если Последнее.Свойство("toolResultList") Тогда
			Последнее.toolResultList.toolResults.Добавить(ЭлементРезультата);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Результаты = Новый Массив;
	Результаты.Добавить(ЭлементРезультата);
	СписокРезультатов = Новый Структура;
	СписокРезультатов.Вставить("toolResults", Результаты);

	Сообщение = Новый Структура;
	Сообщение.Вставить("role",           "user");
	Сообщение.Вставить("toolResultList", СписокРезультатов);
	МассивСообщений.Добавить(Сообщение);

КонецПроцедуры

Процедура ДобавитьИнструментыYandex(СтруктураПромпта, ТелоЗапроса)

	Если Не СтруктураПромпта.Свойство("Инструменты")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(СтруктураПромпта.Инструменты)
		Или СтруктураПромпта.Инструменты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИнструментыYandex = Новый Массив;
	Для Каждого Инструмент Из СтруктураПромпта.Инструменты Цикл
		ОписаниеФункции = Новый Структура;
		ОписаниеФункции.Вставить("name", Инструмент.function.name);
		ОписаниеФункции.Вставить("description", Инструмент.function.description);
		ОписаниеФункции.Вставить("parameters", Инструмент.function.parameters);
		ИнструментыYandex.Добавить(Новый Структура("function", ОписаниеФункции));
	КонецЦикла;

	ТелоЗапроса.Вставить("tools", ИнструментыYandex);

КонецПроцедуры

// Извлекает toolCallList первой альтернативы в Результат.ВызовыИнструментов.
// YandexGPT не присылает идентификаторы вызовов - генерируются позиционные.
Процедура ИзвлечьВызовыИнструментов(ОтветJSON, Результат)

	РезультатYandex = ПолучитьРезультат(ОтветJSON);
	ОтветБезАльтернатив = РезультатYandex = Неопределено
		Или Не РезультатYandex.Свойство("alternatives")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(РезультатYandex.alternatives)
		Или РезультатYandex.alternatives.Количество() = 0;
	Если ОтветБезАльтернатив Тогда
		Возврат;
	КонецЕсли;

	Альтернатива = РезультатYandex.alternatives[0];
	АльтернативаБезВызовов = Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Альтернатива)
		Или Не Альтернатива.Свойство("message")
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Альтернатива.message)
		Или Не Альтернатива.message.Свойство("toolCallList")
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Альтернатива.message.toolCallList)
		Или Не Альтернатива.message.toolCallList.Свойство("toolCalls")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(Альтернатива.message.toolCallList.toolCalls);
	Если АльтернативаБезВызовов Тогда
		Возврат;
	КонецЕсли;

	НомерВызова = 0;
	Для Каждого ЭлементВызова Из Альтернатива.message.toolCallList.toolCalls Цикл

		Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ЭлементВызова)
			Или Не ЭлементВызова.Свойство("functionCall")
			Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ЭлементВызова.functionCall) Тогда
			Продолжить;
		КонецЕсли;

		НомерВызова = НомерВызова + 1;
		Вызов = Новый Структура("Идентификатор, Имя, Аргументы", "call_" + НомерВызова, "", "{}");
		Если ЭлементВызова.functionCall.Свойство("name") Тогда
			Вызов.Имя = Строка(ЭлементВызова.functionCall.name);
		КонецЕсли;
		Если ЭлементВызова.functionCall.Свойство("arguments") Тогда
			Вызов.Аргументы = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(ЭлементВызова.functionCall.arguments);
		КонецЕсли;

		Результат.ВызовыИнструментов.Добавить(Вызов);

	КонецЦикла;

КонецПроцедуры

Процедура ИзвлечьТекстОтвета(ОтветJSON, Результат)

	РезультатYandex = ПолучитьРезультат(ОтветJSON);

	Если РезультатYandex = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИзвлечьТекстИзАльтернатив(РезультатYandex, Результат);

КонецПроцедуры

Функция ПолучитьРезультат(ОтветJSON)

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ОтветJSON.Свойство("result") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON.result) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОтветJSON.result;

КонецФункции

Процедура ИзвлечьТекстИзАльтернатив(РезультатYandex, Результат)

	Если Не РезультатYandex.Свойство("alternatives") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(РезультатYandex.alternatives)
		Или РезультатYandex.alternatives.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Вариант = РезультатYandex.alternatives[0];

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Вариант) Тогда
		Возврат;
	КонецЕсли;

	Если Вариант.Свойство("message") 
		И КИИ_КоннекторИИОбщий.ЭтоСтруктура(Вариант.message)
		И Вариант.message.Свойство("text") Тогда
		Результат.ТекстОтвета = Вариант.message.text;
	КонецЕсли;

	Если Вариант.Свойство("status") Тогда
		Результат.ПричинаЗавершения = Вариант.status;
	КонецЕсли;

КонецПроцедуры

Процедура ИзвлечьМетаданные(ОтветJSON, Результат)

	РезультатYandex = ПолучитьРезультат(ОтветJSON);

	Если РезультатYandex = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если РезультатYandex.Свойство("modelVersion") Тогда
		Результат.МодельОтвета = РезультатYandex.modelVersion;
	КонецЕсли;

КонецПроцедуры

Процедура ИзвлечьТокены(ОтветJSON, Результат)

	РезультатYandex = ПолучитьРезультат(ОтветJSON);

	Если РезультатYandex = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не РезультатYandex.Свойство("usage") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(РезультатYandex.usage) Тогда
		Возврат;
	КонецЕсли;

	Использование = РезультатYandex.usage;

	Если Использование.Свойство("inputTextTokens") Тогда
		Результат.ВходныеТокены = Использование.inputTextTokens;
	КонецЕсли;

	Если Использование.Свойство("completionTokens") Тогда
		Результат.ВыходныеТокены = Использование.completionTokens;
	КонецЕсли;

	Если Использование.Свойство("totalTokens") Тогда
		Результат.ВсегоТокенов = Использование.totalTokens;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет безопасность текста запроса для MCP execute_query.
//
// Параметры:
//  ТекстЗапроса - Строка - сырой текст запроса
//  Лимит        - Число - максимальное количество строк результата
//
// Возвращаемое значение:
//  Структура:
//    * ok      - Булево - запрос разрешен
//    * причина - Строка - код результата проверки
//
Функция ПроверитьЗапросБезопасный(Знач ТекстЗапроса, Знач Лимит) Экспорт

	Перем РезультатФункции;
	
	ОчищенныйТекст = УдалитьНачальныеКомментарии(ТекстЗапроса);
	ПервоеКлючевоеСлово = ПервоеСловоЗапроса(ОчищенныйТекст);
	
	Если ЭтоЗапрещенноеКлючевоеСлово(ПервоеКлючевоеСлово) Тогда
		РезультатФункции = РезультатПроверки(Ложь, "mutation_keyword_detected");
		Возврат РезультатФункции;
	КонецЕсли;
	
	Если ПервоеКлючевоеСлово <> "ВЫБРАТЬ" И ПервоеКлючевоеСлово <> "SELECT" Тогда
		
		РезультатФункции = РезультатПроверки(Ложь, "first_keyword_not_select");
		Возврат РезультатФункции;
		
	КонецЕсли;
	
	Если НайденоЗапрещенноеКлючевоеСлово(ОчищенныйТекст) Тогда
		РезультатФункции = РезультатПроверки(Ложь, "mutation_keyword_detected");
		Возврат РезультатФункции;
	КонецЕсли;
	
	Если Не ЛимитВДопустимомДиапазоне(Лимит) Тогда
		РезультатФункции = РезультатПроверки(Ложь, "limit_out_of_range");
		Возврат РезультатФункции;
	КонецЕсли;
	
	РезультатФункции = РезультатПроверки(Истина, "ok");
	Возврат РезультатФункции;
	
КонецФункции

// Добавляет ПЕРВЫЕ/TOP к запросу, если ограничение уже не задано автором шаблона.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса
//  Лимит        - Число - максимальное количество строк
//
// Возвращаемое значение:
//  Строка - текст запроса с ограничением количества строк
//
Функция ПрименитьЛимит(Знач ТекстЗапроса, Знач Лимит) Экспорт

	Перем РезультатФункции;

	Если Не ЛимитВДопустимомДиапазоне(Лимит) Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	РезультатФункции = ВставитьОграничениеСтрок(ТекстЗапроса, Лимит);
	Возврат РезультатФункции;

КонецФункции

// Ограничивает выборки пакета на Лимит + 1 строку для проверки наличия продолжения.
// Меньший авторский ПЕРВЫЕ сохраняется. Структура разбирается штатной СхемаЗапроса.
// Запросы с ИТОГИ сохраняют прежнее преобразование, чтобы не менять итоговые значения;
// в execute_query число прочитанных записей дополнительно ограничивается курсором.
//
// Параметры:
//  ТекстЗапроса - Строка - исходный текст запроса или шаблона.
//  Лимит - Число - запрошенный предел строк результата.
//
// Возвращаемое значение:
//  Строка - текст запроса с ограничением выборок или прежним преобразованием ИТОГИ.
//
Функция ПрименитьЛимитСПробой(Знач ТекстЗапроса, Знач Лимит) Экспорт

	Перем РезультатФункции;

	Если Не ЛимитВДопустимомДиапазоне(Лимит) Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	КоличествоСтрок = Лимит + 1;
	РезультатФункции = ОграничитьВыборкиПакета(ТекстЗапроса, КоличествоСтрок);
	Возврат РезультатФункции;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Штатная модель отделяет операторы, пакет и строковые литералы без собственного SQL-парсера.
Функция ОграничитьВыборкиПакета(Знач ТекстЗапроса, Знач КоличествоСтрок)

	Схема = Новый СхемаЗапроса;
	Схема.РежимКомпоновкиДанных = Ложь;
	Попытка
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
	Исключение
		// Прежний экспортный метод готовил и шаблоны без доступных здесь метаданных.
		// Отказ оптимизации не разрешает выполнение: запрос проверит сама платформа.
		ДанныеОшибки = ИнформацияОбОшибке();
		КодОшибки = Лев(ДанныеОшибки.Код, 100);
		ТекстСобытия = СтрШаблон("schema_parse_fallback code=%1", КодОшибки);
		ЗаписьЖурналаРегистрации("КИИ.MCP.РазборЗапроса",
			УровеньЖурналаРегистрации.Предупреждение, , , ТекстСобытия);
		Результат = ВставитьОграничениеСтрок(ТекстЗапроса, КоличествоСтрок);
		Возврат Результат;
	КонецПопытки;
	ПакетЗапросов = Схема.ПакетЗапросов;
	Для Каждого ЗапросСхемы Из ПакетЗапросов Цикл
		ВыраженияИтогов = ЗапросСхемы.ВыраженияИтогов;
		КонтрольныеТочкиИтогов = ЗапросСхемы.КонтрольныеТочкиИтогов;
		Если ЗапросСхемы.ОбщиеИтоги Или ВыраженияИтогов.Количество() > 0
			Или КонтрольныеТочкиИтогов.Количество() > 0 Тогда
			// Лимит до расчета итогов меняет их значения; сохраняем прежнее преобразование.
			// Курсор инструмента ограничивает число прочитанных строк без полной выгрузки.
			Результат = ВставитьОграничениеСтрок(ТекстЗапроса, КоличествоСтрок);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЗапросСхемы Из ПакетЗапросов Цикл
		ОграничениеПрименено = ОграничитьЗапросСхемы(ЗапросСхемы, КоличествоСтрок);
		Если Не ОграничениеПрименено Тогда
			ЗаписьЖурналаРегистрации("КИИ.MCP.РазборЗапроса",
				УровеньЖурналаРегистрации.Предупреждение, , , "schema_limit_fallback reason=order_expression");
			Результат = ВставитьОграничениеСтрок(ТекстЗапроса, КоличествоСтрок);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Результат = Схема.ПолучитьТекстЗапроса();
	Возврат Результат;

КонецФункции

Функция ОграничитьЗапросСхемы(ЗапросСхемы, Знач КоличествоСтрок)

	Операторы = ЗапросСхемы.Операторы;
	Если Операторы.Количество() = 1 Тогда
		ОператорВыборки = Операторы.Получить(0);
		ИсходныйПредел = ОператорВыборки.КоличествоПолучаемыхЗаписей;
		Если ИсходныйПредел = Неопределено Или ИсходныйПредел > КоличествоСтрок Тогда
			ОператорВыборки.КоличествоПолучаемыхЗаписей = КоличествоСтрок;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;

	ПорядокСортировки = Новый Массив;
	Колонки = ЗапросСхемы.Колонки;
	ПорядокЗапроса = ЗапросСхемы.Порядок;
	Для Каждого ЭлементПорядка Из ПорядокЗапроса Цикл
		ЭлементСортировки = ЭлементПорядка.Элемент;
		ТипЭлемента = ТипЗнч(ЭлементСортировки);
		Если ТипЭлемента <> Тип("КолонкаСхемыЗапроса") Тогда
			Возврат Ложь;
		КонецЕсли;
		НомерКолонки = Колонки.Индекс(ЭлементСортировки);
		Если НомерКолонки < 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		ОписаниеПорядка = Новый Структура("НомерКолонки,Направление", НомерКолонки, ЭлементПорядка.Направление);
		ПорядокСортировки.Добавить(ОписаниеПорядка);
	КонецЦикла;
	ПорядокЗапроса.Очистить();
	АвтоматическийПорядок = ЗапросСхемы.Автопорядок;
	ЗапросСхемы.Автопорядок = Ложь;
	ВложенныйТекст = ЗапросСхемы.ПолучитьТекстЗапроса();
	ПределТекстом = ПредставлениеЛимита(КоличествоСтрок);
	ТекстОбертки = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ %1 ОграниченныеДанные.* ИЗ (%2) КАК ОграниченныеДанные", ПределТекстом, ВложенныйТекст);
	ЗапросСхемы.УстановитьТекстЗапроса(ТекстОбертки);
	ЗапросСхемы.Автопорядок = АвтоматическийПорядок;
	Колонки = ЗапросСхемы.Колонки;
	ПорядокЗапроса = ЗапросСхемы.Порядок;
	Для Каждого ОписаниеПорядка Из ПорядокСортировки Цикл
		КолонкаСортировки = Колонки.Получить(ОписаниеПорядка.НомерКолонки);
		ЭлементПорядка = ПорядокЗапроса.Добавить(КолонкаСортировки);
		ЭлементПорядка.Направление = ОписаниеПорядка.Направление;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция РезультатПроверки(Знач ЗапросРазрешен, Знач Причина)
	
	Результат = Новый Структура;
	Результат.Вставить("ok", ЗапросРазрешен);
	Результат.Вставить("причина", Причина);
	Возврат Результат;
	
КонецФункции

Функция УдалитьНачальныеКомментарии(Знач ТекстЗапроса)

	Перем ФрагментТекста;
	
	Если ТипЗнч(ТекстЗапроса) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	ОчищенныйТекст = СокрЛП(ТекстЗапроса);
	
	Пока Лев(ОчищенныйТекст, 2) = "//" Цикл
		
		ПозицияКонцаСтроки = СтрНайти(ОчищенныйТекст, Символы.ПС);
		Если ПозицияКонцаСтроки = 0 Тогда
			Возврат "";
		КонецЕсли;
		
		ФрагментТекста = Сред(ОчищенныйТекст, ПозицияКонцаСтроки + 1);
		ОчищенныйТекст = СокрЛП(ФрагментТекста);
		
	КонецЦикла;
	
	Возврат ОчищенныйТекст;
	
КонецФункции

Функция ПервоеСловоЗапроса(Знач ТекстЗапроса)

	Перем РезультатФункции;
	
	НормализованныйТекст = СокрЛП(ТекстЗапроса);
	НормализованныйТекст = СтрЗаменить(НормализованныйТекст, Символы.Таб, " ");
	НормализованныйТекст = СтрЗаменить(НормализованныйТекст, Символы.ПС, " ");
	НормализованныйТекст = СтрЗаменить(НормализованныйТекст, Символы.ВК, " ");
	
	Слова = СтрРазделить(НормализованныйТекст, " ", Ложь);
	Если Слова.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	РезультатФункции = ВРег(Слова[0]);
	Возврат РезультатФункции;
	
КонецФункции

Функция НайденоЗапрещенноеКлючевоеСлово(Знач ТекстЗапроса)

	Перем ЗначениеВВерхнемРегистре;

	// Пословно, а не по подстроке: раньше СтрНайти давал ложные отказы на легитимных read-only
	// запросах, где имя поля/таблицы содержит слово-ключ как подстроку (update_date, deleted) (аудит P3).
	Для Каждого Слово Из РазбитьЗапросНаСлова(ТекстЗапроса) Цикл
		ЗначениеВВерхнемРегистре = ВРег(Слово);
		Если ЭтоЗапрещенноеКлючевоеСлово(ЗначениеВВерхнемРегистре) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Разбивает текст запроса на слова-идентификаторы. Разделители - пробелы и пунктуация запроса;
// буквы, цифры и '_' (символы идентификатора 1С) слово не режут. Точка/скобки/операторы - режут.
Функция РазбитьЗапросНаСлова(Знач ТекстЗапроса)

	Перем ФрагментТекста;
	Перем РезультатФункции;

	Результат = ТекстЗапроса;
	Разделители = " " + Символы.Таб + Символы.ПС + Символы.ВК + ",.();:=<>+-*/[]{}" + """";
	Для Индекс = 1 По СтрДлина(Разделители) Цикл
		ФрагментТекста = Сред(Разделители, Индекс, 1);
		Результат = СтрЗаменить(Результат, ФрагментТекста, " ");
	КонецЦикла;

	РезультатФункции = СтрРазделить(Результат, " ", Ложь);
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоЗапрещенноеКлючевоеСлово(Знач КлючевоеСлово)
	
	Для Каждого ЗапрещенноеСлово Из ЗапрещенныеКлючевыеСлова() Цикл
		Если КлючевоеСлово = ЗапрещенноеСлово Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЗапрещенныеКлючевыеСлова()
	
	Слова = Новый Массив;
	Слова.Добавить("УНИЧТОЖИТЬ");
	Слова.Добавить("DROP");
	Слова.Добавить("УДАЛИТЬ");
	Слова.Добавить("DELETE");
	Слова.Добавить("ИЗМЕНИТЬ");
	Слова.Добавить("UPDATE");
	Слова.Добавить("ВСТАВИТЬ");
	Слова.Добавить("INSERT");
	Возврат Слова;
	
КонецФункции

Функция ЛимитВДопустимомДиапазоне(Знач Лимит)

	Перем РезультатФункции;

	Если ТипЗнч(Лимит) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;

	// Дробный лимит (10.5) недопустим: Формат в ПЕРВЫЕ/TOP даст нецелое → битый запрос.
	Если Лимит <> Цел(Лимит) Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатФункции = Лимит >= 1 И Лимит <= 1000;
	Возврат РезультатФункции;

КонецФункции

// Вставляет ограничение количества строк (ПЕРВЫЕ/TOP) в ВЕРХНЕУРОВНЕВЫЙ SELECT.
// Работает по тексту БЕЗ ведущих комментариев и проверяет наличие ограничения ТОЛЬКО
// в начале (СтрНачинаетсяС), чтобы: (а) лимит не попал в ведущий комментарий мимо
// исполняемого запроса; (б) ПЕРВЫЕ во вложенном подзапросе не считался «уже ограничен».
// Возвращает текст без ведущих комментариев - они не влияют на результат запроса.
Функция ВставитьОграничениеСтрок(Знач ТекстЗапроса, Знач КоличествоСтрок)

	Перем РезультатФункции;

	ОчищенныйТекст = УдалитьНачальныеКомментарии(ТекстЗапроса);
	Если ПустаяСтрока(ОчищенныйТекст) Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	// Токенизируем префикс, устойчиво к нестандартным пробелам (кратные пробелы, табы, переводы
	// строк между ключевыми словами): прежняя детекция через СтрНачинаетсяС(..., "ВЫБРАТЬ ПЕРВЫЕ")
	// с одинарным пробелом не распознавала "ВЫБРАТЬ  ПЕРВЫЕ" → дублировала лимит / ставила ПЕРВЫЕ
	// перед РАЗЛИЧНЫЕ → битый запрос (аудит P2).
	Префикс = РазобратьПрефиксВыборки(ОчищенныйТекст);
	Если Префикс = Неопределено Тогда
		Возврат ОчищенныйТекст;
	КонецЕсли;
	Если Префикс.УжеОграничен Тогда
		Возврат ОчищенныйТекст;
	КонецЕсли;

	Представление = ПредставлениеЛимита(КоличествоСтрок);
	ВставляемыйТекст = ?(Префикс.SQL, " TOP " + Представление, " ПЕРВЫЕ " + Представление);

	РезультатФункции = Лев(ОчищенныйТекст, Префикс.ПозицияВставки - 1)
		+ ВставляемыйТекст
		+ Сред(ОчищенныйТекст, Префикс.ПозицияВставки);
	Возврат РезультатФункции;

КонецФункции

// Разбирает начало запроса: ВЫБРАТЬ|SELECT [РАЗЛИЧНЫЕ|DISTINCT] [ПЕРВЫЕ|TOP …].
// Возвращает Структуру(SQL, ПозицияВставки, УжеОграничен) либо Неопределено, если это не SELECT.
// ПозицияВставки - индекс сразу после ВЫБРАТЬ[ РАЗЛИЧНЫЕ]/SELECT[ DISTINCT] для корректной вставки.
Функция РазобратьПрефиксВыборки(Знач Текст)

	Перем РезультатФункции;

	Позиция = ПропуститьПробельные(Текст, 1);

	Если СовпадаетКлючевоеСлово(Текст, Позиция, "ВЫБРАТЬ") Тогда
		SQL = Ложь;
		СловоРазличные = "РАЗЛИЧНЫЕ";
		СловоЛимит = "ПЕРВЫЕ";
		Позиция = Позиция + СтрДлина("ВЫБРАТЬ");
	ИначеЕсли СовпадаетКлючевоеСлово(Текст, Позиция, "SELECT") Тогда
		SQL = Истина;
		СловоРазличные = "DISTINCT";
		СловоЛимит = "TOP";
		Позиция = Позиция + СтрДлина("SELECT");
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	ПозицияВставки = Позиция;

	ПозицияСлова = ПропуститьПробельные(Текст, Позиция);
	Если СовпадаетКлючевоеСлово(Текст, ПозицияСлова, СловоРазличные) Тогда
		Позиция = ПозицияСлова + СтрДлина(СловоРазличные);
		ПозицияВставки = Позиция;
		ПозицияСлова = ПропуститьПробельные(Текст, Позиция);
	КонецЕсли;

	УжеОграничен = СовпадаетКлючевоеСлово(Текст, ПозицияСлова, СловоЛимит);

	РезультатФункции = Новый Структура("SQL, ПозицияВставки, УжеОграничен", SQL, ПозицияВставки, УжеОграничен);
	Возврат РезультатФункции;

КонецФункции

// Индекс первого непробельного символа, начиная с Позиция (пробел/таб/перевод строки/возврат каретки).
Функция ПропуститьПробельные(Знач Текст, Знач Позиция)

	Пока Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		ЭтоПробельныйСимвол = (Символ = " " Или Символ = Символы.Таб
			Или Символ = Символы.ПС Или Символ = Символы.ВК);
		Если Не ЭтоПробельныйСимвол Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Позиция;

КонецФункции

// Истина, если в Позиция стоит КлючевоеСлово с границей (дальше пробельный символ или конец строки).
Функция СовпадаетКлючевоеСлово(Знач Текст, Знач Позиция, Знач КлючевоеСлово)

	Перем ДлинаТекста2;
	Перем ФрагментТекста;

	Перем ДлинаТекста;
	Перем РезультатФункции;

	ДлинаТекста2 = СтрДлина(КлючевоеСлово);
	ФрагментТекста = Сред(Текст, Позиция, ДлинаТекста2);
	Если ВРег(ФрагментТекста) <> ВРег(КлючевоеСлово) Тогда
		Возврат Ложь;
	КонецЕсли;
	ДлинаТекста = СтрДлина(КлючевоеСлово);
	СледующийСимвол = Сред(Текст, Позиция + ДлинаТекста, 1);
	РезультатФункции = ПустаяСтрока(СледующийСимвол)
		Или СледующийСимвол = " "
		Или СледующийСимвол = Символы.Таб
		Или СледующийСимвол = Символы.ПС
		Или СледующийСимвол = Символы.ВК;
	Возврат РезультатФункции;

КонецФункции

Функция ПредставлениеЛимита(Знач Лимит)

	Перем РезультатФункции;
	
	РезультатФункции = Формат(Лимит, "ЧГ=0");
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет безопасность текста запроса для MCP execute_query.
//
// Параметры:
//  ТекстЗапроса - Строка - сырой текст запроса
//  Лимит        - Число - максимальное количество строк результата
//
// Возвращаемое значение:
//  Структура:
//    * ok      - Булево - запрос разрешен
//    * причина - Строка - код результата проверки
//
Функция ПроверитьЗапросБезопасный(Знач ТекстЗапроса, Знач Лимит) Экспорт
	
	ОчищенныйТекст = УдалитьНачальныеКомментарии(ТекстЗапроса);
	ПервоеКлючевоеСлово = ПервоеСловоЗапроса(ОчищенныйТекст);
	
	Если ЭтоЗапрещенноеКлючевоеСлово(ПервоеКлючевоеСлово) Тогда
		Возврат РезультатПроверки(Ложь, "mutation_keyword_detected");
	КонецЕсли;
	
	Если ПервоеКлючевоеСлово <> "ВЫБРАТЬ"
		И ПервоеКлючевоеСлово <> "SELECT" Тогда
		
		Возврат РезультатПроверки(Ложь, "first_keyword_not_select");
		
	КонецЕсли;
	
	Если НайденоЗапрещенноеКлючевоеСлово(ОчищенныйТекст) Тогда
		Возврат РезультатПроверки(Ложь, "mutation_keyword_detected");
	КонецЕсли;
	
	Если Не ЛимитВДопустимомДиапазоне(Лимит) Тогда
		Возврат РезультатПроверки(Ложь, "limit_out_of_range");
	КонецЕсли;
	
	Возврат РезультатПроверки(Истина, "ok");
	
КонецФункции

// Добавляет ПЕРВЫЕ/TOP к запросу, если ограничение уже не задано автором шаблона.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса
//  Лимит        - Число - максимальное количество строк
//
// Возвращаемое значение:
//  Строка - текст запроса с ограничением количества строк
//
Функция ПрименитьЛимит(Знач ТекстЗапроса, Знач Лимит) Экспорт

	Если Не ЛимитВДопустимомДиапазоне(Лимит) Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	Возврат ВставитьОграничениеСтрок(ТекстЗапроса, Лимит);

КонецФункции

// Как ПрименитьЛимит, но вставляет ПЕРВЫЕ (Лимит + 1) - «пробную» строку, по наличию
// которой инструмент отличает усечение результата от полного результата (иначе
// truncated всегда Ложь). Лимит уже провалидирован вызывающим (ПроверитьЗапросБезопасный),
// поэтому внутреннее Лимит+1 не упирается в верхнюю границу диапазона.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса
//  Лимит        - Число - запрошенный лимит строк
//
// Возвращаемое значение:
//  Строка - текст запроса с ограничением на Лимит + 1 строку
//
Функция ПрименитьЛимитСПробой(Знач ТекстЗапроса, Знач Лимит) Экспорт

	Если Не ЛимитВДопустимомДиапазоне(Лимит) Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	Возврат ВставитьОграничениеСтрок(ТекстЗапроса, Лимит + 1);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РезультатПроверки(Знач ЗапросРазрешен, Знач Причина)
	
	Результат = Новый Структура;
	Результат.Вставить("ok", ЗапросРазрешен);
	Результат.Вставить("причина", Причина);
	Возврат Результат;
	
КонецФункции

Функция УдалитьНачальныеКомментарии(Знач ТекстЗапроса)
	
	Если ТипЗнч(ТекстЗапроса) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	ОчищенныйТекст = СокрЛП(ТекстЗапроса);
	
	Пока Лев(ОчищенныйТекст, 2) = "//" Цикл
		
		ПозицияКонцаСтроки = СтрНайти(ОчищенныйТекст, Символы.ПС);
		Если ПозицияКонцаСтроки = 0 Тогда
			Возврат "";
		КонецЕсли;
		
		ОчищенныйТекст = СокрЛП(Сред(ОчищенныйТекст, ПозицияКонцаСтроки + 1));
		
	КонецЦикла;
	
	Возврат ОчищенныйТекст;
	
КонецФункции

Функция ПервоеСловоЗапроса(Знач ТекстЗапроса)
	
	НормализованныйТекст = СокрЛП(ТекстЗапроса);
	НормализованныйТекст = СтрЗаменить(НормализованныйТекст, Символы.Таб, " ");
	НормализованныйТекст = СтрЗаменить(НормализованныйТекст, Символы.ПС, " ");
	НормализованныйТекст = СтрЗаменить(НормализованныйТекст, Символы.ВК, " ");
	
	Слова = СтрРазделить(НормализованныйТекст, " ", Ложь);
	Если Слова.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ВРег(Слова[0]);
	
КонецФункции

Функция НайденоЗапрещенноеКлючевоеСлово(Знач ТекстЗапроса)

	// Пословно, а не по подстроке: раньше СтрНайти давал ложные отказы на легитимных read-only
	// запросах, где имя поля/таблицы содержит слово-ключ как подстроку (update_date, deleted) (аудит P3).
	Для Каждого Слово Из РазбитьЗапросНаСлова(ТекстЗапроса) Цикл
		Если ЭтоЗапрещенноеКлючевоеСлово(ВРег(Слово)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Разбивает текст запроса на слова-идентификаторы. Разделители - пробелы и пунктуация запроса;
// буквы, цифры и '_' (символы идентификатора 1С) слово не режут. Точка/скобки/операторы - режут.
Функция РазбитьЗапросНаСлова(Знач ТекстЗапроса)

	Результат = ТекстЗапроса;
	Разделители = " " + Символы.Таб + Символы.ПС + Символы.ВК + ",.();:=<>+-*/[]{}" + """";
	Для Индекс = 1 По СтрДлина(Разделители) Цикл
		Результат = СтрЗаменить(Результат, Сред(Разделители, Индекс, 1), " ");
	КонецЦикла;

	Возврат СтрРазделить(Результат, " ", Ложь);

КонецФункции

Функция ЭтоЗапрещенноеКлючевоеСлово(Знач КлючевоеСлово)
	
	Для Каждого ЗапрещенноеСлово Из ЗапрещенныеКлючевыеСлова() Цикл
		Если КлючевоеСлово = ЗапрещенноеСлово Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЗапрещенныеКлючевыеСлова()
	
	Слова = Новый Массив;
	Слова.Добавить("УНИЧТОЖИТЬ");
	Слова.Добавить("DROP");
	Слова.Добавить("УДАЛИТЬ");
	Слова.Добавить("DELETE");
	Слова.Добавить("ИЗМЕНИТЬ");
	Слова.Добавить("UPDATE");
	Слова.Добавить("ВСТАВИТЬ");
	Слова.Добавить("INSERT");
	Возврат Слова;
	
КонецФункции

Функция ЛимитВДопустимомДиапазоне(Знач Лимит)

	Если ТипЗнч(Лимит) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;

	// Дробный лимит (10.5) недопустим: Формат в ПЕРВЫЕ/TOP даст нецелое → битый запрос.
	Если Лимит <> Цел(Лимит) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Лимит >= 1 И Лимит <= 1000;

КонецФункции

// Вставляет ограничение количества строк (ПЕРВЫЕ/TOP) в ВЕРХНЕУРОВНЕВЫЙ SELECT.
// Работает по тексту БЕЗ ведущих комментариев и проверяет наличие ограничения ТОЛЬКО
// в начале (СтрНачинаетсяС), чтобы: (а) лимит не попал в ведущий комментарий мимо
// исполняемого запроса; (б) ПЕРВЫЕ во вложенном подзапросе не считался «уже ограничен».
// Возвращает текст без ведущих комментариев - они не влияют на результат запроса.
Функция ВставитьОграничениеСтрок(Знач ТекстЗапроса, Знач КоличествоСтрок)

	ОчищенныйТекст = УдалитьНачальныеКомментарии(ТекстЗапроса);
	Если ПустаяСтрока(ОчищенныйТекст) Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	// Токенизируем префикс, устойчиво к нестандартным пробелам (кратные пробелы, табы, переводы
	// строк между ключевыми словами): прежняя детекция через СтрНачинаетсяС(..., "ВЫБРАТЬ ПЕРВЫЕ")
	// с одинарным пробелом не распознавала "ВЫБРАТЬ  ПЕРВЫЕ" → дублировала лимит / ставила ПЕРВЫЕ
	// перед РАЗЛИЧНЫЕ → битый запрос (аудит P2).
	Префикс = РазобратьПрефиксВыборки(ОчищенныйТекст);
	Если Префикс = Неопределено Тогда
		Возврат ОчищенныйТекст;
	КонецЕсли;
	Если Префикс.УжеОграничен Тогда
		Возврат ОчищенныйТекст;
	КонецЕсли;

	Представление = ПредставлениеЛимита(КоличествоСтрок);
	ВставляемыйТекст = ?(Префикс.SQL, " TOP " + Представление, " ПЕРВЫЕ " + Представление);

	Возврат Лев(ОчищенныйТекст, Префикс.ПозицияВставки - 1)
		+ ВставляемыйТекст
		+ Сред(ОчищенныйТекст, Префикс.ПозицияВставки);

КонецФункции

// Разбирает начало запроса: ВЫБРАТЬ|SELECT [РАЗЛИЧНЫЕ|DISTINCT] [ПЕРВЫЕ|TOP …].
// Возвращает Структуру(SQL, ПозицияВставки, УжеОграничен) либо Неопределено, если это не SELECT.
// ПозицияВставки - индекс сразу после ВЫБРАТЬ[ РАЗЛИЧНЫЕ]/SELECT[ DISTINCT] для корректной вставки.
Функция РазобратьПрефиксВыборки(Знач Текст)

	Позиция = ПропуститьПробельные(Текст, 1);

	Если СовпадаетКлючевоеСлово(Текст, Позиция, "ВЫБРАТЬ") Тогда
		SQL = Ложь;
		СловоРазличные = "РАЗЛИЧНЫЕ";
		СловоЛимит = "ПЕРВЫЕ";
		Позиция = Позиция + СтрДлина("ВЫБРАТЬ");
	ИначеЕсли СовпадаетКлючевоеСлово(Текст, Позиция, "SELECT") Тогда
		SQL = Истина;
		СловоРазличные = "DISTINCT";
		СловоЛимит = "TOP";
		Позиция = Позиция + СтрДлина("SELECT");
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	ПозицияВставки = Позиция;

	ПозицияСлова = ПропуститьПробельные(Текст, Позиция);
	Если СовпадаетКлючевоеСлово(Текст, ПозицияСлова, СловоРазличные) Тогда
		Позиция = ПозицияСлова + СтрДлина(СловоРазличные);
		ПозицияВставки = Позиция;
		ПозицияСлова = ПропуститьПробельные(Текст, Позиция);
	КонецЕсли;

	УжеОграничен = СовпадаетКлючевоеСлово(Текст, ПозицияСлова, СловоЛимит);

	Возврат Новый Структура("SQL, ПозицияВставки, УжеОграничен", SQL, ПозицияВставки, УжеОграничен);

КонецФункции

// Индекс первого непробельного символа, начиная с Позиция (пробел/таб/перевод строки/возврат каретки).
Функция ПропуститьПробельные(Знач Текст, Знач Позиция)

	Пока Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		ЭтоПробельныйСимвол = (Символ = " " Или Символ = Символы.Таб
			Или Символ = Символы.ПС Или Символ = Символы.ВК);
		Если Не ЭтоПробельныйСимвол Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Позиция;

КонецФункции

// Истина, если в Позиция стоит КлючевоеСлово с границей (дальше пробельный символ или конец строки).
Функция СовпадаетКлючевоеСлово(Знач Текст, Знач Позиция, Знач КлючевоеСлово)

	Если ВРег(Сред(Текст, Позиция, СтрДлина(КлючевоеСлово))) <> ВРег(КлючевоеСлово) Тогда
		Возврат Ложь;
	КонецЕсли;
	СледующийСимвол = Сред(Текст, Позиция + СтрДлина(КлючевоеСлово), 1);
	Возврат ПустаяСтрока(СледующийСимвол)
		Или СледующийСимвол = " " Или СледующийСимвол = Символы.Таб
		Или СледующийСимвол = Символы.ПС Или СледующийСимвол = Символы.ВК;

КонецФункции

Функция ПредставлениеЛимита(Знач Лимит)
	
	Возврат Формат(Лимит, "ЧГ=0");
	
КонецФункции

#КонецОбласти

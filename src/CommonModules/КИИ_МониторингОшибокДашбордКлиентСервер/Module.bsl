// Дашборд ошибок: разбор команд, которые страница в HTML-поле формы передает клику по ссылке.
// Кнопки страницы ведут на «#iikona?command=...&days=...&theme=...»; форма перехватывает клик
// (ПриНажатии поля HTML-документа) и выполняет команду средствами формы.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Команда формы из ссылки, по которой кликнули на странице дашборда.
//
// Параметры:
//  Ссылка - Строка, Неопределено - href элемента, по которому кликнули.
//
// Возвращаемое значение:
//  Неопределено - ссылка не команда дашборда.
//  Структура - команда формы:
//   * Имя        - Строка - refresh, analyze, deep, enable или deep-hide.
//   * ПериодДней - Число - период, открытый на странице: 7, 30 или 90.
//   * Тема       - Строка - тема страницы: light или dark.
//
Функция КомандаСтраницы(Знач Ссылка) Экспорт

	Если ТипЗнч(Ссылка) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозицияЯкоря = СтрНайти(Ссылка, "#iikona?");
	Если ПозицияЯкоря = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Параметры = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить(Сред(Ссылка, ПозицияЯкоря + СтрДлина("#iikona?")), "&", Ложь) Цикл
		ПозицияРавно = СтрНайти(Пара, "=");
		Если ПозицияРавно > 1 Тогда
			Параметры.Вставить(Лев(Пара, ПозицияРавно - 1), Сред(Пара, ПозицияРавно + 1));
		КонецЕсли;
	КонецЦикла;

	Имя = Параметры.Получить("command");
	Если ИменаКоманд().Найти(Имя) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Команда = Новый Структура("Имя, ПериодДней, Тема", Имя, 30, "light");
	Дней = Параметры.Получить("days");
	Если Дней = "7" Или Дней = "90" Тогда
		Команда.ПериодДней = Число(Дней);
	КонецЕсли;
	Если Параметры.Получить("theme") = "dark" Тогда
		Команда.Тема = "dark";
	КонецЕсли;
	Если Имя = "open-error" Тогда
		Хеш = Параметры.Получить("hash");
		Если Не КорректныйХешОшибки(Хеш) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Команда.Вставить("ХешОшибки", Хеш);
	КонецЕсли;
	Возврат Команда;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Команды, которые страница дашборда может передать форме; совпадают с именами в макете СкриптДашборда.
Функция ИменаКоманд()

	Возврат СтрРазделить("refresh,analyze,deep,enable,deep-hide,open-error", ",");

КонецФункции

Функция КорректныйХешОшибки(Знач Хеш)

	Если ТипЗнч(Хеш) <> Тип("Строка") Или СтрДлина(Хеш) <> 32 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Хеш) Цикл
		Если СтрНайти("0123456789abcdefABCDEF", Сред(Хеш, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

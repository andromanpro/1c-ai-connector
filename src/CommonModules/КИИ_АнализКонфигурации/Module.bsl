Функция ОписатьОбъектМетаданных(ОбъектМетаданных, ВключатьДочерние)

	Описание = Новый Соответствие;
	Описание.Вставить("Имя", ОбъектМетаданных.Имя);
	Описание.Вставить("Синоним", ОбъектМетаданных.Синоним);
	Описание.Вставить("ПолноеИмя", ОбъектМетаданных.ПолноеИмя());
	Описание.Вставить("Комментарий", ОбъектМетаданных.Комментарий);

	Если ВключатьДочерние Тогда
		ДобавитьРеквизиты(Описание, ОбъектМетаданных);
		ДобавитьТабличныеЧасти(Описание, ОбъектМетаданных);
		ДобавитьФормы(Описание, ОбъектМетаданных);
		ДобавитьМакеты(Описание, ОбъектМетаданных);
		ДобавитьКоманды(Описание, ОбъектМетаданных);
		ДобавитьИзмерения(Описание, ОбъектМетаданных);
		ДобавитьРесурсы(Описание, ОбъектМетаданных);
		ДобавитьЗначенияПеречисления(Описание, ОбъектМетаданных);
	КонецЕсли;

	Возврат Описание;

КонецФункции


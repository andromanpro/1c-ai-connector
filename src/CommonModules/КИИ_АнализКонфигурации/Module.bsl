// Получить коллекцию метаданных по имени свойства или по самой коллекции.
//
// Карта коллекций хранит объекты-коллекции (Метаданные.Справочники и т.п.) по
// строковым ключам. Вызывающие передают уже саму коллекцию (ЭлементКарты.Значение),
// поэтому строковый аргумент резолвим по карте, а объект-коллекцию возвращаем как есть.
// Без этого Соответствие.Получить(объект-коллекция) не находит ключ и все чтение
// метаданных (статистика/список/поиск/дерево) молча возвращает пусто.
Функция ПолучитьКоллекциюМетаданныхПоИмени(ИмяИлиКоллекция)

	Если ТипЗнч(ИмяИлиКоллекция) = Тип("Строка") Тогда
		Возврат ПолучитьКартуКоллекцийМетаданных().Получить(ИмяИлиКоллекция);
	КонецЕсли;

	Возврат ИмяИлиКоллекция;

КонецФункции


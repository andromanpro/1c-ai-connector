////////////////////////////////////////////////////////////////////////////////
// КИИ_АнализКонфигурации: Анализ конфигурации
//
// Серверный модуль для анализа структуры конфигурации 1С:
//   - Построение дерева метаданных (JSON-совместимый формат)
//   - Получение детальных свойств объектов метаданных
//   - Парсинг XML-дампа конфигурации (текстовый формат)
//   - Интеграция с EDT MCP-сервером (localhost:8764)
//
// Зависимости:
//   - КИИ_HTTPКлиент (HTTP-запросы к EDT)
//
// Версия: 1.0 (март 2026)
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область ДеревоМетаданных

// Построить дерево метаданных конфигурации.
// Возвращает структурированное описание всех объектов, сгруппированных по типам.
//
// Параметры:
//  ФильтрТипов - Строка - фильтр типов через запятую (например "Справочники,Документы").
//                         Пустая строка - все типы. По умолчанию "".
//  ВключатьДочерние - Булево - включать реквизиты, табличные части, формы. По умолчанию Ложь.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -дерево метаданных вида:
//    {"Конфигурация": {"Имя": ..., "Версия": ...},
//     "Справочники": [{"Имя": ..., "Синоним": ..., "Реквизиты": [...], ...}], ...}
//
Функция ПостроитьДеревоМетаданных(Знач ФильтрТипов = "", Знач ВключатьДочерние = Ложь) Экспорт

	Результат = Новый Соответствие;

	// Информация о конфигурации
	ИнформацияКонфигурации = Новый Соответствие;
	ИнформацияКонфигурации.Вставить("Имя", Метаданные.Имя);
	ИнформацияКонфигурации.Вставить("Синоним", Метаданные.Синоним);
	ИнформацияКонфигурации.Вставить("Версия", Метаданные.Версия);
	ИнформацияКонфигурации.Вставить("Поставщик", Метаданные.Поставщик);
	ИнформацияКонфигурации.Вставить("РежимСовместимости", Строка(Метаданные.РежимСовместимости));
	Результат.Вставить("Конфигурация", ИнформацияКонфигурации);

	// Карта коллекций метаданных
	КартаКоллекций = ПолучитьКартуКоллекцийМетаданных();

	// Применяем фильтр
	ДопустимыеТипы = Неопределено;
	Если ЗначениеЗаполнено(ФильтрТипов) Тогда
		ДопустимыеТипы = Новый Соответствие;
		МассивТипов = СтрРазделить(ФильтрТипов, ",", Ложь);
		Для Каждого ТипСтрока Из МассивТипов Цикл
			ДопустимыеТипы.Вставить(ВРег(СокрЛП(ТипСтрока)), Истина); // регистронезависимо (аудит P2)
		КонецЦикла;
	КонецЕсли;

	Для Каждого ЭлементКарты Из КартаКоллекций Цикл

		ИмяКоллекции = ЭлементКарты.Ключ;
		СвойствоМетаданных = ЭлементКарты.Значение;

		Если ДопустимыеТипы <> Неопределено И ДопустимыеТипы.Получить(ВРег(ИмяКоллекции)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Коллекция = ПолучитьКоллекциюМетаданныхПоИмени(СвойствоМетаданных);
		Исключение
			// Не глотаем молча: пропуск коллекции логируем, иначе реальный сбой обхода МД невидим (аудит P2).
			// Уровень "Предупреждение", а не "Ошибка": обход продолжается по остальным коллекциям,
			// а мониторинг собирает ЖР строго по уровню "Ошибка" - иначе штатный пропуск
			// (коллекция недоступна в этой конфигурации) стал бы инцидентом с уведомлением.
			ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстДляЖурнала = СтрШаблон(НСтр("ru = 'Пропущена коллекция %1: %2'"),
				ИмяКоллекции, ПредставлениеОшибки);
			// BSLLS:UsageWriteLogEvent-off
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'КИИ.АнализКонфигурации'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Предупреждение, , ,
				ТекстДляЖурнала);
			// BSLLS:UsageWriteLogEvent-on
			Продолжить;
		КонецПопытки;

		Если Коллекция = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		МассивОбъектов = Новый Массив;
		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			ОписаниеОбъекта = ОписатьОбъектМетаданных(ОбъектМетаданных, ВключатьДочерние);
			МассивОбъектов.Добавить(ОписаниеОбъекта);
		КонецЦикла;

		Если МассивОбъектов.Количество() > 0 Тогда
			Результат.Вставить(ИмяКоллекции, МассивОбъектов);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Получить свойства объекта метаданных по полному имени.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта (например "Справочник.Товары").
//  ВключатьДочерние - Булево - включать реквизиты, табличные части, формы. По умолчанию Истина.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -детальное описание объекта или Неопределено если не найден.
//
Функция ПолучитьСвойстваОбъектаМетаданных(Знач ПолноеИмя, Знач ВключатьДочерние = Истина) Экспорт

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОписатьОбъектМетаданных(ОбъектМетаданных, ВключатьДочерние);

КонецФункции

// Получить идентификатор объекта метаданных.
// Использует механизм ИдентификаторыОбъектовМетаданных (БСП).
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта (например "Справочник.Товары").
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -с ключами "Ссылка", "ПолноеИмя" или Неопределено.
//
Функция ПолучитьИдентификаторОбъектаМетаданных(Знач ПолноеИмя) Экспорт

	Результат = Новый Соответствие;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Идентификатор = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ПолноеИмя);
		Результат.Вставить("Ссылка", Строка(Идентификатор));
		Результат.Вставить("ПолноеИмя", ПолноеИмя);
	Исключение
		Результат.Вставить("Ошибка", ОписаниеОшибки());
		Результат.Вставить("ПолноеИмя", ПолноеИмя);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Получить список всех объектов метаданных определенного типа.
//
// Параметры:
//  ТипМетаданных - Строка - тип коллекции (например "Справочники", "Документы").
//
// Возвращаемое значение:
//  Массив из Структура -массив кратких описаний {Имя, Синоним, ПолноеИмя}.
//
Функция ПолучитьСписокОбъектовТипа(Знач ТипМетаданных) Экспорт

	КартаКоллекций = ПолучитьКартуКоллекцийМетаданных();
	СвойствоМетаданных = КартаКоллекций.Получить(ТипМетаданных);

	Если СвойствоМетаданных = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Попытка
		Коллекция = ПолучитьКоллекциюМетаданныхПоИмени(СвойствоМетаданных);
	Исключение
		Возврат Новый Массив;
	КонецПопытки;

	Если Коллекция = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого ОбъектМетаданных Из Коллекция Цикл
		Описание = Новый Соответствие;
		Описание.Вставить("Имя", ОбъектМетаданных.Имя);
		Описание.Вставить("Синоним", ОбъектМетаданных.Синоним);
		Описание.Вставить("ПолноеИмя", ОбъектМетаданных.ПолноеИмя());
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Получить дерево метаданных в формате JSON-строки.
//
// Параметры:
//  ФильтрТипов - Строка - фильтр типов (по умолчанию "").
//  ВключатьДочерние - Булево - по умолчанию Ложь.
//
// Возвращаемое значение:
//  Строка - JSON-представление дерева.
//
Функция ПолучитьДеревоМетаданныхJSON(Знач ФильтрТипов = "", Знач ВключатьДочерние = Ложь) Экспорт

	Дерево = ПостроитьДеревоМетаданных(ФильтрТипов, ВключатьДочерние);
	Возврат КИИ_HTTPКлиент.СтруктураВJson(Дерево, Истина);

КонецФункции

#КонецОбласти

#Область XMLДамп

// Разобрать XML-дамп конфигурации из текстового файла.
// Поддерживает формат выгрузки через Конфигуратор - Конфигурация - Выгрузить.
//
// Параметры:
//  ПутьКФайлу - Строка - путь к XML-файлу дампа.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -структура вида {"Объекты": [...], "Модули": [...]}.
//     Каждый объект: {"ПолноеИмя", "Тип", "Имя", "Синоним"}.
//     Каждый модуль: {"ПолноеИмя", "ВидМодуля", "Текст"}.
//
Функция РазобратьXMLДампКонфигурации(Знач ПутьКФайлу) Экспорт

	Результат = Новый Соответствие;

	ТекстФайла = ПрочитатьФайлДляРазбораXML(ПутьКФайлу, Результат);
	Если ТекстФайла = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат РазобратьТекстXMLДампаВРезультат(ТекстФайла);

КонецФункции

// Разбирает XML-текст дампа конфигурации в результат. Выделено из РазобратьXMLДампКонфигурации,
// чтобы контракт парсинга (в т.ч. сурфейсинг ошибки на битом XML вместо тихого пустого результата)
// покрывался тестами на фикстурах без файлового I/O.
//
// Параметры:
//  ТекстФайла - Строка - содержимое XML-дампа конфигурации.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Объекты, Модули, КоличествоОбъектов, КоличествоМодулей;
//  при сбое разбора - ключ Ошибка.
Функция РазобратьТекстXMLДампаВРезультат(Знач ТекстФайла) Экспорт

	Результат = Новый Соответствие;

	Состояние = Новый Структура;
	Состояние.Вставить("МассивОбъектов", Новый Массив);
	Состояние.Вставить("МассивМодулей", Новый Массив);
	Состояние.Вставить("ТекущийОбъект", Неопределено);
	Состояние.Вставить("ТекущийМодуль", Неопределено);

	Попытка
		РазобратьXMLТекстДампа(ТекстФайла, Состояние);
	Исключение
		Результат.Вставить("Ошибка", "Ошибка разбора XML: " + ОписаниеОшибки());
	КонецПопытки;

	Результат.Вставить("Объекты", Состояние.МассивОбъектов);
	Результат.Вставить("Модули", Состояние.МассивМодулей);
	Результат.Вставить("КоличествоОбъектов", Состояние.МассивОбъектов.Количество());
	Результат.Вставить("КоличествоМодулей", Состояние.МассивМодулей.Количество());

	Возврат Результат;

КонецФункции

// Возвращает текст in-band ошибки разбора XML-дампа, если он есть в результате.
// Разбор при битом XML не бросает исключение, а кладет ключ "Ошибка" в результат
// (Соответствие) - вызыватели, сериализующие результат в JSON, теряют этот сигнал.
//
// Параметры:
//  Результат - Соответствие из КлючИЗначение, Структура - результат РазобратьXMLДампКонфигурации.
//
// Возвращаемое значение:
//  Строка - текст ошибки разбора или "" (пусто), если ошибки нет.
//
Функция ТекстОшибкиРазбора(Знач Результат) Экспорт

	Значение = Неопределено;
	Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
		Значение = Результат.Получить("Ошибка");
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("Ошибка", Значение);
	Иначе
		// Результат не коллекция ключ-значение - поля "Ошибка" в нем нет.
		Значение = Неопределено;
	КонецЕсли;

	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

// Извлечь модули BSL из XML-дампа конфигурации.
//
// Параметры:
//  ПутьКФайлу - Строка - путь к XML-файлу дампа.
//  ФильтрОбъектов - Строка - фильтр по полному имени владельца (подстрока).
//                            По умолчанию "" (все модули).
//
// Возвращаемое значение:
//  Массив из Структура -каждый элемент: {"ПолноеИмяВладельца", "ВидМодуля", "Текст"}.
//
Функция ИзвлечьМодулиИзXMLДампа(Знач ПутьКФайлу, Знач ФильтрОбъектов = "") Экспорт

	РезультатРазбора = РазобратьXMLДампКонфигурации(ПутьКФайлу);

	Если РезультатРазбора.Получить("Ошибка") <> Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ВсеМодули = РезультатРазбора.Получить("Модули");
	Если ВсеМодули = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ФильтрОбъектов) Тогда
		Возврат ВсеМодули;
	КонецЕсли;

	Результат = Новый Массив;
	ФильтрВерхнийРегистр = ВРег(ФильтрОбъектов);
	Для Каждого Модуль Из ВсеМодули Цикл
		ПолноеИмяВладельца = Модуль.Получить("ПолноеИмяВладельца");
		Если ПолноеИмяВладельца <> Неопределено
			И СтрНайти(ВРег(ПолноеИмяВладельца), ФильтрВерхнийРегистр) > 0 Тогда
			Результат.Добавить(Модуль);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ИнтеграцияEDT

// Получить ошибки проекта из EDT MCP-сервера.
//
// Параметры:
//  ИмяПроекта - Строка - имя EDT-проекта.
//  ФильтрОбъектов - Строка - FQN объекта для фильтрации (необязательный).
//  Серьезность - Строка - уровень серьезности: "ERRORS", "BLOCKER", "CRITICAL", "MAJOR",
//                         "MINOR", "TRIVIAL". По умолчанию "" (все).
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат запроса к EDT:
//    {"errors": [...], "total": Число} или {"Ошибка": "текст"}.
//
Функция ПолучитьОшибкиИзEDT(Знач ИмяПроекта, Знач ФильтрОбъектов = "", Знач Серьезность = "") Экспорт

	Параметры = Новый Соответствие;
	Параметры.Вставить("projectName", ИмяПроекта);

	Если ЗначениеЗаполнено(ФильтрОбъектов) Тогда
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ФильтрОбъектов);
		Параметры.Вставить("objects", МассивОбъектов);
	КонецЕсли;

	Если ЗначениеЗаполнено(Серьезность) Тогда
		Параметры.Вставить("severity", Серьезность);
	КонецЕсли;

	Возврат ВыполнитьЗапросКEDT("get_project_errors", Параметры);

КонецФункции

// Получить метаданные объекта из EDT MCP-сервера.
//
// Параметры:
//  ИмяПроекта - Строка - имя EDT-проекта.
//  ОбъектFQN - Строка - FQN объекта (например "Catalog.Products").
//  Подробно - Булево - запросить полные свойства. По умолчанию Ложь.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат запроса к EDT.
//
Функция ПолучитьМетаданныеИзEDT(Знач ИмяПроекта, Знач ОбъектFQN, Знач Подробно = Ложь) Экспорт

	Параметры = Новый Соответствие;
	Параметры.Вставить("projectName", ИмяПроекта);

	МассивFQN = Новый Массив;
	МассивFQN.Добавить(ОбъектFQN);
	Параметры.Вставить("objectFqns", МассивFQN);

	Если Подробно Тогда
		Параметры.Вставить("full", Истина);
	КонецЕсли;

	Возврат ВыполнитьЗапросКEDT("get_metadata_details", Параметры);

КонецФункции

// Выполнить поиск в коде через EDT MCP-сервер.
//
// Параметры:
//  ИмяПроекта - Строка - имя EDT-проекта.
//  ТекстПоиска - Строка - текст для поиска.
//  РежимВывода - Строка - "full", "files", "count". По умолчанию "full".
//  МаксимальноеКоличество - Число - максимум результатов. По умолчанию 100.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат поиска.
//

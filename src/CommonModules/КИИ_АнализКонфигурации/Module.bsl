#Область ВзаимодействиеEDT

// Базовый URL EDT MCP-сервера.
Функция ПолучитьБазовыйURLEDT()
	Возврат "http://localhost:8764";
КонецФункции

// Выполнить запрос к EDT MCP-серверу.
//
// Параметры:
//  ИмяМетода - Строка - имя метода API EDT MCP (например "get_project_errors").
//  Параметры - Соответствие из КлючИЗначение - параметры запроса.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат запроса или {"Ошибка": "текст"}.
//
Функция ВыполнитьЗапросКEDT(ИмяМетода, Параметры)

	БазовыйURL = ПолучитьБазовыйURLEDT();
	URL = БазовыйURL + "/mcp";

	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("jsonrpc", "2.0");
	ТелоЗапроса.Вставить("id", 1);
	ТелоЗапроса.Вставить("method", "tools/call");

	ПараметрыВызова = Новый Соответствие;
	ПараметрыВызова.Вставить("name", ИмяМетода);
	ПараметрыВызова.Вставить("arguments", Параметры);
	ТелоЗапроса.Вставить("params", ПараметрыВызова);

	ТелоJSON = КИИ_HTTPКлиент.СтруктураВJson(ТелоЗапроса);

	Результат = КИИ_HTTPКлиент.ВыполнитьЗапросJSON("POST", URL, ТелоJSON);

	// ВыполнитьЗапросJSON отдает УЖЕ десериализованный JSON-RPC ответ (result/error),
	// либо {error, status_code} при HTTP/транспортной ошибке. Прежний код читал конверт
	// КодСостояния/Тело функции ВыполнитьЗапрос - этих ключей здесь НЕТ, из-за чего все
	// EDT-функции всегда возвращали «HTTP нет ответа» (интеграция была мертва).
	Возврат КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(Результат);

КонецФункции

#КонецОбласти

#Область ЧтениеФайлов

// Прочитать содержимое текстового файла.
Функция ПрочитатьТекстовыйФайл(ПутьКФайлу)

	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Попытка
		Текст = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
		Возврат Текст;
	Исключение
		ЧтениеТекста.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область РазборXMLДампа

// Проверяет безопасность пути к XML-дампу: путь приходит из поля формы и попадал в чтение файла
// без валидации → чтение произвольного файла сервера (аудит P2, безопасность). Запрещает обход
// каталога (..), UNC/сетевые пути, потоки NTFS и файлы не с расширением .xml.
// Полное ограничение до разрешенного корня (Константа) - отдельный шаг с добавлением метаданных.
//
// Возвращаемое значение:
//  Структура:
//   * Разрешен - Булево
//   * Причина  - Строка - пояснение отказа (пусто при Разрешен)
//
// Параметры:
//  Путь - Строка - путь к файлу XML-дампа для проверки.
Функция ПроверитьПутьДампаXML(Знач Путь) Экспорт

	Результат = Новый Структура("Разрешен, Причина", Ложь, "");
	Значение = СокрЛП(Путь);

	Если ПустаяСтрока(Значение) Тогда
		Результат.Причина = НСтр("ru = 'Путь не задан'");
		Возврат Результат;
	КонецЕсли;

	// Единый разделитель для проверок.
	Нормализованный = СтрЗаменить(Значение, "/", "\");

	Если СтрНачинаетсяС(Нормализованный, "\\") Тогда
		Результат.Причина = НСтр("ru = 'Сетевые (UNC) пути запрещены'");
		Возврат Результат;
	КонецЕсли;

	Если СтрНайти(Нормализованный, "..") > 0 Тогда
		Результат.Причина = НСтр("ru = 'Обход каталога (..) запрещен'");
		Возврат Результат;
	КонецЕсли;

	// ':' допустимо только как разделитель диска на позиции 2 (C:\...); прочее - поток NTFS/устройство.
	Если СтрНайти(Сред(Нормализованный, 3), ":") > 0 Тогда
		Результат.Причина = НСтр("ru = 'Недопустимый символ в пути'");
		Возврат Результат;
	КонецЕсли;

	Если Не СтрЗаканчиваетсяНа(НРег(Нормализованный), ".xml") Тогда
		Результат.Причина = НСтр("ru = 'Разрешены только файлы .xml'");
		Возврат Результат;
	КонецЕсли;

	Результат.Разрешен = Истина;
	Возврат Результат;

КонецФункции

// Прочитать файл для разбора XML с проверками. При ошибке заполняет Результат и возвращает Неопределено.
Функция ПрочитатьФайлДляРазбораXML(Знач ПутьКФайлу, Результат)

	ПроверкаПути = ПроверитьПутьДампаXML(ПутьКФайлу);
	Если Не ПроверкаПути.Разрешен Тогда
		Результат.Вставить("Ошибка", "Недопустимый путь: " + ПроверкаПути.Причина);
		Возврат Неопределено;
	КонецЕсли;

	Файл = Новый Файл(ПутьКФайлу);
	Если Не Файл.Существует() Тогда
		Результат.Вставить("Ошибка", "Файл не найден: " + ПутьКФайлу);
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ТекстФайла = ПрочитатьТекстовыйФайл(ПутьКФайлу);
	Исключение
		Результат.Вставить("Ошибка", "Ошибка чтения файла: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ТекстФайла) Тогда
		Результат.Вставить("Ошибка", "Файл пуст");
		Возврат Неопределено;
	КонецЕсли;

	Возврат ТекстФайла;

КонецФункции

// Разобрать XML-текст дампа, накапливая результат в Состоянии.
Процедура РазобратьXMLТекстДампа(Знач ТекстФайла, Состояние)

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);

	Пока ЧтениеXML.Прочитать() Цикл
		ОбработатьУзелXMLДампа(ЧтениеXML, Состояние);
	КонецЦикла;

	ЧтениеXML.Закрыть();

КонецПроцедуры

// Обработать один узел XML в контексте дампа конфигурации.
Процедура ОбработатьУзелXMLДампа(ЧтениеXML, Состояние)

	Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		ОбработатьНачалоЭлементаДампа(ЧтениеXML, Состояние);
		Возврат;
	КонецЕсли;

	Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
		ОбработатьКонецЭлементаДампа(ЧтениеXML, Состояние);
		Возврат;
	КонецЕсли;

	Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст И Состояние.ТекущийМодуль <> Неопределено Тогда
		Состояние.ТекущийМодуль.Вставить("Текст", ЧтениеXML.Значение);
	КонецЕсли;

КонецПроцедуры

// Обработать открывающий тег XML-элемента дампа.
Процедура ОбработатьНачалоЭлементаДампа(ЧтениеXML, Состояние)

	ИмяЭлемента = ЧтениеXML.Имя;

	Если ИмяЭлемента = "MetadataObject" Тогда
		ТекущийОбъект = Новый Соответствие;
		ТекущийОбъект.Вставить("Тип", ЧтениеXML.ЗначениеАтрибута("type"));
		ТекущийОбъект.Вставить("Имя", ЧтениеXML.ЗначениеАтрибута("name"));
		Состояние.ТекущийОбъект = ТекущийОбъект;
		Возврат;
	КонецЕсли;

	Если ИмяЭлемента = "Module" И Состояние.ТекущийОбъект <> Неопределено Тогда
		ТекущийМодуль = Новый Соответствие;
		ТекущийМодуль.Вставить("ВидМодуля", ЧтениеXML.ЗначениеАтрибута("type"));
		ТекущийМодуль.Вставить("ПолноеИмяВладельца",
			Состояние.ТекущийОбъект.Получить("Тип") + "." + Состояние.ТекущийОбъект.Получить("Имя"));
		Состояние.ТекущийМодуль = ТекущийМодуль;
		Возврат;
	КонецЕсли;

	Если ИмяЭлемента = "Property" И Состояние.ТекущийОбъект <> Неопределено Тогда
		ПрочитатьСвойствоОбъектаДампа(ЧтениеXML, Состояние.ТекущийОбъект);
	КонецЕсли;

КонецПроцедуры

// Прочитать значение свойства "Synonym"/"Comment" в текущий объект.
Процедура ПрочитатьСвойствоОбъектаДампа(ЧтениеXML, ТекущийОбъект)

	ИмяСвойства = ЧтениеXML.ЗначениеАтрибута("name");
	Если ИмяСвойства <> "Synonym" И ИмяСвойства <> "Comment" Тогда
		Возврат;
	КонецЕсли;

	Если ЧтениеXML.Прочитать() И ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
		ТекущийОбъект.Вставить(ИмяСвойства, ЧтениеXML.Значение);
	КонецЕсли;

КонецПроцедуры

// Обработать закрывающий тег XML-элемента дампа.
Процедура ОбработатьКонецЭлементаДампа(ЧтениеXML, Состояние)

	ИмяЭлемента = ЧтениеXML.Имя;

	Если ИмяЭлемента = "MetadataObject" И Состояние.ТекущийОбъект <> Неопределено Тогда
		Состояние.ТекущийОбъект.Вставить("ПолноеИмя",
			Состояние.ТекущийОбъект.Получить("Тип") + "." + Состояние.ТекущийОбъект.Получить("Имя"));
		Состояние.МассивОбъектов.Добавить(Состояние.ТекущийОбъект);
		Состояние.ТекущийОбъект = Неопределено;
		Возврат;
	КонецЕсли;

	Если ИмяЭлемента = "Module" И Состояние.ТекущийМодуль <> Неопределено Тогда
		Состояние.МассивМодулей.Добавить(Состояние.ТекущийМодуль);
		Состояние.ТекущийМодуль = Неопределено;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

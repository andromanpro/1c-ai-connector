// Получить карту коллекций метаданных: ключ - имя коллекции, значение - сама коллекция платформы.
Функция ПолучитьКартуКоллекцийМетаданных()

	Карта = Новый Соответствие;
	Карта.Вставить("Справочники", Метаданные.Справочники);
	Карта.Вставить("Документы", Метаданные.Документы);
	Карта.Вставить("РегистрыСведений", Метаданные.РегистрыСведений);
	Карта.Вставить("РегистрыНакопления", Метаданные.РегистрыНакопления);
	Карта.Вставить("РегистрыБухгалтерии", Метаданные.РегистрыБухгалтерии);
	Карта.Вставить("РегистрыРасчета", Метаданные.РегистрыРасчета);
	Карта.Вставить("Перечисления", Метаданные.Перечисления);
	Карта.Вставить("Отчеты", Метаданные.Отчеты);
	Карта.Вставить("Обработки", Метаданные.Обработки);
	Карта.Вставить("ПланыОбмена", Метаданные.ПланыОбмена);
	Карта.Вставить("ПланыСчетов", Метаданные.ПланыСчетов);
	Карта.Вставить("ПланыВидовХарактеристик", Метаданные.ПланыВидовХарактеристик);
	Карта.Вставить("ПланыВидовРасчета", Метаданные.ПланыВидовРасчета);
	Карта.Вставить("БизнесПроцессы", Метаданные.БизнесПроцессы);
	Карта.Вставить("Задачи", Метаданные.Задачи);
	Карта.Вставить("Константы", Метаданные.Константы);
	Карта.Вставить("ОбщиеМодули", Метаданные.ОбщиеМодули);
	Карта.Вставить("ОбщиеФормы", Метаданные.ОбщиеФормы);

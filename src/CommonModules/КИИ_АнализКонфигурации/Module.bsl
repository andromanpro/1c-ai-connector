			МассивРеквизитовТЧ.Добавить(ОписаниеРеквизита);
		КонецЦикла;
		ОписаниеТЧ.Вставить("Реквизиты", МассивРеквизитовТЧ);

		МассивТабличныхЧастей.Добавить(ОписаниеТЧ);
	КонецЦикла;

	Если МассивТабличныхЧастей.Количество() > 0 Тогда

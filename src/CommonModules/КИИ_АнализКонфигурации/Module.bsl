// Получить статистику конфигурации: количество объектов по типам.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -{"Справочники": 15, "Документы": 22, ...}.
//
Функция ПолучитьСтатистикуКонфигурации() Экспорт

	Результат = Новый Соответствие;
	КартаКоллекций = ПолучитьКартуКоллекцийМетаданных();

	Для Каждого ЭлементКарты Из КартаКоллекций Цикл
		Попытка
			Коллекция = ПолучитьКоллекциюМетаданныхПоИмени(ЭлементКарты.Значение);
			Если Коллекция <> Неопределено Тогда
				Количество = Коллекция.Количество();
				Если Количество > 0 Тогда
					Результат.Вставить(ЭлементКарты.Ключ, Количество);
				КонецЕсли;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	// Общий итог
	Итого = 0;
	Для Каждого Элемент Из Результат Цикл
		Итого = Итого + Элемент.Значение;
	КонецЦикла;
	Результат.Вставить("Итого", Итого);

	Возврат Результат;

КонецФункции

// Найти объекты метаданных по подстроке имени.
//
// Параметры:
//  ПодстрокаИмени - Строка - подстрока для поиска.
//  ТипМетаданных - Строка - фильтр по типу коллекции (необязательный).
//
// Возвращаемое значение:
//  Массив из Структура -найденные объекты {Имя, Синоним, ПолноеИмя, Тип}.
//
Функция НайтиОбъектыМетаданных(Знач ПодстрокаИмени, Знач ТипМетаданных = "") Экспорт

	Результат = Новый Массив;
	КартаКоллекций = ПолучитьКартуКоллекцийМетаданных();
	ПодстрокаВерхнийРегистр = ВРег(ПодстрокаИмени);

	Для Каждого ЭлементКарты Из КартаКоллекций Цикл

		Если ЗначениеЗаполнено(ТипМетаданных) И ЭлементКарты.Ключ <> ТипМетаданных Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Коллекция = ПолучитьКоллекциюМетаданныхПоИмени(ЭлементКарты.Значение);
		Исключение
			Продолжить;
		КонецПопытки;

		Если Коллекция = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			Если СтрНайти(ВРег(ОбъектМетаданных.Имя), ПодстрокаВерхнийРегистр) > 0
				Или СтрНайти(ВРег(ОбъектМетаданных.Синоним), ПодстрокаВерхнийРегистр) > 0 Тогда
				Описание = Новый Соответствие;
				Описание.Вставить("Имя", ОбъектМетаданных.Имя);
				Описание.Вставить("Синоним", ОбъектМетаданных.Синоним);
				Описание.Вставить("ПолноеИмя", ОбъектМетаданных.ПолноеИмя());
				Описание.Вставить("Тип", ЭлементКарты.Ключ);
				Результат.Добавить(Описание);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции


#Область ПрограммныйИнтерфейс

// Возвращает значение перечисления типа формата API, который покрывает данный провайдер.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.КИИ_ТипыФорматовAPI
//
Функция ИмяФормата() Экспорт
	Возврат Перечисления.КИИ_ТипыФорматовAPI.Anthropic;
КонецФункции

// Признак поддержки мультимодального ввода (изображения, файлы и т.п.).
// На текущем этапе разноса - Ложь, расширяется отдельной задачей.
//
// Возвращаемое значение:
//  Булево
//
Функция ПоддерживаетМультимодал() Экспорт
	Возврат Ложь;
КонецФункции

// Заполняет соответствие HTTP-заголовков в соответствии с форматом Anthropic.
//
// Параметры:
//  Параметры  - Структура - параметры модели (см. КИИ_КоннекторИИ.ПараметрыМодели)
//  КлючAPI    - Строка    - значение заголовка x-api-key
//  Заголовки  - Соответствие из КлючИЗначение - выходной параметр, HTTP-заголовки (имя → значение):
//   * Ключ - Строка - имя заголовка
//   * Значение - Строка - значение заголовка
//
Процедура СформироватьЗаголовки(Параметры, КлючAPI, Заголовки) Экспорт
	
	Заголовки.Вставить("Content-Type", "application/json");
	// x-api-key ставим только при заполненном ключе - как OpenAI (аудит P3): пустой заголовок не шлем.
	Если ЗначениеЗаполнено(КлючAPI) Тогда
		Заголовки.Вставить("x-api-key", КлючAPI);
	КонецЕсли;
	Заголовки.Вставить("anthropic-version", "2023-06-01");
	
КонецПроцедуры

// Формирует тело HTTP-запроса в формате Anthropic Messages API.
//
// Параметры:
//  Параметры        - Структура - параметры модели
//  СтруктураПромпта - Структура - системный/пользовательский промпт + опционально история сообщений
//  ТелоЗапроса      - Структура - выходной параметр (model, messages, max_tokens, system, temperature)
//
Процедура СформироватьТелоЗапроса(Параметры, СтруктураПромпта, ТелоЗапроса) Экспорт
	
	// Многоходовый режим (петля агент-анализа): диалог с tool-вызовами конвертируется
	// из OpenAI-формата сырых сообщений в блоки Anthropic Messages API.
	Если СтруктураПромпта.Свойство("СырыеСообщения")
		И КИИ_КоннекторИИОбщий.ЭтоМассив(СтруктураПромпта.СырыеСообщения)
		И СтруктураПромпта.СырыеСообщения.Количество() > 0 Тогда
		СформироватьТелоИзСырыхСообщений(Параметры, СтруктураПромпта, ТелоЗапроса);
		Возврат;
	КонецЕсли;

	МассивСообщений = Новый Массив;
	
	Если СтруктураПромпта.Свойство("ИсторияСообщений") Тогда
		Для Каждого Сообщение Из СтруктураПромпта.ИсторияСообщений Цикл
			СообщениеИстории = Новый Структура("role, content", Сообщение.Роль, Сообщение.Текст);
			МассивСообщений.Добавить(СообщениеИстории);
		КонецЦикла;
	КонецЕсли;
	
	СообщениеПользователь = Новый Структура("role, content", "user",
		КИИ_КоннекторИИОбщий.ТекстПользовательскогоПромпта(СтруктураПромпта.ПользовательскийПромпт));
	МассивСообщений.Добавить(СообщениеПользователь);
	
	ТелоЗапроса.Вставить("model", Параметры.НаименованиеПолное);
	ТелоЗапроса.Вставить("messages", МассивСообщений);
	ТелоЗапроса.Вставить("max_tokens", ?(Параметры.МаксимумТокенов > 0, Параметры.МаксимумТокенов, 4096));
	
	Если ЗначениеЗаполнено(СтруктураПромпта.СистемныйПромпт) Тогда
		ТелоЗапроса.Вставить("system", СтруктураПромпта.СистемныйПромпт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Температура) Тогда
		ТелоЗапроса.Вставить("temperature", Параметры.Температура);
	КонецЕсли;

	// Инструменты нужны и в одноходовом режиме: вызывающий мог передать их без сырых
	// сообщений (первый ход диалога) - иначе модель не узнает о функциях.
	ДобавитьИнструментыAnthropic(СтруктураПромпта, ТелоЗапроса);
	
КонецПроцедуры

// Разбирает JSON-ответ Anthropic Messages API и заполняет структуру результата.
// Не обрабатывает блок error - это делает общий КИИ_КоннекторИИОбщий.ЕстьОшибкаВОтветеAPI до диспетчеризации.
//
// Параметры:
//  ОтветJSON - Соответствие из КлючИЗначение - распарсенный JSON-ответ:
//   * Ключ - Строка - имя поля JSON
//   * Значение - Произвольный - значение поля
//  Результат - Структура    - выходной параметр (см. КИИ_КоннекторИИ.НовыйПараметрыОтветаИИ)
//
Процедура РазобратьОтвет(ОтветJSON, Результат) Экспорт

	ИзвлечьТекстОтвета(ОтветJSON, Результат);
	ИзвлечьМетаданные(ОтветJSON, Результат);
	ИзвлечьТокены(ОтветJSON, Результат);
	ИзвлечьВызовыИнструментов(ОтветJSON, Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тело многоходового запроса из сырых сообщений OpenAI-формата (петля инструментов):
// system уходит в поле system, assistant с tool_calls - в блоки tool_use,
// tool-результаты - в user-сообщения с блоками tool_result.
Процедура СформироватьТелоИзСырыхСообщений(Параметры, СтруктураПромпта, ТелоЗапроса)

	МассивСообщений = Новый Массив;
	ЧастиСистемы = Новый Массив;

	Для Каждого Сообщение Из СтруктураПромпта.СырыеСообщения Цикл

		Если Сообщение.role = "system" Тогда
			ЧастиСистемы.Добавить(Строка(Сообщение.content));
		ИначеЕсли Сообщение.role = "assistant" Тогда
			МассивСообщений.Добавить(СообщениеАссистентаAnthropic(Сообщение));
		ИначеЕсли Сообщение.role = "tool" Тогда
			ДобавитьРезультатИнструментаAnthropic(МассивСообщений, Сообщение);
		Иначе
			МассивСообщений.Добавить(Новый Структура("role, content", "user", Сообщение.content));
		КонецЕсли;

	КонецЦикла;

	ТелоЗапроса.Вставить("model", Параметры.НаименованиеПолное);
	ТелоЗапроса.Вставить("messages", МассивСообщений);
	ТелоЗапроса.Вставить("max_tokens", ?(Параметры.МаксимумТокенов > 0, Параметры.МаксимумТокенов, 4096));

	Если ЧастиСистемы.Количество() > 0 Тогда
		ТелоЗапроса.Вставить("system", СтрСоединить(ЧастиСистемы, Символы.ПС));
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.Температура) Тогда
		ТелоЗапроса.Вставить("temperature", Параметры.Температура);
	КонецЕсли;

	ДобавитьИнструментыAnthropic(СтруктураПромпта, ТелоЗапроса);

КонецПроцедуры

Функция СообщениеАссистентаAnthropic(Сообщение)

	Блоки = Новый Массив;

	ТекстАссистента = Строка(Сообщение.content);
	Если ЗначениеЗаполнено(ТекстАссистента) Тогда
		Блоки.Добавить(Новый Структура("type, text", "text", ТекстАссистента));
	КонецЕсли;

	Если Сообщение.Свойство("tool_calls") И КИИ_КоннекторИИОбщий.ЭтоМассив(Сообщение.tool_calls) Тогда
		Для Каждого Вызов Из Сообщение.tool_calls Цикл
			БлокВызова = Новый Структура;
			БлокВызова.Вставить("type", "tool_use");
			БлокВызова.Вставить("id", Вызов.id);
			БлокВызова.Вставить("name", Вызов.function.name);
			БлокВызова.Вставить("input", КИИ_КоннекторИИОбщий.СтрокаJSONВЗначение(Вызов.function.arguments));
			Блоки.Добавить(БлокВызова);
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("role, content", "assistant", Блоки);

КонецФункции

// tool-результаты, идущие подряд, склеиваются в одно user-сообщение: Anthropic требует
// чередования ролей user/assistant, отдельные user-сообщения подряд API отвергает.
Процедура ДобавитьРезультатИнструментаAnthropic(МассивСообщений, Сообщение)

	БлокРезультата = Новый Структура;
	БлокРезультата.Вставить("type", "tool_result");
	БлокРезультата.Вставить("tool_use_id", Сообщение.tool_call_id);
	БлокРезультата.Вставить("content", Строка(Сообщение.content));

	КоличествоСообщений = МассивСообщений.Количество();
	Если КоличествоСообщений > 0 Тогда
		Последнее = МассивСообщений[КоличествоСообщений - 1];
		Если Последнее.role = "user"
			И КИИ_КоннекторИИОбщий.ЭтоМассив(Последнее.content)
			И Последнее.content.Количество() > 0 Тогда
			Последнее.content.Добавить(БлокРезультата);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Содержимое = Новый Массив;
	Содержимое.Добавить(БлокРезультата);
	МассивСообщений.Добавить(Новый Структура("role, content", "user", Содержимое));

КонецПроцедуры

Процедура ДобавитьИнструментыAnthropic(СтруктураПромпта, ТелоЗапроса)

	Если Не СтруктураПромпта.Свойство("Инструменты")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(СтруктураПромпта.Инструменты)
		Или СтруктураПромпта.Инструменты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИнструментыAnthropic = Новый Массив;
	Для Каждого Инструмент Из СтруктураПромпта.Инструменты Цикл
		Описание = Новый Структура;
		Описание.Вставить("name", Инструмент.function.name);
		Описание.Вставить("description", Инструмент.function.description);
		Описание.Вставить("input_schema", Инструмент.function.parameters);
		ИнструментыAnthropic.Добавить(Описание);
	КонецЦикла;

	ТелоЗапроса.Вставить("tools", ИнструментыAnthropic);

КонецПроцедуры

// Извлекает блоки tool_use ответа в Результат.ВызовыИнструментов (контракт петли:
// аргументы - строкой JSON, как у OpenAI; Anthropic отдает input объектом).
Процедура ИзвлечьВызовыИнструментов(ОтветJSON, Результат)

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON)
		Или Не ОтветJSON.Свойство("content")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(ОтветJSON.content) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Блок Из ОтветJSON.content Цикл

		Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Блок)
			Или Не Блок.Свойство("type")
			Или Блок.type <> "tool_use" Тогда
			Продолжить;
		КонецЕсли;

		Вызов = Новый Структура("Идентификатор, Имя, Аргументы", "", "", "{}");
		Если Блок.Свойство("id") Тогда
			Вызов.Идентификатор = Строка(Блок.id);
		КонецЕсли;
		Если Блок.Свойство("name") Тогда
			Вызов.Имя = Строка(Блок.name);
		КонецЕсли;
		Если Блок.Свойство("input") Тогда
			Вызов.Аргументы = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Блок.input);
		КонецЕсли;

		Результат.ВызовыИнструментов.Добавить(Вызов);

	КонецЦикла;

КонецПроцедуры

Процедура ИзвлечьТекстОтвета(ОтветJSON, Результат)

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON) Тогда
		Возврат;
	КонецЕсли;

	Если Не ОтветJSON.Свойство("content") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(ОтветJSON.content)
		Или ОтветJSON.content.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Собираем текст со ВСЕХ блоков с полем text: у моделей с extended thinking / tool_use первым
	// идет не-text блок, и прежний content[0].text терял ответ (аудит P3).
	ЧастиТекста = Новый Массив;
	Для Каждого Элемент Из ОтветJSON.content Цикл
		Если КИИ_КоннекторИИОбщий.ЭтоСтруктура(Элемент) И Элемент.Свойство("text") Тогда
			Текст = Элемент.text;
			Если ТипЗнч(Текст) = Тип("Строка") Тогда
				ЧастиТекста.Добавить(Текст);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ЧастиТекста.Количество() > 0 Тогда
		Результат.ТекстОтвета = СтрСоединить(ЧастиТекста, "");
	КонецЕсли;

КонецПроцедуры

Процедура ИзвлечьМетаданные(ОтветJSON, Результат)

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON) Тогда
		Возврат;
	КонецЕсли;

	Если ОтветJSON.Свойство("id") Тогда
		Результат.IDЗапроса = ОтветJSON.id;
	КонецЕсли;

	Если ОтветJSON.Свойство("model") Тогда
		Результат.МодельОтвета = ОтветJSON.model;
	КонецЕсли;

	Если ОтветJSON.Свойство("stop_reason") Тогда
		Результат.ПричинаЗавершения = ОтветJSON.stop_reason;
	КонецЕсли;

КонецПроцедуры

Процедура ИзвлечьТокены(ОтветJSON, Результат)

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON) Тогда
		Возврат;
	КонецЕсли;

	Если Не ОтветJSON.Свойство("usage") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON.usage) Тогда
		Возврат;
	КонецЕсли;

	Использование = ОтветJSON.usage;

	Если Использование.Свойство("input_tokens") Тогда
		Результат.ВходныеТокены = Использование.input_tokens;
	КонецЕсли;

	Если Использование.Свойство("output_tokens") Тогда
		Результат.ВыходныеТокены = Использование.output_tokens;
	КонецЕсли;

	Результат.ВсегоТокенов = Результат.ВходныеТокены + Результат.ВыходныеТокены;

КонецПроцедуры

#КонецОбласти

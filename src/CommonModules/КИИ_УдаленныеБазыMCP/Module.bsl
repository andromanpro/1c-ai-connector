#Область ПрограммныйИнтерфейс

// Проверяет публикацию с настоящим пользователем 1С. Сохраненные секреты не возвращает.
// Параметры:
//  Соединение - Структура - Адрес, Пользователь, Пароль, Таймаут, ИдентификаторБазы.
// Возвращаемое значение:
//  Структура - сведения о конфигурации, базе и фактическом пользователе сеанса:
//   * database_id - Строка - UUID целевой базы.
//   * configuration_name - Строка - имя конфигурации.
//   * configuration_version - Строка - версия конфигурации.
Функция ПроверитьПодключение(Соединение) Экспорт

	Перем ПараметрыВызова;
	Параметры = Новый Структура;
	Параметры.Вставить("protocolVersion", "2025-11-25");
	Параметры.Вставить("capabilities", Новый Структура);
	ПараметрыВызова = Новый Структура("name, version", "iikona-databases", "1");
	Параметры.Вставить("clientInfo", ПараметрыВызова);
	// Публикация с фиксированными usr/pwd не должна молча подменять личный вход.
	ЗапросRPC(Соединение, "initialize", Параметры, Ложь, Истина);
	Инициализация = ЗапросRPC(Соединение, "initialize", Параметры);
	Если ТипЗнч(Инициализация) <> Тип("Структура")
		Или Не Инициализация.Свойство("protocolVersion")
		Или Инициализация.protocolVersion <> "2025-11-25" Тогда
		ВызватьИсключение НСтр("ru = 'mcp_protocol_unsupported: версия MCP целевой базы не поддерживается.'");
	КонецЕсли;
	ЗапросRPC(Соединение, "notifications/initialized", Новый Структура, Истина);
	Сведения = ВызовИнструмента(Соединение, "get_configuration_info", Новый Структура);
	ПроверитьСведенияОБазе(Сведения, Соединение.Пользователь, Соединение.ИдентификаторБазы);
	Возврат Сведения;
КонецФункции

// Выполняет инструмент после проверки фактического пользователя и закрепленного ID базы.
// Параметры:
//  Соединение - См. ПроверитьПодключение.Соединение
//  ИмяИнструмента - Строка - имя инструмента MCP.
//  Аргументы - Структура - параметры без центрального database_id.
// Возвращаемое значение:
//  Произвольный - структурированные данные инструмента.
Функция ВыполнитьИнструмент(Соединение, Знач ИмяИнструмента, Аргументы) Экспорт

	Перем РезультатФункции;
	Если ПустаяСтрока(Соединение.ИдентификаторБазы) Тогда
		ВызватьИсключение НСтр("ru = 'mcp_database_not_pinned: сначала проверьте и сохраните подключение к базе.'");
	КонецЕсли;
	ПроверитьПодключение(Соединение);
	РезультатФункции = ВызовИнструмента(Соединение, ИмяИнструмента, Аргументы);
	Возврат РезультатФункции;
КонецФункции

// Проверяет сведения до первого прикладного инструмента. Ошибка не меняет источник.
// Параметры:
//  Сведения - Структура - результат get_configuration_info.
//  Пользователь - Строка - ожидаемый пользователь ИБ.
//  ИдентификаторБазы - Строка - ожидаемый ID; пустой при первоначальной настройке.
Процедура ПроверитьСведенияОБазе(Сведения, Знач Пользователь, Знач ИдентификаторБазы) Экспорт
	Если ТипЗнч(Сведения) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'mcp_identity_missing: целевая база не вернула сведения о сеансе.'");
	КонецЕсли;
	Если Не Сведения.Свойство("connection_protocol")
		Или ТипЗнч(Сведения.connection_protocol) <> Тип("Число")
		Или Сведения.connection_protocol <> 1 Тогда
		ВызватьИсключение НСтр("ru = 'mcp_connection_version: обновите расширение в целевой базе.'");
	КонецЕсли;
	Если Не Сведения.Свойство("session_user") Или ТипЗнч(Сведения.session_user) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'mcp_identity_missing: целевая база не указала пользователя сеанса.'");
	КонецЕсли;
	Если ПустаяСтрока(Пользователь) Или НРег(Сведения.session_user) <> НРег(Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'mcp_user_mismatch: публикация открыла сеанс другого пользователя 1С.'");
	КонецЕсли;
	Если Не Сведения.Свойство("database_id") Или ТипЗнч(Сведения.database_id) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'mcp_identity_missing: целевая база не указала свой идентификатор.'");
	КонецЕсли;
	Если ПустаяСтрока(Сведения.database_id) Тогда
		ВызватьИсключение НСтр("ru = 'mcp_identity_missing: идентификатор целевой базы не заполнен.'");
	КонецЕсли;
	Если Не ПустаяСтрока(ИдентификаторБазы) И Сведения.database_id <> ИдентификаторБазы Тогда
		ВызватьИсключение НСтр("ru = 'mcp_database_mismatch: по этому адресу опубликована другая база.'");
	КонецЕсли;
КонецПроцедуры

// Строго разбирает ответ конкретного JSON-RPC запроса, не возвращая текст HTTP-ошибок.
// Параметры:
//  КодHTTP - Число - код состояния HTTP.
//  Тело - Строка - JSON-ответ.
//  Идентификатор - Строка - ID отправленного запроса.
// Возвращаемое значение:
//  Произвольный - поле result успешного ответа.
Функция РазобратьОтветRPC(Знач КодHTTP, Знач Тело, Знач Идентификатор) Экспорт

	Перем ФорматированноеЗначение;
	Если КодHTTP >= 300 И КодHTTP < 400 Тогда
		ВызватьИсключение НСтр("ru = 'mcp_redirect_refused: укажите конечный адрес публикации без перенаправления.'");
	КонецЕсли;
	Если КодHTTP <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'mcp_http_%1: запрос к целевой базе отклонен.'"), КодHTTP);
	КонецЕсли;
	Попытка
		Ответ = КИИ_КоннекторИИОбщий.ЗначениеИзСтрокиJSON(Тело, Ложь);
	Исключение
		ВызватьИсключение НСтр("ru = 'mcp_invalid_response: целевая база вернула некорректный JSON.'");
	КонецПопытки;
	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'mcp_invalid_response: ожидается объект JSON-RPC.'");
	КонецЕсли;
	Если Не ОтветСоответствуетЗапросу(Ответ, Идентификатор) Тогда
		ВызватьИсключение НСтр("ru = 'mcp_response_mismatch: ответ не соответствует отправленному запросу.'");
	КонецЕсли;
	ЕстьРезультат = Ответ.Свойство("result");
	ЕстьОшибка = Ответ.Свойство("error");
	Если ЕстьРезультат = ЕстьОшибка Тогда
		ВызватьИсключение НСтр("ru = 'mcp_invalid_response: неоднозначный результат JSON-RPC.'");
	КонецЕсли;
	Если ЕстьОшибка Тогда
		// Сообщение чужого сервиса может содержать реквизиты входа. Возвращаем только код.
		Если Не КорректнаяОшибкаRPC(Ответ.error) Тогда
			ВызватьИсключение НСтр("ru = 'mcp_invalid_response: некорректная ошибка JSON-RPC.'");
		КонецЕсли;
		ФорматированноеЗначение = Формат(Ответ.error.code, "ЧГ=0; ЧДЦ=0");
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'mcp_rpc_error_%1: целевая база не выполнила запрос.'"), ФорматированноеЗначение);
	КонецЕсли;
	Возврат Ответ.result;
КонецФункции

// Проверяет адрес публикации без сети и реквизитов входа.
// Параметры:
//  Адрес - Строка - полный адрес целевого /hs/iikona-mcp/connection.
// Возвращаемое значение:
//  См. ОбщегоНазначенияКлиентСервер.СтруктураURI
Функция ПроверитьАдрес(Знач Адрес) Экспорт
	Попытка
		ПараметрыURL = ОбщегоНазначенияКлиентСервер.СтруктураURI(Адрес);
	Исключение
		ВызватьИсключение НСтр(
			"ru = 'mcp_invalid_address: проверьте адрес публикации. Логин и пароль вводятся отдельно.'");
	КонецПопытки;
	ДопустимаяСхема = НРег(ПараметрыURL.Схема) = "http" Или НРег(ПараметрыURL.Схема) = "https";
	ЕстьЛишниеЧасти = ЗначениеЗаполнено(ПараметрыURL.Логин)
		Или СтрНайти(Адрес, "?") > 0 Или СтрНайти(Адрес, "#") > 0;
	ДопустимыйПуть = СтрЗаканчиваетсяНа("/" + ПараметрыURL.ПутьНаСервере, "/hs/iikona-mcp/connection");
	НеверныйАдрес = Не ДопустимаяСхема Или ПустаяСтрока(ПараметрыURL.Хост) Или ЕстьЛишниеЧасти;
	Если НеверныйАдрес Или Не ДопустимыйПуть Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'mcp_invalid_address: укажите полный адрес HTTP/HTTPS, оканчивающийся на %1. %2'"),
			"/hs/iikona-mcp/connection", НСтр("ru = 'Логин и пароль вводятся отдельно.'"));
	КонецЕсли;
	Возврат ПараметрыURL;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВызовИнструмента(Соединение, Знач ИмяИнструмента, Аргументы)
	Параметры = Новый Структура("name, arguments", ИмяИнструмента, Аргументы);
	Ответ = ЗапросRPC(Соединение, "tools/call", Параметры);
	Если ТипЗнч(Ответ) <> Тип("Структура")
		Или Не Ответ.Свойство("isError")
		Или ТипЗнч(Ответ.isError) <> Тип("Булево") Тогда
		ВызватьИсключение НСтр("ru = 'mcp_invalid_tool_result: некорректный результат инструмента.'");
	КонецЕсли;
	Если Ответ.isError Тогда
		СтруктурированныеДанные = Неопределено;
		ОшибкаИнструмента = Неопределено;
		Если Ответ.Свойство("structuredContent", СтруктурированныеДанные)
			И ТипЗнч(СтруктурированныеДанные) = Тип("Структура") Тогда
			Если СтруктурированныеДанные.Свойство("error", ОшибкаИнструмента) Тогда
				КИИ_СерверMCPДиспетчер.ВызватьОшибкуИнструмента(ОшибкаИнструмента);
			КонецЕсли;
		КонецЕсли;
		ВызватьИсключение НСтр("ru = 'mcp_tool_error: целевая база не выполнила инструмент.'");
	КонецЕсли;
	Если Не Ответ.Свойство("structuredContent") Тогда
		ВызватьИсключение НСтр("ru = 'mcp_invalid_tool_result: отсутствуют структурированные данные.'");
	КонецЕсли;
	Возврат Ответ.structuredContent;
КонецФункции

Функция ЗапросRPC(Соединение, Знач Метод, Параметры, Знач Уведомление = Ложь, Знач ПроверкаВхода = Ложь)

	Перем ТелоКакСтрокуЗначение;

	Перем РезультатBase64Строка;
	Перем ТекстJSON;

	Перем РезультатФункции;
	ПараметрыURL = ПроверитьАдрес(Соединение.Адрес);
	Если ПустаяСтрока(Соединение.Пользователь) Или СтрНайти(Соединение.Пользователь, ":") > 0 Тогда
		ВызватьИсключение НСтр("ru = 'mcp_user_required: укажите имя пользователя 1С для входа в публикацию.'");
	КонецЕсли;
	ЗащищенноеСоединение = Неопределено;
	Если НРег(ПараметрыURL.Схема) = "https" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;
	Таймаут = Соединение.Таймаут;
	Если Таймаут <= 0 Тогда
		Таймаут = 60;
	КонецЕсли;
	СоединениеHTTP = Новый HTTPСоединение(ПараметрыURL.Хост, ПараметрыURL.Порт, , , , Таймаут, ЗащищенноеСоединение);
	ЗапросHTTP = Новый HTTPЗапрос("/" + ПараметрыURL.ПутьНаСервере);
	ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗапросHTTP.Заголовки.Вставить("Accept", "application/json");
	ЗапросHTTP.Заголовки.Вставить("MCP-Protocol-Version", "2025-11-25");
	Если Не ПроверкаВхода Тогда
		ДанныеВхода = ПолучитьДвоичныеДанныеИзСтроки(
			Соединение.Пользователь + ":" + Соединение.Пароль, КодировкаТекста.UTF8);
		РезультатBase64Строка = Base64Строка(ДанныеВхода);
		ЗапросHTTP.Заголовки.Вставить("Authorization", "Basic " + РезультатBase64Строка);
	КонецЕсли;
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Тело = Новый Структура("jsonrpc, method, params", "2.0", Метод, Параметры);
	Если Не Уведомление Тогда
		Тело.Вставить("id", Идентификатор);
	КонецЕсли;
	ТекстJSON = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Тело);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8);
	Попытка
		ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
	Исключение
		ВызватьИсключение НСтр(
			"ru = 'mcp_transport_error: целевая база недоступна. Проверьте сеть, адрес и сертификат.'");
	КонецПопытки;
	Если ПроверкаВхода Тогда
		Если ОтветHTTP.КодСостояния <> 401 Тогда
			ОписаниеПубликации = НСтр(
				"ru = 'публикация должна требовать штатный вход пользователя 1С без фиксированных реквизитов в файле публикации.'");
			ТекстОшибки = СтрШаблон("%1 %2", "mcp_publication_auth_required:", ОписаниеПубликации);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Если Уведомление Тогда
		Если ОтветHTTP.КодСостояния <> 202 Тогда
			ВызватьИсключение НСтр("ru = 'mcp_notification_rejected: целевая база не завершила инициализацию MCP.'");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	ТелоКакСтрокуЗначение = ОтветHTTP.ПолучитьТелоКакСтроку();
	РезультатФункции = РазобратьОтветRPC(ОтветHTTP.КодСостояния, ТелоКакСтрокуЗначение, Идентификатор);
	Возврат РезультатФункции;
КонецФункции

Функция ОтветСоответствуетЗапросу(Ответ, Знач Идентификатор)

	Перем РезультатФункции;
	Если Не Ответ.Свойство("jsonrpc") Или Не Ответ.Свойство("id") Тогда
		Возврат Ложь;
	КонецЕсли;
	РезультатФункции = Ответ.jsonrpc = "2.0" И Ответ.id = Идентификатор;
	Возврат РезультатФункции;
КонецФункции

Функция КорректнаяОшибкаRPC(Знач ОшибкаRPC)

	Перем РезультатФункции;
	Если ТипЗнч(ОшибкаRPC) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ОшибкаRPC.Свойство("code") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(ОшибкаRPC.code) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;
	РезультатФункции = ОшибкаRPC.code = Цел(ОшибкаRPC.code);
	Возврат РезультатФункции;
КонецФункции

#КонецОбласти

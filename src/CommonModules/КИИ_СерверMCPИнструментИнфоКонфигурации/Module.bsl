#Область ПрограммныйИнтерфейс

// Декларация инструмента get_configuration_info для container-pattern.
//
// Параметры:
//  Таблица - ТаблицаЗначений - реестр инструментов:
//   * Имя - Строка - имя инструмента
//   * Описание - Строка - описание инструмента
//   * Схема - Структура - JSON-схема аргументов
//
Процедура ДобавитьИнструменты(Таблица) Экспорт
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Имя = "get_configuration_info";
	ОписаниеКонфигурации = НСтр("ru = 'Возвращает сведения о конфигурации, платформе и режиме базы.'");
	СведенияОРасширениях = СтрШаблон("%1 %2",
		НСтр("ru = 'Список extensions достоверен только при extensions_status=available;'"),
		НСтр("ru = 'unavailable означает, что список недоступен, а не что расширений нет.'"));
	НоваяСтрока.Описание = СтрШаблон("%1 %2", ОписаниеКонфигурации, СведенияОРасширениях);
	НоваяСтрока.Схема = Новый Структура("type, properties, additionalProperties", "object", Новый Структура, Ложь);
	
КонецПроцедуры

// Выполняет инструмент get_configuration_info.
//
// Параметры:
//  ИмяИнструмента - Строка - имя MCP-инструмента
//  Аргументы - Структура - не используются
//
// Возвращаемое значение:
//  Структура - сведения о конфигурации:
//   * configuration_name - Строка - имя конфигурации
//   * configuration_synonym - Строка - синоним конфигурации
//   * configuration_version - Строка - версия конфигурации
//   * vendor - Строка - поставщик
//   * platform_version - Строка - версия платформы
//   * compatibility_mode - Строка - режим совместимости
//   * database_mode - Строка - режим базы (файловая/клиент-сервер)
//   * extensions - Массив из Структура - сведения о расширениях: name, version, active
//   * extensions_status - Строка - available: список получен; unavailable: список недоступен
//   * connection_protocol - Число - версия протокола подключённых баз.
//   * session_user - Строка - имя текущего пользователя целевой базы.
//   * database_id - Строка - уникальный идентификатор информационной базы.
//
Функция ВыполнитьИнструмент(Знач ИмяИнструмента, Знач Аргументы) Экспорт

	Перем РезультатБезопасныйСиноним;
	Перем РезультатВерсияКонфигурации;
	Перем РезультатПоставщикКонфигурации;
	Перем РезультатСтрокаВерсии;
	Перем РезультатРежимСовместимостиКонфигурации;
	Перем РезультатРежимИнформационнойБазы;
	Перем РезультатСписокРасширений;
	Перем РезультатИмяПользователя;
	Перем РезультатИдентификаторИнформационнойБазы;
	
	Если ИмяИнструмента <> "get_configuration_info" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Неподдерживаемый инструмент %1 для модуля КИИ_СерверMCPИнструментИнфоКонфигурации'"),
			ИмяИнструмента);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("configuration_name", Метаданные.Имя);
	РезультатБезопасныйСиноним = БезопасныйСиноним(Метаданные);
	Результат.Вставить("configuration_synonym", РезультатБезопасныйСиноним);
	РезультатВерсияКонфигурации = ВерсияКонфигурации();
	Результат.Вставить("configuration_version", РезультатВерсияКонфигурации);
	РезультатПоставщикКонфигурации = ПоставщикКонфигурации();
	Результат.Вставить("vendor", РезультатПоставщикКонфигурации);
	РезультатСтрокаВерсии = СтрокаВерсии();
	Результат.Вставить("platform_version", РезультатСтрокаВерсии);
	РезультатРежимСовместимостиКонфигурации = РежимСовместимостиКонфигурации();
	Результат.Вставить("compatibility_mode", РезультатРежимСовместимостиКонфигурации);
	РезультатРежимИнформационнойБазы = РежимИнформационнойБазы();
	Результат.Вставить("database_mode", РезультатРежимИнформационнойБазы);
	СтатусРасширений = "unavailable";
	РезультатСписокРасширений = СписокРасширений(СтатусРасширений);
	Результат.Вставить("extensions", РезультатСписокРасширений);
	Результат.Вставить("extensions_status", СтатусРасширений);
	РезультатИмяПользователя = ИмяПользователя();
	Результат.Вставить("session_user", РезультатИмяПользователя);
	РезультатИдентификаторИнформационнойБазы = СтандартныеПодсистемыСервер.ИдентификаторИнформационнойБазы();
	Результат.Вставить("database_id", РезультатИдентификаторИнформационнойБазы);
	Результат.Вставить("connection_protocol", 1);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция БезопасныйСиноним(Знач ОбъектМетаданных)

	Перем РезультатФункции;
	
	Попытка
		Синоним = Строка(ОбъектМетаданных.Синоним);
	Исключение
		Синоним = "";
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Синоним) Тогда
		Возврат Синоним;
	КонецЕсли;
	
	Попытка
		РезультатФункции = Строка(ОбъектМетаданных.Имя);
		Возврат РезультатФункции;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ВерсияКонфигурации()

	Перем РезультатФункции;
	
	Попытка
		Если Метаданные.Версия = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		РезультатФункции = Строка(Метаданные.Версия);
		Возврат РезультатФункции;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ПоставщикКонфигурации()

	Перем РезультатФункции;
	
	Попытка
		Если Метаданные.Поставщик = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		РезультатФункции = Строка(Метаданные.Поставщик);
		Возврат РезультатФункции;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция РежимСовместимостиКонфигурации()

	Перем РезультатФункции;
	
	Попытка
		Если Метаданные.РежимСовместимости = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		РезультатФункции = Строка(Метаданные.РежимСовместимости);
		Возврат РезультатФункции;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция РежимИнформационнойБазы()
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	
	Если СтрНайти(СтрокаСоединения, "File=") > 0 Тогда
		Возврат "file";
	КонецЕсли;
	
	Если СтрНайти(СтрокаСоединения, "Srvr=") > 0 Тогда
		Возврат "server";
	КонецЕсли;
	
	Возврат "unknown";
	
КонецФункции

// Список расширений необязателен для основных сведений о базе.
// Статус - Строка - available при успешном чтении, unavailable при отказе платформы.
Функция СписокРасширений(Статус)

	Перем РезультатСвойствоРасширенияИмя;
	Перем РезультатСвойствоРасширенияВерсия;
	Перем РезультатСвойствоРасширенияАктивно;

	Перем ТекстСообщения;
	Перем ДанныеОшибки;
	Перем ПодробностиОшибки;
	Расширения = Новый Массив;
	Статус = "unavailable";
	Попытка
		КоллекцияРасширений = РасширенияКонфигурации.Получить();
	Исключение
		// Основные сведения остаются доступны пользователю без административных прав.
		// Явный статус не позволяет принять отсутствие доступа за отсутствие расширений.
		ТекстСообщения = НСтр("ru = 'КИИ.СерверMCP.СведенияОРасширениях'");
		ДанныеОшибки = ИнформацияОбОшибке();
		ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Предупреждение, , , ПодробностиОшибки);
		Возврат Расширения;
	КонецПопытки;
	Для Каждого Расширение Из КоллекцияРасширений Цикл
		ОписаниеРасширения = Новый Структура;
		РезультатСвойствоРасширенияИмя = СвойствоРасширенияИмя(Расширение);
		ОписаниеРасширения.Вставить("name", РезультатСвойствоРасширенияИмя);
		РезультатСвойствоРасширенияВерсия = СвойствоРасширенияВерсия(Расширение);
		ОписаниеРасширения.Вставить("version", РезультатСвойствоРасширенияВерсия);
		РезультатСвойствоРасширенияАктивно = СвойствоРасширенияАктивно(Расширение);
		ОписаниеРасширения.Вставить("active", РезультатСвойствоРасширенияАктивно);
		Расширения.Добавить(ОписаниеРасширения);
	КонецЦикла;
	Статус = "available";
	Возврат Расширения;
КонецФункции

Функция СвойствоРасширенияИмя(Знач Расширение)

	Перем РезультатФункции;
	
	Попытка
		РезультатФункции = Строка(Расширение.Имя);
		Возврат РезультатФункции;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция СвойствоРасширенияВерсия(Знач Расширение)

	Перем РезультатФункции;
	
	Попытка
		Если Расширение.Версия = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		РезультатФункции = Строка(Расширение.Версия);
		Возврат РезультатФункции;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция СвойствоРасширенияАктивно(Знач Расширение)
	
	Попытка
		Возврат Расширение.Активно;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция СтрокаВерсии()

	Перем РезультатФункции;
	
	Попытка
		ИнфоПриложения = Новый СистемнаяИнформация();
		РезультатФункции = Строка(ИнфоПриложения.ВерсияПриложения);
		Возврат РезультатФункции;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

#КонецОбласти

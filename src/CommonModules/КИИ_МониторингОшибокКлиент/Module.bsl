#Область ПрограммныйИнтерфейс

// Обрабатывает действие формы: ПриОткрытии.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
//  Отказ - Произвольный - параметр действия.
Процедура ПриОткрытии(Форма, Отказ) Экспорт

	Форма.ПодписьРазбора = НСтр("ru = 'Выберите ошибку в списке.'");
	Форма.HTMLРазбора = КИИ_МаркдаунПарсерКлиентСервер.ДокументРазбора(Форма.ПодписьРазбора);
	СписокПриАктивизацииСтроки(Форма, Форма.Элементы.Список);

КонецПроцедуры

// Загружает детали выбранной ошибки без передачи формы на сервер.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
//  Элемент - ТаблицаФормы - элемент списка.
Процедура СписокПриАктивизацииСтроки(Форма, Элемент) Экспорт

	Данные = Форма.Элементы.Список.ТекущиеДанные;
	Если Данные <> Неопределено И Данные.ХешОшибки = Форма.ХешВыбраннойОшибки Тогда
		Возврат;
	КонецЕсли;
	Форма.ХешВыбраннойОшибки = "";
	Форма.ПолныйТекстОшибки = "";
	Форма.РезультатАнализа = "";
	Форма.ОшибкаДоступна = Ложь;
	Форма.ПодписьРазбора = НСтр("ru = 'Выберите ошибку в списке.'");
	Если Данные <> Неопределено Тогда
		Сведения = КИИ_ИнтерфейсВызовСервера.ДанныеОшибки(Данные.ХешОшибки);
		Форма.ХешВыбраннойОшибки = Данные.ХешОшибки;
		Форма.ПолныйТекстОшибки = Сведения.ТекстОшибки;
		Форма.РезультатАнализа = Сведения.ОписаниеОтИИ;
		Форма.ОшибкаДоступна = Сведения.Найдена;
		Если ЗначениеЗаполнено(Форма.РезультатАнализа) Тогда
			ШаблонПодписи = НСтр(
				"ru = 'Сохраненный разбор ошибки %1. Дата и модель глубокого анализа указаны в его тексте, если были
				|записаны.'");
			КороткийХеш = Лев(Форма.ХешВыбраннойОшибки, 8);
			Форма.ПодписьРазбора = СтрШаблон(ШаблонПодписи, КороткийХеш);
		Иначе
			Форма.ПодписьРазбора = СтрШаблон(НСтр("ru = 'Ошибка %1. Сохраненного разбора нет.'"),
				Лев(Форма.ХешВыбраннойОшибки, 8));
		КонецЕсли;
	КонецЕсли;
	Форма.Элементы.ГлубокийАнализ.Доступность = Форма.ОшибкаДоступна И Не Форма.АнализВыполняется;
	ОбновитьПредставлениеРазбора(Форма);

КонецПроцедуры

// Запрашивает подтверждение перед фоновым анализом выбранной ошибки.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
Процедура ГлубокийАнализ(Форма) Экспорт

	Если Не ПредыдущийАнализЗавершен(Форма) Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Предыдущий анализ еще выполняется. Отмена ожидания не гарантирует остановку запроса к модели.'"));
		Возврат;
	КонецЕсли;

	Если Форма.АнализВыполняется Тогда
		Возврат;
	КонецЕсли;
	Если Не Форма.ОшибкаДоступна Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Выберите ошибку, для которой сохранилась запись журнала.'"));
		Возврат;
	КонецЕсли;
	Форма.АнализВыполняется = Истина;
	Форма.Элементы.ГлубокийАнализ.Доступность = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияГлубокогоАнализа", Форма, Форма.ХешВыбраннойОшибки);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Отправить выбранную ошибку модели из настроек мониторинга? Запрос может быть платным. Глубокий
			|анализ использует инструменты и выполняется в фоне.'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Обрабатывает действие формы: ПослеПодтвержденияГлубокогоАнализа.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
//  Ответ - КодВозвратаДиалога - выбранный ответ.
//  ХешОшибки - Строка - идентификатор исходной ошибки.
Процедура ПослеПодтвержденияГлубокогоАнализа(Форма, Ответ, ХешОшибки) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Или ХешОшибки <> Форма.ХешВыбраннойОшибки Тогда
		Форма.АнализВыполняется = Ложь;
		Форма.Элементы.ГлубокийАнализ.Доступность = Форма.ОшибкаДоступна;
		Возврат;
	КонецЕсли;
	Попытка
		Операция = КИИ_ИнтерфейсВызовСервера.НачатьАнализОшибки(ХешОшибки, Форма.УникальныйИдентификатор);
		Форма.ЗаданиеГлубокогоАнализа = Строка(Операция.ИдентификаторЗадания);
		Форма.АдресГлубокогоАнализа = Операция.АдресРезультата;
		Форма.ПодписьРазбора = НСтр(
			"ru = 'Глубокий анализ выполняется. Дождитесь результата или отмените ожидание в окне выполнения.'");
		Оповещение = Новый ОписаниеОповещения("ПослеГлубокогоАнализа", Форма, ХешОшибки);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);
	Исключение
		Форма.АнализВыполняется = Ложь;
		Форма.Элементы.ГлубокийАнализ.Доступность = Форма.ОшибкаДоступна;
		Форма.ПодписьРазбора = НСтр("ru = 'Не удалось запустить глубокий анализ. Проверьте настройки мониторинга.'");
	КонецПопытки;

КонецПроцедуры

// Применяет результат анализа к исходной выбранной ошибке.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
//  Результат - Структура, Неопределено - результат ожидания фонового анализа.
//  ХешОшибки - Строка - идентификатор исходной ошибки.
Процедура ПослеГлубокогоАнализа(Форма, Результат, ХешОшибки) Экспорт

	Форма.АнализВыполняется = Ложь;
	Форма.Элементы.ГлубокийАнализ.Доступность = Форма.ОшибкаДоступна;
	Если Результат = Неопределено Тогда
		Если ХешОшибки = Форма.ХешВыбраннойОшибки Тогда
			Форма.ПодписьРазбора = НСтр(
				"ru = 'Ожидание анализа отменено. Запрос может продолжаться. Повторный запуск доступен после завершения задания.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		Если ХешОшибки = Форма.ХешВыбраннойОшибки Тогда
			Форма.ПодписьРазбора = НСтр(
				"ru = 'Ошибка выполнения глубокого анализа. Подробности доступны в журнале регистрации.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Итог = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	Форма.АдресГлубокогоАнализа = "";
	Если ХешОшибки <> Форма.ХешВыбраннойОшибки Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Разбор другой ошибки завершен. Его можно открыть в журнале ошибок.'"));
		Возврат;
	КонецЕсли;
	Форма.РезультатАнализа = Итог.Текст;
	Форма.ПодписьРазбора = СтрШаблон(НСтр("ru = '%1. Модель: %2. Время: %3.'"),
		?(Итог.ЭтоОшибка, НСтр("ru = 'Анализ не выполнен'"), НСтр("ru = 'Глубокий анализ завершен'")),
		Итог.Модель, Формат(Итог.Дата, "ДФ='dd.MM.yyyy HH:mm'"));
	ОбновитьПредставлениеРазбора(Форма);
	Форма.Элементы.СтраницыДеталей.ТекущаяСтраница = Форма.Элементы.РазборИИ;
	Форма.Элементы.Список.Обновить();

КонецПроцедуры

// Обрабатывает действие формы: КопироватьРазбор.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
Асинх Процедура КопироватьРазбор(Форма) Экспорт

	Если Не ЗначениеЗаполнено(Форма.РезультатАнализа) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Для выбранной ошибки пока нет разбора.'"));
		Возврат;
	КонецЕсли;
	Попытка
		Скопировано = Ждать КИИ_ИнтерфейсКлиент.СкопироватьТекстВБуферОбмена(Форма.РезультатАнализа);
	Исключение
		Скопировано = Ложь;
	КонецПопытки;
	Если Скопировано Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Разбор скопирован.'"));
	Иначе
		Форма.Элементы.СтраницыДеталей.ТекущаяСтраница = Форма.Элементы.ТекстРазбора;
		ПоказатьОповещениеПользователя(НСтр("ru = 'Буфер обмена недоступен. Выделите текст разбора и нажмите Ctrl+C.'"));
	КонецЕсли;

КонецПроцедуры

// Обрабатывает действие формы: РазвернутьРазбор.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
Процедура РазвернутьРазбор(Форма) Экспорт

	Форма.РазборРазвернут = Не Форма.РазборРазвернут;
	Форма.Элементы.Список.Видимость = Не Форма.РазборРазвернут;
	Форма.Элементы.СписокКомпоновщикНастроекПользовательскиеНастройки.Видимость = Не Форма.РазборРазвернут;

КонецПроцедуры

// Обрабатывает действие формы: СоздатьПравило.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
Процедура СоздатьПравило(Форма) Экспорт

	Если Не Форма.ОшибкаДоступна Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите ошибку, для которой сохранилась запись журнала.'"));
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("ХешДляПроверки", Форма.ХешВыбраннойОшибки);
	ОткрытьФорму("Справочник.КИИ_ПравилаИгнорированияОшибок.Форма.ФормаЭлемента", ПараметрыФормы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредыдущийАнализЗавершен(Форма)

	Если ПустаяСтрока(Форма.ЗаданиеГлубокогоАнализа) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не КИИ_ИнтерфейсВызовСервера.АнализОшибкиЗавершен(Форма.ЗаданиеГлубокогоАнализа) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ПустаяСтрока(Форма.АдресГлубокогоАнализа) Тогда
		УдалитьИзВременногоХранилища(Форма.АдресГлубокогоАнализа);
	КонецЕсли;
	Форма.АдресГлубокогоАнализа = "";
	Форма.ЗаданиеГлубокогоАнализа = "";
	Возврат Истина;

КонецФункции

// Обрабатывает действие формы: ОбновитьПредставлениеРазбора.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
Процедура ОбновитьПредставлениеРазбора(Форма)

	Текст = ?(ЗначениеЗаполнено(Форма.РезультатАнализа), Форма.РезультатАнализа, НСтр(
		"ru = 'Разбор выбранной ошибки пока не выполнен.'"));
	Форма.HTMLРазбора = КИИ_МаркдаунПарсерКлиентСервер.ДокументРазбора(Текст);

КонецПроцедуры

#КонецОбласти

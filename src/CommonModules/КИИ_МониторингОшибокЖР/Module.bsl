////////////////////////////////////////////////////////////////////////////////
// Общий модуль: КИИ_МониторингОшибокЖР
// Назначение: Чтение ошибок из журнала регистрации (с пагинацией), дедупликация
//             по MD5-хешу, хранение даты последнего сбора.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// MD5-хеш текста (hex, нижний регистр) - ключ дедупликации ошибок.
// Параметры:
//  Текст - Строка - текст для хеширования.
// Возвращаемое значение:
//  Строка - MD5-хеш текста (hex, нижний регистр).
Функция ВычислитьMD5(Текст) Экспорт

	Хешировщик = Новый ХешированиеДанных(ХешФункция.MD5);
	Хешировщик.Добавить(Текст);
	ШестнадцатеричныйХеш = ПолучитьHexСтрокуИзДвоичныхДанных(Хешировщик.ХешСумма);
	Результат = НРег(ШестнадцатеричныйХеш);
	Возврат Результат;

КонецФункции

// Нормализует текст ошибки для группировки однотипных: GUID заменяются
// плейсхолдером, цифры удаляются (номера строк, идентификаторы, даты).
//
// Параметры:
//  Текст - Строка - исходный текст ошибки.
//
// Возвращаемое значение:
//  Строка - нормализованный текст.
//
Функция НормализоватьТекстОшибки(Знач Текст) Экспорт

	Результат = СвернутьGUID(Текст);
	Для Цифра = 0 По 9 Цикл
		ПредставлениеЦифры = Строка(Цифра);
		Результат = СтрЗаменить(Результат, ПредставлениеЦифры, "");
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Хеш ошибки для дедупликации: MD5 от события и нормализованного текста.
// Однотипные ошибки с вариативными фрагментами (GUID, номера строк) получают
// один хеш; одинаковые тексты под разными событиями - разные.
//
// Параметры:
//  Событие - Строка - событие журнала регистрации.
//  Текст   - Строка - текст (комментарий) ошибки.
//
// Возвращаемое значение:
//  Строка - MD5-хеш (hex, нижний регистр).
//
Функция ВычислитьХешОшибки(Знач Событие, Знач Текст) Экспорт

	НачалоКлюча = Событие + "|";
	НормализованныйТекст = НормализоватьТекстОшибки(Текст);
	ТекстДляХеширования = НачалоКлюча + НормализованныйТекст;
	Результат = ВычислитьMD5(ТекстДляХеширования);
	Возврат Результат;

КонецФункции

// Определяет событие тестовых прогонов: сеяные автотестами ошибки
// не должны попадать в боевой мониторинг.
//
// Параметры:
//  Событие - Строка - событие журнала регистрации.
//
// Возвращаемое значение:
//  Булево - Истина для тестовых событий.
//
Функция ЭтоТестовоеСобытие(Знач Событие) Экспорт

	Результат = СтрНачинаетсяС(Событие, "ИИКона.Тест");
	Возврат Результат;

КонецФункции

// Маркеры автотестовых прогонов по умолчанию: подстроки, по которым запись ЖР опознается
// как порожденная тестом. Ошибки автотестов идут под БОЕВЫМИ именами событий (тест вызывает
// боевой код), поэтому фильтр по имени события их не ловит - маркер ищется в стеке вызовов
// внутри комментария (например "{Тесты ОбщийМодуль.Тесты_КИИ_Ядро.Модуль(1162)}").
//
// Возвращаемое значение:
//  Массив из Строка - маркеры-подстроки для поиска в комментарии записи ЖР.
//
Функция МаркерыТестовыхПрогоновПоУмолчанию() Экспорт

	// Маркеры фреймворка YAxUnit, а НЕ имена модулей: подстрока "Тесты_" из дефолта убрана -
	// у клиента может быть боевой модуль вида "Тесты_Интеграции", и его ошибки молча
	// пропадали бы из мониторинга. Свои маркеры клиент задает настройкой МаркерыТестовыхПрогонов.
	Маркеры = Новый Массив;
	Маркеры.Добавить("ЮТест");
	Маркеры.Добавить("ЮТТесты");
	Маркеры.Добавить("YAXUNIT");

	Возврат Маркеры;

КонецФункции

// Определяет запись автотестового прогона: сеяные тестами ошибки не должны попадать
// в боевой мониторинг (иначе жгут токены ИИ-анализа и засоряют дашборд).
// Проверяются И имя события (старое правило), И стек вызовов в комментарии.
//
// Параметры:
//  Событие     - Строка - событие журнала регистрации.
//  Комментарий - Строка - комментарий записи ЖР (содержит стек вызовов).
//  Маркеры     - Массив из Строка, Неопределено - маркеры-подстроки; Неопределено - взять по умолчанию.
//
// Возвращаемое значение:
//  Булево - Истина для записей, порожденных автотестами.
//
Функция ЭтоТестоваяЗапись(Знач Событие, Знач Комментарий, Знач Маркеры = Неопределено) Экспорт

	Если ЭтоТестовоеСобытие(Событие) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Маркеры = Неопределено Тогда
		Маркеры = МаркерыТестовыхПрогоновПоУмолчанию();
	КонецЕсли;

	// СтрНайти регистрозависим: стек может содержать "YAxUnit"/"yaxunit" при маркере "YAXUNIT",
	// и тестовая ошибка проскочила бы в мониторинг. Сравниваем в верхнем регистре.
	КомментарийСтрокой = Строка(Комментарий);
	ТекстКомментария = ВРег(КомментарийСтрокой);
	Для Каждого Маркер Из Маркеры Цикл
		Если Не ЗначениеЗаполнено(Маркер) Тогда
			Продолжить;
		КонецЕсли;
		МаркерСтрокой = Строка(Маркер);
		МаркерВВерхнемРегистре = ВРег(МаркерСтрокой);
		Если СтрНайти(ТекстКомментария, МаркерВВерхнемРегистре) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Читает ограниченную порцию ЖР; прежний интерфейс возвращает штатные строки таблицы платформы.
// Параметры:
//  ДатаНачала - Дата - начало периода.
//  ДатаОкончания - Дата - конец периода.
//  Настройки - Структура - уровни и размер страницы.
//  Усечено - Булево - в периоде остались записи после порции.
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений - штатные поля журнала без изменения их типов.
Функция ПрочитатьОшибкиИзЖурналаРегистрации(ДатаНачала, ДатаОкончания, Настройки, Усечено = Ложь) Экспорт

	Отбор = ОтборЖурналаДляСбора(ДатаНачала, ДатаОкончания, Настройки);
	ЛимитПорции = Настройки.РазмерСтраницыЖурнала * 100;
	МаксимумВыгрузки = ЛимитПорции + 1;
	ТаблицаЗаписей = Новый ТаблицаЗначений;
	// Третий аргумент - колонки, четвертый - входной файл, пятый - максимум строк таблицы.
	ВыгрузитьЖурналРегистрации(ТаблицаЗаписей, Отбор, , , МаксимумВыгрузки);
	Усечено = ТаблицаЗаписей.Количество() > ЛимитПорции;
	ПрочитанныеОшибки = Новый Массив;
	Для Каждого ЗаписьЖурнала Из ТаблицаЗаписей Цикл
		Если ПрочитанныеОшибки.Количество() >= ЛимитПорции Тогда
			Прервать;
		КонецЕсли;
		ПрочитанныеОшибки.Добавить(ЗаписьЖурнала);
	КонецЦикла;
	Возврат ПрочитанныеОшибки;

КонецФункции

// Служебное продолжение фиксированного периода с ограничением записей в памяти.
// У платформы нет аргумента смещения. Выгрузка читается потоком; уже учтенный префикс пропускается.
// Параметры:
//  ДатаНачала - Дата - начало фиксированного окна.
//  ДатаОкончания - Дата - конец фиксированного окна.
//  Настройки - Структура - сохраненные уровни и размер страницы.
//  Усечено - Булево - после порции есть следующая запись.
//  НачальнаяПозиция - Число - число уже обработанных записей того же окна и отбора.
//  СледующаяПозиция - Число - выходная позиция после порции, включая тестовые события.
// Возвращаемое значение:
//  Массив из Структура - Дата, Событие, Комментарий, ИмяПользователя, Компьютер,
//   ПредставлениеМетаданных, Данные (представление данных); только поля сборщика.
Функция ПрочитатьПорциюЖурналаРегистрации(ДатаНачала, ДатаОкончания, Настройки,
	Усечено, Знач НачальнаяПозиция, СледующаяПозиция) Экспорт

	Если НачальнаяПозиция < 0 Тогда
		ВызватьИсключение НСтр("ru = 'Позиция чтения журнала не может быть отрицательной.'");
	КонецЕсли;
	Отбор = ОтборЖурналаДляСбора(ДатаНачала, ДатаОкончания, Настройки);
	ЛимитПорции = Настройки.РазмерСтраницыЖурнала * 100;
	ИмяВыгрузки = ПолучитьИмяВременногоФайла("xml");
	ЧтениеЖурнала = Новый ЧтениеXML;
	ЧтениеОткрыто = Ложь;
	Попытка
		// МаксимальноеКоличество платформы не ограничивает выгрузку в XML-файл.
		ВыгрузитьЖурналРегистрации(ИмяВыгрузки, Отбор);
		ЧтениеЖурнала.ОткрытьФайл(ИмяВыгрузки);
		ЧтениеОткрыто = Истина;
		ЧтениеЖурнала.ИгнорироватьПробелы = Ложь;
		ПрочитанныеОшибки = ПрочитатьСрезЖурналаXML(ЧтениеЖурнала, НачальнаяПозиция, ЛимитПорции, Усечено);
		ЧтениеЖурнала.Закрыть();
		ЧтениеОткрыто = Ложь;
		УдалитьФайлы(ИмяВыгрузки);
	Исключение
		Если ЧтениеОткрыто Тогда
			ЧтениеЖурнала.Закрыть();
		КонецЕсли;
		УдалитьФайлы(ИмяВыгрузки);
		ВызватьИсключение;
	КонецПопытки;
	СледующаяПозиция = НачальнаяПозиция + ПрочитанныеОшибки.Количество();
	Возврат ПрочитанныеОшибки;

КонецФункции

// Дедупликация ошибок в памяти по хешу события и нормализованного текста
// (см. ВычислитьХешОшибки); события тестовых прогонов пропускаются.
// Возвращает Соответствие хеш -> {ЗаписьЖР, Количество}.
// Для записей с датой дополнительно сохраняет ПерваяДатаВремя, ПоследнееВхождение
// и КоличествоПоДням (дата начала дня -> количество). Счетчики без даты остаются совместимыми.
// Параметры:
//  МассивОшибок - Массив из СтрокаТаблицыЗначений - записи ЖР для дедупликации.
//  Маркеры - Массив из Строка, Неопределено - маркеры тестовых событий; Неопределено - штатный набор.
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - MD5-хеш комментария и агрегат ошибки (ЗаписьЖР, Количество).
Функция ВыполнитьДедупликациюВПамяти(МассивОшибок, Знач Маркеры = Неопределено) Экспорт

	Хеши = Новый Соответствие;

	Для Каждого ЗаписьЖурнала Из МассивОшибок Цикл
		Если ЭтоТестоваяЗапись(ЗаписьЖурнала.Событие, ЗаписьЖурнала.Комментарий, Маркеры) Тогда
			Продолжить;
		КонецЕсли;
		Хеш = ВычислитьХешОшибки(ЗаписьЖурнала.Событие, ЗаписьЖурнала.Комментарий);
		Данные = Хеши[Хеш];
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("ЗаписьЖР, Количество", ЗаписьЖурнала, 1);
			Хеши.Вставить(Хеш, Данные);
		Иначе
			Данные.Количество = Данные.Количество + 1;
		КонецЕсли;
		ДатаСобытия = Неопределено;
		Если ТипЗнч(ЗаписьЖурнала) = Тип("Структура") Тогда
			ЗаписьЖурнала.Свойство("Дата", ДатаСобытия);
		Иначе
			ДатаСобытия = ЗаписьЖурнала.Дата;
		КонецЕсли;
		Если ТипЗнч(ДатаСобытия) = Тип("Дата") Тогда
			УчестьДатуОшибки(Данные, ДатаСобытия);
		КонецЕсли;
	КонецЦикла;

	Возврат Хеши;

КонецФункции

// Подготавливает чтение без длительной транзакции; версия проверяется при фиксации.
// Параметры:
//  Настройки - Структура - уровни и размер страницы журнала.
//  ТекущееВремя - Дата - верхняя граница; текущая незавершенная секунда исключается.
// Возвращаемое значение:
//  Структура, Неопределено - курсор либо отсутствие завершенного интервала для чтения:
//   * Версия - Строка - версия состояния для проверки при фиксации порции.
//   * ДатаПоследнегоСбора - Дата, Неопределено - конец последнего завершенного окна.
//   * ДатаНачала - Дата - начало текущего окна.
//   * ДатаОкончания - Дата - конец текущего окна.
//   * НачальнаяПозиция - Число - смещение следующей порции.
//   * УровниОшибокЖР - Массив из УровеньЖурналаРегистрации - отбор текущего окна.
Функция ПодготовитьКурсорСбора(Настройки, Знач ТекущееВремя) Экспорт

	Состояние = ПрочитатьСостояниеСбора();
	Курсор = Новый Структура;
	Курсор.Вставить("Версия", Состояние.Версия);
	Курсор.Вставить("ДатаПоследнегоСбора", Состояние.ДатаПоследнегоСбора);
	Если Состояние.Завершено Тогда
		Если ЗначениеЗаполнено(Состояние.ДатаПоследнегоСбора) Тогда
			ДатаНачала = Состояние.ДатаПоследнегоСбора + 1;
		Иначе
			ДатаНачала = ТекущееВремя - 5 * 60;
		КонецЕсли;
		ДатаОкончания = ТекущееВремя - 1;
		Если ДатаНачала > ДатаОкончания Тогда
			Возврат Неопределено;
		КонецЕсли;
		Курсор.Вставить("ДатаНачала", ДатаНачала);
		Курсор.Вставить("ДатаОкончания", ДатаОкончания);
		Курсор.Вставить("НачальнаяПозиция", 0);
		УровниЖурнала = Новый Массив;
		Для Каждого УровеньЖурнала Из Настройки.УровниОшибокЖР Цикл
			УровниЖурнала.Добавить(УровеньЖурнала);
		КонецЦикла;
		Курсор.Вставить("УровниОшибокЖР", УровниЖурнала);
	Иначе
		Курсор.Вставить("ДатаНачала", Состояние.ДатаНачала);
		Курсор.Вставить("ДатаОкончания", Состояние.ДатаОкончания);
		Курсор.Вставить("НачальнаяПозиция", Состояние.НачальнаяПозиция);
		Курсор.Вставить("УровниОшибокЖР", Состояние.УровниОшибокЖР);
	КонецЕсли;
	Возврат Курсор;

КонецФункции

// Фиксирует данные и курсор одной транзакцией; устаревшая версия не применяется.
// Параметры:
//  УникальныеОшибки - Соответствие - агрегаты прочитанной порции.
//  Курсор - Структура - результат ПодготовитьКурсорСбора.
//  СледующаяПозиция - Число - позиция после всех прочитанных записей, включая отфильтрованные.
//  Усечено - Булево - остался непрочитанный хвост фиксированного окна.
// Возвращаемое значение:
//  Булево - порция применена; Ложь означает, что другой сбор уже изменил состояние.
Функция ЗафиксироватьПорциюСбора(УникальныеОшибки, Курсор, Знач СледующаяПозиция, Знач Усечено) Экспорт

	Если СледующаяПозиция < Курсор.НачальнаяПозиция Тогда
		ВызватьИсключение НСтр("ru = 'Позиция сбора журнала не может уменьшаться.'");
	КонецЕсли;
	Применено = Ложь;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСостояниеСбора();
		ТекущееСостояние = ПрочитатьСостояниеСбора();
		Если ТекущееСостояние.Версия = Курсор.Версия Тогда
			КИИ_МониторингОшибокРегистры.ЗаписатьУникальныеОшибкиВТранзакции(УникальныеОшибки);
			НовоеСостояние = Новый Структура;
			ИдентификаторВерсии = Новый УникальныйИдентификатор;
			ВерсияСостояния = Строка(ИдентификаторВерсии);
			НовоеСостояние.Вставить("Версия", ВерсияСостояния);
			НовоеСостояние.Вставить("ДатаПоследнегоСбора", Курсор.ДатаПоследнегоСбора);
			НовоеСостояние.Вставить("ДатаНачала", Курсор.ДатаНачала);
			НовоеСостояние.Вставить("ДатаОкончания", Курсор.ДатаОкончания);
			НовоеСостояние.Вставить("НачальнаяПозиция", СледующаяПозиция);
			НовоеСостояние.Вставить("УровниОшибокЖР", Курсор.УровниОшибокЖР);
			НовоеСостояние.Вставить("Завершено", НЕ Усечено);
			Если НЕ Усечено Тогда
				НовоеСостояние.ДатаПоследнегоСбора = Курсор.ДатаОкончания;
			КонецЕсли;
			ЗаписатьСостояниеСбора(НовоеСостояние);
			Применено = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Применено И НЕ Усечено Тогда
		СинхронизироватьПрежнююДатуСбора(Курсор.ДатаОкончания);
	КонецЕсли;
	Возврат Применено;

КонецФункции

// Дата завершенного окна; прежняя константа читается только до первой записи состояния.
// Возвращаемое значение:
//  Дата, Неопределено - последняя полностью обработанная секунда.
Функция ПолучитьДатуПоследнегоСбора() Экспорт

	Состояние = ПрочитатьСостояниеСбора();
	Результат = Состояние.ДатаПоследнегоСбора;
	Возврат Результат;

КонецФункции

// Явное изменение даты отменяет незавершенное окно и устаревшие подготовленные порции.
// Параметры:
//  Дата - Дата, Неопределено - последняя полностью обработанная секунда либо сброс.
Процедура СохранитьДатуПоследнегоСбора(Дата) Экспорт

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСостояниеСбора();
		Состояние = НачальноеСостояниеСбора(Дата);
		ИдентификаторВерсии = Новый УникальныйИдентификатор;
		Состояние.Версия = Строка(ИдентификаторВерсии);
		ЗаписатьСостояниеСбора(Состояние);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	СинхронизироватьПрежнююДатуСбора(Дата);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтборЖурналаДляСбора(ДатаНачала, ДатаОкончания, Настройки)

	УровниЖурнала = Новый Массив;
	Для Каждого УровеньНастройки Из Настройки.УровниОшибокЖР Цикл
		НормализованныйУровень = ВРег(УровеньНастройки);
		Если НормализованныйУровень = "ОШИБКА" Тогда
			УровниЖурнала.Добавить(УровеньЖурналаРегистрации.Ошибка);
		ИначеЕсли НормализованныйУровень = "ПРЕДУПРЕЖДЕНИЕ" Тогда
			УровниЖурнала.Добавить(УровеньЖурналаРегистрации.Предупреждение);
		Иначе
			КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
			СобытиеЖурнала = НСтр("ru = 'ИИКона.МониторингОшибок'", КодОсновногоЯзыка);
			ТекстПредупреждения = СтрШаблон(НСтр("ru = 'Неизвестный уровень ЖР в настройках: %1'"), УровеньНастройки);
			ЗаписьЖурналаРегистрации(
				СобытиеЖурнала, УровеньЖурналаРегистрации.Предупреждение, , , ТекстПредупреждения);
		КонецЕсли;
	КонецЦикла;
	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", ДатаНачала);
	Отбор.Вставить("ДатаОкончания", ДатаОкончания);
	Отбор.Вставить("Уровень", УровниЖурнала);
	Возврат Отбор;

КонецФункции

Функция ПоляЗаписиЖурналаXML()

	Поля = Новый Соответствие;
	Поля.Вставить("Date", "Дата");
	Поля.Вставить("Event", "Событие");
	Поля.Вставить("Comment", "Комментарий");
	Поля.Вставить("UserName", "ИмяПользователя");
	Поля.Вставить("Computer", "Компьютер");
	Поля.Вставить("MetadataPresentation", "ПредставлениеМетаданных");
	Поля.Вставить("DataPresentation", "Данные");
	Возврат Поля;

КонецФункции

Функция НоваяЗаписьЖурналаXML()

	ЗаписьЖурнала = Новый Структура;
	ЗаписьЖурнала.Вставить("Дата", Неопределено);
	ЗаписьЖурнала.Вставить("Событие", "");
	ЗаписьЖурнала.Вставить("Комментарий", "");
	ЗаписьЖурнала.Вставить("ИмяПользователя", "");
	ЗаписьЖурнала.Вставить("Компьютер", "");
	ЗаписьЖурнала.Вставить("ПредставлениеМетаданных", "");
	ЗаписьЖурнала.Вставить("Данные", "");
	Возврат ЗаписьЖурнала;

КонецФункции

Функция ПрочитатьСрезЖурналаXML(ЧтениеЖурнала, Знач НачальнаяПозиция, Знач ЛимитПорции, Усечено)

	ПрочитанныеОшибки = Новый Массив;
	Поля = ПоляЗаписиЖурналаXML();
	ТипДаты = Тип("Дата");
	Фрагменты = Новый Массив;
	СостояниеЧтения = Новый Структура;
	СостояниеЧтения.Вставить("Глубина", 0);
	СостояниеЧтения.Вставить("КоличествоВыгрузки", 0);
	СостояниеЧтения.Вставить("ЗаписьЖурнала", Неопределено);
	СостояниеЧтения.Вставить("ИмяПоля", Неопределено);
	СостояниеЧтения.Вставить("Поля", Поля);
	СостояниеЧтения.Вставить("ТипДаты", ТипДаты);
	СостояниеЧтения.Вставить("Фрагменты", Фрагменты);
	Усечено = Ложь;
	Пока ЧтениеЖурнала.Прочитать() Цикл
		ВидУзла = ЧтениеЖурнала.ТипУзла;
		Если ВидУзла = ТипУзлаXML.НачалоЭлемента Тогда
			СостояниеЧтения.Глубина = СостояниеЧтения.Глубина + 1;
			Усечено = НачатьЭлементЖурналаXML(
				ЧтениеЖурнала, СостояниеЧтения, НачальнаяПозиция, ЛимитПорции);
			Если Усечено Тогда
				Прервать;
			КонецЕсли;
		ИначеЕсли ВидУзла = ТипУзлаXML.КонецЭлемента Тогда
			ЗавершитьЭлементЖурналаXML(СостояниеЧтения, ПрочитанныеОшибки);
			СостояниеЧтения.Глубина = СостояниеЧтения.Глубина - 1;
		Иначе
			ПрочитатьТекстПоляЖурналаXML(ЧтениеЖурнала, СостояниеЧтения);
		КонецЕсли;
	КонецЦикла;
	Если СостояниеЧтения.КоличествоВыгрузки < НачальнаяПозиция Тогда
		ВызватьИсключение НСтр("ru = 'Журнал изменился до сохраненной позиции. Проверьте период сбора.'");
	КонецЕсли;
	Возврат ПрочитанныеОшибки;

КонецФункции

Функция НачатьЭлементЖурналаXML(ЧтениеЖурнала, СостояниеЧтения, Знач НачальнаяПозиция, Знач ЛимитПорции)

	Если СостояниеЧтения.Глубина = 1 Тогда
		Если ЧтениеЖурнала.ЛокальноеИмя <> "EventLog"
			ИЛИ ЧтениеЖурнала.URIПространстваИмен <> "http://v8.1c.ru/eventLog" Тогда
			ВызватьИсключение НСтр("ru = 'Неподдерживаемый формат выгрузки журнала регистрации.'");
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Если СостояниеЧтения.Глубина = 2 И ЧтениеЖурнала.ЛокальноеИмя = "Event" Тогда
		Если СостояниеЧтения.КоличествоВыгрузки >= НачальнаяПозиция + ЛимитПорции Тогда
			Возврат Истина;
		КонецЕсли;
		Если СостояниеЧтения.КоличествоВыгрузки >= НачальнаяПозиция Тогда
			ЗаписьЖурнала = НоваяЗаписьЖурналаXML();
			СостояниеЧтения.ЗаписьЖурнала = ЗаписьЖурнала;
		КонецЕсли;
		СостояниеЧтения.КоличествоВыгрузки = СостояниеЧтения.КоличествоВыгрузки + 1;
		Возврат Ложь;
	КонецЕсли;
	Если СостояниеЧтения.Глубина = 3 И СостояниеЧтения.ЗаписьЖурнала <> Неопределено Тогда
		СостояниеЧтения.ИмяПоля = СостояниеЧтения.Поля.Получить(ЧтениеЖурнала.ЛокальноеИмя);
		СостояниеЧтения.Фрагменты.Очистить();
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Процедура ЗавершитьЭлементЖурналаXML(СостояниеЧтения, ПрочитанныеОшибки)

	ЗаписьЖурнала = СостояниеЧтения.ЗаписьЖурнала;
	ИмяПоля = СостояниеЧтения.ИмяПоля;
	Если СостояниеЧтения.Глубина = 3 И ЗаписьЖурнала <> Неопределено И ИмяПоля <> Неопределено Тогда
		ТекстПоля = СтрСоединить(СостояниеЧтения.Фрагменты, "");
		Если ИмяПоля = "Дата" Тогда
			ДатаСобытия = XMLЗначение(СостояниеЧтения.ТипДаты, ТекстПоля);
			ЗаписьЖурнала.Дата = ДатаСобытия;
		Иначе
			ЗаписьЖурнала[ИмяПоля] = ТекстПоля;
		КонецЕсли;
		СостояниеЧтения.ИмяПоля = Неопределено;
		Возврат;
	КонецЕсли;
	Если СостояниеЧтения.Глубина = 2 И ЗаписьЖурнала <> Неопределено Тогда
		Если ЗаписьЖурнала.Дата = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'В выгрузке журнала регистрации отсутствует дата события.'");
		КонецЕсли;
		ПрочитанныеОшибки.Добавить(ЗаписьЖурнала);
		СостояниеЧтения.ЗаписьЖурнала = Неопределено;
	КонецЕсли;

КонецПроцедуры

Процедура ПрочитатьТекстПоляЖурналаXML(ЧтениеЖурнала, СостояниеЧтения)

	Если СостояниеЧтения.Глубина <> 3 Или СостояниеЧтения.ЗаписьЖурнала = Неопределено
		Или СостояниеЧтения.ИмяПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЧтениеЖурнала.ЭтоСимвольныеДанные Тогда
		СостояниеЧтения.Фрагменты.Добавить(ЧтениеЖурнала.Значение);
	КонецЕсли;

КонецПроцедуры

Функция НачальноеСостояниеСбора(ДатаПоследнегоСбора)

	Состояние = Новый Структура;
	Состояние.Вставить("Версия", "");
	Состояние.Вставить("ДатаПоследнегоСбора", ДатаПоследнегоСбора);
	Состояние.Вставить("ДатаНачала", Неопределено);
	Состояние.Вставить("ДатаОкончания", Неопределено);
	Состояние.Вставить("НачальнаяПозиция", 0);
	УровниЖурнала = Новый Массив;
	Состояние.Вставить("УровниОшибокЖР", УровниЖурнала);
	Состояние.Вставить("Завершено", Истина);
	Возврат Состояние;

КонецФункции

Функция ПрочитатьСостояниеСбора()

	НаборСостояния = РегистрыСведений.КИИ_МониторингОшибокСостояниеСбора.СоздатьНаборЗаписей();
	НаборСостояния.Отбор.ИмяСборщика.Установить("ЖурналРегистрации");
	НаборСостояния.Прочитать();
	Если НаборСостояния.Количество() > 0 Тогда
		ХранилищеСостояния = НаборСостояния[0].Данные;
		Состояние = ХранилищеСостояния.Получить();
	Иначе
		ДатаПоследнегоСбора = ПолучитьПрежнююДатуСбора();
		Состояние = НачальноеСостояниеСбора(ДатаПоследнегоСбора);
	КонецЕсли;
	Возврат Состояние;

КонецФункции

Процедура ЗаписатьСостояниеСбора(Состояние)

	НаборСостояния = РегистрыСведений.КИИ_МониторингОшибокСостояниеСбора.СоздатьНаборЗаписей();
	НаборСостояния.Отбор.ИмяСборщика.Установить("ЖурналРегистрации");
	ЗаписьСостояния = НаборСостояния.Добавить();
	ЗаписьСостояния.ИмяСборщика = "ЖурналРегистрации";
	ЗаписьСостояния.Данные = Новый ХранилищеЗначения(Состояние);
	НаборСостояния.Записать();

КонецПроцедуры

Процедура ЗаблокироватьСостояниеСбора()

	БлокировкаСостояния = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаСостояния.Добавить("РегистрСведений.КИИ_МониторингОшибокСостояниеСбора");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("ИмяСборщика", "ЖурналРегистрации");
	БлокировкаСостояния.Заблокировать();

КонецПроцедуры

Функция ПолучитьПрежнююДатуСбора()

	ЗначениеКонстанты = Константы.КИИ_МониторингОшибокДатаСбора.Получить();
	Если ЗначениеЗаполнено(ЗначениеКонстанты) Тогда
		Возврат ЗначениеКонстанты;
	КонецЕсли;

	// Миграция с персонального хранилища (однократно, до первой записи в константу)
	Устаревшее = Неопределено;
	Попытка
		Устаревшее = ХранилищеОбщихНастроек.Загрузить("КИИ_МониторингОшибок", "ДатаПоследнегоСбора");
	Исключение
		Устаревшее = Неопределено; // Первый запуск - дата еще не сохранена
	КонецПопытки;

	Если ТипЗнч(Устаревшее) = Тип("Дата") И ЗначениеЗаполнено(Устаревшее) Тогда
		Возврат Устаревшее;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура СинхронизироватьПрежнююДатуСбора(Дата)

	Попытка
		Константы.КИИ_МониторингОшибокДатаСбора.Установить(Дата);
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(СведенияОбОшибке);
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось сохранить дату последнего сбора. %1'"), ОписаниеОшибки);
		СобытиеЖурнала = НСтр("ru = 'КИИ.МониторингОшибок'");
		ЗаписьЖурналаРегистрации(
			СобытиеЖурнала,
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Счетчик без даты остается совместимым; у настоящих записей ЖР сохраняются диапазон и дни.
Процедура УчестьДатуОшибки(Данные, Знач ДатаСобытия)

	ПерваяДата = Неопределено;
	Если Данные.Свойство("ПерваяДатаВремя", ПерваяДата) Тогда
		Данные.ПерваяДатаВремя = Мин(ПерваяДата, ДатаСобытия);
		Данные.ПоследнееВхождение = Макс(Данные.ПоследнееВхождение, ДатаСобытия);
		КоличестваПоДням = Данные.КоличествоПоДням;
	Иначе
		КоличестваПоДням = Новый Соответствие;
		Данные.Вставить("ПерваяДатаВремя", ДатаСобытия);
		Данные.Вставить("ПоследнееВхождение", ДатаСобытия);
		Данные.Вставить("КоличествоПоДням", КоличестваПоДням);
	КонецЕсли;
	ДатаДня = НачалоДня(ДатаСобытия);
	КоличествоЗаДень = КоличестваПоДням.Получить(ДатаДня);
	Если КоличествоЗаДень = Неопределено Тогда
		КоличествоЗаДень = 0;
	КонецЕсли;
	КоличестваПоДням.Вставить(ДатаДня, КоличествоЗаДень + 1);

КонецПроцедуры

// Заменяет GUID (hex-группы 8-4-4-4-12) плейсхолдером {GUID}.
Функция СвернутьGUID(Знач Текст)

	Длина = СтрДлина(Текст);
	Если Длина < 36 Тогда
		Возврат Текст;
	КонецЕсли;

	Части = Новый Массив;
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Если Позиция + 35 <= Длина И ЭтоGUIDВПозиции(Текст, Позиция) Тогда
			Части.Добавить("{GUID}");
			Позиция = Позиция + 36;
		Иначе
			СимволТекста = Сред(Текст, Позиция, 1);
			Части.Добавить(СимволТекста);
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;

	Результат = СтрСоединить(Части, "");
	Возврат Результат;

КонецФункции

// Проверяет структуру GUID начиная с позиции.
Функция ЭтоGUIDВПозиции(Знач Текст, Знач Позиция)

	ИсходныйФрагмент = Сред(Текст, Позиция, 36);
	Фрагмент = НРег(ИсходныйФрагмент);
	Для Индекс = 1 По 36 Цикл
		ТекущийСимвол = Сред(Фрагмент, Индекс, 1);
		ЭтоПозицияДефиса = (Индекс = 9 Или Индекс = 14 Или Индекс = 19 Или Индекс = 24);
		Если ЭтоПозицияДефиса Тогда
			Если ТекущийСимвол <> "-" Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли СтрНайти("0123456789abcdef", ТекущийСимвол) = 0 Тогда
			Возврат Ложь;
		Иначе
			// Позиция hex-символа с корректным значением - проверяем следующую.
			Продолжить;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Общий модуль: КИИ_МониторингОшибокЖР
// Назначение: Чтение ошибок из журнала регистрации (с пагинацией), дедупликация
//             по MD5-хешу, хранение даты последнего сбора.
// Выделен из КИИ_МониторингОшибок (декомпозиция god-модуля, 2026-07-08).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// MD5-хеш текста (hex, нижний регистр) - ключ дедупликации ошибок.
// Параметры:
//  Текст - Строка - текст для хеширования.
// Возвращаемое значение:
//  Строка - MD5-хеш текста (hex, нижний регистр).
Функция ВычислитьMD5(Текст) Экспорт

	Хешировщик = Новый ХешированиеДанных(ХешФункция.MD5);
	Хешировщик.Добавить(Текст);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хешировщик.ХешСумма));

КонецФункции

// Нормализует текст ошибки для группировки однотипных: GUID заменяются
// плейсхолдером, цифры удаляются (номера строк, идентификаторы, даты).
//
// Параметры:
//  Текст - Строка - исходный текст ошибки.
//
// Возвращаемое значение:
//  Строка - нормализованный текст.
//
Функция НормализоватьТекстОшибки(Знач Текст) Экспорт

	Результат = СвернутьGUID(Текст);
	Для Цифра = 0 По 9 Цикл
		Результат = СтрЗаменить(Результат, Строка(Цифра), "");
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Хеш ошибки для дедупликации: MD5 от события и нормализованного текста.
// Однотипные ошибки с вариативными фрагментами (GUID, номера строк) получают
// один хеш; одинаковые тексты под разными событиями - разные.
//
// Параметры:
//  Событие - Строка - событие журнала регистрации.
//  Текст   - Строка - текст (комментарий) ошибки.
//
// Возвращаемое значение:
//  Строка - MD5-хеш (hex, нижний регистр).
//
Функция ВычислитьХешОшибки(Знач Событие, Знач Текст) Экспорт

	Возврат ВычислитьMD5(Событие + "|" + НормализоватьТекстОшибки(Текст));

КонецФункции

// Определяет событие тестовых прогонов: сеяные автотестами ошибки
// не должны попадать в боевой мониторинг.
//
// Параметры:
//  Событие - Строка - событие журнала регистрации.
//
// Возвращаемое значение:
//  Булево - Истина для тестовых событий.
//
Функция ЭтоТестовоеСобытие(Знач Событие) Экспорт

	Возврат СтрНачинаетсяС(Событие, "ИИКона.Тест");

КонецФункции

// Маркеры автотестовых прогонов по умолчанию: подстроки, по которым запись ЖР опознается
// как порожденная тестом. Ошибки автотестов идут под БОЕВЫМИ именами событий (тест вызывает
// боевой код), поэтому фильтр по имени события их не ловит - маркер ищется в стеке вызовов
// внутри комментария (например "{Тесты ОбщийМодуль.Тесты_КИИ_Ядро.Модуль(1162)}").
//
// Возвращаемое значение:
//  Массив из Строка - маркеры-подстроки для поиска в комментарии записи ЖР.
//
Функция МаркерыТестовыхПрогоновПоУмолчанию() Экспорт

	// Маркеры фреймворка YAxUnit, а НЕ имена модулей: подстрока "Тесты_" из дефолта убрана -
	// у клиента может быть боевой модуль вида "Тесты_Интеграции", и его ошибки молча
	// пропадали бы из мониторинга. Свои маркеры клиент задает настройкой МаркерыТестовыхПрогонов.
	Маркеры = Новый Массив;
	Маркеры.Добавить("ЮТест");
	Маркеры.Добавить("ЮТТесты");
	Маркеры.Добавить("YAXUNIT");

	Возврат Маркеры;

КонецФункции

// Определяет запись автотестового прогона: сеяные тестами ошибки не должны попадать
// в боевой мониторинг (иначе жгут токены ИИ-анализа и засоряют дашборд).
// Проверяются И имя события (старое правило), И стек вызовов в комментарии.
//
// Параметры:
//  Событие     - Строка - событие журнала регистрации.
//  Комментарий - Строка - комментарий записи ЖР (содержит стек вызовов).
//  Маркеры     - Массив из Строка, Неопределено - маркеры-подстроки; Неопределено - взять по умолчанию.
//
// Возвращаемое значение:
//  Булево - Истина для записей, порожденных автотестами.
//
Функция ЭтоТестоваяЗапись(Знач Событие, Знач Комментарий, Знач Маркеры = Неопределено) Экспорт

	Если ЭтоТестовоеСобытие(Событие) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Маркеры = Неопределено Тогда
		Маркеры = МаркерыТестовыхПрогоновПоУмолчанию();
	КонецЕсли;

	// СтрНайти регистрозависим: стек может содержать "YAxUnit"/"yaxunit" при маркере "YAXUNIT",
	// и тестовая ошибка проскочила бы в мониторинг. Сравниваем в верхнем регистре.
	ТекстКомментария = ВРег(Строка(Комментарий));
	Для Каждого Маркер Из Маркеры Цикл
		Если ЗначениеЗаполнено(Маркер) И СтрНайти(ТекстКомментария, ВРег(Строка(Маркер))) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Читает ошибки из ЖР с пагинацией.
// Если записей больше, чем РазмерСтраницыЖурнала, выполняет многократное чтение
// со сдвигом даты начала до полного охвата периода.
// Параметры:
//  ДатаНачала - Дата - начало периода сбора.
//  ДатаОкончания - Дата - конец периода сбора.
//  Настройки - Структура - настройки мониторинга (УровниОшибокЖР, РазмерСтраницыЖурнала).
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений - записи ЖР за период (с дублями, дедупликация отдельно).
Функция ПрочитатьОшибкиИзЖурналаРегистрации(ДатаНачала, ДатаОкончания, Настройки, Усечено = Ложь) Экспорт

	МассивУровней = Новый Массив;
	Для Каждого УровеньСтр Из Настройки.УровниОшибокЖР Цикл
		Если ВРег(УровеньСтр) = "ОШИБКА" Тогда
			МассивУровней.Добавить(УровеньЖурналаРегистрации.Ошибка);
		ИначеЕсли ВРег(УровеньСтр) = "ПРЕДУПРЕЖДЕНИЕ" Тогда
			МассивУровней.Добавить(УровеньЖурналаРегистрации.Предупреждение);
		Иначе
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'ИИКона.МониторингОшибок'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон(НСтр("ru = 'Неизвестный уровень ЖР в настройках: %1'"), УровеньСтр));
		КонецЕсли;
	КонецЦикла;

	МассивВсехОшибок = Новый Массив;
	РазмерСтраницы    = Настройки.РазмерСтраницыЖурнала;
	МаксимумСтраниц   = 100;
	ОставшиесяСтраницы = МаксимумСтраниц;
	НачальнаяПозиция  = 0;
	ДостигнутЛимитСтраниц = Ложь;

	// Фильтр по дате ФИКСИРОВАН на весь период; страницы сдвигаются по НачальнаяПозиция
	// (порядковый номер записи в отфильтрованном журнале). Прежняя схема двигала
	// ДатаНачала (+1 сек при полной странице одной секунды) и ТЕРЯЛА overflow-записи той
	// же секунды. ДатаОкончания фиксирует набор → оффсеты стабильны в рамках сбора.
	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала",    ДатаНачала);
	Отбор.Вставить("ДатаОкончания", ДатаОкончания);
	Отбор.Вставить("Уровень",       МассивУровней);

	Пока ОставшиесяСтраницы > 0 Цикл
		ОставшиесяСтраницы = ОставшиесяСтраницы - 1;

		ТаблицаЗаписей = Новый ТаблицаЗначений;
		// ВыгрузитьЖурналРегистрации(ТаблицаЗначений, Отбор, НачальнаяПозиция, Количество, Колонки).
		ВыгрузитьЖурналРегистрации(ТаблицаЗаписей, Отбор, НачальнаяПозиция, РазмерСтраницы);

		Для Каждого Запись Из ТаблицаЗаписей Цикл
			МассивВсехОшибок.Добавить(Запись);
		КонецЦикла;

		Если ТаблицаЗаписей.Количество() < РазмерСтраницы Тогда
			Прервать;
		КонецЕсли;

		НачальнаяПозиция = НачальнаяПозиция + ТаблицаЗаписей.Количество();

		Если ОставшиесяСтраницы = 0 Тогда
			ДостигнутЛимитСтраниц = Истина;
		КонецЕсли;
	КонецЦикла;

	Усечено = ДостигнутЛимитСтраниц;

	Если ДостигнутЛимитСтраниц Тогда
		ТекстДляЖурнала = СтрШаблон(
			НСтр("ru = 'Сбор ЖР усечен: достигнут лимит %1 страниц по %2 записей.
				|Хвост периода будет дочитан следующим сбором.'"),
			МаксимумСтраниц, РазмерСтраницы);
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КИИ.МониторингОшибок'"),
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ТекстДляЖурнала);
	КонецЕсли;

	Возврат МассивВсехОшибок;

КонецФункции

// Дедупликация ошибок в памяти по хешу события и нормализованного текста
// (см. ВычислитьХешОшибки); события тестовых прогонов пропускаются.
// Возвращает Соответствие хеш → {ЗаписьЖР, Количество}.
// Параметры:
//  МассивОшибок - Массив из СтрокаТаблицыЗначений - записи ЖР для дедупликации.
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - MD5-хеш комментария и агрегат ошибки (ЗаписьЖР, Количество).
Функция ВыполнитьДедупликациюВПамяти(МассивОшибок, Знач Маркеры = Неопределено) Экспорт

	Хеши = Новый Соответствие;

	Для Каждого ЗаписьЖурнала Из МассивОшибок Цикл
		Если ЭтоТестоваяЗапись(ЗаписьЖурнала.Событие, ЗаписьЖурнала.Комментарий, Маркеры) Тогда
			Продолжить;
		КонецЕсли;
		Хеш = ВычислитьХешОшибки(ЗаписьЖурнала.Событие, ЗаписьЖурнала.Комментарий);
		Данные = Хеши[Хеш];
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("ЗаписьЖР, Количество", ЗаписьЖурнала, 1);
			Хеши.Вставить(Хеш, Данные);
		Иначе
			Данные.Количество = Данные.Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Хеши;

КонецФункции

// Дата последнего успешного сбора - из константы (общая для всех пользователей и заданий).
// При первом чтении мигрирует значение из ХранилищаОбщихНастроек (там оно было ПЕРСОНАЛЬНЫМ:
// регламент под одним пользователем и администратор под другим видели разные даты -
// сбор перечитывал или пропускал период).
//
// Возвращаемое значение:
//  Дата, Неопределено - дата последнего сбора; Неопределено - первый запуск.
//
Функция ПолучитьДатуПоследнегоСбора() Экспорт

	ЗначениеКонстанты = Константы.КИИ_МониторингОшибокДатаСбора.Получить();
	Если ЗначениеЗаполнено(ЗначениеКонстанты) Тогда
		Возврат ЗначениеКонстанты;
	КонецЕсли;

	// Миграция с персонального хранилища (однократно, до первой записи в константу)
	Устаревшее = Неопределено;
	Попытка
		Устаревшее = ХранилищеОбщихНастроек.Загрузить("КИИ_МониторингОшибок", "ДатаПоследнегоСбора");
	Исключение
		Устаревшее = Неопределено; // Первый запуск - дата еще не сохранена
	КонецПопытки;

	Если ТипЗнч(Устаревшее) = Тип("Дата") И ЗначениеЗаполнено(Устаревшее) Тогда
		СохранитьДатуПоследнегоСбора(Устаревшее);
		Возврат Устаревшее;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Сохраняет дату последнего сбора в константу (общую для всех сеансов и регламентных заданий).
// Параметры:
//  Дата - Дата - дата последнего успешного сбора для сохранения.
Процедура СохранитьДатуПоследнегоСбора(Дата) Экспорт

	Попытка
		Константы.КИИ_МониторингОшибокДатаСбора.Установить(Дата);
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось сохранить дату последнего сбора.'")
			+ " " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КИИ.МониторингОшибок'"),
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заменяет GUID (hex-группы 8-4-4-4-12) плейсхолдером {GUID}.
Функция СвернутьGUID(Знач Текст)

	Длина = СтрДлина(Текст);
	Если Длина < 36 Тогда
		Возврат Текст;
	КонецЕсли;

	Части = Новый Массив;
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Если Позиция + 35 <= Длина И ЭтоGUIDВПозиции(Текст, Позиция) Тогда
			Части.Добавить("{GUID}");
			Позиция = Позиция + 36;
		Иначе
			Части.Добавить(Сред(Текст, Позиция, 1));
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции

// Проверяет структуру GUID начиная с позиции.
Функция ЭтоGUIDВПозиции(Знач Текст, Знач Позиция)

	Фрагмент = НРег(Сред(Текст, Позиция, 36));
	Для Индекс = 1 По 36 Цикл
		ТекущийСимвол = Сред(Фрагмент, Индекс, 1);
		ЭтоПозицияДефиса = (Индекс = 9 Или Индекс = 14 Или Индекс = 19 Или Индекс = 24);
		Если ЭтоПозицияДефиса Тогда
			Если ТекущийСимвол <> "-" Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли СтрНайти("0123456789abcdef", ТекущийСимвол) = 0 Тогда
			Возврат Ложь;
		Иначе
			// Позиция hex-символа с корректным значением - проверяем следующую.
			Продолжить;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

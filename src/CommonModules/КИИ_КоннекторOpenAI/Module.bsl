#Область ПрограммныйИнтерфейс

// Возвращает значение перечисления типа формата API, который покрывает данный провайдер.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.КИИ_ТипыФорматовAPI
//
Функция ИмяФормата() Экспорт
	Возврат Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible;
КонецФункции

// Признак поддержки мультимодального ввода (изображения, файлы и т.п.).
// Поддерживается на уровне провайдера; конкретная модель должна быть vision-capable.
//
// Возвращаемое значение:
//  Булево
//
Функция ПоддерживаетМультимодал() Экспорт
	Возврат Истина;
КонецФункции

// Заполняет соответствие HTTP-заголовков в соответствии с форматом OpenAI.
//
// Параметры:
//  Параметры  - Структура - параметры модели (см. КИИ_КоннекторИИ.ПараметрыМодели)
//  КлючAPI    - Строка    - ключ авторизации; если пустой, заголовок Authorization не добавляется
//  Заголовки  - Соответствие из КлючИЗначение - выходной параметр, HTTP-заголовки (имя → значение):
//   * Ключ - Строка - имя заголовка
//   * Значение - Строка - значение заголовка
//
Процедура СформироватьЗаголовки(Параметры, КлючAPI, Заголовки) Экспорт
	
	Заголовки.Вставить("Content-Type", "application/json");
	
	Если ЗначениеЗаполнено(КлючAPI) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
	КонецЕсли;
	
КонецПроцедуры

// Формирует тело HTTP-запроса в формате OpenAI Chat Completions.
//
// Параметры:
//  Параметры        - Структура - параметры модели
//  СтруктураПромпта - Структура - системный/пользовательский промпт + опционально история сообщений
//  ТелоЗапроса      - Структура - выходной параметр (model, messages, прочие поля генерации)
//
Процедура СформироватьТелоЗапроса(Параметры, СтруктураПромпта, ТелоЗапроса) Экспорт

	МассивСообщений = СформироватьМассивСообщений(СтруктураПромпта);

	ТелоЗапроса.Вставить("model", Параметры.НаименованиеПолное);
	ТелоЗапроса.Вставить("messages", МассивСообщений);

	// Function-calling: инструменты передаются, только если вызывающий их положил в промпт.
	// tool_choice="auto" - модель сама решает, звать инструмент или ответить текстом.
	Если СтруктураПромпта.Свойство("Инструменты")
		И КИИ_КоннекторИИОбщий.ЭтоМассив(СтруктураПромпта.Инструменты)
		И СтруктураПромпта.Инструменты.Количество() > 0 Тогда
		ТелоЗапроса.Вставить("tools", СтруктураПромпта.Инструменты);
		ТелоЗапроса.Вставить("tool_choice", "auto");
	КонецЕсли;

	ДобавитьПараметрыГенерации(Параметры, ТелоЗапроса);

КонецПроцедуры

// Разбирает JSON-ответ OpenAI-совместимого провайдера и заполняет структуру результата.
// Не обрабатывает блок error - это делает общий КИИ_КоннекторИИ.ЕстьОшибкаВОтветеAPI до диспетчеризации.
//
// Параметры:
//  ОтветJSON - Соответствие из КлючИЗначение - распарсенный JSON-ответ:
//   * Ключ - Строка - имя поля JSON
//   * Значение - Произвольный - значение поля
//  Результат - Структура    - выходной параметр (см. КИИ_КоннекторИИ.НовыйПараметрыОтветаИИ)
//
Процедура РазобратьОтвет(ОтветJSON, Результат) Экспорт

	ИзвлечьТекстОтвета(ОтветJSON, Результат);
	ИзвлечьМетаданные(ОтветJSON, Результат);
	ИзвлечьТокены(ОтветJSON, Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ФормированиеЗапроса

Функция СформироватьМассивСообщений(СтруктураПромпта)

	// Многоходовый режим (петля агент-анализа): готовый массив messages используется дословно.
	// В нем уже могут быть assistant с tool_calls и tool-результаты, которые обычная сборка
	// из СистемныйПромпт/Пользовательский/История собрать не умеет.
	Если СтруктураПромпта.Свойство("СырыеСообщения")
		И КИИ_КоннекторИИОбщий.ЭтоМассив(СтруктураПромпта.СырыеСообщения)
		И СтруктураПромпта.СырыеСообщения.Количество() > 0 Тогда
		Возврат СтруктураПромпта.СырыеСообщения;
	КонецЕсли;

	МассивСообщений = Новый Массив;

	Если ЗначениеЗаполнено(СтруктураПромпта.СистемныйПромпт) Тогда
		СообщениеСистема = Новый Структура("role, content", "system", СтруктураПромпта.СистемныйПромпт);
		МассивСообщений.Добавить(СообщениеСистема);
	КонецЕсли;

	Если СтруктураПромпта.Свойство("ИсторияСообщений") Тогда
		ДобавитьИсториюСообщений(МассивСообщений, СтруктураПромпта.ИсторияСообщений);
	КонецЕсли;

	Если ТипЗнч(СтруктураПромпта.ПользовательскийПромпт) = Тип("Массив") Тогда
		КонтентПользователя = ПостроитьOpenAIКонтентИзМассива(СтруктураПромпта.ПользовательскийПромпт);
	Иначе
		КонтентПользователя = СтруктураПромпта.ПользовательскийПромпт;
	КонецЕсли;
	
	СообщениеПользователь = Новый Структура("role, content", "user", КонтентПользователя);
	МассивСообщений.Добавить(СообщениеПользователь);

	Возврат МассивСообщений;

КонецФункции

Функция ПостроитьOpenAIКонтентИзМассива(МассивКонтента)
	
	КонтентOpenAI = Новый Массив;
	
	Для Каждого ЭлементКонтента Из МассивКонтента Цикл
		Если ЭлементКонтента.Тип = "text" Тогда
			КонтентOpenAI.Добавить(Новый Структура("type, text", "text", ЭлементКонтента.Текст));
		ИначеЕсли ЭлементКонтента.Тип = "image" Тогда
			КонтентOpenAI.Добавить(ПостроитьКонтентИзображенияOpenAI(ЭлементКонтента));
		ИначеЕсли ЭлементКонтента.Тип = "document" Тогда
			КонтентOpenAI.Добавить(ПостроитьКонтентДокументаOpenAI(ЭлементКонтента));
		Иначе
			// Неизвестный тип контента пропускаем: отправить его провайдеру нельзя
			// (получим 400 на весь запрос), а ронять запрос из-за одного вложения не нужно.
			ТекстДляЖурнала = СтрШаблон(НСтр("ru = 'Пропущен элемент контента неизвестного типа: %1'"),
				ЭлементКонтента.Тип);
			ЗаписьЖурналаРегистрации(НСтр("ru = 'КИИ.КоннекторOpenAI'"),
				УровеньЖурналаРегистрации.Предупреждение, , , ТекстДляЖурнала);
		КонецЕсли;
	КонецЦикла;
	
	Возврат КонтентOpenAI;
	
КонецФункции

Функция ПостроитьКонтентИзображенияOpenAI(ЭлементКонтента)
	
	АдресИзображения = "";
	URL = "";
	Если ЭлементКонтента.Свойство("URL", URL) Тогда
		Если ТипЗнч(URL) = Тип("Строка") Тогда
			Если ЗначениеЗаполнено(URL) Тогда
				АдресИзображения = URL;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресИзображения) Тогда
		
		Base64 = Base64Строка(ЭлементКонтента.ДвоичныеДанные);
		Base64 = СтрЗаменить(Base64, Символы.ПС, "");
		Base64 = СтрЗаменить(Base64, Символы.ВК, "");
		АдресИзображения = "data:" + ЭлементКонтента.MIME + ";base64," + Base64;
		
	КонецЕсли;
	
	СсылкаНаИзображение = Новый Структура;
	СсылкаНаИзображение.Вставить("url", АдресИзображения);

	Контент = Новый Структура;
	Контент.Вставить("type",      "image_url");
	Контент.Вставить("image_url", СсылкаНаИзображение);
	Возврат Контент;
	
КонецФункции

Функция ПостроитьКонтентДокументаOpenAI(ЭлементКонтента)
	
	Base64 = Base64Строка(ЭлементКонтента.ДвоичныеДанные);
	Base64 = СтрЗаменить(Base64, Символы.ПС, "");
	Base64 = СтрЗаменить(Base64, Символы.ВК, "");
	ДанныеФайла = "data:" + ЭлементКонтента.MIME + ";base64," + Base64;
	
	ИмяФайла = "";
	ЭлементКонтента.Свойство("ИмяФайла", ИмяФайла);
	
	ОписаниеФайла = Новый Структура;
	ОписаниеФайла.Вставить("filename",  ИмяФайла);
	ОписаниеФайла.Вставить("file_data", ДанныеФайла);

	Контент = Новый Структура;
	Контент.Вставить("type", "file");
	Контент.Вставить("file", ОписаниеФайла);
	Возврат Контент;
	
КонецФункции

Процедура ДобавитьИсториюСообщений(МассивСообщений, ИсторияСообщений)

	Для Каждого Сообщение Из ИсторияСообщений Цикл
		СообщениеИстории = Новый Структура("role, content", Сообщение.Роль, Сообщение.Текст);
		МассивСообщений.Добавить(СообщениеИстории);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПараметрыГенерации(Параметры, ТелоЗапроса)

	Если ЗначениеЗаполнено(Параметры.Температура) Тогда
		ТелоЗапроса.Вставить("temperature", Параметры.Температура);
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.МаксимумТокенов) Тогда
		ТелоЗапроса.Вставить("max_tokens", Параметры.МаксимумТокенов);
	КонецЕсли;

	Если Параметры.НаименованиеПровайдера = "Ollama" Тогда
		ТелоЗапроса.Вставить("stream", Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработкаОтвета

Процедура ИзвлечьТекстОтвета(ОтветJSON, Результат)

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON) Тогда
		Возврат;
	КонецЕсли;

	Если Не ОтветJSON.Свойство("choices") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(ОтветJSON.choices)
		Или ОтветJSON.choices.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Выборка = ОтветJSON.choices[0];

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Выборка) Тогда
		Возврат;
	КонецЕсли;

	Если Не Выборка.Свойство("message") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Выборка.message) Тогда
		Возврат;
	КонецЕсли;

	Если Выборка.message.Свойство("content") Тогда
		Результат.ТекстОтвета = Выборка.message.content;
	КонецЕсли;

	ИзвлечьВызовыИнструментов(Выборка.message, Результат);

	Если Выборка.Свойство("finish_reason") Тогда
		Результат.ПричинаЗавершения = Выборка.finish_reason;
	КонецЕсли;

КонецПроцедуры

// Извлекает tool_calls из сообщения ответа в Результат.ВызовыИнструментов.
// Формат OpenAI: message.tool_calls[] = {id, type:"function", function:{name, arguments}}.
// arguments - строка JSON (не структура): модель формирует ее как текст, разбирает вызывающий.
Процедура ИзвлечьВызовыИнструментов(СообщениеОтвета, Результат)

	Если Не СообщениеОтвета.Свойство("tool_calls")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(СообщениеОтвета.tool_calls) Тогда
		Возврат;
	КонецЕсли;

	НомерВызова = 0;
	ЗанятыеИдентификаторы = Новый Соответствие;

	Для Каждого ВызовJSON Из СообщениеОтвета.tool_calls Цикл
		Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ВызовJSON)
			Или Не ВызовJSON.Свойство("function")
			Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ВызовJSON.function) Тогда
			Продолжить;
		КонецЕсли;

		Вызов = ОписаниеВызоваИнструмента(ВызовJSON);

		// Пустой или дублирующийся id провайдера ломает следующий раунд диалога: каждый
		// tool-ответ обязан ссылаться на уникальный id (иначе HTTP 400). Чиним id сами -
		// он синтетический в обоих местах диалога (assistant и tool), поэтому согласован.
		НомерВызова = НомерВызова + 1;
		Если ПустаяСтрока(Вызов.Идентификатор) Тогда
			Вызов.Идентификатор = "call_auto_" + Строка(НомерВызова);
		КонецЕсли;
		Пока ЗанятыеИдентификаторы[Вызов.Идентификатор] = Истина Цикл
			Вызов.Идентификатор = Вызов.Идентификатор + "_x";
		КонецЦикла;
		ЗанятыеИдентификаторы.Вставить(Вызов.Идентификатор, Истина);

		Результат.ВызовыИнструментов.Добавить(Вызов);
	КонецЦикла;

КонецПроцедуры

// Собирает описание вызова инструмента (Идентификатор, Имя, Аргументы) из JSON-элемента tool_calls.
Функция ОписаниеВызоваИнструмента(Знач ВызовJSON)

	Вызов = Новый Структура("Идентификатор, Имя, Аргументы", "", "", "");
	Если ВызовJSON.Свойство("id") Тогда
		Вызов.Идентификатор = Строка(ВызовJSON.id);
	КонецЕсли;
	Если ВызовJSON.function.Свойство("name") Тогда
		Вызов.Имя = Строка(ВызовJSON.function.name);
	КонецЕсли;
	Если ВызовJSON.function.Свойство("arguments") Тогда
		Вызов.Аргументы = Строка(ВызовJSON.function.arguments);
	КонецЕсли;

	Возврат Вызов;

КонецФункции

Процедура ИзвлечьМетаданные(ОтветJSON, Результат)

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON) Тогда
		Возврат;
	КонецЕсли;

	Если ОтветJSON.Свойство("id") Тогда
		Результат.IDЗапроса = ОтветJSON.id;
	КонецЕсли;

	// created - Unix-время (сек). Проверяем ТИП: не-число раньше роняло Дата()+строка, и весь разбор
	// после (токены и пр.) проглатывался в общий ЭтоОшибка (аудит P3). Значения вне диапазона Дата
	// платформа усекает штатно, без исключения. TZ-сдвиг к местному времени - отдельный P3, отложен.
	Если ОтветJSON.Свойство("created") И ТипЗнч(ОтветJSON.created) = Тип("Число") Тогда
		Результат.ДатаСоздания = Дата(1970, 1, 1) + ОтветJSON.created;
	КонецЕсли;

	Если ОтветJSON.Свойство("model") Тогда
		Результат.МодельОтвета = ОтветJSON.model;
	КонецЕсли;

	Если ОтветJSON.Свойство("object") Тогда
		Результат.ТипОбъекта = ОтветJSON.object;
	КонецЕсли;

	Если ОтветJSON.Свойство("service_tier") Тогда
		Результат.ТарифСервиса = ОтветJSON.service_tier;
	КонецЕсли;

	Если ОтветJSON.Свойство("system_fingerprint") Тогда
		Результат.ХэшМодели = ОтветJSON.system_fingerprint;
	КонецЕсли;

КонецПроцедуры

Процедура ИзвлечьТокены(ОтветJSON, Результат)

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON) Тогда
		Возврат;
	КонецЕсли;

	Если Не ОтветJSON.Свойство("usage") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON.usage) Тогда
		Возврат;
	КонецЕсли;

	Использование = ОтветJSON.usage;

	Если Использование.Свойство("prompt_tokens") Тогда
		Результат.ВходныеТокены = Использование.prompt_tokens;
	КонецЕсли;

	Если Использование.Свойство("completion_tokens") Тогда
		Результат.ВыходныеТокены = Использование.completion_tokens;
	КонецЕсли;

	Если Использование.Свойство("total_tokens") Тогда
		Результат.ВсегоТокенов = Использование.total_tokens;
	КонецЕсли;

	ИзвлечьКешированныеТокены(Использование, Результат);

КонецПроцедуры

Процедура ИзвлечьКешированныеТокены(Использование, Результат)

	// По спецификации OpenAI cached_tokens лежит в prompt_tokens_details (кешируется ВВОД),
	// а не в completion_tokens_details - раньше поле читалось не оттуда и всегда оставалось 0 (аудит P3).
	Если Не Использование.Свойство("prompt_tokens_details") Тогда
		Возврат;
	КонецЕсли;

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Использование.prompt_tokens_details) Тогда
		Возврат;
	КонецЕсли;

	Если Использование.prompt_tokens_details.Свойство("cached_tokens") Тогда
		Результат.ВыходныеТокеныВКеше = Использование.prompt_tokens_details.cached_tokens;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

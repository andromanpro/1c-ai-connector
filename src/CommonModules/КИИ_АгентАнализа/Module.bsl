// Агент-анализ: инструментальный (function-calling) анализ ошибок через LLM.
// v1 (2026-07-15) - каталог инструментов + смоук одного раунда. Петля и UI - следующим заходом.
// Инструменты берутся из подсистемы MCP-сервера (КИИ_СерверMCPРеестр) - read-only защита
// уже на уровне инструмента (КИИ_СерверMCPБезопасностьЗапросов). См. дизайн:
// _meta/mcp-инструменты-в-анализе-дизайн-v1.md

#Область ПрограммныйИнтерфейс

// Whitelist инструментов, разрешенных модели по умолчанию. Явный список, а не "все из реестра":
// ping бесполезен для анализа, а новые инструменты не должны попадать к модели без ревью.
//
// Возвращаемое значение:
//  Массив из Строка - имена разрешенных MCP-инструментов.
//
Функция ИнструментыПоУмолчанию() Экспорт

	Список = Новый Массив;
	Список.Добавить("get_metadata_tree");
	Список.Добавить("get_object_structure");
	Список.Добавить("get_configuration_info");
	Список.Добавить("execute_query");
	Возврат Список;

КонецФункции

// Поддерживает ли модель инструменты (function-calling). Инструментальный анализ предлагается
// только таким моделям; остальным - обычный анализ без инструментов.
//
// Параметры:
//  Модель - СправочникСсылка.КИИ_МоделиИИ - модель ИИ.
//
// Возвращаемое значение:
//  Булево - значение реквизита ПоддерживаетИнструменты.
//
Функция МодельПоддерживаетИнструменты(Модель) Экспорт

	Если Не ЗначениеЗаполнено(Модель) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Модель.ПоддерживаетИнструменты;

КонецФункции

// Собирает каталог инструментов в формате OpenAI tools из реестра MCP-сервера,
// отфильтрованный по whitelist. Описание execute_query дополняется подсказкой синтаксиса 1С:
// модели по умолчанию пишут SQL (SELECT ... FROM), а 1С требует ВЫБРАТЬ ... ИЗ Справочник.Имя.
//
// Параметры:
//  РазрешенныеИнструменты - Массив из Строка, Неопределено - whitelist имен; Неопределено - ИнструментыПоУмолчанию.
//
// Возвращаемое значение:
//  Массив из Структура - OpenAI tools: [{type:"function", function:{name, description, parameters}}].
//
Функция СобратьИнструментыДляМодели(РазрешенныеИнструменты = Неопределено) Экспорт

	Whitelist = НормализоватьWhitelist(РазрешенныеИнструменты);

	РазрешенныеИмена = Новый Соответствие;
	Для Каждого Имя Из Whitelist Цикл
		РазрешенныеИмена.Вставить(Имя, Истина);
	КонецЦикла;

	Инструменты = Новый Массив;
	Реестр = КИИ_СерверMCPРеестр.ПолучитьРеестрИнструментов();

	Для Каждого СтрокаРеестра Из Реестр Цикл
		Если РазрешенныеИмена[СтрокаРеестра.Имя] <> Истина Тогда
			Продолжить;
		КонецЕсли;

		Описание = СтрокаРеестра.Описание;
		Если СтрокаРеестра.Имя = "execute_query" Тогда
			Описание = Описание + " " + ПодсказкаСинтаксиса1С();
		КонецЕсли;

		ФункцияИнструмента = Новый Структура;
		ФункцияИнструмента.Вставить("name", СтрокаРеестра.Имя);
		ФункцияИнструмента.Вставить("description", Описание);
		ФункцияИнструмента.Вставить("parameters", СтрокаРеестра.Схема);

		Инструмент = Новый Структура;
		Инструмент.Вставить("type", "function");
		Инструмент.Вставить("function", ФункцияИнструмента);

		Инструменты.Добавить(Инструмент);
	КонецЦикла;

	Возврат Инструменты;

КонецФункции

// Выполняет один запрошенный моделью вызов инструмента через реестр MCP-сервера.
// Аргументы приходят от модели строкой JSON - разбираем в структуру. Инструмент вне whitelist
// или ошибка выполнения возвращаются как текст результата (fail-closed), НЕ исключением:
// петля должна отдать это модели как tool-результат, а не падать.
//
// Параметры:
//  Вызов - Структура - {Идентификатор, Имя, Аргументы (Строка JSON)} из ответа модели.
//  РазрешенныеИнструменты - Массив из Строка, Неопределено - whitelist.
//
// Возвращаемое значение:
//  Структура:
//   * Идентификатор - Строка - tool_call_id (для привязки результата к вызову).
//   * Имя           - Строка - имя инструмента.
//   * Успех         - Булево - выполнился ли инструмент без ошибки.
//   * Результат     - Произвольный - данные результата (или текст ошибки при Успех=Ложь).
//
Функция ВыполнитьВызовИнструмента(Вызов, РазрешенныеИнструменты = Неопределено) Экспорт

	Whitelist = НормализоватьWhitelist(РазрешенныеИнструменты);

	Итог = Новый Структура;
	Итог.Вставить("Идентификатор", Вызов.Идентификатор);
	Итог.Вставить("Имя",           Вызов.Имя);
	Итог.Вставить("Успех",         Ложь);
	Итог.Вставить("Результат",     "");

	Если Whitelist.Найти(Вызов.Имя) = Неопределено Тогда
		Итог.Результат = СтрШаблон(
			НСтр("ru = 'Инструмент %1 не разрешен для анализа.'"), Вызов.Имя);
		Возврат Итог;
	КонецЕсли;

	Попытка
		Аргументы = РазобратьАргументы(Вызов.Аргументы);
		Итог.Результат = КИИ_СерверMCPРеестр.ВыполнитьИнструмент(Вызов.Имя, Аргументы);
		Итог.Успех = Истина;
	Исключение
		// Ошибку возвращаем модели как результат (она может исправить запрос), а внутренние
		// детали (стек, correlation) пишем в журнал - клиенту наружу не отдаем.
		Итог.Результат = КраткийТекстОшибки(ИнформацияОбОшибке());
		// Ошибка инструмента - ШТАТНЫЙ ход петли: она возвращается модели, и та исправляет
		// вызов на следующем раунде. Уровень "Ошибка" сделал бы из рабочего сценария инцидент
		// мониторинга (он собирает ЖР строго по этому уровню) и уведомление в телеграм.
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстДляЖурнала = СтрШаблон(НСтр("ru = 'Инструмент %1 завершился с ошибкой: %2'"),
			Вызов.Имя, ПредставлениеОшибки);
		// BSLLS:UsageWriteLogEvent-off
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КИИ.АгентАнализа'"),
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ТекстДляЖурнала);
		// BSLLS:UsageWriteLogEvent-on
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Опции инструментального анализа по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * МаксРаундов             - Число - предел раундов диалога с моделью.
//   * МаксВызововИнструментов - Число - предел суммарных вызовов инструментов за анализ.
//   * МаксСимволовРезультата  - Число - до скольки символов обрезать результат инструмента.
//   * Инструменты             - Массив из Строка, Неопределено - whitelist имен (Неопределено - дефолт).
//
Функция ОпцииПоУмолчанию() Экспорт

	Опции = Новый Структура;
	Опции.Вставить("МаксРаундов", 5);
	Опции.Вставить("МаксВызововИнструментов", 10);
	Опции.Вставить("МаксСимволовРезультата", 2000);
	Опции.Вставить("МаксСимволовДиалога", 24000);
	Опции.Вставить("Инструменты", Неопределено);
	Возврат Опции;

КонецФункции

// Инструментальный анализ: диалог модели с инструментами в цикле до финального текстового ответа.
// Модель сама решает, звать ли инструмент; результаты подаются обратно, пока не будет текст либо
// не сработает предохранитель (лимит раундов/вызовов). Только OpenAI-совместимые модели.
//
// Параметры:
//  Модель - СправочникСсылка.КИИ_МоделиИИ - модель ИИ с поддержкой function-calling.
//  Промпт - Строка, Структура - запрос:
//   * СистемныйПромпт        - Строка - системная инструкция (необязательно).
//   * ПользовательскийПромпт - Строка - текст задачи (или Промпт целиком строкой).
//  Опции  - Структура, Неопределено - см. ОпцииПоУмолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * ЭтоОшибка           - Булево - сетевая/модельная ошибка.
//   * ТекстОшибки         - Строка.
//   * ТекстОтвета         - Строка - финальный ответ модели.
//   * Раундов             - Число - сколько раундов заняло.
//   * ВызововИнструментов - Число - сколько инструментов вызвано.
//   * ОборваноПоЛимиту    - Булево - анализ прерван предохранителем без финализации.
//
Функция ВыполнитьАнализСИнструментами(Модель, Промпт, Опции = Неопределено) Экспорт

	ПолныеОпции = ДополнитьОпции(Опции);
	Инструменты = СобратьИнструментыДляМодели(ПолныеОпции.Инструменты);
	КорреляционныйИдентификатор = Строка(Новый УникальныйИдентификатор);

	Итог = Новый Структура;
	Итог.Вставить("ЭтоОшибка",           Ложь);
	Итог.Вставить("ТекстОшибки",         "");
	Итог.Вставить("ТекстОтвета",         "");
	Итог.Вставить("Раундов",             0);
	Итог.Вставить("ВызововИнструментов", 0);
	Итог.Вставить("ОборваноПоЛимиту",    Ложь);

	Сообщения = НачальныеСообщения(Промпт);
	ДостигнутЛимитВызовов = Ложь;
	// Дедуп повторных вызовов: модель, зациклившаяся на одном и том же вызове, получает
	// кешированный результат без исполнения и расхода лимита.
	КешВызововПетли = Новый Соответствие;

	КонтекстПетли = Новый Структура;
	КонтекстПетли.Вставить("Сообщения", Сообщения);
	КонтекстПетли.Вставить("Итог", Итог);
	КонтекстПетли.Вставить("КешВызовов", КешВызововПетли);
	КонтекстПетли.Вставить("Опции", ПолныеОпции);
	КонтекстПетли.Вставить("КорреляционныйИдентификатор", КорреляционныйИдентификатор);

	Для Раунд = 1 По ПолныеОпции.МаксРаундов Цикл

		// Бюджет контекста: у мелких моделей окно 8-32K токенов; при разрастании диалога
		// принуждаем к выводу из собранного (как при лимите вызовов), а не ловим 400 от API.
		Если ДлинаДиалога(Сообщения) > ПолныеОпции.МаксСимволовДиалога Тогда
			Прервать;
		КонецЕсли;

		Итог.Раундов = Раунд;
		Ответ = КИИ_КоннекторИИ.ЗапросКМоделиСообщениями(Модель, Сообщения, Инструменты, КорреляционныйИдентификатор);

		Если Ответ.ЭтоОшибка Тогда
			Итог.ЭтоОшибка = Истина;
			Итог.ТекстОшибки = Ответ.ТекстОшибки;
			Возврат Итог;
		КонецЕсли;

		Если Ответ.ВызовыИнструментов.Количество() = 0 Тогда
			Итог.ТекстОтвета = Строка(Ответ.ТекстОтвета);
			Возврат Итог;
		КонецЕсли;

		Сообщения.Добавить(СообщениеАссистентаСВызовами(Ответ.ВызовыИнструментов, Ответ.ТекстОтвета));

		// КАЖДЫЙ tool_call обязан получить ответ (иначе диалог невалиден для следующего раунда).
		// При достижении лимита вызовов не выполняем инструмент, но отвечаем заглушкой - так
		// массив messages остается корректным и модель сможет сделать вывод из собранного.
		Для Каждого Вызов Из Ответ.ВызовыИнструментов Цикл
			ОбработатьВызовИнструментаРаунда(Вызов, КонтекстПетли, ДостигнутЛимитВызовов);
		КонецЦикла;

		Если ДостигнутЛимитВызовов Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	// Лимит раундов/вызовов исчерпан без финального текста: принуждаем модель к выводу БЕЗ
	// инструментов (tool_choice отсутствует) - пусть заключит из уже собранных данных, а не
	// оставит клиента с "прервано". Собранные tool-результаты уже в Сообщения.
	Итог.ОборваноПоЛимиту = Истина;
	ФинальныйОтвет = КИИ_КоннекторИИ.ЗапросКМоделиСообщениями(Модель, Сообщения,
		Новый Массив, КорреляционныйИдентификатор);
	Если Не ФинальныйОтвет.ЭтоОшибка И ЗначениеЗаполнено(ФинальныйОтвет.ТекстОтвета) Тогда
		Итог.ТекстОтвета = Строка(ФинальныйОтвет.ТекстОтвета);
	Иначе
		// Сбой финализации не маскируем под успех: вызывающий должен увидеть ошибку.
		Итог.ЭтоОшибка = ФинальныйОтвет.ЭтоОшибка;
		Итог.ТекстОшибки = ФинальныйОтвет.ТекстОшибки;
		Итог.ТекстОтвета = НСтр("ru = 'Анализ прерван по лимиту; вывод не получен.'");
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Тестовые обертки приватных хелперов петли (контракт messages юнит-тестируется без сети).

// см. СообщениеАссистентаСВызовами
Функция СообщениеАссистентаСВызовамиДляТестов(Знач ВызовыИнструментов, Знач ТекстАссистента = "") Экспорт
	Возврат СообщениеАссистентаСВызовами(ВызовыИнструментов, ТекстАссистента);
КонецФункции

// см. СообщениеРезультатаИнструмента
Функция СообщениеРезультатаИнструментаДляТестов(Знач ИдентификаторВызова, Знач ИтогВызова, Знач МаксСимволов) Экспорт
	Возврат СообщениеРезультатаИнструмента(ИдентификаторВызова, ИтогВызова, МаксСимволов);
КонецФункции

// см. ОбрезатьРезультатИнструмента
Функция ОбрезатьРезультатИнструментаДляТестов(Знач ИтогВызова, Знач МаксСимволов) Экспорт
	Возврат ОбрезатьРезультатИнструмента(ИтогВызова, МаксСимволов);
КонецФункции

// см. НачальныеСообщения
Функция НачальныеСообщенияДляТестов(Знач Промпт) Экспорт
	Возврат НачальныеСообщения(Промпт);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает один tool_call раунда петли. При исчерпанном лимите вызовов инструмент
// не исполняется - модель получает заглушку, а ДостигнутЛимитВызовов взводится (мутируется
// по ссылке). Повторный вызов с теми же аргументами берется из кеша петли без расхода лимита.
Процедура ОбработатьВызовИнструментаРаунда(Знач Вызов, КонтекстПетли, ДостигнутЛимитВызовов)

	Итог = КонтекстПетли.Итог;
	Опции = КонтекстПетли.Опции;

	Если ДостигнутЛимитВызовов ИЛИ Итог.ВызововИнструментов >= Опции.МаксВызововИнструментов Тогда
		ДостигнутЛимитВызовов = Истина;
		ЗаписатьАудитВызова(КонтекстПетли.КорреляционныйИдентификатор,
			Новый Структура("Имя, Успех", Вызов.Имя, Ложь), НСтр("ru = 'отклонен: лимит'"));
		СообщениеЛимита = СообщениеToolТекстом(
			Вызов.Идентификатор, НСтр("ru = 'Лимит вызовов инструментов исчерпан.'"));
		КонтекстПетли.Сообщения.Добавить(СообщениеЛимита);
		Возврат;
	КонецЕсли;

	КлючКеша = Вызов.Имя + "|" + Вызов.Аргументы;
	ИтогВызова = КонтекстПетли.КешВызовов[КлючКеша];
	Если ИтогВызова = Неопределено Тогда
		Итог.ВызововИнструментов = Итог.ВызововИнструментов + 1;
		ИтогВызова = ВыполнитьВызовИнструмента(Вызов, Опции.Инструменты);
		КонтекстПетли.КешВызовов.Вставить(КлючКеша, ИтогВызова);
		ЗаписатьАудитВызова(КонтекстПетли.КорреляционныйИдентификатор, ИтогВызова);
	Иначе
		ЗаписатьАудитВызова(КонтекстПетли.КорреляционныйИдентификатор, ИтогВызова, НСтр("ru = '(из кеша петли)'"));
	КонецЕсли;

	СообщениеИнструмента = СообщениеРезультатаИнструмента(
		Вызов.Идентификатор, ИтогВызова, Опции.МаксСимволовРезультата);
	КонтекстПетли.Сообщения.Добавить(СообщениеИнструмента);

КонецПроцедуры

// Нормализует whitelist. Не задано (Неопределено; NULL шлют COM-вызовы) - набор по умолчанию;
// любой другой не-массив - ошибка вызывающего: fail-closed пустой whitelist, а не молчаливое
// расширение до дефолта с execute_query.
// Защита от `Для Каждого ... Из <не массив>` (падение "значение не может быть выбрано из Неопределено").
Функция НормализоватьWhitelist(Знач РазрешенныеИнструменты)

	Если ТипЗнч(РазрешенныеИнструменты) = Тип("Массив") Тогда
		Возврат РазрешенныеИнструменты;
	КонецЕсли;
	Если РазрешенныеИнструменты = Неопределено Или РазрешенныеИнструменты = NULL Тогда
		Возврат ИнструментыПоУмолчанию();
	КонецЕсли;
	Возврат Новый Массив;

КонецФункции

// Опции пользователя, дополненные значениями по умолчанию.
Функция ДополнитьОпции(Знач Опции)

	Полные = ОпцииПоУмолчанию();
	Если ТипЗнч(Опции) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Полные, Опции);
	КонецЕсли;
	Возврат Полные;

КонецФункции

// Начальный массив messages из промпта (строка или структура с полями промпта).
Функция НачальныеСообщения(Знач Промпт)

	СистемныйТекст = "";
	ПользовательскийТекст = "";

	Если ТипЗнч(Промпт) = Тип("Строка") Тогда
		ПользовательскийТекст = Промпт;
	ИначеЕсли ТипЗнч(Промпт) = Тип("Структура") Тогда
		Промпт.Свойство("СистемныйПромпт", СистемныйТекст);
		Промпт.Свойство("ПользовательскийПромпт", ПользовательскийТекст);
	Иначе
		// Промпт неподдерживаемого типа: тексты остаются пустыми, диалог будет пустым -
		// вызывающий получит от модели ошибку валидации, а не молчаливый запрос ни о чем.
		ПользовательскийТекст = "";
	КонецЕсли;

	Сообщения = Новый Массив;
	Если ЗначениеЗаполнено(СистемныйТекст) Тогда
		Сообщения.Добавить(Новый Структура("role, content", "system", Строка(СистемныйТекст)));
	КонецЕсли;
	Сообщения.Добавить(Новый Структура("role, content", "user", Строка(ПользовательскийТекст)));
	Возврат Сообщения;

КонецФункции

// Сообщение assistant с запрошенными вызовами инструментов (для передачи обратно модели).
// arguments - строка JSON от модели, передается как есть (OpenAI ждет строку, не структуру).
Функция СообщениеАссистентаСВызовами(Знач ВызовыИнструментов, Знач ТекстАссистента = "")

	СписокВызовов = Новый Массив;
	Для Каждого Вызов Из ВызовыИнструментов Цикл
		ОписаниеФункции = Новый Структура("name, arguments", Вызов.Имя, Вызов.Аргументы);
		ОписаниеВызова = Новый Структура("id, type, function",
			Вызов.Идентификатор, "function", ОписаниеФункции);
		СписокВызовов.Добавить(ОписаниеВызова);
	КонецЦикла;

	Возврат Новый Структура("role, content, tool_calls", "assistant", Строка(ТекстАссистента), СписокВызовов);

КонецФункции

// Сообщение tool с результатом инструмента (обрезанным), привязанное к вызову по id.
Функция СообщениеРезультатаИнструмента(Знач ИдентификаторВызова, Знач ИтогВызова, Знач МаксСимволов)

	Содержимое = ОбрезатьРезультатИнструмента(ИтогВызова, МаксСимволов);
	Возврат Новый Структура("role, tool_call_id, content", "tool", ИдентификаторВызова, Содержимое);

КонецФункции

// Tool-сообщение с готовым текстом (заглушка при исчерпании лимита - чтобы каждый tool_call
// имел ответ и диалог оставался валидным).
Функция СообщениеToolТекстом(Знач ИдентификаторВызова, Знач Текст)

	Возврат Новый Структура("role, tool_call_id, content", "tool", ИдентификаторВызова, Текст);

КонецФункции

// Результат инструмента как строка для подачи в модель: структуру - в JSON, обрезаем до лимита.
// ЗначениеВJSON падает на Неопределено/NULL (напр. NULL-ячейка запроса) - фолбэк на Строка().
Функция ОбрезатьРезультатИнструмента(Знач ИтогВызова, Знач МаксСимволов)

	Значение = ИтогВызова.Результат;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = Значение;
	Иначе
		Попытка
			Текст = ОбщегоНазначения.ЗначениеВJSON(Значение);
		Исключение
			Текст = Строка(Значение);
		КонецПопытки;
	КонецЕсли;

	Если СтрДлина(Текст) > МаксСимволов Тогда
		// Валидный JSON-конверт вместо рваного фрагмента: модель видит явный признак усечения,
		// а обрезанный preview корректно экранирован.
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Новый Структура("truncated, preview", Истина, Лев(Текст, МаксСимволов)));
		Текст = ЗаписьJSON.Закрыть();
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Суммарная длина текстового содержимого messages - дешевое приближение размера контекста
// (аргументы tool_calls не считаем: они уже учтены в исходных content-ах результатов).
Функция ДлинаДиалога(Знач Сообщения)

	Длина = 0;
	Для Каждого Сообщение Из Сообщения Цикл
		Содержимое = "";
		Если Сообщение.Свойство("content", Содержимое) И ТипЗнч(Содержимое) = Тип("Строка") Тогда
			Длина = Длина + СтрДлина(Содержимое);
		КонецЕсли;
	КонецЦикла;
	Возврат Длина;

КонецФункции

// Аудит одного вызова инструмента: клиент должен видеть, что ИИ делал с базой.
Процедура ЗаписатьАудитВызова(Знач КорреляционныйИдентификатор, Знач ИтогВызова, Знач Примечание = "")

	ТекстПримечания = "";
	Если Не ПустаяСтрока(Примечание) Тогда
		ТекстПримечания = " " + Примечание;
	КонецЕсли;

	Текст = СтрШаблон(
		НСтр("ru = 'correlation=%1 инструмент=%2 успех=%3%4'"),
		КорреляционныйИдентификатор, ИтогВызова.Имя, Строка(ИтогВызова.Успех), ТекстПримечания);

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'КИИ.АгентАнализа.Вызов'"),
		УровеньЖурналаРегистрации.Информация, , , Текст);

КонецПроцедуры

// Подсказка синтаксиса языка запросов 1С для описания execute_query.
Функция ПодсказкаСинтаксиса1С()

	Возврат НСтр("ru = 'ВАЖНО: query_text - на языке запросов 1С, НЕ на SQL.
		|Используй ВЫБРАТЬ вместо SELECT, ИЗ вместо FROM, КОЛИЧЕСТВО вместо COUNT.
		|Таблицы адресуй с префиксом типа: Справочник.Имя, Документ.Имя, РегистрСведений.Имя,
		|РегистрНакопления.Имя. Пример: ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ Справочник.Контрагенты.
		|Обязательно указывай limit. Только чтение - без ИЗМЕНИТЬ/УДАЛИТЬ/УНИЧТОЖИТЬ.'");

КонецФункции

// Разбирает строку JSON-аргументов от модели в структуру. Пустая строка - пустая структура.
Функция РазобратьАргументы(Знач АргументыСтрокой)

	Если ПустаяСтрока(АргументыСтрокой) Тогда
		Возврат Новый Структура;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(АргументыСтрокой);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
		Структура = Новый Структура;
		Для Каждого КлючИЗначение Из Результат Цикл
			Структура.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Возврат Структура;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Краткое (безопасное для клиента) представление ошибки.
Функция КраткийТекстОшибки(Знач ИнформацияОбОшибке)

	Возврат СтрШаблон(
		НСтр("ru = 'Ошибка выполнения инструмента: %1'"),
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

КонецФункции

#КонецОбласти
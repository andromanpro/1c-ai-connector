#Область ПрограммныйИнтерфейс

// Возвращает значение перечисления типа формата API, который покрывает данный провайдер.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.КИИ_ТипыФорматовAPI
//
Функция ИмяФормата() Экспорт
	Возврат Перечисления.КИИ_ТипыФорматовAPI.GigaChat;
КонецФункции

// Признак поддержки мультимодального ввода (изображения и документы).
// Конкретная модель должна поддерживать соответствующую модальность.
//
// Возвращаемое значение:
//  Булево
//
Функция ПоддерживаетМультимодал() Экспорт
	Возврат Истина;
КонецФункции

// Заполняет соответствие HTTP-заголовков для GigaChat API.
// GigaChat использует Bearer-токен (полученный через OAuth2-флоу в КИИ_КоннекторИИ.ПолучитьGigaChatТокенДоступа).
//
// Параметры:
//  Параметры  - Структура - параметры модели (см. КИИ_КоннекторИИ.ПараметрыМодели)
//  КлючAPI    - Строка    - access_token Bearer (НЕ Authorization Key)
//  Заголовки  - Соответствие из КлючИЗначение - выходной параметр, HTTP-заголовки (имя → значение):
//   * Ключ - Строка - имя заголовка
//   * Значение - Строка - значение заголовка
//
Процедура СформироватьЗаголовки(Параметры, КлючAPI, Заголовки) Экспорт
	
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
	
КонецПроцедуры

// Формирует тело HTTP-запроса. Текст собирается в OpenAI-совместимом формате (делегирует на
// КИИ_КоннекторOpenAI) и переводится на диалект GigaChat. Вложения GigaChat v1 принимает только
// идентификаторами загруженных файлов: двоичные данные сначала уходят в POST .../files,
// полученные id попадают в attachments сообщения пользователя.
//
// Параметры:
//  Параметры        - Структура - параметры модели; при вложениях фасад добавляет поле
//                                 КлючAPIДляВложений с Bearer-токеном основного запроса
//  СтруктураПромпта - Структура - системный/пользовательский промпт + опционально история сообщений
//  ТелоЗапроса      - Структура - выходной параметр
//
Процедура СформироватьТелоЗапроса(Параметры, СтруктураПромпта, ТелоЗапроса) Экспорт

	Если КИИ_КоннекторИИОбщий.ЭтоМассив(СтруктураПромпта.ПользовательскийПромпт) Тогда
		ПланВложений = ПостроитьGigaChatКонтентИзМассива(СтруктураПромпта.ПользовательскийПромпт);
		СформироватьОсновуТелаGigaChat(Параметры, СтруктураПромпта, ПланВложений.Текст, ТелоЗапроса);
		ИдентификаторыФайлов = ЗагрузитьФайлыGigaChat(Параметры, ПланВложений.Файлы);
		ДобавитьВложенияGigaChat(ТелоЗапроса, ИдентификаторыФайлов, ПланВложений.ЕстьДокументы);
		Возврат;
	КонецЕсли;

	КИИ_КоннекторOpenAI.СформироватьТелоЗапроса(Параметры, СтруктураПромпта, ТелоЗапроса);

	// GigaChat говорит на диалекте legacy functions API: OpenAI-поля tools/tool_calls/role=tool
	// он не понимает - тело после сборки переводится на functions/function_call/role=function.
	АдаптироватьТелоДляGigaChat(ТелоЗапроса);

КонецПроцедуры

// Формирует мультимодальное тело GigaChat с заранее известными идентификаторами файлов.
// Предназначена для модульных тестов сборки запроса без сетевого вызова.
//
// Параметры:
//  Параметры            - Структура - параметры модели.
//  СтруктураПромпта     - Структура - подготовленный промпт.
//  ИдентификаторыФайлов - Массив из Строка - результаты имитируемой загрузки.
//
// Возвращаемое значение:
//  Структура:
//   * ТелоЗапроса        - Структура - собранное тело GigaChat.
//   * КоличествоЗагрузок - Число - число файлов, которые требуется загрузить.
//
Функция СформироватьМультимодальноеТелоДляТестов(
	Знач Параметры, Знач СтруктураПромпта, Знач ИдентификаторыФайлов) Экспорт

	Перем КоличествоЭлементов;
	Перем РезультатФункции;

	ПланВложений = ПостроитьGigaChatКонтентИзМассива(СтруктураПромпта.ПользовательскийПромпт);
	ТелоЗапроса = Новый Структура;
	СформироватьОсновуТелаGigaChat(Параметры, СтруктураПромпта, ПланВложений.Текст, ТелоЗапроса);
	ДобавитьВложенияGigaChat(ТелоЗапроса, ИдентификаторыФайлов, ПланВложений.ЕстьДокументы);

	КоличествоЭлементов = ПланВложений.Файлы.Количество();
	РезультатФункции = Новый Структура("ТелоЗапроса, КоличествоЗагрузок", ТелоЗапроса, КоличествоЭлементов);
	Возврат РезультатФункции;

КонецФункции

// Адрес загрузки файлов GigaChat, выведенный из адреса модели: путь .../chat/completions
// заменяется на .../files. Файл уходит на тот же хост и в ту же версию API, что и запрос,
// который на него ссылается (облако Сбера, корпоративный контур, шлюз).
//
// Параметры:
//  Параметры - Структура - параметры модели (Адрес, АдресЗапроса, ИспользоватьЗащищенноеСоединение).
//
// Возвращаемое значение:
//  Строка - полный URL загрузки файлов.
//
Функция АдресЗагрузкиФайлов(Знач Параметры) Экспорт

	Перем КонецТекста;
	Перем ДлинаТекста;

	Перем РезультатФункции;

	ПутьЗапроса = СокрЛП(Параметры.АдресЗапроса);
	Если Не СтрНачинаетсяС(ПутьЗапроса, "/") Тогда
		ПутьЗапроса = "/" + ПутьЗапроса;
	КонецЕсли;

	ОкончаниеПути = "/chat/completions";
	ДлинаОкончания = СтрДлина(ОкончаниеПути);
	КонецТекста = Прав(ПутьЗапроса, ДлинаОкончания);
	Если НРег(КонецТекста) <> ОкончаниеПути Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось вывести адрес загрузки файлов GigaChat из адреса запроса %1:
			|ожидается путь, который оканчивается на /chat/completions'"), ПутьЗапроса);
	КонецЕсли;

	Протокол = ?(Параметры.ИспользоватьЗащищенноеСоединение, "https://", "http://");
	ДлинаТекста = СтрДлина(ПутьЗапроса);
	ПутьФайлов = Лев(ПутьЗапроса, ДлинаТекста - ДлинаОкончания) + "/files";

	РезультатФункции = Протокол + СокрЛП(Параметры.Адрес) + ПутьФайлов;
	Возврат РезультатФункции;

КонецФункции

// Разбирает JSON-ответ GigaChat. Формат OpenAI-совместимый - делегирует на КИИ_КоннекторOpenAI.
// Не обрабатывает блок error - это делает общий КИИ_КоннекторИИОбщий.ЕстьОшибкаВОтветеAPI до диспетчеризации.
//
// Параметры:
//  ОтветJSON - Соответствие из КлючИЗначение - распарсенный JSON-ответ:
//   * Ключ - Строка - имя поля JSON
//   * Значение - Произвольный - значение поля
//  Результат - Структура    - выходной параметр (см. КИИ_КоннекторИИ.НовыйПараметрыОтветаИИ)
//
Процедура РазобратьОтвет(ОтветJSON, Результат) Экспорт

	КИИ_КоннекторOpenAI.РазобратьОтвет(ОтветJSON, Результат);
	ИзвлечьВызовФункцииGigaChat(ОтветJSON, Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает массив контента фасада для GigaChat v1: текстовые элементы склеиваются в строку content
// (v1 принимает строку), изображения и документы собираются в список файлов к загрузке.
// Вложение, которое GigaChat не примет, прерывает запрос исключением до любой загрузки.
Функция ПостроитьGigaChatКонтентИзМассива(Знач МассивКонтента)

	Перем РезультатФайлИзображенияGigaChat;
	Перем РезультатФайлДокументаGigaChat;

	Перем ПредставлениеЗначения;
	Перем СоединенныйТекст;
	Перем РезультатФункции;

	ЧастиТекста = Новый Массив;
	Файлы = Новый Массив;
	ЕстьИзображение = Ложь;
	ЕстьДокументы = Ложь;

	Для Каждого ЭлементКонтента Из МассивКонтента Цикл
		Если ЭлементКонтента.Тип = "text" Тогда
			ПредставлениеЗначения = Строка(ЭлементКонтента.Текст);
			ЧастиТекста.Добавить(ПредставлениеЗначения);
		ИначеЕсли ЭлементКонтента.Тип = "image" Тогда
			Если ЕстьИзображение Тогда
				ВызватьИсключение НСтр("ru = 'GigaChat принимает одно изображение в сообщении.
					|Отправьте изображения отдельными запросами'");
			КонецЕсли;
			РезультатФайлИзображенияGigaChat = ФайлИзображенияGigaChat(ЭлементКонтента);
			Файлы.Добавить(РезультатФайлИзображенияGigaChat);
			ЕстьИзображение = Истина;
		ИначеЕсли ЭлементКонтента.Тип = "document" Тогда
			РезультатФайлДокументаGigaChat = ФайлДокументаGigaChat(ЭлементКонтента);
			Файлы.Добавить(РезультатФайлДокументаGigaChat);
			ЕстьДокументы = Истина;
		Иначе
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'GigaChat: неизвестный тип элемента контента %1'"), ЭлементКонтента.Тип);
		КонецЕсли;
	КонецЦикла;

	СоединенныйТекст = СтрСоединить(ЧастиТекста, Символы.ПС);
	РезультатФункции = Новый Структура("Текст, Файлы, ЕстьДокументы", СоединенныйТекст, Файлы, ЕстьДокументы);
	Возврат РезультатФункции;

КонецФункции

// Изображение JPEG, PNG, TIFF или BMP из двоичных данных либо data-URI. Внешние ссылки API v1
// не принимает: в attachments допустим только идентификатор загруженного файла.
Функция ФайлИзображенияGigaChat(Знач ЭлементКонтента)

	Перем РезультатФункции;

	URL = КИИ_КоннекторИИОбщий.АдресИзображения(ЭлементКонтента);
	Если ЗначениеЗаполнено(URL) Тогда
		ДанныеСсылки = КИИ_КоннекторИИОбщий.РазобратьDataURI(URL);
		Если ДанныеСсылки = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'GigaChat не принимает изображение по внешней ссылке.
				|Передайте картинку двоичными данными (КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные)'");
		КонецЕсли;
		MIME = ДанныеСсылки.MIME;
		ДвоичныеДанные = Base64Значение(ДанныеСсылки.Base64);
	Иначе
		MIME = КИИ_КоннекторИИОбщий.НормализованныйMIME(ЭлементКонтента.MIME);
		ДвоичныеДанные = ЭлементКонтента.ДвоичныеДанные;
	КонецЕсли;

	Расширение = РасширениеФайлаGigaChat(MIME, Истина);
	Если Расширение = "" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'GigaChat принимает изображения JPEG, PNG, TIFF и BMP, передан MIME-тип %1'"), MIME);
	КонецЕсли;

	РезультатФункции = Новый Структура("ИмяФайла, ДвоичныеДанные, MIME", "image." + Расширение, ДвоичныеДанные, MIME);
	Возврат РезультатФункции;

КонецФункции

// Документ TXT, DOC, DOCX, PDF, EPUB, PPT, PPTX или XLSX. Имя файла берется из элемента контента,
// без него - техническое по MIME-типу.
Функция ФайлДокументаGigaChat(Знач ЭлементКонтента)

	Перем РезультатФункции;

	MIME = КИИ_КоннекторИИОбщий.НормализованныйMIME(ЭлементКонтента.MIME);
	Расширение = РасширениеФайлаGigaChat(MIME, Ложь);
	Если Расширение = "" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'GigaChat принимает документы TXT, DOC, DOCX, PDF, EPUB, PPT, PPTX и XLSX,
			|передан MIME-тип %1'"), MIME);
	КонецЕсли;

	ИмяФайла = "";
	Если Не ЭлементКонтента.Свойство("ИмяФайла", ИмяФайла) Или Не ЗначениеЗаполнено(ИмяФайла) Тогда
		ИмяФайла = "document." + Расширение;
	КонецЕсли;

	РезультатФункции = Новый Структура(
		"ИмяФайла, ДвоичныеДанные, MIME", ИмяФайла, ЭлементКонтента.ДвоичныеДанные, MIME);
	Возврат РезультатФункции;

КонецФункции

// Расширение файла по MIME-типу, который GigaChat принимает на загрузку; пустая строка - не принимает.
// Документация GigaChat приводит для части форматов нестандартные MIME (application/epub, application/ppt,
// application/pptx и XLSX как application/vnd.ms-excel) - приняты и они, и стандартные значения тех же форматов.
Функция РасширениеФайлаGigaChat(Знач MIME, Знач ЭтоИзображение)

	Перем РезультатФункции;

	Расширения = Новый Соответствие;
	Если ЭтоИзображение Тогда
		Расширения.Вставить("image/jpeg", "jpg");
		Расширения.Вставить("image/png", "png");
		Расширения.Вставить("image/tiff", "tiff");
		Расширения.Вставить("image/bmp", "bmp");
	Иначе
		Расширения.Вставить("text/plain", "txt");
		Расширения.Вставить("application/pdf", "pdf");
		Расширения.Вставить("application/msword", "doc");
		Расширения.Вставить("application/vnd.openxmlformats-officedocument.wordprocessingml.document", "docx");
		Расширения.Вставить("application/epub", "epub");
		Расширения.Вставить("application/epub+zip", "epub");
		Расширения.Вставить("application/ppt", "ppt");
		Расширения.Вставить("application/vnd.ms-powerpoint", "ppt");
		Расширения.Вставить("application/pptx", "pptx");
		Расширения.Вставить("application/vnd.openxmlformats-officedocument.presentationml.presentation", "pptx");
		Расширения.Вставить("application/vnd.ms-excel", "xlsx");
		Расширения.Вставить("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "xlsx");
	КонецЕсли;

	Расширение = Расширения.Получить(MIME);
	РезультатФункции = ?(Расширение = Неопределено, "", Расширение);
	Возврат РезультатФункции;

КонецФункции

Процедура СформироватьОсновуТелаGigaChat(Знач Параметры, Знач СтруктураПромпта,
	Знач ТекстПользователя, ТелоЗапроса)

	КопияПромпта = Новый Структура;
	Для Каждого СвойствоПромпта Из СтруктураПромпта Цикл
		КопияПромпта.Вставить(СвойствоПромпта.Ключ, СвойствоПромпта.Значение);
	КонецЦикла;
	КопияПромпта.Вставить("ПользовательскийПромпт", ТекстПользователя);

	КИИ_КоннекторOpenAI.СформироватьТелоЗапроса(Параметры, КопияПромпта, ТелоЗапроса);
	АдаптироватьТелоДляGigaChat(ТелоЗапроса);

КонецПроцедуры

// Загружает файлы вложений и возвращает их идентификаторы в исходном порядке.
// Токен кладет фасад: коннектор сам безопасное хранилище не читает.
Функция ЗагрузитьФайлыGigaChat(Знач Параметры, Знач ФайлыДляЗагрузки)

	Перем РезультатЗагрузитьФайлGigaChat;

	ИдентификаторыФайлов = Новый Массив;
	Если ФайлыДляЗагрузки.Количество() = 0 Тогда
		Возврат ИдентификаторыФайлов;
	КонецЕсли;

	КлючAPI = "";
	Если Не Параметры.Свойство("КлючAPIДляВложений", КлючAPI) Или Не ЗначениеЗаполнено(КлючAPI) Тогда
		ВызватьИсключение НСтр("ru = 'Не получен токен GigaChat для загрузки вложений'");
	КонецЕсли;

	АдресЗагрузки = АдресЗагрузкиФайлов(Параметры);
	Для Каждого Файл Из ФайлыДляЗагрузки Цикл
		РезультатЗагрузитьФайлGigaChat = ЗагрузитьФайлGigaChat(Параметры, АдресЗагрузки, КлючAPI, Файл);
		ИдентификаторыФайлов.Добавить(РезультатЗагрузитьФайлGigaChat);
	КонецЦикла;

	Возврат ИдентификаторыФайлов;

КонецФункции

// Одна загрузка multipart (file + purpose=general) с теми же заголовками и таймаутом, что у запроса
// генерации: Bearer-токен и дополнительные заголовки модели (X-Client-ID обязан совпасть).
Функция ЗагрузитьФайлGigaChat(Знач Параметры, Знач АдресЗагрузки, Знач КлючAPI, Знач Файл)

	Перем РезультатТекстОшибкиЗагрузкиGigaChat;

	Перем РезультатФункции;

	ПоляФормы = Новый Соответствие;
	ПоляФормы.Вставить("purpose", "general");

	ОписаниеФайла = Новый Структура;
	ОписаниеФайла.Вставить("ИмяФайла", Файл.ИмяФайла);
	ОписаниеФайла.Вставить("ДвоичныеДанные", Файл.ДвоичныеДанные);
	ОписаниеФайла.Вставить("ТипКонтента", Файл.MIME);
	Файлы = Новый Соответствие;
	Файлы.Вставить("file", ОписаниеФайла);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
	Для Каждого Заголовок Из Параметры.Заголовки Цикл
		Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;

	// Маршрут как у запроса генерации: прокси из константы только при ИспользоватьПрокси, иначе
	// системные настройки прокси. Неопределено здесь не годится: многочастный клиент подставил бы
	// вместо него прокси из константы (КИИ_HTTPКлиент.СоздатьHTTPСоединение).
	Прокси = ?(Параметры.ИспользоватьПрокси, КИИ_HTTPКлиент.ПроксиПоУмолчанию(), Новый ИнтернетПрокси(Истина));
	Ответ = КИИ_HTTPКлиент.ВыполнитьМногочастныйЗапрос(
		АдресЗагрузки, ПоляФормы, Файлы, Заголовки, Параметры.Таймаут, Прокси);

	ИдентификаторФайла = ПолучитьПолеОтветаGigaChat(Ответ, "id");
	Если Не ЗначениеЗаполнено(ИдентификаторФайла) Тогда
		РезультатТекстОшибкиЗагрузкиGigaChat = ТекстОшибкиЗагрузкиGigaChat(Ответ);
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Не удалось загрузить файл %1 в GigaChat: %2'"),
			Файл.ИмяФайла,
			РезультатТекстОшибкиЗагрузкиGigaChat);
	КонецЕсли;

	РезультатФункции = Строка(ИдентификаторФайла);
	Возврат РезультатФункции;

КонецФункции

// Текст ошибки загрузки. При HTTP-ошибке клиент кладет в error сырое тело ответа и код в status_code,
// при сбое соединения - представление исключения и код 0.
Функция ТекстОшибкиЗагрузкиGigaChat(Знач Ответ)

	Ошибка = ПолучитьПолеОтветаGigaChat(Ответ, "error");
	Если Ошибка = Неопределено Тогда
		Ошибка = ПолучитьПолеОтветаGigaChat(Ответ, "message");
	Иначе
		СообщениеОшибки = ПолучитьПолеОтветаGigaChat(Ошибка, "message");
		Если ЗначениеЗаполнено(СообщениеОшибки) Тогда
			Ошибка = СообщениеОшибки;
		КонецЕсли;
	КонецЕсли;

	ТекстОшибки = ?(ЗначениеЗаполнено(Ошибка), Строка(Ошибка),
		НСтр("ru = 'ответ не содержит идентификатора файла'"));

	КодСостояния = ПолучитьПолеОтветаGigaChat(Ответ, "status_code");
	Если ЗначениеЗаполнено(КодСостояния) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'HTTP %1: %2'"), КодСостояния, ТекстОшибки);
	КонецЕсли;

	Возврат ТекстОшибки;

КонецФункции

Функция ПолучитьПолеОтветаGigaChat(Знач Ответ, Знач ИмяПоля)

	Перем РезультатФункции;

	Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
		РезультатФункции = Ответ.Получить(ИмяПоля);
		Возврат РезультатФункции;
	ИначеЕсли ТипЗнч(Ответ) = Тип("Структура") Тогда
		ЗначениеПоля = Неопределено;
		Ответ.Свойство(ИмяПоля, ЗначениеПоля);
		Возврат ЗначениеПоля;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Идентификаторы файлов уходят в attachments последнего сообщения пользователя. Для документов
// нужен function_call=auto (иначе GigaChat читает только первый документ), а при своих функциях
// в functions добавляется встроенная get_file_content.
Процедура ДобавитьВложенияGigaChat(ТелоЗапроса, Знач ИдентификаторыФайлов, Знач ЕстьДокументы)

	Если ИдентификаторыФайлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИндексСообщения = ТелоЗапроса.messages.Количество() - 1;
	Пока ИндексСообщения >= 0 Цикл
		Сообщение = ТелоЗапроса.messages[ИндексСообщения];
		Если Сообщение.role = "user" Тогда
			Сообщение.Вставить("attachments", ИдентификаторыФайлов);
			Прервать;
		КонецЕсли;
		ИндексСообщения = ИндексСообщения - 1;
	КонецЦикла;

	Если ЕстьДокументы Тогда
		ТелоЗапроса.Вставить("function_call", "auto");
		ДобавитьФункциюЧтенияФайлаGigaChat(ТелоЗапроса);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьФункциюЧтенияФайлаGigaChat(ТелоЗапроса)

	Перем ПараметрыВызова;

	Если Не ТелоЗапроса.Свойство("functions") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ФункцияGigaChat Из ТелоЗапроса.functions Цикл
		Если ФункцияGigaChat.Свойство("name") И ФункцияGigaChat.name = "get_file_content" Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ПараметрыВызова = Новый Структура("name", "get_file_content");
	ТелоЗапроса.functions.Добавить(ПараметрыВызова);

КонецПроцедуры

// Переводит собранное OpenAI-тело на диалект GigaChat: tools -> functions (+function_call auto),
// assistant.tool_calls -> function_call (первый вызов: параллельных GigaChat не формирует),
// role=tool -> role=function с именем функции, восстановленным по идентификатору вызова.
Процедура АдаптироватьТелоДляGigaChat(ТелоЗапроса)

	Перем РезультатСообщениеДляGigaChat;

	Если ТелоЗапроса.Свойство("tools") Тогда
		Функции = Новый Массив;
		Для Каждого Инструмент Из ТелоЗапроса.tools Цикл
			Функции.Добавить(Инструмент.function);
		КонецЦикла;
		ТелоЗапроса.Удалить("tools");
		Если ТелоЗапроса.Свойство("tool_choice") Тогда
			ТелоЗапроса.Удалить("tool_choice");
		КонецЕсли;
		Если Функции.Количество() > 0 Тогда
			ТелоЗапроса.Вставить("functions", Функции);
			ТелоЗапроса.Вставить("function_call", "auto");
		КонецЕсли;
	КонецЕсли;

	Если Не ТелоЗапроса.Свойство("messages") Тогда
		Возврат;
	КонецЕсли;

	ИменаВызововПоИдентификатору = Новый Соответствие;
	НовыеСообщения = Новый Массив;
	Для Каждого Сообщение Из ТелоЗапроса.messages Цикл
		РезультатСообщениеДляGigaChat = СообщениеДляGigaChat(Сообщение, ИменаВызововПоИдентификатору);
		НовыеСообщения.Добавить(РезультатСообщениеДляGigaChat);
	КонецЦикла;
	ТелоЗапроса.Вставить("messages", НовыеСообщения);

КонецПроцедуры

Функция СообщениеДляGigaChat(Знач Сообщение, ИменаВызововПоИдентификатору)

	Перем ИмяФункцииВСообщении;
	Перем РезультатСтрокаJSONВЗначение;
	Перем ПредставлениеЗначения;
	Перем ПредставлениеЗначения2;

	Роль = "";
	Если ТипЗнч(Сообщение) = Тип("Структура") И Сообщение.Свойство("role") Тогда
		Роль = Строка(Сообщение.role);
	КонецЕсли;

	ЕстьВызовы = Роль = "assistant"
		И Сообщение.Свойство("tool_calls")
		И КИИ_КоннекторИИОбщий.ЭтоМассив(Сообщение.tool_calls)
		И Сообщение.tool_calls.Количество() > 0;

	Если ЕстьВызовы Тогда

		Для Каждого ЭлементВызова Из Сообщение.tool_calls Цикл
			ПредставлениеЗначения = Строка(ЭлементВызова.id);
			ПредставлениеЗначения2 = Строка(ЭлементВызова.function.name);
			ИменаВызововПоИдентификатору.Вставить(ПредставлениеЗначения, ПредставлениеЗначения2);
		КонецЦикла;

		ПервыйВызов = Сообщение.tool_calls[0];
		ОписаниеВызова = Новый Структура;
		ОписаниеВызова.Вставить("name", ПервыйВызов.function.name);
		РезультатСтрокаJSONВЗначение = КИИ_КоннекторИИОбщий.СтрокаJSONВЗначение(ПервыйВызов.function.arguments);
		ОписаниеВызова.Вставить("arguments", РезультатСтрокаJSONВЗначение);

		НовоеСообщение = Новый Структура;
		НовоеСообщение.Вставить("role", "assistant");
		ПредставлениеЗначения = Строка(Сообщение.content);
		НовоеСообщение.Вставить("content", ПредставлениеЗначения);
		НовоеСообщение.Вставить("function_call", ОписаниеВызова);
		Возврат НовоеСообщение;

	ИначеЕсли Роль = "tool" Тогда

		ИмяФункции = ИменаВызововПоИдентификатору[Строка(Сообщение.tool_call_id)];
		НовоеСообщение = Новый Структура;
		НовоеСообщение.Вставить("role", "function");
		ИмяФункцииВСообщении = ?(ИмяФункции = Неопределено, "", ИмяФункции);
		НовоеСообщение.Вставить("name", ИмяФункцииВСообщении);
		ПредставлениеЗначения = Строка(Сообщение.content);
		НовоеСообщение.Вставить("content", ПредставлениеЗначения);
		Возврат НовоеСообщение;

	Иначе

		// Обычные system/user/assistant-сообщения GigaChat понимает в OpenAI-виде - отдаем как есть.
		Возврат Сообщение;

	КонецЕсли;

КонецФункции

// Извлекает function_call ответа GigaChat в Результат.ВызовыИнструментов (контракт петли:
// аргументы - строкой JSON; GigaChat отдает их объектом). Идентификатор позиционный.
Процедура ИзвлечьВызовФункцииGigaChat(Знач ОтветJSON, Результат)

	ОтветБезВыборок = Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON)
		Или Не ОтветJSON.Свойство("choices")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(ОтветJSON.choices)
		Или ОтветJSON.choices.Количество() = 0;
	Если ОтветБезВыборок Тогда
		Возврат;
	КонецЕсли;

	Выборка = ОтветJSON.choices[0];
	ВыборкаБезВызоваФункции = Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Выборка)
		Или Не Выборка.Свойство("message")
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Выборка.message)
		Или Не Выборка.message.Свойство("function_call")
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Выборка.message.function_call);
	Если ВыборкаБезВызоваФункции Тогда
		Возврат;
	КонецЕсли;

	ВызовФункции = Выборка.message.function_call;
	Вызов = Новый Структура("Идентификатор, Имя, Аргументы", "call_1", "", "{}");
	Если ВызовФункции.Свойство("name") Тогда
		Вызов.Имя = Строка(ВызовФункции.name);
	КонецЕсли;
	Если ВызовФункции.Свойство("arguments") Тогда
		Вызов.Аргументы = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(ВызовФункции.arguments);
	КонецЕсли;

	Результат.ВызовыИнструментов.Добавить(Вызов);

КонецПроцедуры

#КонецОбласти

// Дашборд ошибок мониторинга: модель данных, страница и ответы веб-доступа.
// Одна страница на два входа: HTML-поле формы обработки КИИ_ДашбордОшибок (скрипты встроены в страницу)
// и HTTP-сервис КИИ_ДашбордОшибокВеб (скрипты отдельными файлами, данные тем же JSON).
// Графики строит браузер: ECharts 6.1.0 (Apache-2.0, макет echarts_js обработки). Сервер отдает модель
// за 180 дней, периоды 7/30/90 пересчитываются на странице без обращений к базе.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Право смотреть дашборд - право Использование на обработку КИИ_ДашбордОшибок. Его дают полные права
// и роль КИИ_ДашбордОшибокПросмотр, рассчитанная на пользователя веб-доступа.
//
// Возвращаемое значение:
//  Булево - Истина, если текущему пользователю разрешен просмотр дашборда.
//
Функция ПросмотрРазрешен() Экспорт

	Результат = ПравоДоступа("Использование", Метаданные.Обработки.КИИ_ДашбордОшибок);
	Возврат Результат;

КонецФункции

// Хеш ошибки для глубокого анализа из формы дашборда: самая частая за период по сумме вхождений
// из статистики (та же мера, что в блоке «что болит»), без ошибок под правилами игнорирования.
// Накопленное число повторений в журнале не годится: старая ошибка с тысячами повторений за историю
// и одним вхождением за неделю обогнала бы свежую.
//
// Параметры:
//  ДатаОкончания - Дата - последний день периода (входит целиком).
//  ПериодДней    - Число - длина периода в днях.
//
// Возвращаемое значение:
//  Строка - хеш ошибки; пустая строка, если вхождений за период нет.
//
Функция ХешСамойЧастойОшибки(Знач ДатаОкончания, Знач ПериодДней) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Статистика.ХешОшибки КАК ХешОшибки,
		|	СУММА(Статистика.Количество) КАК Вхождений
		|ИЗ
		|	РегистрСведений.КИИ_МониторингОшибокСтатистика КАК Статистика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КИИ_МониторингОшибокЖурнал КАК Журнал
		|		ПО Журнал.ХешОшибки = Статистика.ХешОшибки
		|			И НЕ Журнал.Игнорировать
		|ГДЕ
		|	Статистика.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	Статистика.ХешОшибки
		|
		|УПОРЯДОЧИТЬ ПО
		|	Вхождений УБЫВ,
		|	ХешОшибки";
	НачалоПоследнегоДня = НачалоДня(ДатаОкончания);
	ДатаНачала = НачалоПоследнегоДня - (ПериодДней - 1) * 86400;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	КонецПоследнегоДня = КонецДня(ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецПоследнегоДня);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ХешОшибки;
	КонецЕсли;
	Возврат "";

КонецФункции

// Настройки страницы по умолчанию: светлая тема, период 30 дней, скрипты встроены в страницу.
//
// Возвращаемое значение:
//  Структура:
//   * Тема                 - Строка - light или dark.
//   * ПериодДней           - Число - 7, 30 или 90: период, открытый при загрузке страницы.
//   * ВстроитьСкрипты      - Булево - Истина для HTML-поля формы, Ложь для веб-доступа.
//   * АдресСкриптов        - Строка - базовый адрес HTTP-сервиса, который отдает скрипты (без завершающего /).
//   * ОбновлятьЧерезСекунд - Число - период автообновления страницы; 0 - без автообновления.
//   * КомандыФормы         - Булево - Истина для HTML-поля формы: на странице видны кнопки команд формы
//                            (обновить, анализ, глубокий анализ, включить регламенты); клик по ним форма
//                            получает в ПриНажатии поля как ссылку «#iikona?command=...&days=...&theme=...»
//                            (см. КИИ_МониторингОшибокДашбордКлиентСервер.КомандаСтраницы).
//   * ТекстГлубокогоАнализа - Строка - результат глубокого анализа для панели на странице; "" - панели нет.
//
Функция НовыеНастройкиСтраницы() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Тема", "light");
	Настройки.Вставить("ПериодДней", 30);
	Настройки.Вставить("ВстроитьСкрипты", Истина);
	Настройки.Вставить("АдресСкриптов", "");
	Настройки.Вставить("ОбновлятьЧерезСекунд", 0);
	Настройки.Вставить("КомандыФормы", Ложь);
	Настройки.Вставить("ТекстГлубокогоАнализа", "");
	Возврат Настройки;

КонецФункции

// Страница дашборда с актуальными данными.
//
// Параметры:
//  НастройкиСтраницы - см. КИИ_МониторингОшибокДашборд.НовыеНастройкиСтраницы
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//
Функция СтраницаДашборда(Знач НастройкиСтраницы) Экспорт

	МоментФормирования = ТекущаяДатаСеанса();
	Модель = МодельДашборда(МоментФормирования);
	Страница = СобратьСтраницу(Модель, НастройкиСтраницы);
	Возврат Страница;

КонецФункции

// Модель дашборда из регистров мониторинга и журнала запросов ИИ за окно истории по день ДатаОкончания.
// Регистры читаются в привилегированном режиме, но только после проверки права просмотра: пользователю
// веб-доступа не нужны права на регистры мониторинга и на журнал запросов ИИ с текстами промптов.
//
// Параметры:
//  ДатаОкончания - Дата - момент формирования; последний день окна - день этой даты.
//
// Возвращаемое значение:
//  См. КИИ_МониторингОшибокДашборд.СобратьМодель
//
Функция МодельДашборда(Знач ДатаОкончания) Экспорт

	Если Не ПросмотрРазрешен() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для просмотра дашборда ошибок.
			|Нужна роль «Просмотр дашборда ошибок» или право на обработку «Дашборд ошибок».'");
	КонецЕсли;

	Сведения = НовыеСведенияМодели(ДатаОкончания);
	ДатаНачала = Сведения.ДатаОкончания - (Сведения.ДнейИстории - 1) * 86400;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДневнаяСтатистика.Период КАК Период,
		|	ДневнаяСтатистика.ХешОшибки КАК ХешОшибки,
		|	ДневнаяСтатистика.Количество КАК Количество
		|ПОМЕСТИТЬ ВТВхожденияОкна
		|ИЗ
		|	РегистрСведений.КИИ_МониторингОшибокСтатистика КАК ДневнаяСтатистика
		|ГДЕ
		|	ДневнаяСтатистика.Период МЕЖДУ &ДатаНачала И &КонецОкна
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВхожденияОкна.Период КАК Период,
		|	ВхожденияОкна.ХешОшибки КАК ХешОшибки,
		|	ВхожденияОкна.Количество КАК Количество
		|ИЗ
		|	ВТВхожденияОкна КАК ВхожденияОкна
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЖурналОшибок.ХешОшибки КАК ХешОшибки,
		|	ЖурналОшибок.Критичность КАК Критичность,
		|	ПОДСТРОКА(ЖурналОшибок.Метаданные, 1, 200) КАК Метаданные,
		|	ПОДСТРОКА(ЖурналОшибок.Событие, 1, 200) КАК Событие,
		|	ПОДСТРОКА(ЖурналОшибок.ТекстОшибки, 1, 300) КАК ТекстОшибки,
		|	ПОДСТРОКА(ЖурналОшибок.ОписаниеОтИИ, 1, 700) КАК ОписаниеОтИИ,
		|	ЖурналОшибок.Игнорировать КАК Игнорировать,
		|	ЖурналОшибок.ПроанализированаИИ КАК ПроанализированаИИ,
		|	ЖурналОшибок.ОтправленаВТелеграм КАК ОтправленаВТелеграм,
		|	ЖурналОшибок.ПерваяДатаВремя КАК ПерваяДатаВремя,
		|	ЖурналОшибок.ПоследнееВхождение КАК ПоследнееВхождение
		|ИЗ
		|	РегистрСведений.КИИ_МониторингОшибокЖурнал КАК ЖурналОшибок
		|ГДЕ
		|	ЖурналОшибок.ХешОшибки В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ХешиОкна.ХешОшибки КАК ХешОшибки
		|			ИЗ
		|				ВТВхожденияОкна КАК ХешиОкна)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ЗапросыИИ.ДатаЗапроса, ДЕНЬ) КАК День,
		|	СУММА(ЗапросыИИ.ВсегоТокенов) КАК Токены,
		|	СУММА(ВЫБОР КОГДА ЗапросыИИ.ВалютаСтоимости = ""USD"" ТОГДА ЗапросыИИ.СтоимостьОтвета ИНАЧЕ 0 КОНЕЦ) КАК Стоимость
		|ИЗ
		|	РегистрСведений.КИИ_ЛогЗапросовИИ КАК ЗапросыИИ
		|ГДЕ
		|	ЗапросыИИ.ДатаЗапроса МЕЖДУ &ДатаНачала И &КонецОкна
		|	И НЕ ЗапросыИИ.ИзКеша
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ЗапросыИИ.ДатаЗапроса, ДЕНЬ)";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	КонецОкна = КонецДня(Сведения.ДатаОкончания);
	Запрос.УстановитьПараметр("КонецОкна", КонецОкна);
	Результаты = Запрос.ВыполнитьПакет();

	Состояние = КИИ_МониторингОшибок.СостояниеРегламентов();
	Сведения.СборВключен = Состояние.СборВключен;
	Сведения.АнализВключен = Состояние.АнализВключен;
	Сведения.ДатаПоследнегоСбора = КИИ_МониторингОшибокЖР.ПолучитьДатуПоследнегоСбора();

	УстановитьПривилегированныйРежим(Ложь);

	Вхождения = Результаты[1].Выгрузить();
	ОшибкиЖурнала = Результаты[2].Выгрузить();
	Расходы = Результаты[3].Выгрузить();
	Модель = СобратьМодель(Вхождения, ОшибкиЖурнала, Расходы, Сведения);
	Возврат Модель;

КонецФункции

// Сведения для сборки модели: окно истории, лимит ошибок и состояние мониторинга.
//
// Параметры:
//  ДатаФормирования - Дата - момент формирования модели; последний день окна - день этой даты.
//
// Возвращаемое значение:
//  Структура:
//   * ДатаОкончания       - Дата - начало последнего дня окна.
//   * ДатаФормирования    - Дата - момент формирования, показывается на странице.
//   * ДнейИстории         - Число - длина окна: 90 дней периода и 90 дней для сравнения с прошлым.
//   * ЛимитОшибок         - Число - сколько самых частых ошибок попадает в модель.
//   * ДатаПоследнегоСбора - Дата - последний сбор ошибок из журнала регистрации.
//   * СборВключен         - Булево - регламентное задание сбора ошибок включено.
//   * АнализВключен       - Булево - регламентное задание анализа ИИ включено.
//
Функция НовыеСведенияМодели(Знач ДатаФормирования) Экспорт

	Сведения = Новый Структура;
	ДатаОкончания = НачалоДня(ДатаФормирования);
	Сведения.Вставить("ДатаОкончания", ДатаОкончания);
	Сведения.Вставить("ДатаФормирования", ДатаФормирования);
	Сведения.Вставить("ДнейИстории", 180);
	Сведения.Вставить("ЛимитОшибок", 2000);
	ПустаяДата = Дата(1, 1, 1);
	Сведения.Вставить("ДатаПоследнегоСбора", ПустаяДата);
	Сведения.Вставить("СборВключен", Ложь);
	Сведения.Вставить("АнализВключен", Ложь);
	Возврат Сведения;

КонецФункции

// Собирает модель дашборда из строк выборок. Чистая функция: к базе не обращается.
//
// Параметры:
//  Вхождения     - ТаблицаЗначений, Массив из Структура - строки с полями Период, ХешОшибки, Количество.
//  ОшибкиЖурнала - ТаблицаЗначений, Массив из Структура - строки журнала ошибок с полями ХешОшибки,
//                  Критичность, Метаданные, Событие, ТекстОшибки, ОписаниеОтИИ, Игнорировать, ПроанализированаИИ,
//                  ОтправленаВТелеграм, ПерваяДатаВремя, ПоследнееВхождение.
//  Расходы       - ТаблицаЗначений, Массив из Структура - строки с полями День, Токены, Стоимость.
//  Сведения      - см. КИИ_МониторингОшибокДашборд.НовыеСведенияМодели
//
// Возвращаемое значение:
//  Структура - модель для страницы (ключи на английском: их читает JavaScript страницы):
//   * generated   - Строка - момент формирования.
//   * lastCollect - Строка - момент последнего сбора, пустая строка, если сбора не было.
//   * collectOn   - Булево - сбор ошибок включен.
//   * analyzeOn   - Булево - анализ ИИ включен.
//   * truncated   - Число - сколько редких ошибок не вошло в модель из-за лимита.
//   * days        - Массив из Строка - дни окна в формате ГГГГ-ММ-ДД от старого к новому.
//   * errors      - Массив из Структура - ошибки по убыванию вхождений за окно:
//     ** level     - Строка - crit, high, mid, low или none.
//     ** object    - Строка - объект метаданных.
//     ** event     - Строка - событие журнала регистрации.
//     ** text      - Строка - текст ошибки, сокращенный.
//     ** ai        - Строка - рекомендация ИИ, сокращенная; пустая, если разбора нет.
//     ** ignored   - Булево - ошибка подпала под правило игнорирования.
//     ** analyzed  - Булево - ошибка разобрана ИИ.
//     ** telegram  - Булево - ошибка отправлена в Телеграм.
//     ** first     - Строка - первое вхождение в формате ГГГГ-ММ-ДДTЧЧ:ММ или пустая строка.
//     ** last      - Строка - последнее вхождение в том же формате или пустая строка.
//     ** counts    - Массив из Массив - числовые пары [индекс дня окна, вхождений за день].
//   * costs       - Массив из Массив - числовые тройки [индекс дня окна, токенов, стоимость] по дням с расходами.
//
Функция СобратьМодель(Знач Вхождения, Знач ОшибкиЖурнала, Знач Расходы, Знач Сведения) Экспорт

	ДатаОкончания = НачалоДня(Сведения.ДатаОкончания);
	ДатаНачала = ДатаОкончания - (Сведения.ДнейИстории - 1) * 86400;

	Дни = Новый Массив;
	ИндексыДней = Новый Соответствие;
	Для НомерДня = 0 По Сведения.ДнейИстории - 1 Цикл
		ДеньОкна = ДатаНачала + НомерДня * 86400;
		ПредставлениеДня = Формат(ДеньОкна, "ДФ=yyyy-MM-dd");
		Дни.Добавить(ПредставлениеДня);
		ИндексыДней.Вставить(ДеньОкна, НомерДня);
	КонецЦикла;

	ВхожденияОшибок = ВхожденияПоХешам(Вхождения, ИндексыДней);

	СтрокиЖурнала = Новый Соответствие;
	Для Каждого СтрокаЖурнала Из ОшибкиЖурнала Цикл
		СтрокиЖурнала.Вставить(СтрокаЖурнала.ХешОшибки, СтрокаЖурнала);
	КонецЦикла;

	Порядок = Новый ТаблицаЗначений;
	Порядок.Колонки.Добавить("ХешОшибки");
	Порядок.Колонки.Добавить("Всего");
	Для Каждого ЭлементВхождений Из ВхожденияОшибок Цикл
		СтрокаПорядка = Порядок.Добавить();
		СтрокаПорядка.ХешОшибки = ЭлементВхождений.Ключ;
		СтрокаПорядка.Всего = ЭлементВхождений.Значение.Всего;
	КонецЦикла;
	Порядок.Сортировать("Всего Убыв, ХешОшибки");

	Ошибки = Новый Массив;
	Для Каждого СтрокаПорядка Из Порядок Цикл
		Если Ошибки.Количество() >= Сведения.ЛимитОшибок Тогда
			Прервать;
		КонецЕсли;
		СтрокаЖурнала = СтрокиЖурнала.Получить(СтрокаПорядка.ХешОшибки);
		ВхожденияОшибки = ВхожденияОшибок.Получить(СтрокаПорядка.ХешОшибки);
		Счетчики = ВхожденияОшибки.Счетчики;
		Ошибка = ОшибкаМодели(СтрокаЖурнала, Счетчики);
		Ошибка.Вставить("hash", СтрокаПорядка.ХешОшибки);
		Ошибки.Добавить(Ошибка);
	КонецЦикла;

	Модель = Новый Структура;
	ПредставлениеМоментаФормирования = Формат(Сведения.ДатаФормирования, "ДФ='dd.MM HH:mm'");
	Модель.Вставить("generated", ПредставлениеМоментаФормирования);
	Если ЗначениеЗаполнено(Сведения.ДатаПоследнегоСбора) Тогда
		ПредставлениеПоследнегоСбора = Формат(Сведения.ДатаПоследнегоСбора, "ДФ='dd.MM HH:mm'");
		Модель.Вставить("lastCollect", ПредставлениеПоследнегоСбора);
	Иначе
		Модель.Вставить("lastCollect", "");
	КонецЕсли;
	Модель.Вставить("collectOn", Сведения.СборВключен);
	Модель.Вставить("analyzeOn", Сведения.АнализВключен);
	КоличествоОтсеченныхОшибок = Порядок.Количество() - Ошибки.Количество();
	Модель.Вставить("truncated", КоличествоОтсеченныхОшибок);
	Модель.Вставить("days", Дни);
	Модель.Вставить("errors", Ошибки);
	ДневныеРасходы = РасходыПоДням(Расходы, ИндексыДней);
	Модель.Вставить("costs", ДневныеРасходы);
	Возврат Модель;

КонецФункции

// Собирает HTML-страницу из модели. Скрипты встраиваются в страницу или подключаются по адресу
// HTTP-сервиса; данные (модель и текст глубокого анализа) кладутся неисполняемым JSON и подставляются последними.
//
// Параметры:
//  Модель            - см. КИИ_МониторингОшибокДашборд.СобратьМодель
//  НастройкиСтраницы - см. КИИ_МониторингОшибокДашборд.НовыеНастройкиСтраницы
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//
Функция СобратьСтраницу(Знач Модель, Знач НастройкиСтраницы) Экспорт

	Настройки = НовыеНастройкиСтраницы();
	ЗаполнитьЗначенияСвойств(Настройки, НастройкиСтраницы);

	Если Настройки.Тема = "dark" Тогда
		Тема = "dark";
	Иначе
		Тема = "light";
	КонецЕсли;

	Если Настройки.ПериодДней = 7 Или Настройки.ПериодДней = 90 Тогда
		ПериодДней = Настройки.ПериодДней;
	Иначе
		ПериодДней = 30;
	КонецЕсли;

	Если Настройки.ВстроитьСкрипты Тогда
		СодержимоеБиблиотеки = ТекстБиблиотеки();
		БлокБиблиотеки = СтрШаблон("<script>%1</script>", СодержимоеБиблиотеки);
		СодержимоеСкрипта = ТекстСкрипта();
		БлокСкрипта = СтрШаблон("<script>%1</script>", СодержимоеСкрипта);
	Иначе
		АдресСкриптов = ЭкранироватьАтрибут(Настройки.АдресСкриптов);
		ВерсияБиблиотеки = ВерсияECharts();
		БлокБиблиотеки = СтрШаблон("<script src=""%1/echarts?v=%2""></script>", АдресСкриптов, ВерсияБиблиотеки);
		БлокСкрипта = СтрШаблон("<script src=""%1/script""></script>", АдресСкриптов);
	КонецЕсли;

	// Период автообновления уходит атрибутом data-refresh: страницу перезагружает скрипт по адресу с открытым
	// периодом и темой; meta refresh вернул бы исходный адрес и сбросил выбранный период.
	ИнтервалОбновления = ?(Настройки.ОбновлятьЧерезСекунд > 0, Настройки.ОбновлятьЧерезСекунд, 0);
	ПериодОбновления = Формат(ИнтервалОбновления, "ЧН=0; ЧГ=0");

	// Данные подставляются последними: после них в странице ничего не заменяется, поэтому текст ошибки
	// с именем заполнителя не подменит библиотеку или скрипт.
	МакетСтраницы = Обработки.КИИ_ДашбордОшибок.ПолучитьМакет("ШаблонСтраницы");
	Страница = МакетСтраницы.ПолучитьТекст();
	Страница = СтрЗаменить(Страница, "%ECHARTS_LIBRARY%", БлокБиблиотеки);
	Страница = СтрЗаменить(Страница, "%DASHBOARD_SCRIPT%", БлокСкрипта);
	Страница = СтрЗаменить(Страница, "%DASHBOARD_THEME%", Тема);
	ПредставлениеПериода = Формат(ПериодДней, "ЧГ=0");
	Страница = СтрЗаменить(Страница, "%DASHBOARD_PERIOD%", ПредставлениеПериода);
	Страница = СтрЗаменить(Страница, "%DASHBOARD_REFRESH%", ПериодОбновления);
	ВариантРазмещения = ?(Настройки.КомандыФормы, "form", "web");
	Страница = СтрЗаменить(Страница, "%DASHBOARD_HOST%", ВариантРазмещения);
	ДанныеСтраницы = ДанныеДляСтраницы(Модель, Настройки.ТекстГлубокогоАнализа);
	Страница = СтрЗаменить(Страница, "%DASHBOARD_DATA%", ДанныеСтраницы);
	Возврат Страница;

КонецФункции

// Ответ веб-доступа к дашборду. Не зависит от объектов HTTP-сервиса, поэтому проверяется тестами;
// обработчики HTTP-сервиса КИИ_ДашбордОшибокВеб только переносят результат в HTTPСервисОтвет.
//
// Параметры:
//  Ресурс           - Строка - page (страница), library (ECharts) или script (скрипт дашборда).
//  БазовыйАдрес     - Строка - базовый URL HTTP-сервиса (HTTPСервисЗапрос.БазовыйURL).
//  ПараметрыЗапроса - Соответствие из КлючИЗначение - параметры строки запроса (у HTTP-сервиса - фиксированное
//                     соответствие, оно тоже принимается): days (7, 30 или 90) и theme (light или dark):
//   * Ключ     - Строка - имя параметра.
//   * Значение - Строка - значение параметра.
//  ПросмотрРазрешен - Булево - право текущего пользователя на просмотр (см. ПросмотрРазрешен).
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния - Число - HTTP-код ответа.
//   * Заголовки    - Соответствие из КлючИЗначение - HTTP-заголовки ответа:
//     ** Ключ     - Строка - имя заголовка.
//     ** Значение - Строка - значение заголовка.
//   * Тело         - Строка, ДвоичныеДанные - тело ответа.
//
Функция ОтветВеб(Знач Ресурс, Знач БазовыйАдрес, Знач ПараметрыЗапроса, Знач ПросмотрРазрешен) Экспорт

	Если Не ПросмотрРазрешен Тогда
		ТекстОтказа = НСтр("ru = 'Нет права на просмотр дашборда ошибок.
			|Попросите администратора выдать роль «Просмотр дашборда ошибок».'");
		Ответ = ОтветТекстом(403, ТекстОтказа);
		Возврат Ответ;
	КонецЕсли;

	Если Ресурс = "page" Тогда

		Настройки = НовыеНастройкиСтраницы();
		Настройки.ВстроитьСкрипты = Ложь;
		Настройки.АдресСкриптов = БазовыйАдресБезСлеша(БазовыйАдрес);
		Настройки.ОбновлятьЧерезСекунд = 300;
		ПараметрПериода = ЗначениеПараметраЗапроса(ПараметрыЗапроса, "days");
		Настройки.ПериодДней = ПериодИзПараметра(ПараметрПериода);
		Если ЗначениеПараметраЗапроса(ПараметрыЗапроса, "theme") = "dark" Тогда
			Настройки.Тема = "dark";
		КонецЕсли;

		Страница = СтраницаДашборда(Настройки);
		Ответ = НовыйОтвет(200, "text/html; charset=utf-8", Страница);
		Ответ.Заголовки.Вставить("Cache-Control", "no-store");
		ПолитикаБезопасности = ПолитикаБезопасностиСодержимого();
		Ответ.Заголовки.Вставить("Content-Security-Policy", ПолитикаБезопасности);
		Ответ.Заголовки.Вставить("Referrer-Policy", "no-referrer");
		Ответ.Заголовки.Вставить("X-Frame-Options", "SAMEORIGIN");
		Возврат Ответ;

	ИначеЕсли Ресурс = "library" Тогда

		СодержимоеБиблиотеки = Обработки.КИИ_ДашбордОшибок.ПолучитьМакет("echarts_js");
		Ответ = НовыйОтвет(200, "application/javascript; charset=utf-8", СодержимоеБиблиотеки);
		// Адрес страницы несет версию библиотеки (?v=), поэтому файл можно кешировать надолго.
		Ответ.Заголовки.Вставить("Cache-Control", "private, max-age=604800");
		Возврат Ответ;

	ИначеЕсли Ресурс = "script" Тогда

		СодержимоеСкрипта = ТекстСкрипта();
		Ответ = НовыйОтвет(200, "application/javascript; charset=utf-8", СодержимоеСкрипта);
		// Скрипт меняется с выпуском расширения, а версии в адресе у него нет - браузер перепроверяет его каждый раз.
		Ответ.Заголовки.Вставить("Cache-Control", "no-cache");
		Возврат Ответ;

	Иначе

		ТекстОтказа = НСтр("ru = 'Нет такого ресурса дашборда ошибок.'");
		Ответ = ОтветТекстом(404, ТекстОтказа);
		Возврат Ответ;

	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вхождения окна по хешу ошибки: всего за окно и пары [индекс дня, количество].
Функция ВхожденияПоХешам(Знач Вхождения, Знач ИндексыДней)

	Результат = Новый Соответствие;
	Для Каждого СтрокаВхождений Из Вхождения Цикл
		ДеньВхождения = НачалоДня(СтрокаВхождений.Период);
		ИндексДня = ИндексыДней.Получить(ДеньВхождения);
		Если ИндексДня = Неопределено Или СтрокаВхождений.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Накопление = Результат.Получить(СтрокаВхождений.ХешОшибки);
		Если Накопление = Неопределено Тогда
			Счетчики = Новый Массив;
			Накопление = Новый Структура("Всего, Счетчики", 0, Счетчики);
			Результат.Вставить(СтрокаВхождений.ХешОшибки, Накопление);
		КонецЕсли;

		Пара = Новый Массив;
		Пара.Добавить(ИндексДня);
		Пара.Добавить(СтрокаВхождений.Количество);
		Накопление.Счетчики.Добавить(Пара);
		Накопление.Всего = Накопление.Всего + СтрокаВхождений.Количество;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ошибка модели из строки журнала. Хеш есть в статистике, но нет в журнале - уровень none и пустые тексты.
Функция ОшибкаМодели(Знач СтрокаЖурнала, Знач Счетчики)

	Ошибка = Новый Структура;
	Ошибка.Вставить("level", "none");
	Ошибка.Вставить("object", "");
	Ошибка.Вставить("event", "");
	Ошибка.Вставить("text", "");
	Ошибка.Вставить("ai", "");
	Ошибка.Вставить("ignored", Ложь);
	Ошибка.Вставить("analyzed", Ложь);
	Ошибка.Вставить("telegram", Ложь);
	Ошибка.Вставить("first", "");
	Ошибка.Вставить("last", "");
	Ошибка.Вставить("counts", Счетчики);

	Если СтрокаЖурнала = Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	Ошибка.level = КодУровня(СтрокаЖурнала.Критичность);
	Ошибка.object = СократитьТекст(СтрокаЖурнала.Метаданные, 200);
	Ошибка.event = СократитьТекст(СтрокаЖурнала.Событие, 200);
	Ошибка.text = СократитьТекст(СтрокаЖурнала.ТекстОшибки, 240);
	Ошибка.ai = СократитьТекст(СтрокаЖурнала.ОписаниеОтИИ, 600);
	Ошибка.ignored = СтрокаЖурнала.Игнорировать = Истина;
	Ошибка.analyzed = СтрокаЖурнала.ПроанализированаИИ = Истина;
	Ошибка.telegram = СтрокаЖурнала.ОтправленаВТелеграм = Истина;
	Ошибка.first = МоментДляСтраницы(СтрокаЖурнала.ПерваяДатаВремя);
	Ошибка.last = МоментДляСтраницы(СтрокаЖурнала.ПоследнееВхождение);
	Возврат Ошибка;

КонецФункции

// Код уровня критичности для страницы; пустая или неизвестная критичность - none (ошибка еще не оценена).
Функция КодУровня(Знач Критичность)

	Если Критичность = Перечисления.КИИ_УровниКритичности.Критическая Тогда
		Возврат "crit";
	ИначеЕсли Критичность = Перечисления.КИИ_УровниКритичности.Высокая Тогда
		Возврат "high";
	ИначеЕсли Критичность = Перечисления.КИИ_УровниКритичности.Средняя Тогда
		Возврат "mid";
	ИначеЕсли Критичность = Перечисления.КИИ_УровниКритичности.Низкая Тогда
		Возврат "low";
	Иначе
		Возврат "none";
	КонецЕсли;

КонецФункции

// Расходы по дням окна: тройки [индекс дня, токенов, стоимость] в порядке дней.
Функция РасходыПоДням(Знач Расходы, Знач ИндексыДней)

	Токены = Новый Соответствие;
	Стоимости = Новый Соответствие;
	Для Каждого СтрокаРасходов Из Расходы Цикл
		ДеньРасходов = НачалоДня(СтрокаРасходов.День);
		ИндексДня = ИндексыДней.Получить(ДеньРасходов);
		Если ИндексДня = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НакопленныеТокены = Токены.Получить(ИндексДня);
		ТокеныДоСтроки = ЧислоИлиНоль(НакопленныеТокены);
		ТокеныСтроки = ЧислоИлиНоль(СтрокаРасходов.Токены);
		ВсегоТокенов = ТокеныДоСтроки + ТокеныСтроки;
		Токены.Вставить(ИндексДня, ВсегоТокенов);
		НакопленнаяСтоимость = Стоимости.Получить(ИндексДня);
		СтоимостьДоСтроки = ЧислоИлиНоль(НакопленнаяСтоимость);
		СтоимостьСтроки = ЧислоИлиНоль(СтрокаРасходов.Стоимость);
		ОбщаяСтоимость = СтоимостьДоСтроки + СтоимостьСтроки;
		Стоимости.Вставить(ИндексДня, ОбщаяСтоимость);
	КонецЦикла;

	Результат = Новый Массив;
	Для ИндексДня = 0 По ИндексыДней.Количество() - 1 Цикл
		ТокеныДня = Токены.Получить(ИндексДня);
		Если ТокеныДня = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Тройка = Новый Массив;
		Тройка.Добавить(ИндексДня);
		Тройка.Добавить(ТокеныДня);
		СтоимостьДня = Стоимости.Получить(ИндексДня);
		ОкругленнаяСтоимость = Окр(СтоимостьДня, 4);
		Тройка.Добавить(ОкругленнаяСтоимость);
		Результат.Добавить(Тройка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЧислоИлиНоль(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Момент для страницы в формате ГГГГ-ММ-ДДTЧЧ:ММ; пустая дата - пустая строка.
Функция МоментДляСтраницы(Знач Момент)

	Если ТипЗнч(Момент) <> Тип("Дата") Или Не ЗначениеЗаполнено(Момент) Тогда
		Возврат "";
	КонецЕсли;

	ПредставлениеДня = Формат(Момент, "ДФ=yyyy-MM-dd");
	ПредставлениеВремени = Формат(Момент, "ДФ=HH:mm");
	Результат = СтрШаблон("%1T%2", ПредставлениеДня, ПредставлениеВремени);
	Возврат Результат;

КонецФункции

Функция СократитьТекст(Знач Текст, Знач МаксимальнаяДлина)

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Текст = СокрЛП(Текст);
	Если СтрДлина(Текст) <= МаксимальнаяДлина Тогда
		Возврат Текст;
	КонецЕсли;

	СокращенныйТекст = Лев(Текст, МаксимальнаяДлина - 1);
	Результат = СокращенныйТекст + "…";
	Возврат Результат;

КонецФункции

// JSON данных страницы (модель и текст глубокого анализа под ключом deep) для вставки внутрь
// <script type="application/json">. Символы «<», «>» и «&» записываются JSON-последовательностями
// «обратная косая черта + u003c, u003e, u0026»: JSON.parse вернет исходный текст, а закрыть тег script
// текстом ошибки нельзя. Обратная косая черта - Символ(92): так последовательность не превратится
// обратно в символ ни при какой обработке исходного текста модуля.
Функция ДанныеДляСтраницы(Знач Модель, Знач ТекстГлубокогоАнализа)

	// Копия модели: у вызывающего она не меняется, результат глубокого анализа живет только в данных страницы.
	Данные = Новый Структура;
	Для Каждого Поле Из Модель Цикл
		Данные.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	ПредставлениеГлубокогоАнализа = Строка(ТекстГлубокогоАнализа);
	Данные.Вставить("deep", ПредставлениеГлубокогоАнализа);

	ЗаписьДанных = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьДанных.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьДанных, Данные);
	ТекстДанных = ЗаписьДанных.Закрыть();

	ОбратнаяКосаяЧерта = Символ(92);
	ЭкранированныйАмперсанд = ОбратнаяКосаяЧерта + "u0026";
	ТекстДанных = СтрЗаменить(ТекстДанных, "&", ЭкранированныйАмперсанд);
	ЭкранированнаяЛеваяСкобка = ОбратнаяКосаяЧерта + "u003c";
	ТекстДанных = СтрЗаменить(ТекстДанных, "<", ЭкранированнаяЛеваяСкобка);
	ЭкранированнаяПраваяСкобка = ОбратнаяКосаяЧерта + "u003e";
	ТекстДанных = СтрЗаменить(ТекстДанных, ">", ЭкранированнаяПраваяСкобка);
	Возврат ТекстДанных;

КонецФункции

Функция ТекстБиблиотеки()

	ДвоичныеДанныеБиблиотеки = Обработки.КИИ_ДашбордОшибок.ПолучитьМакет("echarts_js");
	СодержимоеБиблиотеки = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеБиблиотеки, КодировкаТекста.UTF8);
	Возврат СодержимоеБиблиотеки;

КонецФункции

Функция ТекстСкрипта()

	МакетСкрипта = Обработки.КИИ_ДашбордОшибок.ПолучитьМакет("СкриптДашборда");
	СодержимоеСкрипта = МакетСкрипта.ПолучитьТекст();
	Возврат СодержимоеСкрипта;

КонецФункции

// Версия ECharts из макета echarts_js: входит в адрес библиотеки, чтобы после обновления библиотеки браузер
// не взял старый файл из кеша.
Функция ВерсияECharts()

	Возврат "6.1.0";

КонецФункции

// Политика для веб-страницы: скрипты только файлами того же сервиса (данные - неисполняемый JSON),
// стили встроенные, внешние запросы, формы и встраивание на чужие сайты запрещены.
Функция ПолитикаБезопасностиСодержимого()

	Политика = "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src data:; "
		+ "base-uri 'none'; form-action 'none'; frame-ancestors 'self'";
	Возврат Политика;

КонецФункции

Функция ЭкранироватьАтрибут(Знач Текст)

	ПредставлениеТекста = Строка(Текст);
	Результат = СтрЗаменить(ПредставлениеТекста, "&", "&amp;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат Результат;

КонецФункции

Функция БазовыйАдресБезСлеша(Знач БазовыйАдрес)

	ПредставлениеАдреса = Строка(БазовыйАдрес);
	Адрес = СокрЛП(ПредставлениеАдреса);
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		ДлинаБезСлеша = СтрДлина(Адрес) - 1;
		Адрес = Лев(Адрес, ДлинаБезСлеша);
	КонецЦикла;
	Возврат Адрес;

КонецФункции

Функция ЗначениеПараметраЗапроса(Знач ПараметрыЗапроса, Знач ИмяПараметра)

	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Соответствие")
		И ТипЗнч(ПараметрыЗапроса) <> Тип("ФиксированноеСоответствие") Тогда
		Возврат "";
	КонецЕсли;

	Значение = ПараметрыЗапроса.Получить(ИмяПараметра);
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	ЗначениеБезПробелов = СокрЛП(Значение);
	Результат = НРег(ЗначениеБезПробелов);
	Возврат Результат;

КонецФункции

// Период из параметра days: 7 или 90, иначе 30. Строки сравниваются без преобразования в число.
Функция ПериодИзПараметра(Знач ЗначениеПараметра)

	Если ЗначениеПараметра = "7" Тогда
		Возврат 7;
	ИначеЕсли ЗначениеПараметра = "90" Тогда
		Возврат 90;
	Иначе
		Возврат 30;
	КонецЕсли;

КонецФункции

Функция НовыйОтвет(Знач КодСостояния, Знач ТипСодержимого, Знач Тело)

	Ответ = Новый Структура;
	Ответ.Вставить("КодСостояния", КодСостояния);
	Заголовки = Новый Соответствие;
	Ответ.Вставить("Заголовки", Заголовки);
	Ответ.Вставить("Тело", Тело);
	Ответ.Заголовки.Вставить("Content-Type", ТипСодержимого);
	Ответ.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
	Возврат Ответ;

КонецФункции

Функция ОтветТекстом(Знач КодСостояния, Знач Текст)

	Ответ = НовыйОтвет(КодСостояния, "text/plain; charset=utf-8", Текст);
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Возврат Ответ;

КонецФункции

#КонецОбласти

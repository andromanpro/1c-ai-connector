#Область ПрограммныйИнтерфейс

// Возвращает доступные текущему пользователю активные источники без адресов и реквизитов входа.
// Возвращаемое значение:
//  Массив из Структура:
//   * database_id - Строка - постоянный ID центрального подключения.
//   * database_name - Строка - понятное имя источника.
//   * description - Строка - назначение базы.
//   * configuration_name - Строка - проверенная конфигурация.
//   * configuration_version - Строка - проверенная версия.
Функция ДоступныеБазы() Экспорт
	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Подключения.Ссылка КАК Ссылка,
		| Подключения.Наименование КАК Наименование,
		| Подключения.Описание КАК Описание,
		| Подключения.ИмяКонфигурации КАК ИмяКонфигурации,
		| Подключения.ВерсияКонфигурации КАК ВерсияКонфигурации
		|  ИЗ Справочник.КИИ_ПодключенияКБазам КАК Подключения
		|ГДЕ Подключения.Используется
		| И НЕ Подключения.ПометкаУдаления
		| И Подключения.ИдентификаторБазы <> """"
		|УПОРЯДОЧИТЬ ПО Подключения.Наименование, Подключения.Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура;
		Описание.Вставить("database_id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Описание.Вставить("database_name", Выборка.Наименование);
		Описание.Вставить("description", Выборка.Описание);
		Описание.Вставить("configuration_name", Выборка.ИмяКонфигурации);
		Описание.Вставить("configuration_version", Выборка.ВерсияКонфигурации);
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает состояние собственного входа. Сохранённый пароль не возвращается.
// Параметры:
//  Подключение - СправочникСсылка.КИИ_ПодключенияКБазам - доступное подключение.
// Возвращаемое значение:
//  Структура:
//   * ЛичныйВход - Булево - требуется собственный вход пользователя.
//   * Логин - Строка - пользователь целевой базы.
//   * ПарольСохранен - Булево - реквизиты сохранены, включая допустимый пустой пароль.
Функция СостояниеВхода(Подключение) Экспорт
	Настройки = НастройкиПодключения(Подключение);
	Если Настройки.ЛичныйВход Тогда
		Личные = ЛичныеНастройки(Подключение);
		Возврат Новый Структура("ЛичныйВход, Логин, ПарольСохранен", Истина, Личные.Логин, Личные.ПарольСохранен);
	КонецЕсли;
	Возврат Новый Структура(
		"ЛичныйВход, Логин, ПарольСохранен",
		Ложь,
		Настройки.Пользователь,
		ПрочитатьПарольБСП(Подключение) <> Неопределено);
КонецФункции

// Изменяет только служебный пароль доступного подключения при наличии права настройки.
// Параметры:
//  Подключение - СправочникСсылка.КИИ_ПодключенияКБазам - записанная настройка.
//  НовыйПароль - Строка - новое значение, используется только при действии Заменить.
//  Действие - Строка - НеИзменять, Заменить или Удалить.
Процедура СохранитьСлужебныйПароль(Подключение, Знач НовыйПароль, Знач Действие = "НеИзменять") Экспорт
	ПроверитьПравоНастройки();
	Настройки = НастройкиПодключения(Подключение);
	Если Настройки.ЛичныйВход Тогда
		ВызватьИсключение НСтр("ru = 'Для этого подключения используются личные реквизиты входа.'");
	КонецЕсли;
	ИзменитьПарольБСП(Подключение, НовыйПароль, Действие);
КонецПроцедуры

// Сохраняет личные реквизиты только вошедшего пользователя, без перехода на служебный вход.
// Параметры:
//  Подключение - СправочникСсылка.КИИ_ПодключенияКБазам - доступная настройка личного входа.
//  Логин - Строка - имя собственного пользователя целевой базы.
//  НовыйПароль - Строка - новое значение, используется только при действии Заменить.
//  Действие - Строка - НеИзменять, Заменить или Удалить.
Процедура СохранитьЛичныйВход(Подключение, Знач Логин, Знач НовыйПароль, Знач Действие = "НеИзменять") Экспорт
	Настройки = НастройкиПодключения(Подключение);
	Если Не Настройки.ЛичныйВход Тогда
		ВызватьИсключение НСтр("ru = 'Для этого подключения используется служебный вход.'");
	КонецЕсли;
	Пользователь = Пользователи.ТекущийПользователь();
	ПроверитьДействиеПароля(Действие);
	Если Действие <> "Удалить" Тогда
		ПроверитьЛогин(Логин);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Запись = РегистрыСведений.КИИ_ЛичныеПодключенияКБазам.СоздатьМенеджерЗаписи();
		Запись.Подключение = Подключение;
		Запись.Пользователь = Пользователь;
		Запись.Прочитать();
		// Ненайденная запись очищает ключи менеджера; восстановить их перед записью.
		Запись.Подключение = Подключение;
		Запись.Пользователь = Пользователь;
		Если Запись.Логин <> Логин И Действие = "НеИзменять" Тогда
			ВызватьИсключение НСтр("ru = 'При изменении логина введите пароль заново.'");
		КонецЕсли;
		Владелец = ВладелецЛичногоПароля(Подключение, Пользователь);
		ИзменитьПарольБСП(Владелец, НовыйПароль, Действие);
		Если Действие = "Удалить" Тогда
			Запись.Удалить();
		Иначе
			Запись.Логин = Логин;
			Запись.ПарольСохранен = ПрочитатьПарольБСП(Владелец) <> Неопределено;
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Проверяет реальный сеанс целевой базы. Администратор первоначально закрепляет её ID.
// Параметры:
//  Подключение - СправочникСсылка.КИИ_ПодключенияКБазам - записанная настройка.
// Возвращаемое значение:
//  Структура - результат проверки без пароля и служебного имени сеанса:
//   * ИдентификаторБазы - Строка - подтверждённый ID целевой базы.
//   * Конфигурация - Строка - конфигурация целевой базы.
//   * Версия - Строка - версия конфигурации.
Функция ПроверитьПодключение(Подключение) Экспорт
	Настройки = НастройкиПодключения(Подключение);
	МожноНастраивать = ПравоДоступа("Изменение", Метаданные.Справочники.КИИ_ПодключенияКБазам);
	Если ПустаяСтрока(Настройки.ИдентификаторБазы) И Не МожноНастраивать Тогда
		ВызватьИсключение НСтр("ru = 'Администратор ещё не проверил целевую базу подключения.'");
	КонецЕсли;
	Соединение = СоединениеДляВыполнения(Подключение, Настройки);
	Сведения = КИИ_УдаленныеБазыMCP.ПроверитьПодключение(Соединение);
	Если МожноНастраивать Тогда
		АктуальныеНастройки = НастройкиПодключения(Подключение);
		Для Каждого Реквизит Из Настройки Цикл
			Если АктуальныеНастройки[Реквизит.Ключ] <> Реквизит.Значение Тогда
				ВызватьИсключение НСтр(
					"ru = 'Настройки изменились во время проверки. Повторите проверку подключения.'");
			КонецЕсли;
		КонецЦикла;
		ОбъектПодключения = Подключение.ПолучитьОбъект();
		ОбъектПодключения.ИдентификаторБазы = Сведения.database_id;
		ОбъектПодключения.ИмяКонфигурации = Сведения.configuration_name;
		ОбъектПодключения.ВерсияКонфигурации = Сведения.configuration_version;
		ОбъектПодключения.ДатаПроверки = ТекущаяДатаСеанса();
		ОбъектПодключения.РезультатПроверки = НСтр("ru = 'Подключение проверено, пользователь сеанса подтверждён.'");
		ОбъектПодключения.Записать();
	КонецЕсли;
	Возврат Новый Структура(
		"ИдентификаторБазы, Конфигурация, Версия",
		Сведения.database_id,
		Сведения.configuration_name,
		Сведения.configuration_version);
КонецФункции

// Выполняет инструмент только в доступном активном подключении с закреплённой базой.
// Параметры:
//  Идентификатор - Строка - UUID записи центрального каталога.
//  ИмяИнструмента - Строка - один из четырёх встроенных инструментов.
//  Аргументы - Структура - аргументы целевого инструмента без database_id.
// Возвращаемое значение:
//  Произвольный - фактический результат целевой базы.
Функция ВыполнитьИнструмент(Знач Идентификатор, Знач ИмяИнструмента, Аргументы) Экспорт
	Если КИИ_АгентАнализа.ИнструментыПоУмолчанию().Найти(ИмяИнструмента) = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Инструмент не разрешён для подключённых баз.'");
	КонецЕсли;
	Подключение = СсылкаПоИдентификатору(Идентификатор);
	Настройки = НастройкиПодключения(Подключение);
	Если Не Настройки.Используется Или ПустаяСтрока(Настройки.ИдентификаторБазы) Тогда
		ВызватьИсключение НСтр("ru = 'Подключение отключено или ещё не проверено администратором.'");
	КонецЕсли;
	Соединение = СоединениеДляВыполнения(Подключение, Настройки);
	Возврат КИИ_УдаленныеБазыMCP.ВыполнитьИнструмент(Соединение, ИмяИнструмента, Аргументы);
КонецФункции

// Проверяет и нормализует сохраняемую настройку. Смена адреса сбрасывает закреплённую базу.
// Параметры:
//  ОбъектПодключения - СправочникОбъект.КИИ_ПодключенияКБазам - записываемая настройка.
Процедура ПередЗаписьюПодключения(ОбъектПодключения) Экспорт
	ПроверитьПравоНастройки();
	Если ОбъектПодключения.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если ОбъектПодключения.Таймаут = 0 Тогда
		ОбъектПодключения.Таймаут = 60;
	КонецЕсли;
	Если Не ПустаяСтрока(ОбъектПодключения.Адрес) Тогда
		КИИ_УдаленныеБазыMCP.ПроверитьАдрес(ОбъектПодключения.Адрес);
	КонецЕсли;
	Если ОбъектПодключения.Таймаут < 0 Тогда
		ВызватьИсключение НСтр("ru = 'Таймаут подключения должен быть положительным.'");
	КонецЕсли;
	Если ОбъектПодключения.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Прежние = ОбъектПодключения.Ссылка.ПолучитьОбъект();
	Если Прежние.Адрес <> ОбъектПодключения.Адрес
		Или Прежние.Пользователь <> ОбъектПодключения.Пользователь
		Или Прежние.ЛичныйВход <> ОбъектПодключения.ЛичныйВход Тогда
		ОбъектПодключения.ИдентификаторБазы = "";
		ОбъектПодключения.ДатаПроверки = Дата(1, 1, 1);
		ОбъектПодключения.РезультатПроверки = НСтр("ru = 'Настройки изменены, проверьте подключение заново.'");
		Если Прежние.Пользователь <> ОбъектПодключения.Пользователь
			Или Прежние.ЛичныйВход <> ОбъектПодключения.ЛичныйВход Тогда
			ИзменитьПарольБСП(ОбъектПодключения.Ссылка, "", "Удалить");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Удаляет только реквизиты удаляемого подключения в той же транзакции.
// Параметры:
//  Подключение - СправочникСсылка.КИИ_ПодключенияКБазам - удаляемая настройка.
Процедура ПередУдалениемПодключения(Подключение) Экспорт
	Если Не ПравоДоступа("Удаление", Метаданные.Справочники.КИИ_ПодключенияКБазам) Тогда
		ВызватьИсключение НСтр("ru = 'Нет права удаления подключения.'");
	КонецЕсли;
	НастройкиПодключения(Подключение);
	Запрос = Новый Запрос("ВЫБРАТЬ Пользователь КАК Пользователь
		|  ИЗ РегистрСведений.КИИ_ЛичныеПодключенияКБазам
		|ГДЕ Подключение = &Подключение");
	Запрос.УстановитьПараметр("Подключение", Подключение);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИзменитьПарольБСП(ВладелецЛичногоПароля(Подключение, Выборка.Пользователь), "", "Удалить");
	КонецЦикла;
	Набор = РегистрыСведений.КИИ_ЛичныеПодключенияКБазам.СоздатьНаборЗаписей();
	Набор.Отбор.Подключение.Установить(Подключение);
	Набор.Записать();
	ИзменитьПарольБСП(Подключение, "", "Удалить");
КонецПроцедуры

// Проверяет подключение в длительной операции формы без возврата реквизитов входа.
// Параметры:
//  Подключение - СправочникСсылка.КИИ_ПодключенияКБазам - проверяемое подключение.
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - проверка завершилась успешно.
//   * Текст - Строка - сведения о базе или безопасная причина отказа.
Функция ПроверитьПодключениеДляФормы(Подключение) Экспорт
	Попытка
		Сведения = ПроверитьПодключение(Подключение);
		Текст = СтрШаблон(НСтр("ru = 'Подключение проверено: %1, версия %2.'"), Сведения.Конфигурация, Сведения.Версия);
		Возврат Новый Структура("Успех, Текст", Истина, Текст);
	Исключение
		Возврат Новый Структура("Успех, Текст", Ложь, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает доступное пользователю подключение без сохранённых паролей.
// Параметры:
//  Подключение - СправочникСсылка.КИИ_ПодключенияКБазам - записанная настройка.
// Возвращаемое значение:
//  Структура:
//   * Адрес - Строка - адрес публикации.
//   * Используется - Булево - подключение включено.
//   * ЛичныйВход - Булево - используется вход текущего пользователя.
//   * Пользователь - Строка - логин служебного пользователя.
//   * Таймаут - Число - время ожидания HTTP.
//   * ИдентификаторБазы - Строка - закреплённый UUID целевой базы.
Функция НастройкиПодключения(Подключение)
	Если ТипЗнч(Подключение) <> Тип("СправочникСсылка.КИИ_ПодключенияКБазам") Тогда
		ВызватьИсключение НСтр("ru = 'Недопустимое подключение к базе.'");
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Адрес КАК Адрес, Используется КАК Используется, ЛичныйВход КАК ЛичныйВход,
		| Пользователь КАК Пользователь, Таймаут КАК Таймаут, ИдентификаторБазы КАК ИдентификаторБазы
		|  ИЗ Справочник.КИИ_ПодключенияКБазам
		|ГДЕ Ссылка = &Подключение И НЕ ПометкаУдаления";
	Запрос.УстановитьПараметр("Подключение", Подключение);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Подключение отсутствует или недоступно текущему пользователю.'");
	КонецЕсли;
	Результат = Новый Структура;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Результат.Вставить(Колонка.Имя, Таблица[0][Колонка.Имя]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЛичныеНастройки(Подключение)
	Запись = РегистрыСведений.КИИ_ЛичныеПодключенияКБазам.СоздатьМенеджерЗаписи();
	Запись.Подключение = Подключение;
	Запись.Пользователь = Пользователи.ТекущийПользователь();
	Запись.Прочитать();
	Возврат Новый Структура("Логин, ПарольСохранен", Запись.Логин, Запись.ПарольСохранен);
КонецФункции

Функция СоединениеДляВыполнения(Подключение, Настройки)
	Логин = Настройки.Пользователь;
	Владелец = Подключение;
	Если Настройки.ЛичныйВход Тогда
		Личные = ЛичныеНастройки(Подключение);
		Логин = Личные.Логин;
		Владелец = ВладелецЛичногоПароля(Подключение, Пользователи.ТекущийПользователь());
	КонецЕсли;
	ПроверитьЛогин(Логин);
	Пароль = ПрочитатьПарольБСП(Владелец);
	Если Пароль = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Сохраните реквизиты входа в целевую базу.'");
	КонецЕсли;
	СтруктураЗначений = Новый Структура;
	СтруктураЗначений.Вставить("Адрес", Настройки.Адрес);
	СтруктураЗначений.Вставить("Пользователь", Логин);
	СтруктураЗначений.Вставить("Пароль", Пароль);
	СтруктураЗначений.Вставить("Таймаут", Настройки.Таймаут);
	СтруктураЗначений.Вставить("ИдентификаторБазы", Настройки.ИдентификаторБазы);
	Возврат СтруктураЗначений;
КонецФункции

Функция СсылкаПоИдентификатору(Знач Идентификатор)
	Попытка
		UUID = Новый УникальныйИдентификатор(Идентификатор);
	Исключение
		ВызватьИсключение НСтр("ru = 'Недопустимый идентификатор подключения.'");
	КонецПопытки;
	Возврат Справочники.КИИ_ПодключенияКБазам.ПолучитьСсылку(UUID);
КонецФункции

Функция ВладелецЛичногоПароля(Подключение, Пользователь)
	Возврат "КИИ_Базы."
		+ Строка(Подключение.УникальныйИдентификатор())
		+ "."
		+ Строка(Пользователь.УникальныйИдентификатор());
КонецФункции

Процедура ПроверитьПравоНастройки()
	Если Не ПравоДоступа("Изменение", Метаданные.Справочники.КИИ_ПодключенияКБазам) Тогда
		ВызватьИсключение НСтр("ru = 'Нет права настройки подключений к базам.'");
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЛогин(Знач Логин)
	Если ПустаяСтрока(Логин) Или СтрНайти(Логин, ":") > 0 Тогда
		ВызватьИсключение НСтр("ru = 'Укажите имя пользователя целевой базы 1С.'");
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДействиеПароля(Знач Действие)
	Если Действие <> "НеИзменять" И Действие <> "Заменить" И Действие <> "Удалить" Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестное действие с паролем подключения.'");
	КонецЕсли;
КонецПроцедуры

Функция ПрочитатьПарольБСП(Владелец)
	// Закрытый метод: владелец вычислен выше после проверки доступа и личности сеанса.
	// Привилегированный режим действует только во время штатного обращения к хранилищу БСП.
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Владелец);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Пароль;
КонецФункции

Процедура ИзменитьПарольБСП(Владелец, Знач НовыйПароль, Знач Действие)
	ПроверитьДействиеПароля(Действие);
	Если Действие = "НеИзменять" Тогда
		Возврат;
	КонецЕсли;
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Если Действие = "Удалить" Тогда
			ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(Владелец);
		Иначе
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Владелец, НовыйПароль);
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Декларация tools для container-pattern.
// Вызывается из КИИ_СерверMCPРеестр.ПолучитьРеестрИнструментов() через рефлексию.
//
// Параметры:
//  Таблица - ТаблицаЗначений - реестр инструментов (см. КИИ_СерверMCPРеестр):
//   * Имя - Строка - имя инструмента
//   * Описание - Строка - человекочитаемое описание
//   * Схема - Структура - JSON-схема аргументов инструмента
//
Процедура ДобавитьИнструменты(Таблица) Экспорт
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Имя = "ping";
	НоваяСтрока.Описание = НСтр(
		"ru = 'Smoke health-check инструмент. Возвращает {pong: true} для проверки доступности MCP-сервиса.'");
	НоваяСтрока.Схема = Новый Структура("type, properties, additionalProperties", "object", Новый Структура, Ложь);
	
КонецПроцедуры

// Выполнение инструмента ping.
//
// Параметры:
//  ИмяИнструмента - Строка - всегда "ping" в этом ОМ
//  Аргументы      - Структура - игнорируется
//
// Возвращаемое значение:
//  Структура - результат ping:
//   * ok - Булево - всегда Истина
//   * pong - Булево - всегда Истина
//   * timestamp - Строка - текущее UTC в формате ISO 8601
//
Функция ВыполнитьИнструмент(Знач ИмяИнструмента, Знач Аргументы) Экспорт
	
	Если ИмяИнструмента <> "ping" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Неподдерживаемый инструмент %1 для модуля КИИ_СерверMCPИнструментPing'"),
			ИмяИнструмента);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("pong", Истина);
	Результат.Вставить("timestamp", Формат(ТекущаяУниверсальнаяДата(), "ДФ='yyyy-MM-ddTHH:mm:ssZ'"));
	Возврат Результат;
	
КонецФункции

#КонецОбласти

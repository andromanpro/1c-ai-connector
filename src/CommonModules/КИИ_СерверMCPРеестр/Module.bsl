#Область ПрограммныйИнтерфейс

// Возвращает таблицу зарегистрированных инструментов из подсистемы КИИ_СерверMCPИнструменты.
// Кеш не используем (Phase 1 простой); если будет горячая точка - добавим *ПовтИсп.
//
// Возвращаемое значение:
//  ТаблицаЗначений - реестр инструментов, колонки:
//    * Имя       - Строка - MCP tool name
//    * Описание  - Строка - human-readable description
//    * Схема     - Структура - JSON-schema аргументов (или пустая)
//    * ИмяМодуля - Строка - имя ОМ-контейнера
//
Функция ПолучитьРеестрИнструментов() Экспорт

	Перем РезультатПолноеИмя;
	
	Реестр = НовыйТаблицаРеестра();
	
	Состав = Метаданные.Подсистемы.КИИ_СерверMCPИнструменты.Состав;
	Для Каждого ОбъектМетаданных Из Состав Цикл
		
		РезультатПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Если Не СтрНачинаетсяС(РезультатПолноеИмя, "ОбщийМодуль.") Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяМодуля = ОбъектМетаданных.Имя;
		Модуль = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
		ТаблицаИнструментов = НовыйТаблицаРеестра();
		Модуль.ДобавитьИнструменты(ТаблицаИнструментов);
		
		Для Каждого ЗаписьИнструмента Из ТаблицаИнструментов Цикл
			НоваяЗапись = Реестр.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ЗаписьИнструмента);
			НоваяЗапись.ИмяМодуля = ИмяМодуля;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Реестр;
	
КонецФункции

// Выполняет инструмент по имени. Делегирует ВыполнитьИнструмент конкретного ОМ-контейнера.
//
// Параметры:
//  ИмяИнструмента - Строка
//  Аргументы      - Структура, Соответствие из КлючИЗначение - аргументы инструмента
//
// Возвращаемое значение:
//  Произвольный - данные результата (структурированный JSON-объект или примитив)
//
// Исключения:
//  Инструмент не найден - если ИмяИнструмента не зарегистрирован.
//
Функция ВыполнитьИнструмент(Знач ИмяИнструмента, Знач Аргументы) Экспорт

	Перем РезультатФункции;
	
	Реестр = ПолучитьРеестрИнструментов();
	Поиск = Реестр.Найти(ИмяИнструмента, "Имя");
	Если Поиск = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Инструмент %1 не зарегистрирован в реестре'"), ИмяИнструмента);
	КонецЕсли;
	
	Модуль = ОбщегоНазначения.ОбщийМодуль(Поиск.ИмяМодуля);
	РезультатФункции = Модуль.ВыполнитьИнструмент(ИмяИнструмента, Аргументы);
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйТаблицаРеестра()

	Перем ТипЗначения;
	
	Таблица = Новый ТаблицаЗначений;
	ТипЗначения = Новый ОписаниеТипов("Строка");
	Таблица.Колонки.Добавить("Имя", ТипЗначения);
	ТипЗначения = Новый ОписаниеТипов("Строка");
	Таблица.Колонки.Добавить("Описание", ТипЗначения);
	Таблица.Колонки.Добавить("Схема");
	ТипЗначения = Новый ОписаниеТипов("Строка");
	Таблица.Колонки.Добавить("ИмяМодуля", ТипЗначения);
	Возврат Таблица;
	
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает копию параметров с заменой значений sensitive-полей на <redacted>.
// Рекурсивно обходит вложенные структуры, соответствия и массивы.
//
// Параметры:
//  Параметры - Структура, Соответствие из КлючИЗначение, Произвольный - входные данные
//
// Возвращаемое значение:
//  Произвольный - копия с замененными значениями
//
Функция СкрытьСекретыВПараметрах(Знач Параметры) Экспорт
	
	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипПараметров = ТипЗнч(Параметры);
	
	Если ТипПараметров = Тип("Структура") Тогда
		Возврат ОбработатьСтруктуру(Параметры);
	КонецЕсли;
	
	Если ТипПараметров = Тип("Соответствие") Тогда
		Возврат ОбработатьСоответствие(Параметры);
	КонецЕсли;
	
	Если ТипПараметров = Тип("Массив") Тогда
		Возврат ОбработатьМассив(Параметры);
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбработатьСтруктуру(Знач Параметры)
	
	Результат = Новый Структура;
	
	Для Каждого КлючИЗначение Из Параметры Цикл
		
		Если ИмяСекретное(КлючИЗначение.Ключ) Тогда
			Результат.Вставить(КлючИЗначение.Ключ, "<redacted>");
		Иначе
			Значение = СкрытьСекретыВПараметрах(КлючИЗначение.Значение);
			Результат.Вставить(КлючИЗначение.Ключ, Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОбработатьСоответствие(Знач Параметры)
	
	Результат = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из Параметры Цикл
		
		Если ИмяСекретное(КлючИЗначение.Ключ) Тогда
			Результат.Вставить(КлючИЗначение.Ключ, "<redacted>");
		Иначе
			Значение = СкрытьСекретыВПараметрах(КлючИЗначение.Значение);
			Результат.Вставить(КлючИЗначение.Ключ, Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОбработатьМассив(Знач Параметры)
	
	Результат = Новый Массив;
	
	Для Каждого ЗначениеПараметра Из Параметры Цикл
		Результат.Добавить(СкрытьСекретыВПараметрах(ЗначениеПараметра));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяСекретное(Знач Имя)

	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	// Нормализуем: нижний регистр + убираем разделители (_ - . пробел), чтобы
	// api_key / apiKey / access-key приводились к одной форме.
	Нормализованное = НормализоватьИмя(Имя);

	// Короткие неоднозначные маркеры (key, ключ) - только ТОЧНОЕ совпадение, иначе
	// редактируются бизнес-поля вроде primary_key / Заключение / Ключевое.
	Для Каждого Маркер Из ТочныеМаркеры() Цикл
		Если Нормализованное = Маркер Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	// Однозначно секретные маркеры - по подстроке (access_token, myApiKey, ...).
	Для Каждого Маркер Из ПодстрочныеМаркеры() Цикл
		Если СтрНайти(Нормализованное, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НормализоватьИмя(Знач Имя)

	Результат = НРег(Имя);
	Результат = СтрЗаменить(Результат, "_", "");
	Результат = СтрЗаменить(Результат, "-", "");
	Результат = СтрЗаменить(Результат, ".", "");
	Результат = СтрЗаменить(Результат, " ", "");
	Возврат Результат;

КонецФункции

Функция ТочныеМаркеры()

	Маркеры = Новый Массив;
	Маркеры.Добавить("key");
	Маркеры.Добавить("apikey");
	Маркеры.Добавить("ключ");
	Возврат Маркеры;

КонецФункции

Функция ПодстрочныеМаркеры()

	Маркеры = Новый Массив;
	Маркеры.Добавить("password");
	Маркеры.Добавить("passwd");
	Маркеры.Добавить("pwd");
	Маркеры.Добавить("secret");
	Маркеры.Добавить("token");
	Маркеры.Добавить("authorization");
	Маркеры.Добавить("apikey");
	Маркеры.Добавить("accesskey");
	Маркеры.Добавить("secretkey");
	Маркеры.Добавить("privatekey");
	Маркеры.Добавить("clientkey");
	Маркеры.Добавить("clientsecret");
	Маркеры.Добавить("bearer");
	Маркеры.Добавить("credential");
	Маркеры.Добавить("парол");
	Маркеры.Добавить("секрет");
	Маркеры.Добавить("токен");
	// Доп. распространенные имена секретов (аудит P2): session/cookie/signature/otp/jwt.
	// "auth" НЕ добавляем: это чаще имя контейнера (напр. auth={api_token,login}), редактирование
	// целиком ломало бы рекурсию; auth-секреты уже ловятся маркером "authorization".
	Маркеры.Добавить("session");
	Маркеры.Добавить("cookie");
	Маркеры.Добавить("signature");
	Маркеры.Добавить("otp");
	Маркеры.Добавить("jwt");
	Возврат Маркеры;

КонецФункции

#КонецОбласти

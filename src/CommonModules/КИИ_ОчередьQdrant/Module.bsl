#Область ПрограммныйИнтерфейс

// Параметры ограниченного прохода очереди.
// Возвращаемое значение:
//  Структура:
//   * РазмерПакета - Число - от 1 до 64, по умолчанию 32.
//   * КоличествоИсполнителей - Число - от 1 до 4, в файловой базе используется 1.
//   * КодМодели - Строка - пустая строка обрабатывает все модели, иначе только выбранную.
Функция ПараметрыОбработки() Экспорт

	Перем РезультатМаксимумИсполнителей;
	Перем РезультатФункции;
	РезультатМаксимумИсполнителей = МаксимумИсполнителей();
	РезультатФункции = Новый Структура(
		"РазмерПакета, КоличествоИсполнителей, КодМодели", 32, РезультатМаксимумИсполнителей, "");
	Возврат РезультатФункции;
КонецФункции

// Обрабатывает не более 256 снимков очереди. HTTP выполняется вне транзакций.
// Параметры:
//  Параметры - Структура, Неопределено - см. ПараметрыОбработки.
// Возвращаемое значение:
//  Структура:
//   * Выбрано - Число - получено под исключительное владение.
//   * Подтверждено - Число - подтверждено отправленных версий.
//   * Ошибок - Число - ошибочных версий.
//   * Пропущено - Число - чужих или изменившихся версий.
//   * Пакетов - Число - выполнено HTTP-запросов записи.
Функция Обработать(Знач Параметры = Неопределено) Экспорт

	Перем ТекстСообщения;
	Перем ТекстСообщения2;

	Перем РезультатФункции;
	ПроверитьОтсутствиеТранзакции();
	Настройки = ПроверенныеПараметры(Параметры);
	Итог = НовыйИтог();
	Если Не КИИ_RAGQdrant.QdrantДоступен() Тогда
		ТекстСообщения = НСтр("ru = 'КИИ.RAGQdrant.Очередь'");
		ТекстСообщения2 = НСтр("ru = 'Qdrant недоступен; обработка очереди отложена'");
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Предупреждение, , , ТекстСообщения2);
		Возврат Итог;
	КонецЕсли;
	ПроверитьУсловнуюЗапись();
	ОбновитьСтарыеЗаписи();
	Элементы = ВыбратьВерсионированнуюОчередь(Настройки.КодМодели);
	Если Элементы.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Или Настройки.КоличествоИсполнителей = 1 Тогда
		РезультатФункции = ОбработатьПорциюИсполнителя(Элементы, Настройки);
		Возврат РезультатФункции;
	КонецЕсли;
	РезультатФункции = ВыполнитьЧерезБСП(Элементы, Настройки);
	Возврат РезультатФункции;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Сохраняет новую версию атомарно с записью очереди и транзакцией фрагмента.
// Параметры:
//  ФрагментUUID - Строка - идентификатор фрагмента.
//  КодМодели - Строка - код модели индекса.
//  Операция - Строка - upsert или delete.
//  Хеш - Строка - хеш текста для upsert.
// Возвращаемое значение:
//  Структура:
//   * ФрагментИдентификатор - Строка - идентификатор фрагмента.
//   * КодМодели - Строка - код модели.
//   * Операция - Строка - upsert или delete.
//   * Хеш - Строка - хеш текста.
//   * Попыток - Число - число отказов.
//   * НомерПоПорядку - Число - порядковый номер.
//   * Версия - Число - постоянная версия.
//   * Раздел - Число - фиксированный раздел.
Функция Поставить(Знач ФрагментUUID, Знач КодМодели, Знач Операция, Знач Хеш = "") Экспорт

	Перем РезультатТекущаяУниверсальнаяДатаВМиллисекундах;

	Перем ЗначениеБезПробелов;
	ОперацияДопустима = Операция = "upsert" Или Операция = "delete";
	Если ПустаяСтрока(ФрагментUUID) Или ПустаяСтрока(КодМодели) Или Не ОперацияДопустима Тогда
		ВызватьИсключение НСтр("ru = 'Некорректные параметры очереди Qdrant'");
	КонецЕсли;
	ЗначениеБезПробелов = СокрЛП(ФрагментUUID);
	ФрагментUUID = НРег(ЗначениеБезПробелов);
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Блокировка = БлокировкаВерсию(ФрагментUUID, КодМодели);
		Блокировка.Заблокировать();
		Счетчик = РегистрыСведений.КИИ_ВерсииСинхронизацииQdrant.СоздатьМенеджерЗаписи();
		Счетчик.ФрагментИдентификатор = ФрагментUUID;
		Счетчик.КодМодели = КодМодели;
		Счетчик.Прочитать();
		Счетчик.ФрагментИдентификатор = ФрагментUUID;
		Счетчик.КодМодели = КодМодели;
		РезультатТекущаяУниверсальнаяДатаВМиллисекундах = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Счетчик.Версия = Макс(Счетчик.Версия + 1, РезультатТекущаяУниверсальнаяДатаВМиллисекундах);
		Счетчик.Записать();
		Запись = НоваяЗаписьОчереди(ФрагментUUID, КодМодели);
		Запись.Версия = Счетчик.Версия;
		Запись.Раздел = РазделФрагмента(ФрагментUUID);
		Запись.НомерПоПорядку = Счетчик.Версия;
		Запись.Операция = Операция;
		Запись.Хеш = Хеш;
		Запись.Попыток = 0;
		Запись.ПоследняяОшибка = "";
		Запись.ДатаПостановки = ТекущаяДатаСеанса();
		Запись.Записать();
		Снимок = СнимокЗаписи(Запись);
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Снимок;
КонецФункции

// Исполняющий метод БСП. Целые фиксированные разделы принадлежат одному владельцу.
// Параметры:
//  Элементы - Массив из Структура - ограниченная порция снимков очереди.
//  Параметры - см. КИИ_ОчередьQdrant.ПараметрыОбработки
// Возвращаемое значение:
//  Структура:
//   * Выбрано - Число - получено под исключительное владение.
//   * Подтверждено - Число - подтверждено отправленных версий.
//   * Ошибок - Число - ошибочных версий.
//   * Пропущено - Число - чужих или изменившихся версий.
//   * Пакетов - Число - выполнено HTTP-запросов записи.
Функция ОбработатьПорциюИсполнителя(Знач Элементы, Знач Параметры) Экспорт
	ПроверитьОтсутствиеТранзакции();
	Итог = НовыйИтог();
	Владелец = Строка(Новый УникальныйИдентификатор);
	Разделы = ЗахватитьРазделы(Элементы, Владелец);
	Попытка
		Доступные = ОтобратьПринадлежащиеЭлементы(Элементы, Разделы);
		Итог.Выбрано = Доступные.Количество();
		Итог.Пропущено = Элементы.Количество() - Доступные.Количество();
		ОбработатьДоступныеПорции(Доступные, Параметры, Разделы, Владелец, Итог);
	Исключение
		ОсвободитьРазделы(Разделы, Владелец);
		ВызватьИсключение;
	КонецПопытки;
	ОсвободитьРазделы(Разделы, Владелец);
	Возврат Итог;
КонецФункции

// Синхронная пересборка использует пакетную очередь, версии и сетевую защиту.
// Параметры:
//  КодМодели - Строка - код модели.
//  Размерность - Число - размерность коллекции.
// Возвращаемое значение:
//  Структура:
//   * Залито - Число - синхронизированных исходных фрагментов.
//   * Всего - Число - исходных фрагментов модели.
// std436п.2: ограниченные проходы по256 заданий; один проход не может загрузить всю модель.
// @skip-check query-in-loop
Функция ПересобратьМодель(Знач КодМодели, Знач Размерность) Экспорт

	Перем ТекстСообщения;
	Перем ТекстПоШаблону;

	Перем РезультатФункции;
	ПроверитьОтсутствиеТранзакции();
	ПроверитьУсловнуюЗапись();
	КИИ_RAGQdrant.ОтметитьПоколение(КодМодели, Ложь);
	КИИ_RAGQdrant.ОбеспечитьКоллекцию(КодМодели, Размерность);
	Подготовка = ПоставитьФрагментыМодели(КодМодели);
	Параметры = ПараметрыОбработки();
	Параметры.КодМодели = КодМодели;
	НомерПрохода = 0;
	Пока НомерПрохода < Цел((Подготовка.Всего + 255) / 256) + 1 Цикл
		НомерПрохода = НомерПрохода + 1;
		Итог = Обработать(Параметры);
		Если Итог.Выбрано = 0 Или Итог.Ошибок > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Ожидают = ЧислоОжидающихФрагментов(Подготовка.Поставленные, КодМодели);
	Залито = Подготовка.Поставленные.Количество() - Ожидают;
	Если Залито = Подготовка.Всего Тогда
		КИИ_RAGQdrant.ОтметитьПоколение(КодМодели, Истина);
	Иначе
		ТекстСообщения = НСтр("ru = 'КИИ.RAGQdrant.Пересборка'");
		ТекстПоШаблону = СтрШаблон(
			НСтр("ru = 'Пересборка неполная: синхронизировано %1 из %2'"), Залито, Подготовка.Всего);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Предупреждение, , , ТекстПоШаблону);
	КонецЕсли;
	РезультатФункции = Новый Структура("Залито, Всего", Залито, Подготовка.Всего);
	Возврат РезультатФункции;
КонецФункции

// Совместимое подтверждение старого порядкового снимка в короткой транзакции.
// Параметры:
//  ФрагментUUID - Строка - идентификатор фрагмента.
//  КодМодели - Строка - код модели.
//  НомерСнимка - Число - порядковый номер прежнего снимка.
Процедура ПодтвердитьПоНомеру(Знач ФрагментUUID, Знач КодМодели, Знач НомерСнимка) Экспорт
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Блокировка = БлокировкаВерсию(ФрагментUUID, КодМодели);
		Блокировка.Заблокировать();
		Запись = НоваяЗаписьОчереди(ФрагментUUID, КодМодели);
		Запись.Прочитать();
		Если Запись.Выбран() И Запись.НомерПоПорядку <= НомерСнимка Тогда
			Запись.Удалить();
		КонецЕсли;
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Подтверждает только ту версию, которая действительно была отправлена.
// Параметры:
//  Элемент - Структура - снимок записи очереди.
// Возвращаемое значение:
//  Булево - снимок подтвержден; новая версия не изменяется.
Функция Подтвердить(Знач Элемент) Экспорт

	Перем РезультатФункции;
	РезультатФункции = ИзменитьРезультатЗаписи(Элемент, Истина, "");
	Возврат РезультатФункции;
КонецФункции

// Подтверждает порцию одним удалением после проверки текущих версий под блокировкой.
// Параметры:
//  Снимки - Массив из Структура - отправленные снимки записи очереди, без повторов ключей.
// Возвращаемое значение:
//  Число - количество подтвержденных версий; новые задания не изменяются.
Функция ПодтвердитьПакет(Знач Снимки) Экспорт
	Если Снимки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	ТаблицаСнимков = ТаблицаСнимковОчереди(Снимки);
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Блокировка = БлокировкаПорциюОчереди(ТаблицаСнимков);
		Блокировка.Заблокировать();
		Удаляемые = АктуальныеСнимкиПодтверждения(ТаблицаСнимков);
		Количество = Удаляемые.Количество();
		Если Количество > 0 Тогда
			Набор = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.СоздатьНаборЗаписей();
			Набор.Загрузить(Удаляемые);
			Набор.Записать(РежимЗамещения.Удаление);
		КонецЕсли;
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Количество;
КонецФункции

// Увеличивает попытки только той версии, для которой получен отказ.
// Параметры:
//  Элемент - Структура - снимок записи очереди.
//  ТекстОшибки - Строка - диагностическое сообщение.
// Возвращаемое значение:
//  Булево - ошибка относится к текущей записи.
Функция ОтметитьОшибку(Знач Элемент, Знач ТекстОшибки) Экспорт

	Перем РезультатФункции;
	РезультатФункции = ИзменитьРезультатЗаписи(Элемент, Ложь, ТекстОшибки);
	Возврат РезультатФункции;
КонецФункции

// Номер фиксированного раздела не зависит от количества исполнителей.
// Параметры:
//  ФрагментUUID - Строка - идентификатор фрагмента.
// Возвращаемое значение:
//  Число - от 0 до 15.
Функция РазделФрагмента(Знач ФрагментUUID) Экспорт

	Перем ЗначениеВНижнемРегистре;

	Перем РезультатФункции;
	СуммаКодов = 0;
	Для Позиция = 1 По СтрДлина(ФрагментUUID) Цикл
		ЗначениеВНижнемРегистре = НРег(ФрагментUUID);
		СуммаКодов = СуммаКодов + КодСимвола(ЗначениеВНижнемРегистре, Позиция);
	КонецЦикла;
	РезультатФункции = СуммаКодов % КоличествоРазделов();
	Возврат РезультатФункции;
КонецФункции

// Формирует условную операцию: равная или большая версия в NAS не перезаписывается.
// Параметры:
//  Точка - Структура - id, vector и payload.
//  Версия - Число - монотонная версия операции.
// Возвращаемое значение:
//  Структура:
//   * upsert - Структура:
//     ** points - Массив из Структура - точка из входного параметра.
//     ** update_filter - Структура:
//       *** must_not - Массив из Структура - запрет обновления равной или большей версии.
Функция УсловнаяОперация(Знач Точка, Знач Версия) Экспорт

	Перем ПараметрыВызова;
	Перем РезультатФункции;
	Точки = Новый Массив;
	Точки.Добавить(Точка);
	Условия = Новый Массив;
	Диапазон = Новый Структура("gte", Версия);
	ПараметрыВызова = Новый Структура("key, range", "_kii_revision", Диапазон);
	Условия.Добавить(ПараметрыВызова);
	Фильтр = Новый Структура("must_not", Условия);
	ЗаписьТочек = Новый Структура("points, update_filter", Точки, Фильтр);
	РезультатФункции = Новый Структура("upsert", ЗаписьТочек);
	Возврат РезультатФункции;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращаемое значение:
//  Число - наибольшее число операций в одном пакете.
Функция МаксимальныйРазмерПакета()
	Возврат 64;
КонецФункции

// Возвращаемое значение:
//  Число - наибольшее число исполнителей в серверной базе.
Функция МаксимумИсполнителей()
	Возврат 4;
КонецФункции

// Возвращаемое значение:
//  Число - постоянное число разделов; изменение требует миграции очереди.
Функция КоличествоРазделов()
	Возврат 16;
КонецФункции

// Возвращаемое значение:
//  Число - срок захвата и продления владения разделом.
Функция СрокВладенияВСекундах()
	Возврат 600;
КонецФункции

// Возвращаемое значение:
//  Число - общий предел координат векторов для ограничения памяти.
Функция ЛимитКоординатВПакете()
	Возврат 131072;
КонецФункции

// Возвращаемое значение:
//  Число - предел текста ошибки в регистре очереди и журнале.
Функция ДлинаСообщенияОбОшибке()
	Возврат 500;
КонецФункции

// Возвращаемое значение:
//  Структура:
//   * Выбрано - Число - получено под исключительное владение.
//   * Подтверждено - Число - подтверждено отправленных версий.
//   * Ошибок - Число - ошибочных версий.
//   * Пропущено - Число - чужих или изменившихся версий.
//   * Пакетов - Число - выполнено HTTP-запросов записи.
Функция НовыйИтог()
	Результат = Новый Структура;
	Результат.Вставить("Выбрано", 0);
	Результат.Вставить("Подтверждено", 0);
	Результат.Вставить("Ошибок", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Пакетов", 0);
	Возврат Результат;
КонецФункции

Процедура ПроверитьОтсутствиеТранзакции()
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение НСтр("ru = 'Обработка очереди Qdrant не допускается внутри транзакции'");
	КонецЕсли;
КонецПроцедуры

Функция ПроверенныеПараметры(Знач Параметры)

	Перем РезультатМаксимальныйРазмерПакета;
	Перем РезультатМаксимумИсполнителей;
	Результат = ПараметрыОбработки();
	Если Параметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, Параметры);
	КонецЕсли;
	Если ТипЗнч(Результат.КодМодели) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Код модели очереди Qdrant должен быть строкой'");
	КонецЕсли;
	РезультатМаксимальныйРазмерПакета = МаксимальныйРазмерПакета();
	ПроверитьПредел(Результат.РазмерПакета, РезультатМаксимальныйРазмерПакета);
	РезультатМаксимумИсполнителей = МаксимумИсполнителей();
	ПроверитьПредел(Результат.КоличествоИсполнителей, РезультатМаксимумИсполнителей);
	Возврат Результат;
КонецФункции

Процедура ПроверитьПредел(Знач Значение, Знач Максимум)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный тип предела обработки очереди Qdrant'");
	КонецЕсли;
	ВПределах = Значение >= 1 И Значение <= Максимум;
	Если Не ВПределах Или Цел(Значение) <> Значение Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный предел обработки очереди Qdrant'");
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьУсловнуюЗапись()
	Ответ = КИИ_RAGQdrant.ВыполнитьЗапросQdrant("GET", "/");
	Если Не Ответ.Успешно Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось проверить версию Qdrant'");
	КонецЕсли;
	Данные = КИИ_HTTPКлиент.JsonВСтруктуру(Ответ.Тело, Ложь);
	Версия = Данные["version"];
	Если ТипЗнч(Версия) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Сервер не сообщил версию Qdrant'");
	КонецЕсли;
	Части = СтрРазделить(Версия, ".");
	Если Части.Количество() < 2 Тогда
		ВызватьИсключение НСтр("ru = 'Некорректная версия Qdrant'");
	КонецЕсли;
	ОсновнаяВерсия = Число(Части[0]);
	ДополнительнаяВерсия = Число(Части[1]);
	Поддерживается = ОсновнаяВерсия > 1 Или (ОсновнаяВерсия = 1 И ДополнительнаяВерсия >= 16);
	Если Не Поддерживается Тогда
		ВызватьИсключение НСтр("ru = 'Для условной очереди требуется Qdrant 1.16 или новее'");
	КонецЕсли;
КонецПроцедуры

Функция БлокировкаВерсию(Знач ФрагментUUID, Знач КодМодели)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.КИИ_ВерсииСинхронизацииQdrant");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("ФрагментИдентификатор", ФрагментUUID);
	Элемент.УстановитьЗначение("КодМодели", КодМодели);
	Элемент = Блокировка.Добавить("РегистрСведений.КИИ_ОчередьСинхронизацииQdrant");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("ФрагментИдентификатор", ФрагментUUID);
	Элемент.УстановитьЗначение("КодМодели", КодМодели);
	Возврат Блокировка;
КонецФункции

Функция НоваяЗаписьОчереди(Знач ФрагментUUID, Знач КодМодели)
	Запись = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.СоздатьМенеджерЗаписи();
	Запись.ФрагментИдентификатор = ФрагментUUID;
	Запись.КодМодели = КодМодели;
	Возврат Запись;
КонецФункции

Функция СнимокЗаписи(Знач Запись)
	Результат = Новый Структура;
	Результат.Вставить("ФрагментИдентификатор", Запись.ФрагментИдентификатор);
	Результат.Вставить("КодМодели", Запись.КодМодели);
	Результат.Вставить("Операция", Запись.Операция);
	Результат.Вставить("Хеш", Запись.Хеш);
	Результат.Вставить("Попыток", Запись.Попыток);
	Результат.Вставить("НомерПоПорядку", Запись.НомерПоПорядку);
	Результат.Вставить("Версия", Запись.Версия);
	Результат.Вставить("Раздел", Запись.Раздел);
	Возврат Результат;
КонецФункции

Процедура ОбновитьСтарыеЗаписи()

	Перем РезультатЗапроса;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 256
		| Очередь.ФрагментИдентификатор КАК ФрагментИдентификатор,
		| Очередь.КодМодели КАК КодМодели,
		| Очередь.Операция КАК Операция,
		| Очередь.Хеш КАК Хеш
		|ИЗ РегистрСведений.КИИ_ОчередьСинхронизацииQdrant КАК Очередь
		|ГДЕ Очередь.Версия = 0
		|УПОРЯДОЧИТЬ ПО Очередь.НомерПоПорядку, Очередь.ФрагментИдентификатор, Очередь.КодМодели";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбновитьСтаруюЗапись(Выборка.ФрагментИдентификатор, Выборка.КодМодели);
	КонецЦикла;
КонецПроцедуры

Процедура ОбновитьСтаруюЗапись(Знач ФрагментUUID, Знач КодМодели)
	НачатьТранзакцию();
	Попытка
		Блокировка = БлокировкаВерсию(ФрагментUUID, КодМодели);
		Блокировка.Заблокировать();
		Запись = НоваяЗаписьОчереди(ФрагментUUID, КодМодели);
		Запись.Прочитать();
		Если Запись.Выбран() И Запись.Версия = 0 Тогда
			СтарыеДанные = Новый Структура;
			СтарыеДанные.Вставить("Попыток", Запись.Попыток);
			СтарыеДанные.Вставить("ПоследняяОшибка", Запись.ПоследняяОшибка);
			СтарыеДанные.Вставить("НомерПоПорядку", Запись.НомерПоПорядку);
			СтарыеДанные.Вставить("ДатаПостановки", Запись.ДатаПостановки);
			Поставить(ФрагментUUID, КодМодели, Запись.Операция, Запись.Хеш);
			Запись.Прочитать();
			ЗаполнитьЗначенияСвойств(Запись, СтарыеДанные);
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Функция ТаблицаСнимковОчереди(Знач Снимки)

	Перем НоваяСтрока;
	Таблица = Новый ТаблицаЗначений;
	Регистр = Метаданные.РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant;
	Таблица.Колонки.Добавить("ФрагментИдентификатор", Регистр.Измерения.ФрагментИдентификатор.Тип);
	Таблица.Колонки.Добавить("КодМодели", Регистр.Измерения.КодМодели.Тип);
	Таблица.Колонки.Добавить("Версия", Регистр.Ресурсы.Версия.Тип);
	Для Каждого Снимок Из Снимки Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Снимок);
	КонецЦикла;
	Возврат Таблица;
КонецФункции

Функция БлокировкаПорциюОчереди(Знач ТаблицаСнимков)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.КИИ_ОчередьСинхронизацииQdrant");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.ИсточникДанных = ТаблицаСнимков;
	Элемент.ИспользоватьИзИсточникаДанных("ФрагментИдентификатор", "ФрагментИдентификатор");
	Элемент.ИспользоватьИзИсточникаДанных("КодМодели", "КодМодели");
	Возврат Блокировка;
КонецФункции

Функция АктуальныеСнимкиПодтверждения(Знач ТаблицаСнимков)

	Перем РезультатЗапроса;

	Перем РезультатФункции;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Снимки", ТаблицаСнимков);
	Запрос.Текст =
		"ВЫБРАТЬ Снимки.ФрагментИдентификатор КАК ФрагментИдентификатор,
		| Снимки.КодМодели КАК КодМодели, Снимки.Версия КАК Версия
		|ПОМЕСТИТЬ втСнимкиОчереди
		|ИЗ &Снимки КАК Снимки;
		|
		|ВЫБРАТЬ Очередь.ФрагментИдентификатор КАК ФрагментИдентификатор,
		| Очередь.КодМодели КАК КодМодели
		|ИЗ РегистрСведений.КИИ_ОчередьСинхронизацииQdrant КАК Очередь
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСнимкиОчереди КАК Снимки
		| ПО Очередь.ФрагментИдентификатор = Снимки.ФрагментИдентификатор
		| И Очередь.КодМодели = Снимки.КодМодели И Очередь.Версия = Снимки.Версия";
	РезультатЗапроса = Запрос.Выполнить();
	РезультатФункции = РезультатЗапроса.Выгрузить();
	Возврат РезультатФункции;
КонецФункции

Функция ИзменитьРезультатЗаписи(Знач Элемент, Знач Успех, Знач ТекстОшибки)

	Перем РезультатДлинаСообщенияОбОшибке;
	Результат = Ложь;
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Блокировка = БлокировкаВерсию(Элемент.ФрагментИдентификатор, Элемент.КодМодели);
		Блокировка.Заблокировать();
		Запись = НоваяЗаписьОчереди(Элемент.ФрагментИдентификатор, Элемент.КодМодели);
		Запись.Прочитать();
		Если Запись.Выбран() И Запись.Версия = Элемент.Версия Тогда
			Если Успех Тогда
				Запись.Удалить();
			Иначе
				Запись.Попыток = Запись.Попыток + 1;
				РезультатДлинаСообщенияОбОшибке = ДлинаСообщенияОбОшибке();
				Запись.ПоследняяОшибка = Лев(ТекстОшибки, РезультатДлинаСообщенияОбОшибке);
				Запись.Записать();
			КонецЕсли;
			Результат = Истина;
		КонецЕсли;
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция ВыполнитьЧерезБСП(Знач Элементы, Знач Настройки)

	Перем ПредставлениеЗначения;
	Перем РезультатФункции;
	Вызовы = Новый Соответствие;
	Для Номер = 0 По Настройки.КоличествоИсполнителей - 1 Цикл
		Порция = Новый Массив;
		Для Каждого Элемент Из Элементы Цикл
			Если Элемент.Раздел % Настройки.КоличествоИсполнителей = Номер Тогда
				Порция.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
		Если Порция.Количество() > 0 Тогда
			Аргументы = Новый Массив;
			Аргументы.Добавить(Порция);
			Аргументы.Добавить(Настройки);
			ПредставлениеЗначения = Строка(Номер);
			Вызовы.Вставить(ПредставлениеЗначения, Аргументы);
		КонецЕсли;
	КонецЦикла;
	ПараметрыЗапуска = ДлительныеОперации.ПараметрыВыполненияФункции(Новый УникальныйИдентификатор);
	ПараметрыЗапуска.ОжидатьЗавершение = Неопределено;
	ПараметрыЗапуска.ЗапуститьВФоне = Истина;
	ПараметрыЗапуска.ПрерватьВыполнениеЕслиОшибка = Ложь;
	ПараметрыЗапуска.НаименованиеФоновогоЗадания = НСтр("ru = 'Синхронизация очереди Qdrant'");
	Операция = ДлительныеОперации.ВыполнитьФункциюВНесколькоПотоков(
		"КИИ_ОчередьQdrant.ОбработатьПорциюИсполнителя", ПараметрыЗапуска, Вызовы);
	Если Операция.Статус <> "Выполнено" Тогда
		ВызватьИсключение НСтр("ru = 'Фоновые исполнители очереди Qdrant не завершились'");
	КонецЕсли;
	РезультатФункции = СобратьРезультатыИсполнителей(Операция);
	Возврат РезультатФункции;
КонецФункции

Функция СобратьРезультатыИсполнителей(Знач Операция)

	Перем ДанныеХранилища;
	Результаты = ПолучитьИзВременногоХранилища(Операция.АдресРезультата);
	Итог = НовыйИтог();
	ОшибкаИсполнителя = Ложь;
	Для Каждого Пара Из Результаты Цикл
		РезультатПотока = Пара.Значение;
		Если РезультатПотока.Статус = "Выполнено" Тогда
			ДанныеХранилища = ПолучитьИзВременногоХранилища(РезультатПотока.АдресРезультата);
			СложитьИтоги(Итог, ДанныеХранилища);
		Иначе
			ОшибкаИсполнителя = Истина;
		КонецЕсли;
		Если Не ПустаяСтрока(РезультатПотока.АдресРезультата) Тогда
			УдалитьИзВременногоХранилища(РезультатПотока.АдресРезультата);
		КонецЕсли;
	КонецЦикла;
	УдалитьИзВременногоХранилища(Операция.АдресРезультата);
	Если ОшибкаИсполнителя Тогда
		ВызватьИсключение НСтр("ru = 'Один из исполнителей очереди Qdrant завершился с ошибкой'");
	КонецЕсли;
	Возврат Итог;
КонецФункции

Процедура СложитьИтоги(Итог, Знач Порция)
	Для Каждого Пара Из Порция Цикл
		Итог[Пара.Ключ] = Итог[Пара.Ключ] + Пара.Значение;
	КонецЦикла;
КонецПроцедуры

Функция ЗахватитьРазделы(Знач Элементы, Знач Владелец)
	Нужные = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		Нужные.Вставить(Элемент.Раздел, Истина);
	КонецЦикла;
	Результат = Новый Соответствие;
	Попытка
		Для Номер = 0 По КоличествоРазделов() - 1 Цикл
			Если Нужные[Номер] <> Неопределено И ЗахватитьРаздел(Номер, Владелец) Тогда
				Результат.Вставить(Номер, Истина);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ОсвободитьРазделы(Результат, Владелец);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция ЗахватитьРаздел(Знач Раздел, Знач Владелец)

	Перем ТекущийСеансИнформационнойБазыЗначение;
	НачатьТранзакцию();
	Попытка
		Блокировка = БлокировкаРаздела(Раздел);
		Блокировка.Заблокировать();
		Запись = ПрочитатьЗаписьРаздела(Раздел);
		Доступен = Не Запись.Выбран() Или Не ВладелецЕщеРаботает(Запись);
		Если Доступен Тогда
			ТекущийСеансИнформационнойБазыЗначение = ПолучитьТекущийСеансИнформационнойБазы();
			Задание = ТекущийСеансИнформационнойБазыЗначение.ПолучитьФоновоеЗадание();
			Запись.Владелец = Владелец;
			Запись.Задание = ?(Задание = Неопределено, "", Строка(Задание.УникальныйИдентификатор));
			Запись.СрокВладения = ТекущаяУниверсальнаяДата() + СрокВладенияВСекундах();
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Доступен;
КонецФункции

Функция ВладелецЕщеРаботает(Знач Запись)

	Перем ИдентификаторЗначения;
	Перем РезультатФункции;
	Если Не ПустаяСтрока(Запись.Задание) Тогда
		ИдентификаторЗначения = Новый УникальныйИдентификатор(Запись.Задание);
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗначения);
		РезультатФункции = Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно;
		Возврат РезультатФункции;
	КонецЕсли;
	РезультатФункции = Запись.СрокВладения > ТекущаяУниверсальнаяДата();
	Возврат РезультатФункции;
КонецФункции

Функция БлокировкаРаздела(Знач Раздел)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.КИИ_ИсполнителиОчередиQdrant");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Раздел", Раздел);
	Возврат Блокировка;
КонецФункции

Функция ПрочитатьЗаписьРаздела(Знач Раздел)
	Запись = РегистрыСведений.КИИ_ИсполнителиОчередиQdrant.СоздатьМенеджерЗаписи();
	Запись.Раздел = Раздел;
	Запись.Прочитать();
	Запись.Раздел = Раздел;
	Возврат Запись;
КонецФункции

Процедура ОсвободитьРазделы(Знач Разделы, Знач Владелец)
	Для Каждого Пара Из Разделы Цикл
		НачатьТранзакцию();
		Попытка
			Блокировка = БлокировкаРаздела(Пара.Ключ);
			Блокировка.Заблокировать();
			Запись = ПрочитатьЗаписьРаздела(Пара.Ключ);
			Если Запись.Выбран() И Запись.Владелец = Владелец Тогда
				Запись.Удалить();
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция ОтобратьПринадлежащиеЭлементы(Знач Элементы, Знач Разделы)
	Результат = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Если Разделы[Элемент.Раздел] <> Неопределено Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПродлитьВладение(Знач Разделы, Знач Владелец)
	Для Каждого Пара Из Разделы Цикл
		НачатьТранзакцию();
		Попытка
			Блокировка = БлокировкаРаздела(Пара.Ключ);
			Блокировка.Заблокировать();
			Запись = ПрочитатьЗаписьРаздела(Пара.Ключ);
			Если Не Запись.Выбран() Или Запись.Владелец <> Владелец Тогда
				ВызватьИсключение НСтр("ru = 'Владение разделом очереди Qdrant утрачено'");
			КонецЕсли;
			Запись.СрокВладения = ТекущаяУниверсальнаяДата() + СрокВладенияВСекундах();
			Запись.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// std436п.2: сведения и векторы выбираются по ограниченной порции, а не по одному фрагменту.
// @skip-check query-in-loop
// Параметры:
//  Элементы - Массив из Структура - снимки очереди для подготовки.
//  Параметры - Структура - проверенные параметры; см. ПараметрыОбработки.
//  Разделы - Соответствие из КлючИЗначение - принадлежащие исполнителю номера разделов.
//  Владелец - Строка - уникальный идентификатор исполнителя.
//  Итог - Структура - изменяемые счетчики результата; см. Обработать.
Процедура ОбработатьДоступныеПорции(Знач Элементы, Знач Параметры, Знач Разделы, Знач Владелец, Итог)
	Смещение = 0;
	Пока Смещение < Элементы.Количество() Цикл
		ПродлитьВладение(Разделы, Владелец);
		Порция = СрезМассива(Элементы, Смещение, Параметры.РазмерПакета);
		Смещение = Смещение + Порция.Количество();
		Подготовленные = ПодготовитьПорцию(Порция, Итог);
		ОтправитьПоКоллекциям(Подготовленные, Разделы, Владелец, Итог);
	КонецЦикла;
КонецПроцедуры

Функция СрезМассива(Знач Элементы, Знач Начало, Знач Количество)

	Перем КонецДиапазонаЭлементов;
	Перем КоличествоЭлементовМассива;
	Перем ПоследнийИндексПорции;
	Результат = Новый Массив;
	КонецДиапазонаЭлементов = Начало + Количество;
	КоличествоЭлементовМассива = Элементы.Количество();
	ПоследнийИндексПорции = Мин(КонецДиапазонаЭлементов, КоличествоЭлементовМассива) - 1;
	Для Индекс = Начало По ПоследнийИндексПорции Цикл
		Результат.Добавить(Элементы[Индекс]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПодготовитьПорцию(Знач Элементы, Итог)

	Перем РезультатКлючЗаписи;

	Перем ДанныеОшибки;
	Перем ПредставлениеОшибки;
	АктуальныеВерсии = ПрочитатьВерсииПорции(Элементы);
	Идентификаторы = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.Операция = "upsert" Тогда
			Идентификаторы.Добавить(Элемент.ФрагментИдентификатор);
		КонецЕсли;
	КонецЦикла;
	Сведения = КИИ_RAGQdrant.ПрочитатьФрагментыОчереди(Идентификаторы, Ложь);
	Разрешенные = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Фрагмент = Сведения[Элемент.ФрагментИдентификатор];
		Если ТребуетсяВектор(Элемент, Фрагмент) Тогда
			Разрешенные.Добавить(Элемент.ФрагментИдентификатор);
		КонецЕсли;
	КонецЦикла;
	Фрагменты = КИИ_RAGQdrant.ПрочитатьФрагментыОчереди(Разрешенные, Истина);
	Результат = Новый Массив;
	Размерности = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		Попытка
			РезультатКлючЗаписи = КлючЗаписи(Элемент);
			Данные = ПодготовитьЭлемент(
				Элемент, Фрагменты[Элемент.ФрагментИдентификатор], Размерности, АктуальныеВерсии[РезультатКлючЗаписи]);
			Если Данные <> Неопределено Тогда
				Результат.Добавить(Данные);
			Иначе
				Итог.Пропущено = Итог.Пропущено + 1;
			КонецЕсли;
		Исключение
			ДанныеОшибки = ИнформацияОбОшибке();
			ПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
			ЗафиксироватьОтказ(Элемент, ПредставлениеОшибки, Итог);
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ТребуетсяВектор(Знач Элемент, Знач Фрагмент)

	Перем РезультатФункции;
	РезультатФункции = Элемент.Операция = "upsert"
		И Фрагмент <> Неопределено
		И Фрагмент.КодМоделиЭмбеддинга = Элемент.КодМодели
		И Не Фрагмент.БазаПомеченаУдаления
		И Фрагмент.ЭффективнаяПолитика <> Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
	Возврат РезультатФункции;
КонецФункции

Функция ПодготовитьЭлемент(Знач Элемент, Знач Фрагмент, Размерности, Знач АктуальнаяВерсия)

	Перем РезультатИмяКоллекции;
	Если АктуальнаяВерсия <> Элемент.Версия Тогда
		Возврат Неопределено;
	КонецЕсли;
	Удаление = Не ТребуетсяВектор(Элемент, Фрагмент);
	Если Не Удаление Тогда
		Вектор = ВекторЭлемента(Фрагмент);
		Удаление = Вектор = Неопределено;
	КонецЕсли;
	Если Удаление И Элемент.Операция <> "delete" Тогда
		Элемент = ЗаменитьНаУдаление(Элемент);
		Если Элемент = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если Удаление Тогда
		Размерность = Размерности[Элемент.КодМодели];
		Если Размерность = Неопределено Тогда
			Размерность = КИИ_RAGQdrant.РазмерностьДляОчереди(Элемент.КодМодели);
			Размерности.Вставить(Элемент.КодМодели, Размерность);
		КонецЕсли;
		ПолезныеДанные = Новый Структура("_kii_revision, _kii_deleted", Элемент.Версия, Истина);
		Точка = Новый Структура("id, vector, payload");
		Точка.id = КИИ_RAGQdrant.PointId(Элемент.ФрагментИдентификатор);
		Точка.vector = Новый Структура;
		Точка.payload = ПолезныеДанные;
	Иначе
		Размерность = Вектор.Количество();
		Если Размерность > ЛимитКоординатВПакете() Тогда
			ВызватьИсключение НСтр("ru = 'Вектор превышает ограничение памяти пакета Qdrant'");
		КонецЕсли;
		Фрагмент.Вставить("Вектор", Вектор);
		Точка = КИИ_RAGQdrant.ТочкаДляОчереди(Элемент.ФрагментИдентификатор, Фрагмент);
		Точка.payload.Вставить("_kii_revision", Элемент.Версия);
		Точка.payload.Вставить("_kii_deleted", Ложь);
	КонецЕсли;
	Если Размерность <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестна размерность коллекции Qdrant; удаление не подтверждено'");
	КонецЕсли;
	Результат = Новый Структура("Элемент, Точка, Размерность", Элемент, Точка, Размерность);
	РезультатИмяКоллекции = КИИ_RAGQdrant.ИмяКоллекции(Элемент.КодМодели, Размерность);
	Результат.Вставить("Коллекция", РезультатИмяКоллекции);
	Возврат Результат;
КонецФункции

Функция ВекторЭлемента(Знач Фрагмент)
	Если ТипЗнч(Фрагмент.ХранилищеВектора) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вектор = Фрагмент.ХранилищеВектора.Получить();
	Если ТипЗнч(Вектор) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Вектор.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Вектор;
КонецФункции

Функция СнимокАктуален(Знач Элемент)

	Перем РезультатФункции;
	Отбор = Новый Структура("ФрагментИдентификатор, КодМодели", Элемент.ФрагментИдентификатор, Элемент.КодМодели);
	Запись = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.Получить(Отбор);
	РезультатФункции = Запись.Версия = Элемент.Версия;
	Возврат РезультатФункции;
КонецФункции

Функция ЗаменитьНаУдаление(Знач Элемент)
	НачатьТранзакцию();
	Попытка
		Блокировка = БлокировкаВерсию(Элемент.ФрагментИдентификатор, Элемент.КодМодели);
		Блокировка.Заблокировать();
		Результат = Неопределено;
		Если СнимокАктуален(Элемент) Тогда
			Результат = Поставить(Элемент.ФрагментИдентификатор, Элемент.КодМодели, "delete");
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// std436п.2: отдельные коллекции и ограниченные пакеты; подтверждение выполняется одним набором.
// @skip-check query-in-loop
// Параметры:
//  Элементы - Массив из Структура - подготовленные точки, коллекции и снимки очереди.
//  Разделы - Соответствие из КлючИЗначение - принадлежащие исполнителю номера разделов.
//  Владелец - Строка - уникальный идентификатор исполнителя.
//  Итог - Структура - изменяемые счетчики результата; см. Обработать.
Процедура ОтправитьПоКоллекциям(Знач Элементы, Знач Разделы, Знач Владелец, Итог)
	Группы = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		Если Группы[Элемент.Коллекция] = Неопределено Тогда
			Группы.Вставить(Элемент.Коллекция, Новый Массив);
		КонецЕсли;
		Группы[Элемент.Коллекция].Добавить(Элемент);
	КонецЦикла;
	Для Каждого Пара Из Группы Цикл
		Если КоллекцияПорцииГотова(Пара.Значение, Итог) Тогда
			ОтправитьОграниченныеПакеты(Пара.Значение, Разделы, Владелец, Итог);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция КоллекцияПорцииГотова(Знач Элементы, Итог)

	Перем ДанныеОшибки;
	Первый = Элементы[0];
	Попытка
		КИИ_RAGQdrant.ОбеспечитьКоллекцию(Первый.Элемент.КодМодели, Первый.Размерность);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
		Для Каждого Элемент Из Элементы Цикл
			ЗафиксироватьОтказ(Элемент.Элемент, Ошибка, Итог);
		КонецЦикла;
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

Процедура ОтправитьПакет(Знач Элементы, Знач Разделы, Знач Владелец, Итог)

	Перем ПараметрыВызова;

	Перем РезультатУсловнаяОперация;

	Перем КоличествоЭлементов;
	Перем РезультатСрезМассива;
	ПродлитьВладение(Разделы, Владелец);
	Операции = Новый Массив;
	Для Каждого Данные Из Элементы Цикл
		РезультатУсловнаяОперация = УсловнаяОперация(Данные.Точка, Данные.Элемент.Версия);
		Операции.Добавить(РезультатУсловнаяОперация);
	КонецЦикла;
	Коллекция = Элементы[0].Коллекция;
	ПараметрыВызова = Новый Структура("operations", Операции);
	Ответ = КИИ_RAGQdrant.ВыполнитьЗапросQdrant(
		"POST", "/collections/" + Коллекция + "/points/batch?wait=true&ordering=strong", ПараметрыВызова);
	Итог.Пакетов = Итог.Пакетов + 1;
	КоличествоЭлементов = Операции.Количество();
	Если ПакетПодтвержденСервером(Ответ, КоличествоЭлементов) Тогда
		Снимки = Новый Массив;
		Для Каждого Данные Из Элементы Цикл
			Снимки.Добавить(Данные.Элемент);
		КонецЦикла;
		Подтверждено = ПодтвердитьПакет(Снимки);
		Итог.Подтверждено = Итог.Подтверждено + Подтверждено;
		Итог.Пропущено = Итог.Пропущено + Элементы.Количество() - Подтверждено;
		Возврат;
	КонецЕсли;
	Если Элементы.Количество() = 1 Или Не ОшибкаОтдельнойТочки(Ответ) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Пакет Qdrant не принят: HTTP %1 %2'"), Ответ.КодСостояния, Ответ.Тело);
		Для Каждого Данные Из Элементы Цикл
			ЗафиксироватьОтказ(Данные.Элемент, ТекстОшибки, Итог);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	КоличествоЭлементов = Элементы.Количество();
	Середина = Цел(КоличествоЭлементов / 2);
	РезультатСрезМассива = СрезМассива(Элементы, 0, Середина);
	ОтправитьПакет(РезультатСрезМассива, Разделы, Владелец, Итог);
	КоличествоЭлементов = Элементы.Количество();
	РезультатСрезМассива = СрезМассива(Элементы, Середина, КоличествоЭлементов);
	ОтправитьПакет(РезультатСрезМассива, Разделы, Владелец, Итог);
КонецПроцедуры

// Деление допустимо только для слишком большого запроса или известной ошибки конкретной точки.
// Сетевые ошибки, авторизация, перегрузка и неполное подтверждение повторяются целым пакетом.
// Параметры:
//  Ответ - Структура - ответ HTTP-клиента со свойствами КодСостояния и Тело.
// Возвращаемое значение:
//  Булево - есть основание изолировать ошибку делением пакета.
Функция ОшибкаОтдельнойТочки(Знач Ответ)

	Перем РезультатФункции;
	Если Ответ.КодСостояния = 413 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Ответ.КодСостояния <> 400 И Ответ.КодСостояния <> 422 Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстОшибки = НРег(Ответ.Тело);
	РезультатФункции = СтрНайти(ТекстОшибки, "vector dimension error") > 0
		Или СтрНайти(ТекстОшибки, "invalid point id") > 0;
	Возврат РезультатФункции;
КонецФункции

Процедура ЗафиксироватьОтказ(Знач Элемент, Знач ТекстОшибки, Итог)

	Перем ТекстСообщения;
	Перем РезультатДлинаСообщенияОбОшибке;
	Перем НачалоТекста;
	Если ОтметитьОшибку(Элемент, ТекстОшибки) Тогда
		Итог.Ошибок = Итог.Ошибок + 1;
		ТекстСообщения = НСтр("ru = 'КИИ.RAGQdrant.Очередь'");
		РезультатДлинаСообщенияОбОшибке = ДлинаСообщенияОбОшибке();
		НачалоТекста = Лев(ТекстОшибки, РезультатДлинаСообщенияОбОшибке);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, , , НачалоТекста);
	Иначе
		Итог.Пропущено = Итог.Пропущено + 1;
	КонецЕсли;
КонецПроцедуры

Функция КлючЗаписи(Знач Элемент)

	Перем РезультатФункции;
	РезультатФункции = Элемент.ФрагментИдентификатор + "|" + Элемент.КодМодели;
	Возврат РезультатФункции;
КонецФункции

Функция ПрочитатьВерсииПорции(Знач Элементы)

	Перем РезультатКлючЗаписи;

	Перем РезультатЗапроса;
	Идентификаторы = Новый Массив;
	Модели = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Идентификаторы.Добавить(Элемент.ФрагментИдентификатор);
		Модели.Добавить(Элемент.КодМодели);
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Запрос.УстановитьПараметр("Модели", Модели);
	Запрос.Текст =
		"ВЫБРАТЬ Очередь.ФрагментИдентификатор КАК ФрагментИдентификатор,
		| Очередь.КодМодели КАК КодМодели, Очередь.Версия КАК Версия
		|ИЗ РегистрСведений.КИИ_ОчередьСинхронизацииQdrant КАК Очередь
		|ГДЕ Очередь.ФрагментИдентификатор В (&Идентификаторы) И Очередь.КодМодели В (&Модели)";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		РезультатКлючЗаписи = КлючЗаписи(Выборка);
		Результат.Вставить(РезультатКлючЗаписи, Выборка.Версия);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВыбратьВерсионированнуюОчередь(Знач КодМодели)

	Перем РезультатСнимокЗаписи;

	Перем РезультатЗапроса;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КодМодели", КодМодели);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 256
		| Очередь.ФрагментИдентификатор КАК ФрагментИдентификатор,
		| Очередь.КодМодели КАК КодМодели, Очередь.Операция КАК Операция,
		| Очередь.Хеш КАК Хеш, Очередь.Попыток КАК Попыток,
		| Очередь.НомерПоПорядку КАК НомерПоПорядку, Очередь.Версия КАК Версия,
		| Очередь.Раздел КАК Раздел
		|ИЗ РегистрСведений.КИИ_ОчередьСинхронизацииQdrant КАК Очередь
		|ГДЕ Очередь.Версия > 0 И Очередь.Попыток < 10
		|УПОРЯДОЧИТЬ ПО Очередь.НомерПоПорядку, Очередь.ФрагментИдентификатор, Очередь.КодМодели";
	Если Не ПустаяСтрока(КодМодели) Тогда
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст, "ГДЕ Очередь.Версия > 0", "ГДЕ Очередь.КодМодели = &КодМодели И Очередь.Версия > 0");
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		РезультатСнимокЗаписи = СнимокЗаписи(Выборка);
		Результат.Добавить(РезультатСнимокЗаписи);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// std436п.2: лимит131072 координаты на пакет; подтверждение каждого пакета одним набором.
// @skip-check query-in-loop
// Параметры:
//  Элементы - Массив из Структура - подготовленные точки, коллекции и снимки очереди.
//  Разделы - Соответствие из КлючИЗначение - принадлежащие исполнителю номера разделов.
//  Владелец - Строка - уникальный идентификатор исполнителя.
//  Итог - Структура - изменяемые счетчики результата; см. Обработать.
Процедура ОтправитьОграниченныеПакеты(Знач Элементы, Знач Разделы, Знач Владелец, Итог)
	Пакет = Новый Массив;
	ЧиселВПакете = 0;
	Для Каждого Элемент Из Элементы Цикл
		Чисел = ?(ТипЗнч(Элемент.Точка.vector) = Тип("Массив"), Элемент.Точка.vector.Количество(), 0);
		Если ЧиселВПакете + Чисел > ЛимитКоординатВПакете() И Пакет.Количество() > 0 Тогда
			ОтправитьПакет(Пакет, Разделы, Владелец, Итог);
			Пакет = Новый Массив;
			ЧиселВПакете = 0;
		КонецЕсли;
		Пакет.Добавить(Элемент);
		ЧиселВПакете = ЧиселВПакете + Чисел;
	КонецЦикла;
	Если Пакет.Количество() > 0 Тогда
		ОтправитьПакет(Пакет, Разделы, Владелец, Итог);
	КонецЕсли;
КонецПроцедуры

Функция ПакетПодтвержденСервером(Знач Ответ, Знач КоличествоОпераций)
	Если Не Ответ.Успешно Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Данные = КИИ_HTTPКлиент.JsonВСтруктуру(Ответ.Тело, Ложь);
		Результаты = Данные["result"];
		Если Данные["status"] <> "ok" Или ТипЗнч(Результаты) <> Тип("Массив") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Результаты.Количество() <> КоличествоОпераций Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого Результат Из Результаты Цикл
			Если Результат["status"] <> "completed" Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

Функция ПоставитьФрагментыМодели(Знач КодМодели)

	Перем ТекстСообщения;
	Перем ДанныеОшибки;
	Перем ПодробностиОшибки;

	Перем ИдентификаторЗначения;
	Перем РезультатФункции;
	Всего = 0;
	Идентификаторы = Новый Массив;
	Выборка = КИИ_RAGQdrant.ФрагментыМоделиДляОчереди(КодМодели);
	Пока Выборка.Следующий() Цикл
		Всего = Всего + 1;
		Попытка
			ИдентификаторЗначения = Выборка.Ссылка.УникальныйИдентификатор();
			Идентификатор = Строка(ИдентификаторЗначения);
			Поставить(Идентификатор, КодМодели, "upsert", Выборка.ХешТекстаФрагмента);
			Идентификаторы.Добавить(Идентификатор);
		Исключение
			ТекстСообщения = НСтр("ru = 'КИИ.RAGQdrant.Пересборка'");
			ДанныеОшибки = ИнформацияОбОшибке();
			ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
			ЗаписьЖурналаРегистрации(
				ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, , Выборка.Ссылка, ПодробностиОшибки);
		КонецПопытки;
	КонецЦикла;
	РезультатФункции = Новый Структура("Всего, Поставленные", Всего, Идентификаторы);
	Возврат РезультатФункции;
КонецФункции

Функция ЧислоОжидающихФрагментов(Знач Идентификаторы, Знач КодМодели)

	Перем РезультатЗапроса;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Запрос.УстановитьПараметр("КодМодели", КодМодели);
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ РегистрСведений.КИИ_ОчередьСинхронизацииQdrant КАК Очередь
		|ГДЕ Очередь.ФрагментИдентификатор В (&Идентификаторы) И Очередь.КодМодели = &КодМодели";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;
КонецФункции

#КонецОбласти

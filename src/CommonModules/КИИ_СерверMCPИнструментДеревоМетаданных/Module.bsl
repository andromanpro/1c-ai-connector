#Область ПрограммныйИнтерфейс

// Декларация инструмента get_metadata_tree для container-pattern.
//
// Параметры:
//  Таблица - ТаблицаЗначений - реестр инструментов:
//   * Имя - Строка - имя инструмента
//   * Описание - Строка - описание инструмента
//   * Схема - Структура - JSON-схема аргументов
//
Процедура ДобавитьИнструменты(Таблица) Экспорт
	
	Свойства = Новый Структура;
	ОписаниеСвойства = Новый Структура("type, description",
		"string", НСтр("ru = 'Фильтр метаданных: Catalog.*, Document.* или Catalog.ИмяОбъекта.'"));
	Свойства.Вставить("filter", ОписаниеСвойства);
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Имя = "get_metadata_tree";
	НоваяСтрока.Описание = НСтр(
		"ru = 'Возвращает дерево метаданных: counts, список объектов по wildcard или точную ссылку.'");
	НоваяСтрока.Схема = Новый Структура("type, properties, additionalProperties", "object", Свойства, Ложь);
	
КонецПроцедуры

// Выполняет инструмент get_metadata_tree.
//
// Параметры:
//  ИмяИнструмента - Строка - имя MCP-инструмента
//  Аргументы - Структура, Соответствие из КлючИЗначение - аргументы инструмента:
//   * filter - Строка - фильтр метаданных (опционально)
//
// Возвращаемое значение:
//  Структура - дерево метаданных:
//   * objects - Массив из Структура - объекты метаданных
//   * counts - Структура - счетчики по категориям
//
Функция ВыполнитьИнструмент(Знач ИмяИнструмента, Знач Аргументы) Экспорт
	
	Если ИмяИнструмента <> "get_metadata_tree" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Неподдерживаемый инструмент %1 для модуля КИИ_СерверMCPИнструментДеревоМетаданных'"),
			ИмяИнструмента);
	КонецЕсли;
	
	Фильтр = ПолучитьФильтр(Аргументы);
	
	Если Не ЗначениеЗаполнено(Фильтр) Тогда
		Возврат РезультатДерева(ПолучитьТопОбъектов(50), ПодсчитатьКатегории());
	КонецЕсли;
	
	Если СтрокаОканчиваетсяНа(Фильтр, ".*") Тогда
		ТипМетаданных = Лев(Фильтр, СтрДлина(Фильтр) - 2);
		Возврат РезультатДерева(ПолучитьОбъектыТипа(ТипМетаданных), ПодсчитатьКатегории());
	КонецЕсли;
	
	ТипМетаданных = "";
	ИмяОбъекта = "";
	Если Не РазобратьТочнуюСсылку(Фильтр, ТипМетаданных, ИмяОбъекта) Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Некорректный фильтр метаданных: %1'"),
			Фильтр);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	
	Возврат РезультатДерева(ПолучитьТочныйОбъект(ТипМетаданных, ИмяОбъекта), ПодсчитатьКатегории());
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РезультатДерева(Знач Объекты, Знач Счетчики)
	
	Результат = Новый Структура;
	Результат.Вставить("objects", Объекты);
	Результат.Вставить("counts", Счетчики);
	Возврат Результат;
	
КонецФункции

Функция ПолучитьФильтр(Знач Аргументы)
	
	Если Аргументы = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		
		Фильтр = Неопределено;
		Если Аргументы.Свойство("filter", Фильтр) Тогда
			Возврат СокрЛП(Строка(Фильтр));
		КонецЕсли;
		
		Возврат "";
		
	КонецЕсли;
	
	Если ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		
		Фильтр = Аргументы.Получить("filter");
		Если Фильтр = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Возврат СокрЛП(Строка(Фильтр));
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПодсчитатьКатегории()
	
	Счетчики = Новый Структура;
	
	Для Каждого ТипМетаданных Из ТипыМетаданных() Цикл
		
		ИмяКоллекции = ИмяКоллекцииМетаданных(ТипМетаданных);
		КоллекцияМетаданных = ПолучитьКоллекциюМетаданных(ИмяКоллекции);
		Счетчики.Вставить(ТипМетаданных, КоллекцияМетаданных.Количество());
		
	КонецЦикла;
	
	Возврат Счетчики;
	
КонецФункции

Функция ПолучитьТопОбъектов(Знач МаксимальноеКоличество)
	
	Объекты = Новый Массив;
	
	Для Каждого ТипМетаданных Из ОсновныеТипыМетаданных() Цикл
		
		Если Объекты.Количество() >= МаксимальноеКоличество Тогда
			Прервать;
		КонецЕсли;
		
		ДобавитьОбъектыТипа(Объекты, ТипМетаданных, МаксимальноеКоличество);
		
	КонецЦикла;
	
	Возврат Объекты;
	
КонецФункции

Функция ПолучитьОбъектыТипа(Знач ТипМетаданных)
	
	ИмяКоллекции = ИмяКоллекцииМетаданных(ТипМетаданных);
	Если ИмяКоллекции = Неопределено Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Неподдерживаемый тип метаданных: %1'"),
			ТипМетаданных);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	
	Объекты = Новый Массив;
	КоллекцияМетаданных = ПолучитьКоллекциюМетаданных(ИмяКоллекции);
	
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		Объекты.Добавить(ОписаниеОбъекта(ТипМетаданных, ОбъектМетаданных));
	КонецЦикла;
	
	Возврат Объекты;
	
КонецФункции

Функция ПолучитьТочныйОбъект(Знач ТипМетаданных, Знач ИмяОбъекта)
	
	ИмяКоллекции = ИмяКоллекцииМетаданных(ТипМетаданных);
	Если ИмяКоллекции = Неопределено Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Неподдерживаемый тип метаданных: %1'"),
			ТипМетаданных);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	
	КоллекцияМетаданных = ПолучитьКоллекциюМетаданных(ИмяКоллекции);
	ОбъектМетаданных = НайтиОбъектМетаданных(КоллекцияМетаданных, ИмяОбъекта);
	
	Если ОбъектМетаданных = Неопределено Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Объект метаданных не найден: %1.%2'"),
			ТипМетаданных,
			ИмяОбъекта);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	
	Объекты = Новый Массив;
	Объекты.Добавить(ОписаниеОбъекта(ТипМетаданных, ОбъектМетаданных));
	Возврат Объекты;
	
КонецФункции

Процедура ДобавитьОбъектыТипа(Объекты, Знач ТипМетаданных, Знач МаксимальноеКоличество)
	
	ИмяКоллекции = ИмяКоллекцииМетаданных(ТипМетаданных);
	КоллекцияМетаданных = ПолучитьКоллекциюМетаданных(ИмяКоллекции);
	
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		
		Если Объекты.Количество() >= МаксимальноеКоличество Тогда
			Прервать;
		КонецЕсли;
		
		Объекты.Добавить(ОписаниеОбъекта(ТипМетаданных, ОбъектМетаданных));
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеОбъекта(Знач ТипМетаданных, Знач ОбъектМетаданных)
	
	Описание = Новый Структура;
	Описание.Вставить("canonical_ref", ТипМетаданных + "." + ОбъектМетаданных.Имя);
	Описание.Вставить("type", ТипМетаданных);
	Описание.Вставить("name", ОбъектМетаданных.Имя);
	Описание.Вставить("synonym", БезопасныйСиноним(ОбъектМетаданных));
	Описание.Вставить("origin", ОпределитьПроисхождение(ОбъектМетаданных));
	Возврат Описание;

КонецФункции

// Происхождение объекта метаданных: имя расширения, если объект принадлежит расширению, иначе "base".
// Раньше origin был захардкожен "base" - объекты расширений (включая КИИ_*) помечались базовыми (аудит P3).
// Параметры:
//  ОбъектМетаданных - Произвольный - объект метаданных для определения происхождения.
// Возвращаемое значение:
//  Строка - имя расширения-владельца или "base".
Функция ОпределитьПроисхождение(Знач ОбъектМетаданных) Экспорт

	Расширение = ОбъектМетаданных.РасширениеКонфигурации();
	Если Расширение = Неопределено Тогда
		Возврат "base";
	КонецЕсли;

	Возврат Расширение.Имя;

КонецФункции

Функция РазобратьТочнуюСсылку(Знач Фильтр, ТипМетаданных, ИмяОбъекта)
	
	ПозицияРазделителя = СтрНайти(Фильтр, ".");
	Если ПозицияРазделителя <= 1 Или ПозицияРазделителя = СтрДлина(Фильтр) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипМетаданных = Лев(Фильтр, ПозицияРазделителя - 1);
	ИмяОбъекта = Сред(Фильтр, ПозицияРазделителя + 1);
	Возврат Истина;
	
КонецФункции

Функция СтрокаОканчиваетсяНа(Знач СтроковоеЗначение, Знач Окончание)
	
	Если СтрДлина(СтроковоеЗначение) < СтрДлина(Окончание) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Прав(СтроковоеЗначение, СтрДлина(Окончание)) = Окончание;
	
КонецФункции

Функция НайтиОбъектМетаданных(Знач КоллекцияМетаданных, Знач ИмяОбъекта)
	
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		Если ОбъектМетаданных.Имя = ИмяОбъекта Тогда
			Возврат ОбъектМетаданных;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция БезопасныйСиноним(Знач ОбъектМетаданных)
	
	Попытка
		Синоним = Строка(ОбъектМетаданных.Синоним);
	Исключение
		Синоним = "";
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Синоним) Тогда
		Возврат Синоним;
	КонецЕсли;
	
	Возврат ОбъектМетаданных.Имя;
	
КонецФункции

Функция ТипыМетаданных()
	
	Типы = ОсновныеТипыМетаданных();
	Типы.Добавить("Enum");
	Типы.Добавить("CommonModule");
	Типы.Добавить("DataProcessor");
	Типы.Добавить("Report");
	Возврат Типы;
	
КонецФункции

Функция ОсновныеТипыМетаданных()
	
	Типы = Новый Массив;
	Типы.Добавить("Catalog");
	Типы.Добавить("Document");
	Типы.Добавить("InformationRegister");
	Типы.Добавить("AccumulationRegister");
	Типы.Добавить("Role");
	Возврат Типы;
	
КонецФункции

Функция ИмяКоллекцииМетаданных(Знач ТипМетаданных)
	
	ИменаКоллекций = Новый Соответствие;
	ИменаКоллекций.Вставить("Catalog", "Справочники");
	ИменаКоллекций.Вставить("Document", "Документы");
	ИменаКоллекций.Вставить("InformationRegister", "РегистрыСведений");
	ИменаКоллекций.Вставить("AccumulationRegister", "РегистрыНакопления");
	ИменаКоллекций.Вставить("Role", "Роли");
	ИменаКоллекций.Вставить("Enum", "Перечисления");
	ИменаКоллекций.Вставить("CommonModule", "ОбщиеМодули");
	ИменаКоллекций.Вставить("DataProcessor", "Обработки");
	ИменаКоллекций.Вставить("Report", "Отчеты");
	Возврат ИменаКоллекций.Получить(ТипМетаданных);
	
КонецФункции

Функция ПолучитьКоллекциюМетаданных(Знач ИмяКоллекции)
	
	Если ИмяКоллекции = "Справочники" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли ИмяКоллекции = "Документы" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли ИмяКоллекции = "РегистрыСведений" Тогда
		Возврат Метаданные.РегистрыСведений;
	ИначеЕсли ИмяКоллекции = "РегистрыНакопления" Тогда
		Возврат Метаданные.РегистрыНакопления;
	ИначеЕсли ИмяКоллекции = "Роли" Тогда
		Возврат Метаданные.Роли;
	ИначеЕсли ИмяКоллекции = "Перечисления" Тогда
		Возврат Метаданные.Перечисления;
	ИначеЕсли ИмяКоллекции = "ОбщиеМодули" Тогда
		Возврат Метаданные.ОбщиеМодули;
	ИначеЕсли ИмяКоллекции = "Обработки" Тогда
		Возврат Метаданные.Обработки;
	ИначеЕсли ИмяКоллекции = "Отчеты" Тогда
		Возврат Метаданные.Отчеты;
	Иначе
		// Коллекция вне whitelist инструмента: явная ошибка валидации, а не пустой результат.
		// ВызватьОшибкуВалидацииИнструмента бросает исключение - до Возврата ниже не доходим.
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Неподдерживаемая коллекция метаданных: %1'"),
			ИмяКоллекции);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

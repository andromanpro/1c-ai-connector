#Область СлужебныйПрограммныйИнтерфейс

// Проверяет подтвержденный контракт провайдера и формата API.
// Параметры:
//  Модель - СправочникСсылка.КИИ_МоделиИИ - настройка эмбеддера.
// Возвращаемое значение:
//  Булево - поддерживается массив строк и корреляция ответа по index.
Функция ПоддерживаетПакеты(Знач Модель) Экспорт
	Параметры = КИИ_КоннекторИИ.ПараметрыМодели(Модель);
	Провайдер = НРег(СокрЛП(Параметры.НаименованиеПровайдера));
	Возврат (
		Параметры.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible
			И (Провайдер = "openai" Или Провайдер = "openrouter"))
		Или (Параметры.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.GigaChat И Провайдер = "gigachat");
КонецФункции

// Версия значимых настроек подключения, модели, размерности и контроля данных.
// Параметры:
//  Модель - СправочникСсылка.КИИ_МоделиИИ - настройка эмбеддера.
// Возвращаемое значение:
//  Строка - SHA256; изменение представления модели не меняет версию.
Функция ВерсияМодели(Знач Модель) Экспорт
	Параметры = КИИ_КоннекторИИ.ПараметрыМодели(Модель);
	Для Каждого Имя Из СтрРазделить(
		"Наименование,Температура,МаксимумТокенов,СрокЖизниКеша,ВерсияСхемыКеша,ПоддерживаетИнструменты,Таймаут,АдресЗапроса",
		",") Цикл
		Параметры.Удалить(Имя);
	КонецЦикла;
	Настройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Модель,
		"ПометкаУдаления,ТипМодели,EndpointЭмбеддингов,РазмерностьЭмбеддинга,КлассEgress,РежимКонтроляПерсональныхДанных");
	Возврат Хеш(ЗначениеВСтрокуВнутр(Параметры) + ЗначениеВСтрокуВнутр(Настройки));
КонецФункции

// Читает исходный текст и действующую политику для подготовки запроса и условной записи.
// Параметры:
//  Фрагмент - СправочникСсылка.КИИ_ФрагментыЗнаний - сохраненный фрагмент.
// Возвращаемое значение:
//  - Неопределено - данные отсутствуют либо результат отклонен.
//  - Структура - данные успешной обработки:
//      * Ссылка - СправочникСсылка.КИИ_ФрагментыЗнаний - фрагмент.
//      * Текст - Строка - исходный текст.
//      * Владелец - СправочникСсылка.КИИ_БазаЗнаний - база знаний.
//      * Категория - СправочникСсылка.КИИ_КатегорииЗнаний - категория базы.
//      * Политика - ПеречислениеСсылка.КИИ_ПолитикиЭмбеддинга - действующая политика.
//      * ПометкаУдаления - Булево - фрагмент помечен на удаление.
//      * БазаУдалена - Булево - база помечена на удаление.
Функция УсловияФрагмента(Знач Фрагмент) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
        "ВЫБРАТЬ
        | Ф.Ссылка КАК Ссылка, Ф.ТекстФрагмента КАК Текст,
        | Ф.Владелец КАК Владелец, Ф.ПометкаУдаления КАК ПометкаУдаления,
        | Б.Категория КАК Категория, Б.ПометкаУдаления КАК БазаУдалена,
        | ВЫБОР КОГДА Б.ПолитикаЭмбеддингаПереопределение
        |   = ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ПустаяСсылка)
        | ТОГДА К.ПолитикаЭмбеддинга ИНАЧЕ Б.ПолитикаЭмбеддингаПереопределение КОНЕЦ КАК Политика
        |ИЗ Справочник.КИИ_ФрагментыЗнаний КАК Ф
        | ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КИИ_БазаЗнаний КАК Б ПО Ф.Владелец = Б.Ссылка
        | ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КИИ_КатегорииЗнаний КАК К ПО Б.Категория = К.Ссылка
        |ГДЕ Ф.Ссылка = &Фрагмент";
	Запрос.УстановитьПараметр("Фрагмент", Фрагмент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Выборка.Ссылка);
	Результат.Вставить("Текст", Выборка.Текст);
	Результат.Вставить("Владелец", Выборка.Владелец);
	Результат.Вставить("Категория", Выборка.Категория);
	Результат.Вставить("Политика", Выборка.Политика);
	Результат.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
	Результат.Вставить("БазаУдалена", Выборка.БазаУдалена);
	Возврат Результат;
КонецФункции

// Повторная проверка перед отправкой, без транзакции и блокировок на время HTTP.
// Параметры:
//  Задание - Структура - исходные условия и результат контроля персональных данных.
//  КлассEgress - ПеречислениеСсылка.КИИ_ПолитикиЭмбеддинга - класс эмбеддера.
// Возвращаемое значение:
//  Строка - ГотовКОтправке, ТекстИзменился, УсловияИзменились, ЗапрещеноПолитикой.
Функция ПроверитьУсловия(Знач Задание, Знач КлассEgress) Экспорт
	Возврат СтатусУсловий(Задание.Условия, УсловияФрагмента(Задание.Условия.Ссылка), КлассEgress);
КонецФункции

// Выполняет один запрос и проверяет весь набор векторов до первой записи.
// Параметры:
//  Задания - Массив из Структура - подготовленные тексты и контексты контроля.
//  Модель - СправочникСсылка.КИИ_МоделиИИ - настройка эмбеддера.
//  Сведения - Структура - имя модели, endpoint и размерность.
//  ПакетныйВвод - Булево - передать массив строк вместо одиночной строки.
// Возвращаемое значение:
//  Структура - результат проверки всего ответа:
//   * Векторы - Массив, Неопределено - проверенные векторы; отказ при некорректном ответе.
//   * ИсходЗапроса - Строка - состояние отправленного запроса.
//   * ТекстОшибки - Строка - причина отказа.
Функция ПолучитьВекторы(Знач Задания, Знач Модель, Знач Сведения, Знач ПакетныйВвод) Экспорт
	Тексты = Новый Массив;
	Контексты = Новый Массив;
	Для Каждого Задание Из Задания Цикл
		Тексты.Добавить(Задание.Контроль.Текст);
		Контексты.Добавить(Задание.Контроль.Контекст);
	КонецЦикла;
	Тело = Новый Структура("model,input", Сведения.НаименованиеПолное, ?(ПакетныйВвод, Тексты, Тексты[0]));
	Ответ = КИИ_КоннекторИИ.ВыполнитьHTTPЗапросМодели(Модель, Сведения.Endpoint, Тело, "embedding", Контексты);
	Результат = Новый Структура(
		"Векторы,ИсходЗапроса,ТекстОшибки", Неопределено, Ответ.ИсходЗапроса, Ответ.ТекстОшибки);
	Если Ответ.ЭтоОшибка Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Если ПакетныйВвод Тогда
			Результат.Векторы = РазобратьПакет(Ответ.ОтветJSON, Задания.Количество(), Сведения.Размерность);
		Иначе
			Результат.Векторы = Новый Массив;
			Параметры = ПроверитьВектор(Ответ.Разобранное, Сведения.Размерность);
			Если Параметры = Неопределено Тогда
				Результат.Векторы = Неопределено;
			Иначе
				Результат.Векторы.Добавить(Параметры);
			КонецЕсли;
		КонецЕсли;
	Исключение
		// В том числе переполнение при вычислении нормы: весь ответ отклоняется.
		Результат.Векторы = Неопределено;
	КонецПопытки;
	Если Результат.Векторы = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Эмбеддер вернул некорректный набор векторов'");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Короткая условная запись общего одиночного и пакетного пути. HTTP здесь не выполняется.
// Параметры:
//  Задание - Структура - исходные условия фрагмента.
//  Модель - СправочникСсылка.КИИ_МоделиИИ - настройка эмбеддера.
//  Версия - Строка - версия значимых настроек до HTTP.
//  Сведения - Структура - класс egress и размерность.
//  КодМодели - Строка - провайдер и имя модели.
//  ПараметрыВектора - Структура - проверенный нормализованный вектор, размерность и норма.
// Возвращаемое значение:
//  Строка - статус условной записи.
Функция ЗаписатьВектор(
	Знач Задание, Знач Модель, Знач Версия, Знач Сведения, Знач КодМодели, Знач ПараметрыВектора) Экспорт
	Исходные = Задание.Условия;
	ВнешняяТранзакция = ТранзакцияАктивна();
	ОбъектЗаблокирован = Ложь;
	НачатьТранзакцию();
	Попытка
		// Один порядок для обоих путей: модель, категория, база, фрагмент.
		ЗаблокироватьСсылку("КИИ_МоделиИИ", Модель, РежимБлокировкиДанных.Разделяемый);
		ЗаблокироватьСсылку("КИИ_КатегорииЗнаний", Исходные.Категория, РежимБлокировкиДанных.Разделяемый);
		ЗаблокироватьСсылку("КИИ_БазаЗнаний", Исходные.Владелец, РежимБлокировкиДанных.Разделяемый);
		ЗаблокироватьСсылку("КИИ_ФрагментыЗнаний", Исходные.Ссылка, РежимБлокировкиДанных.Исключительный);
		Если ВерсияМодели(Модель) <> Версия Тогда
			Статус = "МодельИзменилась";
		Иначе
			Статус = СтатусУсловий(Исходные, УсловияФрагмента(Исходные.Ссылка), Сведения.КлассEgress);
		КонецЕсли;
		Если Статус = "ГотовКОтправке" Или Статус = "ЗапрещеноПолитикой" Тогда
			Объект = Исходные.Ссылка.ПолучитьОбъект();
			Объект.Заблокировать();
			ОбъектЗаблокирован = Истина;
			СтарыйКод = Объект.КодМоделиЭмбеддинга;
			Если Статус = "ЗапрещеноПолитикой" Тогда
				Объект.Эмбеддинг = Новый ХранилищеЗначения(Неопределено);
				Объект.НормаИсходная = 0;
				Объект.КодМоделиЭмбеддинга = "";
				Объект.Размерность = 0;
			Иначе
				Объект.Эмбеддинг = Новый ХранилищеЗначения(ПараметрыВектора.Нормализованный);
				Объект.НормаИсходная = ПараметрыВектора.Норма;
				Объект.КодМоделиЭмбеддинга = КодМодели;
				Объект.Размерность = ПараметрыВектора.Размерность;
				Объект.ХешТекстаФрагмента = Хеш(Исходные.Текст);
				Статус = "Обновлен";
			КонецЕсли;
			Объект.ДатаОбновления = ТекущаяДатаСеанса();
			Объект.Записать();
			ДобавитьИзменениеВектораВОчередь(
				Исходные.Ссылка, Статус, КодМодели, СтарыйКод, Объект.ХешТекстаФрагмента);
			Объект.Разблокировать();
			ОбъектЗаблокирован = Ложь;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Если ОбъектЗаблокирован Тогда
			Объект.Разблокировать();
		КонецЕсли;
		Если ВнешняяТранзакция Тогда
			ВызватьИсключение;
		КонецЕсли;
		ЗаписьЖурналаРегистрации(
			"КИИ.RAG.ОбновлениеЭмбеддингов",
			УровеньЖурналаРегистрации.Ошибка, ,
			Исходные.Ссылка,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "Ошибка";
	КонецПопытки;
	Возврат Статус;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтатусУсловий(Знач Исходные, Знач Текущие, Знач КлассEgress)
	Если Текущие = Неопределено Или Текущие.ПометкаУдаления Тогда
		Возврат "ТекстИзменился";
	КонецЕсли;
	Если ТипЗнч(Текущие.БазаУдалена) <> Тип("Булево") Или Текущие.БазаУдалена Тогда
		Возврат "ТекстИзменился";
	КонецЕсли;
	Если Текущие.Владелец <> Исходные.Владелец Или Текущие.Категория <> Исходные.Категория Тогда
		Возврат "УсловияИзменились";
	КонецЕсли;
	Если Не КИИ_RAG.РазрешенЭмбеддингПоПолитике(Текущие.Политика, КлассEgress) Тогда
		Возврат "ЗапрещеноПолитикой";
	КонецЕсли;
	Если Текущие.Текст <> Исходные.Текст Тогда
		Возврат "ТекстИзменился";
	КонецЕсли;
	Если Текущие.Политика <> Исходные.Политика Тогда
		Возврат "УсловияИзменились";
	КонецЕсли;
	Возврат "ГотовКОтправке";
КонецФункции

Процедура ЗаблокироватьСсылку(Знач ИмяСправочника, Знач Ссылка, Знач Режим)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник." + ИмяСправочника);
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Элемент.Режим = Режим;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция РазобратьПакет(Знач ОтветJSON, Знач Количество, Знач Размерность)
	// Действующая обертка использует JSONВЗначение(..., Ложь): это Структура.
	// Соответствие также допустимо, как в прежнем одиночном парсере.
	Данные = СвойствоJSON(ОтветJSON, "data");
	Если ТипЗнч(Данные) <> Тип("Массив") Или Данные.Количество() <> Количество Тогда
		Возврат Неопределено;
	КонецЕсли;
	Векторы = Новый Массив(Количество);
	ФактическаяРазмерность = Размерность;
	Для Каждого Элемент Из Данные Цикл
		Индекс = СвойствоJSON(Элемент, "index");
		Если ТипЗнч(Индекс) <> Тип("Число") Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Индекс <> Цел(Индекс) Или Индекс < 0 Или Индекс >= Количество Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Векторы[Индекс] <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Вектор = ПроверитьВектор(СвойствоJSON(Элемент, "embedding"), ФактическаяРазмерность);
		Если Вектор = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ФактическаяРазмерность = Вектор.Размерность;
		Векторы[Индекс] = Вектор;
	КонецЦикла;
	Возврат Векторы;
КонецФункции

// Проверяет сырой вектор для одиночного публичного и пакетного пути.
// Параметры:
//  Вектор - Массив из Число, Произвольный - данные ответа API.
//  Размерность - Число - ожидаемая размерность; 0 означает неизвестную.
// Возвращаемое значение:
//  - Неопределено - данные отсутствуют либо результат отклонен.
//  - Структура - данные успешной обработки:
//      * Нормализованный - Массив - вектор единичной нормы.
//      * Норма - Число - норма исходного вектора.
//      * Размерность - Число - число компонент вектора.
//      * Исходный - Массив - исходные числа без нормализации.
Функция ПроверитьВектор(Знач Вектор, Знач Размерность) Экспорт
	Попытка
		Возврат ПараметрыКорректногоВектора(Вектор, Размерность);
	Исключение
		// Переполнение нормы не должно прерывать поиск или обновление индекса.
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Параметры:
//  Вектор - Массив - проверенный ранее непустой массив чисел.
//  Размерность - Число - ожидаемый размер вектора.
// Возвращаемое значение:
//  - Неопределено - данные отсутствуют либо результат отклонен.
//  - Структура - данные успешной обработки:
//      * Нормализованный - Массив - вектор единичной нормы.
//      * Норма - Число - норма исходного вектора.
//      * Размерность - Число - число компонент вектора.
//      * Исходный - Массив - исходные числа без нормализации.
Функция ПараметрыКорректногоВектора(Знач Вектор, Знач Размерность)
	Если ТипЗнч(Вектор) <> Тип("Массив") Или Вектор.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Размерность > 0 И Вектор.Количество() <> Размерность Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сумма = 0;
	Для Каждого Координата Из Вектор Цикл
		Если ТипЗнч(Координата) <> Тип("Число") Тогда
			Возврат Неопределено;
		КонецЕсли;
		Сумма = Сумма + Координата * Координата;
	КонецЦикла;
	Если Сумма = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Норма = Pow(Сумма, 0.5);
	Результат = Новый Структура;
	Результат.Вставить("Нормализованный", КИИ_RAG.НормализоватьВектор(Вектор));
	Результат.Вставить("Норма", Норма);
	Результат.Вставить("Размерность", Вектор.Количество());
	Результат.Вставить("Исходный", Вектор);
	Возврат Результат;
КонецФункции

Функция Хеш(Знач Текст)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Текст);
	Возврат Base64Строка(Хеширование.ХешСумма);
КонецФункции

Функция СвойствоJSON(Знач ОбъектJSON, Знач Имя)
	Если ТипЗнч(ОбъектJSON) = Тип("Соответствие") Тогда
		Возврат ОбъектJSON.Получить(Имя);
	КонецЕсли;
	Если ТипЗнч(ОбъектJSON) = Тип("Структура") Тогда
		Значение = Неопределено;
		ОбъектJSON.Свойство(Имя, Значение);
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ДобавитьИзменениеВектораВОчередь(
	Знач Фрагмент, Знач Статус, Знач КодМодели, Знач СтарыйКод, Знач ХешТекста)
	Если Не КИИ_RAGQdrant.ЭтоБэкендQdrant() Тогда
		Возврат;
	КонецЕсли;
	Идентификатор = Строка(Фрагмент.УникальныйИдентификатор());
	Если Статус = "Обновлен" Тогда
		КИИ_RAGQdrant.ПоставитьВОчередь(Идентификатор, КодМодели, "upsert", ХешТекста);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтарыйКод) Тогда
		КИИ_RAGQdrant.ПоставитьВОчередь(Идентификатор, СтарыйКод, "delete");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

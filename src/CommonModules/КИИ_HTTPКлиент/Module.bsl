#Область ПрограммныйИнтерфейс

#Область HTTPЗапросы

// Выполняет HTTP-запрос и возвращает структурированный результат.
//
// Параметры:
//  Метод - Строка - HTTP метод (GET, POST, PUT, DELETE)
//  URL - Строка - полный URL запроса
//  Тело - Строка, Соответствие из КлючИЗначение, Структура, Неопределено - тело запроса.
//    Соответствие или Структура сериализуется в JSON автоматически
//  ДополнительныеЗаголовки - Соответствие из КлючИЗначение - дополнительные HTTP заголовки
//  Таймаут - Число - таймаут ожидания в секундах
//  Прокси - ИнтернетПрокси, Неопределено - прокси-сервер соединения (Неопределено = прямое)
//
// Возвращаемое значение:
//  Структура - результат запроса:
//   * КодСостояния - Число - HTTP код ответа
//   * Тело - Строка - тело ответа
//   * Заголовки - Соответствие из КлючИЗначение - заголовки ответа
//   * Успешно - Булево - Истина если код 200-299
//
// Опциональные параметры соответствуют полям HTTP-запроса; структура-обертка
// усложнила бы вызовы и сломала обратную совместимость публичного API.
// BSLLS:NumberOfOptionalParams-off
Функция ВыполнитьЗапрос(
	Знач Метод,
	Знач URL,
	Знач Тело = Неопределено,
	Знач ДополнительныеЗаголовки = Неопределено,
	Знач Таймаут = 30,
	Знач Прокси = Неопределено) Экспорт

	Перем РезультатМаркерОшибкиСериализацииJSON;

	Перем ЗначениеВВерхнемРегистре;
	Перем ДанныеОшибки;
// BSLLS:NumberOfOptionalParams-on

	Результат = НовыйРезультатЗапроса();

	Заголовки = ПодготовитьЗаголовки(ДополнительныеЗаголовки);

	// Сериализация тела
	ТелоСтрокой = "";
	Если Тело <> Неопределено Тогда
		Если ТипЗнч(Тело) = Тип("Строка") Тогда
			ТелоСтрокой = Тело;
		Иначе
			ТелоСтрокой = СтруктураВJson(Тело);
			Если Заголовки.Получить("Content-Type") = Неопределено Тогда
				Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			КонецЕсли;
		КонецЕсли;
		// Гвард #162: тело - сериализованное здесь ИЛИ переданное строкой уже сериализовавшим
		// вызывателем - не должно оказаться JSON-маркером сбоя сериализации, иначе не шлем битый запрос.
		РезультатМаркерОшибкиСериализацииJSON = МаркерОшибкиСериализацииJSON();
		Если СтрНайти(ТелоСтрокой, РезультатМаркерОшибкиСериализацииJSON) > 0 Тогда
			Результат.КодСостояния = 0;
			Результат.Тело = НСтр("ru = 'Ошибка сериализации тела запроса в JSON'");
			Результат.Успешно = Ложь;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	СтруктураURL = РазбитьURL(URL);

	Попытка
		Соединение = СоздатьHTTPСоединение(СтруктураURL, Таймаут, Прокси);

		HTTPЗапрос = Новый HTTPЗапрос(СтруктураURL.Адрес, Заголовки);
		Если ЗначениеЗаполнено(ТелоСтрокой) Тогда
			HTTPЗапрос.УстановитьТелоИзСтроки(ТелоСтрокой, КодировкаТекста.UTF8);
		КонецЕсли;

		ЗначениеВВерхнемРегистре = ВРег(Метод);
		HTTPОтвет = Соединение.ВызватьHTTPМетод(ЗначениеВВерхнемРегистре, HTTPЗапрос);

		Результат.КодСостояния = HTTPОтвет.КодСостояния;
		Результат.Тело = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
		Результат.Заголовки = ПрочитатьЗаголовкиОтвета(HTTPОтвет);
		Результат.Успешно = (HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300);
	Исключение
		Результат.КодСостояния = 0;
		ДанныеОшибки = ИнформацияОбОшибке();
		Результат.Тело = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		Результат.Успешно = Ложь;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выполняет HTTP-запрос с JSON телом и возвращает десериализованный ответ.
//
// Параметры:
//  Метод - Строка - HTTP метод
//  URL - Строка - полный URL
//  Тело - Соответствие из КлючИЗначение, Структура, Строка, Неопределено - данные запроса
//  ДополнительныеЗаголовки - Соответствие из КлючИЗначение - дополнительные заголовки
//  Таймаут - Число - таймаут в секундах
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - десериализованный JSON ответ. При ошибке содержит ключи error и status_code
//
Функция ВыполнитьЗапросJSON(
	Знач Метод,
	Знач URL,
	Знач Тело = Неопределено,
	Знач ДополнительныеЗаголовки = Неопределено,
	Знач Таймаут = 30) Экспорт

	Перем РезультатФункции;

	РезультатЗапроса = ВыполнитьЗапрос(Метод, URL, Тело, ДополнительныеЗаголовки, Таймаут);

	РезультатФункции = ОбработатьОтветJSON(РезультатЗапроса);
	Возврат РезультатФункции;

КонецФункции

// Извлекает результат JSON-RPC из ответа ВыполнитьЗапросJSON.
//
// ВыполнитьЗапросJSON на успехе отдает УЖЕ десериализованное тело (сам JSON-RPC
// объект с ключами result/error), а при HTTP/транспортной ошибке - {error, status_code}.
// Это НЕ конверт ВыполнитьЗапрос (КодСостояния/Тело) - те ключи здесь отсутствуют.
//
// Параметры:
//  Результат - Соответствие из КлючИЗначение - выход ВыполнитьЗапросJSON
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - {"Ошибка": текст} при JSON-RPC/HTTP-ошибке;
//    значение поля result напрямую при успехе; {"Данные": Результат} если ни result,
//    ни error не заданы.
//
Функция ИзвлечьРезультатJSONRPC(Знач Результат) Экспорт

	Перем ТекстОшибкиJSONRPC;
	Перем ПредставлениеЗначения;

	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		ОтветДанные = Новый Соответствие;
		ОтветДанные.Вставить("Данные", Результат);
		Возврат ОтветДанные;
	КонецЕсли;

	ОшибкаОтвета = Результат.Получить("error");
	Если ОшибкаОтвета <> Неопределено Тогда
		ОтветОшибки = Новый Соответствие;
		Если ТипЗнч(ОшибкаОтвета) = Тип("Соответствие") Тогда
			Сообщение = ОшибкаОтвета.Получить("message");
			ТекстОшибкиJSONRPC = ?(Сообщение = Неопределено, Строка(ОшибкаОтвета), Сообщение);
			ОтветОшибки.Вставить("Ошибка", ТекстОшибкиJSONRPC);
		Иначе
			ПредставлениеЗначения = Строка(ОшибкаОтвета);
			ОтветОшибки.Вставить("Ошибка", ПредставлениеЗначения);
		КонецЕсли;
		Возврат ОтветОшибки;
	КонецЕсли;

	РезультатRPC = Результат.Получить("result");
	Если РезультатRPC <> Неопределено Тогда
		Возврат РезультатRPC;
	КонецЕсли;

	ОтветДанные = Новый Соответствие;
	ОтветДанные.Вставить("Данные", Результат);
	Возврат ОтветДанные;

КонецФункции

// Выполняет HTTP-запрос с повторными попытками при неудаче.
// Использует экспоненциальный backoff: задержка удваивается после каждой попытки.
//
// Параметры:
//  Метод - Строка - HTTP метод
//  URL - Строка - полный URL
//  Тело - Соответствие из КлючИЗначение, Структура, Строка, Неопределено - данные запроса
//  ДополнительныеЗаголовки - Соответствие из КлючИЗначение - дополнительные заголовки
//  МаксимумПопыток - Число - максимальное количество попыток
//  НачальнаяЗадержка - Число - начальная задержка между попытками в секундах
//  Таймаут - Число - таймаут одного запроса в секундах
//  Прокси - ИнтернетПрокси, Неопределено - прокси для соединения; Неопределено - прокси по умолчанию
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - десериализованный JSON ответ последней попытки
//
// BSLLS:NumberOfOptionalParams-off
// BSLLS:NumberOfParams-off
Функция ВыполнитьЗапросСПовтором(
	Знач Метод,
	Знач URL,
	Знач Тело = Неопределено,
	Знач ДополнительныеЗаголовки = Неопределено,
	Знач МаксимумПопыток = 3,
	Знач НачальнаяЗадержка = 1,
	Знач Таймаут = 30,
	Знач Прокси = Неопределено) Экспорт

	Перем РезультатФункции;
// BSLLS:NumberOfParams-on
// BSLLS:NumberOfOptionalParams-on

	ТекущаяЗадержка = НачальнаяЗадержка;
	ПоследнийРезультат = Неопределено;

	Для НомерПопытки = 1 По МаксимумПопыток Цикл

		РезультатЗапроса = ВыполнитьЗапрос(Метод, URL, Тело, ДополнительныеЗаголовки, Таймаут, Прокси);

		Если РезультатЗапроса.Успешно Тогда
			РезультатФункции = ОбработатьОтветJSON(РезультатЗапроса);
			Возврат РезультатФункции;
		КонецЕсли;

		ПоследнийРезультат = РезультатЗапроса;

		// Повторяем ТОЛЬКО транзиентные коды (429/5xx). Перманентные (4xx) и сетевой сбой (код 0)
		// не повторяем - сразу отдаем последний результат (не молотим сервер, не двоим POST).
		Если Не ЭтоПовторяемыйКодОтвета(РезультатЗапроса.КодСостояния) Тогда
			Прервать;
		КонецЕсли;

		// Не ждем после последней неудачной попытки
		Если НомерПопытки < МаксимумПопыток Тогда
			Пауза(ТекущаяЗадержка);
			ТекущаяЗадержка = ТекущаяЗадержка * 2;
		КонецЕсли;

	КонецЦикла;

	// Все попытки неудачны
	РезультатФункции = ОбработатьОтветJSON(ПоследнийРезультат);
	Возврат РезультатФункции;

КонецФункции

// Выполняет multipart/form-data HTTP-запрос.
// Используется для отправки файлов (например, в Telegram API).
//
// Параметры:
//  URL - Строка - полный URL
//  ПоляФормы - Соответствие из КлючИЗначение - текстовые поля формы (ключ - значение)
//  Файлы - Соответствие из КлючИЗначение - файлы для отправки. Ключ - имя поля, значение - Структура:
//   * ИмяФайла - Строка - имя файла
//   * ДвоичныеДанные - ДвоичныеДанные - содержимое файла
//   * ТипКонтента - Строка - MIME-тип (по умолчанию application/octet-stream)
//  ДополнительныеЗаголовки - Соответствие из КлючИЗначение - дополнительные заголовки
//  Таймаут - Число - таймаут в секундах
//  Прокси - ИнтернетПрокси, Неопределено - прокси для соединения; Неопределено - прокси по умолчанию
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - десериализованный JSON ответ
//
// BSLLS:NumberOfOptionalParams-off
Функция ВыполнитьМногочастныйЗапрос(
	Знач URL,
	Знач ПоляФормы = Неопределено,
	Знач Файлы = Неопределено,
	Знач ДополнительныеЗаголовки = Неопределено,
	Знач Таймаут = 30,
	Знач Прокси = Неопределено) Экспорт

	Перем ДвоичныеДанныеИзСтрокиЗначение;

	Перем ДанныеОшибки;
	Перем ПодробностиОшибки;

	Перем ПредставлениеЗначения;
	Перем РезультатФункции;
// BSLLS:NumberOfOptionalParams-on

	ПредставлениеЗначения = Строка(Новый УникальныйИдентификатор);
	Граница = СтрЗаменить(ПредставлениеЗначения, "-", "");
	РазделительСтрок = Символы.ВК + Символы.ПС;

	ПотокДанных = Новый ПотокВПамяти;
	ЗаписьДанных = Новый ЗаписьДанных(ПотокДанных);

	// Текстовые поля формы
	Если ПоляФормы <> Неопределено Тогда
		Для Каждого ПолеФормы Из ПоляФормы Цикл
			ТекстЧасти = "--"
				+ Граница
				+ РазделительСтрок
				+ "Content-Disposition: form-data; name="""
				+ ОчиститьПараметрЗаголовкаЧасти(ПолеФормы.Ключ)
				+ """"
				+ РазделительСтрок
				+ РазделительСтрок
				+ Строка(ПолеФормы.Значение)
				+ РазделительСтрок;
			ДвоичныеДанныеИзСтрокиЗначение = ПолучитьДвоичныеДанныеИзСтроки(ТекстЧасти, "UTF-8");
			ЗаписьДанных.Записать(ДвоичныеДанныеИзСтрокиЗначение);
		КонецЦикла;
	КонецЕсли;

	// Файлы
	Если Файлы <> Неопределено Тогда
		Для Каждого ЭлементФайла Из Файлы Цикл
			ЗаписатьЧастьФайлаФормы(ЗаписьДанных, Граница, РазделительСтрок, ЭлементФайла);
		КонецЦикла;
	КонецЕсли;

	// Завершающая граница
	ДвоичныеДанныеИзСтрокиЗначение = ПолучитьДвоичныеДанныеИзСтроки("--" + Граница + "--" + РазделительСтрок, "UTF-8");
	ЗаписьДанных.Записать(ДвоичныеДанныеИзСтрокиЗначение);
	ЗаписьДанных.Закрыть();

	ДвоичноеТело = ПотокДанных.ЗакрытьИПолучитьДвоичныеДанные();

	// Подготовка заголовков
	Заголовки = ПодготовитьЗаголовки(ДополнительныеЗаголовки);
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);

	СтруктураURL = РазбитьURL(URL);

	Попытка
		Соединение = СоздатьHTTPСоединение(СтруктураURL, Таймаут, Прокси);

		HTTPЗапрос = Новый HTTPЗапрос(СтруктураURL.Адрес, Заголовки);
		HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ДвоичноеТело);

		HTTPОтвет = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);

		РезультатЗапроса = НовыйРезультатЗапроса();
		РезультатЗапроса.КодСостояния = HTTPОтвет.КодСостояния;
		РезультатЗапроса.Тело = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
		РезультатЗапроса.Заголовки = ПрочитатьЗаголовкиОтвета(HTTPОтвет);
		РезультатЗапроса.Успешно = (HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300);

		РезультатФункции = ОбработатьОтветJSON(РезультатЗапроса);
		Возврат РезультатФункции;
	Исключение
		ОтветСоответствие = Новый Соответствие;
		ДанныеОшибки = ИнформацияОбОшибке();
		ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		ОтветСоответствие.Вставить("error", ПодробностиОшибки);
		ОтветСоответствие.Вставить("status_code", 0);
		Возврат ОтветСоответствие;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область РаботаСJSON

// Десериализует JSON-строку в Соответствие/Массив.
//
// Параметры:
//  ТекстJSON - Строка, ДвоичныеДанные - JSON для десериализации
//  ВСоответствие - Булево - Истина для Соответствие, Ложь для Структура
//
// Возвращаемое значение:
//  Произвольный - десериализованные данные (Соответствие, Массив или примитив)
//
Функция JsonВСтруктуру(Знач ТекстJSON, Знач ВСоответствие = Истина) Экспорт

	Если ТипЗнч(ТекстJSON) = Тип("ДвоичныеДанные") Тогда
		ТекстJSON = ПолучитьСтрокуИзДвоичныхДанных(ТекстJSON);
	КонецЕсли;

	Если ТипЗнч(ТекстJSON) <> Тип("Строка") Тогда
		ТекстJSON = Строка(ТекстJSON);
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);

	Данные = ПрочитатьJSON(ЧтениеJSON, ВСоответствие, Неопределено, ФорматДатыJSON.ISO);
	ЧтениеJSON.Закрыть();

	Возврат Данные;

КонецФункции

// Сериализует данные в JSON-строку.
//
// Параметры:
//  Данные - Произвольный - данные для сериализации (Соответствие, Структура, Массив, примитив)
//  СПереносомСтрок - Булево - форматировать с переносами строк
//
// Возвращаемое значение:
//  Строка - JSON-представление данных
//
Функция СтруктураВJson(Знач Данные, Знач СПереносомСтрок = Ложь) Экспорт

	Перем ТекстСообщения;
	Перем ДанныеОшибки;
	Перем ПодробностиОшибки;

	Перем РезультатФункции;

	Перенос = ?(СПереносомСтрок, ПереносСтрокJSON.Windows, ПереносСтрокJSON.Нет);

	ПараметрыJSON = Новый ПараметрыЗаписиJSON(
		Перенос, " ", Истина, ЭкранированиеСимволовJSON.Нет, Ложь, Ложь, Ложь, Ложь);

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
		ЗаписатьJSON(ЗаписьJSON, Данные);
		РезультатФункции = ЗаписьJSON.Закрыть();
		Возврат РезультатФункции;
	Исключение
		// Тихий Возврат Строка(Данные) слал «Структура»/мусор как валидный JSON в тело запроса
		// или на клиент, а исключение пропадало без следа (аудит P3). Логируем сбой и возвращаем
		// явный JSON-маркер ошибки - валидный JSON, но заведомо не успешный ответ.
		ТекстСообщения = НСтр("ru = 'КИИ.HTTPКлиент.Сериализация'");
		ДанныеОшибки = ИнформацияОбОшибке();
		ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, , , ПодробностиОшибки);
		РезультатФункции = "{""" + МаркерОшибкиСериализацииJSON() + """: true}";
		Возврат РезультатФункции;
	КонецПопытки;

КонецФункции

// Очищает значение параметра multipart-заголовка от символов, ломающих Content-Disposition:
// CR/LF (инъекция произвольного заголовка) и двойную кавычку (обрыв name/filename). Имя файла,
// тип контента и имя поля могут прийти из недоверенных данных (аудит P3, header injection).
//
// Параметры:
//  Значение - Строка - исходное значение параметра заголовка.
//
// Возвращаемое значение:
//  Строка - значение без CR, LF и двойных кавычек.
Функция ОчиститьПараметрЗаголовкаЧасти(Знач Значение) Экспорт

	Значение = Строка(Значение);
	Значение = СтрЗаменить(Значение, Символы.ВК, "");
	Значение = СтрЗаменить(Значение, Символы.ПС, "");
	Значение = СтрЗаменить(Значение, """", "'");
	Возврат Значение;

КонецФункции

#КонецОбласти

#Область ПреобразованиеТипов

// Безопасно преобразует значение в строку.
//
// Параметры:
//  Значение - Произвольный - преобразуемое значение
//
// Возвращаемое значение:
//  Строка - строковое представление значения
//
Функция ПолучитьСтрокуБезопасно(Знач Значение) Экспорт

	Перем РезультатФункции;

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		РезультатФункции = ЧислоВСтроку(Значение);
		Возврат РезультатФункции;
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		РезультатФункции = ?(Значение, "true", "false");
		Возврат РезультатФункции;
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		РезультатФункции = XMLСтрока(Значение);
		Возврат РезультатФункции;
	ИначеЕсли ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		РезультатФункции = ПолучитьСтрокуИзДвоичныхДанных(Значение);
		Возврат РезультатФункции;
	Иначе
		Попытка
			РезультатФункции = Строка(Значение);
			Возврат РезультатФункции;
		Исключение
			Возврат "";
		КонецПопытки;
	КонецЕсли;

КонецФункции

// Безопасно преобразует значение в число.
//
// Параметры:
//  Значение - Произвольный - преобразуемое значение
//  ЗначениеПоУмолчанию - Число - возвращается при невозможности преобразования
//
// Возвращаемое значение:
//  Число - числовое значение
//
Функция ПолучитьЧислоБезопасно(Знач Значение, Знач ЗначениеПоУмолчанию = 0) Экспорт

	Перем РезультатФункции;

	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		РезультатФункции = ?(Значение, 1, 0);
		Возврат РезультатФункции;
	Иначе
		ОписаниеТипа = Новый ОписаниеТипов("Число");
		РезультатПреобразования = ОписаниеТипа.ПривестиЗначение(Значение);
		РезультатФункции = ?(
			РезультатПреобразования = 0 И Значение <> 0 И Значение <> "0",
			ЗначениеПоУмолчанию,
			РезультатПреобразования);
		Возврат РезультатФункции;
	КонецЕсли;

КонецФункции

// Безопасно преобразует значение в булево.
//
// Параметры:
//  Значение - Произвольный - преобразуемое значение
//  ЗначениеПоУмолчанию - Булево - возвращается при невозможности преобразования
//
// Возвращаемое значение:
//  Булево - логическое значение
//
Функция ПолучитьБулевоБезопасно(Знач Значение, Знач ЗначениеПоУмолчанию = Ложь) Экспорт

	Перем РезультатФункции;
	Перем ЗначениеБезПробелов;

	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		РезультатФункции = Значение <> 0;
		Возврат РезультатФункции;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		ЗначениеБезПробелов = СокрЛП(Значение);
		ЗначениеНижний = НРег(ЗначениеБезПробелов);
		РезультатФункции = ЗначениеНижний = "true"
			Или ЗначениеНижний = "да"
			Или ЗначениеНижний = "истина"
			Или ЗначениеНижний = "1";
		Возврат РезультатФункции;
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Маркер-подстрока, которой СтруктураВJson помечает результат при сбое сериализации.
// Потребители (ВыполнитьЗапрос) детектируют ее, чтобы не слать заведомо битое тело.
//
// Возвращаемое значение:
//  Строка - подстрока-маркер сбоя сериализации.
Функция МаркерОшибкиСериализацииJSON()
	Возврат "__ОшибкаСериализацииJSON__";
КонецФункции

// Разбирает URL на составляющие: сервер, порт, адрес, протокол.
//
// Параметры:
//  URL - Строка - полный URL
//
// Возвращаемое значение:
//  Структура:
//   * Сервер - Строка
//   * Адрес - Строка
//   * Порт - Число - явно указанный порт или стандартный порт протокола
//   * Защищенное - Булево
//
Функция РазбитьURL(Знач URL) Экспорт

	Перем АдресДляПроверкиHTTP;
	Перем ЗначениеВНижнемРегистре2;
	Перем РезультатРазобратьПорт;
	Перем ЗначениеВНижнемРегистре;
	Перем ДлинаТекста;

	ЗначениеВНижнемРегистре2 = НРег(URL);
	ЗащищенноеСоединение = Не СтрНачинаетсяС(ЗначениеВНижнемРегистре2, "http://");

	// Снимаем ТОЛЬКО префикс схемы. Глобальный СтрЗаменить вырезал бы https://|http:// и из
	// query/пути (напр. ?callback=https://…), искажая адрес и параметры запроса (аудит P1).
	ЗначениеВНижнемРегистре = НРег(URL);
	Если СтрНачинаетсяС(ЗначениеВНижнемРегистре, "https://") Тогда
		ДлинаТекста = СтрДлина("https://");
		URL = Сред(URL, ДлинаТекста + 1);
	Иначе
		АдресДляПроверкиHTTP = НРег(URL);
		Если СтрНачинаетсяС(АдресДляПроверкиHTTP, "http://") Тогда
			ДлинаТекста = СтрДлина("http://");
			URL = Сред(URL, ДлинаТекста + 1);
		Иначе
			// URL без схемы (host/path) - разбираем как есть, схема определяется вызывающим.
			URL = СокрЛП(URL);
		КонецЕсли;
	КонецЕсли;

	// Отделяем authority от пути/квери.
	ПозицияСлеша = СтрНайти(URL, "/");
	Если ПозицияСлеша = 0 Тогда
		Адрес = "/";
		Authority = URL;
	Иначе
		Адрес = Сред(URL, ПозицияСлеша);
		Authority = Лев(URL, ПозицияСлеша - 1);
	КонецЕсли;

	// userinfo (user:pass@host) отбрасываем - иначе ':' в учетных данных ломал разбор порта (аудит P2).
	ПозицияСобаки = СтрНайти(Authority, "@", НаправлениеПоиска.СКонца);
	Если ПозицияСобаки > 0 Тогда
		Authority = Сред(Authority, ПозицияСобаки + 1);
	КонецЕсли;

	// host[:port] с поддержкой IPv6-литерала [::1]:port - иначе ':' внутри адреса ломал порт (аудит P2).
	ДоменИПорт = РазобратьДоменИПорт(Authority);

	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Сервер", ДоменИПорт.Домен);
	СтруктураВозврата.Вставить("Адрес", Адрес);
	РезультатРазобратьПорт = РазобратьПорт(ДоменИПорт.ПортСтрока, ЗащищенноеСоединение);
	СтруктураВозврата.Вставить("Порт", РезультатРазобратьПорт);
	СтруктураВозврата.Вставить("Защищенное", ЗащищенноеСоединение);

	Возврат СтруктураВозврата;

КонецФункции

// Делит authority на домен и строку порта. IPv6-литерал [::1]:port разбирается по закрывающей
// скобке - двоеточия внутри скобок не являются разделителем порта.
// Параметры:
//  Authority - Строка - узел и необязательный порт без пользовательских данных.
// Возвращаемое значение:
//  Структура:
//   * Домен - Строка - имя узла или IPv6 в квадратных скобках.
//   * ПортСтрока - Строка - строка порта либо пустая строка.
//
Функция РазобратьДоменИПорт(Знач Authority)

	Результат = Новый Структура("Домен, ПортСтрока", Authority, "");

	Если СтрНачинаетсяС(Authority, "[") Тогда
		ПозицияСкобки = СтрНайти(Authority, "]");
		Если ПозицияСкобки > 0 Тогда
			Результат.Домен = Лев(Authority, ПозицияСкобки);
			Остаток = Сред(Authority, ПозицияСкобки + 1);
			Результат.ПортСтрока = ?(СтрНачинаетсяС(Остаток, ":"), Сред(Остаток, 2), "");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(Authority, ":");
	Если ПозицияДвоеточия <> 0 Тогда
		Результат.Домен = Лев(Authority, ПозицияДвоеточия - 1);
		Результат.ПортСтрока = Сред(Authority, ПозицияДвоеточия + 1);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Валидный порт (1..65535) либо дефолт схемы (443/80). Раньше битый/пустой порт молча давал
// Порт=0 → соединение на порт 0 (аудит P2).
Функция РазобратьПорт(Знач ПортСтрока, Знач ЗащищенноеСоединение)

	Перем ФрагментТекста;

	Перем РезультатФункции;

	ПортСтрока = СокрЛП(ПортСтрока);
	ЭтоЧисло = СтрДлина(ПортСтрока) > 0;
	Для Индекс = 1 По СтрДлина(ПортСтрока) Цикл
		ФрагментТекста = Сред(ПортСтрока, Индекс, 1);
		Если СтрНайти("0123456789", ФрагментТекста) = 0 Тогда
			ЭтоЧисло = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЭтоЧисло Тогда
		Значение = Число(ПортСтрока);
		Если Значение > 0 И Значение <= 65535 Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	РезультатФункции = ?(ЗащищенноеСоединение, 443, 80);
	Возврат РезультатФункции;

КонецФункции

// Возвращает прокси по умолчанию для исходящих HTTP-запросов: собирается из константы
// КИИ_АдресПроксиИнтернет ("host:port" либо пусто). Единая точка настройки прокси ИИконы:
// коннектор ИИ, Telegram-уведомления и прочие потребители КИИ_HTTPКлиент берут прокси отсюда.
//
// Возвращаемое значение:
//  ИнтернетПрокси, Неопределено - прокси для исходящих запросов либо Неопределено (соединение по умолчанию)
//
Функция ПроксиПоУмолчанию() Экспорт

	Перем РезультатФункции;

	АдресПрокси = Константы.КИИ_АдресПроксиИнтернет.Получить();
	РезультатФункции = СформироватьПроксиИзАдреса(АдресПрокси);
	Возврат РезультатФункции;

КонецФункции

// Тестовый seam: сборка прокси из строки адреса (обертка приватной СформироватьПроксиИзАдреса).
// Только для модульных тестов.
//
// Параметры:
//  АдресПрокси - Строка - "host:port" или пусто
//
// Возвращаемое значение:
//  ИнтернетПрокси, Неопределено - см. СформироватьПроксиИзАдреса
//
Функция СформироватьПроксиДляТестов(Знач АдресПрокси) Экспорт

	Перем РезультатФункции;

	РезультатФункции = СформироватьПроксиИзАдреса(АдресПрокси);
	Возврат РезультатФункции;

КонецФункции

// Чистая функция: разбирает строку "host:port" и собирает ИнтернетПрокси с обходом
// локальных адресов (RFC1918) - локальный LiteLLM-шлюз / Ollama работают мимо прокси.
//
// Параметры:
//  АдресПрокси - Строка - "host:port" или пусто
//
// Возвращаемое значение:
//  ИнтернетПрокси, Неопределено - либо объект с http/https установкой
//                                 либо Неопределено при пустой/невалидной строке
//
Функция СформироватьПроксиИзАдреса(АдресПрокси)

	Перем ЗначениеБезПробелов;
	Перем ТекстСообщения;

	Если ПустаяСтрока(АдресПрокси) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Непустой, но невалидный адрес - это ошибка КОНФИГУРАЦИИ, а не "прокси не задан".
	// Молча возвращать Неопределено нельзя: запросы ушли бы мимо прокси (вплоть до прямого
	// выхода в интернет), и админ не понял бы, почему его настройка не работает.
	Части = СтрРазделить(АдресПрокси, ":", Ложь);
	Хост = ?(Части.Количество() > 0, СокрЛП(Части[0]), "");
	Порт = 0;
	Если Части.Количество() = 2 И Не ПустаяСтрока(Хост) Тогда
		// Приведение через БСП, а не Попытка/Исключение: невалидная строка дает Неопределено,
		// а исключение как штатная ветка разбора - антипаттерн (BSLLS TryNumber).
		ЗначениеБезПробелов = СокрЛП(Части[1]);
		ПортИзСтроки = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЗначениеБезПробелов);
		Если ПортИзСтроки <> Неопределено Тогда
			Порт = ПортИзСтроки;
		КонецЕсли;
	КонецЕсли;

	АдресНекорректен = Части.Количество() <> 2 Или ПустаяСтрока(Хост) Или Порт <= 0 Или Порт > 65535;
	Если АдресНекорректен Тогда
		ТекстДляЖурнала = СтрШаблон(
			НСтр("ru = 'Некорректный адрес прокси в константе КИИ_АдресПроксиИнтернет: ""%1"".
				|Ожидается формат ""хост:порт"" (порт 1-65535). Прокси не применен.'"),
			АдресПрокси);
		ТекстСообщения = НСтр("ru = 'КИИ.HTTPКлиент'");
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, , , ТекстДляЖурнала);
		Возврат Неопределено;
	КонецЕсли;

	Прокси = Новый ИнтернетПрокси(Ложь);
	Прокси.Установить("http", Хост, Порт);
	Прокси.Установить("https", Хост, Порт);
	Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = Истина;
	МаскиОбхода = Прокси.НеИспользоватьПроксиДляАдресов;
	Для Каждого Маска Из МаскиЛокальныхАдресов() Цикл
		МаскиОбхода.Добавить(Маска);
	КонецЦикла;

	Возврат Прокси;

КонецФункции

// Маски адресов, минующих прокси: локальный хост и приватные диапазоны RFC1918.
//
// Возвращаемое значение:
//  Массив из Строка - маски для НеИспользоватьПроксиДляАдресов
//
Функция МаскиЛокальныхАдресов()

	Перем ФорматированноеЗначение;

	Маски = Новый Массив;
	Маски.Добавить("localhost");
	Маски.Добавить("127.*");
	Маски.Добавить("192.168.*");
	Маски.Добавить("10.*");
	Для НомерПодсети = 16 По 31 Цикл
		ФорматированноеЗначение = Формат(НомерПодсети, "ЧГ=");
		Маски.Добавить("172." + ФорматированноеЗначение + ".*");
	КонецЦикла;

	Возврат Маски;

КонецФункции

// Создает HTTP-соединение по параметрам URL.
Функция СоздатьHTTPСоединение(Знач СтруктураURL, Знач Таймаут, Знач Прокси = Неопределено)

	Перем РезультатФункции;

	Если Прокси = Неопределено Тогда
		Прокси = ПроксиПоУмолчанию();
	КонецЕсли;

	Если СтруктураURL.Защищенное Тогда
		РезультатФункции = Новый HTTPСоединение(
			СтруктураURL.Сервер, СтруктураURL.Порт, , , Прокси, Таймаут, Новый ЗащищенноеСоединениеOpenSSL);
		Возврат РезультатФункции;
	Иначе
		РезультатФункции = Новый HTTPСоединение(СтруктураURL.Сервер, СтруктураURL.Порт, , , Прокси, Таймаут);
		Возврат РезультатФункции;
	КонецЕсли;

КонецФункции

// Подготавливает соответствие заголовков, объединяя с дополнительными.
Функция ПодготовитьЗаголовки(Знач ДополнительныеЗаголовки)

	Заголовки = Новый Соответствие;

	Если ДополнительныеЗаголовки <> Неопределено Тогда
		Для Каждого Заголовок Из ДополнительныеЗаголовки Цикл
			Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Заголовки;

КонецФункции

// Читает заголовки из HTTP-ответа в Соответствие.
Функция ПрочитатьЗаголовкиОтвета(Знач HTTPОтвет)

	ЗаголовкиОтвета = Новый Соответствие;

	Для Каждого Заголовок Из HTTPОтвет.Заголовки Цикл
		ЗаголовкиОтвета.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;

	Возврат ЗаголовкиОтвета;

КонецФункции

// Создает пустую структуру результата HTTP-запроса.
Функция НовыйРезультатЗапроса()

	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("Тело", "");
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("Успешно", Ложь);

	Возврат Результат;

КонецФункции

// Обрабатывает результат запроса и возвращает JSON-соответствие.
Функция ОбработатьОтветJSON(Знач РезультатЗапроса)

	Перем РезультатФункции;

	Если РезультатЗапроса = Неопределено Тогда
		ОтветСоответствие = Новый Соответствие;
		ОтветСоответствие.Вставить("error", "Нет результата");
		ОтветСоответствие.Вставить("status_code", 0);
		Возврат ОтветСоответствие;
	КонецЕсли;

	Если РезультатЗапроса.Успешно И ЗначениеЗаполнено(РезультатЗапроса.Тело) Тогда
		Попытка
			РезультатФункции = JsonВСтруктуру(РезультатЗапроса.Тело);
			Возврат РезультатФункции;
		Исключение
			ОтветСоответствие = Новый Соответствие;
			ОтветСоответствие.Вставить("result", РезультатЗапроса.Тело);
			ОтветСоответствие.Вставить("status_code", РезультатЗапроса.КодСостояния);
			Возврат ОтветСоответствие;
		КонецПопытки;
	Иначе
		ОтветСоответствие = Новый Соответствие;
		ОтветСоответствие.Вставить("error", РезультатЗапроса.Тело);
		ОтветСоответствие.Вставить("status_code", РезультатЗапроса.КодСостояния);
		Возврат ОтветСоответствие;
	КонецЕсли;

КонецФункции

// Транзиентный ли HTTP-код ответа (имеет смысл повторить запрос).
// 429 (лимит), 500/502/503/504 (временные серверные) → Истина; все остальное (2xx, 4xx-перманентные,
// код 0 сетевого сбоя) → Ложь. Код 0 намеренно НЕ повторяемый: сетевой таймаут неидемпотентного POST
// может задвоить операцию - AI-путь обрабатывает сетевое исключение отдельно (аудит P2 #5/#9).
// Параметры:
//  КодСостояния - Число - HTTP-код ответа (0 для сетевого сбоя).
// Возвращаемое значение:
//  Булево - Истина, если код транзиентный (имеет смысл повторить запрос).
Функция ЭтоПовторяемыйКодОтвета(Знач КодСостояния) Экспорт

	Перем РезультатФункции;

	РезультатФункции = КодСостояния = 429
		Или КодСостояния = 500
		Или КодСостояния = 502
		Или КодСостояния = 503
		Или КодСостояния = 504;
	Возврат РезультатФункции;

КонецФункции

// Приостанавливает выполнение на заданное число секунд между повторами запросов.
// Использует ожидание фонового задания, как штатные методы Пауза БСП 3.1.11.
// Во время ожидания серверный поток не выполняет цикл опроса часов.
//
// Параметры:
//  Секунды - Число - длительность паузы; неположительное значение не требует ожидания.
//
Процедура Пауза(Знач Секунды) Экспорт

	Если ТипЗнч(Секунды) <> Тип("Число") Или Секунды <= 0 Тогда
		Возврат;
	КонецЕсли;

	Сеанс = ПолучитьТекущийСеансИнформационнойБазы();
	Задание = Сеанс.ПолучитьФоновоеЗадание();
	Если Задание = Неопределено Тогда
		Параметры = Новый Массив;
		Параметры.Добавить(Секунды);
		Задание = ФоновыеЗадания.Выполнить("КИИ_HTTPКлиент.Пауза", Параметры);
	КонецЕсли;
	Задание.ОжидатьЗавершенияВыполнения(Секунды);

КонецПроцедуры

// Преобразует число в строку без разделителей групп.
Функция ЧислоВСтроку(Знач Значение)

	Перем РезультатФункции;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если Значение = 0 Тогда
			Возврат "0";
		Иначе
			РезультатФункции = Формат(Значение, "ЧГ=0");
			Возврат РезультатФункции;
		КонецЕсли;
	Иначе
		РезультатФункции = Строка(Значение);
		Возврат РезультатФункции;
	КонецЕсли;

КонецФункции

// Записать одну часть multipart-формы с файлом в поток данных.
Процедура ЗаписатьЧастьФайлаФормы(ЗаписьДанных, Знач Граница, Знач РазделительСтрок, Знач ЭлементФайла)

	Перем ДвоичныеДанныеИзСтрокиЗначение;

	ДанныеФайла = ЭлементФайла.Значение;
	ИмяФайла = "";
	ТипКонтента = "application/octet-stream";
	ДвоичныеДанныеФайла = Неопределено;

	Если ТипЗнч(ДанныеФайла) = Тип("Структура") Тогда
		ДанныеФайла.Свойство("ИмяФайла", ИмяФайла);
		ДанныеФайла.Свойство("ТипКонтента", ТипКонтента);
		ДанныеФайла.Свойство("ДвоичныеДанные", ДвоичныеДанныеФайла);
	ИначеЕсли ТипЗнч(ДанныеФайла) = Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанныеФайла = ДанныеФайла;
		ИмяФайла = ЭлементФайла.Ключ;
	Иначе
		// Неподдерживаемый тип данных файла - пропускаем часть.
		Возврат;
	КонецЕсли;

	ЗаголовокЧасти = "--"
		+ Граница
		+ РазделительСтрок
		+ "Content-Disposition: form-data; name="""
		+ ОчиститьПараметрЗаголовкаЧасти(ЭлементФайла.Ключ)
		+ """; filename="""
		+ ОчиститьПараметрЗаголовкаЧасти(ИмяФайла)
		+ """"
		+ РазделительСтрок
		+ "Content-Type: "
		+ ОчиститьПараметрЗаголовкаЧасти(ТипКонтента)
		+ РазделительСтрок
		+ РазделительСтрок;
	ДвоичныеДанныеИзСтрокиЗначение = ПолучитьДвоичныеДанныеИзСтроки(ЗаголовокЧасти, "UTF-8");
	ЗаписьДанных.Записать(ДвоичныеДанныеИзСтрокиЗначение);

	Если ДвоичныеДанныеФайла <> Неопределено Тогда
		ЗаписьДанных.Записать(ДвоичныеДанныеФайла);
	КонецЕсли;

	ДвоичныеДанныеИзСтрокиЗначение = ПолучитьДвоичныеДанныеИзСтроки(РазделительСтрок, "UTF-8");
	ЗаписьДанных.Записать(ДвоичныеДанныеИзСтрокиЗначение);

КонецПроцедуры

#КонецОбласти

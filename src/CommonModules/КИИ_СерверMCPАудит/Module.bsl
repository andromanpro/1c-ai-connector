#Область ПрограммныйИнтерфейс

// Записывает событие аудита параллельно в журнал регистрации и регистр сведений.
//
// Параметры:
//  Вызывающий    - Строка - имя пользователя или IP/hostname
//  Метод         - Строка - MCP-метод или пустая строка для невалидного payload
//  ПараметрыJSON - Строка - сырой JSON-payload params для хеширования
//  Результат     - Строка - ok / error / auth_failed / rate_limited / parse_error
//  IDЗапроса     - Строка, Число, Неопределено - JSON-RPC id из payload
//
Процедура ЗаписатьВызов(Знач Вызывающий, Знач Метод, Знач ПараметрыJSON, Знач Результат, Знач IDЗапроса = "") Экспорт

	Перем УниверсальнаяДата;
	Перем РезультатОбрезатьСтроку;
	Перем ХешПараметровЗначение;
	Перем ПараметрыСкрытыеЗначение;
	Перем IDЗапросаКакСтрокуЗначение;

	Перем ПредставлениеЗначения;
	Перем ДанныеОшибки;
	
	Попытка
		
		// Имена ключей совпадают с реквизитами регистра КИИ_СерверMCPАудитВызовов -
		// запись в регистр заполняется через ЗаполнитьЗначенияСвойств.
		ДанныеВызова = Новый Структура;
		ПредставлениеЗначения = Строка(Новый УникальныйИдентификатор);
		ДанныеВызова.Вставить("Идентификатор", ПредставлениеЗначения);
		УниверсальнаяДата = ТекущаяУниверсальнаяДата();
		ДанныеВызова.Вставить("Дата", УниверсальнаяДата);
		РезультатОбрезатьСтроку = ОбрезатьСтроку(Вызывающий, 100);
		ДанныеВызова.Вставить("Вызывающий", РезультатОбрезатьСтроку);
		РезультатОбрезатьСтроку = ОбрезатьСтроку(Метод, 50);
		ДанныеВызова.Вставить("Метод", РезультатОбрезатьСтроку);
		РезультатОбрезатьСтроку = ОбрезатьСтроку(Результат, 20);
		ДанныеВызова.Вставить("Результат", РезультатОбрезатьСтроку);
		ХешПараметровЗначение = ВычислитьХешПараметров(ПараметрыJSON);
		ДанныеВызова.Вставить("ХешПараметров", ХешПараметровЗначение);
		ПараметрыСкрытыеЗначение = ВычислитьПараметрыСкрытые(ПараметрыJSON);
		ДанныеВызова.Вставить("ПараметрыСкрытые", ПараметрыСкрытыеЗначение);
		IDЗапросаКакСтрокуЗначение = ПолучитьIDЗапросаКакСтроку(IDЗапроса);
		ДанныеВызова.Вставить("IDЗапроса", IDЗапросаКакСтрокуЗначение);
		
		ЗаписатьВЖурналРегистрации(ДанныеВызова);
		ЗаписатьВРегистрСведений(ДанныеВызова);
		
	Исключение
		
		ДанныеОшибки = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		ЗаписатьОшибкуАудита(ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

// Извлекает идентификатор вызывающего из HTTPСервисЗапроса для audit caller.
//
// Параметры:
//  Запрос             - HTTPСервисЗапрос
//  ПользовательИзAuth - Строка - имя пользователя из ПроверитьBasicAuth
//
// Возвращаемое значение:
//  Строка
//
Функция ИзвлечьВызывающего(Знач Запрос, Знач ПользовательИзAuth) Экспорт

	Перем РезультатФункции;
	Перем ЗаголовокЗапросаЗначение;
	
	Если ЗначениеЗаполнено(ПользовательИзAuth) Тогда
		РезультатФункции = ОбрезатьСтроку(ПользовательИзAuth, 100);
		Возврат РезультатФункции;
	КонецЕсли;
	
	ЗаголовокЗапросаЗначение = КИИ_СерверMCPAuth.ПолучитьЗаголовокЗапроса(Запрос.Заголовки, "X-Forwarded-For");
	АдресПрокси = СокрЛП(ЗаголовокЗапросаЗначение);
	Если ЗначениеЗаполнено(АдресПрокси) Тогда
		РезультатФункции = ОбрезатьСтроку(АдресПрокси, 100);
		Возврат РезультатФункции;
	КонецЕсли;
	
	Возврат "anonymous";
	
КонецФункции

// Регламентная очистка аудита MCP: удаляет записи старше срока хранения.
// Вызывается заданием КИИ_СерверMCPАудитОчистка.
Процедура ВыполнитьОчисткуАудита() Экспорт

	Перем УниверсальнаяДата;

	Перем ТекстСообщения2;
	Перем ДанныеОшибки;
	Перем ПодробностиОшибки;

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();

	Попытка

		УниверсальнаяДата = ТекущаяУниверсальнаяДата();
		ПороговаяДата = НачалоДня(УниверсальнаяДата) - СрокХраненияАудитаДней() * 86400;
		Удалено = ОчиститьЗаписиАудитаСтарше(ПороговаяДата);

		ТекстСообщения = СтрШаблон(НСтр("ru = 'Очистка аудита MCP завершена. Удалено записей: %1'"), Удалено);
		ТекстСообщения2 = НСтр("ru = 'КИИ.СерверMCP.Аудит'");
		ЗаписьЖурналаРегистрации(ТекстСообщения2, УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);

	Исключение

		ТекстСообщения2 = НСтр("ru = 'Ошибка очистки аудита MCP: %1'");
		ДанныеОшибки = ИнформацияОбОшибке();
		ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		ТекстОшибки = СтрШаблон(ТекстСообщения2, ПодробностиОшибки);
		ТекстСообщения2 = НСтр("ru = 'КИИ.СерверMCP.Аудит'");
		ЗаписьЖурналаРегистрации(ТекстСообщения2, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);

	КонецПопытки;

КонецПроцедуры

// Удаляет записи аудита MCP старше пороговой даты (дата в регистре - UTC).
//
// Параметры:
//  ПороговаяДата - Дата - записи с датой вызова строго меньше пороговой удаляются.
//
// Возвращаемое значение:
//  Число - количество удаленных записей.
//
Функция ОчиститьЗаписиАудитаСтарше(Знач ПороговаяДата) Экспорт

	Перем РезультатЗапроса;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Аудит.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.КИИ_СерверMCPАудитВызовов КАК Аудит
	|ГДЕ
	|	Аудит.Дата < &ПороговаяДата";
	Запрос.УстановитьПараметр("ПороговаяДата", ПороговаяДата);

	Удалено = 0;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.КИИ_СерверMCPАудитВызовов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Идентификатор.Установить(Выборка.Идентификатор);
		НаборЗаписей.Записать();
		Удалено = Удалено + 1;
	КонецЦикла;

	Возврат Удалено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Срок хранения записей аудита MCP в днях; согласован со сроком хранения
// данных мониторинга по умолчанию.
Функция СрокХраненияАудитаДней()

	Возврат 30;

КонецФункции

Функция ВычислитьХешПараметров(Знач ПараметрыJSON)

	Перем ШестнадцатеричнаяСтрока;
	Перем РезультатФункции;
	
	Если Не ЗначениеЗаполнено(ПараметрыJSON) Тогда
		Возврат "";
	КонецЕсли;
	
	Хешировщик = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хешировщик.Добавить(ПараметрыJSON);
	ШестнадцатеричнаяСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(Хешировщик.ХешСумма);
	РезультатФункции = НРег(ШестнадцатеричнаяСтрока);
	Возврат РезультатФункции;
	
КонецФункции

Функция ВычислитьПараметрыСкрытые(Знач ПараметрыJSON)

	Перем РезультатФункции;
	
	Если Не ЗначениеЗаполнено(ПараметрыJSON) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Структура = КИИ_КоннекторИИОбщий.ЗначениеИзСтрокиJSON(ПараметрыJSON);
		Скрытые = КИИ_СерверMCPСокрытиеСекретов.СкрытьСекретыВПараметрах(Структура);
		Результат = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Скрытые);
	Исключение
		Возврат "";
	КонецПопытки;
	
	Если СтрДлина(Результат) > 2000 Тогда
		РезультатФункции = Лев(Результат, 2000);
		Возврат РезультатФункции;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьIDЗапросаКакСтроку(Знач IDЗапроса)

	Перем ПредставлениеЗначения;
	Перем РезультатФункции;
	
	Если IDЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ПредставлениеЗначения = Строка(IDЗапроса);
	РезультатФункции = ОбрезатьСтроку(ПредставлениеЗначения, 100);
	Возврат РезультатФункции;
	
КонецФункции

Функция ОбрезатьСтроку(Знач Значение, Знач МаксимальнаяДлина)

	Перем РезультатФункции;
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЗначениеСтрокой = Строка(Значение);
	
	Если СтрДлина(ЗначениеСтрокой) <= МаксимальнаяДлина Тогда
		Возврат ЗначениеСтрокой;
	КонецЕсли;
	
	РезультатФункции = Лев(ЗначениеСтрокой, МаксимальнаяДлина);
	Возврат РезультатФункции;
	
КонецФункции

Процедура ЗаписатьВЖурналРегистрации(Знач ДанныеВызова)

	Перем ТекстСообщения;
	Перем ТекстJSON;
	
	// Состав и порядок ключей сохраняются: JSON комментария журнала - внешний формат.
	ДанныеЛога = Новый Структура;
	ДанныеЛога.Вставить("Вызывающий", ДанныеВызова.Вызывающий);
	ДанныеЛога.Вставить("Метод", ДанныеВызова.Метод);
	ДанныеЛога.Вставить("ХешПараметров", ДанныеВызова.ХешПараметров);
	ДанныеЛога.Вставить("Результат", ДанныеВызова.Результат);
	ДанныеЛога.Вставить("IDЗапроса", ДанныеВызова.IDЗапроса);
	ДанныеЛога.Вставить("Идентификатор", ДанныеВызова.Идентификатор);
	
	ТекстСообщения = НСтр("ru = 'КИИ.СерверMCP.Аудит'");
	ТекстJSON = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(ДанныеЛога);
	ЗаписьЖурналаРегистрации(
		ТекстСообщения, УровеньЖурналаРегистрации.Информация, Метаданные.HTTPСервисы.КИИ_СерверMCPAPI, , ТекстJSON);
	
КонецПроцедуры

Процедура ЗаписатьВРегистрСведений(Знач ДанныеВызова)
	
	МенеджерЗаписи = РегистрыСведений.КИИ_СерверMCPАудитВызовов.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ДанныеВызова);
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Процедура ЗаписатьОшибкуАудита(Знач ТекстОшибкиАудита)

	Перем ТекстСообщения;

	// Аудит - вспомогательный тракт: его собственный сбой не должен ронять основной поток
	// обработки MCP-запроса, поэтому исключение здесь осознанно поглощается.
	// BSLLS:MissingCodeTryCatchEx-off
	Попытка

		ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка записи аудита MCP: %1'"), ТекстОшибкиАудита);
		
		ТекстСообщения = НСтр("ru = 'КИИ.СерверMCP.Аудит'");
		ЗаписьЖурналаРегистрации(
			ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, Метаданные.HTTPСервисы.КИИ_СерверMCPAPI, , ТекстОшибки);
		
	Исключение
	КонецПопытки;
	// BSLLS:MissingCodeTryCatchEx-on

КонецПроцедуры

#КонецОбласти

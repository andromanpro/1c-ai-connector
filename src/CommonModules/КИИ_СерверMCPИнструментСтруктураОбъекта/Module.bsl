#Область ПрограммныйИнтерфейс

// Декларация инструмента get_object_structure для container-pattern.
//
// Параметры:
//  Таблица - ТаблицаЗначений - реестр инструментов:
//   * Имя - Строка - имя инструмента
//   * Описание - Строка - описание инструмента
//   * Схема - Структура - JSON-схема аргументов
//
Процедура ДобавитьИнструменты(Таблица) Экспорт

	Перем ТекстСообщения;
	
	Свойства = Новый Структура;
	ТекстСообщения = НСтр("ru = 'Тип объекта метаданных: Catalog, Document, InformationRegister и т.п.'");
	ОписаниеСвойства = Новый Структура("type, description", "string", ТекстСообщения);
	Свойства.Вставить("object_type", ОписаниеСвойства);
	ТекстСообщения = НСтр("ru = 'Имя объекта метаданных без префикса типа.'");
	ОписаниеСвойства = Новый Структура("type, description", "string", ТекстСообщения);
	Свойства.Вставить("name", ОписаниеСвойства);

	ТекстСообщения = НСтр("ru = 'Смещение страницы полей. Продолжайте с next_offset из предыдущего ответа.'");
	ОписаниеСвойства = Новый Структура("type, minimum, description", "integer", 0, ТекстСообщения);
	Свойства.Вставить("offset", ОписаниеСвойства);
	ОписаниеСвойства = Новый Структура("type, minimum, maximum", "integer", 1, 200);
	Свойства.Вставить("limit", ОписаниеСвойства);
	Разделы = СтрРазделить("all,attributes,tabular_sections,dimensions,resources", ",");
	ТекстСообщения = НСтр("ru = 'Раздел структуры. all включает все поля; tabular_sections - части и их реквизиты.'");
	ОписаниеСвойства = Новый Структура("type, enum, description", "string", Разделы, ТекстСообщения);
	Свойства.Вставить("section", ОписаниеСвойства);
	
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("object_type");
	ОбязательныеПоля.Добавить("name");
	
	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", ОбязательныеПоля);
	Схема.Вставить("additionalProperties", Ложь);
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Имя = "get_object_structure";
	НоваяСтрока.Описание = НСтр(
		"ru = 'Структура объекта: реквизиты, табличные части, измерения и ресурсы.
		|С limit, offset или section возвращает items с полными путями.
		|Пока has_more=true, продолжайте с next_offset и теми же object_type, name, section.'");
	НоваяСтрока.Схема = Схема;
	
КонецПроцедуры

// Выполняет инструмент get_object_structure.
//
// Параметры:
//  ИмяИнструмента - Строка - имя MCP-инструмента
//  Аргументы - Структура, Соответствие из КлючИЗначение - аргументы инструмента:
//   * object_type - Строка - тип объекта метаданных
//   * name - Строка - имя объекта
//   * section - Строка - all, attributes, tabular_sections, dimensions или resources (необязательно).
//   * offset - Число - целое неотрицательное смещение (необязательно).
//   * limit - Число - размер страницы от 1 до 200, по умолчанию 20 (необязательно).
// Без новых параметров сохраняется прежняя структура. Иначе возвращается страница items:
// каждый элемент имеет section и path, поля табличной части также tabular_section.
// С тем же объектом, разделом и версией конфигурации продолжайте с next_offset до has_more=Ложь.
//
// Возвращаемое значение:
//  Структура - структура объекта метаданных:
//   * canonical_ref - Строка - полное имя (Тип.Имя)
//   * type - Строка - тип метаданных
//   * name - Строка - имя объекта
//   * synonym - Строка - синоним
//   * attributes - Массив из Структура - реквизиты
//   * tabular_sections - Массив из Структура - табличные части
//   * dimensions - Массив из Структура - измерения
//   * resources - Массив из Структура - ресурсы
//
Функция ВыполнитьИнструмент(Знач ИмяИнструмента, Знач Аргументы) Экспорт

	Перем РезультатФункции;
	
	Если ИмяИнструмента <> "get_object_structure" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Неподдерживаемый инструмент %1 для модуля КИИ_СерверMCPИнструментСтруктураОбъекта'"),
			ИмяИнструмента);
	КонецЕсли;
	
	ТипМетаданных = ПолучитьОбязательныйАргументСтрокой(Аргументы, "object_type");
	ИмяОбъекта = ПолучитьОбязательныйАргументСтрокой(Аргументы, "name");
	ОбъектМетаданных = ПолучитьОбъектМетаданных(ТипМетаданных, ИмяОбъекта);
	
	ПараметрыСтраницы = ПараметрыСтраницыСтруктуры(Аргументы);
	Если ПараметрыСтраницы = Неопределено Тогда
		РезультатФункции = ОписаниеСтруктурыОбъекта(ТипМетаданных, ОбъектМетаданных);
	Иначе
		РезультатФункции = ПолучитьСтраницуСтруктуры(ТипМетаданных, ОбъектМетаданных, ПараметрыСтраницы);
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыСтраницыСтруктуры(Знач Аргументы)

	Смещение = ПолучитьАргумент(Аргументы, "offset");
	Размер = ПолучитьАргумент(Аргументы, "limit");
	Раздел = ПолучитьАргумент(Аргументы, "section");
	Если Смещение = Неопределено И Размер = Неопределено И Раздел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Смещение = Неопределено Тогда
		Смещение = 0;
	КонецЕсли;
	Если Размер = Неопределено Тогда
		Размер = 20;
	КонецЕсли;
	Если Раздел = Неопределено Тогда
		Раздел = "all";
	КонецЕсли;
	ТекстОшибки = НСтр("ru = 'Некорректный параметр структуры: offset - целое от 0, limit - целое от 1 до 200.'");
	Если ТипЗнч(Смещение) <> Тип("Число") Или ТипЗнч(Размер) <> Тип("Число") Тогда
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	СмещениеНекорректно = Смещение < 0 Или Смещение <> Цел(Смещение);
	РазмерНекорректен = Размер < 1 Или Размер > 200 Или Размер <> Цел(Размер);
	Если СмещениеНекорректно Или РазмерНекорректен Тогда
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	Разделы = СтрРазделить("all,attributes,tabular_sections,dimensions,resources", ",");
	Если ТипЗнч(Раздел) <> Тип("Строка") Или Разделы.Найти(Раздел) = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Некорректный параметр структуры section. Выберите раздел из схемы инструмента.'");
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	Параметры = Новый Структура("offset, limit, section", Смещение, Размер, Раздел);
	Возврат Параметры;

КонецФункции

Функция ПолучитьСтраницуСтруктуры(Знач ТипМетаданных, Знач ОбъектМетаданных, Знач Параметры)

	Элементы = Новый Массив;
	Состояние = Новый Структура("Параметры, items, total_count", Параметры, Элементы, 0);
	Разделы = СтрРазделить("attributes,tabular_sections,dimensions,resources", ",");
	Для Каждого Раздел Из Разделы Цикл
		Если Параметры.section <> "all" И Параметры.section <> Раздел Тогда
			Продолжить;
		КонецЕсли;
		КоллекцияРаздела = КоллекцияРазделаСтруктуры(ТипМетаданных, ОбъектМетаданных, Раздел);
		Для Каждого Элемент Из КоллекцияРаздела Цикл
			Путь = СтрШаблон("%1.%2", Раздел, Элемент.Имя);
			ДобавитьЭлементСтруктурыВСтраницу(Элемент, Раздел, Путь, "", Состояние);
			Если Раздел = "tabular_sections" Тогда
				Для Каждого РеквизитЧасти Из Элемент.Реквизиты Цикл
					ПутьРеквизита = СтрШаблон("%1.attributes.%2", Путь, РеквизитЧасти.Имя);
					ДобавитьЭлементСтруктурыВСтраницу(РеквизитЧасти, Раздел,
						ПутьРеквизита, Элемент.Имя, Состояние);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ПолноеИмяОбъекта = СтрШаблон("%1.%2", ТипМетаданных, ОбъектМетаданных.Имя);
	СинонимОбъекта = БезопасныйСиноним(ОбъектМетаданных);
	Страница = Новый Структура;
	Страница.Вставить("canonical_ref", ПолноеИмяОбъекта);
	Страница.Вставить("type", ТипМетаданных);
	Страница.Вставить("name", ОбъектМетаданных.Имя);
	Страница.Вставить("synonym", СинонимОбъекта);
	Страница.Вставить("items", Элементы);
	Страница.Вставить("paged", Истина);
	Страница.Вставить("section", Параметры.section);
	Страница.Вставить("offset", Параметры.offset);
	Страница.Вставить("limit", Параметры.limit);
	Страница.Вставить("total_count", Состояние.total_count);
	КоличествоПереданных = Элементы.Количество();
	СледующееСмещение = Параметры.offset + КоличествоПереданных;
	Страница.Вставить("returned_count", КоличествоПереданных);
	Страница.Вставить("next_offset", СледующееСмещение);
	Страница.Вставить("has_more", СледующееСмещение < Состояние.total_count);
	Возврат Страница;

КонецФункции

Функция КоллекцияРазделаСтруктуры(Знач ТипМетаданных, Знач ОбъектМетаданных, Знач Раздел)

	Коллекция = Новый Массив;
	ЭтоДокументИлиСправочник = ТипМетаданных = "Catalog" Или ТипМетаданных = "Document";
	ЭтоРегистр = ТипМетаданных = "InformationRegister" Или ТипМетаданных = "AccumulationRegister";
	ЭтоОбъектСРеквизитами = ЭтоДокументИлиСправочник
		Или ЭтоРегистр
		Или ТипМетаданных = "DataProcessor"
		Или ТипМетаданных = "Report";
	Если Раздел = "attributes" И ЭтоОбъектСРеквизитами Тогда
		Коллекция = ОбъектМетаданных.Реквизиты;
	ИначеЕсли Раздел = "tabular_sections" И ЭтоДокументИлиСправочник Тогда
		Коллекция = ОбъектМетаданных.ТабличныеЧасти;
	ИначеЕсли Раздел = "dimensions" И ЭтоРегистр Тогда
		Коллекция = ОбъектМетаданных.Измерения;
	ИначеЕсли Раздел = "resources" И ЭтоРегистр Тогда
		Коллекция = ОбъектМетаданных.Ресурсы;
	Иначе
		// У выбранного вида объекта нет такого раздела структуры.
		Возврат Коллекция;
	КонецЕсли;
	Возврат Коллекция;

КонецФункции

Процедура ДобавитьЭлементСтруктурыВСтраницу(
	Знач ОбъектМетаданных, Знач Раздел, Знач Путь, Знач ТабличнаяЧасть, Состояние)

	Позиция = Состояние.total_count;
	Состояние.total_count = Позиция + 1;
	Параметры = Состояние.Параметры;
	Если Позиция < Параметры.offset Или Позиция >= Параметры.offset + Параметры.limit Тогда
		Возврат;
	КонецЕсли;
	СинонимЭлемента = БезопасныйСиноним(ОбъектМетаданных);
	Элемент = Новый Структура;
	Элемент.Вставить("section", Раздел);
	Элемент.Вставить("path", Путь);
	Элемент.Вставить("name", ОбъектМетаданных.Имя);
	Элемент.Вставить("synonym", СинонимЭлемента);
	Если Раздел <> "tabular_sections" Или ТабличнаяЧасть <> "" Тогда
		ТипРеквизита = ОписаниеТипаРеквизита(ОбъектМетаданных);
		Элемент.Вставить("type", ТипРеквизита);
		Элемент.Вставить("required", Ложь);
	КонецЕсли;
	Если ТабличнаяЧасть <> "" Тогда
		Элемент.Вставить("tabular_section", ТабличнаяЧасть);
	КонецЕсли;
	Состояние.items.Добавить(Элемент);

КонецПроцедуры

Функция ОписаниеСтруктурыОбъекта(Знач ТипМетаданных, Знач ОбъектМетаданных)

	Перем РезультатБезопасныйСиноним;
	
	Атрибуты = Новый Массив;
	ТабличныеЧасти = Новый Массив;
	Измерения = Новый Массив;
	Ресурсы = Новый Массив;
	
	Если ТипМетаданных = "Catalog" Или ТипМетаданных = "Document" Тогда
		
		Атрибуты = ОписаниеРеквизитов(ОбъектМетаданных.Реквизиты);
		ТабличныеЧасти = ОписаниеТабличныхЧастей(ОбъектМетаданных.ТабличныеЧасти);
		
	ИначеЕсли ТипМетаданных = "InformationRegister" Или ТипМетаданных = "AccumulationRegister" Тогда
		
		Атрибуты = ОписаниеРеквизитов(ОбъектМетаданных.Реквизиты);
		Измерения = ОписаниеРеквизитов(ОбъектМетаданных.Измерения);
		Ресурсы = ОписаниеРеквизитов(ОбъектМетаданных.Ресурсы);
		
	Иначе
		
		Попытка
			Атрибуты = ОписаниеРеквизитов(ОбъектМетаданных.Реквизиты);
		Исключение
			Атрибуты = Новый Массив;
		КонецПопытки;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("canonical_ref", ТипМетаданных + "." + ОбъектМетаданных.Имя);
	Результат.Вставить("type", ТипМетаданных);
	Результат.Вставить("name", ОбъектМетаданных.Имя);
	РезультатБезопасныйСиноним = БезопасныйСиноним(ОбъектМетаданных);
	Результат.Вставить("synonym", РезультатБезопасныйСиноним);
	Результат.Вставить("attributes", Атрибуты);
	Результат.Вставить("tabular_sections", ТабличныеЧасти);
	Результат.Вставить("dimensions", Измерения);
	Результат.Вставить("resources", Ресурсы);
	Возврат Результат;
	
КонецФункции

Функция ОписаниеРеквизитов(Знач КоллекцияРеквизитов)

	Перем РезультатОписаниеРеквизита;
	
	Реквизиты = Новый Массив;
	
	Для Каждого РеквизитМетаданных Из КоллекцияРеквизитов Цикл
		РезультатОписаниеРеквизита = ОписаниеРеквизита(РеквизитМетаданных);
		Реквизиты.Добавить(РезультатОписаниеРеквизита);
	КонецЦикла;
	
	Возврат Реквизиты;
	
КонецФункции

Функция ОписаниеТабличныхЧастей(Знач КоллекцияТабличныхЧастей)

	Перем РезультатБезопасныйСиноним;
	Перем РезультатОписаниеРеквизитов;
	
	ТабличныеЧасти = Новый Массив;
	
	Для Каждого ТабличнаяЧастьМетаданных Из КоллекцияТабличныхЧастей Цикл
		
		ОписаниеТабличнойЧасти = Новый Структура;
		ОписаниеТабличнойЧасти.Вставить("name", ТабличнаяЧастьМетаданных.Имя);
		РезультатБезопасныйСиноним = БезопасныйСиноним(ТабличнаяЧастьМетаданных);
		ОписаниеТабличнойЧасти.Вставить("synonym", РезультатБезопасныйСиноним);
		РезультатОписаниеРеквизитов = ОписаниеРеквизитов(ТабличнаяЧастьМетаданных.Реквизиты);
		ОписаниеТабличнойЧасти.Вставить("attributes", РезультатОписаниеРеквизитов);
		ТабличныеЧасти.Добавить(ОписаниеТабличнойЧасти);
		
	КонецЦикла;
	
	Возврат ТабличныеЧасти;
	
КонецФункции

Функция ОписаниеРеквизита(Знач РеквизитМетаданных)

	Перем РезультатБезопасныйСиноним;
	Перем РезультатОписаниеТипаРеквизита;
	
	Описание = Новый Структура;
	Описание.Вставить("name", РеквизитМетаданных.Имя);
	РезультатБезопасныйСиноним = БезопасныйСиноним(РеквизитМетаданных);
	Описание.Вставить("synonym", РезультатБезопасныйСиноним);
	РезультатОписаниеТипаРеквизита = ОписаниеТипаРеквизита(РеквизитМетаданных);
	Описание.Вставить("type", РезультатОписаниеТипаРеквизита);
	Описание.Вставить("required", Ложь);
	Возврат Описание;
	
КонецФункции

Функция ОписаниеТипаРеквизита(Знач РеквизитМетаданных)

	Перем РезультатФункции;
	
	Попытка
		РезультатФункции = ОписаниеТипа(РеквизитМетаданных.Тип);
		Возврат РезультатФункции;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ОписаниеТипа(Знач ОписаниеТипов)

	Перем ПредставлениеЗначения;
	
	Если ОписаниеТипов = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТипыЗначений = ОписаниеТипов.Типы();
	Если ТипыЗначений.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Описание = "";
	
	Для Каждого ТипЗначения Из ТипыЗначений Цикл
		
		Если ЗначениеЗаполнено(Описание) Тогда
			Описание = Описание + " | ";
		КонецЕсли;
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Если ОбъектМетаданных <> Неопределено Тогда
			Описание = Описание + ОбъектМетаданных.ПолноеИмя();
		Иначе
			ПредставлениеЗначения = Строка(ТипЗначения);
			Описание = Описание + СтрЗаменить(ПредставлениеЗначения, "Тип ", "");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Описание;
	
КонецФункции

Функция ПолучитьОбъектМетаданных(Знач ТипМетаданных, Знач ИмяОбъекта)
	
	ИмяКоллекции = ИмяКоллекцииМетаданных(ТипМетаданных);
	Если ИмяКоллекции = Неопределено Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Неподдерживаемый тип метаданных: %1'"),
			ТипМетаданных);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	
	КоллекцияМетаданных = ПолучитьКоллекциюМетаданных(ИмяКоллекции);
	
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		Если ОбъектМетаданных.Имя = ИмяОбъекта Тогда
			Возврат ОбъектМетаданных;
		КонецЕсли;
	КонецЦикла;
	
	// ВызватьОшибкуВалидацииИнструмента бросает исключение - до Возврата ниже не доходим,
	// но анализатор видит возврат на всех путях.
	ТекстОшибки = СтрШаблон(
		НСтр("ru = 'Объект метаданных не найден: %1.%2'"),
		ТипМетаданных,
		ИмяОбъекта);
	КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьОбязательныйАргументСтрокой(Знач Аргументы, Знач ИмяАргумента)

	Перем ПредставлениеЗначения;
	Перем РезультатФункции;
	
	ЗначениеАргумента = ПолучитьАргумент(Аргументы, ИмяАргумента);
	
	Если Не ЗначениеЗаполнено(ЗначениеАргумента) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не заполнен обязательный параметр %1'"), ИмяАргумента);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	
	ПредставлениеЗначения = Строка(ЗначениеАргумента);
	РезультатФункции = СокрЛП(ПредставлениеЗначения);
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьАргумент(Знач Аргументы, Знач ИмяАргумента)

	Перем РезультатФункции;
	
	ЗначениеАргумента = Неопределено;
	
	Если Аргументы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		
		Если Аргументы.Свойство(ИмяАргумента, ЗначениеАргумента) Тогда
			Возврат ЗначениеАргумента;
		КонецЕсли;
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		РезультатФункции = Аргументы.Получить(ИмяАргумента);
		Возврат РезультатФункции;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция БезопасныйСиноним(Знач ОбъектМетаданных)
	
	Попытка
		Синоним = Строка(ОбъектМетаданных.Синоним);
	Исключение
		Синоним = "";
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Синоним) Тогда
		Возврат Синоним;
	КонецЕсли;
	
	Возврат ОбъектМетаданных.Имя;
	
КонецФункции

Функция ИмяКоллекцииМетаданных(Знач ТипМетаданных)

	Перем РезультатФункции;
	
	ИменаКоллекций = Новый Соответствие;
	ИменаКоллекций.Вставить("Catalog", "Справочники");
	ИменаКоллекций.Вставить("Document", "Документы");
	ИменаКоллекций.Вставить("InformationRegister", "РегистрыСведений");
	ИменаКоллекций.Вставить("AccumulationRegister", "РегистрыНакопления");
	ИменаКоллекций.Вставить("Role", "Роли");
	ИменаКоллекций.Вставить("Enum", "Перечисления");
	ИменаКоллекций.Вставить("CommonModule", "ОбщиеМодули");
	ИменаКоллекций.Вставить("DataProcessor", "Обработки");
	ИменаКоллекций.Вставить("Report", "Отчеты");
	РезультатФункции = ИменаКоллекций.Получить(ТипМетаданных);
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьКоллекциюМетаданных(Знач ИмяКоллекции)
	
	Если ИмяКоллекции = "Справочники" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли ИмяКоллекции = "Документы" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли ИмяКоллекции = "РегистрыСведений" Тогда
		Возврат Метаданные.РегистрыСведений;
	ИначеЕсли ИмяКоллекции = "РегистрыНакопления" Тогда
		Возврат Метаданные.РегистрыНакопления;
	ИначеЕсли ИмяКоллекции = "Роли" Тогда
		Возврат Метаданные.Роли;
	ИначеЕсли ИмяКоллекции = "Перечисления" Тогда
		Возврат Метаданные.Перечисления;
	ИначеЕсли ИмяКоллекции = "ОбщиеМодули" Тогда
		Возврат Метаданные.ОбщиеМодули;
	ИначеЕсли ИмяКоллекции = "Обработки" Тогда
		Возврат Метаданные.Обработки;
	ИначеЕсли ИмяКоллекции = "Отчеты" Тогда
		Возврат Метаданные.Отчеты;
	Иначе
		// Коллекция вне whitelist инструмента: явная ошибка валидации, а не пустой результат.
		// ВызватьОшибкуВалидацииИнструмента бросает исключение - до Возврата ниже не доходим.
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Неподдерживаемая коллекция метаданных: %1'"),
			ИмяКоллекции);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

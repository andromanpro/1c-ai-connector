#Область ПрограммныйИнтерфейс

// Возвращает детали ошибки с обычной проверкой прав на регистр журнала.
// Параметры:
//  ХешОшибки - Строка - идентификатор выбранной ошибки.
// Возвращаемое значение:
//  См. КИИ_МониторингОшибокАнализ.ДанныеОшибкиДляПросмотра
Функция ДанныеОшибки(Знач ХешОшибки) Экспорт

	Возврат КИИ_МониторингОшибокАнализ.ДанныеОшибкиДляПросмотра(ХешОшибки);

КонецФункции

// Начинает анализ, привязанный к форме инициатора.
// Параметры:
//  ХешОшибки - Строка - идентификатор подтвержденной ошибки.
//  ИдентификаторФормы - УникальныйИдентификатор - форма инициатора.
// Возвращаемое значение:
//  См. ДлительныеОперации.ВыполнитьФункцию
Функция НачатьАнализОшибки(Знач ХешОшибки, Знач ИдентификаторФормы) Экспорт

	Параметры = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	Параметры.ЗапуститьВФоне = Истина;
	Возврат ДлительныеОперации.ВыполнитьФункцию(Параметры,
		"КИИ_МониторингОшибокАнализ.ВыполнитьГлубокийАнализОшибки", ХешОшибки);

КонецФункции

// Проверяет завершение предыдущего задания, не изменяя данные формы.
// Параметры:
//  ИдентификаторЗадания - Строка - идентификатор задания анализа.
// Возвращаемое значение:
//  Булево - задание отсутствует или завершено.
Функция АнализОшибкиЗавершен(Знач ИдентификаторЗадания) Экспорт

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
		Новый УникальныйИдентификатор(ИдентификаторЗадания));
	Возврат Задание = Неопределено Или Задание.Состояние <> СостояниеФоновогоЗадания.Активно;

КонецФункции

// Проверяет готовность выбранного индекса без запроса к сервису эмбеддингов.
// Параметры:
//  Эксперт - СправочникСсылка.КИИ_ЭкспертыИИ, Неопределено - выбранный эксперт.
//  База - СправочникСсылка.КИИ_БазаЗнаний, Неопределено - выбранная база знаний.
//  Категория - СправочникСсылка.КИИ_КатегорииЗнаний, Неопределено - выбранная категория.
//  Модель - СправочникСсылка.КИИ_МоделиИИ, Неопределено - модель эмбеддингов.
// Возвращаемое значение:
//  Структура:
//   * Статус - Строка - код готовности поиска.
//   * Диагностика - Строка - пояснение состояния индекса.
//   * Модель - СправочникСсылка.КИИ_МоделиИИ, Неопределено - выбранная модель.
//   * КодМодели - Строка - имя модели у сервиса.
Функция СведенияПоиска(Знач Эксперт, Знач База, Знач Категория, Знач Модель) Экспорт

	Сведения = КИИ_RAG.СведенияДляПроверкиПоиска(Эксперт, База, Категория, Модель);
	Результат = Новый Структура;
	Результат.Вставить("Статус", Сведения.Статус);
	Результат.Вставить("Диагностика", Сведения.Диагностика);
	Результат.Вставить("Модель", Сведения.Модель);
	Результат.Вставить("КодМодели", Сведения.КодМодели);
	Возврат Результат;

КонецФункции

// Начинает подтвержденную проверку поиска в фоновом задании.
// Параметры:
//  ПараметрыПоиска - Структура - подтвержденные параметры поиска знаний.
//  ИдентификаторФормы - УникальныйИдентификатор - форма инициатора.
// Возвращаемое значение:
//  См. ДлительныеОперации.ВыполнитьФункцию
Функция НачатьПроверкуПоиска(Знач ПараметрыПоиска, Знач ИдентификаторФормы) Экспорт

	Параметры = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	Параметры.КлючФоновогоЗадания = "КИИ_ПроверкаПоиска_" + Строка(ИдентификаторФормы);
	Параметры.НаименованиеФоновогоЗадания = НСтр("ru = 'Проверка поиска знаний'");
	Параметры.ЗапуститьВФоне = Истина;
	Возврат ДлительныеОперации.ВыполнитьФункцию(Параметры,
		"КИИ_RAG.ПроверитьПоискЗнаний", ПараметрыПоиска);

КонецФункции

#КонецОбласти

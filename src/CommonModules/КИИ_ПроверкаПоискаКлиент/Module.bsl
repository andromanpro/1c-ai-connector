КонецПроцедуры

// Проверяет параметры и запрашивает подтверждение поиска знаний.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
Процедура ПроверитьПоиск(Форма) Экспорт

	Если Форма.ПоискВыполняется Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(Форма.Вопрос) Тогда
		Форма.СостояниеПоиска = НСтр("ru = 'Введите вопрос для проверки поиска.'");
		Возврат;
	КонецЕсли;
	НеверныеПараметрыПоиска = Форма.КоличествоРезультатов < 1 Или Форма.КоличествоРезультатов > 50
		Или Форма.ПорогСходства < -1 Или Форма.ПорогСходства > 1;
	Если НеверныеПараметрыПоиска Тогда
		Форма.СостояниеПоиска = НСтр("ru = 'Количество результатов должно быть от 1 до 50, порог сходства от -1 до 1.'");
		Возврат;
	КонецЕсли;
	Форма.НайденныеФрагменты.Очистить();
	Форма.ТекстФрагмента = "";
	Сведения = ОбновитьСведенияПоиска(Форма);
	Если Сведения.Статус <> "ОК" Тогда
		Возврат;
	КонецЕсли;
	УстановитьОжиданиеПоиска(Форма, Истина);
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("Вопрос", Форма.Вопрос);
	ПараметрыПроверки.Вставить("Эксперт", Форма.ЭкспертПоиска);
	ПараметрыПроверки.Вставить("База", Форма.БазаПоиска);
	ПараметрыПроверки.Вставить("Категория", Форма.КатегорияПоиска);
	ПараметрыПроверки.Вставить("Количество", Форма.КоличествоРезультатов);
	ПараметрыПроверки.Вставить("Порог", Форма.ПорогСходства);
	ПараметрыПроверки.Вставить("Модель", Форма.МодельДляПроверки);
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияПоиска", Форма, ПараметрыПроверки);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Выполнить поиск? Вопрос будет передан настроенному сервису эмбеддингов с учетом контроля
			|персональных данных. Сервис может тарифицировать запрос. Ответ чат-модели не генерируется.'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

// Обрабатывает действие формы: ОткрытьБазуФрагмента.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
Процедура ОткрытьБазуФрагмента(Форма) Экспорт

	Данные = Форма.Элементы.НайденныеФрагменты.ТекущиеДанные;
	Если Данные <> Неопределено И ЗначениеЗаполнено(Данные.База) Тогда
		ПоказатьЗначение(, Данные.База);
	КонецЕсли;

КонецПроцедуры

// Обрабатывает действие формы: КопироватьФрагмент.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
Асинх Процедура КопироватьФрагмент(Форма) Экспорт

	Если Не ПустаяСтрока(Форма.ТекстФрагмента) Тогда
		Скопировано = Ждать КИИ_ИнтерфейсКлиент.СкопироватьТекстВБуферОбмена(Форма.ТекстФрагмента);
		Если Не Скопировано Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Буфер обмена недоступен. Выделите и скопируйте текст фрагмента вручную.'"));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Обрабатывает действие формы: ПослеПодтвержденияПоиска.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
//  Ответ - КодВозвратаДиалога - выбранный ответ.
//  ПараметрыПроверки - Структура - подтвержденные параметры поиска.
Процедура ПослеПодтвержденияПоиска(Форма, Ответ, ПараметрыПроверки) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		УстановитьОжиданиеПоиска(Форма, Ложь);
		Форма.СостояниеПоиска = НСтр("ru = 'Поиск отменен. Запрос к сервису эмбеддингов не выполнялся.'");
		Возврат;
	КонецЕсли;
	Форма.СостояниеПоиска = НСтр("ru = 'Выполняется поиск по выбранным знаниям...'");
	Попытка
		Операция = КИИ_ИнтерфейсВызовСервера.НачатьПроверкуПоиска(ПараметрыПроверки, Форма.УникальныйИдентификатор);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиПоиска", Форма);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);
	Исключение
		УстановитьОжиданиеПоиска(Форма, Ложь);
		Форма.СостояниеПоиска = НСтр("ru = 'Не удалось запустить поиск. Подробности приведены в сообщении об ошибке.'");
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Обрабатывает действие формы: ПослеПроверкиПоиска.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
//  РезультатОперации - Структура, Неопределено - результат ожидания поиска.
//  ДополнительныеПараметры - Произвольный - параметры обработчика оповещения.
Процедура ПослеПроверкиПоиска(Форма, РезультатОперации, ДополнительныеПараметры) Экспорт

	УстановитьОжиданиеПоиска(Форма, Ложь);
	Если РезультатОперации = Неопределено Тогда
		Форма.СостояниеПоиска = НСтр("ru = 'Ожидание завершено. Если операция еще выполняется, ее результат не получен.'");
		Возврат;
	КонецЕсли;
	Если РезультатОперации.Статус <> "Выполнено" Тогда
		Форма.СостояниеПоиска = НСтр("ru = 'Не удалось выполнить поиск. Подробности доступны в журнале регистрации.'");
		Возврат;
	КонецЕсли;
	ПрименитьРезультатПоиска(Форма, РезультатОперации.АдресРезультата);
	Если Форма.НайденныеФрагменты.Количество() > 0 Тогда
		Форма.Элементы.СтраницыПоиска.ТекущаяСтраница = Форма.Элементы.СтраницаФрагменты;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает действие формы: ПараметрыПоискаПриИзменении.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
//  Элемент - ТаблицаФормы - элемент списка.
Процедура ПараметрыПоискаПриИзменении(Форма, Элемент)

	Форма.НайденныеФрагменты.Очистить();
	Форма.ТекстФрагмента = "";
	ОбновитьСведенияПоиска(Форма);
	Форма.СостояниеПоиска = НСтр("ru = 'Параметры изменены. Нажмите «Проверить поиск» для получения нового результата.'");

КонецПроцедуры

// Обрабатывает действие формы: ПрименитьРезультатПоиска.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
//  АдресРезультата - Строка - адрес результата в временном хранилище.
Процедура ПрименитьРезультатПоиска(Форма, Знач АдресРезультата)

	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	УдалитьИзВременногоХранилища(АдресРезультата);
	Форма.НайденныеФрагменты.Очистить();
	Форма.ТекстФрагмента = "";
	Если Результат = Неопределено Тогда
		Форма.СостояниеПоиска = НСтр("ru = 'Результат поиска недоступен. Повторите проверку.'");
		Возврат;
	КонецЕсли;
	Для Каждого Фрагмент Из Результат.Знания Цикл
		СтрокаТаблицы = Форма.НайденныеФрагменты.Добавить();
		СтрокаТаблицы.Фрагмент = Фрагмент.Ссылка;
		СтрокаТаблицы.База = Фрагмент.База;
		СтрокаТаблицы.Категория = Фрагмент.Категория;
		СтрокаТаблицы.Сходство = Фрагмент.Score;
		СтрокаТаблицы.Текст = Фрагмент.Текст;
	КонецЦикла;
	Если Результат.Статус = "ОК" Тогда
		Форма.СостояниеПоиска = СтрШаблон(НСтр("ru = 'Найдено фрагментов: %1. %2'"),
			Форма.НайденныеФрагменты.Количество(), Результат.Диагностика);
	Иначе
		Форма.СостояниеПоиска = Результат.Диагностика;
	КонецЕсли;
	Если Форма.НайденныеФрагменты.Количество() > 0 Тогда
		Форма.ТекстФрагмента = Форма.НайденныеФрагменты[0].Текст;
	КонецЕсли;

КонецПроцедуры

// Обрабатывает действие формы: ОбновитьСведенияПоиска.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
// Возвращаемое значение:
//  Структура - результат проверки готовности поиска.
Функция ОбновитьСведенияПоиска(Форма)

	Результат = КИИ_ИнтерфейсВызовСервера.СведенияПоиска(Форма.ЭкспертПоиска, Форма.БазаПоиска,
		Форма.КатегорияПоиска, Форма.МодельДляПроверки);
	Форма.СостояниеПоиска = Результат.Диагностика;
	Если ЗначениеЗаполнено(Результат.Модель) Тогда
		Форма.МодельПоиска = Строка(Результат.Модель) + " (" + Результат.КодМодели + ")";
	Иначе
		Форма.МодельПоиска = НСтр("ru = 'Не настроена'");
	КонецЕсли;
	Возврат Новый Структура("Статус", Результат.Статус);

КонецФункции

// Обрабатывает действие формы: УстановитьОжиданиеПоиска.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма журнала ошибок или проверки поиска знаний.
//  Выполняется - Булево - признак выполняющейся проверки.
Процедура УстановитьОжиданиеПоиска(Форма, Знач Выполняется)

	Форма.ПоискВыполняется = Выполняется;
	Форма.Элементы.ПроверитьПоиск.Доступность = Не Выполняется;
	Форма.Элементы.ЭкспертПоиска.Доступность = Не Выполняется;
	Форма.Элементы.БазаПоиска.Доступность = Не Выполняется;
	Форма.Элементы.КатегорияПоиска.Доступность = Не Выполняется;
	Форма.Элементы.Вопрос.Доступность = Не Выполняется;
	Форма.Элементы.КоличествоРезультатов.Доступность = Не Выполняется;
	Форма.Элементы.ПорогСходства.Доступность = Не Выполняется;
	Форма.Элементы.МодельДляПроверки.Доступность = Не Выполняется;

КонецПроцедуры

#КонецОбласти

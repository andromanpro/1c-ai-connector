#Область ПрограммныйИнтерфейс

// Записывает уникальные (дедуплицированные) ошибки в регистр Журнал и статистику.
//
// Параметры:
//  УникальныеОшибки - Соответствие из КлючИЗначение - хеш → {ЗаписьЖР, Количество}
//
Процедура ЗаписатьУникальныеОшибкиВРегистр(УникальныеОшибки) Экспорт

	Если УникальныеОшибки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Пачка Журнал+Статистика ДОЛЖНА быть атомарной: без транзакции частичный сбой оставлял
	// закоммиченные записи → на повторном сборе (дата не сохранена) счетчик задваивался.
	НачатьТранзакцию();
	Попытка

		Хеши = Новый Массив;
		Для Каждого Элемент Из УникальныеОшибки Цикл
			Хеши.Добавить(Элемент.Ключ);
		КонецЦикла;
		ЗаблокироватьОшибки(Хеши, Истина);
		ПравилаИгнорирования = АктивныеПравилаИгнорированияОшибок();
		Для Каждого Элемент Из УникальныеОшибки Цикл

			Хеш = Элемент.Ключ;
			Данные = Элемент.Значение;
			ЗаписьЖурнала = Данные.ЗаписьЖР;
			Количество = Данные.Количество;

			НаборЗаписей = РегистрыСведений.КИИ_МониторингОшибокЖурнал.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ХешОшибки.Установить(Хеш);
			НаборЗаписей.Прочитать();

			Если НаборЗаписей.Количество() = 0 Тогда

				Зап = НаборЗаписей.Добавить();
				Зап.ХешОшибки = Хеш;
				Зап.ПерваяДатаВремя = ЗаписьЖурнала.Дата;
				Зап.ПоследнееВхождение = ЗаписьЖурнала.Дата;
				Зап.КоличествоПовторений = Количество;
				Зап.ТекстОшибки = ЗаписьЖурнала.Комментарий;
				Зап.Событие = Строка(ЗаписьЖурнала.Событие);
				Зап.Пользователь = Строка(ЗаписьЖурнала.ИмяПользователя);
				Зап.Компьютер = Строка(ЗаписьЖурнала.Компьютер);
				Зап.Метаданные = ПолучитьПредставлениеМетаданных(ЗаписьЖурнала);
				Зап.Критичность = Перечисления.КИИ_УровниКритичности.Средняя;
				Зап.ТребуетАнализа = Истина;
				Зап.ПроанализированаИИ = Ложь;
				Зап.ОтправленаВТелеграм = Ложь;
				Зап.Игнорировать = ОшибкаСоответствуетПравилам(
					Зап.Событие, Зап.Метаданные, Зап.ТекстОшибки, ПравилаИгнорирования);
				Зап.ОшибкаАнализаИИ = Ложь;
				Зап.КоличествоОтправок = 0;

			Иначе

				Зап = НаборЗаписей[0];
				Зап.ПоследнееВхождение = Макс(Зап.ПоследнееВхождение, ЗаписьЖурнала.Дата);
				Зап.ПерваяДатаВремя = Мин(Зап.ПерваяДатаВремя, ЗаписьЖурнала.Дата);
				Зап.КоличествоПовторений = Зап.КоличествоПовторений + Количество;

			КонецЕсли;

			НаборЗаписей.Записать();

			ЗаписатьДвижениеСтатистики(Хеш, ЗаписьЖурнала, Количество);

		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Проверяет, подавляется ли ошибка правилом из справочника КИИ_ПравилаИгнорированияОшибок.
// Совпадение = ВСЕ непустые критерии правила (Событие/Метаданные/ТекстСодержит) содержатся
// в соответствующих полях ошибки (подстрока). Правило без единого критерия НЕ матчит (защита
// от «пустышки, глушащей всё»). Совпало → ошибку помечаем Игнорировать на этапе сбора.
//
// Параметры:
//  Событие - Строка - событие журнала регистрации.
//  Метаданные - Строка - имя объекта метаданных.
//  ТекстОшибки - Строка - текст проверяемой ошибки.
// Возвращаемое значение:
//  Булево - найдено активное правило с хотя бы одним критерием и совпадением всех критериев.
//
Функция ЭтоПодавляемаяОшибка(Знач Событие, Знач Метаданные, Знач ТекстОшибки) Экспорт

	Правила = АктивныеПравилаИгнорированияОшибок();
	Возврат ОшибкаСоответствуетПравилам(Событие, Метаданные, ТекстОшибки, Правила);

КонецФункции

// Обновляет поля записи регистра Журнал по хешу ошибки.
//
// Параметры:
//  ХешОшибки    - Строка - ключ записи
//  ЗначенияПолей - Структура - имя поля → значение
//  УвеличитьКоличествоОтправок - Булево - увеличить счетчик под той же блокировкой после отправки.
//
Процедура ОбновитьЗаписьРегистраОшибки(ХешОшибки, ЗначенияПолей, УвеличитьКоличествоОтправок = Ложь) Экспорт

	// Парные вызовы сохраняют активную транзакцию вызывающего кода.
	НачатьТранзакцию();
	Попытка
		Хеши = Новый Массив;
		Хеши.Добавить(ХешОшибки);
		ЗаблокироватьОшибки(Хеши);
		НаборЗаписей = РегистрыСведений.КИИ_МониторингОшибокЖурнал.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ХешОшибки.Установить(ХешОшибки);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			Зап = НаборЗаписей[0];
			Для Каждого Элемент Из ЗначенияПолей Цикл
				Зап[Элемент.Ключ] = Элемент.Значение;
			КонецЦикла;
			Если УвеличитьКоличествоОтправок Тогда
				Зап.КоличествоОтправок = Зап.КоличествоОтправок + 1;
			КонецЕсли;
			НаборЗаписей.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Помечает ошибку как отправленную в Telegram (флаг + дата + счетчик).
// Параметры:
//  ХешОшибки - Строка - хеш ошибки (ключ записи регистра Журнал).
Процедура ОбновитьФлагОтправкиТелеграм(ХешОшибки) Экспорт

	ПоляОбновления = Новый Структура("ОтправленаВТелеграм, ДатаПоследнейОтправки", Истина, ТекущаяДатаСеанса());
	ОбновитьЗаписьРегистраОшибки(ХешОшибки, ПоляОбновления, Истина);

КонецПроцедуры

// Удаляет из регистра Журнал записи старше пороговой даты. Возвращает число удаленных.
// Параметры:
//  ПороговаяДата - Дата - удаляются записи старше этой даты.
// Возвращаемое значение:
//  Число - количество удаленных записей.
Функция ОчиститьРегистрЖурнала(ПороговаяДата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.ХешОшибки КАК ХешОшибки
	|ИЗ
	|	РегистрСведений.КИИ_МониторингОшибокЖурнал КАК Р
	|ГДЕ
	|	Р.ПоследнееВхождение < &ПороговаяДата";
	Запрос.УстановитьПараметр("ПороговаяДата", ПороговаяДата);

	Выборка = Запрос.Выполнить().Выбрать();
	Счетчик = 0;

	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
			Хеши = Новый Массив;
			Хеши.Добавить(Выборка.ХешОшибки);
			ЗаблокироватьОшибки(Хеши);
			НаборЗаписей = РегистрыСведений.КИИ_МониторингОшибокЖурнал.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ХешОшибки.Установить(Выборка.ХешОшибки);
			НаборЗаписей.Прочитать();
			// За время ожидания блокировки сборщик мог обновить последнюю дату.
			Если НаборЗаписей.Количество() > 0 И НаборЗаписей[0].ПоследнееВхождение < ПороговаяДата Тогда
				НаборЗаписей.Очистить();
				НаборЗаписей.Записать();
				Счетчик = Счетчик + 1;
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Если ТранзакцияАктивна() Тогда
				// Ошибку во внешней транзакции должен обработать ее владелец.
				ВызватьИсключение;
			КонецЕсли;
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'КИИ.МониторингОшибок.Очистка'"),
				УровеньЖурналаРегистрации.Ошибка, ,
				Выборка.ХешОшибки,
				ТекстОшибки
			);
		КонецПопытки;
	КонецЦикла;

	Возврат Счетчик;

КонецФункции

// Удаляет из регистра Статистика записи старше пороговой даты. Возвращает число удаленных.
// Параметры:
//  ПороговаяДата - Дата - удаляются записи старше этой даты.
// Возвращаемое значение:
//  Число - количество удаленных записей.
Функция ОчиститьРегистрСтатистики(ПороговаяДата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.Период КАК Период
	|ИЗ
	|	РегистрСведений.КИИ_МониторингОшибокСтатистика КАК Р
	|ГДЕ
	|	Р.Период < &ПороговаяДата";
	Запрос.УстановитьПараметр("ПороговаяДата", ПороговаяДата);

	Выборка = Запрос.Выполнить().Выбрать();
	Счетчик = 0;

	Пока Выборка.Следующий() Цикл
		Попытка
			НаборЗаписей = РегистрыСведений.КИИ_МониторингОшибокСтатистика.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Период.Значение      = Выборка.Период;
			НаборЗаписей.Отбор.Период.Использование = Истина;
			НаборЗаписей.Прочитать();
			Счетчик = Счетчик + НаборЗаписей.Количество();
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'КИИ.МониторингОшибок.Очистка'"),
				УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	Возврат Счетчик;

КонецФункции

// Удаляет из регистра ЛогЗапросовИИ записи старше пороговой даты. Возвращает число удаленных.
// Параметры:
//  ПороговаяДата - Дата - удаляются записи старше этой даты.
// Возвращаемое значение:
//  Число - количество удаленных записей.
Функция ОчиститьРегистрЛогаИИ(ПороговаяДата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.Идентификатор                   КАК Идентификатор,
	|	Р.УниверсальнаяДатаВМиллисекундах КАК УниверсальнаяДатаВМиллисекундах
	|ИЗ
	|	РегистрСведений.КИИ_ЛогЗапросовИИ КАК Р
	|ГДЕ
	|	Р.ДатаЗапроса < &ПороговаяДата";
	Запрос.УстановитьПараметр("ПороговаяДата", ПороговаяДата);

	Выборка = Запрос.Выполнить().Выбрать();
	Счетчик = 0;

	Пока Выборка.Следующий() Цикл
		Попытка
			МенеджерЗаписи = РегистрыСведений.КИИ_ЛогЗапросовИИ.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Идентификатор                   = Выборка.Идентификатор;
			МенеджерЗаписи.УниверсальнаяДатаВМиллисекундах = Выборка.УниверсальнаяДатаВМиллисекундах;
			МенеджерЗаписи.Удалить();
			Счетчик = Счетчик + 1;
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'КИИ.МониторингОшибок.Очистка'"),
				УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	Возврат Счетчик;

КонецФункции

// Проверяет текущие условия правила на примере ошибки без записи и отправки.
// Параметры:
//  Правило - Структура - Событие, Метаданные, ТекстСодержит (Строка), Активно (Булево).
//  Ошибка - Структура - Событие, Метаданные, Текст (Строка).
// Возвращаемое значение:
//  Структура:
//   * Совпало - Булево - совпали все заполненные условия.
//   * Пояснение - Строка - результаты условий и предупреждения.
Функция РезультатПроверкиПравила(Правило, Ошибка) Экспорт

	ЕстьКритерий = Ложь;
	Совпало = Истина;
	Строки = Новый Массив;
	Условия = Новый Структура("Событие, Метаданные, ТекстСодержит", Ошибка.Событие, Ошибка.Метаданные, Ошибка.Текст);
	КоличествоУсловий = 0;
	Для Каждого Условие Из Условия Цикл
		Критерий = Правило[Условие.Ключ];
		ПрименитьКритерийПравила(Условие.Значение, Критерий, ЕстьКритерий, Совпало);
		Если Не ПустаяСтрока(Критерий) Тогда
			КоличествоУсловий = КоличествоУсловий + 1;
			Итог = ?(СтрНайти(Условие.Значение, Критерий) > 0, НСтр("ru = 'совпало'"), НСтр("ru = 'не совпало'"));
		Иначе
			Итог = НСтр("ru = 'не ограничено'");
		КонецЕсли;
		Строки.Добавить(Условие.Ключ + ": " + Итог);
	КонецЦикла;
	Совпало = Совпало И ЕстьКритерий;
	Если Не ЕстьКритерий Тогда
		Строки.Добавить(НСтр("ru = 'Правило пустое: ошибки не подавляются.'"));
	КонецЕсли;
	Если ЕстьКритерий И КоличествоУсловий = 1 Тогда
		Строки.Добавить(НСтр("ru = 'Внимание: одно условие. Проверьте, не захватывает ли оно лишние ошибки.'"));
	КонецЕсли;
	Если Не Правило.Активно Тогда
		Строки.Добавить(НСтр("ru = 'Правило выключено и не применяется. Итог ниже показывает совпадение условий.'"));
	КонецЕсли;
	Строки.Добавить(?(Совпало, НСтр("ru = 'Все заполненные условия совпали.'"), НСтр("ru = 'Правило не совпало.'")));
	Возврат Новый Структура("Совпало, Пояснение", Совпало, СтрСоединить(Строки, Символы.ПС));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает активные правила один раз на обрабатываемую партию ошибок.
// Возвращаемое значение:
//  ТаблицаЗначений - правила с критериями Событие, Метаданные и ТекстСодержит.
Функция АктивныеПравилаИгнорированияОшибок()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Правила.Событие       КАК Событие,
		|	Правила.Метаданные    КАК Метаданные,
		|	Правила.ТекстСодержит КАК ТекстСодержит
		|ИЗ
		|	Справочник.КИИ_ПравилаИгнорированияОшибок КАК Правила
		|ГДЕ
		|	Правила.Активно = ИСТИНА
		|	И Правила.ПометкаУдаления = ЛОЖЬ";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Проверяет ошибку по уже прочитанным правилам, не обращаясь к базе.
// Параметры:
//  Событие - Строка - событие журнала регистрации.
//  Метаданные - Строка - имя объекта метаданных.
//  ТекстОшибки - Строка - текст ошибки.
//  Правила - ТаблицаЗначений - активные правила с критериями Событие, Метаданные, ТекстСодержит.
// Возвращаемое значение:
//  Булево - все непустые критерии хотя бы одного правила совпали.
Функция ОшибкаСоответствуетПравилам(Знач Событие, Знач Метаданные, Знач ТекстОшибки, Знач Правила)

	Для Каждого Правило Из Правила Цикл

		ЕстьКритерий = Ложь;
		Совпало      = Истина;

		ПрименитьКритерийПравила(Событие, Правило.Событие, ЕстьКритерий, Совпало);
		ПрименитьКритерийПравила(Метаданные, Правило.Метаданные, ЕстьКритерий, Совпало);
		ПрименитьКритерийПравила(ТекстОшибки, Правило.ТекстСодержит, ЕстьКритерий, Совпало);

		Если Совпало И ЕстьКритерий Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Учитывает один критерий правила игнорирования: непустой критерий взводит ЕстьКритерий,
// отсутствие подстроки в значении поля сбрасывает Совпало. Уже несовпавшее правило
// (Совпало = Ложь) дальше не проверяется. Флаги мутируются по ссылке.
Процедура ПрименитьКритерийПравила(Знач ЗначениеПоля, Знач Критерий, ЕстьКритерий, Совпало)

	Если Не Совпало Или Не ЗначениеЗаполнено(Критерий) Тогда
		Возврат;
	КонецЕсли;

	ЕстьКритерий = Истина;
	Если СтрНайти(ЗначениеПоля, Критерий) = 0 Тогда
		Совпало = Ложь;
	КонецЕсли;

КонецПроцедуры

// Регистрирует движение статистики за день ВОЗНИКНОВЕНИЯ ошибки, ключ (Период, ХешОшибки).
// Критичность/тип здесь НЕ хранятся (протухали бы после анализа) - берутся из Журнала джойном
// по ХешОшибки: единый источник, всегда актуально (аудит P2 #2, star-schema).
//
// Параметры:
//  ХешОшибки - Строка - хеш уникальной ошибки (ключ join к Журналу).
//  ЗаписьЖурнала - Структура - запись-источник; используется ЗаписьЖурнала.Дата для периода.
//  Количество - Число - на сколько увеличить счетчик за день возникновения.
Процедура ЗаписатьДвижениеСтатистики(Знач ХешОшибки, ЗаписьЖурнала, Количество)

	ПериодСтатистики = НачалоДня(ЗаписьЖурнала.Дата);

	НаборЗаписей = РегистрыСведений.КИИ_МониторингОшибокСтатистика.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Значение        = ПериодСтатистики;
	НаборЗаписей.Отбор.Период.Использование    = Истина;
	НаборЗаписей.Отбор.ХешОшибки.Значение       = ХешОшибки;
	НаборЗаписей.Отбор.ХешОшибки.Использование  = Истина;
	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Количество() = 0 Тогда
		Зап            = НаборЗаписей.Добавить();
		Зап.Период     = ПериодСтатистики;
		Зап.ХешОшибки  = ХешОшибки;
		Зап.Количество = Количество;
	Иначе
		НаборЗаписей[0].Количество = НаборЗаписей[0].Количество + Количество;
	КонецЕсли;

	НаборЗаписей.Записать();

КонецПроцедуры

// Строковое представление метаданных из записи ЖР (для поля Метаданные регистра Журнал).
Функция ПолучитьПредставлениеМетаданных(ЗаписьЖурнала)

	Попытка
		Если ЗначениеЗаполнено(ЗаписьЖурнала.МетаданныеПредставление) Тогда
			Возврат Строка(ЗаписьЖурнала.МетаданныеПредставление);
		ИначеЕсли ЗначениеЗаполнено(ЗаписьЖурнала.Данные) Тогда
			Возврат Строка(ЗаписьЖурнала.Данные);
		Иначе
			Возврат "";
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Устанавливает блокировки только для изменяемых хешей; вызывается внутри транзакции.
// Параметры:
//  Хеши - Массив из Строка - хеши изменяемых ошибок.
//  ВключаяСтатистику - Булево - также защитить счетчики по этим ошибкам.
Процедура ЗаблокироватьОшибки(Знач Хеши, Знач ВключаяСтатистику = Ложь)
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("ХешОшибки", Новый ОписаниеТипов("Строка"));
	Для Каждого Хеш Из Хеши Цикл
		Данные.Добавить().ХешОшибки = Хеш;
	КонецЦикла;
	Данные.Сортировать("ХешОшибки");
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.КИИ_МониторингОшибокЖурнал");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.ИсточникДанных = Данные;
	Элемент.ИспользоватьИзИсточникаДанных("ХешОшибки", "ХешОшибки");
	Если ВключаяСтатистику Тогда
		Элемент = Блокировка.Добавить("РегистрСведений.КИИ_МониторингОшибокСтатистика");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.ИсточникДанных = Данные;
		Элемент.ИспользоватьИзИсточникаДанных("ХешОшибки", "ХешОшибки");
	КонецЕсли;
	Блокировка.Заблокировать();
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Ищет в тексте персональные данные форматных типов и возвращает найденные интервалы.
// Детекторы ничего не меняют в тексте: разбор идет по оригиналу, замену выполняет вызывающий код.
//
// Параметры:
//  Текст - Строка - текст, в котором ищутся персональные данные.
//  ВключенныеТипы - Массив из Строка - типы правил, которые нужно применить. Неопределено - все типы.
//
// Возвращаемое значение:
//  Массив из Структура - найденные значения в порядке появления в тексте:
//   * Тип - Строка - один из типов: СНИЛС, КАРТА, ИНН, ПАСПОРТ, EMAIL, ТЕЛЕФОН, ФИО.
//   * Значение - Строка - значение так, как оно записано в тексте.
//   * НормализованныйКлюч - Строка - значение, приведенное к виду для сравнения одинаковых значений.
//   * Начало - Число - позиция первого символа значения в тексте, начиная с единицы.
//   * Длина - Число - длина значения в символах.
//   * Уверенность - Строка - Высокая, если значение прошло контрольную сумму или собрано из нескольких
//                            признаков, Низкая - если найдено только по контекстному слову.
//   * Детектор - Строка - имя правила, которое нашло значение.
//
Функция НайтиСущности(Знач Текст, Знач ВключенныеТипы = Неопределено) Экспорт

	Перем РезультатРазделителиТокенов;

	Находки = Новый Массив;

	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Находки;
	КонецЕсли;

	РезультатРазделителиТокенов = РазделителиТокенов();
	ИсходныеТокены = СтрРазделить(Текст, РезультатРазделителиТокенов, Истина);
	Позиции = ПозицииТокенов(ИсходныеТокены);
	Токены = ТокеныДляРазбора(Текст, ИсходныеТокены, Позиции);

	Индекс = 0;
	Пока Индекс <= Токены.Количество() - 1 Цикл
		Индекс = Индекс + РазобратьТокен(Токены, Позиции, Индекс, ВключенныеТипы, Находки);
	КонецЦикла;

	// Значение берется из текста как есть: окно из нескольких токенов может разделяться не одним пробелом,
	// а контрольная проверка тела и восстановление ищут именно исходное написание.
	Для Каждого Находка Из Находки Цикл
		Находка.Значение = Сред(Текст, Находка.Начало, Находка.Длина);
	КонецЦикла;

	Возврат Находки;

КонецФункции

// Снимает пересечения между находками разных детекторов и возвращает непротиворечивый набор интервалов.
// Порядок разрешения: значение с проверенной контрольной суммой, затем более длинный интервал,
// затем более специфичный тип, затем более раннее начало.
//
// Параметры:
//  Находки - Массив из Структура - результат функции НайтиСущности.
//
// Возвращаемое значение:
//  Массив из Структура - подмножество находок без пересечений, по возрастанию начала интервала.
//
Функция РазрешитьПересечения(Знач Находки) Экспорт

	Перем ПолучательВызова;
	Перем КоличествоЭлементов;

	Перем РезультатФункции;

	Если Находки.Количество() < 2 Тогда
		РезультатФункции = КопияМассива(Находки);
		Возврат РезультатФункции;
	КонецЕсли;

	Принятые = Новый Массив;

	// Один проход по интервалам слева направо. Пересекающиеся находки сливаются в одну, покрывающую обе:
	// снять слабую целиком нельзя - ее хвост ушел бы открытым («ООО «Иванов Иван Иванович Ромашка»»).
	Для Каждого Очередная Из ОтсортированныеПоНачалу(Находки) Цикл

		Кандидат = Очередная;

		Пока Принятые.Количество() > 0 Цикл
			Последняя = Принятые[Принятые.Количество() - 1];
			Если Кандидат.Начало >= Последняя.Начало + Последняя.Длина Тогда
				Прервать;
			КонецЕсли;
			ПолучательВызова = Принятые;
			КоличествоЭлементов = Принятые.Количество();
			ПолучательВызова.Удалить(КоличествоЭлементов - 1);
			Кандидат = ПокрытиеПересечения(Последняя, Кандидат);
		КонецЦикла;

		Принятые.Добавить(Кандидат);

	КонецЦикла;

	Возврат Принятые;

КонецФункции

// Приводит значение к виду, по которому одинаковые значения получают одну подстановку.
// Нормализация используется только для сравнения: в тексте заменяется исходное написание.
//
// Параметры:
//  Тип - Строка - тип персональных данных.
//  Значение - Строка - значение так, как оно записано в тексте.
//
// Возвращаемое значение:
//  Строка - нормализованный ключ.
//
Функция НормализоватьЗначение(Знач Тип, Знач Значение) Экспорт

	Перем ЗначениеБезПробелов;
	Перем РезультатФункции;
	Перем ЗначениеВНижнемРегистре;

	Если Тип = "EMAIL" Тогда
		ЗначениеБезПробелов = СокрЛП(Значение);
		РезультатФункции = НРег(ЗначениеБезПробелов);
		Возврат РезультатФункции;
	КонецЕсли;

	Если Тип = "ФИО" Тогда
		ЗначениеБезПробелов = СокрЛП(Значение);
		ЗначениеВНижнемРегистре = НРег(ЗначениеБезПробелов);
		РезультатФункции = СтрЗаменить(ЗначениеВНижнемРегистре, "ё", "е");
		Возврат РезультатФункции;
	КонецЕсли;

	// Организация, адрес и дата рождения приходят от сервиса распознавания имен: сравниваются как текст.
	// Для даты это важно: «12 мая 1985» и «12 июня 1985» по одним цифрам совпали бы.
	Если Тип = "ОРГАНИЗАЦИЯ" Или Тип = "АДРЕС" Или Тип = "ДАТАРОЖДЕНИЯ" Тогда
		РезультатФункции = ТекстовыйКлюч(Значение);
		Возврат РезультатФункции;
	КонецЕсли;

	РезультатФункции = ТолькоЦифры(Значение);
	Возврат РезультатФункции;

КонецФункции

// Проверяет контрольные цифры идентификационного номера налогоплательщика.
//
// Параметры:
//  Цифры - Строка - только цифры номера, 10 или 12 знаков.
//
// Возвращаемое значение:
//  Булево - Истина, если контрольные цифры сходятся.
//
Функция ИННКорректен(Знач Цифры) Экспорт

	Перем ОдиннадцатыйСимволИНН;
	Перем ОдиннадцатаяЦифраИНН;
	Перем ДвенадцатыйСимволИНН;
	Перем ДвенадцатаяЦифраИНН;
	Перем РезультатКонтрольнаяЦифра;
	Перем ФрагментТекста;
	Перем РезультатФункции;

	Если ВырожденноеЗначение(Цифры) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрДлина(Цифры) = 10 Тогда
		РезультатКонтрольнаяЦифра = КонтрольнаяЦифра(Цифры, "2,4,10,3,5,9,4,6,8");
		ФрагментТекста = Сред(Цифры, 10, 1);
		РезультатФункции = РезультатКонтрольнаяЦифра = Число(ФрагментТекста);
		Возврат РезультатФункции;
	КонецЕсли;

	Если СтрДлина(Цифры) = 12 Тогда
		Одиннадцатая = КонтрольнаяЦифра(Цифры, "7,2,4,10,3,5,9,4,6,8");
		Двенадцатая = КонтрольнаяЦифра(Цифры, "3,7,2,4,10,3,5,9,4,6,8");
		ОдиннадцатыйСимволИНН = Сред(Цифры, 11, 1);
		ОдиннадцатаяЦифраИНН = Число(ОдиннадцатыйСимволИНН);
		РезультатФункции = Одиннадцатая = ОдиннадцатаяЦифраИНН;
		Если РезультатФункции Тогда
			ДвенадцатыйСимволИНН = Сред(Цифры, 12, 1);
			ДвенадцатаяЦифраИНН = Число(ДвенадцатыйСимволИНН);
			РезультатФункции = Двенадцатая = ДвенадцатаяЦифраИНН;
		КонецЕсли;
		Возврат РезультатФункции;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Проверяет контрольную сумму страхового номера индивидуального лицевого счета.
//
// Параметры:
//  Цифры - Строка - только цифры номера, 11 знаков.
//
// Возвращаемое значение:
//  Булево - Истина, если контрольная сумма сходится.
//
Функция СНИЛСКорректен(Знач Цифры) Экспорт

	Перем ФрагментТекста;
	Перем КонецТекста;

	Перем РезультатФункции;

	Если СтрДлина(Цифры) <> 11 Или ВырожденноеЗначение(Цифры) Тогда
		Возврат Ложь;
	КонецЕсли;

	Сумма = 0;
	Для Позиция = 1 По 9 Цикл
		ФрагментТекста = Сред(Цифры, Позиция, 1);
		Сумма = Сумма + Число(ФрагментТекста) * (10 - Позиция);
	КонецЦикла;

	Если Сумма < 100 Тогда
		Контрольное = Сумма;
	ИначеЕсли Сумма = 100 Или Сумма = 101 Тогда
		Контрольное = 0;
	Иначе
		Контрольное = Сумма % 101;
		Если Контрольное = 100 Тогда
			Контрольное = 0;
		КонецЕсли;
	КонецЕсли;

	КонецТекста = Прав(Цифры, 2);
	РезультатФункции = Контрольное = Число(КонецТекста);
	Возврат РезультатФункции;

КонецФункции

// Проверяет номер платежной карты по алгоритму Луна.
//
// Параметры:
//  Цифры - Строка - только цифры номера, от 13 до 19 знаков.
//
// Возвращаемое значение:
//  Булево - Истина, если контрольная сумма сходится.
//
Функция НомерКартыКорректен(Знач Цифры) Экспорт

	Перем ФрагментТекста;
	Перем РезультатФункции;

	Длина = СтрДлина(Цифры);
	Если Длина < 13 Или Длина > 19 Или ВырожденноеЗначение(Цифры) Тогда
		Возврат Ложь;
	КонецЕсли;

	Сумма = 0;
	Четность = Длина % 2;
	Для Позиция = 1 По Длина Цикл
		ФрагментТекста = Сред(Цифры, Позиция, 1);
		Значение = Число(ФрагментТекста);
		// Удваивается каждая вторая цифра справа: у позиции от нуля четность совпадает с четностью длины.
		Если (Позиция - 1) % 2 = Четность Тогда
			Значение = Значение * 2;
			Если Значение > 9 Тогда
				Значение = Значение - 9;
			КонецЕсли;
		КонецЕсли;
		Сумма = Сумма + Значение;
	КонецЦикла;

	РезультатФункции = Сумма % 10 = 0;
	Возврат РезультатФункции;

КонецФункции

// Возвращает версию свода правил. Версия попадает в событие журнала и в ключ кеша,
// поэтому меняется при любом изменении состава правил или их поведения.
//
// Возвращаемое значение:
//  Строка - версия свода правил.
//
Функция ВерсияПравил() Экспорт

	Возврат "1.3";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Токены

Функция РазделителиТокенов()

	Перем РезультатФункции;

	// Косая черта разделяет пары вида «ИНН/КПП 7707083893/770701001». Амперсанд режет HTML-сущности
	// «&quot;Иванов&quot;», звездочка и обратный апостроф - разметку Markdown из ответов модели.
	// Неразрывный пробел приходит из Word и из Формат(), кавычки-«лапки» - из Word, iOS и ответов модели.
	РезультатФункции = " "
		+ Символы.ПС
		+ Символы.ВК
		+ Символы.Таб
		+ Символы.НПП
		+ ",;:()[]{}<>/\&*`=|№#"
		+ """"
		+ "'"
		+ "«»“”„!?";
	Возврат РезультатФункции;

КонецФункции

// Готовит токены к разбору, не сдвигая позиций. Точка в конце предложения не входит в номер и адрес
// почты: «паспорт 45 06 123456.» Токены, начинающиеся с буквы, не трогаются - в инициалах «А.В.» точка
// значимая. Пустой токен у скобки помечается пропуском, чтобы номер «8 (903) 123-45-67» не рвался,
// а пустой токен после запятой по-прежнему окно останавливает.
//
// Параметры:
//  Текст - Строка - исходный текст.
//  Токены - Массив из Строка - токены текста.
//  Позиции - Массив из Число - позиции начала токенов в тексте.
//
// Возвращаемое значение:
//  Массив из Строка - токены для разбора, по одному на каждый исходный токен.
//
Функция ТокеныДляРазбора(Знач Текст, Знач Токены, Знач Позиции)

	Перем НачалоКонтекстаТокена;
	Перем КонтекстОколоТокена;
	Перем РезультатБезЗавершающихТочек;
	Перем РезультатПропускВНомере;

	Результат = Новый Массив;
	Для Индекс = 0 По Токены.Количество() - 1 Цикл
		Токен = Токены[Индекс];
		Если ЗначениеЗаполнено(Токен) Тогда
			РезультатБезЗавершающихТочек = БезЗавершающихТочек(Токен);
			Результат.Добавить(РезультатБезЗавершающихТочек);
		Иначе
			НачалоКонтекстаТокена = Макс(1, Позиции[Индекс] - 1);
			КонтекстОколоТокена = Сред(Текст, НачалоКонтекстаТокена, 2);
			Если ЕстьСкобка(КонтекстОколоТокена) Тогда
				РезультатПропускВНомере = ПропускВНомере();
				Результат.Добавить(РезультатПропускВНомере);
			Иначе
				Результат.Добавить(Токен);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция БезЗавершающихТочек(Знач Токен)

	Перем КодПервогоСимволаТокена;
	Перем ЭтоНечисловойТокен;
	Перем КодСимволаПередПроверкойПлюса;
	Перем КодЗнакаПлюс;
	Перем СимволТочкиВТокене;
	Перем ТочкаНеПередЦифрой;
	Перем КодСимволаПослеТочки;
	Перем РезультатФункции;
	Перем ДлинаТекста;

	КодПервогоСимволаТокена = КодСимвола(Токен, 1);
	ЭтоНечисловойТокен = Не ЭтоЦифра(КодПервогоСимволаТокена);
	Если ЭтоНечисловойТокен Тогда
		КодСимволаПередПроверкойПлюса = КодСимвола(Токен, 1);
		КодЗнакаПлюс = КодСимволаПлюс();
		ЭтоНечисловойТокен = КодСимволаПередПроверкойПлюса <> КодЗнакаПлюс;
	КонецЕсли;
	Если ЭтоНечисловойТокен Тогда
		ЭтоНечисловойТокен = СтрНайти(Токен, "@") = 0;
	КонецЕсли;
	Если ЭтоНечисловойТокен Тогда
		РезультатФункции = СловоБезТочкиВКонце(Токен);
		Возврат РезультатФункции;
	КонецЕсли;

	Очищенный = Токен;
	Пока СтрЗаканчиваетсяНа(Очищенный, ".") Цикл
		ДлинаТекста = СтрДлина(Очищенный);
		Очищенный = Лев(Очищенный, ДлинаТекста - 1);
	КонецЦикла;

	// У номера расширение имени файла отрезается: «7707083893.pdf». У адреса почты точка перед буквой -
	// часть домена, а в версии «8.3.24» после точки цифра, и такой токен не меняется.
	Если СтрНайти(Очищенный, "@") > 0 Тогда
		Возврат Очищенный;
	КонецЕсли;
	Для Позиция = 2 По СтрДлина(Очищенный) - 1 Цикл
		СимволТочкиВТокене = Сред(Очищенный, Позиция, 1);
		ТочкаНеПередЦифрой = СимволТочкиВТокене = ".";
		Если ТочкаНеПередЦифрой Тогда
			КодСимволаПослеТочки = КодСимвола(Очищенный, Позиция + 1);
			ТочкаНеПередЦифрой = Не ЭтоЦифра(КодСимволаПослеТочки);
		КонецЕсли;
		Если ТочкаНеПередЦифрой Тогда
			РезультатФункции = Лев(Очищенный, Позиция - 1);
			Возврат РезультатФункции;
		КонецЕсли;
	КонецЦикла;

	Возврат Очищенный;

КонецФункции

Функция ЕстьСкобка(Знач Фрагмент)

	Перем РезультатФункции;

	РезультатФункции = СтрНайти(Фрагмент, "(") > 0 Или СтрНайти(Фрагмент, ")") > 0;
	Возврат РезультатФункции;

КонецФункции

// У слова точка в конце предложения снимается: «…Иванович.» Инициалы «И.» и «А.В.» не трогаются -
// в них точка не последняя или слово из одной буквы.
Функция СловоБезТочкиВКонце(Знач Токен)

	Перем ЭтоРасширениеВКонцеТокена;
	Перем ЧислоТочекВТокене;
	Перем ОкончаниеТокенаПослеТочки;
	Перем ДлинаТекста;
	Перем РезультатФункции;

	Если СтрДлина(Токен) > 2 И СтрЗаканчиваетсяНа(Токен, ".") И СтрЧислоВхождений(Токен, ".") = 1 Тогда
		ДлинаТекста = СтрДлина(Токен);
		РезультатФункции = Лев(Токен, ДлинаТекста - 1);
		Возврат РезультатФункции;
	КонецЕсли;

	// «Иванович.docx» в имени файла: расширение латиницей отрезается от слова.
	Позиция = СтрНайти(Токен, ".");
	ЭтоРасширениеВКонцеТокена = Позиция > 2;
	Если ЭтоРасширениеВКонцеТокена Тогда
		ЧислоТочекВТокене = СтрЧислоВхождений(Токен, ".");
		ЭтоРасширениеВКонцеТокена = ЧислоТочекВТокене = 1;
	КонецЕсли;
	Если ЭтоРасширениеВКонцеТокена Тогда
		ОкончаниеТокенаПослеТочки = Сред(Токен, Позиция + 1);
		ЭтоРасширениеВКонцеТокена = ЭтоРасширениеФайла(ОкончаниеТокенаПослеТочки);
	КонецЕсли;
	Если ЭтоРасширениеВКонцеТокена Тогда
		РезультатФункции = Лев(Токен, Позиция - 1);
		Возврат РезультатФункции;
	КонецЕсли;

	Возврат Токен;

КонецФункции

Функция ЭтоРасширениеФайла(Знач Хвост)

	Длина = СтрДлина(Хвост);
	Если Длина < 2 Или Длина > 5 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По Длина Цикл
		Код = КодСимвола(Хвост, Позиция);
		Если Не ((Код >= 97 И Код <= 122) Или ЭтоЦифра(Код)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Метка пустого токена у скобки внутри номера. Сама скобка - разделитель, в токен она не попадает.
Функция ПропускВНомере()

	Возврат "()";

КонецФункции

Функция ПозицииТокенов(Знач Токены)

	Позиции = Новый Массив;
	Позиция = 1;
	Для Каждого Токен Из Токены Цикл
		Позиции.Добавить(Позиция);
		Позиция = Позиция + СтрДлина(Токен) + 1;
	КонецЦикла;

	Возврат Позиции;

КонецФункции

// Разбирает один токен и, если с него начинаются персональные данные, добавляет находку.
//
// Параметры:
//  Токены - Массив из Строка - токены текста.
//  Позиции - Массив из Число - позиции начала токенов в тексте.
//  Индекс - Число - индекс разбираемого токена.
//  ВключенныеТипы - Массив из Строка, Неопределено - типы правил, которые нужно применить.
//  Находки - Массив из Структура - сюда добавляются найденные значения.
//
// Возвращаемое значение:
//  Число - на сколько токенов сдвинуться дальше: значение из нескольких токенов пропускается целиком.
//
Функция РазобратьТокен(Знач Токены, Знач Позиции, Знач Индекс, Знач ВключенныеТипы, Находки)

	Перем ДлинаТекста;

	Токен = Токены[Индекс];
	Если Не ЗначениеЗаполнено(Токен) Тогда
		Возврат 1;
	КонецЕсли;

	// Дешевый отсев: разбираем только то, что может начинать персональные данные. Односимвольный токен
	// тоже разбирается: телефон «8 903 123 45 67» начинается с одной цифры.
	ПервыйКод = КодСимвола(Токен, 1);
	Разбор = Неопределено;
	// Номер начинается только с чисто числового токена: версия «8.3.24.1234» или дата «01.02.2026» - не номер.
	Если (ЭтоЦифра(ПервыйКод) Или ПервыйКод = КодСимволаПлюс()) И ЭтоЧисловойТокен(Токен) Тогда
		Разбор = РазобратьЧисловоеОкно(Токены, Позиции, Индекс, ВключенныеТипы);
	ИначеЕсли ЭтоЗаглавнаяБуква(ПервыйКод) Тогда
		Разбор = РазобратьИмя(Токены, Позиции, Индекс, ВключенныеТипы);
	Иначе
		Разбор = Неопределено;
	КонецЕсли;

	СдвигИндекса = 1;
	Если Разбор <> Неопределено Тогда
		Находки.Добавить(Разбор.Находка);
		СдвигИндекса = Разбор.Токенов;
	КонецЕсли;

	Если ТипВключен("EMAIL", ВключенныеТипы) И ЭтоАдресПочты(Токен) Тогда
		КлючПочты = НормализоватьЗначение("EMAIL", Токен);
		ДлинаТекста = СтрДлина(Токен);
		НаходкаПочты = НоваяНаходка(
			"EMAIL", Токен, КлючПочты, Позиции[Индекс], ДлинаТекста, "Высокая", "ПочтаПоСтруктуре");
		Находки.Добавить(НаходкаПочты);
	КонецЕсли;

	Возврат СдвигИндекса;

КонецФункции

Функция ОкноТекстом(Знач Токены, Знач Индекс, Знач Ширина)

	Перем РезультатФункции;

	Части = Новый Массив;
	Для Смещение = 0 По Ширина Цикл
		Части.Добавить(Токены[Индекс + Смещение]);
	КонецЦикла;

	РезультатФункции = СтрСоединить(Части, " ");
	Возврат РезультатФункции;

КонецФункции

Функция ДлинаОкна(Знач Токены, Знач Позиции, Знач Индекс, Знач Ширина)

	Перем РезультатФункции;

	ПоследнийИндекс = Индекс + Ширина;

	РезультатФункции = Позиции[ПоследнийИндекс] + СтрДлина(Токены[ПоследнийИндекс]) - Позиции[Индекс];
	Возврат РезультатФункции;

КонецФункции

Функция КонтекстноеСловоРядом(Знач Токены, Знач Индекс, Знач Слово)

	Перем ЗначениеВНижнемРегистре;

	Начало = Макс(0, Индекс - 2);
	Для Позиция = Начало По Индекс - 1 Цикл
		ЗначениеВНижнемРегистре = НРег(Токены[Позиция]);
		Если СтрНачинаетсяС(ЗначениеВНижнемРегистре, Слово) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область Символы

Функция КодСимволаПлюс()

	Возврат 43;

КонецФункции

Функция КодСимволаДефис()

	Возврат 45;

КонецФункции

Функция ЭтоЦифра(Знач Код)

	Перем РезультатФункции;

	РезультатФункции = Код >= 48 И Код <= 57;
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоЗаглавнаяБуква(Знач Код)

	Перем РезультатФункции;

	ЭтоКириллица = (Код >= 1040 И Код <= 1071) Или Код = 1025;
	ЭтоЛатиница = Код >= 65 И Код <= 90;

	РезультатФункции = ЭтоКириллица Или ЭтоЛатиница;
	Возврат РезультатФункции;

КонецФункции

#КонецОбласти

#Область ЧисловыеЗначения

// Числовое значение может быть разорвано пробелами и дефисами, поэтому собирается окно до пяти токенов.
// Побеждает самое длинное окно, прошедшее проверку: так СНИЛС «112-233-445 95» не теряется на пробеле.
//
// Параметры:
//  Токены - Массив из Строка - токены текста.
//  Позиции - Массив из Число - позиции начала токенов в тексте.
//  Индекс - Число - индекс первого токена окна.
//  ВключенныеТипы - Массив из Строка, Неопределено - типы правил, которые нужно применить.
//
// Возвращаемое значение:
//  Неопределено - в окне нет персональных данных.
//  Структура - найденное значение:
//   * Находка - Структура - описание находки, как в результате НайтиСущности.
//   * Токенов - Число - сколько токенов заняло значение.
//
Функция РазобратьЧисловоеОкно(Знач Токены, Знач Позиции, Знач Индекс, Знач ВключенныеТипы)

	Перем РезультатОкноТекстом;
	Перем РезультатДлинаОкна;

	Перем РезультатФункции;

	Накопленные = НакопленныеЦифрыОкна(Токены, Индекс);
	ЕстьПаспорт = КонтекстноеСловоРядом(Токены, Индекс, "паспорт");
	ЕстьИдентификатор = КонтекстноеСловоРядом(Токены, Индекс, "инн") Или КонтекстноеСловоРядом(Токены, Индекс, "снилс");
	Контекст = Новый Структура("Паспорт, Идентификатор", ЕстьПаспорт, ЕстьИдентификатор);

	Ширина = Накопленные.Количество() - 1;
	Пока Ширина >= 0 Цикл

		Значение = Накопленные[Ширина];
		Распознанное = ?(
			Значение = Неопределено, Неопределено, ТипЧисловогоЗначения(Значение, Контекст, ВключенныеТипы));

		Если Распознанное <> Неопределено Тогда
			РезультатОкноТекстом = ОкноТекстом(Токены, Индекс, Ширина);
			РезультатДлинаОкна = ДлинаОкна(Токены, Позиции, Индекс, Ширина);
			Находка = НоваяНаходка(
				Распознанное.Тип,
				РезультатОкноТекстом,
				Значение,
				Позиции[Индекс],
				РезультатДлинаОкна,
				Распознанное.Уверенность,
				Распознанное.Детектор);
			РезультатФункции = Новый Структура("Находка, Токенов", Находка, Ширина + 1);
			Возврат РезультатФункции;
		КонецЕсли;

		Ширина = Ширина - 1;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция НакопленныеЦифрыОкна(Знач Токены, Знач Индекс)

	Перем КоличествоЭлементов;

	Накопленные = Новый Массив;
	Цифры = "";
	КоличествоЭлементов = Токены.Количество();
	МаксимумТокенов = Мин(8, КоличествоЭлементов - Индекс);
	Для Смещение = 0 По МаксимумТокенов - 1 Цикл
		Текущий = Токены[Индекс + Смещение];
		// Скобка внутри номера «8 (903) 123» дает пустой токен: окно через него идет, но на нем не кончается.
		Если Смещение > 0 И Текущий = ПропускВНомере() Тогда
			Накопленные.Добавить(Неопределено);
			Продолжить;
		КонецЕсли;
		// Окно растет только по числовым токенам: иначе «7707083893, договор 12» склеится в один номер.
		Если Смещение > 0 И Не ЭтоЧисловойТокен(Текущий) Тогда
			Прервать;
		КонецЕсли;
		Цифры = Цифры + ТолькоЦифры(Текущий);
		Если СтрДлина(Цифры) > 19 Тогда
			Прервать;
		КонецЕсли;
		Накопленные.Добавить(Цифры);
	КонецЦикла;

	Возврат Накопленные;

КонецФункции

// Определяет тип числового значения. Порядок проверок задает приоритет: значение с контрольной суммой
// раньше значения по контексту.
//
// Параметры:
//  Значение - Строка - только цифры кандидата.
//  Контекст - Структура - контекстные слова перед значением:
//   * Паспорт - Булево - рядом стоит слово «паспорт».
//   * Идентификатор - Булево - рядом стоит слово «ИНН» или «СНИЛС».
//  ВключенныеТипы - Массив из Строка, Неопределено - типы правил, которые нужно применить.
//
// Возвращаемое значение:
//  Неопределено - значение не распознано.
//  Структура - распознанное значение:
//   * Тип - Строка - тип персональных данных.
//   * Уверенность - Строка - Высокая или Низкая.
//   * Детектор - Строка - имя правила.
//
Функция ТипЧисловогоЗначения(Знач Значение, Знач Контекст, Знач ВключенныеТипы)

	Перем РезультатФункции;

	Длина = СтрДлина(Значение);

	Если ЭтоСНИЛС(Значение, Длина, ВключенныеТипы) Тогда
		РезультатФункции = РаспознанноеЗначение("СНИЛС", "Высокая", "СНИЛСКонтрольнаяСумма");
		Возврат РезультатФункции;
	КонецЕсли;

	Если ЭтоТелефон(Значение, Длина, ВключенныеТипы) Тогда
		РезультатФункции = РаспознанноеЗначение("ТЕЛЕФОН", "Высокая", "ТелефонОдиннадцатьЦифр");
		Возврат РезультатФункции;
	КонецЕсли;

	Если ЭтоИНН(Значение, Длина, ВключенныеТипы) Тогда
		РезультатФункции = РаспознанноеЗначение("ИНН", "Высокая", "ИННКонтрольныеЦифры");
		Возврат РезультатФункции;
	КонецЕсли;

	Если ЭтоНомерКарты(Значение, Длина, ВключенныеТипы) Тогда
		РезультатФункции = РаспознанноеЗначение("КАРТА", "Высокая", "КартаЛун");
		Возврат РезультатФункции;
	КонецЕсли;

	Если Длина = 10 И Контекст.Паспорт И ТипВключен("ПАСПОРТ", ВключенныеТипы) Тогда
		РезультатФункции = РаспознанноеЗначение("ПАСПОРТ", "Высокая", "ПаспортПоКонтексту");
		Возврат РезультатФункции;
	КонецЕсли;

	// Рядом стоит слово ИНН или СНИЛС, а контрольная сумма не сошлась: значение все равно считается
	// находкой, но с пониженной уверенностью - решение принимает режим канала.
	Если Контекст.Идентификатор И ДлинаИдентификатора(Длина) Тогда
		Тип = ?(Длина = 11, "СНИЛС", "ИНН");
		РезультатФункции = РаспознанноеЗначение(Тип, "Низкая", "ИдентификаторПоКонтексту");
		Возврат РезультатФункции;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция РаспознанноеЗначение(Знач Тип, Знач Уверенность, Знач Детектор)

	Перем РезультатФункции;

	РезультатФункции = Новый Структура("Тип, Уверенность, Детектор", Тип, Уверенность, Детектор);
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоСНИЛС(Знач Значение, Знач Длина, Знач ВключенныеТипы)

	Перем РезультатФункции;

	РезультатФункции = Длина = 11 И ТипВключен("СНИЛС", ВключенныеТипы) И СНИЛСКорректен(Значение);
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоТелефон(Знач Значение, Знач Длина, Знач ВключенныеТипы)

	Перем РезультатФункции;

	Если Длина <> 11 Или Не ТипВключен("ТЕЛЕФОН", ВключенныеТипы) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПерваяЦифра = Лев(Значение, 1);

	РезультатФункции = ПерваяЦифра = "7" Или ПерваяЦифра = "8";
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоИНН(Знач Значение, Знач Длина, Знач ВключенныеТипы)

	Перем РезультатФункции;

	Если Длина <> 10 И Длина <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатФункции = ТипВключен("ИНН", ВключенныеТипы) И ИННКорректен(Значение);
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоНомерКарты(Знач Значение, Знач Длина, Знач ВключенныеТипы)

	Перем РезультатФункции;

	Если Длина < 13 Или Длина > 19 Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатФункции = ТипВключен("КАРТА", ВключенныеТипы) И НомерКартыКорректен(Значение);
	Возврат РезультатФункции;

КонецФункции

Функция ДлинаИдентификатора(Знач Длина)

	Перем РезультатФункции;

	РезультатФункции = Длина >= 10 И Длина <= 12;
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоЧисловойТокен(Знач Токен)

	ЕстьЦифра = Ложь;
	Для Позиция = 1 По СтрДлина(Токен) Цикл
		Код = КодСимвола(Токен, Позиция);
		Если ЭтоЦифра(Код) Тогда
			ЕстьЦифра = Истина;
			Продолжить;
		КонецЕсли;
		Если Код <> КодСимволаДефис() И Код <> КодСимволаПлюс() Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат ЕстьЦифра;

КонецФункции

Функция ТолькоЦифры(Знач Значение)

	Перем РезультатКодСимвола;
	Перем РезультатФункции;

	Части = Новый Массив;
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		РезультатКодСимвола = КодСимвола(Символ);
		Если ЭтоЦифра(РезультатКодСимвола) Тогда
			Части.Добавить(Символ);
		КонецЕсли;
	КонецЦикла;

	РезультатФункции = СтрСоединить(Части, "");
	Возврат РезультатФункции;

КонецФункции

Функция ВырожденноеЗначение(Знач Цифры)

	Если Не ЗначениеЗаполнено(Цифры) Тогда
		Возврат Истина;
	КонецЕсли;

	Первая = Лев(Цифры, 1);
	Для Позиция = 2 По СтрДлина(Цифры) Цикл
		Если Сред(Цифры, Позиция, 1) <> Первая Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция КонтрольнаяЦифра(Знач Цифры, Знач СтрокаВесов)

	Перем ФрагментТекста;

	Перем РезультатФункции;

	Веса = СтрРазделить(СтрокаВесов, ",");
	Сумма = 0;
	Для Позиция = 1 По Веса.Количество() Цикл
		ФрагментТекста = Сред(Цифры, Позиция, 1);
		Сумма = Сумма + Число(ФрагментТекста) * Число(Веса[Позиция - 1]);
	КонецЦикла;

	РезультатФункции = Сумма % 11 % 10;
	Возврат РезультатФункции;

КонецФункции

#КонецОбласти

#Область ПочтаИИмена

Функция ЭтоАдресПочты(Знач Токен)

	Перем РезультатФункции;

	Собака = СтрНайти(Токен, "@");
	Если Собака < 2 Или Собака = СтрДлина(Токен) Тогда
		Возврат Ложь;
	КонецЕсли;

	Домен = Сред(Токен, Собака + 1);
	Точка = СтрНайти(Домен, ".");

	РезультатФункции = Точка > 1 И Точка < СтрДлина(Домен);
	Возврат РезультатФункции;

КонецФункции

// Полное имя из трех слов с заглавной буквы с отчеством либо фамилия с инициалами.
//
// Параметры:
//  Токены - Массив из Строка - токены текста.
//  Позиции - Массив из Число - позиции начала токенов в тексте.
//  Индекс - Число - индекс первого слова имени.
//  ВключенныеТипы - Массив из Строка, Неопределено - типы правил, которые нужно применить.
//
// Возвращаемое значение:
//  Неопределено - с этого токена имя не начинается.
//  Структура - найденное имя:
//   * Находка - Структура - описание находки, как в результате НайтиСущности.
//   * Токенов - Число - сколько токенов заняло имя.
//
Функция РазобратьИмя(Знач Токены, Знач Позиции, Знач Индекс, Знач ВключенныеТипы)

	Перем РезультатНормализоватьЗначение;
	Перем РезультатДлинаОкна;

	Перем РезультатФункции;

	Если Не ТипВключен("ФИО", ВключенныеТипы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Детектор = ДетекторИмени(Токены, Индекс);
	Если Детектор = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ширина = ?(Детектор = "ИмяТриСлова" Или Детектор = "ИмяОтчествоФамилия", 2, 1);

	Значение = ОкноТекстом(Токены, Индекс, Ширина);
	РезультатНормализоватьЗначение = НормализоватьЗначение("ФИО", Значение);
	РезультатДлинаОкна = ДлинаОкна(Токены, Позиции, Индекс, Ширина);
	Находка = НоваяНаходка(
		"ФИО", Значение, РезультатНормализоватьЗначение, Позиции[Индекс], РезультатДлинаОкна, "Высокая", Детектор);

	РезультатФункции = Новый Структура("Находка, Токенов", Находка, Ширина + 1);
	Возврат РезультатФункции;

КонецФункции

// Какой порядок имени начинается с токена: «Фамилия Имя Отчество», «Имя Отчество Фамилия»,
// «Фамилия И.О.», «И.О. Фамилия». Пустая строка - имени нет.
Функция ДетекторИмени(Знач Токены, Знач Индекс)

	// «Звонила Анна Ивановна Петрова»: слово с заглавной в начале предложения не фамилия,
	// если за ним стоит имя с отчеством и фамилией по окончанию.
	Если ЭтоПолноеИмя(Токены, Индекс) И Не ЭтоИмяОтчествоФамилия(Токены, Индекс + 1) Тогда
		Возврат "ИмяТриСлова";
	КонецЕсли;
	Если ЭтоИмяОтчествоФамилия(Токены, Индекс) Тогда
		Возврат "ИмяОтчествоФамилия";
	КонецЕсли;
	Если ЭтоФамилия(Токены[Индекс]) И ЭтоФамилияСИнициалами(Токены, Индекс) Тогда
		Возврат "ФамилияСИнициалами";
	КонецЕсли;
	Если ЭтоИнициалыПередФамилией(Токены, Индекс) Тогда
		Возврат "ИнициалыИФамилия";
	КонецЕсли;

	Возврат "";

КонецФункции

// Перед фамилией - только полные инициалы «И.И.»: одна буква с точкой - это пункт списка «А. Проверить»
// или сокращение «Г. Москва».
Функция ЭтоИнициалыПередФамилией(Знач Токены, Знач Индекс)

	Перем РезультатФункции;

	Если Не ЭтоИнициалы(Токены[Индекс]) Или СтрДлина(Токены[Индекс]) < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатФункции = Индекс + 1 <= Токены.Количество() - 1 И ЭтоФамилия(Токены[Индекс + 1]);
	Возврат РезультатФункции;

КонецФункции

// «Иван Иванович Иванов»: отчество вторым словом, фамилия третьим. Третье слово принимается только
// с фамильным окончанием, иначе «Анна Ивановна Главный бухгалтер» станет человеком.
Функция ЭтоИмяОтчествоФамилия(Знач Токены, Знач Индекс)

	Перем РезультатФункции;

	Если Индекс + 2 > Токены.Количество() - 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатФункции = ЭтоФамилия(Токены[Индекс])
		И ЭтоОтчество(Токены[Индекс + 1])
		И ЭтоФамилия(Токены[Индекс + 2])
		И ЕстьФамильноеОкончание(Токены[Индекс + 2]);
	Возврат РезультатФункции;

КонецФункции

Функция ЕстьФамильноеОкончание(Знач Слово)

	Значение = НРег(Слово);
	Для Каждого Окончание Из ОкончанияФамилий() Цикл
		Если СтрЗаканчиваетсяНа(Значение, Окончание) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ОкончанияФамилий()

	Перем РезультатФункции;

	РезультатФункции = СтрРазделить(
		"ов,ова,ев,ева,ин,ина,ын,ына,ский,ская,цкий,цкая,ской,ых,их,енко,ук,юк,ян,дзе,швили", ",");
	Возврат РезультатФункции;

КонецФункции

// Слово кириллицей с заглавной буквы и строчными дальше: «HTTP», «ООО», «SQL» фамилией не считаются.
// Фамилия заглавными («ИВАНОВ И.И.» в печатных формах) принимается от четырех букв.
Функция ЭтоФамилия(Знач Токен)

	Перем ФамилияНеПодходит;
	Перем КодПервойБуквыФамилии;

	ФамилияНеПодходит = СтрДлина(Токен) < 2;
	Если Не ФамилияНеПодходит Тогда
		КодПервойБуквыФамилии = КодСимвола(Токен, 1);
		ФамилияНеПодходит = Не ЭтоЗаглавнаяКириллица(КодПервойБуквыФамилии);
	КонецЕсли;
	Если ФамилияНеПодходит Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрДлина(Токен) >= 4 И ВРег(Токен) = Токен И ВсеБуквыКириллица(Токен) Тогда
		Возврат Истина;
	КонецЕсли;

	Длина = СтрДлина(Токен);
	Для Позиция = 2 По Длина Цикл
		Код = КодСимвола(Токен, Позиция);
		Если (Код >= 1072 И Код <= 1103) Или Код = 1105 Тогда
			Продолжить;
		КонецЕсли;
		// Двойная фамилия через дефис: «Петров-Водкин».
		ПослеДефиса = КодСимвола(Токен, Позиция - 1) = КодСимволаДефис();
		Если Код = КодСимволаДефис() И Позиция < Длина И Не ПослеДефиса Тогда
			Продолжить;
		КонецЕсли;
		Если ПослеДефиса И ЭтоЗаглавнаяКириллица(Код) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Ложь;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ВсеБуквыКириллица(Знач Токен)

	Для Позиция = 1 По СтрДлина(Токен) Цикл
		Код = КодСимвола(Токен, Позиция);
		Если Не ЭтоБукваКириллицы(Код) И Код <> КодСимволаДефис() Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоБукваКириллицы(Знач Код)

	Перем РезультатФункции;

	РезультатФункции = (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105;
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоЗаглавнаяКириллица(Знач Код)

	Перем РезультатФункции;

	РезультатФункции = (Код >= 1040 И Код <= 1071) Или Код = 1025;
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоПолноеИмя(Знач Токены, Знач Индекс)

	Перем РезультатФункции;

	Если Индекс + 2 > Токены.Количество() - 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ЭтоСловоСЗаглавной(Токены[Индекс + 1]) Или Не ЭтоСловоСЗаглавной(Токены[Индекс + 2]) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Тройка слов с заглавной считается именем только при отчестве: иначе «Реализация Товаров Услуг»
	// и прочие имена метаданных станут людьми. Имя без отчества берет словарь базы, а его в 1.5 нет.
	РезультатФункции = ЭтоОтчество(Токены[Индекс + 2]);
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоФамилияСИнициалами(Знач Токены, Знач Индекс)

	Перем РезультатФункции;

	Если Индекс + 1 > Токены.Количество() - 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатФункции = ЭтоИнициалы(Токены[Индекс + 1]);
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоСловоСЗаглавной(Знач Токен)

	Перем КодПервойБуквыСлова;
	Перем РезультатФункции;

	РезультатФункции = СтрДлина(Токен) > 1;
	Если РезультатФункции Тогда
		КодПервойБуквыСлова = КодСимвола(Токен, 1);
		РезультатФункции = ЭтоЗаглавнаяБуква(КодПервойБуквыСлова);
	КонецЕсли;
	Возврат РезультатФункции;

КонецФункции

Функция ЭтоОтчество(Знач Токен)

	Значение = НРег(Токен);
	Если СтрДлина(Значение) < 5 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Окончание Из ОкончанияОтчеств() Цикл
		Если СтрЗаканчиваетсяНа(Значение, Окончание) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ОкончанияОтчеств()

	Перем РезультатФункции;

	РезультатФункции = СтрРазделить("ович,евич,ьич,овна,евна,ична,инична,овича,евича,овну,евну,овне,евне", ",");
	Возврат РезультатФункции;

КонецФункции

// Инициалы - заглавные буквы кириллицы через точку: «И.», «И.И.», «И.И». Слово с точкой - не инициалы.
Функция ЭтоИнициалы(Знач Токен)

	Длина = СтрДлина(Токен);
	Если Длина < 2 Или Длина > 4 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По Длина Цикл
		Код = КодСимвола(Токен, Позиция);
		Если Позиция % 2 = 1 И Не ЭтоЗаглавнаяКириллица(Код) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Позиция % 2 = 0 И Сред(Токен, Позиция, 1) <> "." Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Находки

Функция ТипВключен(Знач Тип, Знач ВключенныеТипы)

	Перем РезультатФункции;

	РезультатФункции = ВключенныеТипы = Неопределено Или ВключенныеТипы.Найти(Тип) <> Неопределено;
	Возврат РезультатФункции;

КонецФункции

Функция НоваяНаходка(Знач Тип, Знач Значение, Знач НормализованныйКлюч, Знач Начало, Знач Длина,
	Знач Уверенность, Знач Детектор)

	Находка = Новый Структура;
	Находка.Вставить("Тип", Тип);
	Находка.Вставить("Значение", Значение);
	Находка.Вставить("НормализованныйКлюч", НормализованныйКлюч);
	Находка.Вставить("Начало", Начало);
	Находка.Вставить("Длина", Длина);
	Находка.Вставить("Уверенность", Уверенность);
	Находка.Вставить("Детектор", Детектор);

	Возврат Находка;

КонецФункции

Функция КопияМассива(Знач Исходный)

	Результат = Новый Массив;
	Для Каждого Элемент Из Исходный Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сортирует находки по началу интервала, при равном начале - более длинные раньше. Сортировка идет
// таблицей значений: это нативная операция платформы, на тысяче находок она в разы дешевле вставок.
//
// Параметры:
//  Находки - Массив из Структура - находки в произвольном порядке.
//
// Возвращаемое значение:
//  Массив из Структура - те же находки в порядке сортировки.
//
Функция ОтсортированныеПоНачалу(Знач Находки)

	Перем ТипЗначения;

	Таблица = Новый ТаблицаЗначений;
	ТипЗначения = Новый ОписаниеТипов("Число");
	Таблица.Колонки.Добавить("Начало", ТипЗначения);
	ТипЗначения = Новый ОписаниеТипов("Число");
	Таблица.Колонки.Добавить("Длина", ТипЗначения);
	Таблица.Колонки.Добавить("Находка");

	Для Каждого Находка Из Находки Цикл
		Строка = Таблица.Добавить();
		Строка.Начало = Находка.Начало;
		Строка.Длина = Находка.Длина;
		Строка.Находка = Находка;
	КонецЦикла;

	Таблица.Сортировать("Начало Возр, Длина Убыв");

	Результат = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Находка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Одна находка вместо двух пересекающихся; Левая начинается не позже Правой. Вложенная уступает
// охватывающей, одинаковые интервалы решает приоритет, при частичном пересечении интервал
// объединяется, а тип и детектор берутся у более приоритетной.
Функция ПокрытиеПересечения(Знач Левая, Знач Правая)

	КонецЛевой = Левая.Начало + Левая.Длина;
	КонецПравой = Правая.Начало + Правая.Длина;

	Если Левая.Начало = Правая.Начало И КонецЛевой = КонецПравой Тогда
		Если ПриоритетВыше(Правая, Левая) Тогда
			Возврат Правая;
		КонецЕсли;
		Возврат Левая;
	КонецЕсли;
	Если КонецПравой <= КонецЛевой Тогда
		Возврат Левая;
	КонецЕсли;
	Если Левая.Начало = Правая.Начало Тогда
		Возврат Правая;
	КонецЕсли;

	Главная = Левая;
	Если ПриоритетВыше(Правая, Левая) Тогда
		Главная = Правая;
	КонецЕсли;
	Итог = Новый Структура;
	Для Каждого Свойство Из Главная Цикл
		Итог.Вставить(Свойство.Ключ, Свойство.Значение);
	КонецЦикла;
	Итог.Начало = Левая.Начало;
	Итог.Значение = Левая.Значение + Сред(Правая.Значение, КонецЛевой - Правая.Начало + 1);
	Итог.Длина = СтрДлина(Итог.Значение);
	// Ключ по унаследованному типу склеил бы разные составные значения с одним телефоном или ИНН.
	Итог.НормализованныйКлюч = "составное|" + ТекстовыйКлюч(Итог.Значение);

	Возврат Итог;

КонецФункции

// Текст в нижнем регистре с одиночными пробелами.
Функция ТекстовыйКлюч(Знач Значение)

	Перем ЗначениеВНижнемРегистре;
	Перем ЧастиТекста;
	Перем РезультатФункции;

	ЗначениеВНижнемРегистре = НРег(Значение);
	ЧастиТекста = СтрРазделить(ЗначениеВНижнемРегистре, " " + Символы.ПС + Символы.Таб, Ложь);
	РезультатФункции = СтрСоединить(ЧастиТекста, " ");
	Возврат РезультатФункции;

КонецФункции

Функция ПриоритетВыше(Знач Первая, Знач Вторая)

	Перем РезультатФункции;

	Если ВесУверенности(Первая) <> ВесУверенности(Вторая) Тогда
		РезультатФункции = ВесУверенности(Первая) > ВесУверенности(Вторая);
		Возврат РезультатФункции;
	КонецЕсли;

	Если Первая.Длина <> Вторая.Длина Тогда
		РезультатФункции = Первая.Длина > Вторая.Длина;
		Возврат РезультатФункции;
	КонецЕсли;

	Если ВесТипа(Первая.Тип) <> ВесТипа(Вторая.Тип) Тогда
		РезультатФункции = ВесТипа(Первая.Тип) > ВесТипа(Вторая.Тип);
		Возврат РезультатФункции;
	КонецЕсли;

	РезультатФункции = Первая.Начало < Вторая.Начало;
	Возврат РезультатФункции;

КонецФункции

Функция ВесУверенности(Знач Находка)

	Перем РезультатФункции;

	РезультатФункции = ?(Находка.Уверенность = "Высокая", 1, 0);
	Возврат РезультатФункции;

КонецФункции

Функция ВесТипа(Знач Тип)

	// Чем специфичнее тип, тем выше вес: он побеждает при равной длине интервала.
	Если СтрНайти(",СНИЛС,КАРТА,ИНН,", "," + Тип + ",") > 0 Тогда
		Возврат 3;
	КонецЕсли;

	Если СтрНайти(",EMAIL,ТЕЛЕФОН,ПАСПОРТ,", "," + Тип + ",") > 0 Тогда
		Возврат 2;
	КонецЕсли;

	Возврат 1;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПрограммныйИнтерфейс

// ГАРАНТИЯ БЕЗОПАСНОСТИ (аудит 2026-07-15): запрос исполняется С ПРАВАМИ ТЕКУЩЕГО СЕАНСА -
// в подсистеме MCP нет УстановитьПривилегированныйРежим и privileged-модулей, RLS и права
// базовой конфигурации применяются платформой штатно. НЕ добавлять привилегированный режим
// и не выносить выполнение в privileged-контекст: обход прав здесь = утечка данных в LLM.
// Дополнительный слой: настройка мониторинга РазрешитьЗапросыКДанным (дефолт Ложь) вообще
// не предлагает execute_query модели в глубоком анализе.

// Декларация инструмента execute_query для container-pattern.
//
// Параметры:
//  Таблица - ТаблицаЗначений - реестр инструментов:
//   * Имя - Строка - имя инструмента
//   * Описание - Строка - описание инструмента
//   * Схема - Структура - JSON-схема аргументов
//
Процедура ДобавитьИнструменты(Таблица) Экспорт

	Перем ТекстСообщения;
	
	Свойства = Новый Структура;
	ТекстСообщения = НСтр("ru = 'Стабильный идентификатор шаблона запроса.'");
	ОписаниеСвойства = Новый Структура("type, description", "string", ТекстСообщения);
	Свойства.Вставить("query_id", ОписаниеСвойства);
	ТекстСообщения = НСтр("ru = 'Текст read-only запроса 1С.'");
	ОписаниеСвойства = Новый Структура("type, description", "string", ТекстСообщения);
	Свойства.Вставить("query_text", ОписаниеСвойства);
	ТекстСообщения = НСтр("ru = 'Параметры запроса: имя параметра без & и значение.'");
	ОписаниеСвойства = Новый Структура("type, description", "object", ТекстСообщения);
	Свойства.Вставить("params", ОписаниеСвойства);
	ТекстСообщения = НСтр("ru = 'Лимит строк результата, целое от 1 до 1000.'");
	ОписаниеСвойства = Новый Структура("type, description", "integer", ТекстСообщения);
	Свойства.Вставить("limit", ОписаниеСвойства);
	
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("query_id");
	ОбязательныеПоля.Добавить("query_text");
	ОбязательныеПоля.Добавить("limit");
	
	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", ОбязательныеПоля);
	Схема.Вставить("additionalProperties", Ложь);
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Имя = "execute_query";
	НоваяСтрока.Описание = НСтр("ru = 'Выполняет безопасный read-only запрос 1С с обязательным limit и параметрами.'");
	НоваяСтрока.Схема = Схема;
	
КонецПроцедуры

// Выполняет инструмент execute_query.
//
// Параметры:
//  ИмяИнструмента - Строка - имя MCP-инструмента
//  Аргументы - Структура, Соответствие из КлючИЗначение - аргументы инструмента:
//   * query_id - Строка - идентификатор шаблона запроса
//   * query_text - Строка - текст read-only запроса
//   * params - Структура - параметры запроса (опционально)
//   * limit - Число - лимит строк (1..1000)
//
// Возвращаемое значение:
//  Структура - результат запроса:
//   * query_id - Строка - идентификатор запроса
//   * columns - Массив из Структура - описание колонок
//   * rows - Массив из Массив - строки результата
//   * total - Число - количество возвращенных строк (не более limit)
//   * truncated - Булево - в источнике есть строки сверх limit (результат усечен)
//
//@skip-check doc-comment-collection-item-type
Функция ВыполнитьИнструмент(Знач ИмяИнструмента, Знач Аргументы) Экспорт

	Перем РезультатОписаниеКолонок;
	Перем РезультатСтрокиРезультата;

	Перем ОбязательныйАргументЧисломЗначение;
	
	Если ИмяИнструмента <> "execute_query" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Неподдерживаемый инструмент %1 для модуля КИИ_СерверMCPИнструментВыполнитьЗапрос'"),
			ИмяИнструмента);
	КонецЕсли;

	ИдентификаторЗапроса = ПолучитьОбязательныйАргументСтрокой(Аргументы, "query_id");
	ТекстЗапроса = ПолучитьОбязательныйАргументСтрокой(Аргументы, "query_text");
	ОбязательныйАргументЧисломЗначение = ПолучитьОбязательныйАргументЧислом(Аргументы, "limit");
	Лимит = Число(ОбязательныйАргументЧисломЗначение);
	ПараметрыЗапроса = ПолучитьАргумент(Аргументы, "params", Новый Структура);
	
	ПроверкаБезопасности = КИИ_СерверMCPБезопасностьЗапросов.ПроверитьЗапросБезопасный(ТекстЗапроса, Лимит);
	Если Не ПроверкаБезопасности.ok Тогда
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ПроверкаБезопасности.причина);
	КонецЕсли;
	
	ТекстЗапросаСЛимитом = КИИ_СерверMCPБезопасностьЗапросов.ПрименитьЛимитСПробой(ТекстЗапроса, Лимит);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСЛимитом;
	УстановитьПараметрыЗапроса(Запрос, ПараметрыЗапроса);

	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ОшибкаИнструмента = ОшибкаВыполненияЗапроса(ДанныеОшибки);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуИнструмента(ОшибкаИнструмента);
	КонецПопытки;
	Усечен = Ложь;
	РезультатСтрокиРезультата = СтрокиРезультата(РезультатЗапроса, Лимит, Усечен);
	КоличествоВозвращено = РезультатСтрокиРезультата.Количество();

	Результат = Новый Структура;
	Результат.Вставить("query_id", ИдентификаторЗапроса);
	РезультатОписаниеКолонок = ОписаниеКолонок(РезультатЗапроса);
	Результат.Вставить("columns", РезультатОписаниеКолонок);
	Результат.Вставить("rows", РезультатСтрокиРезультата);
	Результат.Вставить("total", КоличествоВозвращено);
	Результат.Вставить("truncated", Усечен);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаВыполненияЗапроса(Знач ДанныеОшибки)

	ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
	ДанныеКорреляции = КИИ_СерверMCPДиспетчер.СформироватьДанныеОшибкиСКорреляцией(ПредставлениеОшибки);
	// Технический ответ инструмента должен сохранять причину для исправления запроса.
	ТекстПричины = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
	КодОшибки = "query_failed";
	Если ДанныеОшибки.ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Истина) Тогда
		КодОшибки = "access_denied";
	КонецЕсли;
	Сообщение = СтрШаблон(
		НСтр("ru = 'Не удалось выполнить запрос. %1 Код обращения: %2.'"),
		ТекстПричины,
		ДанныеКорреляции.correlation_id);
	Результат = Новый Структура("code,message,correlation_id", КодОшибки, Сообщение, ДанныеКорреляции.correlation_id);
	Возврат Результат;

КонецФункции

Процедура УстановитьПараметрыЗапроса(Запрос, Знач ПараметрыЗапроса)

	Перем ТекстСообщения;
	
	Если ПараметрыЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") И ТипЗнч(ПараметрыЗапроса) <> Тип("Соответствие") Тогда
		
		ТекстСообщения = НСтр("ru = 'Параметр params должен быть структурой или соответствием'");
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстСообщения);
		
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеКолонок(Знач РезультатЗапроса)

	Перем РезультатОписаниеТипаКолонки;
	
	Колонки = Новый Массив;
	
	Для Каждого КолонкаРезультата Из РезультатЗапроса.Колонки Цикл
		
		ОписаниеКолонки = Новый Структура;
		ОписаниеКолонки.Вставить("name", КолонкаРезультата.Имя);
		РезультатОписаниеТипаКолонки = ОписаниеТипаКолонки(КолонкаРезультата);
		ОписаниеКолонки.Вставить("type", РезультатОписаниеТипаКолонки);
		ОписаниеКолонки.Вставить("sensitive", Ложь);
		Колонки.Добавить(ОписаниеКолонки);
		
	КонецЦикла;
	
	Возврат Колонки;
	
КонецФункции

// Читаем не более Лимит + 1 записей: последняя только определяет truncated.
// Прямой курсор сохраняет строки итогов в том же порядке, что и прежняя Выгрузить().
Функция СтрокиРезультата(Знач РезультатЗапроса, Знач Лимит, Усечен)

	Строки = Новый Массив;
	КоличествоСтрок = 0;
	Усечен = Ложь;
	КолонкиРезультата = РезультатЗапроса.Колонки;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если КоличествоСтрок >= Лимит Тогда
			Усечен = Истина;
			Прервать;
		КонецЕсли;
		СтрокаДанных = Новый Массив;
		Для Каждого КолонкаРезультата Из КолонкиРезультата Цикл
			ЗначениеКолонки = Выборка[КолонкаРезультата.Имя];
			ЗначениеДляJSON = ПодготовитьЗначениеРезультата(ЗначениеКолонки);
			СтрокаДанных.Добавить(ЗначениеДляJSON);
		КонецЦикла;
		Строки.Добавить(СтрокаДанных);
		КоличествоСтрок = КоличествоСтрок + 1;
	КонецЦикла;
	Возврат Строки;

КонецФункции

Функция ОписаниеТипаКолонки(Знач КолонкаРезультата)

	Перем РезультатФункции;
	
	Попытка
		РезультатФункции = ОписаниеТипа(КолонкаРезультата.ТипЗначения);
		Возврат РезультатФункции;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ОписаниеТипа(Знач ОписаниеТипов)

	Перем ПредставлениеЗначения;
	
	Если ОписаниеТипов = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТипыЗначений = ОписаниеТипов.Типы();
	Если ТипыЗначений.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Описание = "";
	
	Для Каждого ТипЗначения Из ТипыЗначений Цикл
		
		Если ЗначениеЗаполнено(Описание) Тогда
			Описание = Описание + " | ";
		КонецЕсли;
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Если ОбъектМетаданных <> Неопределено Тогда
			Описание = Описание + ОбъектМетаданных.ПолноеИмя();
		Иначе
			ПредставлениеЗначения = Строка(ТипЗначения);
			Описание = Описание + СтрЗаменить(ПредставлениеЗначения, "Тип ", "");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Описание;
	
КонецФункции

Функция ПодготовитьЗначениеРезультата(Знач ЗначениеРезультата)

	Перем РезультатФункции;
	
	Если ЗначениеРезультата = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеРезультата = Null Тогда
		// ЗаписатьJSON представляет Неопределено как null; нативный Null сериализатор не принимает.
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(ЗначениеРезультата);
	
	Если ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		
		Возврат ЗначениеРезультата;
		
	КонецЕсли;
	
	Если ТипЗначения = Тип("Дата") Тогда
		РезультатФункции = Формат(ЗначениеРезультата, "ДФ='yyyy-MM-ddTHH:mm:ss'");
		Возврат РезультатФункции;
	КонецЕсли;
	
	РезультатФункции = Строка(ЗначениеРезультата);
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьОбязательныйАргументСтрокой(Знач Аргументы, Знач ИмяАргумента)

	Перем ПредставлениеЗначения;
	Перем РезультатФункции;
	
	ЗначениеАргумента = ПолучитьАргумент(Аргументы, ИмяАргумента);
	
	Если Не ЗначениеЗаполнено(ЗначениеАргумента) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не заполнен обязательный параметр %1'"), ИмяАргумента);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	
	ПредставлениеЗначения = Строка(ЗначениеАргумента);
	РезультатФункции = СокрЛП(ПредставлениеЗначения);
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьОбязательныйАргументЧислом(Знач Аргументы, Знач ИмяАргумента)
	
	ЗначениеАргумента = ПолучитьАргумент(Аргументы, ИмяАргумента);
	
	Если ТипЗнч(ЗначениеАргумента) <> Тип("Число") Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не заполнен обязательный числовой параметр %1'"), ИмяАргумента);
		КИИ_СерверMCPДиспетчер.ВызватьОшибкуВалидацииИнструмента(ТекстОшибки);
	КонецЕсли;
	
	Возврат ЗначениеАргумента;
	
КонецФункции

Функция ПолучитьАргумент(Знач Аргументы, Знач ИмяАргумента, ЗначениеПоУмолчанию = Неопределено)
	
	ЗначениеАргумента = Неопределено;
	
	Если Аргументы = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		
		Если Аргументы.Свойство(ИмяАргумента, ЗначениеАргумента) Тогда
			Возврат ЗначениеАргумента;
		КонецЕсли;
		
		Возврат ЗначениеПоУмолчанию;
		
	КонецЕсли;
	
	Если ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		
		ЗначениеАргумента = Аргументы.Получить(ИмяАргумента);
		Если ЗначениеАргумента = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		
		Возврат ЗначениеАргумента;
		
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

#КонецОбласти

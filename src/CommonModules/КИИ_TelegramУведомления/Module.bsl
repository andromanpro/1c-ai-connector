#Область ОтправкаСообщений

// Отправляет текстовое сообщение в чат или канал Telegram.
//
// Параметры:
//   Токен - Строка - токен бота
//   IDЧата - Строка, Число - ID чата или канала
//   Текст - Строка - текст сообщения (максимум 4096 символов)
//   РежимПарсинга - Строка - режим форматирования: "HTML", "Markdown", "MarkdownV2" или ""
//   Клавиатура - Строка - JSON клавиатуры, см. СформироватьКлавиатуруПоМассивуКнопок
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - ответ Telegram API
//
Функция ОтправитьТекстовоеСообщение(
	Знач Токен, Знач IDЧата, Знач Текст, Знач РежимПарсинга = "HTML", Знач Клавиатура = "") Экспорт

	Перем РезультатФункции;
	
	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", IDЧата);
	Параметры.Вставить("text", Текст);
	
	Если Не ПустаяСтрока(РежимПарсинга) Тогда
		Параметры.Вставить("parse_mode", РежимПарсинга);
	КонецЕсли;
	
	ДобавитьКлавиатуру(Параметры, Клавиатура);
	
	РезультатФункции = ВызватьМетодТелеграм(Токен, "sendMessage", Параметры);
	Возврат РезультатФункции;
	
КонецФункции

// Отправляет документ (файл) в чат или канал Telegram.
//
// Параметры:
//   Токен - Строка - токен бота
//   IDЧата - Строка, Число - ID чата или канала
//   Текст - Строка - подпись к документу
//   Документ - ДвоичныеДанные - файл для отправки
//   Клавиатура - Строка - JSON клавиатуры
//   ИмяФайла - Строка - имя файла с расширением
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - ответ Telegram API
//
Функция ОтправитьДокумент(
	Знач Токен, Знач IDЧата, Знач Текст, Знач Документ, Знач Клавиатура = "", Знач ИмяФайла = "") Экспорт

	Перем РезультатФункции;
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "document.dat";
	КонецЕсли;
	
	ПоляФормы = НовыеПоляФормыОтправкиФайла(IDЧата, Текст, Клавиатура);
	
	РезультатФункции = ОтправитьФайлТелеграм(Токен, "sendDocument", "document", ПоляФормы, Документ, ИмяФайла);
	Возврат РезультатФункции;
	
КонецФункции

// Отправляет картинку в чат или канал Telegram.
//
// Параметры:
//   Токен - Строка - токен бота
//   IDЧата - Строка, Число - ID чата или канала
//   Текст - Строка - подпись к картинке
//   Картинка - ДвоичныеДанные - файл картинки
//   Клавиатура - Строка - JSON клавиатуры
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - ответ Telegram API
//
Функция ОтправитьКартинку(Знач Токен, Знач IDЧата, Знач Текст, Знач Картинка, Знач Клавиатура = "") Экспорт

	Перем РезультатФункции;
	
	ПоляФормы = НовыеПоляФормыОтправкиФайла(IDЧата, Текст, Клавиатура);
	
	РезультатФункции = ОтправитьФайлТелеграм(Токен, "sendPhoto", "photo", ПоляФормы, Картинка, "photo.jpg");
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти


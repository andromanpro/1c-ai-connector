#Область Клавиатура

// Формирует JSON клавиатуры из массива текстов кнопок.
// Результат передается в параметр Клавиатура методов отправки.
//
// Параметры:
//   МассивКнопок - Массив из Строка - тексты кнопок
//   ПодСообщением - Булево - Истина: inline-клавиатура под сообщением, Ложь: внизу экрана
//   ОднаПодОдной - Булево - Истина: кнопки в столбик, Ложь: в строку
//
// Возвращаемое значение:
//   Строка - JSON клавиатуры
//
Функция СформироватьКлавиатуруПоМассивуКнопок(
	Знач МассивКнопок, Знач ПодСообщением = Ложь, Знач ОднаПодОдной = Истина) Экспорт

	Перем ПараметрыВызова;
	Перем РезультатФункции;
	
	Строки = Новый Массив;
	
	Если ОднаПодОдной Тогда
		// Каждая кнопка в отдельной строке (столбик)
		Для Каждого ТекстКнопки Из МассивКнопок Цикл
			Кнопки = Новый Массив;
			ТекстСтрокой = КИИ_HTTPКлиент.ПолучитьСтрокуБезопасно(ТекстКнопки);
			ПараметрыВызова = Новый Структура("text,callback_data", ТекстСтрокой, ТекстСтрокой);
			Кнопки.Добавить(ПараметрыВызова);
			Строки.Добавить(Кнопки);
		КонецЦикла;
	Иначе
		// Все кнопки в одной строке (горизонтально)
		Кнопки = Новый Массив;
		Для Каждого ТекстКнопки Из МассивКнопок Цикл
			ТекстСтрокой = КИИ_HTTPКлиент.ПолучитьСтрокуБезопасно(ТекстКнопки);
			ПараметрыВызова = Новый Структура("text,callback_data", ТекстСтрокой, ТекстСтрокой);
			Кнопки.Добавить(ПараметрыВызова);
		КонецЦикла;
		Строки.Добавить(Кнопки);
	КонецЕсли;
	
	Если ПодСообщением Тогда
		СтруктураКлавиатуры = Новый Структура("inline_keyboard", Строки);
	Иначе
		СтруктураКлавиатуры = Новый Структура("keyboard,resize_keyboard", Строки, Истина);
	КонецЕсли;
	
	РезультатФункции = КИИ_HTTPКлиент.СтруктураВJson(СтруктураКлавиатуры);
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти

#Область Утилиты

// Проверяет, что текст не превышает лимит Telegram API.
// Лимит текстового сообщения: 4096 символов, подписи к файлам: 1024 символа.
//
// Параметры:
//   Текст - Строка - проверяемый текст
//   Лимит - Число - максимальная длина
//
// Возвращаемое значение:
//   Булево - Истина если длина текста не превышает лимит
//
Функция ПроверитьДлинуСообщения(Знач Текст, Знач Лимит = 4096) Экспорт

	Перем РезультатФункции;
	
	РезультатФункции = СтрДлина(Текст) <= Лимит;
	Возврат РезультатФункции;
	
КонецФункции

// Обрезает текст до указанного лимита с добавлением маркера "..." в конце.
//
// Параметры:
//   Текст - Строка - текст для обрезки
//   Лимит - Число - максимальная длина результата
//
// Возвращаемое значение:
//   Строка - обрезанный текст
//
Функция ОбрезатьСообщениеДоЛимита(Знач Текст, Знач Лимит = 4096) Экспорт

	Перем ДлинаТекста;
	Перем РезультатФункции;
	
	Если СтрДлина(Текст) <= Лимит Тогда
		Возврат Текст;
	КонецЕсли;

	Маркер = "...";
	ДлинаТекста = СтрДлина(Маркер);
	Обрезанное = Лев(Текст, Лимит - ДлинаТекста);

	// Наивная обрезка рвала HTML-теги/сущности посреди → parse_mode=HTML давал API 400 и
	// уведомление терялось (аудит P2). Откатываемся до последнего полного перевода строки (строки
	// сообщения самодостаточны по тегам), затем страхуемся от незакрытого '<' и '&'.
	ПоследнийПереводСтроки = СтрНайти(Обрезанное, Символы.ПС, НаправлениеПоиска.СКонца);
	Если ПоследнийПереводСтроки > 0 Тогда
		Обрезанное = Лев(Обрезанное, ПоследнийПереводСтроки - 1);
	КонецЕсли;

	ПоследнийОткрытыйТег = СтрНайти(Обрезанное, "<", НаправлениеПоиска.СКонца);
	ПоследнийЗакрытыйТег = СтрНайти(Обрезанное, ">", НаправлениеПоиска.СКонца);
	Если ПоследнийОткрытыйТег > ПоследнийЗакрытыйТег Тогда
		Обрезанное = Лев(Обрезанное, ПоследнийОткрытыйТег - 1);
	КонецЕсли;

	ПоследняяСущность = СтрНайти(Обрезанное, "&", НаправлениеПоиска.СКонца);
	ПоследняяТочкаСЗапятой = СтрНайти(Обрезанное, ";", НаправлениеПоиска.СКонца);
	Если ПоследняяСущность > ПоследняяТочкаСЗапятой Тогда
		Обрезанное = Лев(Обрезанное, ПоследняяСущность - 1);
	КонецЕсли;

	РезультатФункции = Обрезанное + Маркер;
	Возврат РезультатФункции;

КонецФункции

#КонецОбласти

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

// Вызывает метод Telegram Bot API через JSON POST с автоматическим retry.
// Прокси берется из единой настройки КИИ_HTTPКлиент.ПроксиПоУмолчанию (константа КИИ_АдресПроксиИнтернет).
//
// Параметры:
//   Токен - Строка - токен бота
//   ИмяМетода - Строка - имя метода API (например, "sendMessage")
//   Параметры - Структура - параметры запроса
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - ответ Telegram API
//
Функция ВызватьМетодТелеграм(Знач Токен, Знач ИмяМетода, Знач Параметры)

	Перем ПолучательВызова;
	Перем РезультатТекстЗаглушкиКонтроля;

	Перем РезультатФункции;
	Перем ДанныеОшибки;
	
	// Контроль персональных данных стоит здесь, а не у вызывающих: любой текст уходит в Telegram только так.
	Контроль = КИИ_КонтрольПерсональныхДанных.ПодготовитьПоляТелеграм(Параметры);
	Если Не Контроль.Разрешено Тогда
		Если Не Параметры.Свойство("text") Тогда
			РезультатФункции = НовыйРезультатОшибки(Контроль.ТекстОтказа);
			Возврат РезультатФункции;
		КонецЕсли;
		// Текст уведомления заменяется заглушкой без данных: оператор все равно узнает, что событие было.
		ПолучательВызова = Контроль.Поля;
		РезультатТекстЗаглушкиКонтроля = ТекстЗаглушкиКонтроля(Контроль.ТекстОтказа);
		ПолучательВызова.Вставить("text", РезультатТекстЗаглушкиКонтроля);
	КонецЕсли;
	Параметры = Контроль.Поля;
	// Подстановка может быть длиннее исходного значения: лимит проверяется после подготовки.
	Если Параметры.Свойство("text") И Не ПроверитьДлинуСообщения(Параметры.text) Тогда
		Параметры.text = ОбрезатьСообщениеДоЛимита(Параметры.text);
	КонецЕсли;
	
	URL = СформироватьURLМетода(Токен, ИмяМетода);
	
	Попытка
		Результат = КИИ_HTTPКлиент.ВыполнитьЗапросСПовтором("POST", URL, Параметры);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		ТекстОшибки = СкрытьТокенВТексте(ТекстОшибки, Токен);
		ЗаписатьОшибку("КИИ.Telegram." + ИмяМетода, ТекстОшибки);
		РезультатФункции = НовыйРезультатОшибки(ТекстОшибки);
		Возврат РезультатФункции;
	КонецПопытки;
	
	ОбработатьРезультатВызова(Результат, ИмяМетода);
	
	Возврат Результат;
	
КонецФункции

// Отправляет файл через Telegram Bot API (multipart/form-data).
//
// Параметры:
//   Токен - Строка - токен бота
//   ИмяМетода - Строка - имя метода API (например, "sendDocument")
//   ИмяПоляФайла - Строка - имя поля файла в запросе ("document", "photo")
//   ПоляФормы - Структура - текстовые поля формы (chat_id, caption и т.д.)
//   Файл - ДвоичныеДанные - файл для отправки
//   ИмяФайла - Строка - имя файла
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - ответ Telegram API
//
Функция ОтправитьФайлТелеграм(Знач Токен, Знач ИмяМетода, Знач ИмяПоляФайла, Знач ПоляФормы, Знач Файл, Знач ИмяФайла)

	Перем РезультатФункции;
	Перем ДанныеОшибки;
	
	// Содержимое файла текстовая проверка не видит: при отказе файл не отправляется совсем.
	Контроль = КИИ_КонтрольПерсональныхДанных.ПодготовитьПоляТелеграм(ПоляФормы, ИмяФайла);
	Если Не Контроль.Разрешено Тогда
		РезультатФункции = НовыйРезультатОшибки(Контроль.ТекстОтказа);
		Возврат РезультатФункции;
	КонецЕсли;
	ПоляФормы = Контроль.Поля;
	ИмяФайла = Контроль.ИмяФайла;
	
	URL = СформироватьURLМетода(Токен, ИмяМетода);
	
	Файлы = Новый Соответствие;
	ОписаниеФайла = Новый Структура("ИмяФайла, ДвоичныеДанные", ИмяФайла, Файл);
	Файлы.Вставить(ИмяПоляФайла, ОписаниеФайла);
	
	Попытка
		Результат = КИИ_HTTPКлиент.ВыполнитьМногочастныйЗапрос(URL, ПоляФормы, Файлы);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		ТекстОшибки = СкрытьТокенВТексте(ТекстОшибки, Токен);
		ЗаписатьОшибку("КИИ.Telegram." + ИмяМетода, ТекстОшибки);
		РезультатФункции = НовыйРезультатОшибки(ТекстОшибки);
		Возврат РезультатФункции;
	КонецПопытки;
	
	ОбработатьРезультатВызова(Результат, ИмяМетода);
	
	Возврат Результат;
	
КонецФункции

// Текст, который уходит вместо уведомления, остановленного контролем персональных данных.
//
// Параметры:
//   ТекстОтказа - Строка - причина отказа без значений персональных данных.
//
// Возвращаемое значение:
//   Строка - текст заглушки.
//
Функция ТекстЗаглушкиКонтроля(Знач ТекстОтказа)

	Перем РезультатФункции;

	РезультатФункции = СтрШаблон(
		НСтр("ru = 'Уведомление не отправлено. %1 Подробности - в журнале контроля персональных данных.'"),
		ТекстОтказа);
	Возврат РезультатФункции;

КонецФункции

// Формирует полный URL метода Telegram Bot API.
Функция СформироватьURLМетода(Знач Токен, Знач ИмяМетода)

	Перем РезультатФункции;

	РезультатФункции = "https://api.telegram.org/bot" + Токен + "/" + ИмяМетода;
	Возврат РезультатФункции;

КонецФункции

// Маскирует токен бота в тексте (ошибки/логи): токен вшит в URL метода и без маскировки утекает
// в журнал регистрации при исключении/ошибке HTTP (аудит P2).
// Параметры:
//  Текст - Строка - исходный текст (сообщение об ошибке или лог).
//  Токен - Строка - токен бота для маскировки.
// Возвращаемое значение:
//  Строка - текст с заменой токена на "<скрыт>".
Функция СкрытьТокенВТексте(Знач Текст, Знач Токен) Экспорт

	Перем РезультатФункции;

	Если ПустаяСтрока(Токен) Тогда
		Возврат Текст;
	КонецЕсли;
	РезультатФункции = СтрЗаменить(Текст, Токен, "<скрыт>");
	Возврат РезультатФункции;

КонецФункции

// Формирует базовые поля формы для отправки файлов.
Функция НовыеПоляФормыОтправкиФайла(Знач IDЧата, Знач Текст, Знач Клавиатура)

	Перем СтрокуБезопасноЗначение;
	
	ПоляФормы = Новый Структура;
	СтрокуБезопасноЗначение = КИИ_HTTPКлиент.ПолучитьСтрокуБезопасно(IDЧата);
	ПоляФормы.Вставить("chat_id", СтрокуБезопасноЗначение);
	
	Если Не ПустаяСтрока(Текст) Тогда
		ПоляФормы.Вставить("caption", Текст);
		ПоляФормы.Вставить("parse_mode", "HTML");
	КонецЕсли;
	
	Если Не ПустаяСтрока(Клавиатура) Тогда
		ПоляФормы.Вставить("reply_markup", Клавиатура);
	КонецЕсли;
	
	Возврат ПоляФормы;
	
КонецФункции

// Обрабатывает результат вызова API - записывает ошибку в ЖР при неудаче.
Процедура ОбработатьРезультатВызова(Знач Результат, Знач ИмяМетода)

	Классификация = КлассифицироватьОтветТелеграм(Результат);
	Если Классификация.ЕстьОшибка Тогда
		ЗаписатьОшибку("КИИ.Telegram." + ИмяМетода, Классификация.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

// Классифицирует ответ Telegram API: HTTP-ошибка (error/status_code) или API-ошибка (ok=false)
// → ЕстьОшибка + читаемый ТекстОшибки. Чистая функция (вынесена из ОбработатьРезультатВызова
// для покрытия боевого пути на фикстурах, аудит P2 тест-гэп).
//
// Параметры:
//  Результат - Соответствие из КлючИЗначение - ответ Telegram API или результат HTTP-клиента.
// Возвращаемое значение:
//  Структура - классификация ответа:
//   * ЕстьОшибка - Булево - признак наличия ошибки.
//   * ТекстОшибки - Строка - читаемый текст ошибки (пустой, если ошибки нет).
Функция КлассифицироватьОтветТелеграм(Знач Результат) Экспорт

	Перем РезультатЗначение;

	Итог = Новый Структура("ЕстьОшибка, ТекстОшибки", Ложь, "");

	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Возврат Итог;
	КонецЕсли;

	// Ошибка HTTP-уровня (от КИИ_HTTPКлиент)
	Если Результат.Получить("error") <> Неопределено Тогда
		ТекстОшибки = КИИ_HTTPКлиент.ПолучитьСтрокуБезопасно(Результат["error"]);
		КодСостояния = Результат.Получить("status_code");
		Если КодСостояния <> Неопределено Тогда
			ТекстОшибки = ТекстОшибки + " (HTTP " + КИИ_HTTPКлиент.ПолучитьСтрокуБезопасно(КодСостояния) + ")";
		КонецЕсли;
		Итог.ЕстьОшибка = Истина;
		Итог.ТекстОшибки = ТекстОшибки;
		Возврат Итог;
	КонецЕсли;

	// Ошибка Telegram API (поле "ok" = false)
	Если Результат.Получить("ok") = Ложь Тогда
		РезультатЗначение = Результат.Получить("description");
		Описание = КИИ_HTTPКлиент.ПолучитьСтрокуБезопасно(РезультатЗначение);
		КодОшибки = Результат.Получить("error_code");
		ТекстОшибки = "Telegram API: " + Описание;
		Если КодОшибки <> Неопределено Тогда
			ТекстОшибки = ТекстОшибки + " (код " + КИИ_HTTPКлиент.ПолучитьСтрокуБезопасно(КодОшибки) + ")";
		КонецЕсли;
		Итог.ЕстьОшибка = Истина;
		Итог.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Добавляет клавиатуру в параметры JSON-запроса.
// Клавиатура приходит как JSON-строка и парсится в объект для JSON body.
Процедура ДобавитьКлавиатуру(Параметры, Знач Клавиатура)
	
	Если ПустаяСтрока(Клавиатура) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ОбъектКлавиатуры = КИИ_HTTPКлиент.JsonВСтруктуру(Клавиатура, Истина);
		Параметры.Вставить("reply_markup", ОбъектКлавиатуры);
	Исключение
		// Если не удалось распарсить - передаем как строку
		Параметры.Вставить("reply_markup", Клавиатура);
	КонецПопытки;
	
КонецПроцедуры

// Создает Соответствие с ошибкой в формате Telegram API.
Функция НовыйРезультатОшибки(Знач ТекстОшибки)
	
	Результат = Новый Соответствие;
	Результат.Вставить("ok", Ложь);
	Результат.Вставить("description", ТекстОшибки);
	
	Возврат Результат;
	
КонецФункции

// Записывает ошибку в журнал регистрации.
Процедура ЗаписатьОшибку(Знач Событие, Знач ТекстОшибки)
	
	ЗаписьЖурналаРегистрации(
		Событие,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстОшибки);
	
КонецПроцедуры


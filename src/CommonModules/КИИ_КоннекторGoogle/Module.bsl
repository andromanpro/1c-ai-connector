// Заполняет соответствие HTTP-заголовков в соответствии с форматом Google Generative AI.
//
// Параметры:
//  Параметры  - Структура - параметры модели (см. КИИ_КоннекторИИ.ПараметрыМодели)
//  КлючAPI    - Строка    - значение заголовка x-goog-api-key
//  Заголовки  - Соответствие из КлючИЗначение - выходной параметр, HTTP-заголовки (имя → значение):
//   * Ключ - Строка - имя заголовка
//   * Значение - Строка - значение заголовка
//
Процедура СформироватьЗаголовки(Параметры, КлючAPI, Заголовки) Экспорт
	
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("x-goog-api-key", КлючAPI);
	
КонецПроцедуры

// Формирует тело HTTP-запроса в формате Google Gemini generateContent.
//
// Параметры:
//  Параметры        - Структура - параметры модели
//  СтруктураПромпта - Структура - системный/пользовательский промпт + опционально история сообщений
//  ТелоЗапроса      - Структура - выходной параметр (contents, generationConfig, systemInstruction)
//
Процедура СформироватьТелоЗапроса(Параметры, СтруктураПромпта, ТелоЗапроса) Экспорт

	// Многоходовый режим (петля агент-анализа): диалог с tool-вызовами конвертируется
	// из OpenAI-формата сырых сообщений в contents Gemini API.
	Если СтруктураПромпта.Свойство("СырыеСообщения")
		И КИИ_КоннекторИИОбщий.ЭтоМассив(СтруктураПромпта.СырыеСообщения)
		И СтруктураПромпта.СырыеСообщения.Количество() > 0 Тогда
		СформироватьТелоИзСырыхСообщений(Параметры, СтруктураПромпта, ТелоЗапроса);
		Возврат;
	КонецЕсли;

	Содержания = СформироватьСодержания(СтруктураПромпта);
	КонфигурацияГенерации = СформироватьКонфигурациюГенерации(Параметры);

	ТелоЗапроса.Вставить("contents", Содержания);
	ТелоЗапроса.Вставить("generationConfig", КонфигурацияГенерации);

	Если ЗначениеЗаполнено(СтруктураПромпта.СистемныйПромпт) Тогда
		ДобавитьСистемнуюИнструкцию(ТелоЗапроса, СтруктураПромпта.СистемныйПромпт);
	КонецЕсли;

	// Инструменты нужны и в одноходовом режиме (первый ход диалога без сырых сообщений).
	ДобавитьИнструментыGoogle(СтруктураПромпта, ТелоЗапроса);

КонецПроцедуры

// Разбирает JSON-ответ Google Gemini API и заполняет структуру результата.
// Не обрабатывает блок error - это делает общий КИИ_КоннекторИИОбщий.ЕстьОшибкаВОтветеAPI до диспетчеризации.
//
// Параметры:
//  ОтветJSON - Соответствие из КлючИЗначение - распарсенный JSON-ответ:
//   * Ключ - Строка - имя поля JSON
//   * Значение - Произвольный - значение поля
//  Результат - Структура    - выходной параметр (см. КИИ_КоннекторИИ.НовыйПараметрыОтветаИИ)
//
Процедура РазобратьОтвет(ОтветJSON, Результат) Экспорт

	ИзвлечьТекстОтвета(ОтветJSON, Результат);
	ИзвлечьТокены(ОтветJSON, Результат);
	ИзвлечьВызовыИнструментов(ОтветJSON, Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ФормированиеЗапроса

// Тело многоходового запроса из сырых сообщений OpenAI-формата (петля инструментов):
// assistant с tool_calls - в model-контент с частями functionCall, tool-результаты -
// в user-контент с частями functionResponse (имя функции восстанавливается по id вызова).
Процедура СформироватьТелоИзСырыхСообщений(Параметры, СтруктураПромпта, ТелоЗапроса)

	Перем РезультатСодержимоеМоделиGoogle;
	Перем КонфигурациюГенерацииЗначение;

	Перем ПредставлениеЗначения;
	Перем СоединенныйТекст;

	Содержания = Новый Массив;
	ЧастиСистемы = Новый Массив;
	ИменаВызововПоИдентификатору = Новый Соответствие;

	Для Каждого Сообщение Из СтруктураПромпта.СырыеСообщения Цикл

		Если Сообщение.role = "system" Тогда
			ПредставлениеЗначения = Строка(Сообщение.content);
			ЧастиСистемы.Добавить(ПредставлениеЗначения);
		ИначеЕсли Сообщение.role = "assistant" Тогда
			РезультатСодержимоеМоделиGoogle = СодержимоеМоделиGoogle(Сообщение, ИменаВызововПоИдентификатору);
			Содержания.Добавить(РезультатСодержимоеМоделиGoogle);
		ИначеЕсли Сообщение.role = "tool" Тогда
			ДобавитьРезультатИнструментаGoogle(Содержания, Сообщение, ИменаВызововПоИдентификатору);
		Иначе
			Если КИИ_КоннекторИИОбщий.ЭтоМассивКонтентаПромпта(Сообщение.content) Тогда
				Части = ПостроитьGoogleКонтентИзМассива(Сообщение.content);
				ДобавитьСообщениеСЧастями(Содержания, "user", Части);
			Иначе
				ПредставлениеЗначения = Строка(Сообщение.content);
				ДобавитьСообщение(Содержания, "user", ПредставлениеЗначения);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	ТелоЗапроса.Вставить("contents", Содержания);
	КонфигурациюГенерацииЗначение = СформироватьКонфигурациюГенерации(Параметры);
	ТелоЗапроса.Вставить("generationConfig", КонфигурациюГенерацииЗначение);

	Если ЧастиСистемы.Количество() > 0 Тогда
		СоединенныйТекст = СтрСоединить(ЧастиСистемы, Символы.ПС);
		ДобавитьСистемнуюИнструкцию(ТелоЗапроса, СоединенныйТекст);
	КонецЕсли;

	ДобавитьИнструментыGoogle(СтруктураПромпта, ТелоЗапроса);

КонецПроцедуры

Функция СодержимоеМоделиGoogle(Сообщение, ИменаВызововПоИдентификатору)

	Перем РезультатСтрокаJSONВЗначение;

	Перем ПараметрыВызова;
	Перем ПредставлениеЗначения;
	Перем ПредставлениеЗначения2;

	Части = Новый Массив;

	ТекстАссистента = Строка(Сообщение.content);
	Если ЗначениеЗаполнено(ТекстАссистента) Тогда
		ПараметрыВызова = Новый Структура("text", ТекстАссистента);
		Части.Добавить(ПараметрыВызова);
	КонецЕсли;

	Если Сообщение.Свойство("tool_calls") И КИИ_КоннекторИИОбщий.ЭтоМассив(Сообщение.tool_calls) Тогда
		Для Каждого Вызов Из Сообщение.tool_calls Цикл
			ПредставлениеЗначения = Строка(Вызов.id);
			ПредставлениеЗначения2 = Строка(Вызов.function.name);
			ИменаВызововПоИдентификатору.Вставить(ПредставлениеЗначения, ПредставлениеЗначения2);
			ОписаниеВызова = Новый Структура;
			ОписаниеВызова.Вставить("name", Вызов.function.name);
			РезультатСтрокаJSONВЗначение = КИИ_КоннекторИИОбщий.СтрокаJSONВЗначение(Вызов.function.arguments);
			ОписаниеВызова.Вставить("args", РезультатСтрокаJSONВЗначение);
			ПараметрыВызова = Новый Структура("functionCall", ОписаниеВызова);
			Части.Добавить(ПараметрыВызова);
		КонецЦикла;
	КонецЕсли;

	Содержимое = Новый Структура;
	Содержимое.Вставить("role", "model");
	Содержимое.Вставить("parts", Части);
	Возврат Содержимое;

КонецФункции

// Результаты инструментов, идущие подряд, складываются частями одного user-контента:
// при параллельных вызовах Gemini ждет все functionResponse в одном сообщении.
Процедура ДобавитьРезультатИнструментаGoogle(Содержания, Сообщение, ИменаВызововПоИдентификатору)

	Перем ПредставлениеЗначения;
	Перем ПараметрыВызова;

	ИмяФункции = ИменаВызововПоИдентификатору[Строка(Сообщение.tool_call_id)];
	Если ИмяФункции = Неопределено Тогда
		ИмяФункции = "";
	КонецЕсли;

	ОтветФункции = Новый Структура;
	ОтветФункции.Вставить("name", ИмяФункции);
	ПредставлениеЗначения = Строка(Сообщение.content);
	ПараметрыВызова = Новый Структура("result", ПредставлениеЗначения);
	ОтветФункции.Вставить("response", ПараметрыВызова);
	ЧастьРезультата = Новый Структура("functionResponse", ОтветФункции);

	КоличествоСодержаний = Содержания.Количество();
	Если КоличествоСодержаний > 0 Тогда
		Последнее = Содержания[КоличествоСодержаний - 1];
		Если Последнее.role = "user"
			И Последнее.parts.Количество() > 0
			И Последнее.parts[0].Свойство("functionResponse") Тогда
			Последнее.parts.Добавить(ЧастьРезультата);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(ЧастьРезультата);
	Содержимое = Новый Структура;
	Содержимое.Вставить("role", "user");
	Содержимое.Вставить("parts", Части);
	Содержания.Добавить(Содержимое);

КонецПроцедуры

Процедура ДобавитьИнструментыGoogle(СтруктураПромпта, ТелоЗапроса)

	Перем ПараметрыВызова;

	Если Не СтруктураПромпта.Свойство("Инструменты")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(СтруктураПромпта.Инструменты)
		Или СтруктураПромпта.Инструменты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Объявления = Новый Массив;
	Для Каждого Инструмент Из СтруктураПромпта.Инструменты Цикл
		Объявление = Новый Структура;
		Объявление.Вставить("name", Инструмент.function.name);
		Объявление.Вставить("description", Инструмент.function.description);
		Объявление.Вставить("parameters", Инструмент.function.parameters);
		Объявления.Добавить(Объявление);
	КонецЦикла;

	Инструменты = Новый Массив;
	ПараметрыВызова = Новый Структура("functionDeclarations", Объявления);
	Инструменты.Добавить(ПараметрыВызова);
	ТелоЗапроса.Вставить("tools", Инструменты);

КонецПроцедуры

// Извлекает functionCall-части первого кандидата в Результат.ВызовыИнструментов.
// Gemini не присылает идентификаторы вызовов - генерируются позиционные, имя функции
// для functionResponse восстанавливается конвертером сырых сообщений по этому id.
Процедура ИзвлечьВызовыИнструментов(ОтветJSON, Результат)

	Кандидат = ПолучитьПервогоКандидата(ОтветJSON);
	КандидатБезЧастей = Кандидат = Неопределено
		Или Не Кандидат.Свойство("content")
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Кандидат.content)
		Или Не Кандидат.content.Свойство("parts")
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(Кандидат.content.parts);
	Если КандидатБезЧастей Тогда
		Возврат;
	КонецЕсли;

	НомерВызова = 0;
	Для Каждого Часть Из Кандидат.content.parts Цикл

		Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Часть)
			Или Не Часть.Свойство("functionCall")
			Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Часть.functionCall) Тогда
			Продолжить;
		КонецЕсли;

		НомерВызова = НомерВызова + 1;
		Вызов = Новый Структура("Идентификатор, Имя, Аргументы", "call_" + НомерВызова, "", "{}");
		Если Часть.functionCall.Свойство("name") Тогда
			Вызов.Имя = Строка(Часть.functionCall.name);
		КонецЕсли;
		Если Часть.functionCall.Свойство("args") Тогда
			Вызов.Аргументы = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Часть.functionCall.args);
		КонецЕсли;

		Результат.ВызовыИнструментов.Добавить(Вызов);

	КонецЦикла;

КонецПроцедуры

Функция СформироватьСодержания(СтруктураПромпта)

	Перем ПользовательскийТекст;

	Содержания = Новый Массив;

	Если СтруктураПромпта.Свойство("ИсторияСообщений") Тогда
		ДобавитьИсториюСообщений(Содержания, СтруктураПромпта.ИсторияСообщений);
	КонецЕсли;

	Если КИИ_КоннекторИИОбщий.ЕстьВложения(СтруктураПромпта.ПользовательскийПромпт) Тогда
		Части = ПостроитьGoogleКонтентИзМассива(СтруктураПромпта.ПользовательскийПромпт);
		ДобавитьСообщениеСЧастями(Содержания, "user", Части);
	Иначе
		ПользовательскийТекст = КИИ_КоннекторИИОбщий.ТекстПользовательскогоПромпта(
			СтруктураПромпта.ПользовательскийПромпт);
		ДобавитьСообщение(Содержания, "user", ПользовательскийТекст);
	КонецЕсли;

	Возврат Содержания;

КонецФункции

// Переводит массив контента фасада в parts Gemini с сохранением порядка: text - текстовой частью,
// изображения и документы - частями inline_data. Вложение, которое Gemini не примет, прерывает
// запрос исключением: молча выброшенная часть дала бы ответ модели без нее.
Функция ПостроитьGoogleКонтентИзМассива(Знач МассивКонтента)

	Перем РезультатПостроитьКонтентИзображенияGoogle;
	Перем РезультатПостроитьКонтентДокументаGoogle;

	Перем ПараметрыВызова;

	ЧастиGoogle = Новый Массив;

	Для Каждого ЭлементКонтента Из МассивКонтента Цикл
		Если ЭлементКонтента.Тип = "text" Тогда
			ПараметрыВызова = Новый Структура("text", ЭлементКонтента.Текст);
			ЧастиGoogle.Добавить(ПараметрыВызова);
		ИначеЕсли ЭлементКонтента.Тип = "image" Тогда
			РезультатПостроитьКонтентИзображенияGoogle = ПостроитьКонтентИзображенияGoogle(ЭлементКонтента);
			ЧастиGoogle.Добавить(РезультатПостроитьКонтентИзображенияGoogle);
		ИначеЕсли ЭлементКонтента.Тип = "document" Тогда
			РезультатПостроитьКонтентДокументаGoogle = ПостроитьКонтентДокументаGoogle(ЭлементКонтента);
			ЧастиGoogle.Добавить(РезультатПостроитьКонтентДокументаGoogle);
		Иначе
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Gemini: неизвестный тип элемента контента %1'"), ЭлементКонтента.Тип);
		КонецЕсли;
	КонецЦикла;

	Возврат ЧастиGoogle;

КонецФункции

// data-URI и двоичные данные уходят частью inline_data, внешняя ссылка - частью file_data.
Функция ПостроитьКонтентИзображенияGoogle(Знач ЭлементКонтента)

	Перем РезультатФункции;

	URL = КИИ_КоннекторИИОбщий.АдресИзображения(ЭлементКонтента);
	Если ЗначениеЗаполнено(URL) Тогда
		ДанныеСсылки = КИИ_КоннекторИИОбщий.РазобратьDataURI(URL);
		Если ДанныеСсылки = Неопределено Тогда
			РезультатФункции = ЧастьФайлаПоСсылкеGoogle(URL, ЭлементКонтента);
			Возврат РезультатФункции;
		КонецЕсли;
		MIME = ДанныеСсылки.MIME;
		ДанныеBase64 = ДанныеСсылки.Base64;
	Иначе
		MIME = КИИ_КоннекторИИОбщий.НормализованныйMIME(ЭлементКонтента.MIME);
		ДанныеBase64 = КИИ_КоннекторИИОбщий.Base64БезПереводовСтрок(ЭлементКонтента.ДвоичныеДанные);
	КонецЕсли;

	ПоддерживаемыеТипы = СтрРазделить("image/png,image/jpeg,image/webp,image/heic,image/heif", ",");
	Если ПоддерживаемыеТипы.Найти(MIME) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Gemini принимает изображения PNG, JPEG, WebP, HEIC и HEIF, передан MIME-тип %1'"), MIME);
	КонецЕсли;

	РезультатФункции = ЧастьВстроенныхДанныхGoogle(MIME, ДанныеBase64);
	Возврат РезультатФункции;

КонецФункции

// PDF и текстовые форматы, подтвержденные документацией Gemini, уходят частью inline_data.
Функция ПостроитьКонтентДокументаGoogle(Знач ЭлементКонтента)

	Перем РезультатBase64БезПереводовСтрок;
	Перем РезультатФункции;

	MIME = КИИ_КоннекторИИОбщий.НормализованныйMIME(ЭлементКонтента.MIME);
	ПоддерживаемыеТипы = СтрРазделить("application/pdf,text/plain,text/markdown,text/html,text/xml", ",");
	Если ПоддерживаемыеТипы.Найти(MIME) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Gemini принимает документы PDF, TXT, Markdown, HTML и XML, передан MIME-тип %1'"), MIME);
	КонецЕсли;

	РезультатBase64БезПереводовСтрок = КИИ_КоннекторИИОбщий.Base64БезПереводовСтрок(ЭлементКонтента.ДвоичныеДанные);
	РезультатФункции = ЧастьВстроенныхДанныхGoogle(MIME, РезультатBase64БезПереводовСтрок);
	Возврат РезультатФункции;

КонецФункции

// Внешнюю ссылку Gemini скачивает сам (публичный или подписанный HTTPS, кроме семейства 2.0), но в
// file_data нужен MIME. Он берется из поля MIME элемента, без него - по расширению из пути ссылки.
// Без того и другого запрос останавливается: картинка с чужим типом хуже понятной ошибки. Саму ссылку
// в текст ошибки не подставляем - у подписанной ссылки в параметрах лежит секрет доступа.
Функция ЧастьФайлаПоСсылкеGoogle(Знач URL, Знач ЭлементКонтента)

	Перем РезультатФункции;

	MIME = "";
	Если ЭлементКонтента.Свойство("MIME", MIME) Тогда
		MIME = КИИ_КоннекторИИОбщий.НормализованныйMIME(MIME);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(MIME) Тогда
		MIME = MIMEИзображенияПоРасширениюGoogle(URL);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(MIME) Тогда
		ВызватьИсключение НСтр("ru = 'Коннектор Gemini не определил тип изображения по ссылке: ожидается расширение
			|.png, .jpg, .jpeg, .webp или .bmp либо поле MIME в элементе. Или передайте картинку двоичными данными'");
	КонецЕсли;

	ФайлПоСсылке = Новый Структура;
	ФайлПоСсылке.Вставить("mime_type", MIME);
	ФайлПоСсылке.Вставить("file_uri", URL);

	РезультатФункции = Новый Структура("file_data", ФайлПоСсылке);
	Возврат РезультатФункции;

КонецФункции

Функция MIMEИзображенияПоРасширениюGoogle(Знач URL)

	Путь = НРег(URL);
	ПозицияЗапроса = СтрНайти(Путь, "?");
	Если ПозицияЗапроса > 0 Тогда
		Путь = Лев(Путь, ПозицияЗапроса - 1);
	КонецЕсли;
	ПозицияФрагмента = СтрНайти(Путь, "#");
	Если ПозицияФрагмента > 0 Тогда
		Путь = Лев(Путь, ПозицияФрагмента - 1);
	КонецЕсли;

	Если СтрЗаканчиваетсяНа(Путь, ".png") Тогда
		Возврат "image/png";
	ИначеЕсли СтрЗаканчиваетсяНа(Путь, ".jpg") Или СтрЗаканчиваетсяНа(Путь, ".jpeg") Тогда
		Возврат "image/jpeg";
	ИначеЕсли СтрЗаканчиваетсяНа(Путь, ".webp") Тогда
		Возврат "image/webp";
	ИначеЕсли СтрЗаканчиваетсяНа(Путь, ".bmp") Тогда
		Возврат "image/bmp";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

Функция ЧастьВстроенныхДанныхGoogle(Знач MIME, Знач ДанныеBase64)

	Перем РезультатФункции;

	ВстроенныеДанные = Новый Структура;
	ВстроенныеДанные.Вставить("mime_type", MIME);
	ВстроенныеДанные.Вставить("data", ДанныеBase64);

	РезультатФункции = Новый Структура("inline_data", ВстроенныеДанные);
	Возврат РезультатФункции;

КонецФункции

Процедура ДобавитьСообщениеСЧастями(Содержания, Знач Роль, Знач Части)

	Содержимое = Новый Структура;
	Содержимое.Вставить("role", Роль);
	Содержимое.Вставить("parts", Части);
	Содержания.Добавить(Содержимое);

КонецПроцедуры

Процедура ДобавитьИсториюСообщений(Содержания, ИсторияСообщений)

	Для Каждого Сообщение Из ИсторияСообщений Цикл
		РольGoogle = ?(Сообщение.Роль = "assistant", "model", Сообщение.Роль);
		ДобавитьСообщение(Содержания, РольGoogle, Сообщение.Текст);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСообщение(Содержания, Роль, Текст)

	Части = Новый Массив;
	Часть = Новый Структура("text", Текст);
	Части.Добавить(Часть);

	Содержимое = Новый Структура;
	Содержимое.Вставить("role", Роль);
	Содержимое.Вставить("parts", Части);

	Содержания.Добавить(Содержимое);

КонецПроцедуры

Функция СформироватьКонфигурациюГенерации(Параметры)

	КонфигурацияГенерации = Новый Структура;
	// Температуру шлем только если задана (>0): безусловная вставка форсила детерминизм при
	// незаданной температуре, расходясь с guard-паттерном OpenAI/Anthropic (аудит P2).
	Если ЗначениеЗаполнено(Параметры.Температура) Тогда
		КонфигурацияГенерации.Вставить("temperature", Параметры.Температура);
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.МаксимумТокенов) Тогда
		КонфигурацияГенерации.Вставить("maxOutputTokens", Параметры.МаксимумТокенов);
	КонецЕсли;

	Возврат КонфигурацияГенерации;

КонецФункции

Процедура ДобавитьСистемнуюИнструкцию(ТелоЗапроса, СистемныйПромпт)

	СистемнаяИнструкция = Новый Структура;
	СистемнаяИнструкция.Вставить("parts", Новый Массив);

	ЧастьСистемы = Новый Структура("text", СистемныйПромпт);
	СистемнаяИнструкция.parts.Добавить(ЧастьСистемы);

	ТелоЗапроса.Вставить("systemInstruction", СистемнаяИнструкция);

КонецПроцедуры

#КонецОбласти

#Область ОбработкаОтвета

Процедура ИзвлечьТекстОтвета(ОтветJSON, Результат)

	Кандидат = ПолучитьПервогоКандидата(ОтветJSON);

	Если Кандидат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИзвлечьТекстИзКандидата(Кандидат, Результат);

	Если Кандидат.Свойство("finishReason") Тогда
		Результат.ПричинаЗавершения = Кандидат.finishReason;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПервогоКандидата(ОтветJSON)

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ОтветJSON.Свойство("candidates") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(ОтветJSON.candidates)
		Или ОтветJSON.candidates.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Кандидат = ОтветJSON.candidates[0];

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Кандидат) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кандидат;

КонецФункции

Процедура ИзвлечьТекстИзКандидата(Кандидат, Результат)

	Если Не Кандидат.Свойство("content") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Кандидат.content) Тогда
		Возврат;
	КонецЕсли;

	Если Не Кандидат.content.Свойство("parts") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоМассив(Кандидат.content.parts)
		Или Кандидат.content.parts.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СобранныйТекст = "";
	Для Каждого Часть Из Кандидат.content.parts Цикл
		Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(Часть) Тогда
			Продолжить;
		КонецЕсли;
		Если Часть.Свойство("text") И ТипЗнч(Часть.text) = Тип("Строка") Тогда
			СобранныйТекст = СобранныйТекст + Часть.text;
		ИначеЕсли Часть.Свойство("inlineData") И КИИ_КоннекторИИОбщий.ЭтоСтруктура(Часть.inlineData) Тогда
			ДобавитьВложениеИзInlineData(Часть.inlineData, Результат);
		Иначе
			// Прочие типы частей ответа Gemini (functionCall разбирает ИзвлечьВызовыИнструментов,
			// executableCode/thought нам не нужны) - пропускаем.
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Результат.ТекстОтвета = СобранныйТекст;

КонецПроцедуры

// Добавляет картинку из inlineData-части ответа Gemini во вложения ответа.
// Части без данных или с не-image типом контента молча пропускаются.
Процедура ДобавитьВложениеИзInlineData(Знач ДанныеЧасти, Результат)

	Перем ФактическийТипMIME;
	Перем ОжидаемыйТипMIME;
	Перем MIMEВНижнемРегистре;
	Перем ПрефиксТипаИзображения;

	MIMEЧасти = "";
	Если ДанныеЧасти.Свойство("mimeType") Тогда
		MIMEЧасти = ДанныеЧасти.mimeType;
	КонецЕсли;

	ЭтоКартинка = ДанныеЧасти.Свойство("data");
	Если ЭтоКартинка Тогда
		ФактическийТипMIME = ТипЗнч(MIMEЧасти);
		ОжидаемыйТипMIME = Тип("Строка");
		ЭтоКартинка = ФактическийТипMIME = ОжидаемыйТипMIME;
	КонецЕсли;
	Если ЭтоКартинка Тогда
		MIMEВНижнемРегистре = НРег(MIMEЧасти);
		ПрефиксТипаИзображения = Лев(MIMEВНижнемРегистре, 6);
		ЭтоКартинка = ПрефиксТипаИзображения = "image/";
	КонецЕсли;
	Если Не ЭтоКартинка Тогда
		Возврат;
	КонецЕсли;

	ДвоичныеЧасти = Base64Значение(ДанныеЧасти.data);
	Вложение = КИИ_КоннекторИИ.НовоеВложениеОтвета("image", MIMEЧасти, ДвоичныеЧасти, "gemini-image");
	Результат.ВложенияОтвета.Добавить(Вложение);

КонецПроцедуры

Процедура ИзвлечьТокены(ОтветJSON, Результат)

	Если Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON) Тогда
		Возврат;
	КонецЕсли;

	Если Не ОтветJSON.Свойство("usageMetadata") 
		Или Не КИИ_КоннекторИИОбщий.ЭтоСтруктура(ОтветJSON.usageMetadata) Тогда
		Возврат;
	КонецЕсли;

	Использование = ОтветJSON.usageMetadata;
	ЕстьДанныеИспользования = Использование.Свойство("promptTokenCount")
		И Использование.Свойство("candidatesTokenCount");
	Результат.Вставить("ЕстьДанныеИспользования", ЕстьДанныеИспользования);

	Если Использование.Свойство("promptTokenCount") Тогда
		Результат.ВходныеТокены = Использование.promptTokenCount;
	КонецЕсли;

	Если Использование.Свойство("candidatesTokenCount") Тогда
		Результат.ВыходныеТокены = Использование.candidatesTokenCount;
	КонецЕсли;

	Если Использование.Свойство("cachedContentTokenCount") Тогда
		Результат.Вставить("ВыходныеТокеныВКеше", Использование.cachedContentTokenCount);
	КонецЕсли;
	Если Использование.Свойство("thoughtsTokenCount") Тогда
		Результат.ВыходныеТокены = Результат.ВыходныеТокены + Использование.thoughtsTokenCount;
	КонецЕсли;
	Если Использование.Свойство("totalTokenCount") Тогда
		Результат.ВсегоТокенов = Использование.totalTokenCount;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

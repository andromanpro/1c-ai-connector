// Читает настройки из констант (общие для всех пользователей и регламентных заданий).
// Ссылка на модель хранится отдельной константой: в JSON ее не сериализовать.
//
// Возвращаемое значение:
//  Структура, Неопределено - сохраненные настройки; Неопределено - константа еще не заполнена.
//
Функция ПрочитатьНастройкиИзКонстант()

	ЗначениеJSON = Константы.КИИ_МониторингОшибокНастройки.Получить();
	Если НЕ ЗначениеЗаполнено(ЗначениеJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Настройки = КИИ_КоннекторИИОбщий.ЗначениеИзСтрокиJSON(ЗначениеJSON, Ложь);
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Модель здесь НЕ читаем: ее подставляет ПолучитьНастройкиМониторинга независимо от JSON.

	Возврат Настройки;

КонецФункции

// Записывает настройки в константы: скалярные значения - JSON-строкой, ссылку на модель - отдельно.
//
// Параметры:
//  Настройки - Структура - настройки для сохранения (см. ПолучитьНастройкиМониторинга).
//
Процедура ЗаписатьНастройкиВКонстанты(Знач Настройки)

	// ⚠ ОбщегоНазначения.ЗначениеВJSON ПАДАЕТ на Неопределено - такие поля не сериализуем
	// (при чтении подставится значение из НастройкиПоУмолчанию).
	// ⚠ Даты в JSON уходят строкой ISO и обратно строкой НЕ конвертируются - полей типа Дата
	// в настройках не держать (дата последнего сбора вынесена в отдельную константу).
	ДляJSON = Новый Структура;
	Для Каждого Элемент Из Настройки Цикл
		ТипЗначения = ТипЗнч(Элемент.Значение);
		Если Элемент.Ключ = "МодельДляАнализа"
			ИЛИ ТипЗначения = Тип("Неопределено")
			ИЛИ ТипЗначения = Тип("NULL") Тогда
			Продолжить;
		КонецЕсли;
		ДляJSON.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	НастройкиВСтрокеJSON = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(ДляJSON);
	Константы.КИИ_МониторингОшибокНастройки.Установить(НастройкиВСтрокеJSON);

	Модель = Неопределено;
	Настройки.Свойство("МодельДляАнализа", Модель);
	Если ТипЗнч(Модель) = Тип("СправочникСсылка.КИИ_МоделиИИ") Тогда
		Константы.КИИ_МониторингОшибокМодельАнализа.Установить(Модель);
	Иначе
		ПустаяМодель = Справочники.КИИ_МоделиИИ.ПустаяСсылка();
		Константы.КИИ_МониторингОшибокМодельАнализа.Установить(ПустаяМодель);
	КонецЕсли;

КонецПроцедуры

// Читает настройки прежних версий из персонального ХранилищаОбщихНастроек.
// Использовалось до перевода настроек на константы: значения были ПЕРСОНАЛЬНЫМИ -
// регламентное задание под служебным пользователем не видело настройки администратора.
//
// Возвращаемое значение:
//  Структура, Неопределено - настройки текущего пользователя либо Неопределено.
//
Функция ПрочитатьУстаревшиеНастройки()

	Попытка
		Сохраненные = ХранилищеОбщихНастроек.Загрузить("КИИ_МониторингОшибок_Настройки", "");
	Исключение
		Возврат Неопределено; // Настроек прежних версий нет
	КонецПопытки;

	ЭтоНастройки = ТипЗнч(Сохраненные) = Тип("Структура");
	Результат = ?(ЭтоНастройки, Сохраненные, Неопределено);
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

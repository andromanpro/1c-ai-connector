// Экспорт: вызывается кросс-модульно из КИИ_МониторингОшибокАнализ.СформироватьПакетныйПромптДляИИ.
// Без Экспорт вызов падал «метод не обнаружен» - латентный сбой пакетного анализа (аудит: паттерн
// «молчаливой смерти», путь не был прогнан).
// Возвращаемое значение:
//  Строка - системный промпт для пакетного анализа ошибок ИИ.
Функция ПолучитьСистемныйПромптПакетный() Экспорт

	Возврат
	"Ты - эксперт по 1С:Предприятие. Проанализируй пакет ошибок из журнала регистрации.
	|
	|Критерии критичности:
	|- Низкая: информационные, не влияют на работу
	|- Средняя: предупреждения, могут создавать неудобства
	|- Высокая: ошибки, нарушающие бизнес-процессы
	|- Критическая: блокирующие (deadlock, потеря данных, access violation)
	|
	|ВАЖНО: Верни ТОЛЬКО JSON-массив без дополнительного текста.
	|На каждую ошибку - один элемент массива:
	|[
	|  {""номер"": 1, ""критичность"": ""Низкая|Средняя|Высокая|Критическая"",
	|   ""описание"": ""Краткое описание и рекомендация (до 200 слов)""},
	|  {""номер"": 2, ""критичность"": ""..."", ""описание"": ""...""}
	|]";

КонецФункции

// Максимальная дата среди обработанных записей ЖР - курсор для продолжения усеченного сбора.
//
// Параметры:
//  МассивОшибок   - Массив из СтрокаТаблицыЗначений - обработанные записи ЖР.
//  ДатаПоследнего - Дата - дата, с которой шел текущий сбор.
//
// Возвращаемое значение:
//  Дата - дата последней обработанной записи (строго больше ДатаПоследнего).
//
Функция ПоследняяДатаЗаписей(Знач МассивОшибок, Знач ДатаПоследнего)

	Максимум = ДатаПоследнего;
	Для Каждого ЗаписьЖурнала Из МассивОшибок Цикл
		Если ЗаписьЖурнала.Дата > Максимум Тогда
			Максимум = ЗаписьЖурнала.Дата;
		КонецЕсли;
	КонецЦикла;

	// Защита от зацикливания: если все записи уместились в ту же секунду, что и старый курсор,
	// сбор читал бы один и тот же кусок вечно. Сдвигаем на секунду вперед - при 100 x РазмерСтраницы
	// записей в одной секунде часть все равно потеряется, но подсистема не встанет колом.
	Возврат ?(Максимум > ДатаПоследнего, Максимум, ДатаПоследнего + 1);

КонецФункции

// Читает настройки из констант (общие для всех пользователей и регламентных заданий).
// Ссылка на модель хранится отдельной константой: в JSON ее не сериализовать.
//
// Возвращаемое значение:
//  Структура, Неопределено - сохраненные настройки; Неопределено - константа еще не заполнена.
//
Функция ПрочитатьНастройкиИзКонстант()

	ЗначениеJSON = Константы.КИИ_МониторингОшибокНастройки.Получить();
	Если НЕ ЗначениеЗаполнено(ЗначениеJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Настройки = ОбщегоНазначения.JSONВЗначение(ЗначениеJSON, , Ложь);
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Модель здесь НЕ читаем: ее подставляет ПолучитьНастройкиМониторинга независимо от JSON.

	Возврат Настройки;

КонецФункции

// Записывает настройки в константы: скалярные значения - JSON-строкой, ссылку на модель - отдельно.
//
// Параметры:
//  Настройки - Структура - настройки для сохранения (см. ПолучитьНастройкиМониторинга).
//
Процедура ЗаписатьНастройкиВКонстанты(Знач Настройки)

	// ⚠ ОбщегоНазначения.ЗначениеВJSON ПАДАЕТ на Неопределено - такие поля не сериализуем
	// (при чтении подставится значение из НастройкиПоУмолчанию).
	// ⚠ Даты в JSON уходят строкой ISO и обратно строкой НЕ конвертируются - полей типа Дата
	// в настройках не держать (дата последнего сбора вынесена в отдельную константу).
	ДляJSON = Новый Структура;
	Для Каждого Элемент Из Настройки Цикл
		ТипЗначения = ТипЗнч(Элемент.Значение);
		Если Элемент.Ключ = "МодельДляАнализа"
			ИЛИ ТипЗначения = Тип("Неопределено")
			ИЛИ ТипЗначения = Тип("NULL") Тогда
			Продолжить;
		КонецЕсли;
		ДляJSON.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Константы.КИИ_МониторингОшибокНастройки.Установить(ОбщегоНазначения.ЗначениеВJSON(ДляJSON));

	Модель = Неопределено;
	Настройки.Свойство("МодельДляАнализа", Модель);
	Если ТипЗнч(Модель) = Тип("СправочникСсылка.КИИ_МоделиИИ") Тогда
		Константы.КИИ_МониторингОшибокМодельАнализа.Установить(Модель);
	Иначе
		Константы.КИИ_МониторингОшибокМодельАнализа.Установить(
			Справочники.КИИ_МоделиИИ.ПустаяСсылка());
	КонецЕсли;

КонецПроцедуры

// Читает настройки прежних версий из персонального ХранилищаОбщихНастроек.
// Использовалось до перевода настроек на константы: значения были ПЕРСОНАЛЬНЫМИ -
// регламентное задание под служебным пользователем не видело настройки администратора.
//
// Возвращаемое значение:
//  Структура, Неопределено - настройки текущего пользователя либо Неопределено.
//
Функция ПрочитатьУстаревшиеНастройки()

	Попытка
		Сохраненные = ХранилищеОбщихНастроек.Загрузить("КИИ_МониторингОшибок_Настройки", "");
	Исключение
		Возврат Неопределено; // Настроек прежних версий нет
	КонецПопытки;

	Возврат ?(ТипЗнч(Сохраненные) = Тип("Структура"), Сохраненные, Неопределено);

КонецФункции

#КонецОбласти

#КонецОбласти

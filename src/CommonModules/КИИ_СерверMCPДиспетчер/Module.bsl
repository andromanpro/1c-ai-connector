#Область ПрограммныйИнтерфейс

// Обрабатывает MCP JSON-RPC запрос. Вызывается из HTTPService POST handler.
//
// Параметры:
//  ТелоJSON - Строка - сырое тело запроса (JSON)
//
// Возвращаемое значение:
//  - Структура - данные успешной обработки:
//
//  - Неопределено - данные отсутствуют либо результат отклонен.
Функция ОбработатьЗапросMCP(Знач ТелоJSON) Экспорт

	Перем РезультатФункции;
	
	РезультатФункции = ОбработатьЗапросMCPСАудитом(ТелоJSON).Ответ;
	Возврат РезультатФункции;
	
КонецФункции

// Обрабатывает MCP JSON-RPC запрос и возвращает ответ ВМЕСТЕ с метаданными
// аудита, вычисленными за ОДИН разбор тела. Адаптеры транспорта НЕ должны
// повторно парсить JSON-RPC (ADR-0024). Сбой сериализации params для аудита
// изолирован и не влияет на обработку запроса (дефект D4).
//
// Параметры:
//  ТелоJSON - Строка - тело JSON-RPC запроса
//
// Возвращаемое значение:
//  Структура:
//    * Ответ - Структура, Неопределено - JSON-RPC ответ; у уведомления отсутствует.
//    * АудитМета - Структура - {Метод, Идентификатор, ПараметрыJSON, КодРезультата}
//
Функция ОбработатьЗапросMCPСАудитом(Знач ТелоJSON) Экспорт

	Перем ТекстСообщения;

	Перем ДанныеОшибки2;
	Перем ПодробностиОшибки;
	Перем РезультатФункции;
	Перем УспехЗначение;
	Перем СписокИнструментовЗначение;
	
	АудитМета = НоваяАудитМета();
	Идентификатор = Неопределено;
	ИмяМетода = "";
	
	Попытка
		
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоJSON);
			ЗапросMCP = ПрочитатьJSON(ЧтениеJSON, Ложь);
			ЧтениеJSON.Закрыть();
		Исключение
			АудитМета.КодРезультата = "parse_error";
			ДанныеОшибки2 = ИнформацияОбОшибке();
			ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки2);
			ДанныеОшибкиПарсинга = СформироватьДанныеОшибкиСКорреляцией(ПодробностиОшибки);
			ТекстСообщения = НСтр("ru = 'Parse error'");
			ОтветОшибки = СформироватьОшибку(Неопределено, -32700, ТекстСообщения, ДанныеОшибкиПарсинга);
			РезультатФункции = РезультатСАудитом(ОтветОшибки, АудитМета);
			Возврат РезультатФункции;
		КонецПопытки;
		
		ЗаполнитьАудитМета(ЗапросMCP, АудитМета);
		
		Если Не ВалидныйЗапросMCP(ЗапросMCP, Идентификатор, ИмяМетода) Тогда
			АудитМета.КодРезультата = "error";
			ТекстСообщения = НСтр("ru = 'Invalid request'");
			ОтветОшибки = СформироватьОшибку(Идентификатор, -32600, ТекстСообщения);
			РезультатФункции = РезультатСАудитом(ОтветОшибки, АудитМета);
			Возврат РезультатФункции;
		КонецЕсли;
		
		Если Не ЗапросMCP.Свойство("id") Тогда
			АудитМета.КодРезультата = "notification";
			РезультатФункции = РезультатСАудитом(Неопределено, АудитМета);
			Возврат РезультатФункции;
		КонецЕсли;
		Если ИмяМетода = "initialize" Тогда
			ОтветИнициализации = ОбработатьИнициализацию(ЗапросMCP, Идентификатор);
			АудитМета.КодРезультата = ?(ОтветИнициализации.Свойство("error"), "error", "ok");
			РезультатФункции = РезультатСАудитом(ОтветИнициализации, АудитМета);
			Возврат РезультатФункции;
		КонецЕсли;
		Если ИмяМетода = "ping" Тогда
			АудитМета.КодРезультата = "ok";
			УспехЗначение = СформироватьУспех(Идентификатор, Новый Структура);
			РезультатФункции = РезультатСАудитом(УспехЗначение, АудитМета);
			Возврат РезультатФункции;
		КонецЕсли;
		Если ИмяМетода = "tools/list" Тогда
			АудитМета.КодРезультата = "ok";
			СписокИнструментовЗначение = СформироватьСписокИнструментов();
			УспехЗначение = СформироватьУспех(Идентификатор, СписокИнструментовЗначение);
			РезультатФункции = РезультатСАудитом(УспехЗначение, АудитМета);
			Возврат РезультатФункции;
		КонецЕсли;
		
		Если ИмяМетода = "tools/call" Тогда
			ОтветИнструмента = ОбработатьВызовИнструмента(ЗапросMCP, Идентификатор);
			АудитМета.КодРезультата = "error";
			Если Не ОтветИнструмента.Свойство("error") Тогда
				РезультатВызова = ОтветИнструмента.result;
				Если Не РезультатВызова.isError Тогда
					АудитМета.КодРезультата = "ok";
				КонецЕсли;
			КонецЕсли;
			РезультатФункции = РезультатСАудитом(ОтветИнструмента, АудитМета);
			Возврат РезультатФункции;
		КонецЕсли;
		
		АудитМета.КодРезультата = "error";
		ТекстСообщения = НСтр("ru = 'Method not found or not whitelisted'");
		ОтветОшибки = СформироватьОшибку(Идентификатор, -32601, ТекстСообщения);
		РезультатФункции = РезультатСАудитом(ОтветОшибки, АудитМета);
		Возврат РезультатФункции;
		
	Исключение
		
		ДанныеОшибки2 = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки2);
		ДанныеОшибки = СформироватьДанныеОшибкиСКорреляцией(ТекстОшибки);
		АудитМета.КодРезультата = "error";
		ТекстСообщения = НСтр("ru = 'Internal error'");
		ОтветОшибки = СформироватьОшибку(Идентификатор, -32603, ТекстСообщения, ДанныеОшибки);
		РезультатФункции = РезультатСАудитом(ОтветОшибки, АудитМета);
		Возврат РезультатФункции;

	КонецПопытки;

КонецФункции

// Регистрирует инцидент: пишет [correlation_id] + подробности ошибки в журнал
// регистрации и возвращает данные для клиента БЕЗ раскрытия внутренних деталей
// (только correlation_id). Клиент сообщает correlation_id в поддержку - детали
// (имена модулей, фрагменты запросов, значения параметров) остаются на сервере.
//
// Параметры:
//  ТекстОшибки - Строка - подробное представление ошибки (только для журнала)
//  ИсточникЖР  - Строка - имя события журнала регистрации
//
// Возвращаемое значение:
//  Структура - данные ошибки для JSON-RPC error.data:
//   * correlation_id - Строка - идентификатор корреляции с записью в ЖР.
//
Функция СформироватьДанныеОшибкиСКорреляцией(Знач ТекстОшибки, Знач ИсточникЖР = "КИИ.СерверMCP.Диспетчер") Экспорт

	Перем ТекстПоШаблону;

	Перем РезультатФункции;

	ИдентификаторКорреляции = Строка(Новый УникальныйИдентификатор);

	ТекстПоШаблону = СтрШаблон("[%1] %2", ИдентификаторКорреляции, ТекстОшибки);
	ЗаписьЖурналаРегистрации(ИсточникЖР, УровеньЖурналаРегистрации.Ошибка, , , ТекстПоШаблону);

	РезультатФункции = Новый Структура("correlation_id", ИдентификаторКорреляции);
	Возврат РезультатФункции;

КонецФункции

// Передает ожидаемый отказ инструмента между локальным вызовом, MCP и агентом.
// Параметры:
//  ОшибкаИнструмента - Структура - code, message и correlation_id без стека платформы.
Процедура ВызватьОшибкуИнструмента(Знач ОшибкаИнструмента) Экспорт

	ПроверитьДанныеОшибкиИнструмента(ОшибкаИнструмента);
	ТекстJSON = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(ОшибкаИнструмента);
	ТекстИсключения = "[MCPToolError] " + ТекстJSON;
	ВызватьИсключение ТекстИсключения;

КонецПроцедуры

// Читает наш транспортный маркер, не классифицируя текст ошибок платформы.
// Параметры:
//  ДанныеОшибки - ИнформацияОбОшибке - Перехваченное исключение.
// Возвращаемое значение:
//  Структура, Неопределено - Ожидаемый отказ либо обычное исключение.
Функция ДанныеОшибкиИнструмента(Знач ДанныеОшибки) Экспорт

	Маркер = "[MCPToolError] ";
	ПозицияМаркера = СтрНайти(ДанныеОшибки.Описание, Маркер);
	Если ПозицияМаркера = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДлинаМаркера = СтрДлина(Маркер);
	ТекстJSON = Сред(ДанныеОшибки.Описание, ПозицияМаркера + ДлинаМаркера);
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	ОшибкаИнструмента = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	ПроверитьДанныеОшибкиИнструмента(ОшибкаИнструмента);
	Возврат ОшибкаИнструмента;

КонецФункции

// Маркер валидационной ошибки инструмента. Текст исключения после маркера
// безопасен для возврата MCP-клиенту - см. ВызватьОшибкуВалидацииИнструмента.
//
// Возвращаемое значение:
//  Строка - префикс-маркер валидационной ошибки инструмента.
//
Функция МаркерОшибкиВалидацииИнструмента() Экспорт

	Возврат "[MCPValidation] ";

КонецФункции

// Бросает исключение с маркером валидационной ошибки. Инструменты вызывают
// для ошибок входных данных (невалидные параметры, неизвестные имена объектов):
// диспетчер вернет текст клиенту с кодом -32602 без correlation_id.
// Внутренние инварианты бросать обычным ВызватьИсключение - они уходят
// в Internal error с корреляцией и деталями только в журнале регистрации.
//
// Параметры:
//  ТекстОшибки - Строка - описание ошибки для MCP-клиента (без внутренних деталей).
//
Процедура ВызватьОшибкуВалидацииИнструмента(Знач ТекстОшибки) Экспорт

	ВызватьИсключение МаркерОшибкиВалидацииИнструмента() + ТекстОшибки;

КонецПроцедуры

// Уведомления MCP принимаются без тела ответа; прежние запросы возвращают JSON.
// Параметры:
//  РезультатЯдра - Структура - результат обработки с полем Ответ.
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ транспорта 202 без тела или 200 с JSON.
Функция СформироватьHTTPОтветMCP(Знач РезультатЯдра) Экспорт

	Перем ТекстJSON;

	Перем РезультатФункции;
#Если Сервер И Не ВнешнееСоединение Тогда
	// HTTPСервисОтвет недоступен во внешнем соединении клиент-серверной базы.
	Если РезультатЯдра.Ответ = Неопределено Тогда
		РезультатФункции = Новый HTTPСервисОтвет(202);
		Возврат РезультатФункции;
	КонецЕсли;
	ОтветHTTP = Новый HTTPСервисОтвет(200);
	ОтветHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ТекстJSON = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(РезультатЯдра.Ответ);
	ОтветHTTP.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8);
	Возврат ОтветHTTP;
#Иначе
	ВызватьИсключение НСтр("ru = 'http_context_required: HTTP-ответ формируется на сервере HTTP-сервиса.'");
#КонецЕсли
КонецФункции

// Ошибка инфраструктуры учета не превращается в разрешение выполнить инструмент.
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ 503 с причиной временной недоступности.
Функция СформироватьHTTPОтветПриСбоеОграничителя() Экспорт

	Перем ТекстJSON;

	Перем ТекстСообщения;
#Если Сервер И Не ВнешнееСоединение Тогда
	// HTTPСервисОтвет недоступен во внешнем соединении клиент-серверной базы.
	ОтветHTTP = Новый HTTPСервисОтвет(503);
	ОтветHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ОтветHTTP.Заголовки.Вставить("Retry-After", "1");
	ТекстСообщения = НСтр("ru = 'Request accounting temporarily unavailable'");
	ОтветОшибка = СформироватьОшибку(Неопределено, -32005, ТекстСообщения);
	ТекстJSON = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(ОтветОшибка);
	ОтветHTTP.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8);
	Возврат ОтветHTTP;
#Иначе
	ВызватьИсключение НСтр("ru = 'http_context_required: HTTP-ответ формируется на сервере HTTP-сервиса.'");
#КонецЕсли
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает текст валидационной ошибки инструмента без маркера либо Неопределено,
// если исключение не помечено маркером валидации (= внутренняя ошибка).
//
// Параметры:
//  ИнформацияОбИсключении - ИнформацияОбОшибке - перехваченное исключение инструмента.
//
// Возвращаемое значение:
//  Строка, Неопределено - текст для MCP-клиента либо Неопределено для внутренних ошибок.
//
Функция ТекстОшибкиВалидацииИнструмента(Знач ИнформацияОбИсключении)

	Перем ДлинаТекста;
	Перем РезультатФункции;

	Маркер = МаркерОшибкиВалидацииИнструмента();
	Описание = ИнформацияОбИсключении.Описание;
	ПозицияМаркера = СтрНайти(Описание, Маркер);
	Если ПозицияМаркера = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДлинаТекста = СтрДлина(Маркер);
	РезультатФункции = Сред(Описание, ПозицияМаркера + ДлинаТекста);
	Возврат РезультатФункции;

КонецФункции

Процедура ПроверитьДанныеОшибкиИнструмента(Знач ОшибкаИнструмента)

	Если ТипЗнч(ОшибкаИнструмента) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректное описание отказа инструмента.'");
	КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("code,message,correlation_id", ",") Цикл
		ЗначениеПоля = Неопределено;
		Если Не ОшибкаИнструмента.Свойство(ИмяПоля, ЗначениеПоля) Или ТипЗнч(ЗначениеПоля) <> Тип("Строка") Тогда
			ВызватьИсключение НСтр("ru = 'Некорректное описание отказа инструмента.'");
		КонецЕсли;
		Если ПустаяСтрока(ЗначениеПоля) Тогда
			ВызватьИсключение НСтр("ru = 'Пустое описание отказа инструмента.'");
		КонецЕсли;
	КонецЦикла;
	Попытка
		ИдентификаторКорреляции = Новый УникальныйИдентификатор(ОшибкаИнструмента.correlation_id);
	Исключение
		ВызватьИсключение НСтр("ru = 'Некорректный код обращения инструмента.'");
	КонецПопытки;
	КаноническийИдентификатор = Строка(ИдентификаторКорреляции);
	ПолученныйИдентификатор = НРег(ОшибкаИнструмента.correlation_id);
	Если КаноническийИдентификатор <> ПолученныйИдентификатор Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный код обращения инструмента.'");
	КонецЕсли;

КонецПроцедуры

Функция ВалидныйЗапросMCP(ЗапросMCP, Идентификатор, ИмяМетода)
	
	Если ТипЗнч(ЗапросMCP) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КандидатИдентификатора = Неопределено;
	Если ЗапросMCP.Свойство("id", КандидатИдентификатора) Тогда
		Если ТипЗнч(КандидатИдентификатора) <> Тип("Строка") И ТипЗнч(КандидатИдентификатора) <> Тип("Число") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ТипЗнч(КандидатИдентификатора) = Тип("Число") И КандидатИдентификатора <> Цел(КандидатИдентификатора) Тогда
			Возврат Ложь;
		КонецЕсли;
		Идентификатор = КандидатИдентификатора;
	КонецЕсли;
	
	Если Не ЗапросMCP.Свойство("jsonrpc") Или ЗапросMCP.jsonrpc <> "2.0" Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если Не ЗапросMCP.Свойство("method", ИмяМетода) Или ТипЗнч(ИмяМетода) <> Тип("Строка") Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Совместимость с MCP 2024-2025. Редакция 2026 имеет другой цикл и не заявляется.
Функция ОбработатьИнициализацию(Знач ЗапросMCP, Знач Идентификатор)

	Перем ТекстСообщения;

	Перем РезультатФункции;
	Перем ПараметрыВызова;
	Параметры = Неопределено;
	Версия = Неопределено;
	ВозможностиКлиента = Неопределено;
	Клиент = Неопределено;
	ИмяКлиента = Неопределено;
	ВерсияКлиента = Неопределено;
	Если Не ЗапросMCP.Свойство("params", Параметры) Или ТипЗнч(Параметры) <> Тип("Структура") Тогда
		ТекстСообщения = НСтр("ru = 'Invalid params'");
		РезультатФункции = СформироватьОшибку(Идентификатор, -32602, ТекстСообщения);
		Возврат РезультатФункции;
	КонецЕсли;
	НеверныеПараметрыИнициализации = Не Параметры.Свойство("protocolVersion", Версия)
		Или ТипЗнч(Версия) <> Тип("Строка")
		Или Не Параметры.Свойство("capabilities", ВозможностиКлиента)
		Или ТипЗнч(ВозможностиКлиента) <> Тип("Структура")
		Или Не Параметры.Свойство("clientInfo", Клиент)
		Или ТипЗнч(Клиент) <> Тип("Структура");
	Если НеверныеПараметрыИнициализации Тогда
		ТекстСообщения = НСтр("ru = 'Invalid params'");
		РезультатФункции = СформироватьОшибку(Идентификатор, -32602, ТекстСообщения);
		Возврат РезультатФункции;
	КонецЕсли;
	НеверныеСведенияКлиента = Не Клиент.Свойство("name", ИмяКлиента)
		Или ТипЗнч(ИмяКлиента) <> Тип("Строка")
		Или Не Клиент.Свойство("version", ВерсияКлиента)
		Или ТипЗнч(ВерсияКлиента) <> Тип("Строка");
	Если НеверныеСведенияКлиента Тогда
		ТекстСообщения = НСтр("ru = 'Invalid params'");
		РезультатФункции = СформироватьОшибку(Идентификатор, -32602, ТекстСообщения);
		Возврат РезультатФункции;
	КонецЕсли;
	ВерсияНеПоддерживается = Версия <> "2024-11-05"
		И Версия <> "2025-03-26"
		И Версия <> "2025-06-18"
		И Версия <> "2025-11-25";
	Если ВерсияНеПоддерживается Тогда
		Версия = "2025-11-25";
	КонецЕсли;
	ВозможностиИнструментов = Новый Структура("listChanged", Ложь);
	ВозможностиСервера = Новый Структура("tools", ВозможностиИнструментов);
	СведенияСервера = Новый Структура("name, version", "iikona-runtime-mcp", "0.1.0");
	ПараметрыВызова = Новый Структура(
		"protocolVersion, capabilities, serverInfo", Версия, ВозможностиСервера, СведенияСервера);
	РезультатФункции = СформироватьУспех(Идентификатор, ПараметрыВызова);
	Возврат РезультатФункции;
КонецФункции

Функция СформироватьСписокИнструментов()

	Перем РезультатФункции;
	
	Инструменты = Новый Массив;
	Реестр = КИИ_СерверMCPРеестр.ПолучитьРеестрИнструментов();
	
	Для Каждого ЗаписьРеестра Из Реестр Цикл
		
		Если ЗаписьРеестра.Схема = Неопределено Тогда
			Схема = Новый Структура;
		Иначе
			Схема = ЗаписьРеестра.Схема;
		КонецЕсли;
		
		Инструмент = Новый Структура;
		Инструмент.Вставить("name", ЗаписьРеестра.Имя);
		Инструмент.Вставить("description", ЗаписьРеестра.Описание);
		Инструмент.Вставить("inputSchema", Схема);
		Инструменты.Добавить(Инструмент);
		
	КонецЦикла;
	
	РезультатФункции = Новый Структура("tools", Инструменты);
	Возврат РезультатФункции;
	
КонецФункции

Функция ОбработатьВызовИнструмента(ЗапросMCP, Знач Идентификатор)

	Перем РезультатМетаданныеВызова;
	Перем ТекстJSON;
	Перем ПараметрыВызова;

	Перем ТекстСообщения;

	Перем РезультатФункции;
	Перем ДанныеОшибки;
	
	ИмяИнструмента = "";
	Аргументы = Новый Структура;
	Если Не ПолучитьПараметрыВызоваИнструмента(ЗапросMCP, ИмяИнструмента, Аргументы) Тогда
		ТекстСообщения = НСтр("ru = 'Invalid params'");
		РезультатФункции = СформироватьОшибку(Идентификатор, -32602, ТекстСообщения);
		Возврат РезультатФункции;
	КонецЕсли;
	
	Если Не ИнструментЗарегистрирован(ИмяИнструмента) Тогда
		ТекстСообщения = НСтр("ru = 'Tool not found'");
		РезультатФункции = СформироватьОшибку(Идентификатор, -32601, ТекстСообщения);
		Возврат РезультатФункции;
	КонецЕсли;
	
	ОшибкаИнструмента = Неопределено;
	Попытка
		Данные = КИИ_СерверMCPРеестр.ВыполнитьИнструмент(ИмяИнструмента, Аргументы);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ТекстВалидации = ТекстОшибкиВалидацииИнструмента(ДанныеОшибки);
		Если ТекстВалидации <> Неопределено Тогда
			РезультатФункции = СформироватьОшибку(Идентификатор, -32602, ТекстВалидации);
			Возврат РезультатФункции;
		КонецЕсли;
		ОшибкаИнструмента = ДанныеОшибкиИнструмента(ДанныеОшибки);
		Если ОшибкаИнструмента = Неопределено Тогда
			ВызватьИсключение;
		КонецЕсли;
		Данные = Новый Структура("error", ОшибкаИнструмента);
	КонецПопытки;
	Результат = Новый Структура;
	Результат.Вставить("ok", ОшибкаИнструмента = Неопределено);
	Результат.Вставить("tool", ИмяИнструмента);
	Результат.Вставить("data", Данные);
	РезультатМетаданныеВызова = МетаданныеВызова();
	Результат.Вставить("meta", РезультатМетаданныеВызова);
	Содержимое = Новый Массив;
	ТекстJSON = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Данные);
	ПараметрыВызова = Новый Структура("type, text", "text", ТекстJSON);
	Содержимое.Добавить(ПараметрыВызова);
	Результат.Вставить("content", Содержимое);
	Результат.Вставить("structuredContent", Данные);
	Результат.Вставить("isError", ОшибкаИнструмента <> Неопределено);
	
	РезультатФункции = СформироватьУспех(Идентификатор, Результат);
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьПараметрыВызоваИнструмента(ЗапросMCP, ИмяИнструмента, Аргументы)
	
	ИмяИнструмента = "";
	Аргументы = Новый Структура;
	Параметры = Неопределено;
	
	Если Не ЗапросMCP.Свойство("params", Параметры) Или ТипЗнч(Параметры) <> Тип("Структура") Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если Не Параметры.Свойство("name", ИмяИнструмента)
		Или ТипЗнч(ИмяИнструмента) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(ИмяИнструмента) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если Параметры.Свойство("arguments", Аргументы) Тогда
		
		Если Аргументы = Неопределено Тогда
			Аргументы = Новый Структура;
		КонецЕсли;
		
		Если ТипЗнч(Аргументы) <> Тип("Структура") И ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ИнструментЗарегистрирован(Знач ИмяИнструмента)

	Перем РезультатФункции;
	
	Реестр = КИИ_СерверMCPРеестр.ПолучитьРеестрИнструментов();
	РезультатФункции = Реестр.Найти(ИмяИнструмента, "Имя") <> Неопределено;
	Возврат РезультатФункции;
	
КонецФункции

Функция МетаданныеВызова()

	Перем УниверсальнаяДата;
	Перем ФорматированноеЗначение;
	
	ДанныеВызова = Новый Структура;
	ДанныеВызова.Вставить("server", "iikona-runtime-mcp");
	ДанныеВызова.Вставить("version", "0.1.0");
	УниверсальнаяДата = ТекущаяУниверсальнаяДата();
	ФорматированноеЗначение = Формат(УниверсальнаяДата, "ДФ='yyyy-MM-ddTHH:mm:ssZ'");
	ДанныеВызова.Вставить("timestamp", ФорматированноеЗначение);
	Возврат ДанныеВызова;
	
КонецФункции

Функция СформироватьУспех(Знач Идентификатор, Знач Результат)
	
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("result", Результат);
	Возврат Ответ;
	
КонецФункции

Функция СформироватьОшибку(Знач Идентификатор, Знач Код, Знач Сообщение, Знач ДополнительныеДанные = Неопределено)
	
	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	
	Если ДополнительныеДанные <> Неопределено Тогда
		Ошибка.Вставить("data", ДополнительныеДанные);
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("error", Ошибка);
	Возврат Ответ;
	
КонецФункции

Функция НоваяАудитМета()
	
	Мета = Новый Структура("Метод, Идентификатор, ПараметрыJSON", "", Неопределено, "");
	Мета.Вставить("КодРезультата", "");
	Возврат Мета;
	
КонецФункции

Функция РезультатСАудитом(Знач Ответ, Знач АудитМета)
	
	Результат = Новый Структура;
	Результат.Вставить("Ответ", Ответ);
	Результат.Вставить("АудитМета", АудитМета);
	Возврат Результат;
	
КонецФункции

// Заполняет метаданные аудита из разобранного запроса. Сериализация params
// изолирована Попыткой - ее сбой НЕ влияет на обработку запроса (дефект D4).
Процедура ЗаполнитьАудитМета(Знач ЗапросMCP, АудитМета)

	Перем РезультатСанитизироватьПараметрыДляАудита;
	
	Если ТипЗнч(ЗапросMCP) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Значение = "";
	Если ЗапросMCP.Свойство("method", Значение) И ТипЗнч(Значение) = Тип("Строка") Тогда
		АудитМета.Метод = Значение;
	КонецЕсли;
	
	Если ЗапросMCP.Свойство("id", Значение) Тогда
		АудитМета.Идентификатор = Значение;
	КонецЕсли;
	
	Параметры = Неопределено;
	Если ЗапросMCP.Свойство("params", Параметры) И Параметры <> Неопределено Тогда
		Попытка
			РезультатСанитизироватьПараметрыДляАудита = СанитизироватьПараметрыДляАудита(Параметры);
			АудитМета.ПараметрыJSON = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(
				РезультатСанитизироватьПараметрыДляАудита);
		Исключение
			АудитМета.ПараметрыJSON = "";
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЗначениеКлюча(Знач Контейнер, Знач Ключ, Значение)

	Перем РезультатФункции;
	
	Значение = Неопределено;
	Если ТипЗнч(Контейнер) = Тип("Структура") Тогда
		РезультатФункции = Контейнер.Свойство(Ключ, Значение);
		Возврат РезультатФункции;
	КонецЕсли;
	Если ТипЗнч(Контейнер) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение Из Контейнер Цикл
			Если КлючЗначение.Ключ = Ключ Тогда
				Значение = КлючЗначение.Значение;
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Функция КопироватьКлючи(Знач Контейнер)
	
	Если ТипЗнч(Контейнер) = Тип("Соответствие") Тогда
		КопияС = Новый Соответствие;
		Для Каждого КлючЗначение Из Контейнер Цикл
			КопияС.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		Возврат КопияС;
	КонецЕсли;
	Копия = Новый Структура;
	Для Каждого КлючЗначение Из Контейнер Цикл
		Копия.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Возврат Копия;
	
КонецФункции

// Аудит-санитизация: для tools/call execute_query заменяет arguments.query_text
// на sha256-хеш - секрет-литералы в тексте запроса не попадают в журнал аудита
// (дефект D2′: редакция по имени ключа не ловит содержимое query_text).
// Оригинальный ЗапросMCP НЕ мутируется (работаем по копиям); сбой изолирован.
Функция СанитизироватьПараметрыДляАудита(Знач Параметры)

	Перем ШестнадцатеричнаяСтрока;

	Перем ПредставлениеЗначения;
	
	Попытка
		
		Если ТипЗнч(Параметры) <> Тип("Структура") И ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
			Возврат Параметры;
		КонецЕсли;
		
		ИмяИнструмента = Неопределено;
		Если Не ПолучитьЗначениеКлюча(Параметры, "name", ИмяИнструмента) Или ИмяИнструмента <> "execute_query" Тогда
			Возврат Параметры;
		КонецЕсли;
		
		Аргументы = Неопределено;
		Если Не ПолучитьЗначениеКлюча(Параметры, "arguments", Аргументы)
			Или (ТипЗнч(Аргументы) <> Тип("Структура") И ТипЗнч(Аргументы) <> Тип("Соответствие")) Тогда
			Возврат Параметры;
		КонецЕсли;
		
		ТекстЗапроса = Неопределено;
		Если Не ПолучитьЗначениеКлюча(Аргументы, "query_text", ТекстЗапроса) Тогда
			Возврат Параметры;
		КонецЕсли;
		
		Хешировщик = Новый ХешированиеДанных(ХешФункция.SHA256);
		ПредставлениеЗначения = Строка(ТекстЗапроса);
		Хешировщик.Добавить(ПредставлениеЗначения);
		ШестнадцатеричнаяСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(Хешировщик.ХешСумма);
		ХешЗапроса = "sha256:" + НРег(ШестнадцатеричнаяСтрока);
		
		НовыеАргументы = КопироватьКлючи(Аргументы);
		НовыеАргументы.Вставить("query_text", ХешЗапроса);
		НовыеПараметры = КопироватьКлючи(Параметры);
		НовыеПараметры.Вставить("arguments", НовыеАргументы);
		Возврат НовыеПараметры;
		
	Исключение
		Возврат Параметры;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Обрабатывает MCP JSON-RPC запрос. Вызывается из HTTPService POST handler.
//
// Параметры:
//  ТелоJSON - Строка - сырое тело запроса (JSON)
//
// Возвращаемое значение:
//  Структура - JSON-RPC ответ (success или error по спецификации)
//
Функция ОбработатьЗапросMCP(Знач ТелоJSON) Экспорт
	
	Возврат ОбработатьЗапросMCPСАудитом(ТелоJSON).Ответ;
	
КонецФункции

// Обрабатывает MCP JSON-RPC запрос и возвращает ответ ВМЕСТЕ с метаданными
// аудита, вычисленными за ОДИН разбор тела. Адаптеры транспорта НЕ должны
// повторно парсить JSON-RPC (ADR-0024). Сбой сериализации params для аудита
// изолирован и не влияет на обработку запроса (дефект D4).
//
// Параметры:
//  ТелоJSON - Строка - тело JSON-RPC запроса
//
// Возвращаемое значение:
//  Структура:
//    * Ответ     - Структура - JSON-RPC ответ (success или error)
//    * АудитМета - Структура - {Метод, Идентификатор, ПараметрыJSON, КодРезультата}
//
Функция ОбработатьЗапросMCPСАудитом(Знач ТелоJSON) Экспорт
	
	АудитМета = НоваяАудитМета();
	Идентификатор = Неопределено;
	ИмяМетода = "";
	
	Попытка
		
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоJSON);
			ЗапросMCP = ПрочитатьJSON(ЧтениеJSON, Ложь);
			ЧтениеJSON.Закрыть();
		Исключение
			АудитМета.КодРезультата = "parse_error";
			ДанныеОшибкиПарсинга = СформироватьДанныеОшибкиСКорреляцией(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОтветОшибки = СформироватьОшибку(
				Неопределено,
				-32700,
				НСтр("ru = 'Parse error'"),
				ДанныеОшибкиПарсинга);
			Возврат РезультатСАудитом(ОтветОшибки, АудитМета);
		КонецПопытки;
		
		ЗаполнитьАудитМета(ЗапросMCP, АудитМета);
		
		Если Не ВалидныйЗапросMCP(ЗапросMCP, Идентификатор, ИмяМетода) Тогда
			АудитМета.КодРезультата = "error";
			ОтветОшибки = СформироватьОшибку(
				Идентификатор,
				-32600,
				НСтр("ru = 'Invalid request'"));
			Возврат РезультатСАудитом(ОтветОшибки, АудитМета);
		КонецЕсли;
		
		Если ИмяМетода = "tools/list" Тогда
			АудитМета.КодРезультата = "ok";
			Возврат РезультатСАудитом(СформироватьУспех(Идентификатор, СформироватьСписокИнструментов()), АудитМета);
		КонецЕсли;
		
		Если ИмяМетода = "tools/call" Тогда
			ОтветИнструмента = ОбработатьВызовИнструмента(ЗапросMCP, Идентификатор);
			АудитМета.КодРезультата = ?(ОтветИнструмента.Свойство("error"), "error", "ok");
			Возврат РезультатСАудитом(ОтветИнструмента, АудитМета);
		КонецЕсли;
		
		АудитМета.КодРезультата = "error";
		ОтветОшибки = СформироватьОшибку(
			Идентификатор,
			-32601,
			НСтр("ru = 'Method not found or not whitelisted'"));
		Возврат РезультатСАудитом(ОтветОшибки, АудитМета);
		
	Исключение
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДанныеОшибки = СформироватьДанныеОшибкиСКорреляцией(ТекстОшибки);
		АудитМета.КодРезультата = "error";
		ОтветОшибки = СформироватьОшибку(
			Идентификатор,
			-32603,
			НСтр("ru = 'Internal error'"),
			ДанныеОшибки);
		Возврат РезультатСАудитом(ОтветОшибки, АудитМета);

	КонецПопытки;

КонецФункции

// Регистрирует инцидент: пишет [correlation_id] + подробности ошибки в журнал
// регистрации и возвращает данные для клиента БЕЗ раскрытия внутренних деталей
// (только correlation_id). Клиент сообщает correlation_id в поддержку - детали
// (имена модулей, фрагменты запросов, значения параметров) остаются на сервере.
//
// Параметры:
//  ТекстОшибки - Строка - подробное представление ошибки (только для журнала)
//  ИсточникЖР  - Строка - имя события журнала регистрации
//
// Возвращаемое значение:
//  Структура - данные ошибки для JSON-RPC error.data:
//   * correlation_id - Строка - идентификатор корреляции с записью в ЖР.
//
Функция СформироватьДанныеОшибкиСКорреляцией(Знач ТекстОшибки, Знач ИсточникЖР = "КИИ.СерверMCP.Диспетчер") Экспорт

	ИдентификаторКорреляции = Строка(Новый УникальныйИдентификатор);

	ЗаписьЖурналаРегистрации(
		ИсточникЖР,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		СтрШаблон("[%1] %2", ИдентификаторКорреляции, ТекстОшибки));

	Возврат Новый Структура("correlation_id", ИдентификаторКорреляции);

КонецФункции

// Маркер валидационной ошибки инструмента. Текст исключения после маркера
// безопасен для возврата MCP-клиенту - см. ВызватьОшибкуВалидацииИнструмента.
//
// Возвращаемое значение:
//  Строка - префикс-маркер валидационной ошибки инструмента.
//
Функция МаркерОшибкиВалидацииИнструмента() Экспорт

	Возврат "[MCPValidation] ";

КонецФункции

// Бросает исключение с маркером валидационной ошибки. Инструменты вызывают
// для ошибок входных данных (невалидные параметры, неизвестные имена объектов):
// диспетчер вернет текст клиенту с кодом -32602 без correlation_id.
// Внутренние инварианты бросать обычным ВызватьИсключение - они уходят
// в Internal error с корреляцией и деталями только в журнале регистрации.
//
// Параметры:
//  ТекстОшибки - Строка - описание ошибки для MCP-клиента (без внутренних деталей).
//
Процедура ВызватьОшибкуВалидацииИнструмента(Знач ТекстОшибки) Экспорт

	ВызватьИсключение МаркерОшибкиВалидацииИнструмента() + ТекстОшибки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает текст валидационной ошибки инструмента без маркера либо Неопределено,
// если исключение не помечено маркером валидации (= внутренняя ошибка).
//
// Параметры:
//  ИнформацияОбИсключении - ИнформацияОбОшибке - перехваченное исключение инструмента.
//
// Возвращаемое значение:
//  Строка, Неопределено - текст для MCP-клиента либо Неопределено для внутренних ошибок.
//
Функция ТекстОшибкиВалидацииИнструмента(Знач ИнформацияОбИсключении)

	Маркер = МаркерОшибкиВалидацииИнструмента();
	Описание = ИнформацияОбИсключении.Описание;
	ПозицияМаркера = СтрНайти(Описание, Маркер);
	Если ПозицияМаркера = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Сред(Описание, ПозицияМаркера + СтрДлина(Маркер));

КонецФункции

Функция ВалидныйЗапросMCP(ЗапросMCP, Идентификатор, ИмяМетода)
	
	Если ТипЗнч(ЗапросMCP) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗапросMCP.Свойство("id") Тогда
		Идентификатор = ЗапросMCP.id;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗапросMCP.Свойство("jsonrpc")
		Или ЗапросMCP.jsonrpc <> "2.0" Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если Не ЗапросMCP.Свойство("method", ИмяМетода)
		Или ТипЗнч(ИмяМетода) <> Тип("Строка") Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьСписокИнструментов()
	
	Инструменты = Новый Массив;
	Реестр = КИИ_СерверMCPРеестр.ПолучитьРеестрИнструментов();
	
	Для Каждого ЗаписьРеестра Из Реестр Цикл
		
		Если ЗаписьРеестра.Схема = Неопределено Тогда
			Схема = Новый Структура;
		Иначе
			Схема = ЗаписьРеестра.Схема;
		КонецЕсли;
		
		Инструмент = Новый Структура;
		Инструмент.Вставить("name", ЗаписьРеестра.Имя);
		Инструмент.Вставить("description", ЗаписьРеестра.Описание);
		Инструмент.Вставить("inputSchema", Схема);
		Инструменты.Добавить(Инструмент);
		
	КонецЦикла;
	
	Возврат Новый Структура("tools", Инструменты);
	
КонецФункции

Функция ОбработатьВызовИнструмента(ЗапросMCP, Знач Идентификатор)
	
	ИмяИнструмента = "";
	Аргументы = Новый Структура;
	Если Не ПолучитьПараметрыВызоваИнструмента(ЗапросMCP, ИмяИнструмента, Аргументы) Тогда
		Возврат СформироватьОшибку(
			Идентификатор,
			-32602,
			НСтр("ru = 'Invalid params'"));
	КонецЕсли;
	
	Если Не ИнструментЗарегистрирован(ИмяИнструмента) Тогда
		Возврат СформироватьОшибку(
			Идентификатор,
			-32601,
			НСтр("ru = 'Tool not found'"));
	КонецЕсли;
	
	Попытка
		Данные = КИИ_СерверMCPРеестр.ВыполнитьИнструмент(ИмяИнструмента, Аргументы);
	Исключение
		ТекстВалидации = ТекстОшибкиВалидацииИнструмента(ИнформацияОбОшибке());
		Если ТекстВалидации = Неопределено Тогда
			ВызватьИсключение;
		КонецЕсли;
		Возврат СформироватьОшибку(
			Идентификатор,
			-32602,
			ТекстВалидации);
	КонецПопытки;
	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("tool", ИмяИнструмента);
	Результат.Вставить("data", Данные);
	Результат.Вставить("meta", МетаданныеВызова());
	
	Возврат СформироватьУспех(Идентификатор, Результат);
	
КонецФункции

Функция ПолучитьПараметрыВызоваИнструмента(ЗапросMCP, ИмяИнструмента, Аргументы)
	
	ИмяИнструмента = "";
	Аргументы = Новый Структура;
	Параметры = Неопределено;
	
	Если Не ЗапросMCP.Свойство("params", Параметры)
		Или ТипЗнч(Параметры) <> Тип("Структура") Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если Не Параметры.Свойство("name", ИмяИнструмента)
		Или ТипЗнч(ИмяИнструмента) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(ИмяИнструмента) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если Параметры.Свойство("arguments", Аргументы) Тогда
		
		Если Аргументы = Неопределено Тогда
			Аргументы = Новый Структура;
		КонецЕсли;
		
		Если ТипЗнч(Аргументы) <> Тип("Структура")
			И ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ИнструментЗарегистрирован(Знач ИмяИнструмента)
	
	Реестр = КИИ_СерверMCPРеестр.ПолучитьРеестрИнструментов();
	Возврат Реестр.Найти(ИмяИнструмента, "Имя") <> Неопределено;
	
КонецФункции

Функция МетаданныеВызова()
	
	ДанныеВызова = Новый Структура;
	ДанныеВызова.Вставить("server", "iikona-runtime-mcp");
	ДанныеВызова.Вставить("version", "0.1.0");
	ДанныеВызова.Вставить("timestamp", Формат(ТекущаяУниверсальнаяДата(), "ДФ='yyyy-MM-ddTHH:mm:ssZ'"));
	Возврат ДанныеВызова;
	
КонецФункции

Функция СформироватьУспех(Знач Идентификатор, Знач Результат)
	
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("result", Результат);
	Возврат Ответ;
	
КонецФункции

Функция СформироватьОшибку(Знач Идентификатор, Знач Код, Знач Сообщение, Знач ДополнительныеДанные = Неопределено)
	
	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	
	Если ДополнительныеДанные <> Неопределено Тогда
		Ошибка.Вставить("data", ДополнительныеДанные);
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("error", Ошибка);
	Возврат Ответ;
	
КонецФункции

Функция НоваяАудитМета()
	
	Мета = Новый Структура("Метод, Идентификатор, ПараметрыJSON", "", Неопределено, "");
	Мета.Вставить("КодРезультата", "");
	Возврат Мета;
	
КонецФункции

Функция РезультатСАудитом(Знач Ответ, Знач АудитМета)
	
	Результат = Новый Структура;
	Результат.Вставить("Ответ", Ответ);
	Результат.Вставить("АудитМета", АудитМета);
	Возврат Результат;
	
КонецФункции

// Заполняет метаданные аудита из разобранного запроса. Сериализация params
// изолирована Попыткой - ее сбой НЕ влияет на обработку запроса (дефект D4).
Процедура ЗаполнитьАудитМета(Знач ЗапросMCP, АудитМета)
	
	Если ТипЗнч(ЗапросMCP) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Значение = "";
	Если ЗапросMCP.Свойство("method", Значение) И ТипЗнч(Значение) = Тип("Строка") Тогда
		АудитМета.Метод = Значение;
	КонецЕсли;
	
	Если ЗапросMCP.Свойство("id", Значение) Тогда
		АудитМета.Идентификатор = Значение;
	КонецЕсли;
	
	Параметры = Неопределено;
	Если ЗапросMCP.Свойство("params", Параметры) И Параметры <> Неопределено Тогда
		Попытка
			АудитМета.ПараметрыJSON = ОбщегоНазначения.ЗначениеВJSON(СанитизироватьПараметрыДляАудита(Параметры));
		Исключение
			АудитМета.ПараметрыJSON = "";
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЗначениеКлюча(Знач Контейнер, Знач Ключ, Значение)
	
	Значение = Неопределено;
	Если ТипЗнч(Контейнер) = Тип("Структура") Тогда
		Возврат Контейнер.Свойство(Ключ, Значение);
	КонецЕсли;
	Если ТипЗнч(Контейнер) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение Из Контейнер Цикл
			Если КлючЗначение.Ключ = Ключ Тогда
				Значение = КлючЗначение.Значение;
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Функция КопироватьКлючи(Знач Контейнер)
	
	Если ТипЗнч(Контейнер) = Тип("Соответствие") Тогда
		КопияС = Новый Соответствие;
		Для Каждого КлючЗначение Из Контейнер Цикл
			КопияС.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		Возврат КопияС;
	КонецЕсли;
	Копия = Новый Структура;
	Для Каждого КлючЗначение Из Контейнер Цикл
		Копия.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Возврат Копия;
	
КонецФункции

// Аудит-санитизация: для tools/call execute_query заменяет arguments.query_text
// на sha256-хеш - секрет-литералы в тексте запроса не попадают в журнал аудита
// (дефект D2′: редакция по имени ключа не ловит содержимое query_text).
// Оригинальный ЗапросMCP НЕ мутируется (работаем по копиям); сбой изолирован.
Функция СанитизироватьПараметрыДляАудита(Знач Параметры)
	
	Попытка
		
		Если ТипЗнч(Параметры) <> Тип("Структура") И ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
			Возврат Параметры;
		КонецЕсли;
		
		ИмяИнструмента = Неопределено;
		Если Не ПолучитьЗначениеКлюча(Параметры, "name", ИмяИнструмента)
			Или ИмяИнструмента <> "execute_query" Тогда
			Возврат Параметры;
		КонецЕсли;
		
		Аргументы = Неопределено;
		Если Не ПолучитьЗначениеКлюча(Параметры, "arguments", Аргументы)
			Или (ТипЗнч(Аргументы) <> Тип("Структура") И ТипЗнч(Аргументы) <> Тип("Соответствие")) Тогда
			Возврат Параметры;
		КонецЕсли;
		
		ТекстЗапроса = Неопределено;
		Если Не ПолучитьЗначениеКлюча(Аргументы, "query_text", ТекстЗапроса) Тогда
			Возврат Параметры;
		КонецЕсли;
		
		Хешировщик = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хешировщик.Добавить(Строка(ТекстЗапроса));
		ХешЗапроса = "sha256:" + НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хешировщик.ХешСумма));
		
		НовыеАргументы = КопироватьКлючи(Аргументы);
		НовыеАргументы.Вставить("query_text", ХешЗапроса);
		НовыеПараметры = КопироватьКлючи(Параметры);
		НовыеПараметры.Вставить("arguments", НовыеАргументы);
		Возврат НовыеПараметры;
		
	Исключение
		Возврат Параметры;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

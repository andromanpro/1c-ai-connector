// Копирует текст средствами платформы в буфер обмена клиентского компьютера.
// Параметры:
//  Текст - Строка - текст для копирования.
// Возвращаемое значение:
//  Обещание - результат копирования (Булево); Ложь, если буфер недоступен.
Асинх Функция СкопироватьТекстВБуферОбмена(Знач Текст) Экспорт

	Если Не СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		Возврат Ложь;
	КонецЕсли;
	ФорматДанных = СтандартныйФорматДанныхБуфераОбмена.Текст;
	Если Не СредстваБуфераОбмена.ПоддерживаетсяФорматДанных(ФорматДанных) Тогда
		Возврат Ложь;
	КонецЕсли;
	Данные = Новый ЭлементБуфераОбмена(ФорматДанных, Текст);
	РезультатКопирования = Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(Данные);
	Возврат РезультатКопирования;

КонецФункции

// Возвращает идентификаторы выделенных диалогов; при пустом выделении использует текущую строку.
// Параметры:
//  Диалоги - ДанныеФормыКоллекция - строки списка собственных диалогов.
//  ВыделенныеСтроки - Массив - идентификаторы строк таблицы формы.
//  ТекущаяБеседа - ДанныеФормыЭлементКоллекции, Неопределено - текущая строка списка.
// Возвращаемое значение:
//  Массив из Строка - идентификаторы выбранных диалогов; устаревшее выделение вызывает исключение.
Функция ИдентификаторыДиалоговДляУдаления(Диалоги, ВыделенныеСтроки, ТекущаяБеседа) Экспорт

	Идентификаторы = Новый Массив;
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		Беседа = Диалоги.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Беседа = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Список диалогов изменился. Обновите его и повторите выделение.'");
		КонецЕсли;
		Идентификаторы.Добавить(Беседа.Диалог);
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 И ТекущаяБеседа <> Неопределено Тогда
		Идентификаторы.Добавить(ТекущаяБеседа.Диалог);
	КонецЕсли;
	Возврат Идентификаторы;

КонецФункции

#КонецОбласти

#КонецЕсли

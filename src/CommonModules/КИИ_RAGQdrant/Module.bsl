#Область ПрограммныйИнтерфейс

// Тест-обертка над УдалитьСтрокуОчереди (гвард коалесцирования) для paired-eval из YAxUnit.
//
// Параметры:
//  ФрагментUUID - Строка - идентификатор фрагмента (измерение очереди).
//  КодМодели - Строка - код модели эмбеддинга (измерение очереди).
//  НомерПоПорядкуСнимка - Число - НомерПоПорядку из снимка выборки (гвард против коалесцирования).
Процедура УдалитьСтрокуОчередиДляТестов(Знач ФрагментUUID, Знач КодМодели, Знач НомерПоПорядкуСнимка) Экспорт
	УдалитьСтрокуОчереди(ФрагментUUID, КодМодели, НомерПоПорядкуСнимка);
КонецПроцедуры

// Возвращает Истину, если активный бэкенд векторного поиска - Qdrant (внешний ANN).
// Дефолт (пустая константа) - Нативный.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоБэкендQdrant() Экспорт
	Возврат Константы.КИИ_БэкендВекторногоПоиска.Получить() = Перечисления.КИИ_БэкендыВекторногоПоиска.Qdrant;
КонецФункции

// Рантайм-доступность Qdrant (GET /readyz = 200). НЕ путать с ИндексПостроен (build-marker).
//
// Возвращаемое значение:
//  Булево
Функция QdrantДоступен() Экспорт
	Попытка
		Ответ = ВыполнитьЗапросQdrant("GET", "/readyz");
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Ответ.КодСостояния = 200;
КонецФункции

// Признак того, что индекс модели когда-либо полностью залит (build-marker из
// РегистрСведений.КИИ_ПоколениеИндексаQdrant). Стартовый гейт диспетчера (§8), НЕ рантайм.
//
// Параметры:
//  КодМодели - Строка - код модели эмбеддинга
//
// Возвращаемое значение:
//  Булево
Функция ИндексПостроен(Знач КодМодели) Экспорт
	Если РегламентныеЗаданияСервер.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		Возврат Ложь;
	КонецЕсли;
	ВычислитьTenantId();
	Отбор = Новый Структура("КодМодели", КодМодели);
	Данные = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.Получить(Отбор);
	Возврат Данные.ИндексПостроен = Истина;
КонецФункции

// Записывает build-marker поколения индекса модели (readiness-gate §8). Размерность коллекции
// сохраняется (ее пишет ОбеспечитьКоллекцию) - здесь не затирается.
//
// Параметры:
//  КодМодели      - Строка
//  ИндексПостроен - Булево - индекс полностью залит
//  Поколение      - Число, Неопределено - если задано, устанавливает; иначе инкремент
Процедура ОтметитьПоколение(Знач КодМодели, Знач ИндексПостроен, Знач Поколение = Неопределено) Экспорт
	ВычислитьTenantId();
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Блокировка = БлокировкаПоколения(КодМодели);
		Блокировка.Заблокировать();
		Отбор = Новый Структура("КодМодели", КодМодели);
		Текущее = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.Получить(Отбор);
		Если Поколение <> Неопределено Тогда
			НовоеПоколение = Поколение;
		Иначе
			ТекущееПоколение = 0;
			Если ЗначениеЗаполнено(Текущее.Поколение) Тогда
				ТекущееПоколение = Текущее.Поколение;
			КонецЕсли;
			// Индекс достроен - поколение фиксируем; иначе инкремент: читатели по старому
			// поколению должны увидеть, что индекс сменился и их снимок неактуален.
			Если ИндексПостроен Тогда
				НовоеПоколение = ТекущееПоколение;
			Иначе
				НовоеПоколение = ТекущееПоколение + 1;
			КонецЕсли;
		КонецЕсли;
	
		Запись = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.СоздатьМенеджерЗаписи();
		Запись.КодМодели = КодМодели;
		Запись.Поколение = НовоеПоколение;
		Запись.ИндексПостроен = ИндексПостроен;
		Запись.ДатаПостроения = ТекущаяДатаСеанса();
		Запись.Размерность = Текущее.Размерность;
		Запись.Записать();

		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Идентификатор экземпляра БСП одинаков в COM, клиенте и фоновых заданиях.
// Штатное подтверждение копии БСП меняет его; до решения администратора обращения
// к Qdrant блокируются. При смене контура прежние отметки готовности снимаются
// атомарно с записью кеша. После обновления на эту схему нужна пересборка индекса.
//
// Возвращаемое значение:
//  Строка - 16 hex-символов
Функция ВычислитьTenantId() Экспорт
	Ожидаемый = TenantИзОкружения();
	Если СокрЛП(Константы.КИИ_ИдентификаторTenantQdrant.Получить()) = Ожидаемый Тогда
		Возврат Ожидаемый;
	КонецЕсли;
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Константа.КИИ_ИдентификаторTenantQdrant");
		Блокировка.Добавить("РегистрСведений.КИИ_ПоколениеИндексаQdrant");
		Блокировка.Заблокировать();
		Если СокрЛП(Константы.КИИ_ИдентификаторTenantQdrant.Получить()) <> Ожидаемый Тогда
			СнятьГотовностьПрежнегоКонтура();
			Константы.КИИ_ИдентификаторTenantQdrant.Установить(Ожидаемый);
		КонецЕсли;
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Ожидаемый;
КонецФункции

// Имя коллекции = iikona_<tenant>_<provider>_<model>_<dim>_v<schema>, санировано [a-z0-9_] (§3).
// tenant разводит dev/prod-клоны на одном Qdrant; provider/model не смешивают эмбеддеры;
// dim фиксирует размерность; schema позволяет миграцию payload без коллизий.
//
// Параметры:
//  КодМодели   - Строка - напр. "openrouter:text-embedding-3-small"
//  Размерность - Число
//
// Возвращаемое значение:
//  Строка
Функция ИмяКоллекции(Знач КодМодели, Знач Размерность) Экспорт
	Части = Новый Массив;
	Части.Добавить("iikona");
	Части.Добавить(ВычислитьTenantId());
	Части.Добавить(СанироватьИмя(КодМодели));
	Части.Добавить(Формат(Размерность, "ЧГ=0"));
	Части.Добавить("v" + Формат(ВерсияСхемы(), "ЧГ=0"));
	Возврат СтрСоединить(Части, "_");
КонецФункции

// Детерминированный идентификатор точки для фрагмента: UUIDv5-подобный (SHA1 от namespace=tenant
// и name=UUID фрагмента) (§3). Идемпотентен, не коллизирует между клонами ИБ (разный tenant).
// point id необратим → uuid фрагмента дополнительно кладется в payload для rehydrate.
//
// Параметры:
//  ФрагментUUID - Строка - УникальныйИдентификатор ссылки фрагмента строкой
//
// Возвращаемое значение:
//  Строка - UUID-строка формата 8-4-4-4-12
Функция PointId(Знач ФрагментUUID) Экспорт
	Основа = ВычислитьTenantId() + ":" + СокрЛП(ФрагментUUID);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеширование.Добавить(Основа);
	Хекс = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
	Хекс = СтрЗаменить(СтрЗаменить(Хекс, " ", ""), Символы.ПС, "");
	Хекс = Лев(Хекс, 32);
	// Проставить версию (5) и вариант (10xx) как в RFC UUIDv5.
	Хекс = Лев(Хекс, 12) + "5" + Сред(Хекс, 14, 3) + ВариантныйНиббл(Сред(Хекс, 17, 1)) + Сред(Хекс, 18);
	Возврат Лев(Хекс, 8) + "-" + Сред(Хекс, 9, 4) + "-" + Сред(Хекс, 13, 4)
		+ "-" + Сред(Хекс, 17, 4) + "-" + Сред(Хекс, 21, 12);
КонецФункции

// Обеспечивает существование коллекции модели и payload-индексов (uuid для фрагмент/базаЗнаний,
// keyword для категория/политика) - ДО заливки (§3). Идемпотентно. Запоминает размерность
// коллекции в build-marker (нужна для delete, когда фрагмент уже удален).
//
// Решение по результату GET-проверки коллекции Qdrant: "create" (404), "exists" (2xx), "error" (иначе).
// Параметры:
//  КодСостояния - Число - HTTP-код ответа GET-проверки коллекции.
//  Успешно - Булево - успешен ли HTTP-запрос проверки коллекции.
// Возвращаемое значение:
//  Строка - решение: "create", "exists" или "error".
// Раньше любой не-404 трактовался как «коллекция есть» → при 5xx/таймауте/403 создание молча
// пропускалось, а последующие upsert падали на отсутствующей коллекции (аудит P3).
Функция РешениеПоПроверкеКоллекции(Знач КодСостояния, Знач Успешно) Экспорт
	Если КодСостояния = 404 Тогда
		Возврат "create";
	ИначеЕсли Успешно Тогда
		Возврат "exists";
	Иначе
		// 5xx / таймаут / 403: состояние коллекции неизвестно. Раньше любой не-404 считался
		// "коллекция есть" - создание молча пропускалось, upsert падал (аудит P3).
		Возврат "error";
	КонецЕсли;
КонецФункции

// Обеспечивает существование коллекции Qdrant для модели (создает при 404, иначе проверяет наличие).
// Параметры:
//  КодМодели - Строка - идентификатор модели эмбеддингов.
//  Размерность - Число - размерность вектора.
// Возвращаемое значение:
//  Строка - имя обеспеченной коллекции.
Функция ОбеспечитьКоллекцию(Знач КодМодели, Знач Размерность) Экспорт
	Имя = ИмяКоллекции(КодМодели, Размерность);
	Проверка = ВыполнитьЗапросQdrant("GET", "/collections/" + Имя);
	Решение = РешениеПоПроверкеКоллекции(Проверка.КодСостояния, Проверка.Успешно);
	Если Решение = "error" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Проверка коллекции Qdrant %1 не удалась: HTTP %2 %3'"),
			Имя, Проверка.КодСостояния, Проверка.Тело);
	КонецЕсли;
	Если Решение = "create" Тогда
		ТелоСоздания = Новый Структура;
		Векторы = Новый Структура;
		Векторы.Вставить("size", Размерность);
		Векторы.Вставить("distance", "Dot");
		ТелоСоздания.Вставить("vectors", Векторы);
		Создание = ВыполнитьЗапросQdrant("PUT", "/collections/" + Имя, ТелоСоздания);
		Если Не Создание.Успешно
			И Не КоллекцияСозданаДругимИсполнителем(Имя, Размерность, Создание.КодСостояния) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось создать коллекцию Qdrant %1: HTTP %2 %3'"),
				Имя, Создание.КодСостояния, Создание.Тело);
		КонецЕсли;
		СоздатьИндексПоля(Имя, "фрагмент", "uuid");
		СоздатьИндексПоля(Имя, "базаЗнаний", "uuid");
		СоздатьИндексПоля(Имя, "категория", "keyword");
		СоздатьИндексПоля(Имя, "политика", "keyword");
	КонецЕсли;
	ЗапомнитьРазмерностьКоллекции(КодМодели, Размерность);
	Возврат Имя;
КонецФункции

// Ставит операцию синхронизации в outbox (РегистрСведений.КИИ_ОчередьСинхронизацииQdrant).
// Вызывается ТОЛЬКО в той же транзакции, что и запись фрагмента (§5). Для upsert - только со
// свежим вектором. FIFO по НомерПоПорядку (миллисекунды универсальной даты). Т.к. измерения =
// (фрагмент, модель), повторный enqueue перезаписывает прежнюю операцию (коалесцирование): при
// стабильном point-id это корректно (последняя операция отражает целевое состояние точки).
//
// Параметры:
//  ФрагментUUID - Строка - идентификатор фрагмента строкой (переживает удаление ссылки)
//  КодМодели    - Строка
//  Операция     - Строка - "upsert" | "delete"
//  Хеш          - Строка - хеш текста, под который посчитан вектор (для upsert)
Процедура ПоставитьВОчередь(Знач ФрагментUUID, Знач КодМодели, Знач Операция, Знач Хеш = "") Экспорт
	КИИ_ОчередьQdrant.Поставить(ФрагментUUID, КодМодели, Операция, Хеш);
КонецПроцедуры

// Совместимый вход в ограниченный пакетный обработчик. HTTP выполняется вне транзакций.
// Исполнители владеют постоянными разделами; подтверждаются только актуальные версии.
// После десяти отказов задание ожидает повторной постановки.
Процедура ОбработатьОчередь() Экспорт
	КИИ_ОчередьQdrant.Обработать();
КонецПроцедуры

// Выбирает элементы очереди FIFO-батчем (ПЕРВЫЕ 256, УПОРЯДОЧИТЬ ПО НомерПоПорядку), исключая
// «ядовитые» строки (Попыток ≥ лимит), чтобы они не блокировали очередь. Вынесено из
// ОбработатьОчередь для тестируемости poison-exclusion и порядка (аудит: тест-гэп).
//
// Возвращаемое значение:
//  Массив из Структура - элементы очереди (ФрагментИдентификатор, КодМодели, Операция, Хеш,
//                        Попыток, НомерПоПорядку)
Функция ВыбратьЭлементыОчереди() Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛимитПопыток", ЛимитПопытокОчереди());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 256
		|	Очередь.ФрагментИдентификатор КАК ФрагментИдентификатор,
		|	Очередь.КодМодели КАК КодМодели,
		|	Очередь.Операция КАК Операция,
		|	Очередь.Хеш КАК Хеш,
		|	Очередь.Попыток КАК Попыток,
		|	Очередь.НомерПоПорядку КАК НомерПоПорядку
		|ИЗ
		|	РегистрСведений.КИИ_ОчередьСинхронизацииQdrant КАК Очередь
		|ГДЕ
		|	Очередь.Попыток < &ЛимитПопыток
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.НомерПоПорядку";
	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура("ФрагментИдентификатор, КодМодели, Операция",
			Выборка.ФрагментИдентификатор, Выборка.КодМодели, Выборка.Операция);
		Элемент.Вставить("Хеш", Выборка.Хеш);
		Элемент.Вставить("Попыток", Выборка.Попыток);
		Элемент.Вставить("НомерПоПорядку", Выборка.НомерПоПорядку);
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Поиск по вектору через Qdrant Query API (§6). Возвращает ту же структуру, что нативный
// КИИ_RAG.ПоискПоВектору. Rehydrate текста и re-check политики (ЗапрещеноВнешнее → исключить +
// enqueue delete) выполняется здесь; consumer-policy-check (ТолькоРФ vs чат-модель) - снаружи,
// перед подмешиванием (общая РазрешенФрагментДляМодели). Транспортные ошибки → APIОшибка (graceful).
//
// Параметры:
//  ЭмбеддингЗапроса - Массив из Число - нормализованный вектор запроса
//  Категории        - Массив из СправочникСсылка.КИИ_КатегорииЗнаний,
//                     СправочникСсылка.КИИ_КатегорииЗнаний, Неопределено - фильтр категорий
//  Топ              - Число
//  ПорогСходства    - Число - score_threshold, диапазон [-1,1] для Dot
//  КодМодели        - Строка
//  Размерность      - Число
//  ВладелецБаза     - СправочникСсылка.КИИ_БазаЗнаний, Неопределено - owner-фильтр.
//  ДопустимыеФрагменты - Массив из СправочникСсылка.КИИ_ФрагментыЗнаний, Неопределено - готовые фрагменты.
//
// Возвращаемое значение:
//  Структура - результат поиска:
//   * Знания - Массив из Структура - найденные фрагменты (Ссылка, Текст, Категория, Score)
//   * Статус - Строка - код статуса (ОК, НетИндекса, APIОшибка, ВсеНижеПорога)
//   * Диагностика - Строка - пояснение статуса
Функция Поиск(Знач ЭмбеддингЗапроса, Знач Категории, Знач Топ, Знач ПорогСходства,
	Знач КодМодели, Знач Размерность, Знач ВладелецБаза = Неопределено,
	Знач ДопустимыеФрагменты = Неопределено) Экспорт
	Имя = ИмяКоллекции(КодМодели, Размерность);
	Тело = ПостроитьТелоПоиска(ЭмбеддингЗапроса, Топ, ПорогСходства, Категории, ВладелецБаза, ДопустимыеФрагменты);

	Попытка
		Ответ = ВыполнитьЗапросQdrant("POST", "/collections/" + Имя + "/points/query", Тело);
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Qdrant недоступен: %1'"), ПредставлениеОшибки);
		Возврат РезультатПоиска("APIОшибка", ТекстОшибки);
	КонецПопытки;

	Если Ответ.КодСостояния = 404 Тогда
		Возврат РезультатПоиска("НетИндекса", НСтр("ru = 'Коллекция Qdrant не найдена'"));
	КонецЕсли;
	Если Не Ответ.Успешно Тогда
		Возврат РезультатПоиска("APIОшибка", СтрШаблон(НСтр("ru = 'Qdrant вернул HTTP %1'"), Ответ.КодСостояния));
	КонецЕсли;

	РазобранныйОтвет = КИИ_HTTPКлиент.JsonВСтруктуру(Ответ.Тело, Истина);
	Возврат РазобратьОтветПоиска(РазобранныйОтвет, КодМодели);
КонецФункции

// Строит тело запроса Qdrant Query API (чистая функция, тестируется на фикстуре).
//
// Параметры:
//  ЭмбеддингЗапроса - Массив из Число - вектор запроса
//  Топ              - Число
//  ПорогСходства    - Число
//  Категории        - Массив из СправочникСсылка.КИИ_КатегорииЗнаний,
//                     СправочникСсылка.КИИ_КатегорииЗнаний, Неопределено - фильтр категорий
//  ВладелецБаза     - СправочникСсылка.КИИ_БазаЗнаний, Неопределено - owner-фильтр.
//  ДопустимыеФрагменты - Массив из СправочникСсылка.КИИ_ФрагментыЗнаний, Неопределено - готовые фрагменты.
//
// Возвращаемое значение:
//  Структура - тело запроса Qdrant Query API:
//   * query - Массив из Число - вектор запроса
//   * limit - Число - максимум точек
//   * score_threshold - Число - порог score
//   * with_payload - Массив из Строка - имена полей payload
//   * filter - Структура - фильтр (опционально)
Функция ПостроитьТелоПоиска(Знач ЭмбеддингЗапроса, Знач Топ, Знач ПорогСходства,
	Знач Категории, Знач ВладелецБаза = Неопределено, Знач ДопустимыеФрагменты = Неопределено) Экспорт
	Тело = Новый Структура;
	Тело.Вставить("query", ЭмбеддингЗапроса);
	Тело.Вставить("limit", Топ);
	Тело.Вставить("score_threshold", ПорогСходства);

	СПолями = Новый Массив;
	СПолями.Добавить("базаЗнаний");
	СПолями.Добавить("категория");
	СПолями.Добавить("номер");
	СПолями.Добавить("политика");
	СПолями.Добавить("фрагмент");
	Тело.Вставить("with_payload", СПолями);

	Условия = Новый Массив;
	Если ВладелецБаза <> Неопределено И ЗначениеЗаполнено(ВладелецБаза) Тогда
		Условия.Добавить(УсловиеСовпадения("базаЗнаний", Строка(ВладелецБаза.УникальныйИдентификатор())));
	КонецЕсли;
	СписокКатегорий = ИдентификаторыКатегорий(Категории);
	Если СписокКатегорий.Количество() > 0 Тогда
		Совпадение = Новый Структура("any", СписокКатегорий);
		Условие = Новый Структура;
		Условие.Вставить("key", "категория");
		Условие.Вставить("match", Совпадение);
		Условия.Добавить(Условие);
	КонецЕсли;
	Если ДопустимыеФрагменты <> Неопределено Тогда
		Идентификаторы = Новый Массив;
		Для Каждого Фрагмент Из ДопустимыеФрагменты Цикл
			Идентификаторы.Добавить(Строка(Фрагмент.УникальныйИдентификатор()));
		КонецЦикла;
		СовпадениеФрагментов = Новый Структура("any", Идентификаторы);
		УсловиеФрагментов = Новый Структура("key, match", "фрагмент", СовпадениеФрагментов);
		Условия.Добавить(УсловиеФрагментов);
	КонецЕсли;
	Если Условия.Количество() > 0 Тогда
		Фильтр = Новый Структура("must", Условия);
		Тело.Вставить("filter", Фильтр);
	КонецЕсли;

	Возврат Тело;
КонецФункции

// Разбирает ответ Query API и читает данные найденных фрагментов одной порцией.
// Rehydrate текста и re-check политики - из 1С по payload.фрагмент (point id необратим, §6).
// Фрагмент удален / политика теперь ЗапрещеноВнешнее → исключается и ставится delete в очередь.
//
// Параметры:
//  Ответ     - Соответствие из КлючИЗначение - десериализованный JSON ответа Qdrant
//  КодМодели - Строка
//
// Возвращаемое значение:
//  Структура - результат поиска:
//   * Знания - Массив из Структура - найденные фрагменты (Ссылка, Текст, Категория, Score)
//   * Статус - Строка - код статуса
//   * Диагностика - Строка - пояснение статуса
Функция РазобратьОтветПоиска(Знач Ответ, Знач КодМодели) Экспорт
	Результат = РезультатПоиска("ОК", "");
	Точки = ТочкиИзОтвета(Ответ);
	Если Точки = Неопределено Тогда
		Результат.Статус = "APIОшибка";
		Результат.Диагностика = НСтр("ru = 'Неожиданный формат ответа Qdrant'");
		Возврат Результат;
	КонецЕсли;

	Фрагменты = ФрагментыПоUUID(ИдентификаторыТочек(Точки), Ложь);
	Для Каждого Точка Из Точки Цикл
		Payload = ЗначениеСоответствия(Точка, "payload");
		Если Payload = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ФрагментUUID = СтрокаИзСоответствия(Payload, "фрагмент");
		Если Не ЗначениеЗаполнено(ФрагментUUID) Тогда
			Продолжить;
		КонецЕсли;
		Фрагмент = Фрагменты.Получить(КлючФрагмента(ФрагментUUID));
		Если Фрагмент = Неопределено Тогда
			// Осиротевшая точка - фрагмент отсутствует в 1С: убрать из индекса.
			ПоставитьВОчередьБезопасно(ФрагментUUID, КодМодели, "delete");
			Продолжить;
		КонецЕсли;
		Если Не РазрешеноВИндексе(Фрагмент.ЭффективнаяПолитика) Тогда
			ПоставитьВОчередьБезопасно(ФрагментUUID, КодМодели, "delete");
			Продолжить;
		КонецЕсли;
		Запись = Новый Структура("Ссылка, Текст, Категория");
		Запись.Ссылка = Фрагмент.Ссылка;
		Запись.Текст = Фрагмент.ТекстФрагмента;
		Запись.Категория = Фрагмент.Категория;
		Запись.Вставить("Score", ЧислоИзСоответствия(Точка, "score"));
		Результат.Знания.Добавить(Запись);
	КонецЦикла;

	Если Результат.Знания.Количество() = 0 Тогда
		Если Точки.Количество() = 0 Тогда
			Результат.Статус = "ВсеНижеПорога";
			Результат.Диагностика = НСтр("ru = 'Совпадений выше порога не найдено'");
		Иначе
			// Qdrant вернул точки, но все отсеяны (осиротевшие/по политике) - это НЕ «ниже порога» (аудит P3).
			Результат.Статус = "ВсеОтфильтрованы";
			Результат.Диагностика = НСтр("ru = 'Совпадения есть, но все отфильтрованы (осиротевшие или по политике)'");
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Consumer-policy-check (§7): можно ли подмешать фрагмент данной политики в чат-модель данного
// класса egress. ТолькоРФ-контент - лишь в модель РФ-класса; ЗапрещеноВнешнее - никогда.
// Общая для обоих бэкендов (native + Qdrant), применяется перед ПодмешатьКонтекст.
//
// Параметры:
//  ПолитикаФрагмента     - ПеречислениеСсылка.КИИ_ПолитикиЭмбеддинга
//  КлассEgressЧатМодели  - ПеречислениеСсылка.КИИ_ПолитикиЭмбеддинга - класс egress чат-модели
//
// Возвращаемое значение:
//  Булево
Функция РазрешенФрагментДляМодели(Знач ПолитикаФрагмента, Знач КлассEgressЧатМодели) Экспорт
	Если ПолитикаФрагмента = Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПолитикаФрагмента = Перечисления.КИИ_ПолитикиЭмбеддинга.ТолькоРФ Тогда
		Возврат КлассEgressЧатМодели = Перечисления.КИИ_ПолитикиЭмбеддинга.ТолькоРФ;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Санирует компонент имени коллекции до [a-z0-9_] (нижний регистр, прочее → "_").
//
// Параметры:
//  Значение - Строка
//
// Возвращаемое значение:
//  Строка
Функция СанироватьИмя(Знач Значение) Экспорт
	Исходная = НРег(СокрЛП(Значение));
	Разрешено = "abcdefghijklmnopqrstuvwxyz0123456789_";
	Результат = "";
	Для Позиция = 1 По СтрДлина(Исходная) Цикл
		Символ = Сред(Исходная, Позиция, 1);
		Результат = Результат + ?(СтрНайти(Разрешено, Символ) > 0, Символ, "_");
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Пересборка коллекции модели в blue-green (§5): поднимает поколение и закрывает readiness-gate
// на время пересборки (диспетчер уходит в native - стартовый гейт, не рантайм-fallback), затем
// заполняет заново и открывает гейт. MVP: пересборка в ту же коллекцию (одна модель).
//
// Параметры:
//  КодМодели   - Строка
//  Размерность - Число
//
// Возвращаемое значение:
//  Структура - счетчики заливки:
//   * Залито - Число - успешно залито точек
//   * Всего - Число - всего фрагментов модели
Функция ПересобратьКоллекцию(Знач КодМодели, Знач Размерность) Экспорт
	Возврат КИИ_ОчередьQdrant.ПересобратьМодель(КодМодели, Размерность);
КонецФункции

// Reconciliation (§5): проходит точки Qdrant по коллекции модели, удаляет осиротевшие (фрагмент
// отсутствует в 1С / на удаление / политика ЗапрещеноВнешнее); пропуски (эмбедденные фрагменты
// 1С без точки) ставит на upsert. MVP-скан ≤256 через scroll.
//
// Параметры:
//  КодМодели   - Строка
//  Размерность - Число
//
// Возвращаемое значение:
//  Структура - счетчики сверки:
//   * Удалено - Число - осиротевших точек поставлено на удаление
//   * Поставлено - Число - пропущенных фрагментов поставлено на upsert
Функция Сверить(Знач КодМодели, Знач Размерность) Экспорт
	Имя = ИмяКоллекции(КодМодели, Размерность);
	Удалено = ПоставитьУдаленияОсиротевшихТочек(КодМодели, Имя);
	Поставлено = 0;

	// Пропуски: эмбедденные фрагменты модели без флага в очереди - поставить upsert.
	Выборка = ФрагментыМодели(КодМодели);
	Пока Выборка.Следующий() Цикл
		Если РазрешеноВИндексе(Выборка.ЭффективнаяПолитика) Тогда
			ПоставитьВОчередьБезопасно(Строка(Выборка.Ссылка.УникальныйИдентификатор()),
				КодМодели, "upsert", Выборка.ХешТекстаФрагмента);
			Поставлено = Поставлено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Удалено, Поставлено", Удалено, Поставлено);
КонецФункции

// Reconciliation по всем моделям с построенным индексом (parameterless - для регламентного
// задания; сам Сверить требует КодМодели/Размерность). Затем осушает очередь.
// std436 п. 2: порционное чтение по модели. Каждая коллекция сверяется отдельно,
// ее выборка обходится последовательно; векторы всех моделей в памяти не собираются.
// Проверка двух моделей: Тесты_КИИ_ПакетноеЧтение.Сверка_НесколькоМоделейИОсиротевшиеТочки.
// @skip-check query-in-loop
Процедура СверитьВсе() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоколенияИндекса.КодМодели КАК КодМодели,
		|	ПоколенияИндекса.Размерность КАК Размерность
		|ИЗ
		|	РегистрСведений.КИИ_ПоколениеИндексаQdrant КАК ПоколенияИндекса
		|ГДЕ
		|	ПоколенияИндекса.ИндексПостроен
		|	И ПоколенияИндекса.Размерность > 0";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сверить(Выборка.КодМодели, Выборка.Размерность);
	КонецЦикла;
	ОбработатьОчередь();
КонецПроцедуры

// Единственная точка HTTP к Qdrant (seam §4/§11). Тестируется на фикстуре. Собирает URL из
// константы-адреса + путь, добавляет api-key из БезопасногоХранилища (если задан), таймаут 5с.
//
// Параметры:
//  Метод - Строка - GET | PUT | POST | DELETE
//  Путь  - Строка - напр. "/collections/x/points/query"
//  Тело  - Структура, Соответствие из КлючИЗначение, Строка, Неопределено - тело запроса
//
// Возвращаемое значение:
//  Структура - результат HTTP-запроса:
//   * КодСостояния - Число - HTTP-код ответа
//   * Тело - Строка - тело ответа
//   * Заголовки - Соответствие из КлючИЗначение - заголовки ответа
//   * Успешно - Булево - Истина при коде 2xx
Функция ВыполнитьЗапросQdrant(Знач Метод, Знач Путь, Знач Тело = Неопределено) Экспорт
	Если РегламентныеЗаданияСервер.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		ВызватьИсключение НСтр("ru = 'Работа с Qdrant запрещена блокировкой внешних ресурсов БСП.'");
	КонецЕсли;
	URL = АдресQdrant() + Путь;
	Заголовки = Новый Соответствие;
	Ключ = КлючAPI();
	Если ЗначениеЗаполнено(Ключ) Тогда
		Заголовки.Вставить("api-key", Ключ);
	КонецЕсли;
	Возврат КИИ_HTTPКлиент.ВыполнитьЗапрос(Метод, URL, Тело, Заголовки, ТаймаутПодключения(), ПрямоеСоединение());
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Порционное чтение очереди: разрешенные векторы распаковывает исполнитель по одному.
// Параметры:
//  Идентификаторы - Массив из Строка - идентификаторы фрагментов.
//  СВектором - Булево - читать хранилище вектора без распаковки.
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - сведения фрагментов по идентификатору.
Функция ПрочитатьФрагментыОчереди(Знач Идентификаторы, Знач СВектором) Экспорт
	Возврат ФрагментыПоUUID(Идентификаторы, СВектором, Ложь, Ложь);
КонецФункции

// Параметры:
//  КодМодели - Строка - код модели индекса.
// Возвращаемое значение:
//  Число - сохраненная размерность коллекции либо 0.
Функция РазмерностьДляОчереди(Знач КодМодели) Экспорт
	Возврат РазмерностьКоллекции(КодМодели);
КонецФункции

// Параметры:
//  ФрагментUUID - Строка - идентификатор фрагмента.
//  Фрагмент - Структура - разрешенный фрагмент с распакованным вектором:
//   * Вектор - Массив из Число - проверенный непустой вектор.
//   * Владелец - СправочникСсылка.КИИ_БазаЗнаний - владелец фрагмента.
//   * Категория - СправочникСсылка.КИИ_КатегорииЗнаний, Неопределено - категория.
//   * НомерФрагмента - Число - номер в базе знаний.
//   * ХешТекстаФрагмента - Строка - хеш текста.
//   * ЭффективнаяПолитика - ПеречислениеСсылка.КИИ_ПолитикиЭмбеддинга - действующая политика.
// Возвращаемое значение:
//  Структура:
//   * id - Строка - идентификатор точки Qdrant.
//   * vector - Массив из Число - вектор фрагмента.
//   * payload - Структура:
//     ** фрагмент - Строка - идентификатор фрагмента.
//     ** базаЗнаний - Строка - идентификатор владельца.
//     ** категория - Строка - идентификатор категории.
//     ** номер - Число - номер фрагмента.
//     ** хеш - Строка - хеш текста.
//     ** политика - Строка - код политики внешней отправки.
Функция ТочкаДляОчереди(Знач ФрагментUUID, Знач Фрагмент) Экспорт
	Возврат ТочкаИзФрагмента(ФрагментUUID, Фрагмент);
КонецФункции

// Параметры:
//  КодМодели - Строка - код модели индекса.
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - ссылки и хеши фрагментов без чтения векторов.
Функция ФрагментыМоделиДляОчереди(Знач КодМодели) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КодМодели", КодМодели);
	Запрос.Текст =
		"ВЫБРАТЬ Фрагменты.Ссылка КАК Ссылка,
		| Фрагменты.ХешТекстаФрагмента КАК ХешТекстаФрагмента
		|ИЗ Справочник.КИИ_ФрагментыЗнаний КАК Фрагменты
		|ГДЕ Фрагменты.КодМоделиЭмбеддинга = &КодМодели И НЕ Фрагменты.ПометкаУдаления";
	Возврат Запрос.Выполнить().Выбрать();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Первое заполнение штатного идентификатора сериализуется между координаторами.
// Возвращаемое значение:
//  Строка - идентификатор экземпляра информационной базы БСП.
Функция ИдентификаторЭкземпляраБСП()
	Если ЗначениеЗаполнено(Константы.ИдентификаторИнформационнойБазы.Получить()) Тогда
		Возврат СтандартныеПодсистемыСервер.ИдентификаторИнформационнойБазы();
	КонецЕсли;
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Константа.ИдентификаторИнформационнойБазы");
		Блокировка.Заблокировать();
		ИдентификаторБазы = СтандартныеПодсистемыСервер.ИдентификаторИнформационнойБазы();
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат ИдентификаторБазы;
КонецФункции

// Вызывается под блокировкой всего регистра при смене экземпляра или схемы контура.
// Размерности сохраняются для повторной отправки удалений; готовность требует пересборки.
Процедура СнятьГотовностьПрежнегоКонтура()
	Поколения = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.СоздатьНаборЗаписей();
	Поколения.Прочитать();
	Изменены = Ложь;
	Для Каждого Поколение Из Поколения Цикл
		Если Поколение.ИндексПостроен Тогда
			Поколение.ИндексПостроен = Ложь;
			Поколение.Поколение = Поколение.Поколение + 1;
			Поколение.ДатаПостроения = ТекущаяДатаСеанса();
			Изменены = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Изменены Тогда
		Поколения.Записать(РежимЗамещения.Обновление);
	КонецЕсли;
КонецПроцедуры

// Фаза удаления сверки: ставит delete для осиротевших точек Qdrant (фрагмент
// не найден в 1С либо запрещен egress-политикой). Возвращает число поставленных удалений.
// Параметры:
//  КодМодели - Строка - код модели, для которой ставятся удаления.
//  Имя - Строка - имя коллекции Qdrant для чтения точек.
// Возвращаемое значение:
//  Число - количество точек, для которых запрошено удаление из индекса.
Функция ПоставитьУдаленияОсиротевшихТочек(Знач КодМодели, Знач Имя)

	Удалено = 0;

	ТелоScroll = Новый Структура;
	ТелоScroll.Вставить("limit", 256);
	СПолями = Новый Массив;
	СПолями.Добавить("фрагмент");
	ТелоScroll.Вставить("with_payload", СПолями);
	Ответ = ВыполнитьЗапросQdrant("POST", "/collections/" + Имя + "/points/scroll", ТелоScroll);
	Если Не Ответ.Успешно Тогда
		Возврат Удалено;
	КонецЕсли;

	Разобрано = КИИ_HTTPКлиент.JsonВСтруктуру(Ответ.Тело, Истина);
	Результат = ЗначениеСоответствия(Разобрано, "result");
	Точки = ?(Результат = Неопределено, Неопределено, ЗначениеСоответствия(Результат, "points"));
	Если ТипЗнч(Точки) <> Тип("Массив") Тогда
		Возврат Удалено;
	КонецЕсли;

	Фрагменты = ФрагментыПоUUID(ИдентификаторыТочек(Точки), Ложь, Истина);
	Для Каждого Точка Из Точки Цикл
		Payload = ЗначениеСоответствия(Точка, "payload");
		ФрагментUUID = ?(Payload = Неопределено, "", СтрокаИзСоответствия(Payload, "фрагмент"));
		Фрагмент = ?(ЗначениеЗаполнено(ФрагментUUID), Фрагменты.Получить(КлючФрагмента(ФрагментUUID)), Неопределено);
		Если Фрагмент = Неопределено Или Не РазрешеноВИндексе(Фрагмент.ЭффективнаяПолитика) Тогда
			ПоставитьВОчередьБезопасно(ФрагментUUID, КодМодели, "delete");
			Удалено = Удалено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Удалено;

КонецФункции

// Контур экземпляра БСП не зависит от представления адреса кластера или компьютера потока.
// Возвращаемое значение:
//  Строка - первые 16 шестнадцатеричных символов хеша идентификатора экземпляра БСП.
Функция TenantИзОкружения()
	ИдентификаторБазы = ИдентификаторЭкземпляраБСП();
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить("iikona-instance-v2|" + НРег(СокрЛП(ИдентификаторБазы)));
	Хекс = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
	Хекс = СтрЗаменить(СтрЗаменить(Хекс, " ", ""), Символы.ПС, "");
	Возврат Лев(Хекс, 16);
КонецФункции

// Отображает исходный ниббл в вариант UUID (10xx → hex 8..b), сохраняя 2 бита энтропии.
// Параметры:
//  Символ - Строка - шестнадцатеричный символ; неизвестное значение соответствует варианту 8.
// Возвращаемое значение:
//  Строка - один символ варианта UUID: 8, 9, a или b.
Функция ВариантныйНиббл(Знач Символ)
	Значения = "0123456789abcdef";
	Индекс = СтрНайти(Значения, НРег(Символ)) - 1;
	Если Индекс < 0 Тогда
		Индекс = 0;
	КонецЕсли;
	Варианты = "89ab";
	Возврат Сред(Варианты, (Индекс % 4) + 1, 1);
КонецФункции

Функция АдресQdrant()
	Адрес = СокрЛП(Константы.КИИ_QdrantАдрес.Получить());
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		// Стандартный локальный Qdrant; свой сервер задается константой КИИ_QdrantАдрес.
		// BSLLS:UsingHardcodeNetworkAddress-off
		Адрес = "http://localhost:6333";
		// BSLLS:UsingHardcodeNetworkAddress-on
	КонецЕсли;
	Пока СтрДлина(Адрес) > 0 И Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Возврат Адрес;
КонецФункции

Функция ТаймаутПодключения()
	// NAS-хранилище Qdrant: create/delete коллекции наблюдались 20-37с (медленный I/O тома);
	// GET/query - миллисекунды. Таймаут с запасом под структурные операции; readiness-gate
	// (QdrantДоступен по /readyz) отсекает реально мертвый Qdrant до тяжелых вызовов.
	Возврат 90;
КонецФункции

// Прямое соединение (без системного прокси). Qdrant - LAN, а системный SOCKS-прокси (xkeen)
// дропает PUT/DELETE (проверено: через SOCKS 127.0.0.1:10808 GET проходит, PUT/DELETE таймаутят).
// Системный прокси нужен только для внешних вызовов (OpenRouter) - они идут своим путем.
// Возвращаемое значение:
//  ИнтернетПрокси - настройки без системного прокси для прямого обращения к Qdrant.
Функция ПрямоеСоединение()
	Возврат Новый ИнтернетПрокси(Ложь);
КонецФункции

Функция ЛимитПопытокОчереди()
	Возврат 10;
КонецФункции

Функция ВерсияСхемы()
	Значение = Константы.КИИ_ВерсияСхемыQdrant.Получить();
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, 1);
КонецФункции

Функция КлючAPI()
	Возврат ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("КИИ_RAGQdrant", "КлючAPI");
КонецФункции

Функция РезультатПоиска(Знач Статус, Знач Диагностика)
	Результат = Новый Структура;
	Результат.Вставить("Знания", Новый Массив);
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("Диагностика", Диагностика);
	Возврат Результат;
КонецФункции

Функция УсловиеСовпадения(Знач Ключ, Знач Значение)
	Совпадение = Новый Структура("value", Значение);
	Условие = Новый Структура;
	Условие.Вставить("key", Ключ);
	Условие.Вставить("match", Совпадение);
	Возврат Условие;
КонецФункции

Функция ИдентификаторыКатегорий(Знач Категории)
	Результат = Новый Массив;
	Если Категории = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Категории) = Тип("Массив") Тогда
		Для Каждого Категория Из Категории Цикл
			Если ЗначениеЗаполнено(Категория) Тогда
				Результат.Добавить(Строка(Категория.УникальныйИдентификатор()));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(Категории) Тогда
		Результат.Добавить(Строка(Категории.УникальныйИдентификатор()));
	Иначе
		// Категории не заданы (пустая ссылка / Неопределено) - фильтра по категориям нет.
		Возврат Результат;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция РазрешеноВИндексе(Знач ЭффективнаяПолитика)
	Возврат ЭффективнаяПолитика <> Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
КонецФункции

Функция ТочкиИзОтвета(Знач Ответ)
	Результат = ЗначениеСоответствия(Ответ, "result");
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Точки = ЗначениеСоответствия(Результат, "points");
	Если ТипЗнч(Точки) = Тип("Массив") Тогда
		Возврат Точки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЗначениеСоответствия(Знач Источник, Знач Ключ)
	Если ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Возврат Источник.Получить(Ключ);
	ИначеЕсли ТипЗнч(Источник) = Тип("Структура") И Источник.Свойство(Ключ) Тогда
		Возврат Источник[Ключ];
	Иначе
		// Не JSON-объект либо нет такого ключа - значения нет.
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция СтрокаИзСоответствия(Знач Источник, Знач Ключ)
	Значение = ЗначениеСоответствия(Источник, Ключ);
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

Функция ЧислоИзСоответствия(Знач Источник, Знач Ключ)
	Значение = ЗначениеСоответствия(Источник, Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);
КонецФункции

// Читает фрагмент по UUID строкой: ссылка, текст, категория (через владельца), эффективная
// политика, хеш, вектор. Возвращает Неопределено, если фрагмента нет или он помечен на удаление.

// Читает уникальные фрагменты одним запросом; удаленные и неверные UUID исключаются.
// Параметры:
//  Идентификаторы - Массив из Строка - UUID фрагментов.
//  СВектором - Булево - читать и раскрывать хранилище вектора.
//  ТолькоПолитика - Булево - читать только ссылку и эффективную политику без содержимого.
//  РаспаковыватьВектор - Булево - извлекать массив из хранилища; иначе передавать хранилище исполнителю.
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - нормализованный UUID существующего фрагмента.
//   * Значение - Структура - данные фрагмента для проверки политики и формирования результата.
Функция ФрагментыПоUUID(Знач Идентификаторы, Знач СВектором, Знач ТолькоПолитика = Ложь,
	Знач РаспаковыватьВектор = Истина)
	Результат = Новый Соответствие;
	Ссылки = Новый Массив;
	УникальныеИдентификаторы = Новый Соответствие;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Ключ = КлючФрагмента(Идентификатор);
		Если ПустаяСтрока(Ключ) Или УникальныеИдентификаторы[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УникальныеИдентификаторы.Вставить(Ключ, Истина);
		Ссылки.Добавить(Справочники.КИИ_ФрагментыЗнаний.ПолучитьСсылку(Новый УникальныйИдентификатор(Ключ)));
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Фрагменты.Ссылка КАК Ссылка,
		|	Фрагменты.ТекстФрагмента КАК ТекстФрагмента,
		|	Фрагменты.ХешТекстаФрагмента КАК ХешТекстаФрагмента,
		|	Фрагменты.КодМоделиЭмбеддинга КАК КодМоделиЭмбеддинга,
		|	ЕСТЬNULL(База.ПометкаУдаления, ИСТИНА) КАК БазаПомеченаУдаления,
		|	Фрагменты.НомерФрагмента КАК НомерФрагмента,
		|	Фрагменты.Эмбеддинг КАК Эмбеддинг,
		|	Фрагменты.Владелец КАК Владелец,
		|	ЕСТЬNULL(База.Категория, ЗНАЧЕНИЕ(Справочник.КИИ_КатегорииЗнаний.ПустаяСсылка)) КАК Категория,
		|	ЕСТЬNULL(
		|		ВЫБОР
		|			КОГДА ЕСТЬNULL(База.ПометкаУдаления, ИСТИНА)
		|				ТОГДА ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее)
		|			КОГДА База.ПолитикаЭмбеддингаПереопределение
		|					<> ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ПустаяСсылка)
		|				ТОГДА База.ПолитикаЭмбеддингаПереопределение
		|			КОГДА База.Категория = ЗНАЧЕНИЕ(Справочник.КИИ_КатегорииЗнаний.ПустаяСсылка)
		|				ТОГДА ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ПустаяСсылка)
		|			ИНАЧЕ ЕСТЬNULL(КатегорияЗнаний.ПолитикаЭмбеддинга,
		|				ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее))
		|		КОНЕЦ,
		|		ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее)) КАК ЭффективнаяПолитика
		|ИЗ
		|	Справочник.КИИ_ФрагментыЗнаний КАК Фрагменты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КИИ_БазаЗнаний КАК База
		|		ПО Фрагменты.Владелец = База.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КИИ_КатегорииЗнаний КАК КатегорияЗнаний
		|		ПО ЕСТЬNULL(База.Категория,
		|			ЗНАЧЕНИЕ(Справочник.КИИ_КатегорииЗнаний.ПустаяСсылка)) = КатегорияЗнаний.Ссылка
		|ГДЕ
		|	Фрагменты.Ссылка В (&Ссылки)
		|	И НЕ Фрагменты.ПометкаУдаления";
	Если Не СВектором Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Фрагменты.Эмбеддинг КАК Эмбеддинг", "NULL КАК Эмбеддинг");
	КонецЕсли;
	// Для осиротевших точек нужны только ссылка и политика: текст и вектор не читаются.
	Если ТолькоПолитика Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"Фрагменты.ТекстФрагмента КАК ТекстФрагмента", "NULL КАК ТекстФрагмента");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"Фрагменты.ХешТекстаФрагмента КАК ХешТекстаФрагмента", "NULL КАК ХешТекстаФрагмента");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"Фрагменты.НомерФрагмента КАК НомерФрагмента", "NULL КАК НомерФрагмента");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"Фрагменты.Владелец КАК Владелец", "NULL КАК Владелец");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ЕСТЬNULL(База.Категория, ЗНАЧЕНИЕ(Справочник.КИИ_КатегорииЗнаний.ПустаяСсылка)) КАК Категория",
			"NULL КАК Категория");
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура;
		Данные.Вставить("Ссылка", Выборка.Ссылка);
		Данные.Вставить("ТекстФрагмента", Выборка.ТекстФрагмента);
		Данные.Вставить("ХешТекстаФрагмента", Выборка.ХешТекстаФрагмента);
		Данные.Вставить("НомерФрагмента", Выборка.НомерФрагмента);
		Данные.Вставить("Владелец", Выборка.Владелец);
		Данные.Вставить("Категория", Выборка.Категория);
		Данные.Вставить("ЭффективнаяПолитика", Выборка.ЭффективнаяПолитика);
		Данные.Вставить("КодМоделиЭмбеддинга", Выборка.КодМоделиЭмбеддинга);
		Данные.Вставить("БазаПомеченаУдаления", Выборка.БазаПомеченаУдаления);
		Если СВектором И Не РаспаковыватьВектор Тогда
			Данные.Вставить("ХранилищеВектора", Выборка.Эмбеддинг);
			Данные.Вставить("Вектор", Неопределено);
		Иначе
			Данные.Вставить("Вектор", ?(СВектором, ВекторИзХранилища(Выборка.Эмбеддинг), Неопределено));
		КонецЕсли;
		Результат.Вставить(Строка(Выборка.Ссылка.УникальныйИдентификатор()), Данные);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Нормализует UUID без чтения информационной базы; неверное значение дает пустую строку.
// Параметры:
//  Идентификатор - Строка - UUID фрагмента, возможно с пробелами по краям.
// Возвращаемое значение:
//  Строка - нормализованный UUID либо пустая строка при неверном значении.
Функция КлючФрагмента(Знач Идентификатор)
	Попытка
		Возврат Строка(Новый УникальныйИдентификатор(СокрЛП(Идентификатор)));
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Собирает UUID из полученной порции точек; отсутствие payload не является ошибкой.
// Параметры:
//  Точки - Массив из Соответствие - точки ответа Qdrant с необязательным payload.
// Возвращаемое значение:
//  Массив из Строка - идентификаторы из payload; отсутствие поля дает пустую строку.
Функция ИдентификаторыТочек(Знач Точки)
	Идентификаторы = Новый Массив;
	Для Каждого Точка Из Точки Цикл
		Payload = ЗначениеСоответствия(Точка, "payload");
		Если Payload <> Неопределено Тогда
			Идентификаторы.Добавить(СтрокаИзСоответствия(Payload, "фрагмент"));
		КонецЕсли;
	КонецЦикла;
	Возврат Идентификаторы;
КонецФункции

Функция ВекторИзХранилища(Знач Хранилище)
	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вектор = Хранилище.Получить();
	Если ТипЗнч(Вектор) = Тип("Массив") И Вектор.Количество() > 0 Тогда
		Возврат Вектор;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Выборка эмбедденных фрагментов модели (для пересборки / сверки).
// Параметры:
//  КодМодели - Строка - код модели эмбеддинга для отбора действующих фрагментов.
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - фрагменты с текстом, вектором, владельцем, категорией и политикой.
//  Отсутствующий или помеченный владелец и неизвестная наследуемая политика запрещают индексацию.
Функция ФрагментыМодели(Знач КодМодели)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КодМодели", КодМодели);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Фрагменты.Ссылка КАК Ссылка,
		|	Фрагменты.ТекстФрагмента КАК ТекстФрагмента,
		|	Фрагменты.ХешТекстаФрагмента КАК ХешТекстаФрагмента,
		|	Фрагменты.НомерФрагмента КАК НомерФрагмента,
		|	Фрагменты.Эмбеддинг КАК Эмбеддинг,
		|	Фрагменты.Владелец КАК Владелец,
		|	ЕСТЬNULL(База.Категория, ЗНАЧЕНИЕ(Справочник.КИИ_КатегорииЗнаний.ПустаяСсылка)) КАК Категория,
		|	ЕСТЬNULL(
		|		ВЫБОР
		|			КОГДА ЕСТЬNULL(База.ПометкаУдаления, ИСТИНА)
		|				ТОГДА ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее)
		|			КОГДА База.ПолитикаЭмбеддингаПереопределение
		|					<> ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ПустаяСсылка)
		|				ТОГДА База.ПолитикаЭмбеддингаПереопределение
		|			КОГДА База.Категория = ЗНАЧЕНИЕ(Справочник.КИИ_КатегорииЗнаний.ПустаяСсылка)
		|				ТОГДА ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ПустаяСсылка)
		|			ИНАЧЕ ЕСТЬNULL(КатегорияЗнаний.ПолитикаЭмбеддинга,
		|				ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее))
		|		КОНЕЦ,
		|		ЗНАЧЕНИЕ(Перечисление.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее)) КАК ЭффективнаяПолитика
		|ИЗ
		|	Справочник.КИИ_ФрагментыЗнаний КАК Фрагменты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КИИ_БазаЗнаний КАК База
		|		ПО Фрагменты.Владелец = База.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КИИ_КатегорииЗнаний КАК КатегорияЗнаний
		|		ПО ЕСТЬNULL(База.Категория,
		|			ЗНАЧЕНИЕ(Справочник.КИИ_КатегорииЗнаний.ПустаяСсылка)) = КатегорияЗнаний.Ссылка
		|ГДЕ
		|	Фрагменты.КодМоделиЭмбеддинга = &КодМодели
		|	И НЕ Фрагменты.ПометкаУдаления";
	Возврат Запрос.Выполнить().Выбрать();
КонецФункции

// Размерность коллекции модели: из build-marker (запомнена при ОбеспечитьКоллекцию), иначе
// из живого фрагмента. Нужна для delete, когда фрагмент уже удален (иначе имя коллекции не собрать).
// Параметры:
//  КодМодели - Строка - код модели коллекции.
// Возвращаемое значение:
//  Число - сохраненная размерность либо размерность фрагмента модели; 0, если она неизвестна.
Функция РазмерностьКоллекции(Знач КодМодели)
	Отбор = Новый Структура("КодМодели", КодМодели);
	Данные = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.Получить(Отбор);
	Если ЗначениеЗаполнено(Данные.Размерность) Тогда
		Возврат Данные.Размерность;
	КонецЕсли;
	Возврат РазмерностьМодели(КодМодели);
КонецФункции

Функция РазмерностьМодели(Знач КодМодели)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КодМодели", КодМодели);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Фрагменты.Размерность КАК Размерность
		|ИЗ
		|	Справочник.КИИ_ФрагментыЗнаний КАК Фрагменты
		|ГДЕ
		|	Фрагменты.КодМоделиЭмбеддинга = &КодМодели
		|	И Фрагменты.Размерность > 0";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Размерность, 0);
КонецФункции

// Запоминает размерность коллекции модели в build-marker (для delete-пути), сохраняя прочие поля.
// Параметры:
//  КодМодели - Строка - код модели коллекции.
//  Размерность - Число - размерность обеспеченной коллекции Qdrant.
Процедура ЗапомнитьРазмерностьКоллекции(Знач КодМодели, Знач Размерность)
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Блокировка = БлокировкаПоколения(КодМодели);
		Блокировка.Заблокировать();
		Отбор = Новый Структура("КодМодели", КодМодели);
		Текущее = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.Получить(Отбор);
		Запись = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.СоздатьМенеджерЗаписи();
		Запись.КодМодели = КодМодели;
		Запись.Поколение = Текущее.Поколение;
		Запись.ИндексПостроен = Текущее.ИндексПостроен;
		Запись.ДатаПостроения = Текущее.ДатаПостроения;
		Запись.Размерность = Размерность;
		Запись.Записать();

		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Строит точку Qdrant: id (UUIDv5) + вектор + payload без текста (§6).
// Параметры:
//  ФрагментUUID - Строка - идентификатор фрагмента.
//  Фрагмент - Структура:
//   * Вектор - Массив из Число - проверенный непустой вектор.
//   * Владелец - СправочникСсылка.КИИ_БазаЗнаний - владелец фрагмента.
//   * Категория - СправочникСсылка.КИИ_КатегорииЗнаний, Неопределено - категория.
//   * НомерФрагмента - Число - номер в базе знаний.
//   * ХешТекстаФрагмента - Строка - хеш текста.
//   * ЭффективнаяПолитика - ПеречислениеСсылка.КИИ_ПолитикиЭмбеддинга - действующая политика.
// Возвращаемое значение:
//  Структура - точка Qdrant с полями id, vector и payload; см. ТочкаДляОчереди.
// Возвращаемое значение:
//  Структура - точка Qdrant:
//   * id - Строка - идентификатор фрагмента.
//   * vector - Массив - вектор фрагмента.
//   * payload - Структура - метаданные фрагмента.
Функция ТочкаИзФрагмента(Знач ФрагментUUID, Знач Фрагмент)
	Payload = Новый Структура;
	Payload.Вставить("фрагмент", СокрЛП(ФрагментUUID));
	Payload.Вставить("базаЗнаний", Строка(Фрагмент.Владелец.УникальныйИдентификатор()));
	КатегорияИдентификатор = "";
	Если ЗначениеЗаполнено(Фрагмент.Категория) Тогда
		КатегорияИдентификатор = Строка(Фрагмент.Категория.УникальныйИдентификатор());
	КонецЕсли;
	Payload.Вставить("категория", КатегорияИдентификатор);
	Payload.Вставить("номер", Фрагмент.НомерФрагмента);
	Payload.Вставить("хеш", Фрагмент.ХешТекстаФрагмента);
	Payload.Вставить("политика", Строка(Фрагмент.ЭффективнаяПолитика));

	Точка = Новый Структура;
	Точка.Вставить("id", PointId(ФрагментUUID));
	Точка.Вставить("vector", Фрагмент.Вектор);
	Точка.Вставить("payload", Payload);
	Возврат Точка;
КонецФункции

// Удаляет точку фрагмента из коллекции модели (wait=true). 404 / отсутствие - идемпотентно.
// Размерность коллекции берется из build-marker (переживает удаление фрагмента) - иначе точка-сирота.

Процедура СоздатьИндексПоля(Знач Коллекция, Знач Поле, Знач Схема)
	Тело = Новый Структура;
	Тело.Вставить("field_name", Поле);
	Тело.Вставить("field_schema", Схема);
	Ответ = ВыполнитьЗапросQdrant("PUT", "/collections/" + Коллекция + "/index?wait=true", Тело);
	// Раньше результат игнорировался: сбой создания индекса проходил молча → фильтр-поиск по полю
	// потом деградировал/падал на неиндексированной коллекции (аудит P3).
	Если Не Ответ.Успешно Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось создать индекс Qdrant %1.%2: HTTP %3 %4'"),
			Коллекция, Поле, Ответ.КодСостояния, Ответ.Тело);
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьСтрокуОчереди(Знач ФрагментUUID, Знач КодМодели, Знач НомерПоПорядкуСнимка)
	КИИ_ОчередьQdrant.ПодтвердитьПоНомеру(ФрагментUUID, КодМодели, НомерПоПорядкуСнимка);
КонецПроцедуры

// Enqueue, не роняющий вызывающий цикл (rehydrate/сверка): ошибки логируются, не пробрасываются.
// Параметры:
//  ФрагментUUID - Строка - идентификатор фрагмента для операции очереди.
//  КодМодели - Строка - код модели индекса.
//  Операция - Строка - upsert или delete.
//  Хеш - Строка - хеш текста для upsert; по умолчанию пустая строка.
Процедура ПоставитьВОчередьБезопасно(Знач ФрагментUUID, Знач КодМодели, Знач Операция, Знач Хеш = "")
	Попытка
		ПоставитьВОчередь(ФрагментUUID, КодМодели, Операция, Хеш);
	Исключение
		Если ТранзакцияАктивна() Тогда
			ВызватьИсключение;
		КонецЕсли;
		ЗаписьЖурналаРегистрации(НСтр("ru = 'КИИ.RAGQdrant.Очередь'"), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

// Возвращаемое значение:
//  Число - предел чтений коллекции после конкурентного создания или временной ошибки.
Функция ЛимитПроверокСозданияКоллекции()
	Возврат 5;
КонецФункции

Функция КоллекцияСозданаДругимИсполнителем(Знач Имя, Знач Размерность, Знач КодСоздания)
	Если КодСоздания = 404 Или (КодСоздания <> 409 И Не ВременнаяОшибкаHTTP(КодСоздания)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Задержка = 0.25;
	Для НомерЧтения = 1 По ЛимитПроверокСозданияКоллекции() Цикл
		Ответ = ВыполнитьЗапросQdrant("GET", "/collections/" + Имя);
		Если Ответ.Успешно Тогда
			Возврат СовместимыеПараметрыКоллекции(Ответ.Тело, Размерность);
		КонецЕсли;
		Если Не ВременнаяОшибкаHTTP(Ответ.КодСостояния) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НомерЧтения < ЛимитПроверокСозданияКоллекции() Тогда
			ПаузаИсполнителя(Задержка);
			Задержка = Задержка * 2;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Не требует паузы пользовательского сеанса или дополнительных фоновых заданий.
// В фоне используется публичный API БСП, совместимый с платформой 8.3.27.
// Параметры:
//  Секунд - Число - продолжительность паузы фонового исполнителя в секундах.
Процедура ПаузаИсполнителя(Знач Секунд)
	Сеанс = ПолучитьТекущийСеансИнформационнойБазы();
	Если Сеанс.ПолучитьФоновоеЗадание() <> Неопределено Тогда
		ОбщегоНазначенияБТС.Пауза(Секунд);
	КонецЕсли;
КонецПроцедуры

Функция ВременнаяОшибкаHTTP(Знач Код)
	Возврат Код = 0 Или Код = 404 Или Код = 408 Или Код = 429
		Или Код = 500 Или Код = 502 Или Код = 503 Или Код = 504;
КонецФункции

Функция СовместимыеПараметрыКоллекции(Знач Тело, Знач Размерность)
	Попытка
		Данные = КИИ_HTTPКлиент.JsonВСтруктуру(Тело, Ложь);
		Векторы = Данные["result"]["config"]["params"]["vectors"];
		Возврат Векторы["size"] = Размерность И Векторы["distance"] = "Dot";
	Исключение

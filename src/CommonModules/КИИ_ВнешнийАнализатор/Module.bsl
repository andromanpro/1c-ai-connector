// Порт EDT MCP-сервера.
Функция ПортEDT()
	Возврат 8764;
КонецФункции

// Порт Codepilot MCP-сервера.
Функция ПортCodepilot()
	Возврат 8766;
КонецФункции

// Токен авторизации для Codepilot.
Функция ТокенCodepilot()

	Попытка
		Владелец = Справочники.КИИ_ЭкспертыИИ.ПустаяСсылка();
		Токен = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Владелец, "ТокенCodepilot");
		Если ЗначениеЗаполнено(Токен) Тогда
			Возврат Токен;
		КонецЕсли;
	Исключение
		Токен = ""; // Безопасное хранилище недоступно
	КонецПопытки;

	Возврат "";

КонецФункции

// Выполнить JSON-RPC запрос к MCP-серверу.
//
// Параметры:
//  Порт - Число - порт сервера.
//  ИмяМетода - Строка - имя метода MCP.
//  Параметры - Соответствие из КлючИЗначение - параметры вызова.
//  ТокенАвторизации - Строка - Bearer-токен (необязательный).
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат запроса.
//
Функция ВыполнитьЗапросMCP(Порт, ИмяМетода, Параметры, Знач ТокенАвторизации = "", НастройкиПодключения = Неопределено)

	Перем РезультатФункции;
	Перем ОтветОшибкиMCP;
	Перем ПредставлениеЗначения;

	Адрес = "http://localhost:" + Формат(Порт, "ЧГ=0") + "/mcp";
	Если НастройкиПодключения <> Неопределено Тогда
		НастройкиПодключения.Свойство("Адрес", Адрес);
		НастройкиПодключения.Свойство("ТокенАвторизации", ТокенАвторизации);
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept", "application/json, text/event-stream");
	Если ЗначениеЗаполнено(ТокенАвторизации) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + ТокенАвторизации);
	КонецЕсли;

	Инициализация = Новый Соответствие;
	Инициализация.Вставить("jsonrpc", "2.0");
	Инициализация.Вставить("id", 0);
	Инициализация.Вставить("method", "initialize");
	ОписаниеКлиента = Новый Структура("name, version", "iikona", "1");
	ПараметрыИнициализации = Новый Структура(
		"protocolVersion, capabilities, clientInfo", "2025-06-18", Новый Соответствие, ОписаниеКлиента);
	Инициализация.Вставить("params", ПараметрыИнициализации);
	ОтветИнициализации = КИИ_HTTPКлиент.ВыполнитьЗапрос("POST", Адрес, Инициализация, Заголовки);
	ИдентификаторСеанса = ЗаголовокОтветаMCP(ОтветИнициализации.Заголовки, "mcp-session-id");
	Если ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		Заголовки.Вставить("Mcp-Session-Id", ИдентификаторСеанса);
	КонецЕсли;
	ДанныеИнициализации = ПрочитатьОтветMCP(ОтветИнициализации, 0);
	ОшибкаИнициализации = ДанныеИнициализации.Получить("error");
	СтарыйСервер = ТипЗнч(ОшибкаИнициализации) = Тип("Соответствие") И ОшибкаИнициализации.Получить("code") = -32601;
	Если ОшибкаИнициализации <> Неопределено И Не СтарыйСервер Тогда
		ЗавершитьСеансMCP(Адрес, Заголовки, ИдентификаторСеанса);
		РезультатФункции = КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(ДанныеИнициализации);
		Возврат РезультатФункции;
	КонецЕсли;

	Если Не СтарыйСервер Тогда
		РезультатИнициализации = ДанныеИнициализации.Получить("result");
		Если ТипЗнч(РезультатИнициализации) <> Тип("Соответствие") Тогда
			ЗавершитьСеансMCP(Адрес, Заголовки, ИдентификаторСеанса);
			ОтветОшибкиMCP = ОшибкаMCP("Некорректный ответ инициализации MCP");
			РезультатФункции = КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(ОтветОшибкиMCP);
			Возврат РезультатФункции;
		КонецЕсли;
		ВерсияПротокола = РезультатИнициализации.Получить("protocolVersion");
		Если ЗначениеЗаполнено(ВерсияПротокола) Тогда
			Заголовки.Вставить("MCP-Protocol-Version", ВерсияПротокола);
		КонецЕсли;
		Уведомление = Новый Структура("jsonrpc, method", "2.0", "notifications/initialized");
		ОтветУведомления = КИИ_HTTPКлиент.ВыполнитьЗапрос("POST", Адрес, Уведомление, Заголовки);
		Если Не ОтветУведомления.Успешно Тогда
			ЗавершитьСеансMCP(Адрес, Заголовки, ИдентификаторСеанса);
			ПредставлениеЗначения = Строка(ОтветУведомления.КодСостояния);
			ОтветОшибкиMCP = ОшибкаMCP("Ошибка уведомления об инициализации MCP: HTTP " + ПредставлениеЗначения);
			РезультатФункции = КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(ОтветОшибкиMCP);
			Возврат РезультатФункции;
		КонецЕсли;
	КонецЕсли;

	МетодRPC = ?(ПустаяСтрока(ИмяМетода), "tools/list", "tools/call");
	ТелоЗапроса = Новый Структура("jsonrpc, id, method", "2.0", 1, МетодRPC);
	Если Не ПустаяСтрока(ИмяМетода) Тогда
		ПараметрыВызова = Новый Структура("name, arguments", ИмяМетода, Параметры);
		ТелоЗапроса.Вставить("params", ПараметрыВызова);
	КонецЕсли;
	Ответ = КИИ_HTTPКлиент.ВыполнитьЗапрос("POST", Адрес, ТелоЗапроса, Заголовки);
	ДанныеОтвета = ПрочитатьОтветMCP(Ответ, 1);
	ЗавершитьСеансMCP(Адрес, Заголовки, ИдентификаторСеанса);
	РезультатФункции = НормализованныйРезультатMCP(ДанныеОтвета);
	Возврат РезультатФункции;

КонецФункции

// Проверить доступность MCP-сервера на указанном порту.
Функция ПроверитьДоступностьСервера(Порт, Знач ТокенАвторизации = "")

	Перем РезультатФункции;
	Попытка
		Результат = ВыполнитьЗапросMCP(Порт, "", Новый Соответствие, ТокенАвторизации);
		РезультатФункции = Результат.Получить("Ошибка") = Неопределено;
		Возврат РезультатФункции;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Читает JSON-RPC из JSON или отдельного события SSE.
Функция ПрочитатьОтветMCP(Ответ, ОжидаемыйИдентификатор)

	Перем ТекстСобытияБезПробелов;
	Перем ЭтоОтветСобытияMCP;
	Перем ПредставлениеЗначения;
	Перем РезультатФункции;
	Если Не Ответ.Успешно Тогда
		ПредставлениеЗначения = Строка(Ответ.КодСостояния);
		РезультатФункции = ОшибкаMCP("Ошибка соединения с MCP: HTTP " + ПредставлениеЗначения);
		Возврат РезультатФункции;
	КонецЕсли;
	Текст = Ответ.Тело;
	ТекстСобытияБезПробелов = СокрЛП(Текст);
	ЭтоОтветСобытияMCP = СтрНачинаетсяС(ТекстСобытияБезПробелов, "event:");
	Если Не ЭтоОтветСобытияMCP Тогда
		ТекстСобытияБезПробелов = СокрЛП(Текст);
		ЭтоОтветСобытияMCP = СтрНачинаетсяС(ТекстСобытияБезПробелов, "data:");
	КонецЕсли;
	Если ЭтоОтветСобытияMCP Тогда
		РезультатФункции = ПрочитатьСобытияОтветаMCP(Текст, ОжидаемыйИдентификатор);
		Возврат РезультатФункции;
	КонецЕсли;
	РезультатФункции = ДанныеОтветаMCP(Текст, ОжидаемыйИдентификатор);
	Возврат РезультатФункции;
КонецФункции

Функция ЗаголовокОтветаMCP(Заголовки, Имя)
	Для Каждого Заголовок Из Заголовки Цикл
		Если НРег(Заголовок.Ключ) = Имя Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ОшибкаMCP(Сообщение)
	Данные = Новый Соответствие;
	Данные.Вставить("error", Сообщение);
	Возврат Данные;
КонецФункции

Функция ДанныеОтветаMCP(Текст, ОжидаемыйИдентификатор)

	Перем РезультатФункции;
	Попытка
		Данные = КИИ_HTTPКлиент.JsonВСтруктуру(Текст);
		ОтветСоответствуетВызову = ТипЗнч(Данные) = Тип("Соответствие")
			И Данные.Получить("jsonrpc") = "2.0"
			И Данные.Получить("id") = ОжидаемыйИдентификатор
			И (Данные.Получить("result") <> Неопределено Или Данные.Получить("error") <> Неопределено);
		Если ОтветСоответствуетВызову Тогда
			Возврат Данные;
		КонецЕсли;
	Исключение
		РезультатФункции = ОшибкаMCP("Некорректный JSON-RPC ответ MCP");
		Возврат РезультатФункции;
	КонецПопытки;
	РезультатФункции = ОшибкаMCP("Некорректный JSON-RPC ответ MCP");
	Возврат РезультатФункции;
КонецФункции

// Завершает только сессию, открытую этим вызовом; ответ DELETE не заменяет результат инструмента.
Процедура ЗавершитьСеансMCP(Адрес, Заголовки, ИдентификаторСеанса)
	Если ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		КИИ_HTTPКлиент.ВыполнитьЗапрос("DELETE", Адрес, Неопределено, Заголовки);
	КонецЕсли;
КонецПроцедуры

// CallToolResult.isError является ошибкой, даже если транспорт и JSON-RPC успешны.
Функция НормализованныйРезультатMCP(ОтветRPC)

	Перем ЭлементЗначение;
	Перем ПредставлениеЗначения;

	Перем ОтветОшибкиMCP;
	Перем РезультатФункции;
	Результат = КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(ОтветRPC);
	Если ТипЗнч(Результат) = Тип("Соответствие") И Результат.Получить("isError") = Истина Тогда
		Сообщения = Новый Массив;
		Содержимое = Результат.Получить("content");
		Если ТипЗнч(Содержимое) = Тип("Массив") Тогда
			Для Каждого Элемент Из Содержимое Цикл
				Если ТипЗнч(Элемент) = Тип("Соответствие") И Элемент.Получить("type") = "text" Тогда
					ЭлементЗначение = Элемент.Получить("text");
					ПредставлениеЗначения = Строка(ЭлементЗначение);
					Сообщения.Добавить(ПредставлениеЗначения);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ТекстОшибки = ?(
			Сообщения.Количество() = 0,
			НСтр("ru = 'Инструмент MCP завершился ошибкой.'"),
			СтрСоединить(Сообщения, Символы.ПС));
		ОтветОшибкиMCP = ОшибкаMCP(ТекстОшибки);
		РезультатФункции = КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(ОтветОшибкиMCP);
		Возврат РезультатФункции;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПрочитатьСобытияОтветаMCP(Знач Текст, Знач ОжидаемыйИдентификатор)

	Перем ТекстПослеЗамены;
	Перем ЧастиТекста;

	Перем ФрагментТекста;
	Перем ЗначениеБезПробелов;
	Перем СоединенныйТекст;
	Перем РезультатФункции;
	ДанныеСобытия = Новый Массив;
	ТекстПослеЗамены = СтрЗаменить(Текст, Символы.ВК, "");
	ЧастиТекста = СтрРазделить(ТекстПослеЗамены, Символы.ПС, Истина);
	Для Каждого СтрокаСобытия Из ЧастиТекста Цикл
		Если СтрНачинаетсяС(СтрокаСобытия, "data:") Тогда
			ФрагментТекста = Сред(СтрокаСобытия, 6);
			ЗначениеБезПробелов = СокрЛП(ФрагментТекста);
			ДанныеСобытия.Добавить(ЗначениеБезПробелов);
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаСобытия) И ДанныеСобытия.Количество() > 0 Тогда
			СоединенныйТекст = СтрСоединить(ДанныеСобытия, Символы.ПС);
			Данные = ДанныеОтветаMCP(СоединенныйТекст, ОжидаемыйИдентификатор);
			Если Данные.Получить("id") = ОжидаемыйИдентификатор Тогда
				Возврат Данные;
			КонецЕсли;
			ДанныеСобытия.Очистить();
		КонецЕсли;
	КонецЦикла;
	СоединенныйТекст = СтрСоединить(ДанныеСобытия, Символы.ПС);
	РезультатФункции = ДанныеОтветаMCP(СоединенныйТекст, ОжидаемыйИдентификатор);
	Возврат РезультатФункции;
КонецФункции

#КонецОбласти

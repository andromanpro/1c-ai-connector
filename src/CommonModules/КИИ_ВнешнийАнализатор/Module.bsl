////////////////////////////////////////////////////////////////////////////////
// КИИ_ВнешнийАнализатор: Коннектор к внешним инструментам анализа кода
//
// Серверный модуль-обертка для взаимодействия с:
//   - EDT MCP-сервером (localhost:8764) - ошибки, метаданные, код
//   - Codepilot MCP-сервером (localhost:8766) - расширенный анализ кода
//
// Зависимости:
//   - КИИ_HTTPКлиент (HTTP-запросы)
//
// Версия: 1.0 (март 2026)
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область EDT

// Получить ошибки проекта из EDT.
//
// Параметры:
//  ИмяПроекта - Строка - имя EDT-проекта.
//  ФильтрОбъектов - Строка - FQN объекта (необязательный).
//  Серьезность - Строка - минимальный уровень серьезности (необязательный).
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат запроса (ошибки или описание ошибки).
//
Функция ПолучитьОшибкиПроектаEDT(Знач ИмяПроекта, Знач ФильтрОбъектов = "", Знач Серьезность = "") Экспорт

	Параметры = Новый Соответствие;
	Параметры.Вставить("projectName", ИмяПроекта);

	Если ЗначениеЗаполнено(ФильтрОбъектов) Тогда
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ФильтрОбъектов);
		Параметры.Вставить("objects", МассивОбъектов);
	КонецЕсли;

	Если ЗначениеЗаполнено(Серьезность) Тогда
		Параметры.Вставить("severity", Серьезность);
	КонецЕсли;

	Возврат ВыполнитьЗапросMCP(ПортEDT(), "get_project_errors", Параметры);

КонецФункции

// Получить исходный код модуля из EDT.
//
// Параметры:
//  ИмяПроекта - Строка - имя EDT-проекта.
//  ПутьМодуля - Строка - путь от src/ (например "CommonModules/MyModule/Module.bsl").
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат запроса.
//
Функция ПолучитьМодульEDT(Знач ИмяПроекта, Знач ПутьМодуля) Экспорт

	Параметры = Новый Соответствие;
	Параметры.Вставить("projectName", ИмяПроекта);
	Параметры.Вставить("modulePath", ПутьМодуля);

	Возврат ВыполнитьЗапросMCP(ПортEDT(), "read_module_source", Параметры);

КонецФункции

// Найти ссылки на объект через EDT.
//
// Параметры:
//  ИмяПроекта - Строка - имя EDT-проекта.
//  ОбъектFQN - Строка - FQN объекта (например "Catalog.Products").
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат запроса.
//
Функция НайтиСсылкиEDT(Знач ИмяПроекта, Знач ОбъектFQN) Экспорт

	Параметры = Новый Соответствие;
	Параметры.Вставить("projectName", ИмяПроекта);
	Параметры.Вставить("objectFqn", ОбъектFQN);

	Возврат ВыполнитьЗапросMCP(ПортEDT(), "find_references", Параметры);

КонецФункции

// Выполнить поиск в коде через EDT.
//
// Параметры:
//  ИмяПроекта - Строка - имя EDT-проекта.
//  ТекстПоиска - Строка - текст для поиска.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат запроса.
//
Функция ПоискВКодеEDT(Знач ИмяПроекта, Знач ТекстПоиска) Экспорт

	Параметры = Новый Соответствие;
	Параметры.Вставить("projectName", ИмяПроекта);
	Параметры.Вставить("query", ТекстПоиска);
	Параметры.Вставить("outputMode", "full");
	Параметры.Вставить("maxResults", 100);

	Возврат ВыполнитьЗапросMCP(ПортEDT(), "search_in_code", Параметры);

КонецФункции

// Проверить доступность EDT MCP-сервера.
//
// Возвращаемое значение:
//  Булево - Истина если сервер доступен.
//
Функция ПроверитьДоступностьEDT() Экспорт

	Возврат ПроверитьДоступностьСервера(ПортEDT());

КонецФункции

#КонецОбласти

#Область Codepilot

// Анализировать код через Codepilot MCP-сервер.
//
// Параметры:
//  ИмяПроекта - Строка - имя EDT-проекта.
//  ПутьФайла - Строка - путь к файлу от src/.
//  НастройкиПодключения - Структура, Неопределено - необязательные Адрес и ТокенАвторизации. Прежние вызовы совместимы.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат анализа.
//
Функция АнализироватьКодCodepilot(Знач ИмяПроекта, Знач ПутьФайла, НастройкиПодключения = Неопределено) Экспорт
	Путь = СтрЗаменить(ПутьФайла, "\", "/");
	Если Лев(Путь, 1) = "/" Тогда
		Путь = Сред(Путь, 2);
	КонецЕсли;
	Если Не СтрНачинаетсяС(Путь, ИмяПроекта + "/") Тогда
		Если Не СтрНачинаетсяС(Путь, "src/") Тогда
			Путь = "src/" + Путь;
		КонецЕсли;
		Путь = ИмяПроекта + "/" + Путь;
	КонецЕсли;
	Параметры = Новый Соответствие;
	Параметры.Вставить("project_name", ИмяПроекта);
	Параметры.Вставить("scope", "file");
	Параметры.Вставить("path", Путь);
	Возврат ВыполнитьЗапросMCP(ПортCodepilot(), "get_diagnostics", Параметры, ТокенCodepilot(), НастройкиПодключения);
КонецФункции

// Получить структуру модуля через Codepilot.
//
// Параметры:
//  ИмяПроекта - Строка - имя EDT-проекта.
//  ПутьФайла - Строка - путь к файлу от src/.
//  НастройкиПодключения - Структура, Неопределено - необязательные Адрес и ТокенАвторизации. Прежние вызовы совместимы.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -структура модуля.
//
Функция ПолучитьСтруктуруМодуляCodepilot(Знач ИмяПроекта, Знач ПутьФайла, НастройкиПодключения = Неопределено) Экспорт
	Параметры = Новый Соответствие;
	Параметры.Вставить("projectName", ИмяПроекта);
	Параметры.Вставить("moduleFqn", ПутьФайла);
	Возврат ВыполнитьЗапросMCP(
		ПортCodepilot(), "edt_get_module_structure", Параметры, ТокенCodepilot(), НастройкиПодключения);
КонецФункции

// Получить детали метаданных через Codepilot.
//
// Параметры:
//  ИмяПроекта - Строка - имя EDT-проекта.
//  ОбъектFQN - Массив из Строка - FQN объектов.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -детали метаданных.
//
Функция ПолучитьДеталиМетаданныхCodepilot(Знач ИмяПроекта, Знач ОбъектFQN) Экспорт

	Параметры = Новый Соответствие;
	Параметры.Вставить("projectName", ИмяПроекта);

	МассивFQN = Новый Массив;
	Если ТипЗнч(ОбъектFQN) = Тип("Массив") Тогда
		МассивFQN = ОбъектFQN;
	Иначе
		МассивFQN.Добавить(ОбъектFQN);
	КонецЕсли;
	Параметры.Вставить("objectFqns", МассивFQN);

	Возврат ВыполнитьЗапросMCP(ПортCodepilot(), "edt_metadata_details", Параметры,
		ТокенCodepilot());

КонецФункции

// Проверить доступность Codepilot MCP-сервера.
//
// Возвращаемое значение:
//  Булево - Истина если сервер доступен.
//
Функция ПроверитьДоступностьCodepilot() Экспорт
	Возврат ПроверитьДоступностьСервера(ПортCodepilot(), ТокенCodepilot());
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Порт EDT MCP-сервера.
Функция ПортEDT()
	Возврат 8764;
КонецФункции

// Порт Codepilot MCP-сервера.
Функция ПортCodepilot()
	Возврат 8766;
КонецФункции

// Токен авторизации для Codepilot.
Функция ТокенCodepilot()

	Попытка
		Владелец = Справочники.КИИ_ЭкспертыИИ.ПустаяСсылка();
		Токен = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Владелец, "ТокенCodepilot");
		Если ЗначениеЗаполнено(Токен) Тогда
			Возврат Токен;
		КонецЕсли;
	Исключение
		Токен = ""; // Безопасное хранилище недоступно
	КонецПопытки;

	Возврат "";

КонецФункции

// Выполнить JSON-RPC запрос к MCP-серверу.
//
// Параметры:
//  Порт - Число - порт сервера.
//  ИмяМетода - Строка - имя метода MCP.
//  Параметры - Соответствие из КлючИЗначение - параметры вызова.
//  ТокенАвторизации - Строка - Bearer-токен (необязательный).
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -результат запроса.
//
Функция ВыполнитьЗапросMCP(Порт, ИмяМетода, Параметры, Знач ТокенАвторизации = "", НастройкиПодключения = Неопределено)

	Адрес = "http://localhost:" + Формат(Порт, "ЧГ=0") + "/mcp";
	Если НастройкиПодключения <> Неопределено Тогда
		НастройкиПодключения.Свойство("Адрес", Адрес);
		НастройкиПодключения.Свойство("ТокенАвторизации", ТокенАвторизации);
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept", "application/json, text/event-stream");
	Если ЗначениеЗаполнено(ТокенАвторизации) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + ТокенАвторизации);
	КонецЕсли;

	Инициализация = Новый Соответствие;
	Инициализация.Вставить("jsonrpc", "2.0");
	Инициализация.Вставить("id", 0);
	Инициализация.Вставить("method", "initialize");
	ОписаниеКлиента = Новый Структура("name, version", "iikona", "1");
	ПараметрыИнициализации = Новый Структура(
		"protocolVersion, capabilities, clientInfo", "2025-06-18", Новый Соответствие, ОписаниеКлиента);
	Инициализация.Вставить("params", ПараметрыИнициализации);
	ОтветИнициализации = КИИ_HTTPКлиент.ВыполнитьЗапрос("POST", Адрес, Инициализация, Заголовки);
	ИдентификаторСеанса = ЗаголовокОтветаMCP(ОтветИнициализации.Заголовки, "mcp-session-id");
	Если ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		Заголовки.Вставить("Mcp-Session-Id", ИдентификаторСеанса);
	КонецЕсли;
	ДанныеИнициализации = ПрочитатьОтветMCP(ОтветИнициализации, 0);
	ОшибкаИнициализации = ДанныеИнициализации.Получить("error");
	СтарыйСервер = ТипЗнч(ОшибкаИнициализации) = Тип("Соответствие") И ОшибкаИнициализации.Получить("code") = -32601;
	Если ОшибкаИнициализации <> Неопределено И Не СтарыйСервер Тогда
		ЗавершитьСеансMCP(Адрес, Заголовки, ИдентификаторСеанса);
		Возврат КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(ДанныеИнициализации);
	КонецЕсли;

	Если Не СтарыйСервер Тогда
		РезультатИнициализации = ДанныеИнициализации.Получить("result");
		Если ТипЗнч(РезультатИнициализации) <> Тип("Соответствие") Тогда
			ЗавершитьСеансMCP(Адрес, Заголовки, ИдентификаторСеанса);
			Возврат КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(ОшибкаMCP("Некорректный ответ инициализации MCP"));
		КонецЕсли;
		ВерсияПротокола = РезультатИнициализации.Получить("protocolVersion");
		Если ЗначениеЗаполнено(ВерсияПротокола) Тогда
			Заголовки.Вставить("MCP-Protocol-Version", ВерсияПротокола);
		КонецЕсли;
		Уведомление = Новый Структура("jsonrpc, method", "2.0", "notifications/initialized");
		ОтветУведомления = КИИ_HTTPКлиент.ВыполнитьЗапрос("POST", Адрес, Уведомление, Заголовки);
		Если Не ОтветУведомления.Успешно Тогда
			ЗавершитьСеансMCP(Адрес, Заголовки, ИдентификаторСеанса);
			Возврат КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(
				ОшибкаMCP("Ошибка уведомления об инициализации MCP: HTTP " + Строка(ОтветУведомления.КодСостояния)));
		КонецЕсли;
	КонецЕсли;

	МетодRPC = ?(ПустаяСтрока(ИмяМетода), "tools/list", "tools/call");
	ТелоЗапроса = Новый Структура("jsonrpc, id, method", "2.0", 1, МетодRPC);
	Если Не ПустаяСтрока(ИмяМетода) Тогда
		ПараметрыВызова = Новый Структура("name, arguments", ИмяМетода, Параметры);
		ТелоЗапроса.Вставить("params", ПараметрыВызова);
	КонецЕсли;
	Ответ = КИИ_HTTPКлиент.ВыполнитьЗапрос("POST", Адрес, ТелоЗапроса, Заголовки);
	ДанныеОтвета = ПрочитатьОтветMCP(Ответ, 1);
	ЗавершитьСеансMCP(Адрес, Заголовки, ИдентификаторСеанса);
	Возврат НормализованныйРезультатMCP(ДанныеОтвета);

КонецФункции

// Проверить доступность MCP-сервера на указанном порту.
Функция ПроверитьДоступностьСервера(Порт, Знач ТокенАвторизации = "")
	Попытка
		Результат = ВыполнитьЗапросMCP(Порт, "", Новый Соответствие, ТокенАвторизации);
		Возврат Результат.Получить("Ошибка") = Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Читает JSON-RPC из JSON или отдельного события SSE.
Функция ПрочитатьОтветMCP(Ответ, ОжидаемыйИдентификатор)
	Если Не Ответ.Успешно Тогда
		Возврат ОшибкаMCP("Ошибка соединения с MCP: HTTP " + Строка(Ответ.КодСостояния));
	КонецЕсли;
	Текст = Ответ.Тело;
	Если СтрНачинаетсяС(СокрЛП(Текст), "event:") Или СтрНачинаетсяС(СокрЛП(Текст), "data:") Тогда
		Возврат ПрочитатьСобытияОтветаMCP(Текст, ОжидаемыйИдентификатор);
	КонецЕсли;
	Возврат ДанныеОтветаMCP(Текст, ОжидаемыйИдентификатор);
КонецФункции

Функция ЗаголовокОтветаMCP(Заголовки, Имя)
	Для Каждого Заголовок Из Заголовки Цикл
		Если НРег(Заголовок.Ключ) = Имя Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ОшибкаMCP(Сообщение)
	Данные = Новый Соответствие;
	Данные.Вставить("error", Сообщение);
	Возврат Данные;
КонецФункции

Функция ДанныеОтветаMCP(Текст, ОжидаемыйИдентификатор)
	Попытка
		Данные = КИИ_HTTPКлиент.JsonВСтруктуру(Текст);
		ОтветСоответствуетВызову = ТипЗнч(Данные) = Тип("Соответствие")
			И Данные.Получить("jsonrpc") = "2.0"
			И Данные.Получить("id") = ОжидаемыйИдентификатор
			И (Данные.Получить("result") <> Неопределено Или Данные.Получить("error") <> Неопределено);
		Если ОтветСоответствуетВызову Тогда
			Возврат Данные;
		КонецЕсли;
	Исключение
		Возврат ОшибкаMCP("Некорректный JSON-RPC ответ MCP");
	КонецПопытки;
	Возврат ОшибкаMCP("Некорректный JSON-RPC ответ MCP");
КонецФункции

// Завершает только сессию, открытую этим вызовом; ответ DELETE не заменяет результат инструмента.
Процедура ЗавершитьСеансMCP(Адрес, Заголовки, ИдентификаторСеанса)
	Если ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		КИИ_HTTPКлиент.ВыполнитьЗапрос("DELETE", Адрес, Неопределено, Заголовки);
	КонецЕсли;
КонецПроцедуры

// CallToolResult.isError является ошибкой, даже если транспорт и JSON-RPC успешны.
Функция НормализованныйРезультатMCP(ОтветRPC)
	Результат = КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(ОтветRPC);
	Если ТипЗнч(Результат) = Тип("Соответствие") И Результат.Получить("isError") = Истина Тогда
		Сообщения = Новый Массив;
		Содержимое = Результат.Получить("content");
		Если ТипЗнч(Содержимое) = Тип("Массив") Тогда
			Для Каждого Элемент Из Содержимое Цикл
				Если ТипЗнч(Элемент) = Тип("Соответствие") И Элемент.Получить("type") = "text" Тогда
					Сообщения.Добавить(Строка(Элемент.Получить("text")));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ТекстОшибки = ?(
			Сообщения.Количество() = 0,
			НСтр("ru = 'Инструмент MCP завершился ошибкой.'"),
			СтрСоединить(Сообщения, Символы.ПС));
		Возврат КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(ОшибкаMCP(ТекстОшибки));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПрочитатьСобытияОтветаMCP(Знач Текст, Знач ОжидаемыйИдентификатор)
	ДанныеСобытия = Новый Массив;
	Для Каждого СтрокаСобытия Из СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина) Цикл
		Если СтрНачинаетсяС(СтрокаСобытия, "data:") Тогда
			ДанныеСобытия.Добавить(СокрЛП(Сред(СтрокаСобытия, 6)));
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаСобытия) И ДанныеСобытия.Количество() > 0 Тогда
			Данные = ДанныеОтветаMCP(СтрСоединить(ДанныеСобытия, Символы.ПС), ОжидаемыйИдентификатор);
			Если Данные.Получить("id") = ОжидаемыйИдентификатор Тогда
				Возврат Данные;
			КонецЕсли;
			ДанныеСобытия.Очистить();
		КонецЕсли;
	КонецЦикла;
	Возврат ДанныеОтветаMCP(СтрСоединить(ДанныеСобытия, Символы.ПС), ОжидаемыйИдентификатор);
КонецФункции

#КонецОбласти

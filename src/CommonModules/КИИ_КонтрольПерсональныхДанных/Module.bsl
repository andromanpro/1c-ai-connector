КонецФункции

#КонецОбласти

#Область Восстановление

// Все вхождения всех подстановок в тексте, по возрастанию позиции, без пересечений.
Функция ВхожденияПодстановок(Знач Текст, Знач Контекст)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Начало", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Длина", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Подстановка", Новый ОписаниеТипов("Строка"));

	Для Каждого Элемент Из Контекст.ОригиналПоПодстановке Цикл
		Позиция = СтрНайти(Текст, Элемент.Ключ);
		Пока Позиция > 0 Цикл
			Вхождение = Таблица.Добавить();
			Вхождение.Начало = Позиция;
			Вхождение.Длина = СтрДлина(Элемент.Ключ);
			Вхождение.Подстановка = Элемент.Ключ;
			Позиция = СтрНайти(Текст, Элемент.Ключ, , Позиция + Вхождение.Длина);
		КонецЦикла;
	КонецЦикла;

	Таблица.Сортировать("Начало Возр, Длина Убыв");

	Возврат Таблица;

КонецФункции

Функция ТекстСОригиналами(Знач Текст, Знач Вхождения, Знач Контекст)

	Части = Новый Массив;
	Позиция = 1;
	Для Каждого Вхождение Из Вхождения Цикл
		Если Вхождение.Начало < Позиция Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(Сред(Текст, Позиция, Вхождение.Начало - Позиция));
		Части.Добавить(Контекст.ОригиналПоПодстановке[Вхождение.Подстановка]);
		Позиция = Вхождение.Начало + Вхождение.Длина;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Позиция));

	Возврат СтрСоединить(Части, "");

КонецФункции

// Подставная фамилия встречается в тексте не целиком (модель ее просклоняла): такое место
// не восстановится, и человек должен об этом знать.
Функция ЕстьИскаженныеПодстановки(Знач Текст, Знач Контекст)

	// Целые подстановки вырезаются: их восстановление уже сделано. Если в остатке встречается основа
	// подставной фамилии, модель ее просклоняла или разорвала, и это место человек увидит с подстановкой.
	// Имя и отчество не проверяются: их основы совпадают с обычными словами («Вера» - «Версия»).
	Остаток = Текст;
	Для Каждого Элемент Из Контекст.ОригиналПоПодстановке Цикл
		Остаток = СтрЗаменить(Остаток, Элемент.Ключ, " ");
	КонецЦикла;

	Фамилии = Новый Соответствие;
	Для Каждого Фамилия Из ФамилииМужские() Цикл
		Фамилии.Вставить(Фамилия, Истина);
	КонецЦикла;
	Для Каждого Фамилия Из ФамилииЖенские() Цикл
		Фамилии.Вставить(Фамилия, Истина);
	КонецЦикла;

	Для Каждого Элемент Из Контекст.ОригиналПоПодстановке Цикл
		Для Каждого Слово Из СловаИмени(Элемент.Ключ) Цикл
			Если Фамилии[Слово] <> Неопределено И СтрНайти(Остаток, Лев(Слово, СтрДлина(Слово) - 1)) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область Журнал

Процедура ЗаписатьСобытие(Знач Результат, Знач Режим, Знач Контекст, Знач Модель, Знач Обработка, Знач Начало)

	УстановитьПривилегированныйРежим(Истина);

	МенеджерЗаписи = РегистрыСведений.КИИ_ЖурналКонтроляПерсональныхДанных.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСобытия = Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи.Момент = ТекущаяДатаСеанса();
	МенеджерЗаписи.Канал = Контекст.Канал;
	МенеджерЗаписи.Модель = ?(ЗначениеЗаполнено(Модель), Модель, Справочники.КИИ_МоделиИИ.ПустаяСсылка());
	МенеджерЗаписи.Операция = Контекст.ИдентификаторОперации;
	МенеджерЗаписи.Этап = "Подготовка";
	МенеджерЗаписи.Режим = Режим;
	МенеджерЗаписи.Решение = Результат.Решение;
	МенеджерЗаписи.КодОтказа = Результат.КодОтказа;
	МенеджерЗаписи.ТипыСущностей = ТипыСтрокой(Контекст);
	МенеджерЗаписи.КоличествоЗамен = ?(Обработка = Неопределено, 0, Обработка.Замен);
	МенеджерЗаписи.БылиЗамены = Результат.БылиЗамены;
	МенеджерЗаписи.ЕстьВложения = Обработка <> Неопределено И Обработка.ЕстьВложения;
	МенеджерЗаписи.ВерсияПравил = КИИ_ПравилаПерсональныхДанных.ВерсияПравил();
	МенеджерЗаписи.ВерсияГенератораПодстановок = ВерсияГенератора();
	МенеджерЗаписи.ДлительностьМиллисекунд = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	МенеджерЗаписи.СтатусАудита = "Записано";
	МенеджерЗаписи.Записать();

КонецПроцедуры

Функция ТипыСтрокой(Знач Контекст)

	Типы = Новый Массив;
	Для Каждого Элемент Из Контекст.ТипыСущностей Цикл
		Типы.Добавить(Элемент.Ключ);
	КонецЦикла;

	Возврат СтрСоединить(Типы, ", ");

КонецФункции

Функция ВерсияГенератора()

	Возврат "1.0";

КонецФункции

#КонецОбласти

#Область Хеш

Функция ХешСтроки(Знач Значение)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Значение);

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Десятичные цифры из шестнадцатеричного хеша: каждый символ дает одну цифру.
Функция ЦифрыИзХеша(Знач Хеш, Знач Количество)

	Цифры = Новый Массив;
	Для Позиция = 1 По Количество Цикл
		Цифры.Добавить(Формат(ЗначениеСимволаХеша(Хеш, Позиция) % 10, "ЧН=0; ЧГ=0"));
	КонецЦикла;

	Возврат СтрСоединить(Цифры, "");

КонецФункции

Функция ЧислоИзХеша(Знач Хеш, Знач Смещение, Знач Символов)

	Значение = 0;
	Для Позиция = Смещение По Смещение + Символов - 1 Цикл
		Значение = Значение * 16 + ЗначениеСимволаХеша(Хеш, Позиция);
	КонецЦикла;

	Возврат Значение;

КонецФункции

Функция ЗначениеСимволаХеша(Знач Хеш, Знач Позиция)

	Возврат СтрНайти("0123456789abcdef", Сред(Хеш, Позиция, 1)) - 1;

КонецФункции

Функция ЭкранированныйВJSON(Знач Значение)

	Возврат СтрЗаменить(СтрЗаменить(Значение, "\", "\\"), """", "\""");

КонецФункции


// Метка вида [ФИО-1]: номер растет по типу в пределах операции, одно значение - одна метка.
// Номер, который уже написан в тексте пользователя, пропускается: иначе его литерал при восстановлении
// превратился бы в чужое значение.
Функция НоваяМетка(Знач Тип, Контекст)

	Номер = Контекст.НомераМеток[Тип];
	Если Номер = Неопределено Тогда
		Номер = 0;
	КонецЕсли;
	Номер = Номер + 1;
	Метка = СтрШаблон("[%1-%2]", МеткаТипа(Тип), Формат(Номер, "ЧГ=0"));
	Пока Контекст.ЗанятыеМетки[Метка] <> Неопределено Цикл
		Номер = Номер + 1;
		Метка = СтрШаблон("[%1-%2]", МеткаТипа(Тип), Формат(Номер, "ЧГ=0"));
	КонецЦикла;
	Контекст.НомераМеток.Вставить(Тип, Номер);

	Возврат Метка;

КонецФункции

Процедура ЗарезервироватьМетки(Знач Текст, Контекст)

	Начало = СтрНайти(Текст, "[");
	Пока Начало > 0 Цикл
		Конец = СтрНайти(Текст, "]", , Начало);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Кандидат = Сред(Текст, Начало, Конец - Начало + 1);
		Если ЭтоМетка(Кандидат) Тогда
			Контекст.ЗанятыеМетки.Вставить(Кандидат, Истина);
		КонецЕсли;
		Начало = СледующееВхождение(Текст, "[", Начало + 1);
	КонецЦикла;

КонецПроцедуры

// Метка - «[», буквы, дефис, цифры, «]».
Функция ЭтоМетка(Знач Кандидат)

	Дефис = СтрНайти(Кандидат, "-");
	Номер = Сред(Кандидат, Дефис + 1, СтрДлина(Кандидат) - Дефис - 1);
	Если Дефис < 3 Или СтрДлина(Номер) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Номер) Цикл
		Если СтрНайти("0123456789", Сред(Номер, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция МеткаТипа(Знач Тип)

	Метки = Новый Соответствие;
	Метки.Вставить("EMAIL", "ПОЧТА");
	Метки.Вставить("ОРГАНИЗАЦИЯ", "ОРГ");
	Метки.Вставить("ДАТАРОЖДЕНИЯ", "ДАТА");
	Метка = Метки[Тип];
	Если Метка = Неопределено Тогда
		Возврат Тип;
	КонецЕсли;

	Возврат Метка;

КонецФункции

// Списки для подставных ФИО: правдоподобные или нарочито выдуманные, которые никто не примет за человека.
Функция НаборИмен(Знач Выдуманные)

	Набор = Новый Структура;
	Набор.Вставить("Выдуманные", Выдуманные);
	Если Выдуманные Тогда
		ФамилииМужские = ВыдуманныеФамилии();
		ФамилииЖенские = Новый Массив;
		Для Каждого Фамилия Из ФамилииМужские Цикл
			ФамилииЖенские.Добавить(Фамилия + "а");
		КонецЦикла;
		Набор.Вставить("ФамилииМужские", ФамилииМужские);
		Набор.Вставить("ФамилииЖенские", ФамилииЖенские);
		Набор.Вставить("ИменаМужские", ВыдуманныеИменаМужские());
		Набор.Вставить("ИменаЖенские", ВыдуманныеИменаЖенские());
		Набор.Вставить("ОтчестваМужские", ВыдуманныеОтчестваМужские());
		Набор.Вставить("ОтчестваЖенские", ВыдуманныеОтчестваЖенские());
		Возврат Набор;
	КонецЕсли;

	Набор.Вставить("ФамилииМужские", ФамилииМужские());
	Набор.Вставить("ФамилииЖенские", ФамилииЖенские());
	Набор.Вставить("ИменаМужские", ИменаМужские());
	Набор.Вставить("ИменаЖенские", ИменаЖенские());
	Набор.Вставить("ОтчестваМужские", ОтчестваМужские());
	Набор.Вставить("ОтчестваЖенские", ОтчестваЖенские());

	Возврат Набор;


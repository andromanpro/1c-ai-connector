// Слова имени без учета того, чем они разделены в тексте: пробелом, переносом строки или табуляцией.
Функция СловаИмени(Знач Значение)

	Возврат СтрРазделить(Значение, " " + Символы.ПС + Символы.ВК + Символы.Таб, Ложь);

КонецФункции

// Род определяется по отчеству, если оно есть, иначе по окончанию фамилии.
Функция ЭтоЖенскоеИмя(Знач Слова, Знач Детектор)

	Последнее = Слова.Количество() - 1;
	ИндексОтчества = -1;
	Если Детектор = "ИмяТриСлова" Тогда
		ИндексОтчества = Последнее;
	КонецЕсли;
	Если Детектор = "ИмяОтчествоФамилия" Тогда
		ИндексОтчества = 1;
	КонецЕсли;
	Если ИндексОтчества >= 0 И ИндексОтчества <= Последнее Тогда
		Отчество = НРег(Слова[ИндексОтчества]);
		Возврат СтрЗаканчиваетсяНа(Отчество, "вна") Или СтрЗаканчиваетсяНа(Отчество, "чна");
	КонецЕсли;

	Фамилия = НРег(Слова[?(Детектор = "ИнициалыИФамилия", Последнее, 0)]);
	// Косвенные падежи («Петровой», «Ильиной») бывают только у женской фамилии: так ее отдает сервис.
	Возврат СтрЗаканчиваетсяНа(Фамилия, "ова") Или СтрЗаканчиваетсяНа(Фамилия, "ева")
		Или СтрЗаканчиваетсяНа(Фамилия, "ина") Или СтрЗаканчиваетсяНа(Фамилия, "ая")
		Или СтрЗаканчиваетсяНа(Фамилия, "овой") Или СтрЗаканчиваетсяНа(Фамилия, "евой")
		Или СтрЗаканчиваетсяНа(Фамилия, "иной");

КонецФункции

Функция ЭлементСписка(Знач Список, Знач Хеш, Знач Смещение)

	Индекс = ЧислоИзХеша(Хеш, Смещение, 2) % Список.Количество();
	Возврат Список[Индекс];

КонецФункции

// Стиль подстановок из настройки. Пустая настройка - правдоподобные значения, как до появления стилей.
Функция СтильПодстановок()

	УстановитьПривилегированныйРежим(Истина);
	Стиль = Константы.КИИ_СтильПодстановокПерсональныхДанных.Получить();
	УстановитьПривилегированныйРежим(Ложь);

	Возврат ?(ЗначениеЗаполнено(Стиль), ОбщегоНазначения.ИмяЗначенияПеречисления(Стиль), "Правдоподобные");


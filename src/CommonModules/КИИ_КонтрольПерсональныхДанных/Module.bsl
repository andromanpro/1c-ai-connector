// Создает контекст контроля на одну операцию: соль подстановок и карту соответствий.
// Карта живет только в памяти вызова: в результат, кеш, лог и параметры фоновых заданий не попадает.
//
// Параметры:
//  Канал - Строка - канал, см. КаналЗапросыКМоделям. Пустая строка - канал запросов к моделям.
//
// Возвращаемое значение:
//  Структура - контекст контроля:
//   * ИдентификаторОперации - Строка - идентификатор операции для журнала.
//   * Канал - Строка - канал.
//   * Режим - ПеречислениеСсылка.КИИ_РежимыКонтроляПерсональныхДанных - режим, заданный явно;
//             пустая ссылка - режим определяется настройками канала и модели.
//   * Соль - Строка - случайная соль подстановок операции.
//   * ПодстановкаПоКлючу - Соответствие - тип и нормализованное значение -> подстановка.
//   * ОригиналПоПодстановке - Соответствие - подстановка -> исходное написание значения.
//   * Оригиналы - Соответствие - исходные написания значений, замененных в операции.
//   * ТипыСущностей - Соответствие - типы найденных значений.
//   * КоличествоЗамен - Число - сколько вхождений заменено.
//   * ПроверятьТело - Булево - проверять перед отправкой, что исходных значений в теле нет.
//   * Стиль - Строка - стиль подстановок: Правдоподобные, Метки, Выдуманные.
//   * НомераМеток - Соответствие - тип значения -> последний выданный номер метки.
//   * КешСервисаИмен - Соответствие - текст -> находки сервиса распознавания имен в этой операции.
//   * СервисИменНедоступен - Булево - сервис не ответил, в операции работают только свои правила.
//
Функция НовыйКонтекст(Знач Канал = "") Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("ИдентификаторОперации", Строка(Новый УникальныйИдентификатор));
	Контекст.Вставить("Канал", ?(ЗначениеЗаполнено(Канал), Канал, КаналЗапросыКМоделям()));
	Контекст.Вставить("Режим", Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.ПустаяСсылка());
	Контекст.Вставить("Соль", Строка(Новый УникальныйИдентификатор));
	Контекст.Вставить("ПодстановкаПоКлючу", Новый Соответствие);
	Контекст.Вставить("ОригиналПоПодстановке", Новый Соответствие);
	Контекст.Вставить("Оригиналы", Новый Соответствие);
	Контекст.Вставить("ТипыСущностей", Новый Соответствие);
	Контекст.Вставить("КоличествоЗамен", 0);
	Контекст.Вставить("ПроверятьТело", Ложь);
	Контекст.Вставить("Стиль", СтильПодстановок());
	Контекст.Вставить("НомераМеток", Новый Соответствие);
	Контекст.Вставить("ЗанятыеМетки", Новый Соответствие);
	Контекст.Вставить("КешСервисаИмен", Новый Соответствие);
	Контекст.Вставить("СервисИменНедоступен", Ложь);

	Возврат Контекст;

КонецФункции

// Готовит структуру промпта к отправке во внешнюю модель: находит персональные данные во всех
// текстовых полях и по режиму канала заменяет их подстановками, пропускает с записью в журнал
// или останавливает запрос. Исходная структура не меняется: заменяется независимая копия.
//
// Параметры:
//  СтруктураПромпта - Структура - результат КИИ_КоннекторИИ.ПодготовитьПромпт.
//  Модель - СправочникСсылка.КИИ_МоделиИИ, Неопределено - получатель запроса.
//  Контекст - Структура - см. НовыйКонтекст.
//
// Возвращаемое значение:
//  Структура - результат подготовки:
//   * Разрешено - Булево - запрос можно отправлять.
//   * СтруктураПромпта - Структура - что отправлять: копия с подстановками либо исходная структура.
//   * БылиЗамены - Булево - в отправляемой структуре есть подстановки.
//   * Решение - Строка - Выключено, Пропущено, Записано, Замаскировано, Заблокировано, Ошибка.
//   * КодОтказа - Строка - типизированная причина отказа или сбоя проверки; пустая строка, если проверка прошла.
//   * ТекстОтказа - Строка - описание причины для пользователя, без значений персональных данных.
//
Функция ПодготовитьЗапрос(Знач СтруктураПромпта, Знач Модель, Контекст) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Результат = НовыйРезультатПодготовки(СтруктураПромпта);
	Режим = РежимДляЗапроса(Контекст, Модель);
	Режимы = Перечисления.КИИ_РежимыКонтроляПерсональныхДанных;

	Если Режим = Режимы.Выключен Тогда
		Результат.Решение = "Выключено";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Копия = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураПромпта);
		Обработка = ЗамаскироватьПоляПромпта(Копия, Контекст);
	Исключение
		// Отказ детектора в защищенном режиме останавливает запрос: иначе обход появится в первой аварии.
		Возврат ОтказИлиПропуск(Результат, Режим, "ДетекторНедоступен",
			НСтр("ru = 'Проверка персональных данных не выполнилась, запрос не отправлен.'"),
			Контекст, Модель, Начало);
	КонецПопытки;

	ЗаполнитьРешение(Результат, Режим, Копия, Обработка, Контекст);

	Если Результат.Решение <> "Пропущено" Тогда
		Попытка
			ЗаписатьСобытие(Результат, Режим, Контекст, Модель, Обработка, Начало);
		Исключение
			Возврат ОтказИлиПропуск(Результат, Режим, "ЖурналНедоступен",
				НСтр("ru = 'Журнал контроля персональных данных недоступен, запрос не отправлен.'"),
				Неопределено, Модель, Начало);
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Готовит текст для отправки во внешний канал: уведомление Telegram или код диаграммы для Kroki.
//
// Параметры:
//  Канал - Строка - см. КаналУведомленияТелеграм, КаналРендерДиаграмм.
//  Текст - Строка - текст, который уйдет наружу.
//  Модель - СправочникСсылка.КИИ_МоделиИИ, Неопределено - получатель, если это модель: учитываются ее режим
//           и доверенный маршрут.
//
// Возвращаемое значение:
//  Структура - результат подготовки:
//   * Разрешено - Булево - текст можно отправлять.
//   * Текст - Строка - что отправлять.
//   * Решение - Строка - как для ПодготовитьЗапрос.
//   * КодОтказа - Строка - типизированная причина отказа.
//   * ТекстОтказа - Строка - описание причины без значений персональных данных.
//   * Контекст - Структура - контекст операции для восстановления ответа, см. НовыйКонтекст.
//
Функция ПодготовитьТекстКанала(Знач Канал, Знач Текст, Знач Модель = Неопределено) Экспорт

	Контекст = НовыйКонтекст(Канал);
	Подготовка = ПодготовитьЗапрос(Новый Структура("ПользовательскийПромпт", Текст), Модель, Контекст);

	Результат = Новый Структура;
	Результат.Вставить("Разрешено", Подготовка.Разрешено);
	Результат.Вставить("Текст", Подготовка.СтруктураПромпта.ПользовательскийПромпт);
	Результат.Вставить("Решение", Подготовка.Решение);
	Результат.Вставить("КодОтказа", Подготовка.КодОтказа);
	Результат.Вставить("ТекстОтказа", Подготовка.ТекстОтказа);
	Результат.Вставить("Контекст", Контекст);

	Возврат Результат;

КонецФункции

// Готовит поля запроса к Telegram Bot API: текст сообщения, подпись и имя файла проверяются
// по режиму канала уведомлений. Содержимое файла текстовая проверка не видит, поэтому в режиме
// «Блокировать» файл не отправляется.
//
// Параметры:
//  Поля - Структура - поля запроса (chat_id, text, caption и прочие); не меняется.
//  ИмяФайла - Строка, Неопределено - имя отправляемого файла; Неопределено - файла нет.
//
// Возвращаемое значение:
//  Структура - результат подготовки:
//   * Разрешено - Булево - запрос можно отправлять.
//   * Поля - Структура - что отправлять: новая структура, текстовые поля с подстановками.
//   * ИмяФайла - Строка, Неопределено - имя файла к отправке.
//   * Решение - Строка - как для ПодготовитьЗапрос.
//   * КодОтказа - Строка - типизированная причина отказа.
//   * ТекстОтказа - Строка - описание причины без значений персональных данных.
//
Функция ПодготовитьПоляТелеграм(Знач Поля, Знач ИмяФайла = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Разрешено", Истина);
	Результат.Вставить("Поля", Новый Структура);
	Результат.Вставить("ИмяФайла", ИмяФайла);
	Результат.Вставить("Решение", "Пропущено");
	Результат.Вставить("КодОтказа", "");
	Результат.Вставить("ТекстОтказа", "");

	Для Каждого Поле Из Поля Цикл
		Результат.Поля.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;

	ТекстовыеПоля = Новый Массив;
	Контент = Новый Массив;
	Для Каждого ИмяПоля Из СтрРазделить("text,caption", ",") Цикл
		Если Результат.Поля.Свойство(ИмяПоля) И ТипЗнч(Результат.Поля[ИмяПоля]) = Тип("Строка") Тогда
			ТекстовыеПоля.Добавить(ИмяПоля);
			Контент.Добавить(Новый Структура("Тип, Текст", "text", Результат.Поля[ИмяПоля]));
		КонецЕсли;
	КонецЦикла;
	Если ИмяФайла <> Неопределено Тогда
		Контент.Добавить(Новый Структура("Тип, ИмяФайла", "document", Строка(ИмяФайла)));
	КонецЕсли;

	Если Контент.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Подготовка = ПодготовитьЗапрос(Новый Структура("ПользовательскийПромпт", Контент), Неопределено,
		НовыйКонтекст(КаналУведомленияТелеграм()));
	ЗаполнитьЗначенияСвойств(Результат, Подготовка, "Разрешено, Решение, КодОтказа, ТекстОтказа");

	Если Не Подготовка.БылиЗамены Тогда
		Возврат Результат;
	КонецЕсли;

	Подготовленный = Подготовка.СтруктураПромпта.ПользовательскийПромпт;
	Для Индекс = 0 По ТекстовыеПоля.Количество() - 1 Цикл
		Результат.Поля.Вставить(ТекстовыеПоля[Индекс], Подготовленный[Индекс].Текст);
	КонецЦикла;
	Если ИмяФайла <> Неопределено Тогда
		Результат.ИмяФайла = Подготовленный[Подготовленный.Количество() - 1].ИмяФайла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Восстанавливает исходные значения в тексте ответа модели для показа человеку. Вызывается только
// для интерактивного представления: машинный результат, кеш, лог и мониторинг остаются с подстановками.
// Восстановление идет одним проходом слева направо, уже вставленные оригиналы повторно не обрабатываются.
//
// Параметры:
//  Текст - Строка - текст ответа модели.
//  Контекст - Структура, Неопределено - контекст операции, см. НовыйКонтекст.
//
// Возвращаемое значение:
//  Структура - результат восстановления:
//   * Текст - Строка - текст с исходными значениями.
//   * Статус - Строка - БезПодстановок, ВосстановленоПолностью, ЧастичноНеУзнано, КартаНедоступна.
//
Функция ВосстановитьДляЧеловека(Знач Текст, Знач Контекст) Экспорт

	Результат = Новый Структура("Текст, Статус", Текст, "БезПодстановок");

	Если Контекст = Неопределено Тогда
		Результат.Статус = "КартаНедоступна";
		Возврат Результат;
	КонецЕсли;

	Если Контекст.ОригиналПоПодстановке.Количество() = 0 Или Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Вхождения = ВхожденияПодстановок(Текст, Контекст);
	Результат.Текст = ТекстСОригиналами(Текст, Вхождения, Контекст);
	Результат.Статус = ?(ЕстьИскаженныеПодстановки(Текст, Контекст), "ЧастичноНеУзнано", "ВосстановленоПолностью");

	Возврат Результат;

КонецФункции

// Контрольная проверка перед отправкой: в сериализованном теле запроса не должно остаться ни одного
// исходного значения, замененного в операции. Сработка означает, что какой-то путь обошел подготовку.
//
// Параметры:
//  ТелоJSON - Строка - сериализованное тело HTTP-запроса.
//  Контекст - Структура - см. НовыйКонтекст.
//
// Возвращаемое значение:
//  Булево - Истина, если в теле найдено исходное значение.
//
Функция ТелоСодержитОригиналы(Знач ТелоJSON, Знач Контекст) Экспорт

	Если Контекст = Неопределено Или Не Контекст.ПроверятьТело Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Элемент Из Контекст.Оригиналы Цикл
		Оригинал = Элемент.Ключ;
		Если СтрНайти(ТелоJSON, Оригинал) > 0 Или СтрНайти(ТелоJSON, ЭкранированныйВJSON(Оригинал)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Текст отказа при утечке исходного значения в тело запроса.
//
// Возвращаемое значение:
//  Строка - описание причины без значений персональных данных.
//
Функция ТекстОтказаУтечки() Экспорт

	Возврат НСтр("ru = 'Контроль персональных данных: исходное значение попало в тело запроса
		|в обход подготовки. Запрос не отправлен.'");

КонецФункции

// Проверка текста для формы настроек. В модель, Telegram и журнал контроля ничего не уходит; если настроен
// сервис распознавания имен, текст проверяется и им, а его недоступность оставляет предупреждение
// в журнале регистрации.
//
// Параметры:
//  Текст - Строка - проверяемый текст.
//  Стиль - ПеречислениеСсылка.КИИ_СтилиПодстановок, Неопределено - стиль для предпросмотра до сохранения
//          настройки; Неопределено - стиль из настройки.
//
// Возвращаемое значение:
//  Структура - результат проверки:
//   * Находки - Массив из Структура - найденные значения: Тип, Значение, Начало, Длина, Уверенность, Подстановка.
//   * ТекстПослеЗамены - Строка - как текст уйдет при замене подстановками.
//
Функция ПроверитьТекст(Знач Текст, Знач Стиль = Неопределено) Экспорт

	Контекст = НовыйКонтекст();
	Если ЗначениеЗаполнено(Стиль) Тогда
		Контекст.Стиль = ОбщегоНазначения.ИмяЗначенияПеречисления(Стиль);
	КонецЕсли;
	Находки = НайтиВсеНаходки(Текст, ВключенныеТипы(), Контекст);

	Описания = Новый Массив;
	Для Каждого Находка Из Находки Цикл
		Описание = Новый Структура("Тип, Значение, Начало, Длина, Уверенность");
		ЗаполнитьЗначенияСвойств(Описание, Находка);
		Описание.Вставить("Подстановка", ПодстановкаДляНаходки(Находка, Контекст));
		Описания.Добавить(Описание);
	КонецЦикла;

	Возврат Новый Структура("Находки, ТекстПослеЗамены", Описания, ТекстСПодстановками(Текст, Находки, Контекст));

КонецФункции

// Отпечаток маршрута модели: адрес, прокси и идентификатор модели. Смена любого из них аннулирует доверие.
//
// Параметры:
//  Параметры - Структура - см. КИИ_КоннекторИИ.ПараметрыМодели.
//
// Возвращаемое значение:
//  Строка - отпечаток SHA-256 в шестнадцатеричном виде.
//
Функция ОтпечатокМаршрута(Знач Параметры) Экспорт

	Части = Новый Массив;
	Части.Добавить(НРег(СокрЛП(Параметры.Адрес)));
	Части.Добавить(Строка(Параметры.ИспользоватьПрокси));
	Части.Добавить(СокрЛП(Параметры.НаименованиеПолное));
	Если Параметры.ИспользоватьПрокси Тогда
		УстановитьПривилегированныйРежим(Истина);
		Части.Добавить(СокрЛП(Константы.КИИ_АдресПроксиИнтернет.Получить()));
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	Возврат ХешСтроки(СтрСоединить(Части, "|"));

КонецФункции

// Регламентная очистка журнала контроля по сроку хранения.
//
Процедура ОчиститьЖурналКонтроля() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.КИИ_ОчисткаЖурналаКонтроляПерсональныхДанных);

	УстановитьПривилегированныйРежим(Истина);
	СрокДней = Константы.КИИ_СрокХраненияСобытийКонтроля.Получить();
	Если СрокДней <= 0 Тогда
		СрокДней = 30;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Журнал.ИдентификаторСобытия КАК ИдентификаторСобытия
		|ИЗ
		|	РегистрСведений.КИИ_ЖурналКонтроляПерсональныхДанных КАК Журнал
		|ГДЕ
		|	Журнал.Момент < &Граница";
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - СрокДней * 86400);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.КИИ_ЖурналКонтроляПерсональныхДанных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторСобытия.Установить(Выборка.ИдентификаторСобытия);
		НаборЗаписей.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Разбирает ответ сервиса распознавания имен. Значения ищутся в тексте заново, а не по смещениям сервиса:
// Python и 1С считают символы по-разному (эмодзи в уведомлениях), а значение надежнее позиции.
//
// Параметры:
//  Текст - Строка - текст, отправленный сервису.
//  Ответ - Структура - ответ сервиса: ok, entities - массив из Структура (type, text, form, gender).
//  Типы - Массив из Строка, Неопределено - включенные типы; Неопределено - все.
//
// Возвращаемое значение:
//  Массив из Структура - находки в формате КИИ_ПравилаПерсональныхДанных.НайтиСущности, все вхождения каждого
//  значения, с уверенностью «Средняя» и детектором «Natasha».
//
Функция РазобратьОтветСервисаИмен(Знач Текст, Знач Ответ, Знач Типы) Экспорт

	Находки = Новый Массив;
	Сущности = Неопределено;
	Успех = Неопределено;
	ПоПротоколу = ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("ok", Успех) И Успех = Истина
		И Ответ.Свойство("entities", Сущности) И ТипЗнч(Сущности) = Тип("Массив");
	Если Не ПоПротоколу Тогда
		ВызватьИсключение НСтр("ru = 'Сервис распознавания имен вернул ответ неизвестного формата'");
	КонецЕсли;

	Учтенные = Новый Соответствие;
	Для Каждого Сущность Из Сущности Цикл
		ПроверитьСущностьСервиса(Сущность);
		Находка = НаходкаСервиса(Сущность, Типы);
		Если Находка = Неопределено Или Учтенные[Находка.Тип + "|" + Находка.Значение] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтенные.Вставить(Находка.Тип + "|" + Находка.Значение, Истина);
		ДобавитьВхождения(Находки, Текст, Находка);
	КонецЦикла;

	Возврат Находки;

КонецФункции

// Проверка сервиса для формы настроек: запрос /health по введенному или сохраненному адресу.
//
// Параметры:
//  Адрес - Строка, Неопределено - адрес, введенный в форме до сохранения; Неопределено - сохраненный.
//  Таймаут - Число, Неопределено - таймаут в секундах; Неопределено или 0 - сохраненный.
//
// Возвращаемое значение:
//  Структура - результат:
//   * Доступен - Булево - сервис ответил.
//   * Текст - Строка - что ответил сервис или почему не удалось.
//
Функция ПроверитьСервисИмен(Знач Адрес = Неопределено, Знач Таймаут = Неопределено) Экспорт

	Результат = Новый Структура("Доступен, Текст", Ложь, НСтр("ru = 'Адрес сервиса не заполнен.'"));
	Настройки = НастройкиСервисаИмен();
	Если Адрес <> Неопределено Тогда
		Настройки.Адрес = СокрЛП(Адрес);
	КонецЕсли;
	Если ЗначениеЗаполнено(Таймаут) И Таймаут > 0 Тогда
		Настройки.Таймаут = Таймаут;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Настройки.Адрес) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Ответ = ВызватьСервисИмен(Настройки, "health", Неопределено);
		Результат.Текст = СтрШаблон(НСтр("ru = 'Сервис отвечает: %1 %2.'"), Ответ.service, Ответ.version);
		Результат.Доступен = Истина;
	Исключение
		Результат.Текст = СтрШаблон(НСтр("ru = 'Сервис не ответил: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Режимы

Функция РежимДляЗапроса(Знач Контекст, Знач Модель)

	Если ЗначениеЗаполнено(Контекст.Режим) Тогда
		Возврат Контекст.Режим;
	КонецЕсли;

	Режим = РежимКанала(Контекст.Канал);

	Если Не ЗначениеЗаполнено(Модель) Тогда
		Возврат Режим;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Модель,
		"РежимКонтроляПерсональныхДанных, МаршрутДоверенный, ОтпечатокДоверенногоМаршрута");
	УстановитьПривилегированныйРежим(Ложь);

	Если ЗначениеЗаполнено(Реквизиты.РежимКонтроляПерсональныхДанных) Тогда
		Режим = Реквизиты.РежимКонтроляПерсональныхДанных;
	КонецЕсли;

	Если МаршрутДоверен(Модель, Реквизиты) Тогда
		Возврат Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Выключен;
	КонецЕсли;

	Возврат Режим;

КонецФункции

// Пустая или неизвестная настройка защиту не отключает: берется режим канала по умолчанию.
Функция РежимКанала(Знач Канал)

	Режимы = Перечисления.КИИ_РежимыКонтроляПерсональныхДанных;

	УстановитьПривилегированныйРежим(Истина);
	Если Канал = КаналУведомленияТелеграм() Тогда
		Режим = Константы.КИИ_РежимКонтроляУведомленийТелеграм.Получить();
		ПоУмолчанию = Режимы.Маскировать;
	ИначеЕсли Канал = КаналРендерДиаграмм() Тогда
		Режим = ?(Константы.КИИ_РендерДиаграммДоверенный.Получить(), Режимы.Выключен,
			Константы.КИИ_РежимКонтроляРендераДиаграмм.Получить());
		ПоУмолчанию = Режимы.Логировать;
	Иначе
		Режим = Константы.КИИ_РежимКонтроляЗапросовКМоделям.Получить();
		ПоУмолчанию = Режимы.Маскировать;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат ?(ЗначениеЗаполнено(Режим), Режим, ПоУмолчанию);

КонецФункции

Функция МаршрутДоверен(Знач Модель, Знач Реквизиты)

	Если Не Реквизиты.МаршрутДоверенный Или Не ЗначениеЗаполнено(Реквизиты.ОтпечатокДоверенногоМаршрута) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Доверие привязано к отпечатку: сменили адрес, прокси или модель - доверие аннулировано.
	Возврат Реквизиты.ОтпечатокДоверенногоМаршрута = ОтпечатокМаршрута(КИИ_КоннекторИИ.ПараметрыМодели(Модель));

КонецФункции

Функция ВключенныеТипы()

	УстановитьПривилегированныйРежим(Истина);
	Настройка = Константы.КИИ_ВключенныеПравилаПерсональныхДанных.Получить();
	УстановитьПривилегированныйРежим(Ложь);

	Известные = СтрРазделить("СНИЛС,КАРТА,ИНН,ПАСПОРТ,EMAIL,ТЕЛЕФОН,ФИО,ОРГАНИЗАЦИЯ,АДРЕС,ДАТАРОЖДЕНИЯ", ",");
	Типы = Новый Массив;
	Для Каждого Элемент Из СтрРазделить(ВРег(Настройка), ",", Ложь) Цикл
		Если Известные.Найти(СокрЛП(Элемент)) <> Неопределено Тогда
			Типы.Добавить(СокрЛП(Элемент));
		КонецЕсли;
	КонецЦикла;

	// Пустая или испорченная настройка не отключает правила: включены все.
	Возврат ?(Типы.Количество() = 0, Неопределено, Типы);

КонецФункции

#КонецОбласти

#Область Подготовка

Функция НовыйРезультатПодготовки(Знач СтруктураПромпта)

	Результат = Новый Структура;
	Результат.Вставить("Разрешено", Истина);
	Результат.Вставить("СтруктураПромпта", СтруктураПромпта);
	Результат.Вставить("БылиЗамены", Ложь);
	Результат.Вставить("Решение", "Пропущено");
	Результат.Вставить("КодОтказа", "");
	Результат.Вставить("ТекстОтказа", "");

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьРешение(Результат, Знач Режим, Знач Копия, Знач Обработка, Контекст)

	Режимы = Перечисления.КИИ_РежимыКонтроляПерсональныхДанных;
	НайденыДанные = Обработка.Замен > 0;

	Если Режим = Режимы.Логировать Тогда
		Результат.Решение = ?(НайденыДанные, "Записано", "Пропущено");
		Возврат;
	КонецЕсли;

	Если Обработка.НеПоддержано.Количество() > 0 Тогда
		Отказать(Результат, "НеподдержанноеПоле",
			НСтр("ru = 'В запросе есть поле, которое контроль персональных данных не умеет проверять. Запрос не отправлен.'"));
		Возврат;
	КонецЕсли;

	Если Режим = Режимы.Блокировать И НайденыДанные Тогда
		Шаблон = НСтр("ru = 'В запросе найдены персональные данные (%1), режим канала запрещает отправку.'");
		Типы = ТипыСтрокой(Контекст);
		Отказать(Результат, "НайденыПерсональныеДанные", СтрШаблон(Шаблон, Типы));
		Возврат;
	КонецЕсли;

	Если Режим = Режимы.Блокировать И Обработка.ЕстьВложения Тогда
		Отказать(Результат, "ВложенияПриБлокировке",
			НСтр("ru = 'В запросе есть вложения: их содержимое проверить нельзя, режим канала запрещает отправку.'"));
		Возврат;
	КонецЕсли;

	Если Не НайденыДанные Тогда
		Возврат;
	КонецЕсли;

	Если Контекст.Канал = КаналЗапросыКМоделям() Тогда
		ДобавитьИнструкциюМодели(Копия);
	КонецЕсли;
	Результат.СтруктураПромпта = Копия;
	Результат.БылиЗамены = Истина;
	Результат.Решение = "Замаскировано";
	Контекст.ПроверятьТело = Истина;

КонецПроцедуры

Процедура Отказать(Результат, Знач КодОтказа, Знач ТекстОтказа)

	Результат.Разрешено = Ложь;
	Результат.Решение = "Заблокировано";
	Результат.КодОтказа = КодОтказа;
	Результат.ТекстОтказа = ТекстОтказа;

КонецПроцедуры

// В режиме «Логировать» сбой не останавливает запрос, в защищенных режимах - останавливает.
Функция ОтказИлиПропуск(Результат, Знач Режим, Знач КодОтказа, Знач ТекстОтказа, Знач Контекст,
	Знач Модель, Знач Начало)

	// В «Логировать» запрос уходит, но сбой проверки все равно попадает в журнал с кодом причины.
	Если Режим <> Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Логировать Тогда
		Отказать(Результат, КодОтказа, ТекстОтказа);
	КонецЕсли;
	Результат.Решение = "Ошибка";
	Результат.КодОтказа = КодОтказа;

	// Журнал контроля недоступен (контекст не передан) или сам упал - след остается в журнале регистрации.
	// Текст исключения туда не пишется: в нем могут оказаться значения из проверяемого текста.
	ЗаписаноВЖурнал = Ложь;
	Если Контекст <> Неопределено Тогда
		Попытка
			ЗаписатьСобытие(Результат, Режим, Контекст, Модель, Неопределено, Начало);
			ЗаписаноВЖурнал = Истина;
		Исключение
			ЗаписаноВЖурнал = Ложь;
		КонецПопытки;
	КонецЕсли;
	Если Не ЗаписаноВЖурнал Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'КИИ.КонтрольПерсональныхДанных'"),
			УровеньЖурналаРегистрации.Предупреждение, , , КодОтказа);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ДобавитьИнструкциюМодели(СтруктураПромпта)

	Инструкция = НСтр("ru = 'Часть значений в запросе заменена условными подстановками: выдуманными значениями
		|или метками вида [ФИО-1]. Используй их дословно, как написано: не склоняй, не исправляй и не заменяй
		|другими значениями.'");

	// В агентском сценарии системный промпт не доходит до модели: сообщения идут массивом дословно.
	СырыеСообщения = Неопределено;
	СтруктураПромпта.Свойство("СырыеСообщения", СырыеСообщения);
	Если ТипЗнч(СырыеСообщения) = Тип("Массив") И СырыеСообщения.Количество() > 0 Тогда
		СтруктураПромпта.СырыеСообщения.Вставить(0, Новый Структура("role, content", "system", Инструкция));
		Возврат;
	КонецЕсли;

	Если СтруктураПромпта.Свойство("СистемныйПромпт") И ЗначениеЗаполнено(СтруктураПромпта.СистемныйПромпт) Тогда
		СтруктураПромпта.СистемныйПромпт = СтруктураПромпта.СистемныйПромпт + Символы.ПС + Инструкция;
	Иначе
		СтруктураПромпта.Вставить("СистемныйПромпт", Инструкция);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбходПолей

// Закрытый перечень полей: что не распознано - НеПоддержано, а не «пропустим».
Функция ЗамаскироватьПоляПромпта(СтруктураПромпта, Контекст)

	Обработка = Новый Структура("Замен, НеПоддержано, ЕстьВложения", 0, Новый Массив, Ложь);
	ЗаменДо = Контекст.КоличествоЗамен;
	Типы = ВключенныеТипы();

	// Литерал «[ФИО-1]» в позднем поле не должен совпасть с меткой, выданной в раннем.
	Если Контекст.Стиль = "Метки" Тогда
		Для Каждого Строка Из СтрокиЗначения(СтруктураПромпта, Новый Массив) Цикл
			ЗарезервироватьМетки(Строка, Контекст);
		КонецЦикла;
	КонецЕсли;

	Если СтруктураПромпта.Свойство("СистемныйПромпт") Тогда
		СтруктураПромпта.СистемныйПромпт = ЗамаскироватьЗначение(СтруктураПромпта.СистемныйПромпт,
			"СистемныйПромпт", Контекст, Типы, Обработка);
	КонецЕсли;

	Если СтруктураПромпта.Свойство("ПользовательскийПромпт") Тогда
		СтруктураПромпта.ПользовательскийПромпт = ЗамаскироватьКонтент(СтруктураПромпта.ПользовательскийПромпт,
			"ПользовательскийПромпт", Контекст, Типы, Обработка);
	КонецЕсли;

	Если СтруктураПромпта.Свойство("ИсторияСообщений") Тогда
		ЗамаскироватьИсторию(СтруктураПромпта.ИсторияСообщений, Контекст, Типы, Обработка);
	КонецЕсли;

	Если СтруктураПромпта.Свойство("СырыеСообщения") Тогда
		ЗамаскироватьСырыеСообщения(СтруктураПромпта.СырыеСообщения, Контекст, Типы, Обработка);
	КонецЕсли;

	// Инструменты не проверяются: их объявления пишет разработчик расширения, данных пользователя там нет.
	Обработка.Замен = Контекст.КоличествоЗамен - ЗаменДо;

	Возврат Обработка;

КонецФункции

// Все строки значения: обход структур, соответствий и массивов в глубину, прочие типы пропускаются.
Функция СтрокиЗначения(Знач Значение, Строки)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Строки.Добавить(Значение);
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Значение Цикл
			СтрокиЗначения(Элемент.Значение, Строки);
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			СтрокиЗначения(Элемент, Строки);
		КонецЦикла;
	Иначе
		// Числа, даты и двоичные данные вложений строк пользователя не содержат.
		Возврат Строки;
	КонецЕсли;

	Возврат Строки;

КонецФункции

Функция ЗамаскироватьЗначение(Знач Значение, Знач ИмяПоля, Контекст, Знач Типы, Обработка)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ЗамаскироватьТекст(Значение, Контекст, Типы);
	КонецЕсли;

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Значение;
	КонецЕсли;

	Обработка.НеПоддержано.Добавить(ИмяПоля);
	Возврат Значение;

КонецФункции

// В имени файла слова часто разделены подчеркиванием: «Выписка_ИНН_7707083893.xlsx». Для поиска
// подчеркивания читаются как пробелы; если замен нет, имя уходит нетронутым.
Функция ЗамаскироватьИмяФайла(Знач ИмяФайла, Знач ИмяПоля, Контекст, Знач Типы, Обработка)

	Если ТипЗнч(ИмяФайла) <> Тип("Строка") Или СтрНайти(ИмяФайла, "_") = 0 Тогда
		Возврат ЗамаскироватьЗначение(ИмяФайла, ИмяПоля, Контекст, Типы, Обработка);
	КонецЕсли;

	СПробелами = СтрЗаменить(ИмяФайла, "_", " ");
	Замаскированное = ЗамаскироватьЗначение(СПробелами, ИмяПоля, Контекст, Типы, Обработка);

	Возврат ?(Замаскированное = СПробелами, ИмяФайла, Замаскированное);

КонецФункции

Функция ЗамаскироватьКонтент(Знач Контент, Знач ИмяПоля, Контекст, Знач Типы, Обработка)

	Если ТипЗнч(Контент) <> Тип("Массив") Тогда
		Возврат ЗамаскироватьЗначение(Контент, ИмяПоля, Контекст, Типы, Обработка);
	КонецЕсли;

	Для Каждого Элемент Из Контент Цикл
		ЗамаскироватьЭлементКонтента(Элемент, ИмяПоля, Контекст, Типы, Обработка);
	КонецЦикла;

	Возврат Контент;

КонецФункции

Процедура ЗамаскироватьЭлементКонтента(Элемент, Знач ИмяПоля, Контекст, Знач Типы, Обработка)

	Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
		Обработка.НеПоддержано.Добавить(ИмяПоля);
		Возврат;
	КонецЕсли;

	ТипЭлемента = "";
	Элемент.Свойство("Тип", ТипЭлемента);

	Если ТипЭлемента = "text" Тогда
		Элемент.Текст = ЗамаскироватьЗначение(Элемент.Текст, ИмяПоля, Контекст, Типы, Обработка);
		Возврат;
	КонецЕсли;

	Если ТипЭлемента = "image" Или ТипЭлемента = "document" Тогда
		// Содержимое файла текстовая маскировка не трогает; имя файла проверяется как текст.
		Обработка.ЕстьВложения = Истина;
		Если Элемент.Свойство("ИмяФайла") Тогда
			Элемент.ИмяФайла = ЗамаскироватьИмяФайла(Элемент.ИмяФайла, ИмяПоля, Контекст, Типы, Обработка);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Обработка.НеПоддержано.Добавить(ИмяПоля);

КонецПроцедуры

Процедура ЗамаскироватьИсторию(ИсторияСообщений, Контекст, Знач Типы, Обработка)

	Если ТипЗнч(ИсторияСообщений) <> Тип("Массив") Тогда
		Обработка.НеПоддержано.Добавить("ИсторияСообщений");
		Возврат;
	КонецЕсли;

	Для Каждого Сообщение Из ИсторияСообщений Цикл
		Если ТипЗнч(Сообщение) = Тип("Структура") И Сообщение.Свойство("Текст") Тогда
			Сообщение.Текст = ЗамаскироватьКонтент(Сообщение.Текст, "ИсторияСообщений", Контекст, Типы, Обработка);
		Иначе
			Обработка.НеПоддержано.Добавить("ИсторияСообщений");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗамаскироватьСырыеСообщения(СырыеСообщения, Контекст, Знач Типы, Обработка)

	Если ТипЗнч(СырыеСообщения) <> Тип("Массив") Тогда
		Обработка.НеПоддержано.Добавить("СырыеСообщения");
		Возврат;
	КонецЕсли;

	Для Каждого Сообщение Из СырыеСообщения Цикл

		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Обработка.НеПоддержано.Добавить("СырыеСообщения");
			Продолжить;
		КонецЕсли;

		Если Сообщение.Свойство("content") Тогда
			Сообщение.content = ЗамаскироватьЧастиСообщения(Сообщение.content, Контекст, Типы, Обработка);
		КонецЕсли;

		Если Сообщение.Свойство("tool_calls") И ТипЗнч(Сообщение.tool_calls) = Тип("Массив") Тогда
			ЗамаскироватьВызовыИнструментов(Сообщение.tool_calls, Контекст, Типы, Обработка);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// content сообщения OpenAI: строка либо массив частей {type, text}.
Функция ЗамаскироватьЧастиСообщения(Знач Содержимое, Контекст, Знач Типы, Обработка)

	Если ТипЗнч(Содержимое) <> Тип("Массив") Тогда
		Возврат ЗамаскироватьЗначение(Содержимое, "СырыеСообщения", Контекст, Типы, Обработка);
	КонецЕсли;

	Для Каждого Часть Из Содержимое Цикл
		Если ТипЗнч(Часть) = Тип("Структура") И Часть.Свойство("text") Тогда
			Часть.text = ЗамаскироватьЗначение(Часть.text, "СырыеСообщения", Контекст, Типы, Обработка);
		ИначеЕсли ТипЗнч(Часть) = Тип("Структура") И Часть.Свойство("image_url") Тогда
			Обработка.ЕстьВложения = Истина;
		Иначе
			Обработка.НеПоддержано.Добавить("СырыеСообщения");
		КонецЕсли;
	КонецЦикла;

	Возврат Содержимое;

КонецФункции

// Аргументы вызова - строка JSON от модели: подстановки в ней безопасны, их символы в JSON не экранируются.
Процедура ЗамаскироватьВызовыИнструментов(ВызовыИнструментов, Контекст, Знач Типы, Обработка)

	Для Каждого Вызов Из ВызовыИнструментов Цикл
		Если ЭтоВызовСАргументами(Вызов) Тогда
			Вызов.function.arguments = ЗамаскироватьЗначение(Вызов.function.arguments, "СырыеСообщения",
				Контекст, Типы, Обработка);
		Иначе
			Обработка.НеПоддержано.Добавить("СырыеСообщения");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЭтоВызовСАргументами(Знач Вызов)

	Если ТипЗнч(Вызов) <> Тип("Структура") Или Не Вызов.Свойство("function") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТипЗнч(Вызов.function) = Тип("Структура") И Вызов.function.Свойство("arguments");

КонецФункции

Функция ЗамаскироватьТекст(Знач Текст, Контекст, Знач Типы)

	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	Находки = НайтиВсеНаходки(Текст, Типы, Контекст);

	Если Находки.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Возврат ТекстСПодстановками(Текст, Находки, Контекст);

КонецФункции

Функция ТекстСПодстановками(Знач Текст, Знач Находки, Контекст)

	Части = Новый Массив;
	Позиция = 1;
	Для Каждого Находка Из Находки Цикл
		Части.Добавить(Сред(Текст, Позиция, Находка.Начало - Позиция));
		Части.Добавить(ПодстановкаДляНаходки(Находка, Контекст));
		Позиция = Находка.Начало + Находка.Длина;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Позиция));

	Возврат СтрСоединить(Части, "");

КонецФункции

#КонецОбласти

#Область СервисРаспознаванияИмен

// Находки своих правил и сервиса распознавания имен, без пересечений.
Функция НайтиВсеНаходки(Знач Текст, Знач Типы, Контекст)

	Если Контекст.Стиль = "Метки" Тогда
		ЗарезервироватьМетки(Текст, Контекст);
	КонецЕсли;
	Находки = КИИ_ПравилаПерсональныхДанных.НайтиСущности(Текст, Типы);
	Для Каждого Находка Из НаходкиСервисаИмен(Текст, Типы, Контекст) Цикл
		Находки.Добавить(Находка);
	КонецЦикла;

	Возврат КИИ_ПравилаПерсональныхДанных.РазрешитьПересечения(Находки);

КонецФункции

// Сервис спрашивается один раз на текст в пределах операции: агентская петля повторяет историю в каждом раунде.
// Недоступный сервис по умолчанию не останавливает работу - остаются свои правила, а в журнале регистрации
// остается предупреждение. С флажком «Без сервиса не отправлять» сбой становится отказом проверки.
Функция НаходкиСервисаИмен(Знач Текст, Знач Типы, Контекст)

	Если Не НужныТипыСервиса(Типы) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Настройки = НастройкиСервисаИмен();
	Если Не ЗначениеЗаполнено(Настройки.Адрес) Тогда
		// Обязательный сервис без адреса - та же недоступность: без проверки именами отправлять нельзя.
		Если Настройки.Обязателен Тогда
			ВызватьИсключение НСтр("ru = 'Сервис распознавания имен обязателен, но его адрес не заполнен'");
		КонецЕсли;
		Возврат Новый Массив;
	КонецЕсли;
	Если Контекст.СервисИменНедоступен Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Сохраненные = Контекст.КешСервисаИмен[Текст];
	Если Сохраненные <> Неопределено Тогда
		Возврат Сохраненные;
	КонецЕсли;

	// Разбор - в той же попытке, что и вызов: ответ не по протоколу значит, что сервис текст не проверил.
	Попытка
		Ответ = ВызватьСервисИмен(Настройки, "detect", Новый Структура("text", Текст));
		Находки = РазобратьОтветСервисаИмен(Текст, Ответ, Типы);
	Исключение
		Если Настройки.Обязателен Тогда
			ВызватьИсключение НСтр("ru = 'Сервис распознавания имен недоступен, а без него отправка запрещена'");
		КонецЕсли;
		Контекст.СервисИменНедоступен = Истина;
		ИмяСобытия = НСтр("ru = 'КИИ.КонтрольПерсональныхДанных'");
		Сообщение = НСтр("ru = 'Сервис распознавания имен недоступен: проверка идет только своими правилами'");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , Сообщение);
		Возврат Новый Массив;
	КонецПопытки;

	Контекст.КешСервисаИмен.Вставить(Текст, Находки);

	Возврат Находки;

КонецФункции

// Элемент без типа или текста - ответ не по протоколу: пропустить его молча нельзя, в нем могло быть имя.
Процедура ПроверитьСущностьСервиса(Знач Сущность)

	ТипСущности = Неопределено;
	Значение = Неопределено;
	ПоПротоколу = ТипЗнч(Сущность) = Тип("Структура") И Сущность.Свойство("type", ТипСущности)
		И Сущность.Свойство("text", Значение) И ТипЗнч(ТипСущности) = Тип("Строка")
		И ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(Значение));
	Если Не ПоПротоколу Тогда
		ВызватьИсключение НСтр("ru = 'Сервис распознавания имен вернул элемент неизвестного формата'");
	КонецЕсли;

КонецПроцедуры

Функция НужныТипыСервиса(Знач Типы)

	Если Типы = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Тип Из СтрРазделить("ФИО,ОРГАНИЗАЦИЯ,АДРЕС,ДАТАРОЖДЕНИЯ", ",") Цикл
		Если Типы.Найти(Тип) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НастройкиСервисаИмен()

	УстановитьПривилегированныйРежим(Истина);
	Настройки = Новый Структура;
	Настройки.Вставить("Адрес", СокрЛП(Константы.КИИ_АдресСервисаРаспознаванияИмен.Получить()));
	Настройки.Вставить("Таймаут", Константы.КИИ_ТаймаутСервисаРаспознаванияИмен.Получить());
	Настройки.Вставить("Обязателен", Константы.КИИ_СервисРаспознаванияИменОбязателен.Получить());
	УстановитьПривилегированныйРежим(Ложь);

	Если Настройки.Таймаут <= 0 Тогда
		Настройки.Таймаут = 5;
	КонецЕсли;

	Возврат Настройки;

КонецФункции

// Сервис стоит в контуре рядом с 1С, поэтому ходим напрямую, без прокси из настроек интернета.
Функция ВызватьСервисИмен(Знач Настройки, Знач Метод, Знач Тело)

	Адрес = ОбщегоНазначенияКлиентСервер.СтруктураURI(Настройки.Адрес);
	Порт = 80;
	ЗащищенноеСоединение = Неопределено;
	Если НРег(Адрес.Схема) = "https" Тогда
		Порт = 443;
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
	КонецЕсли;
	Если ЗначениеЗаполнено(Адрес.Порт) Тогда
		Порт = Число(Адрес.Порт);
	КонецЕсли;
	Соединение = Новый HTTPСоединение(Адрес.Хост, Порт, , , , Настройки.Таймаут, ЗащищенноеСоединение);

	Путь = Адрес.ПутьНаСервере;
	Если Не СтрЗаканчиваетсяНа(Путь, "/") Тогда
		Путь = Путь + "/";
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Путь + Метод);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Если Тело = Неопределено Тогда
		Ответ = Соединение.Получить(Запрос);
	Иначе
		Запрос.УстановитьТелоИзСтроки(ОбщегоНазначения.ЗначениеВJSON(Тело), КодировкаТекста.UTF8,
			ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	КонецЕсли;

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Сервис распознавания имен вернул код %1'"), Ответ.КодСостояния);
	КонецЕсли;

	Возврат ОбщегоНазначения.JSONВЗначение(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), , Ложь);

КонецФункции

Функция НаходкаСервиса(Знач Сущность, Знач Типы)

	Тип = "";
	Значение = "";
	Если ТипЗнч(Сущность) <> Тип("Структура") Или Не Сущность.Свойство("type", Тип)
		Или Не Сущность.Свойство("text", Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = СокрЛП(Значение);
	Если Не ЗначениеЗаполнено(Значение) Или Не ТипНаходкиСервиса(Тип, Типы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Для ФИО детектор несет порядок частей и род: «Natasha:LF:f» - фамилия, имя, женский.
	Детектор = "Natasha";
	Если Тип = "ФИО" Тогда
		Форма = "";
		Род = "";
		Сущность.Свойство("form", Форма);
		Сущность.Свойство("gender", Род);
		Детектор = СтрШаблон("Natasha:%1:%2", Форма, Род);
	КонецЕсли;

	Находка = Новый Структура;
	Находка.Вставить("Тип", Тип);
	Находка.Вставить("Значение", Значение);
	Находка.Вставить("НормализованныйКлюч", КИИ_ПравилаПерсональныхДанных.НормализоватьЗначение(Тип, Значение));
	Находка.Вставить("Начало", 0);
	Находка.Вставить("Длина", СтрДлина(Значение));
	Находка.Вставить("Уверенность", "Средняя");
	Находка.Вставить("Детектор", Детектор);

	Возврат Находка;

КонецФункции

Функция ТипНаходкиСервиса(Знач Тип, Знач Типы)

	Если СтрНайти(",ФИО,ОРГАНИЗАЦИЯ,АДРЕС,ДАТАРОЖДЕНИЯ,", "," + Тип + ",") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Типы = Неопределено Или Типы.Найти(Тип) <> Неопределено;

КонецФункции

Процедура ДобавитьВхождения(Находки, Знач Текст, Знач Образец)

	Позиция = СтрНайти(Текст, Образец.Значение);
	Пока Позиция > 0 Цикл
		Находка = Новый Структура;
		Для Каждого Поле Из Образец Цикл
			Находка.Вставить(Поле.Ключ, Поле.Значение);
		КонецЦикла;
		Находка.Начало = Позиция;
		Находки.Добавить(Находка);
		Позиция = СледующееВхождение(Текст, Образец.Значение, Позиция + Образец.Длина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Подстановки

// Подстановка детерминирована внутри операции: одно значение - одна подстановка. Карта взаимно
// однозначна: кандидат, уже занятый другим значением или совпавший с исходным, отбрасывается.
Функция ПодстановкаДляНаходки(Знач Находка, Контекст)

	// Значение уже является подстановкой этой операции (агентская петля несет прошлые ответы модели):
	// повторно не заменяется, иначе цепочка восстановления порвется.
	Если Контекст.ОригиналПоПодстановке[Находка.Значение] <> Неопределено Тогда
		Возврат Находка.Значение;
	КонецЕсли;

	Ключ = Находка.Тип + "|" + Находка.НормализованныйКлюч;
	Подстановка = Контекст.ПодстановкаПоКлючу[Ключ];

	Если Подстановка = Неопределено Тогда
		Подстановка = НоваяПодстановка(Находка, Ключ, Контекст);
		Контекст.ПодстановкаПоКлючу.Вставить(Ключ, Подстановка);
		Контекст.ОригиналПоПодстановке.Вставить(Подстановка, Находка.Значение);
	КонецЕсли;

	Контекст.Оригиналы.Вставить(Находка.Значение, Истина);
	Контекст.ТипыСущностей.Вставить(Находка.Тип, Истина);
	Контекст.КоличествоЗамен = Контекст.КоличествоЗамен + 1;

	Возврат Подстановка;

КонецФункции

Функция НоваяПодстановка(Знач Находка, Знач Ключ, Знач Контекст)

	// Метка нумеруется по типу и уникальна по построению: подбирать варианты не нужно.
	Если Контекст.Стиль = "Метки" Тогда
		Возврат НоваяМетка(Находка.Тип, Контекст);
	КонецЕсли;

	Набор = НаборИмен(Контекст.Стиль = "Выдуманные");
	Для НомерВарианта = 0 По 99 Цикл
		Хеш = ХешСтроки(Контекст.Соль + "|" + Ключ + "|" + Формат(НомерВарианта, "ЧН=0; ЧГ=0"));
		Набор.Вставить("НомерВарианта", НомерВарианта);
		Кандидат = СгенерироватьПодстановку(Находка, Хеш, Набор);
		Занят = Контекст.ОригиналПоПодстановке[Кандидат] <> Неопределено
			Или Контекст.Оригиналы[Кандидат] <> Неопределено
			Или Кандидат = Находка.Значение;
		Если Не Занят Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;

	// Сто вариантов заняты (сотни организаций одной формы в операции): метка уникальна по построению,
	// и запрос не блокируется из-за исчерпания словаря.
	Возврат НоваяМетка(Находка.Тип, Контекст);

КонецФункции

// Подстановки берутся из заведомо несуществующих диапазонов: телефон с кодом 000, почта
// на зарезервированном домене example.com, ИНН с регионом 00, СНИЛС 000, карта с BIN 0000,
// паспорт серии 00 00. Формат и контрольные суммы валидны, принадлежать человеку значение не может.
Функция СгенерироватьПодстановку(Знач Находка, Знач Хеш, Знач Набор)

	Если Находка.Тип = "ФИО" Тогда
		Возврат ПодстановкаФИО(Находка, Хеш, Набор);
	КонецЕсли;

	Если Находка.Тип = "ОРГАНИЗАЦИЯ" Тогда
		Возврат ПодстановкаОрганизации(Находка.Значение, Хеш, Набор.Выдуманные, Набор.НомерВарианта);
	КонецЕсли;

	Если Находка.Тип = "АДРЕС" Тогда
		Возврат ПодстановкаАдреса(Хеш, Набор.Выдуманные);
	КонецЕсли;

	// Дата рождения - первое января года из прошлого века: формат прежний, на человека не указывает.
	Если Находка.Тип = "ДАТАРОЖДЕНИЯ" Тогда
		Возврат "01.01.19" + ЦифрыИзХеша(Хеш, 2);
	КонецЕсли;

	Если Находка.Тип = "EMAIL" Тогда
		Возврат "user." + Лев(Хеш, 8) + "@example.com";
	КонецЕсли;

	Если Находка.Тип = "ТЕЛЕФОН" Тогда
		Цифры = ЦифрыИзХеша(Хеш, 7);
		Возврат "+7 000 " + Лев(Цифры, 3) + "-" + Сред(Цифры, 4, 2) + "-" + Сред(Цифры, 6, 2);
	КонецЕсли;

	Если Находка.Тип = "ИНН" Тогда
		Возврат ПодстановкаИНН(СтрДлина(Находка.НормализованныйКлюч), Хеш);
	КонецЕсли;

	Если Находка.Тип = "СНИЛС" Тогда
		Возврат ПодстановкаСНИЛС(Хеш);
	КонецЕсли;

	Если Находка.Тип = "КАРТА" Тогда
		Возврат ПодстановкаКарты(Хеш);
	КонецЕсли;

	Если Находка.Тип = "ПАСПОРТ" Тогда
		Возврат "00 00 " + ЦифрыИзХеша(Хеш, 6);
	КонецЕсли;

	ВызватьИсключение СтрШаблон(НСтр("ru = 'Нет генератора подстановок для типа %1'"), Находка.Тип);

КонецФункции

Функция ПодстановкаИНН(Знач Длина, Знач Хеш)

	Если Длина = 12 Тогда
		Основа = "00" + ЦифрыИзХеша(Хеш, 8);
		Одиннадцатая = КонтрольнаяЦифраИНН(Основа, "7,2,4,10,3,5,9,4,6,8");
		Двенадцатая = КонтрольнаяЦифраИНН(Основа + Одиннадцатая, "3,7,2,4,10,3,5,9,4,6,8");
		Возврат Основа + Одиннадцатая + Двенадцатая;
	КонецЕсли;

	Основа = "00" + ЦифрыИзХеша(Хеш, 7);
	Возврат Основа + КонтрольнаяЦифраИНН(Основа, "2,4,10,3,5,9,4,6,8");

КонецФункции

Функция КонтрольнаяЦифраИНН(Знач Цифры, Знач СтрокаВесов)

	Веса = СтрРазделить(СтрокаВесов, ",");
	Сумма = 0;
	Для Позиция = 1 По Веса.Количество() Цикл
		Сумма = Сумма + Число(Сред(Цифры, Позиция, 1)) * Число(Веса[Позиция - 1]);
	КонецЦикла;

	Возврат Формат(Сумма % 11 % 10, "ЧН=0; ЧГ=0");

КонецФункции

Функция ПодстановкаСНИЛС(Знач Хеш)

	Основа = "000" + ЦифрыИзХеша(Хеш, 6);
	Сумма = 0;
	Для Позиция = 1 По 9 Цикл
		Сумма = Сумма + Число(Сред(Основа, Позиция, 1)) * (10 - Позиция);
	КонецЦикла;
	Контрольное = Сумма % 101;
	Если Контрольное = 100 Тогда
		Контрольное = 0;
	КонецЕсли;

	Возврат Лев(Основа, 3) + "-" + Сред(Основа, 4, 3) + "-" + Сред(Основа, 7, 3) + " "
		+ Формат(Контрольное, "ЧЦ=2; ЧВН=; ЧН=00; ЧГ=0");

КонецФункции

Функция ПодстановкаКарты(Знач Хеш)

	Основа = "000000" + ЦифрыИзХеша(Хеш, 9);
	Цифры = Основа + КонтрольнаяЦифраЛуна(Основа);

	Возврат Лев(Цифры, 4) + " " + Сред(Цифры, 5, 4) + " " + Сред(Цифры, 9, 4) + " " + Сред(Цифры, 13, 4);

КонецФункции

Функция КонтрольнаяЦифраЛуна(Знач Основа)

	Сумма = 0;
	Длина = СтрДлина(Основа);
	Для Позиция = 1 По Длина Цикл
		Значение = Число(Сред(Основа, Длина - Позиция + 1, 1));
		// Справа налево, начиная с цифры перед будущей контрольной: удваивается каждая нечетная.
		Если Позиция % 2 = 1 Тогда
			Значение = Значение * 2;
			Если Значение > 9 Тогда
				Значение = Значение - 9;
			КонецЕсли;
		КонецЕсли;
		Сумма = Сумма + Значение;
	КонецЦикла;

	Возврат Формат((10 - Сумма % 10) % 10, "ЧН=0; ЧГ=0");

КонецФункции

Функция ПодстановкаФИО(Знач Находка, Знач Хеш, Знач Набор)

	Если СтрНачинаетсяС(Находка.Детектор, "Natasha") Тогда
		Возврат ПодстановкаФИОСервиса(Находка, Хеш, Набор);
	КонецЕсли;

	Слова = СловаИмени(Находка.Значение);
	Женское = ЭтоЖенскоеИмя(Слова, Находка.Детектор);
	Фамилия = ЭлементСписка(?(Женское, Набор.ФамилииЖенские, Набор.ФамилииМужские), Хеш, 1);

	// Подстановка повторяет форму исходного значения: порядок слов и сокращение инициалами.
	Буквы = СтрРазделить("А,Б,В,Г,Д,Е,К,Л,М,Н,П,Р,С,Т", ",");
	Инициалы = ЭлементСписка(Буквы, Хеш, 9) + "." + ЭлементСписка(Буквы, Хеш, 11) + ".";
	Если Находка.Детектор = "ФамилияСИнициалами" Тогда
		Возврат Фамилия + " " + Инициалы;
	КонецЕсли;
	Если Находка.Детектор = "ИнициалыИФамилия" Тогда
		Возврат Инициалы + " " + Фамилия;
	КонецЕсли;

	Имя = ЭлементСписка(?(Женское, Набор.ИменаЖенские, Набор.ИменаМужские), Хеш, 3);
	Отчество = ЭлементСписка(?(Женское, Набор.ОтчестваЖенские, Набор.ОтчестваМужские), Хеш, 5);
	Если Находка.Детектор = "ИмяОтчествоФамилия" Тогда
		Возврат Имя + " " + Отчество + " " + Фамилия;
	КонецЕсли;

	Возврат Фамилия + " " + Имя + " " + Отчество;

КонецФункции

// ФИО от сервиса: порядок частей берется из формы («LF» - фамилия, имя), род - из ответа сервиса,
// а если его нет - по окончаниям. Одиночная фамилия заменяется одной фамилией.
Функция ПодстановкаФИОСервиса(Знач Находка, Знач Хеш, Знач Набор)

	Части = СтрРазделить(Находка.Детектор, ":");
	Форма = "";
	Род = "";
	Если Части.Количество() > 1 Тогда
		Форма = Части[1];
	КонецЕсли;
	Если Части.Количество() > 2 Тогда
		Род = Части[2];
	КонецЕсли;
	Слова = СловаИмени(Находка.Значение);
	Если Форма = "" Тогда
		Форма = СтрРазделить("L,LF,LFM", ",")[Мин(Слова.Количество(), 3) - 1];
	КонецЕсли;
	Если Род = "" Тогда
		Женское = ЭтоЖенскоеИмя(Слова, "");
	Иначе
		Женское = Род = "f";
	КонецЕсли;

	Фамилии = Набор.ФамилииМужские;
	Имена = Набор.ИменаМужские;
	Отчества = Набор.ОтчестваМужские;
	Если Женское Тогда
		Фамилии = Набор.ФамилииЖенские;
		Имена = Набор.ИменаЖенские;
		Отчества = Набор.ОтчестваЖенские;
	КонецЕсли;

	Значения = Новый Соответствие;
	Значения.Вставить("L", ЭлементСписка(Фамилии, Хеш, 1));
	Значения.Вставить("F", ЭлементСписка(Имена, Хеш, 3));
	Значения.Вставить("M", ЭлементСписка(Отчества, Хеш, 5));

	Итог = Новый Массив;
	Для Позиция = 1 По СтрДлина(Форма) Цикл
		Часть = Значения[Сред(Форма, Позиция, 1)];
		Если Часть <> Неопределено Тогда
			Итог.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Итог, " ");

КонецФункции

// Правовая форма исходной организации сохраняется: модели важно, что это ООО или ИП.
// Смешных названий два десятка: когда в операции организаций больше, к названию добавляется номер.
Функция ПодстановкаОрганизации(Знач Исходное, Знач Хеш, Знач Выдуманные, Знач НомерВарианта)

	Формы = СтрРазделить("ООО,ОАО,ЗАО,ПАО,АО,ИП,НКО,АНО,ГУП,МУП,ФГУП,ТОО,НАО", ",");
	Первое = СтрРазделить(СокрЛП(Исходное), " «" + Символ(34), Ложь);
	Форма = "ООО";
	Если Первое.Количество() > 0 И Формы.Найти(Первое[0]) <> Неопределено Тогда
		Форма = Первое[0];
	КонецЕсли;

	Если Выдуманные Тогда
		Список = ВыдуманныеОрганизации();
		Название = ЭлементСписка(Список, Хеш, 1);
		Если НомерВарианта >= Список.Количество() Тогда
			Название = Название + " " + Формат(Цел(НомерВарианта / Список.Количество()) + 1, "ЧГ=0");
		КонецЕсли;
	Иначе
		Название = ЭлементСписка(ПравдоподобныеОрганизации(), Хеш, 1) + "-" + ЦифрыИзХеша(Хеш, 3);
	КонецЕсли;

	Возврат СтрШаблон("%1 «%2»", Форма, Название);

КонецФункции

// Город Энск - условный город русской литературы; в смешном стиле - сказочные адреса.
Функция ПодстановкаАдреса(Знач Хеш, Знач Выдуманные)

	Дом = Формат(ЧислоИзХеша(Хеш, 7, 2) % 99 + 1, "ЧГ=0");
	Если Выдуманные Тогда
		Возврат СтрШаблон("%1, %2, д. %3", ЭлементСписка(ВыдуманныеГорода(), Хеш, 1),
			ЭлементСписка(ВыдуманныеУлицы(), Хеш, 3), Дом);
	КонецЕсли;

	Возврат СтрШаблон("г. Энск, ул. %1, д. %2", ЭлементСписка(ПравдоподобныеУлицы(), Хеш, 3), Дом);

КонецФункции

Функция ПравдоподобныеОрганизации()

	Возврат СтрРазделить("Вектор,Меридиан,Альянс,Горизонт,Прогресс,Импульс,Стандарт,Ресурс,Партнер,Магистраль,"
		+ "Спектр,Фактор", ",");


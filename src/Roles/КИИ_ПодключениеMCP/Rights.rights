<?xml version="1.0" encoding="UTF-8"?>
<Rights xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://v8.1c.ru/8.2/roles" xsi:type="Rights">
	<setForNewObjects>false</setForNewObjects>
	<setForAttributesByDefault>false</setForAttributesByDefault>
	<independentRightsOfChildObjects>false</independentRightsOfChildObjects>
	<object>
		<name>HTTPService.КИИ_СерверMCPAPI.URLTemplate.connection.Method.POST</name>
		<right>
			<name>Use</name>
			<value>true</value>
		</right>
	</object>
	<object>
		<name>InformationRegister.КИИ_СерверMCPОграниченияВызовов</name>
		<right>
			<name>Read</name>
			<value>true</value>
			<restrictionByCondition>
				<condition>ГДЕ Вызывающий = "user:" + &amp;КИИ_ИмяПользователяMCP</condition>
			</restrictionByCondition>
		</right>
		<right>
			<name>Update</name>
			<value>true</value>
			<restrictionByCondition>
				<condition>ГДЕ Вызывающий = "user:" + &amp;КИИ_ИмяПользователяMCP</condition>
			</restrictionByCondition>
		</right>
	</object>
	<object>
		<name>InformationRegister.КИИ_СерверMCPАудитВызовов</name>
		<right>
			<name>Read</name>
			<value>true</value>
			<restrictionByCondition>
				<condition>ГДЕ Вызывающий = &amp;КИИ_ИмяПользователяMCP</condition>
			</restrictionByCondition>
		</right>
		<right>
			<name>Update</name>
			<value>true</value>
			<restrictionByCondition>
				<condition>ГДЕ Вызывающий = &amp;КИИ_ИмяПользователяMCP</condition>
			</restrictionByCondition>
		</right>
	</object>
	<object>
		<name>SessionParameter.КИИ_ИмяПользователяMCP</name>
		<right>
			<name>Get</name>
			<value>true</value>
		</right>
	</object>
</Rights>

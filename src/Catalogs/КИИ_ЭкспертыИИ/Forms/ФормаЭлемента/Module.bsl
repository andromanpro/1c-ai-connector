#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьСведенияЗнанийЭксперта();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьСведенияЗнанийЭксперта();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьСведенияЗнанийЭксперта();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПоискЗнаний(Команда)

	Перем ТекстСообщения;
	Перем ПараметрыВызова;

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		ТекстСообщения = НСтр("ru = 'Сначала запишите карточку. Проверка использует записанные знания и категории.'");
		ПоказатьПредупреждение(, ТекстСообщения);
		Возврат;
	КонецЕсли;
	ПараметрыВызова = Новый Структура("ЭкспертПоиска", Объект.Ссылка);
	ОткрытьФорму("Обработка.КИИ_ПроверкаПоискаЗнаний.Форма.Форма", ПараметрыВызова);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКатегориюЗнаний(Команда)

	Данные = Элементы.КатегорииЗнаний.ТекущиеДанные;
	Если Данные <> Неопределено И ЗначениеЗаполнено(Данные.Категория) Тогда
		ПоказатьЗначение(, Данные.Категория);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьСведенияЗнанийЭксперта()

	Перем ПредставлениеЗначения;

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СостояниеЗнанийЭксперта = НСтр(
			"ru = 'Запишите карточку после выбора категорий. Здесь будет показана готовность подключенных знаний.'");
		Возврат;
	КонецЕсли;
	Сведения = КИИ_RAG.СведенияДляПроверкиПоиска(Объект.Ссылка);
	СтрокиСостояния = Новый Массив;
	СтрокиСостояния.Добавить(Сведения.Диагностика);
	Если ЗначениеЗаполнено(Сведения.Модель) Тогда
		ПредставлениеЗначения = Строка(Сведения.Модель);
		ОписаниеМодели = СтрШаблон(НСтр("ru = 'Модель для поиска знаний: %1.'"), ПредставлениеЗначения);
		СтрокиСостояния.Добавить(ОписаниеМодели);
	КонецЕсли;
	ПредупреждениеОКатегориях = НСтр(
		"ru = 'Проверка использует записанные категории. После изменения списка запишите карточку.'");
	СтрокиСостояния.Добавить(ПредупреждениеОКатегориях);
	СостояниеЗнанийЭксперта = СтрСоединить(СтрокиСостояния, Символы.ПС);

КонецПроцедуры

#КонецОбласти

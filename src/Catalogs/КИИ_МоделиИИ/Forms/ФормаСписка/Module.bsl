#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Кнопка видна всегда: после обновления расширения ею подтягиваются новые предустановки.
	Если Справочники.КИИ_МоделиИИ.МоделиЗаполнены() Тогда
		Элементы.ФормаЗаполнитьМодели.Заголовок = НСтр("ru = 'Обновить предустановленные модели'");
	Иначе
		СтрокаСообщения = НСтр("ru = 'Для заполнения предустановленными моделями нажмите ""Заполнить Модели""'",
								ОбщегоНазначения.КодОсновногоЯзыка());
		ОбщегоНазначения.СообщитьПользователю(СтрокаСообщения);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьМодели(Команда)

	Если Не МоделиЗаполненыНаСервере() Тогда
		ЗаполнитьМоделиНаСервере();
		Возврат;
	КонецЕсли;

	// Одноименные модели перезаполняются из шаблона: адрес и заголовки своей модели с именем пресета затрутся.
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьМоделиЗавершение", ЭтотОбъект);
	ТекстВопроса = НСтр("ru = 'Появятся новые предустановленные модели. Модели с такими же наименованиями, как у
		|предустановок, будут перезаполнены из шаблона (ключи API сохранятся). Свои модели с другими
		|наименованиями не изменятся. Продолжить?'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьМоделиЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьМоделиНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция МоделиЗаполненыНаСервере()

	Возврат Справочники.КИИ_МоделиИИ.МоделиЗаполнены();

КонецФункции

&НаСервере
Процедура ЗаполнитьМоделиНаСервере()

	Справочники.КИИ_МоделиИИ.ЗаполнитьПредустановленныеМодели();
	Элементы.Список.Обновить();
	Элементы.ФормаЗаполнитьМодели.Заголовок = НСтр("ru = 'Обновить предустановленные модели'");
	СтрокаСообщения = НСтр("ru = 'Модели успешно заполнены'");
	ОбщегоНазначения.СообщитьПользователю(СтрокаСообщения);

КонецПроцедуры

#КонецОбласти

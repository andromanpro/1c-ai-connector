#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Перем ВалютаНеУказанаДляТарифов;
	Перем ВалютаБезКрайнихПробелов;

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ЕстьОтрицательныйПредел = МаксимумРаундовПетли < 0
		Или МаксимумВызововПетли < 0
		Или МаксимумСимволовРезультатаПетли < 0
		Или МаксимумСимволовДиалогаПетли < 0;
	Если ЕстьОтрицательныйПредел Тогда
		ВызватьИсключение НСтр(
			"ru = 'Пределы петли не могут быть отрицательными. Укажите 0 для стандартного значения.'");
	КонецЕсли;

	ВалютаНеУказанаДляТарифов = Ложь;
	Если РассчитыватьСтоимость Тогда
		ВалютаБезКрайнихПробелов = СокрЛП(ВалютаТарифов);
		ВалютаНеУказанаДляТарифов = ПустаяСтрока(ВалютаБезКрайнихПробелов);
	КонецЕсли;
	Если ВалютаНеУказанаДляТарифов Тогда
		ВызватьИсключение НСтр("ru = 'Для оценки стоимости укажите валюту тарифов.'");
	КонецЕсли;
	ЕстьОтрицательныйТариф = ТарифВходныхТокенов < 0
		Или ТарифВыходныхТокенов < 0
		Или ТарифЧтенияКеша < 0
		Или ТарифЗаписиКеша < 0;
	Если ЕстьОтрицательныйТариф Тогда
		ВызватьИсключение НСтр("ru = 'Тарифы токенов не могут быть отрицательными.'");
	КонецЕсли;

	// Доверие маршруту привязано к отпечатку адреса, прокси и модели на момент включения флажка.
	// Смена адреса после этого отпечаток не обновляет: доверие аннулируется, пока флажок не включат заново.
	Если Не МаршрутДоверенный Тогда
		ОтпечатокДоверенногоМаршрута = "";
	КонецЕсли;
	Если МаршрутДоверенный И Не ЗначениеЗаполнено(ОтпечатокДоверенногоМаршрута) Тогда
		ОтпечатокДоверенногоМаршрута = КИИ_КонтрольПерсональныхДанных.ОтпечатокМаршрута(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли

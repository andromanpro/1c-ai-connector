#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Доверие маршруту привязано к отпечатку адреса, прокси и модели на момент включения флажка.
	// Смена адреса после этого отпечаток не обновляет: доверие аннулируется, пока флажок не включат заново.
	Если Не МаршрутДоверенный Тогда
		ОтпечатокДоверенногоМаршрута = "";
	КонецЕсли;
	Если МаршрутДоверенный И Не ЗначениеЗаполнено(ОтпечатокДоверенногоМаршрута) Тогда
		ОтпечатокДоверенногоМаршрута = КИИ_КонтрольПерсональныхДанных.ОтпечатокМаршрута(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли

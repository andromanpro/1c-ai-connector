#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Список.УстановитьОбязательноеИспользование("Ссылка", Истина);
	Список.УстановитьОбязательноеИспользование("Владелец", Истина);
	Список.УстановитьОбязательноеИспользование("СостояниеИндекса", Истина);
	Поля = Новый Массив;
	Поля.Добавить("СостояниеИндекса");
	Список.УстановитьОграниченияИспользованияВОтборе(Поля);
	Список.УстановитьОграниченияИспользованияВПорядке(Поля);
	Список.УстановитьОграниченияИспользованияВГруппировке(Поля);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьБазу(Команда)

	Если ТипЗнч(Элементы.Список.ТекущаяСтрока) <> Тип("СправочникСсылка.КИИ_ФрагментыЗнаний") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите один фрагмент в списке.'"));
		Возврат;
	КонецЕсли;
	Данные = Элементы.Список.ТекущиеДанные;
	Если Данные <> Неопределено И ЗначениеЗаполнено(Данные.Владелец) Тогда
		ПоказатьЗначение(, Данные.Владелец);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)

	Базы = Новый Массив;
	Ключи = Строки.ПолучитьКлючи();
	Для Каждого Ключ Из Ключи Цикл
		Если ТипЗнч(Ключ) <> Тип("СправочникСсылка.КИИ_ФрагментыЗнаний") Тогда
			Продолжить;
		КонецЕсли;
		База = Строки.Получить(Ключ).Данные.Владелец;
		Если Базы.Найти(База) = Неопределено Тогда
			Базы.Добавить(База);
		КонецЕсли;
	КонецЦикла;
	Состояния = КИИ_RAG.СведенияОбИндексахБаз(Базы);
	Для Каждого Ключ Из Ключи Цикл
		Если ТипЗнч(Ключ) <> Тип("СправочникСсылка.КИИ_ФрагментыЗнаний") Тогда
			Продолжить;
		КонецЕсли;
		Данные = Строки.Получить(Ключ).Данные;
		Сведения = Состояния.Получить(Данные.Владелец);
		Если Сведения = Неопределено Тогда
			Данные.СостояниеИндекса = НСтр("ru = 'База недоступна'");
		ИначеЕсли Сведения.ГотовыеФрагменты.Найти(Ключ) <> Неопределено Тогда
			Данные.СостояниеИндекса = НСтр("ru = 'Готов к поиску'");
		ИначеЕсли Сведения.Готово > 0 Тогда
			Данные.СостояниеИндекса = НСтр("ru = 'Фрагмент требует обновления'");
		Иначе
			Данные.СостояниеИндекса = КИИ_RAG.ПредставлениеСостоянияИндекса(Сведения);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

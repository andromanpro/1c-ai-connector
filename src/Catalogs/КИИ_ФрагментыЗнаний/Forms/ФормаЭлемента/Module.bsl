#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТолькоПросмотр = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьБазу(Команда)

	Если ЗначениеЗаполнено(Объект.Владелец) Тогда
		ПоказатьЗначение(, Объект.Владелец);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура КопироватьТекст(Команда)

	Если Не ПустаяСтрока(Объект.ТекстФрагмента) Тогда
		Скопировано = Ждать КИИ_ИнтерфейсКлиент.СкопироватьТекстВБуферОбмена(Объект.ТекстФрагмента);
		Если Не Скопировано Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Буфер обмена недоступен. Выделите и скопируйте текст вручную.'"));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПояснениеПравила = НСтр(
		"ru = 'Совпадают все заполненные условия. Подстроки учитывают регистр. Пустое правило не подавляет ошибки.
			|Одно короткое условие может скрыть слишком много ошибок. Проверка не сохраняет правило и ничего не
			|отправляет.'");

	ХешДляПроверки = "";
	Если Параметры.Свойство("ХешДляПроверки", ХешДляПроверки) И ЗначениеЗаполнено(ХешДляПроверки) Тогда
		ЗаписьОшибки = РегистрыСведений.КИИ_МониторингОшибокЖурнал.СоздатьМенеджерЗаписи();
		ЗаписьОшибки.ХешОшибки = ХешДляПроверки;
		ЗаписьОшибки.Прочитать();
		Если ЗаписьОшибки.Выбран() Тогда
			ПробноеСобытие = ЗаписьОшибки.Событие;
			ПробныеМетаданные = ЗаписьОшибки.Метаданные;
			ПробныйТекст = ЗаписьОшибки.ТекстОшибки;
			Объект.Событие = ПробноеСобытие;
			Объект.Метаданные = ПробныеМетаданные;
			Объект.ТекстСодержит = Лев(ПробныйТекст, 120);
			Объект.Наименование = Лев(ПробныйТекст, 100);
			Объект.Активно = Ложь;
			ПроверитьПравилоНаСервере();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	ПустоеАктивноеПравило = ТекущийОбъект.Активно И ПустаяСтрока(ТекущийОбъект.Событие)
		И ПустаяСтрока(ТекущийОбъект.Метаданные) И ПустаяСтрока(ТекущийОбъект.ТекстСодержит);
	Если ПустоеАктивноеПравило Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для активного правила заполните хотя бы одно условие.'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПравило(Команда)

	ПроверитьПравилоНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьПравилоНаСервере()

	Правило = Новый Структура;
	Правило.Вставить("Событие", Объект.Событие);
	Правило.Вставить("Метаданные", Объект.Метаданные);
	Правило.Вставить("ТекстСодержит", Объект.ТекстСодержит);
	Правило.Вставить("Активно", Объект.Активно);
	Ошибка = Новый Структура("Событие, Метаданные, Текст", ПробноеСобытие, ПробныеМетаданные, ПробныйТекст);
	Проверка = КИИ_МониторингОшибокРегистры.РезультатПроверкиПравила(Правило, Ошибка);
	РезультатПроверкиПравила = Проверка.Пояснение;

КонецПроцедуры

#КонецОбласти

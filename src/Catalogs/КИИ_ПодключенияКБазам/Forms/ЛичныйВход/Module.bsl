#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ОбновитьСостояниеВхода();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	// Эта форма сохраняет только личный вход через отдельную команду.
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НовыйПарольПриИзменении(Элемент)
	ИзменитьПароль = Истина;
	УдалитьПароль = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПарольПриИзменении(Элемент)
	Если ИзменитьПароль Тогда
		УдалитьПароль = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПарольПриИзменении(Элемент)
	Если УдалитьПароль Тогда
		ИзменитьПароль = Ложь;
		НовыйПароль = "";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьВход(Команда)
	СтатусПроверки = СохранитьВходНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВход(Команда)
	ИзмененПароль = ИзменитьПароль Или УдалитьПароль Или Не ПустаяСтрока(НовыйПароль);
	Если ИзмененПароль Или Логин <> СохраненныйЛогин Тогда
		СтатусПроверки = НСтр("ru = 'Сначала сохраните изменения личного входа.'");
		Возврат;
	КонецЕсли;
	Элементы.РеквизитыВхода.Доступность = Ложь;
	Элементы.СохранитьВход.Доступность = Ложь;
	Элементы.ПроверитьВход.Доступность = Ложь;
	СтатусПроверки = НСтр("ru = 'Проверяется вход в целевую базу...'");
	Попытка
		Операция = НачатьПроверкуНаСервере();
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиВхода", ЭтотОбъект);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);
	Исключение
		ЗавершитьОжидание();
		СтатусПроверки = НСтр("ru = 'Не удалось запустить проверку входа.'");
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьСостояниеВхода()
	Состояние = КИИ_ПодключенияКБазам.СостояниеВхода(Объект.Ссылка);
	ЛичныйРежим = Состояние.ЛичныйВход;
	Логин = ?(Состояние.ЛичныйВход, Состояние.Логин, "");
	СохраненныйЛогин = Логин;
	Элементы.РеквизитыВхода.Доступность = Состояние.ЛичныйВход;
	Элементы.СохранитьВход.Доступность = Состояние.ЛичныйВход;
	СостояниеПароля = ?(Состояние.ПарольСохранен, НСтр("ru = 'Пароль задан'"), НСтр("ru = 'Пароль не задан'"));
	Если Не Состояние.ЛичныйВход Тогда
		СтатусПроверки = НСтр("ru = 'Используется служебный вход, настроенный администратором.'");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СохранитьВходНаСервере()
	Если ИзменитьПароль И УдалитьПароль Тогда
		Возврат НСтр("ru = 'Выберите одно действие: заменить или удалить пароль.'");
	КонецЕсли;
	Если УдалитьПароль Тогда
		Действие = "Удалить";
	ИначеЕсли ИзменитьПароль Тогда
		Действие = "Заменить";
	Иначе
		Действие = "НеИзменять";
	КонецЕсли;
	Попытка
		КИИ_ПодключенияКБазам.СохранитьЛичныйВход(Объект.Ссылка, Логин, НовыйПароль, Действие);
		НовыйПароль = "";
		ИзменитьПароль = Ложь;
		УдалитьПароль = Ложь;
		ОбновитьСостояниеВхода();
		Возврат НСтр("ru = 'Личный вход сохранён.'");
	Исключение
		Возврат ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

&НаСервере
Функция НачатьПроверкуНаСервере()
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения, "КИИ_ПодключенияКБазам.ПроверитьПодключениеДляФормы", Объект.Ссылка);
КонецФункции

&НаКлиенте
Процедура ЗавершитьОжидание()
	Элементы.РеквизитыВхода.Доступность = ЛичныйРежим;
	Элементы.СохранитьВход.Доступность = ЛичныйРежим;
	Элементы.ПроверитьВход.Доступность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиВхода(Результат, ДополнительныеПараметры) Экспорт
	ЗавершитьОжидание();
	Если Результат = Неопределено Тогда
		СтатусПроверки = НСтр("ru = 'Проверка отменена.'");
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		СтатусПроверки = НСтр("ru = 'Ошибка выполнения проверки входа.'");
	Иначе
		Проверка = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		УдалитьИзВременногоХранилища(Результат.АдресРезультата);
		СтатусПроверки = Проверка.Текст;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура МойВход(Команда)
	Подключение = Элементы.Список.ТекущаяСтрока;
	Если Подключение <> Неопределено И ТипЗнч(Подключение) <> Тип("СправочникСсылка.КИИ_ПодключенияКБазам") Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Выберите подключение, а не строку группировки.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Подключение) Тогда
		ОткрытьФорму(
			"Справочник.КИИ_ПодключенияКБазам.Форма.ЛичныйВход", Новый Структура("Ключ", Подключение), ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Используется = Истина;
		Объект.Таймаут = 60;
	КонецЕсли;
	ОбновитьСостояниеПароля();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ОбновитьСостояниеПароля(ТекущийОбъект.Ссылка);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ИзменитьПароль И УдалитьПароль Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Выберите одно действие: заменить или удалить пароль.'");
		Сообщение.Сообщить();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если Не ТекущийОбъект.ЛичныйВход Тогда
		Если УдалитьПароль Тогда
			Действие = "Удалить";
		ИначеЕсли ИзменитьПароль Тогда
			Действие = "Заменить";
		Иначе
			Действие = "НеИзменять";
		КонецЕсли;
		КИИ_ПодключенияКБазам.СохранитьСлужебныйПароль(ТекущийОбъект.Ссылка, НовыйПароль, Действие);
	КонецЕсли;
	НовыйПароль = "";
	ИзменитьПароль = Ложь;
	УдалитьПароль = Ложь;
	ОбновитьСостояниеПароля(ТекущийОбъект.Ссылка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЛичныйВходПриИзменении(Элемент)
	НовыйПароль = "";
	ИзменитьПароль = Ложь;
	УдалитьПароль = Ложь;
	Элементы.СлужебныйВход.Видимость = Не Объект.ЛичныйВход;
	СтатусПроверки = НСтр("ru = 'Режим входа изменён. Запишите подключение и проверьте его заново.'");
КонецПроцедуры

&НаКлиенте
Процедура НовыйПарольПриИзменении(Элемент)
	ИзменитьПароль = Истина;
	УдалитьПароль = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПарольПриИзменении(Элемент)
	Если ИзменитьПароль Тогда
		УдалитьПароль = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПарольПриИзменении(Элемент)
	Если УдалитьПароль Тогда
		ИзменитьПароль = Ложь;
		НовыйПароль = "";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура МойВход(Команда)
	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СтатусПроверки = НСтр("ru = 'Сначала запишите подключение.'");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Справочник.КИИ_ПодключенияКБазам.Форма.ЛичныйВход", Новый Структура("Ключ", Объект.Ссылка), ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СтатусПроверки = НСтр("ru = 'Сначала запишите подключение и реквизиты входа.'");
		Возврат;
	КонецЕсли;
	Элементы.Страницы.Доступность = Ложь;
	Элементы.ПроверитьПодключение.Доступность = Ложь;
	СтатусПроверки = НСтр("ru = 'Проверяется вход в целевую базу...'");
	Попытка
		Операция = НачатьПроверкуНаСервере();
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиПодключения", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);
	Исключение
		Элементы.Страницы.Доступность = Истина;
		Элементы.ПроверитьПодключение.Доступность = Истина;
		СтатусПроверки = НСтр("ru = 'Не удалось запустить проверку подключения.'");
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьСостояниеПароля(Подключение = Неопределено)
	Элементы.СлужебныйВход.Видимость = Не Объект.ЛичныйВход;
	СостояниеПароля = НСтр("ru = 'Пароль не задан'");
	Если Подключение = Неопределено Тогда
		Подключение = Объект.Ссылка;
	КонецЕсли;
	Если ЗначениеЗаполнено(Подключение) Тогда
		Состояние = КИИ_ПодключенияКБазам.СостояниеВхода(Подключение);
		Если Состояние.ПарольСохранен Тогда
			СостояниеПароля = НСтр("ru = 'Пароль задан'");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НачатьПроверкуНаСервере()
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения, "КИИ_ПодключенияКБазам.ПроверитьПодключениеДляФормы", Объект.Ссылка);
КонецФункции

&НаКлиенте
Процедура ПослеПроверкиПодключения(Результат, ДополнительныеПараметры) Экспорт
	Элементы.Страницы.Доступность = Истина;
	Элементы.ПроверитьПодключение.Доступность = Истина;
	Если Результат = Неопределено Тогда
		СтатусПроверки = НСтр("ru = 'Проверка отменена.'");
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		СтатусПроверки = НСтр("ru = 'Ошибка выполнения проверки подключения.'");
	Иначе
		Проверка = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		УдалитьИзВременногоХранилища(Результат.АдресРезультата);
		Если Проверка.Успех Тогда
			Прочитать();
		КонецЕсли;
		СтатусПроверки = Проверка.Текст;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

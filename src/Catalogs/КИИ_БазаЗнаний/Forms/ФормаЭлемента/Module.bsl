#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИндексацияВыполняется = Ложь;
	ОбновитьСостояниеИндекса();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьСостояниеИндекса();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьСостояниеИндекса();
	ИтогИндексации = НСтр("ru = 'Изменения записаны. Если текст изменился, обновите индекс этой базы.'");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проиндексировать(Команда)

	Если ИндексацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите изменения карточки. Индекс строится по записанному тексту.'"));
		Возврат;
	КонецЕсли;
	Если Объект.ПометкаУдаления Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'База помечена на удаление. Снимите пометку перед индексацией.'"));
		Возврат;
	КонецЕсли;

	ИндексацияВыполняется = Истина;
	Элементы.Проиндексировать.Доступность = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияИндексации", ЭтотОбъект, Объект.Ссылка);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Обновить индекс выбранной базы знаний? Для новых или измененных фрагментов текст может быть
			|отправлен сервису эмбеддингов с учетом политики доступа. Сервис может тарифицировать запросы.'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПоискЗнаний(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Сначала запишите карточку. Проверка использует записанные знания и категории.'"));
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Обработка.КИИ_ПроверкаПоискаЗнаний.Форма.Форма",
		Новый Структура("БазаПоиска", Объект.Ссылка));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеПодтвержденияИндексации(Ответ, СсылкаБазы) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		ЗавершитьОжиданиеИндексации();
		Возврат;
	КонецЕсли;
	Если Модифицированность Или Объект.Ссылка <> СсылкаБазы Тогда
		ЗавершитьОжиданиеИндексации();
		ПоказатьПредупреждение(, НСтр("ru = 'Карточка изменилась. Запишите изменения и снова запустите индексацию.'"));
		Возврат;
	КонецЕсли;
	ИтогИндексации = НСтр("ru = 'Обновляется индекс выбранной базы знаний...'");
	Попытка
		Операция = НачатьИндексацию(СсылкаБазы, УникальныйИдентификатор);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		Оповещение = Новый ОписаниеОповещения("ПослеИндексации", ЭтотОбъект, СсылкаБазы);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);
	Исключение
		ЗавершитьОжиданиеИндексации();
		ИтогИндексации = НСтр("ru = 'Не удалось запустить индексацию. Подробности приведены в сообщении об ошибке.'");
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Получает итог фоновой операции для той же карточки и освобождает временное хранилище.
// Параметры:
//  Результат - Структура, Неопределено - результат ожидания БСП.
//  СсылкаБазы - СправочникСсылка.КИИ_БазаЗнаний - база, для которой запущено задание.
&НаКлиенте
Процедура ПослеИндексации(Результат, СсылкаБазы) Экспорт

	ЗавершитьОжиданиеИндексации();
	Если Результат = Неопределено Тогда
		ИтогИндексации = НСтр(
			"ru = 'Ожидание отменено. Задание может продолжаться; состояние индекса можно проверить после его завершения.'");
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		ИтогИндексации = НСтр("ru = 'Индексация завершилась с ошибкой. Подробности доступны в журнале регистрации.'");
		Возврат;
	КонецЕсли;
	Итог = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	Если Объект.Ссылка <> СсылкаБазы Тогда
		Возврат;
	КонецЕсли;
	Фрагменты = Итог.Фрагменты;
	Эмбеддинги = Итог.Эмбеддинги;
	Если Итог.ТекстИзменился Тогда
		ТекстИтога = НСтр("ru = 'Записанный текст изменился во время обработки. Обновите индекс повторно.'");
	ИначеЕсли Итог.Завершено Тогда
		ТекстИтога = НСтр("ru = 'Индекс этой базы готов.'");
	ИначеЕсли Эмбеддинги.Статус = "НетМодели" Тогда
		ТекстИтога = НСтр("ru = 'Фрагменты подготовлены, но модель эмбеддингов не настроена. Выберите модель и
			|повторите обновление.'");
	ИначеЕсли Эмбеддинги.Статус = "НетФрагментов" Тогда
		ТекстИтога = НСтр("ru = 'Нет текста для индексации. Заполните и запишите текст базы.'");
	Иначе
		ТекстИтога = НСтр("ru = 'Индекс готов не полностью. Проверьте пропуски и ошибки ниже; подробности ошибок
			|доступны в журнале регистрации.'");
	КонецЕсли;
	ИтогИндексации = ТекстИтога + Символы.ПС + СтрШаблон(
		НСтр("ru = 'Фрагментов: %1. Создано: %2; обновлено: %3; удалено: %4; ошибок записи: %5.'"),
		Фрагменты.Всего, Фрагменты.Создано, Фрагменты.Обновлено, Фрагменты.Удалено, Фрагменты.Ошибок)
		+ Символы.ПС + СтрШаблон(
		НСтр("ru = 'Эмбеддинги: обновлено %1; уже готовы %2; запрет политики %3; отказ проверки персональных данных
			|%4; ошибок %5.'"),
		Эмбеддинги.Обновлено, Эмбеддинги.УжеГотово, Эмбеддинги.ЗапрещеноПолитикой,
		Эмбеддинги.ОтказПДн, Эмбеддинги.Ошибок);
	ОбновитьСостояниеИндекса();

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОжиданиеИндексации()

	ИндексацияВыполняется = Ложь;
	Элементы.Проиндексировать.Доступность = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НачатьИндексацию(Знач СсылкаБазы, Знач ИдентификаторФормы)

	Если Не ПравоДоступа("Изменение", Метаданные.Справочники.КИИ_БазаЗнаний) Тогда
		ВызватьИсключение НСтр("ru = 'Нет права обновления индекса знаний.'");
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.КлючФоновогоЗадания = "КИИ_ИндексЗнаний_" + Строка(СсылкаБазы.УникальныйИдентификатор());
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обновление индекса знаний'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"КИИ_RAG.ИндексироватьБазуЗнаний", СсылкаБазы);

КонецФункции

&НаСервере
Процедура ОбновитьСостояниеИндекса()

	Элементы.Проиндексировать.Доступность = ПравоДоступа("Изменение", Метаданные.Справочники.КИИ_БазаЗнаний)
		И Не ИндексацияВыполняется;

	Политика = Объект.ПолитикаЭмбеддингаПереопределение;
	Если Не ЗначениеЗаполнено(Политика) И ЗначениеЗаполнено(Объект.Категория) Тогда
		Политика = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Категория, "ПолитикаЭмбеддинга");
	КонецЕсли;
	ПолитикаДоступа = ?(ЗначениеЗаполнено(Политика), Строка(Политика),
		НСтр("ru = 'Ограничение не задано; отправка сервису эмбеддингов разрешена.'"));
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СостояниеИндекса = НСтр("ru = 'Новая база. Сначала запишите текст карточки.'");
		Возврат;
	КонецЕсли;
	СведенияИндекса = КИИ_RAG.СведенияОбИндексеБазы(Объект.Ссылка);
	Модель = СведенияИндекса.Модель;
	Всего = СведенияИндекса.Всего;
	Готово = СведенияИндекса.Готово;
	ДатаЭмбеддинга = СведенияИндекса.ДатаЭмбеддинга;
	СостояниеИндекса = СтрШаблон(НСтр("ru = 'Фрагментов: %1. Готовы для текущей модели: %2. Требуют обновления: %3.'"),
		Всего, Готово, Всего - Готово);
	Если СведенияИндекса.ТекстИзменился Тогда
		СостояниеИндекса = СостояниеИндекса + Символы.ПС
			+ НСтр("ru = 'Фрагменты не соответствуют записанному тексту. Обновите индекс этой базы.'");
	КонецЕсли;
	Если ЗначениеЗаполнено(Модель) Тогда
		СостояниеИндекса = СостояниеИндекса + Символы.ПС + СтрШаблон(НСтр("ru = 'Модель эмбеддингов: %1.'"), Модель);
	Иначе
		СостояниеИндекса = СостояниеИндекса + Символы.ПС + НСтр("ru = 'Модель эмбеддингов не настроена.'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаЭмбеддинга) Тогда
		СостояниеИндекса = СостояниеИндекса + Символы.ПС
			+ СтрШаблон(НСтр("ru = 'Последнее обновление эмбеддингов: %1.'"), Формат(ДатаЭмбеддинга, "ДЛФ=DT"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

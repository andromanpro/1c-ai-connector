#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проиндексировать(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите базу знаний, затем запустите индексацию.'"));
		Возврат;
	КонецЕсли;
	ПроиндексироватьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроиндексироватьНаСервере()
	Статистика = КИИ_RAG.ПереиндексироватьБазу(Объект.Ссылка);
	КИИ_RAG.ОбновитьЭмбеддинги();
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Индексация базы «%1»: фрагментов %2 (создано %3, обновлено %4, удалено %5).
			|Эмбеддинги обновлены.'"),
		Объект.Наименование, Статистика.Всего, Статистика.Создано, Статистика.Обновлено, Статистика.Удалено);
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Список.УстановитьОбязательноеИспользование("Ссылка", Истина);
	Поля = Новый Массив;
	Поля.Добавить("ВсегоФрагментов");
	Поля.Добавить("ГотовоФрагментов");
	Поля.Добавить("СостояниеИндекса");
	Поля.Добавить("ДатаИндекса");
	Для Каждого Поле Из Поля Цикл
		Список.УстановитьОбязательноеИспользование(Поле, Истина);
	КонецЦикла;
	Список.УстановитьОграниченияИспользованияВОтборе(Поля);
	Список.УстановитьОграниченияИспользованияВПорядке(Поля);
	Список.УстановитьОграниченияИспользованияВГруппировке(Поля);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)

	Базы = Новый Массив;
	Для Каждого Ключ Из Строки.ПолучитьКлючи() Цикл
		Если ТипЗнч(Ключ) = Тип("СправочникСсылка.КИИ_БазаЗнаний") Тогда
			Базы.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Состояния = КИИ_RAG.СведенияОбИндексахБаз(Базы);
	Для Каждого Состояние Из Состояния Цикл
		Данные = Строки.Получить(Состояние.Ключ).Данные;
		Данные.ВсегоФрагментов = Состояние.Значение.Всего;
		Данные.ГотовоФрагментов = Состояние.Значение.Готово;
		Данные.СостояниеИндекса = КИИ_RAG.ПредставлениеСостоянияИндекса(Состояние.Значение);
		Данные.ДатаИндекса = Состояние.Значение.ДатаЭмбеддинга;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьФрагменты(Команда)

	Перем ПараметрыВызова;

	База = ВыбраннаяБаза();
	Если ЗначениеЗаполнено(База) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыВызова = Новый Структура("Владелец", База);
		ПараметрыФормы.Вставить("Отбор", ПараметрыВызова);
		ОткрытьФорму("Справочник.КИИ_ФрагментыЗнаний.ФормаСписка", ПараметрыФормы, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПоиск(Команда)

	Перем ПараметрыВызова;

	База = ВыбраннаяБаза();
	Если ЗначениеЗаполнено(База) Тогда
		ПараметрыВызова = Новый Структура("БазаПоиска", База);
		ОткрытьФорму("Обработка.КИИ_ПроверкаПоискаЗнаний.Форма.Форма", ПараметрыВызова, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ВыбраннаяБаза()

	Перем ТекстСообщения;

	Ключ = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Ключ) = Тип("СправочникСсылка.КИИ_БазаЗнаний") Тогда
		Возврат Ключ;
	КонецЕсли;
	ТекстСообщения = НСтр("ru = 'Выберите одну базу знаний в списке.'");
	ПоказатьПредупреждение(, ТекстСообщения);
	Возврат Неопределено;

КонецФункции

#КонецОбласти

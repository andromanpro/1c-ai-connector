#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		// Исключение std773: загруженные служебные признаки нельзя считать проверенными.
		// Содержимое, заголовок и переданная дата сохраняются; поиск проверит их полностью.
		ХешиФрагментовДляПоиска = "";
		Возврат;
	КонецЕсли;
	ХешиФрагментовДляПоиска = КИИ_RAG.ХешиСохраненногоТекста(Наименование, Содержимое);
	Если ЭтоНовый() Тогда
		ДатаОбновления = ТекущаяДатаСеанса();
		Возврат;
	КонецЕсли;
	Сохраненные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Наименование, Содержимое, ДатаОбновления");
	Если Наименование <> Сохраненные.Наименование Или Содержимое <> Сохраненные.Содержимое Тогда
		ДатаОбновления = ТекущаяДатаСеанса();
	Иначе
		ДатаОбновления = Сохраненные.ДатаОбновления;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьНастройкиФормы();
	ОбновитьОтображениеОтвета();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьНастройкиФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЭкспертПриИзменении(Элемент)
	
	СохранитьНастройкиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВФонеПриИзменении(Элемент)
	
	СохранитьНастройкиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РазмерКонтекстаПриИзменении(Элемент)
	
	Если РазмерКонтекста < 0 Тогда
		РазмерКонтекста = 0;
	КонецЕсли;
	
	СохранитьНастройкиФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)
	
	Если ПустаяСтрока(Промпт) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите промпт'"));
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Эксперт) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не заполнен Эксперт ИИ'"));
		Возврат;
	КонецЕсли;
	
	Если ЕстьОтмеченныеВложения() Тогда
		ПредупреждениеМультимодал = МультимодалДоступенДляЭксперта();
		Если Не ПустаяСтрока(ПредупреждениеМультимодал) Тогда
			ПоказатьПредупреждение(, ПредупреждениеМультимодал);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.Отправить.Доступность = Ложь;
	
	ТекущийПромпт = Промпт;
	Промпт = "";
	
	Если ВыполнятьВФоне Тогда
		ЗапуститьЗапросВФоне(ТекущийПромпт);
	Иначе
		ВыполнитьЗапросСинхронно(ТекущийПромпт);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьОтмеченныеВложения()
	
	Для Каждого СтрокаТаблицы Из ТаблицаВложений Цикл
		Если СтрокаТаблицы.Направление = "Исходящее" И СтрокаТаблицы.Отправлять = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура Очистить(Команда)
	Промпт = "";
	ОчиститьИсториюНаСервере();
	ТаблицаВложений.Очистить();
	ВложенияТекст = "";
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВыполнениеЗапроса

&НаКлиенте
Процедура ВыполнитьЗапросСинхронно(ТекущийПромпт)
	
	ДобавитьСообщениеВИсториюЛокально("user", ТекущийПромпт);
	
	РезультатЗапроса = ВыполнитьЗапросНаСервере(ТекущийПромпт);
	
	Элементы.Отправить.Доступность = Истина;
	
	ПроцессИтогиЗапроса(РезультатЗапроса);
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапросНаСервере(Знач ТекстПромпта)
	
	Модель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эксперт, "Модель");
	СтруктураПромпта = СформироватьСтруктураПромпта(Эксперт, ТекстПромпта);
	
	Результат = КИИ_КоннекторИИ.ЗапросКМодели(Модель, СтруктураПромпта);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗапуститьЗапросВФоне(ТекстПромпта)
	
	ДобавитьСообщениеВИсториюЛокально("user", ТекстПромпта);
	
	Попытка
		ФоновоеЗадание = ЗапуститьЗапросВФонеНаСервере(ТекстПромпта);
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка запуска фонового задания:%1%2'"),
			Символы.ПС,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ДобавитьСообщениеВИсториюЛокально("error", ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
		
		Элементы.Отправить.Доступность = Истина;
		Возврат;
	КонецПопытки;
	
	Если ФоновоеЗадание = Неопределено Тогда
		Элементы.Отправить.Доступность = Истина;
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Запрос к модели ИИ...'");
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Ложь;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьЗавершениеФоновогоЗадания", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ФоновоеЗадание, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьЗапросВФонеНаСервере(Знач ТекстПромпта)
	
	Модель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эксперт, "Модель");
	СтруктураПромпта = СформироватьСтруктураПромпта(Эксперт, ТекстПромпта);
	
	Возврат КИИ_КоннекторИИ.ЗапросКМоделиВФоне(Модель, СтруктураПромпта);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьЗавершениеФоновогоЗадания(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.Отправить.Доступность = Истина;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		Если Результат.ИнформацияОбОшибке <> Неопределено Тогда
			ДетальОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке);
		Иначе
			ДетальОшибки = Результат.КраткоеПредставлениеОшибки;
		КонецЕсли;
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка выполнения:%1%2'"), Символы.ПС, ДетальОшибки);
		
		ДобавитьСообщениеВИсториюЛокально("error", ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		РезультатЗапроса = ПолучитьРезультатИзАдреса(Результат.АдресРезультата);
		
		Если РезультатЗапроса <> Неопределено Тогда
			ПроцессИтогиЗапроса(РезультатЗапроса);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРезультатИзАдреса(Знач АдресРезультата)
	
	Попытка
		Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
		Возврат Результат;
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'ИИКона.ПолучениеРезультатаИзХранилища'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ПроцессИтогиЗапроса(РезультатЗапроса)
	
	Если РезультатЗапроса.ЭтоОшибка Тогда
		ДобавитьСообщениеВИсториюЛокально("error", РезультатЗапроса.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Метаинформация = СформироватьМетаинформацию(РезультатЗапроса) + HTMLВложенийОтвета(РезультатЗапроса.ВложенияОтвета);
	ТокенКартинок = ДобавитьВложенияОтветаВТаблицу(РезультатЗапроса.ВложенияОтвета);
	Если Не ПустаяСтрока(ТокенКартинок) Тогда
		Метаинформация = Метаинформация + "[[КИИ_ИЗО:" + ТокенКартинок + "]]";
	КонецЕсли;
	ДобавитьСообщениеВИсториюЛокально("assistant", РезультатЗапроса.ТекстОтвета, Метаинформация);
	Для Каждого СтрокаТаблицы Из ТаблицаВложений Цикл
		Если СтрокаТаблицы.Направление = "Исходящее" Тогда
			СтрокаТаблицы.Отправлять = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСИсторией

&НаКлиенте
Процедура ДобавитьСообщениеВИсториюЛокально(Роль, Текст, Метаинформация = "")
	
	НоваяСтрока = ИсторияДиалога.Добавить();
	НоваяСтрока.Роль = Роль;
	НоваяСтрока.Текст = Текст;
	НоваяСтрока.Метаинформация = Метаинформация;
	
	ОбновитьОтображениеОтвета();
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьМетаинформацию(РезультатЗапроса)
	
	МодельОтвета = ?(ПустаяСтрока(РезультатЗапроса.МодельОтвета), 
		"N/A", 
		РезультатЗапроса.МодельОтвета);
	
	Метаинформация = СтрШаблон(
		НСтр("ru = '⚡ Токены: %1 | ⏱ Время: %2с | ⚒ Модель: %3'"),
		РезультатЗапроса.ВсегоТокенов,
		Формат(РезультатЗапроса.ВремяОтветаСекунд, "ЧЦ=5; ЧДЦ=1"),
		МодельОтвета);
	
	Возврат Метаинформация;
	
КонецФункции

&НаСервере
Процедура ОчиститьИсториюНаСервере()
	
	ИсторияДиалога.Очистить();
	ОбновитьОтображениеОтвета();
	
КонецПроцедуры

#КонецОбласти

#Область ОтображениеДиалога

&НаСервере
Процедура ОбновитьОтображениеОтвета()
	
	Если ИсторияДиалога.Количество() = 0 Тогда
		ОтветHTML = СформироватьПустуюИсториюHTML();
		Возврат;
	КонецЕсли;
	
	Шаблон = Обработки.КИИ_ТестИИ.ПолучитьМакет("ШаблонДиалога").ПолучитьТекст();
	
	ИндексыСКартинками = Новый Массив;
	ИндексСообщения = 0;
	Для Каждого Сообщение Из ИсторияДиалога Цикл
		Если СтрНайти(Сообщение.Метаинформация, "[[КИИ_ИЗО:") > 0 Тогда
			ИндексыСКартинками.Добавить(ИндексСообщения);
		КонецЕсли;
		ИндексСообщения = ИндексСообщения + 1;
	КонецЦикла;
	ПорогИнлайна = 0; // лимит инлайна снят (все картинки в своих пузырях; рост рендера принят пользователем)
	ИнлайнИндексы = Новый Соответствие;
	Для Сч = ПорогИнлайна По ИндексыСКартинками.Количество() - 1 Цикл
		ИнлайнИндексы.Вставить(ИндексыСКартинками[Сч], Истина);
	КонецЦикла;
	
	СообщенияHTML = "";
	ИндексСообщения = 0;
	Для Каждого Сообщение Из ИсторияДиалога Цикл
		ИнлайнЭто = (ИнлайнИндексы[ИндексСообщения] = Истина);
		СообщенияHTML = СообщенияHTML + СформироватьHTMLСообщения(Сообщение, ИнлайнЭто);
		ИндексСообщения = ИндексСообщения + 1;
	КонецЦикла;
	
	HTML = СтрЗаменить(Шаблон, "[MESSAGES]", СообщенияHTML);
	
	ОтветHTML = HTML;
	
КонецПроцедуры

&НаСервере
Функция СформироватьПустуюИсториюHTML()
	
	HTML = "
	|<!DOCTYPE html>
	|<html>
	|<head>
	|    <meta charset='UTF-8'>
	|    <style>
	|        body {
	|            font-family: Arial;
	|            padding: 20px;
	|            text-align: center;
	|            color: #999;
	|        }
	|    </style>
	|</head>
	|<body>
	|    <p>✎ История диалога пуста</p>
	|    <p>Задайте вопрос, чтобы начать общение</p>
	|</body>
	|</html>";
	
	Возврат HTML;
	
КонецФункции

&НаСервере
Функция СформироватьHTMLСообщения(Сообщение, ИнлайнитьКартинки = Ложь)
	
	ОписаниеРоли = ОписаниеРолиСообщения(Сообщение.Роль);
	ТекстСообщения = ОбработатьТекстСообщения(Сообщение.Текст);
	
	ДанныеКартинок = ИзвлечьТокенКартинок(Сообщение.Метаинформация);
	МетаТекст = ДанныеКартинок.МетаТекст;
	КартинкиHTML = "";
	Если ДанныеКартинок.ЕстьКартинки И ИнлайнитьКартинки Тогда
		КартинкиHTML = HTMLИнлайнКартинок(ДанныеКартинок.СписокАдресов);
	КонецЕсли;
	
	HTML = СтрШаблон("
			|<div class='message %1'>
			|    <div class='role'>%2 %3</div>
			|    <div class='content'>%4</div>",
			ОписаниеРоли.Класс, ОписаниеРоли.Эмодзи, ОписаниеРоли.ИмяРоли, ТекстСообщения);
	
	Если Не ПустаяСтрока(КартинкиHTML) Тогда
		HTML = HTML + СтрШаблон("
		|    <div class='content'>%1</div>", КартинкиHTML);
	КонецЕсли;
	
	Если Не ПустаяСтрока(МетаТекст) Тогда
		МетаHTML = КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML(МетаТекст);
		HTML = HTML + СтрШаблон("
		|    <div class='meta'>%1</div>", МетаHTML);
	КонецЕсли;
	
	HTML = HTML + "
			|</div>";
	
	Возврат HTML;
	
КонецФункции

// CSS-класс, подпись и эмодзи для роли сообщения диалога.
&НаСервереБезКонтекста
Функция ОписаниеРолиСообщения(Знач Роль)
	
	Если Роль = "user" Тогда
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "user", НСтр("ru = 'Пользователь'"), "✎");
	ИначеЕсли Роль = "assistant" Тогда
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "assistant", НСтр("ru = 'ИИ эксперт'"), "⚒");
	Иначе
		// Все прочие роли (включая error) рисуем как ошибку.
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "error", НСтр("ru = 'Ошибка'"), "⚠");
	КонецЕсли;
	
КонецФункции

// Выделяет из метаинформации токен [[КИИ_ИЗО:...]] со списком индексов сгенерированных
// картинок. Возвращает структуру: МетаТекст (очищенный от токена), СписокАдресов, ЕстьКартинки.
&НаСервереБезКонтекста
Функция ИзвлечьТокенКартинок(Знач МетаТекст)
	
	Результат = Новый Структура("МетаТекст, СписокАдресов, ЕстьКартинки", МетаТекст, "", Ложь);
	
	НачТокена = СтрНайти(МетаТекст, "[[КИИ_ИЗО:");
	Если НачТокена = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОстатокТокена = Сред(МетаТекст, НачТокена);
	КонецТокенаОтн = СтрНайти(ОстатокТокена, "]]");
	Если КонецТокенаОтн = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПолныйТокен = Сред(МетаТекст, НачТокена, КонецТокенаОтн + 1);
	Результат.СписокАдресов = СтрЗаменить(СтрЗаменить(ПолныйТокен, "[[КИИ_ИЗО:", ""), "]]", "");
	Результат.МетаТекст = СтрЗаменить(МетаТекст, ПолныйТокен, "");
	Результат.ЕстьКартинки = Истина;
	
	Возврат Результат;
	
КонецФункции

// Строки таблицы вложений, сгенерированные моделью (в порядке таблицы).
&НаСервере
Функция СгенерированныеСтрокиВложений()
	
	СгенерированныеСтроки = Новый Массив;
	Для Каждого СтрокаТбл Из ТаблицаВложений Цикл
		Если СтрокаТбл.Направление = "Сгенерировано" Тогда
			СгенерированныеСтроки.Добавить(СтрокаТбл);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СгенерированныеСтроки;
	
КонецФункции

// Собирает inline-HTML картинок по списку индексов из токена (битые индексы пропускаются).
&НаСервере
Функция HTMLИнлайнКартинок(Знач СписокАдресов)
	
	КартинкиHTML = "";
	СгенерированныеСтроки = СгенерированныеСтрокиВложений();
	
	Для Каждого ИндексСтрокой Из СтрРазделить(СписокАдресов, ",", Ложь) Цикл
		// Приведение через БСП, а не Попытка/Исключение: нечисловой ввод дает
		// Неопределено (BSLLS TryNumber - исключение не ветка разбора).
		Индекс = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СокрЛП(ИндексСтрокой));
		Если Индекс = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Индекс < 0 Или Индекс > СгенерированныеСтроки.Количество() - 1 Тогда
			Продолжить;
		КонецЕсли;
		КартинкиHTML = КартинкиHTML + HTMLКартинкиВложения(СгенерированныеСтроки[Индекс]);
	КонецЦикла;
	
	Возврат КартинкиHTML;
	
КонецФункции

// data-URL img-тег одной сгенерированной картинки; пусто, если вложение не двоичные данные.
&НаСервере
Функция HTMLКартинкиВложения(Знач СтрокаКартинки)
	
	ДвоичныеКартинки = ПолучитьИзВременногоХранилища(СтрокаКартинки.Адрес);
	Если ТипЗнч(ДвоичныеКартинки) <> Тип("ДвоичныеДанные") Тогда
		Возврат "";
	КонецЕсли;
	
	МимеКартинки = ?(ПустаяСтрока(СтрокаКартинки.MIME), "image/png", СтрокаКартинки.MIME);
	Base64Картинки = Base64Строка(ДвоичныеКартинки);
	Base64Картинки = СтрЗаменить(Base64Картинки, Символы.ПС, "");
	Base64Картинки = СтрЗаменить(Base64Картинки, Символы.ВК, "");
	МимеБезопасный = КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML(МимеКартинки);
	
	Возврат "<div style=""margin-top:6px"">"
		+ "<img src=""data:" + МимеБезопасный + ";base64," + Base64Картинки + """"
		+ " style=""max-width:480px"">"
		+ "</div>";
	
КонецФункции

&НаСервере
Функция ОбработатьТекстСообщения(Текст)
	
	ТипКонтента = ОпределитьТипКонтента(Текст);
	
	Если ТипКонтента = "HTML" Тогда
		Возврат СтрШаблон("<pre><code class='language-html'>%1</code></pre>", 
			КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML(Текст));
		
	ИначеЕсли ТипКонтента = "JSON" Тогда
		Возврат СтрШаблон("<pre><code class='language-json'>%1</code></pre>", 
			КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML(Текст));
		
	ИначеЕсли ТипКонтента = "Markdown" Тогда
		Возврат КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML(Текст);
	Иначе
		ТекстHTML = КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML(Текст);
		ТекстHTML = СтрЗаменить(ТекстHTML, Символы.ПС, "<br>");
		Возврат ТекстHTML;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ОпределитьТипКонтента(Знач Текст)
	
	ТекстОбрезанный = СокрЛП(Текст);
	
	Если ЭтоПолныйHTMLДокумент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;
	
	Если ЭтоJSON(ТекстОбрезанный) Тогда
		Возврат "JSON";
	КонецЕсли;
	
	Если ЭтоMarkdown(Текст) Тогда
		Возврат "Markdown";
	КонецЕсли;
	
	Если ЭтоHTMLФрагмент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;
	
	Возврат "PlainText";
	
КонецФункции

&НаСервере
Функция ЭтоПолныйHTMLДокумент(Текст)
	
	ТекстНижний = НРег(Текст);
	
	Если СтрНачинаетсяС(ТекстНижний, "<!doctype html") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрНачинаетсяС(ТекстНижний, "<html") 
		И СтрНайти(ТекстНижний, "</html>") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЭтоJSON(Знач Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПервыйСимвол = Лев(Текст, 1);
	ПоследнийСимвол = Прав(Текст, 1);
	
	ЭтоОбъект = (ПервыйСимвол = "{" И ПоследнийСимвол = "}");
	ЭтоМассив = (ПервыйСимвол = "[" И ПоследнийСимвол = "]");
	
	Если НЕ (ЭтоОбъект Или ЭтоМассив) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		ПрочитатьJSON(ЧтениеJSON);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ЭтоHTMLФрагмент(Текст)
	
	ТекстНижний = НРег(Текст);
	
	НачинаетсяСТега = СтрНачинаетсяС(ТекстНижний, "<div")
		Или СтрНачинаетсяС(ТекстНижний, "<table")
		Или СтрНачинаетсяС(ТекстНижний, "<section")
		Или СтрНачинаетсяС(ТекстНижний, "<article");
	
	ЗаканчиваетсяТегом = СтрЗаканчиваетсяНа(ТекстНижний, "</div>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</table>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</section>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</article>");
	
	Возврат НачинаетсяСТега И ЗаканчиваетсяТегом;
	
КонецФункции

&НаСервере
Функция ЭтоMarkdown(Знач Текст)
	
	Возврат КИИ_МаркдаунПарсерКлиентСервер.ЭтоMarkdown(Текст);
	
КонецФункции

#КонецОбласти

#Область НастройкиФормы

&НаСервере
Функция ПолучитьКлючНастроек()
	
	Возврат Метаданные.Обработки.КИИ_ТестИИ.ПолноеИмя();
	
КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкиФормы()
	
	КлючОбъекта = ПолучитьКлючНастроек();
	
	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		КлючОбъекта,
		"НастройкиФормы");
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		РазмерКонтекста = 5;
		Возврат;
	КонецЕсли;
	
	Если Настройки.Свойство("ПоследнийЭксперт") 
		И ЗначениеЗаполнено(Настройки.ПоследнийЭксперт) Тогда
		Эксперт = Настройки.ПоследнийЭксперт;
	КонецЕсли;
	
	Если Настройки.Свойство("ВыполнятьВФоне") Тогда
		ВыполнятьВФоне = Настройки.ВыполнятьВФоне;
	КонецЕсли;
	
	Если Настройки.Свойство("РазмерКонтекста") Тогда
		РазмерКонтекста = Настройки.РазмерКонтекста;
	Иначе
		РазмерКонтекста = 5;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиФормы()
	
	КлючОбъекта = ПолучитьКлючНастроек();
	
	Настройки = Новый Структура;
	Настройки.Вставить("ПоследнийЭксперт", Эксперт);
	Настройки.Вставить("ВыполнятьВФоне", ВыполнятьВФоне);
	Настройки.Вставить("РазмерКонтекста", РазмерКонтекста);
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		КлючОбъекта,
		"НастройкиФормы",
		Настройки);
	
КонецПроцедуры

#КонецОбласти

#Область Вспомогательные

&НаСервереБезКонтекста
Функция HTMLВложенийОтвета(Знач Вложения)
	
	Если ТипЗнч(Вложения) <> Тип("Массив") Или Вложения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	HTML = "";
	Для Каждого Вложение Из Вложения Цикл
		Если Ложь Тогда // base64 отключен: изображения отображаются строками в таблице вкладки «Вложения»
			Base64Картинки = Base64Строка(Вложение.ДвоичныеДанные);
			Base64Картинки = СтрЗаменить(Base64Картинки, Символы.ПС, "");
			Base64Картинки = СтрЗаменить(Base64Картинки, Символы.ВК, "");
			МимеБезопасный = КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML(Вложение.MIME);
			HTML = HTML + "<div><img src=""data:" + МимеБезопасный + ";base64,"
				+ Base64Картинки + """ style=""max-width:480px""></div>";
		Иначе
			Подпись = СтрШаблон(НСтр("ru = '[вложение: %1, %2, %3 Б]'"),
				КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML(Вложение.ИмяФайла),
				КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML(Вложение.MIME),
				Формат(Вложение.РазмерБайт, "ЧГ=0"));
			HTML = HTML + "<div class=""attachment"">" + Подпись + "</div>";
		КонецЕсли;
	КонецЦикла;
	Возврат HTML;
	
КонецФункции
&НаСервереБезКонтекста
Функция КонтентВложения(Знач Адрес, Знач Имя, Знач MIME)
	
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	MIMEНижнийРегистр = НРег(MIME);
	
	Если Лев(MIMEНижнийРегистр, 6) = "image/" Тогда
		Возврат КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные(Данные, MIME);
	КонецЕсли;
	
	ЭтоТекстовыйФормат = Лев(MIMEНижнийРегистр, 5) = "text/"
		Или MIMEНижнийРегистр = "application/json"
		Или MIMEНижнийРегистр = "application/xml";
	Если ЭтоТекстовыйФормат Тогда
		ТекстФайла = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
		Шапка = СтрШаблон(НСтр("ru = 'Содержимое файла %1:'"), Имя);
		Возврат КИИ_КоннекторИИ.ПостроитьКонтентТекст(Шапка + Символы.ПС + ТекстФайла);
	КонецЕсли;
	
	Возврат КИИ_КоннекторИИ.ПостроитьКонтентДокументДанные(Данные, MIME, Имя);
	
КонецФункции

&НаКлиенте
Процедура ПрикрепитьФайлы(Команда)
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	// Фильтр диалога: описание и маски разделяются вертикальной чертой, поэтому собираем
	// строку конкатенацией - многострочный литерал НСтр здесь использовать нельзя.
	МаскиФайлов = "*.png;*.jpg;*.jpeg;*.webp;*.gif;*.pdf;*.doc;*.docx;*.rtf;"
		+ "*.txt;*.md;*.csv;*.json;*.xml;*.html;*.htm;*.log";
	ПараметрыЗагрузки.Диалог.Фильтр = НСтр("ru = 'Изображения и документы'") + "|" + МаскиФайлов;
	ПараметрыЗагрузки.Диалог.МножественныйВыбор = Истина;
	
	Оповещение = Новый ОписаниеОповещения("ПослеПрикрепленияФайлов", ЭтотОбъект);
	ФайловаяСистемаКлиент.ЗагрузитьФайлы(Оповещение, ПараметрыЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПрикрепленияФайлов(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовыеФайлы = Новый Массив;
	Для Каждого ПомещенныйФайл Из ПомещенныеФайлы Цикл
		ОписаниеФайла = Новый Структура("Имя, Адрес", ПомещенныйФайл.ИмяФайла, ПомещенныйФайл.Хранение);
		НовыеФайлы.Добавить(ОписаниеФайла);
	КонецЦикла;
	
	Если НовыеФайлы.Количество() > 0 Тогда
		ДобавитьВложенияНаСервере(НовыеФайлы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВложенияНаСервере(Знач НовыеФайлы)
	
	Для Каждого НовыйФайл Из НовыеФайлы Цикл
		НоваяСтрока = ТаблицаВложений.Добавить();
		НоваяСтрока.Направление = "Исходящее";
		НоваяСтрока.Отправлять = Истина;
		НоваяСтрока.Имя = НовыйФайл.Имя;
		НоваяСтрока.MIME = MIMEПоИмениФайла(НовыйФайл.Имя);
		НоваяСтрока.Адрес = НовыйФайл.Адрес;
		НоваяСтрока.РазмерБайт = 0;
	КонецЦикла;
	
	СтрокиВложений = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаВложений Цикл
		Если СтрокаТаблицы.Направление = "Исходящее" Тогда
			СтрокиВложений.Добавить(СтрШаблон("%1 (%2)", СтрокаТаблицы.Имя, СтрокаТаблицы.MIME));
		КонецЕсли;
	КонецЦикла;
	ВложенияТекст = СтрСоединить(СтрокиВложений, Символы.ПС);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция MIMEПоИмениФайла(Имя)
	
	ПозицияТочки = СтрНайти(Имя, ".", НаправлениеПоиска.СКонца);
	Если ПозицияТочки > 0 Тогда
		Расширение = НРег(Сред(Имя, ПозицияТочки + 1));
	Иначе
		Расширение = "";
	КонецЕсли;
	
	КартаMIME = Новый Соответствие;
	КартаMIME.Вставить("png",  "image/png");
	КартаMIME.Вставить("jpg",  "image/jpeg");
	КартаMIME.Вставить("jpeg", "image/jpeg");
	КартаMIME.Вставить("webp", "image/webp");
	КартаMIME.Вставить("gif",  "image/gif");
	КартаMIME.Вставить("pdf",  "application/pdf");
	КартаMIME.Вставить("doc",  "application/msword");
	КартаMIME.Вставить("docx", "application/vnd.openxmlformats-officedocument.wordprocessingml.document");
	КартаMIME.Вставить("rtf",  "application/rtf");
	КартаMIME.Вставить("csv",  "text/csv");
	КартаMIME.Вставить("json", "application/json");
	КартаMIME.Вставить("xml",  "application/xml");
	КартаMIME.Вставить("html", "text/html");
	КартаMIME.Вставить("htm",  "text/html");
	
	MIME = КартаMIME[Расширение];
	Если MIME = Неопределено Тогда
		Возврат "text/plain";
	КонецЕсли;
	Возврат MIME;
	
КонецФункции

&НаКлиенте
Процедура ОчиститьВложения(Команда)
	Индекс = ТаблицаВложений.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ТаблицаВложений[Индекс].Направление = "Исходящее" Тогда
			ТаблицаВложений.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	ВложенияТекст = "";
	
КонецПроцедуры

&НаСервере
Функция ДобавитьВложенияОтветаВТаблицу(Знач ВложенияОтвета)
	
	ТокенИзображений = "";
	Если ТипЗнч(ВложенияОтвета) <> Тип("Массив") Тогда
		Возврат ТокенИзображений;
	КонецЕсли;
	СчетчикСгенерированных = 0;
	Для Каждого СтрокаПодсчета Из ТаблицаВложений Цикл
		Если СтрокаПодсчета.Направление = "Сгенерировано" Тогда
			СчетчикСгенерированных = СчетчикСгенерированных + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ВложениеОтвета Из ВложенияОтвета Цикл
		Если ВложениеОтвета.Тип <> "image" Тогда
			Продолжить;
		КонецЕсли;
		АдресВХ = ПоместитьВоВременноеХранилище(ВложениеОтвета.ДвоичныеДанные, УникальныйИдентификатор);
		НоваяСтрока = ТаблицаВложений.Добавить();
		НоваяСтрока.Направление = "Сгенерировано";
		НоваяСтрока.Отправлять = Ложь;
		НоваяСтрока.Имя = ВложениеОтвета.ИмяФайла;
		НоваяСтрока.MIME = ВложениеОтвета.MIME;
		НоваяСтрока.РазмерБайт = ВложениеОтвета.РазмерБайт;
		НоваяСтрока.Адрес = АдресВХ;
		ТокенИзображений = ТокенИзображений + Строка(СчетчикСгенерированных) + ",";
		СчетчикСгенерированных = СчетчикСгенерированных + 1;
	КонецЦикла;
	
	Возврат ТокенИзображений;
	
КонецФункции

&НаКлиенте
Процедура СохранитьВыбранноеВложение(Команда)
	
	ТекущаяСтрока = Элементы.ТаблицаВложений.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Или ПустаяСтрока(ТекущаяСтрока.Адрес) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку с файлом'"));
		Возврат;
	КонецЕсли;
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, ТекущаяСтрока.Адрес, ТекущаяСтрока.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотретьВыбранноеВложение(Команда)
	
	ТекущаяСтрока = Элементы.ТаблицаВложений.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Или ПустаяСтрока(ТекущаяСтрока.Адрес) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку с файлом'"));
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, Новый Картинка(ПолучитьИзВременногоХранилища(ТекущаяСтрока.Адрес)));
	
КонецПроцедуры

&НаСервере
Функция МультимодалДоступенДляЭксперта()
	
	ЕстьОтмеченные = Ложь;
	Для Каждого СтрокаТаблицы Из ТаблицаВложений Цикл
		Если СтрокаТаблицы.Направление = "Исходящее" И СтрокаТаблицы.Отправлять = Истина Тогда
			ЕстьОтмеченные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьОтмеченные Тогда
		Возврат "";
	КонецЕсли;
	
	Модель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эксперт, "Модель");
	ПараметрыМодели = КИИ_КоннекторИИ.ПараметрыМодели(Модель);
	СтруктураПромпта = СформироватьСтруктураПромпта(Эксперт, Промпт);
	СтруктураПромпта.Вставить("ЕстьИзображения", Истина);
	
	Попытка
		КИИ_КоннекторИИ.ПроверитьПоддержкуМультимодала(ПараметрыМодели, СтруктураПромпта);
	Исключение
		Возврат ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция СформироватьСтруктураПромпта(Знач Эксперт, Знач Промпт)
	
	Результат = Новый Структура;
	Результат.Вставить("СистемныйПромпт", "");
	Результат.Вставить("ПользовательскийПромпт", "");
	Результат.Вставить("ИсторияСообщений", Новый Массив);
	
	ПромптЭксперта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эксперт, "ОписаниеЭксперта");
	// { androman 2026-06-19 RAG-ревайвл
	Результат.СистемныйПромпт = КИИ_RAG.ПодмешатьЗнанияЭксперта(Эксперт, Промпт, ПромптЭксперта);
	// }
	Результат.ПользовательскийПромпт = Промпт;
	
	Если ЕстьИсходящиеВложения() Тогда
		КонтентСВложениями = КонтентПромптаСВложениями(Промпт);
		Если КонтентСВложениями <> Неопределено Тогда
			Результат.ПользовательскийПромпт = КонтентСВложениями;
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьИсториюДиалога(Результат);
	
	Возврат Результат;
	
КонецФункции

// Истина, если в таблице вложений есть хотя бы одно отправляемое исходящее вложение.
&НаСервере
Функция ЕстьИсходящиеВложения()
	
	Для Каждого СтрокаТаблицы Из ТаблицаВложений Цикл
		Если СтрокаТаблицы.Направление = "Исходящее" И СтрокаТаблицы.Отправлять = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Мультимодальный контент запроса: текст промпта + отправляемые вложения таблицы.
// Неопределено, если ни одно вложение добавить не удалось - остаемся на текстовом промпте.
&НаСервере
Функция КонтентПромптаСВложениями(Знач Промпт)
	
	Контент = КИИ_КоннекторИИ.ПостроитьКонтентМассив();
	Если Не ПустаяСтрока(Промпт) Тогда
		Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентТекст(Промпт));
	КонецЕсли;
	
	ДобавленоВложений = 0;
	Для Каждого СтрокаТаблицы Из ТаблицаВложений Цикл
		Если СтрокаТаблицы.Направление <> "Исходящее" Или СтрокаТаблицы.Отправлять <> Истина Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЭлементКонтента = КонтентВложения(СтрокаТаблицы.Адрес, СтрокаТаблицы.Имя, СтрокаТаблицы.MIME);
		Исключение
			// данные временного хранилища недоступны (очищено/протухло) - пропускаем вложение
			Продолжить;
		КонецПопытки;
		Контент.Добавить(ЭлементКонтента);
		ДобавленоВложений = ДобавленоВложений + 1;
	КонецЦикла;
	
	Возврат ?(ДобавленоВложений > 0, Контент, Неопределено);
	
КонецФункции

// Добавляет в структуру промпта хвост истории диалога, ограниченный размером контекста.
// Пропускаются сообщения-ошибки и последнее user-сообщение (оно уходит текущим промптом).
&НаСервере
Процедура ДобавитьИсториюДиалога(Результат)
	
	Если ИсторияДиалога.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоДоступных = ИсторияДиалога.Количество() - 1;
	Если РазмерКонтекста = 0 Тогда
		НачальнаяПозиция = 0;
	Иначе
		НачальнаяПозиция = Макс(0, КоличествоДоступных - РазмерКонтекста);
	КонецЕсли;
	
	Для Индекс = НачальнаяПозиция По ИсторияДиалога.Количество() - 1 Цикл
		
		Сообщение = ИсторияДиалога[Индекс];
		
		Если Сообщение.Роль = "error" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Индекс = ИсторияДиалога.Количество() - 1 И Сообщение.Роль = "user" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаИстории = Новый Структура;
		СтрокаИстории.Вставить("Роль", Сообщение.Роль);
		СтрокаИстории.Вставить("Текст", Сообщение.Текст);
		
		Результат.ИсторияСообщений.Добавить(СтрокаИстории);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

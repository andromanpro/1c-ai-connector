#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	КоличествоРезультатов = 3;
	МодельДляПроверки = КИИ_RAG.ТекущаяМодельЭмбеддер();
	ПорогСходства = 0;
	ПоискВыполняется = Ложь;
	Если Параметры.Свойство("БазаПоиска") Тогда
		БазаПоиска = Параметры.БазаПоиска;
	КонецЕсли;
	Если Параметры.Свойство("ЭкспертПоиска") Тогда
		ЭкспертПоиска = Параметры.ЭкспертПоиска;
	КонецЕсли;
	ПояснениеПоиска = НСтр(
		"ru = 'Проверка показывает найденные знания и их источники. Ответ эксперта не генерируется. Для поиска по
			|вопросу может потребоваться платный запрос к внешнему сервису эмбеддингов. Проверка готовности индекса
			|выполняется без такого запроса.'");
	Сведения = КИИ_RAG.СведенияДляПроверкиПоиска(ЭкспертПоиска, БазаПоиска, КатегорияПоиска, МодельДляПроверки);
	СостояниеПоиска = Сведения.Диагностика;
	МодельПоиска = ?(ЗначениеЗаполнено(Сведения.Модель),
		Строка(Сведения.Модель) + " (" + Сведения.КодМодели + ")", НСтр("ru = 'Не настроена'"));

КонецПроцедуры


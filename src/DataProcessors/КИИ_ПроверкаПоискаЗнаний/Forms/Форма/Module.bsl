#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	КоличествоРезультатов = 3;
	МодельДляПроверки = КИИ_RAG.ТекущаяМодельЭмбеддер();
	ПорогСходства = 0;
	ПоискВыполняется = Ложь;
	Если Параметры.Свойство("БазаПоиска") Тогда
		БазаПоиска = Параметры.БазаПоиска;
	КонецЕсли;
	Если Параметры.Свойство("ЭкспертПоиска") Тогда
		ЭкспертПоиска = Параметры.ЭкспертПоиска;
	КонецЕсли;
	ПояснениеПоиска = НСтр(
		"ru = 'Показываются фрагменты источников.
			|Ответ ИИ здесь не формируется.
			|Запрос к модели может быть платным.'");
	Сведения = КИИ_ИнтерфейсВызовСервера.СведенияПоиска(ЭкспертПоиска, БазаПоиска, КатегорияПоиска, МодельДляПроверки);
	МодельДляПроверки = Сведения.Модель;
	Элементы.МодельДляПроверки.ТолькоПросмотр = ЗначениеЗаполнено(БазаПоиска);
	СостояниеПоиска = Сведения.Диагностика;
	МодельПоиска = ?(ЗначениеЗаполнено(Сведения.Модель),
		Строка(Сведения.Модель) + " (" + Сведения.КодМодели + ")", Сведения.КодМодели);

КонецПроцедуры

#КонецОбласти


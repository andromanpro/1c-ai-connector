#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗагрузитьНастройки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьВыполнить(Команда)

	Сохранить();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки MCP сохранены'"));

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьPingВыполнить(Команда)

	Результат = ВыполнитьPingНаСервере();
	СтатусПроверки = Результат;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПубликацию(Команда)

	Элементы.ПроверитьПубликацию.Доступность = Ложь;
	СтатусПроверки = НСтр("ru = 'Проверка введенного адреса HTTP-публикации и учетных данных API...'");
	Попытка
		Операция = НачатьПроверкуПубликации();
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиПубликации", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);
	Исключение
		Элементы.ПроверитьПубликацию.Доступность = Истина;
		СтатусПроверки = НСтр("ru = 'Не удалось запустить проверку HTTP-публикации.'");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьНастройки()

	Пользователь = Константы.КИИ_СерверMCPПользовательAPI.Получить();

	// Пароль читается в привилегированном режиме (иначе форму не открыть без полных прав базы),
	// поэтому только тому, кто вправе менять настройки MCP.
	ДанныеХранилища = Неопределено;
	Если ПравоДоступа("Изменение", Метаданные.Константы.КИИ_СерверMCPПользовательAPI) Тогда
		УстановитьПривилегированныйРежим(Истина);
		ДанныеХранилища = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			"КИИ_СерверMCPПользовательAPI",
			"Пароль");
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	Если ДанныеХранилища = Неопределено Тогда
		Пароль = "";
	Иначе
		Пароль = Строка(ДанныеХранилища);
	КонецЕсли;

	ШаблонАдреса = НСтр("ru = 'Шаблон: '") + СформироватьАдресСервиса();
	СохраненныйАдрес = ХранилищеОбщихНастроек.Загрузить("КИИ_MCPПубликация", "Адрес");
	АдресСервиса = ?(ТипЗнч(СохраненныйАдрес) = Тип("Строка"), СохраненныйАдрес, "");
	СтатусПроверки = "";

КонецПроцедуры

&НаСервере
Процедура Сохранить()

	КонстантаМенеджер = Константы.КИИ_СерверMCPПользовательAPI.СоздатьМенеджерЗначения();
	КонстантаМенеджер.Значение = Пользователь;
	КонстантаМенеджер.Записать();

	// Безопасное хранилище БСП пишется только в привилегированном режиме: без него пароль
	// не сохранял пользователь с ролью «КИИ полные права». Право на настройки MCP проверила запись
	// константы выше: без него она бы упала раньше.
	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
		"КИИ_СерверMCPПользовательAPI",
		Пароль,
		"Пароль");
	УстановитьПривилегированныйРежим(Ложь);

	ХранилищеОбщихНастроек.Сохранить("КИИ_MCPПубликация", "Адрес", СокрЛП(АдресСервиса));
	КИИ_КоннекторИИ.ОбеспечитьРегламентыОчистки();

КонецПроцедуры

&НаСервере
Функция СформироватьАдресСервиса()

	Возврат НСтр("ru = 'http://<сервер>/<база>/hs/iikona-mcp/rpc'");

КонецФункции

&НаСервере
Функция ВыполнитьPingНаСервере()

	Попытка
		Результат = КИИ_СерверMCPРеестр.ВыполнитьИнструмент("ping", Новый Структура);
		Если ТипЗнч(Результат) = Тип("Структура")
			И Результат.Свойство("pong")
			И Результат.pong Тогда

			Возврат СтрШаблон(
				НСтр("ru = 'Внутренний сервис исправен (%1). HTTP-публикация и авторизация API этой проверкой не проверялись.'"),
				Результат.timestamp);

		Иначе
			Возврат НСтр("ru = '✗ ping вернул неожиданный результат'");
		КонецЕсли;
	Исключение
		Возврат СтрШаблон(
			НСтр("ru = '✗ ошибка: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

&НаСервере
Функция НачатьПроверкуПубликации()

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"КИИ_СерверMCPAuth.ПроверитьПубликациюMCP", СокрЛП(АдресСервиса), Пользователь, Пароль);

КонецФункции

&НаКлиенте
Процедура ПослеПроверкиПубликации(Результат, ДополнительныеПараметры) Экспорт

	Элементы.ПроверитьПубликацию.Доступность = Истина;
	Если Результат = Неопределено Тогда
		СтатусПроверки = НСтр("ru = 'Проверка HTTP-публикации отменена.'");
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		СтатусПроверки = НСтр("ru = 'Ошибка выполнения проверки HTTP-публикации.'");
	Иначе
		СтатусПроверки = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

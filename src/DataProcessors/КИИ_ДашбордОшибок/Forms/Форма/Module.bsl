#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПериодДней = 30;
	ТемаСтраницы = "light";

	// Растяжения HTML-поля не переживают выгрузку формы при обновлении конфигурации - задаем программно.
	Элементы.ПолеДашборд.РастягиватьПоГоризонтали = Истина;
	Элементы.ПолеДашборд.РастягиватьПоВертикали = Истина;

	ЗаполнитьДашборд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Кнопки дашборда - на самой странице: клик по ссылке «#iikona?command=...» приходит сюда вместе
// с открытым периодом и темой, форма выполняет команду и возвращает страницу в том же состоянии.
&НаКлиенте
Процедура ПолеДашбордПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Ссылка = Неопределено;
	ДанныеСобытия.Свойство("Href", Ссылка);
	Команда = КИИ_МониторингОшибокДашбордКлиентСервер.КомандаСтраницы(Ссылка);
	Если ТипЗнч(Команда) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ПериодДней = Команда.ПериодДней;
	ТемаСтраницы = Команда.Тема;

	Если Команда.Имя = "open-error" Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", Новый Структура("ХешОшибки", Команда.ХешОшибки));
		ПараметрыФормы.Вставить("ХешОшибки", Команда.ХешОшибки);
		ОткрытьФорму("РегистрСведений.КИИ_МониторингОшибокЖурнал.Форма.ФормаСписка", ПараметрыФормы);
	ИначеЕсли Команда.Имя = "refresh" Тогда
		ЗаполнитьДашборд();
	ИначеЕсли Команда.Имя = "analyze" Тогда
		ПроанализироватьИОповестить();
	ИначеЕсли Команда.Имя = "deep" Тогда
		ВыполнитьГлубокийАнализИОповестить();
	ИначеЕсли Команда.Имя = "enable" Тогда
		ВключитьРегламентыИОповестить();
	ИначеЕсли Команда.Имя = "deep-hide" Тогда
		РезультатГлубокогоАнализа = "";
		ЗаполнитьДашборд();
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестная команда дашборда: %1'"), Команда.Имя);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьДашборд();

КонецПроцедуры

&НаКлиенте
Процедура ВключитьРегламенты(Команда)

	ВключитьРегламентыИОповестить();

КонецПроцедуры

&НаКлиенте
Процедура ПроанализироватьСейчас(Команда)

	ПроанализироватьИОповестить();

КонецПроцедуры

// Инструментальный (function-calling) анализ топ-ошибки: модель сама запрашивает данные базы
// через безопасные read-only инструменты и делает вывод по фактам, а не по догадкам.
&НаКлиенте
Процедура ГлубокийАнализ(Команда)

	ВыполнитьГлубокийАнализИОповестить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроанализироватьИОповестить()

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияАнализа", ЭтотОбъект, "Обычный");
	ТекстВопроса = НСтр(
		"ru = 'Отправить ошибки модели из настроек мониторинга? Запросы могут быть платными. Обычный анализ
			|обрабатывает очередь и может отправлять настроенные уведомления; глубокий анализ разбирает самую
			|частую ошибку выбранного периода с инструментами.'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьГлубокийАнализИОповестить()

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияАнализа", ЭтотОбъект, "Глубокий");
	ТекстВопроса = НСтр(
		"ru = 'Отправить ошибки модели из настроек мониторинга? Запросы могут быть платными. Обычный анализ
			|обрабатывает очередь и может отправлять настроенные уведомления; глубокий анализ разбирает самую
			|частую ошибку выбранного периода с инструментами.'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ВключитьРегламентыИОповестить()

	Создано = ВключитьРегламентыНаСервере();
	Если Создано > 0 Тогда
		ПоказатьОповещениеПользователя(
			СтрШаблон(НСтр("ru = 'Создано регламентных заданий: %1. Сбор и анализ работают по расписанию'"), Создано));
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Регламентные задания включены'"));
	КонецЕсли;

КонецПроцедуры

// Регламентные задания расширения не предопределены - платформа не создает их экземпляры сама.
// Кнопка дает клиенту включить мониторинг без обращения к разработчику.
&НаСервере
Функция ВключитьРегламентыНаСервере()

	Результат = КИИ_МониторингОшибок.ИнициализироватьРегламентныеЗадания(Истина);
	ЗаполнитьДашборд();
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ВыполнитьАнализНаСервере()

	КИИ_МониторингОшибок.ВыполнитьАнализИИ();
	ЗаполнитьДашборд();

КонецПроцедуры

// Глубокий анализ самой частой ошибки инструментальным агентом. В HTML-дашборде нет таблицы
// для выбора строки, поэтому берем топ по количеству повторений - самое болезненное для клиента.
// Результат показывает панель на странице (ТекстГлубокогоАнализа в настройках страницы).
&НаСервере
Процедура ВыполнитьГлубокийАнализНаСервере()

	// Самая частая ошибка за период, открытый на дашборде (как в блоке «что болит»); сам анализ - общий вход
	// в модуле анализа (он же используется командами форм списков журнала и статистики).
	ХешОшибки = КИИ_МониторингОшибокДашборд.ХешСамойЧастойОшибки(ТекущаяДатаСеанса(), ПериодДней);

	Если ЗначениеЗаполнено(ХешОшибки) Тогда
		ИтогАнализа = КИИ_МониторингОшибокАнализ.ВыполнитьГлубокийАнализОшибки(ХешОшибки);
		РезультатГлубокогоАнализа = ИтогАнализа.Текст;
	Иначе
		РезультатГлубокогоАнализа = НСтр("ru = 'Нет ошибок для анализа.'");
	КонецЕсли;

	ЗаполнитьДашборд();

КонецПроцедуры

// Страница дашборда (КИИ_МониторингОшибокДашборд): графики строит браузер HTML-поля, периоды 7/30/90
// и тема переключаются на странице и возвращаются в форму со ссылкой команды; ПериодДней задает
// период при открытии и для глубокого анализа.
&НаСервере
Процедура ЗаполнитьДашборд()

	Если ПериодДней <> 7 И ПериодДней <> 90 Тогда
		ПериодДней = 30;
	КонецЕсли;

	НастройкиСтраницы = КИИ_МониторингОшибокДашборд.НовыеНастройкиСтраницы();
	НастройкиСтраницы.ПериодДней = ПериодДней;
	НастройкиСтраницы.Тема = ТемаСтраницы;
	НастройкиСтраницы.КомандыФормы = Истина;
	НастройкиСтраницы.ТекстГлубокогоАнализа = РезультатГлубокогоАнализа;
	HTMLДашборд = КИИ_МониторингОшибокДашборд.СтраницаДашборда(НастройкиСтраницы);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияАнализа(Ответ, ВидАнализа) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Операция = НачатьАнализНаСервере(ВидАнализа);
	Исключение
		ПоказатьПредупреждение(, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Если Операция = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Предыдущий анализ еще выполняется. Отмена ожидания не гарантирует остановку запроса.'"));
		Возврат;
	КонецЕсли;
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Ложь;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Анализ ошибок...'");
	Оповещение = Новый ОписаниеОповещения("ПослеАнализа", ЭтотОбъект, ВидАнализа);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция НачатьАнализНаСервере(Знач ВидАнализа)

	Если Не ПустаяСтрока(ЗаданиеАнализа) Тогда
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ЗаданиеАнализа));
		Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Не ПустаяСтрока(АдресРезультатаАнализа) Тогда
			УдалитьИзВременногоХранилища(АдресРезультатаАнализа);
		КонецЕсли;
	КонецЕсли;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Анализ ошибок'");
	Если ВидАнализа = "Глубокий" Тогда
		Хеш = КИИ_МониторингОшибокДашборд.ХешСамойЧастойОшибки(ТекущаяДатаСеанса(), ПериодДней);
		Если ПустаяСтрока(Хеш) Тогда
			ВызватьИсключение НСтр("ru = 'За выбранный период нет ошибок для анализа.'");
		КонецЕсли;
		Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"КИИ_МониторингОшибокАнализ.ВыполнитьГлубокийАнализОшибки", Хеш);
	Иначе
		Операция = ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "КИИ_МониторингОшибок.ВыполнитьАнализИИ");
	КонецЕсли;
	ЗаданиеАнализа = Строка(Операция.ИдентификаторЗадания);
	АдресРезультатаАнализа = Операция.АдресРезультата;
	Возврат Операция;

КонецФункции

&НаКлиенте
Процедура ПослеАнализа(Результат, ВидАнализа) Экспорт

	Если Результат = Неопределено Тогда
		РезультатГлубокогоАнализа = НСтр(
			"ru = 'Ожидание анализа отменено. Запрос может продолжаться; повторный запуск доступен после завершения задания.'");
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		РезультатГлубокогоАнализа = Результат.КраткоеПредставлениеОшибки;
	Иначе
		ПоказатьИтогАнализа(Результат.АдресРезультата, ВидАнализа);
	КонецЕсли;
	ЗаполнитьДашборд();

КонецПроцедуры

&НаСервере
Процедура ПоказатьИтогАнализа(Знач АдресРезультата, Знач ВидАнализа)

	Если ВидАнализа = "Глубокий" Тогда
		Итог = ПолучитьИзВременногоХранилища(АдресРезультата);
		РезультатГлубокогоАнализа = Итог.Текст;
	Иначе
		РезультатГлубокогоАнализа = НСтр(
			"ru = 'Обработка очереди завершена. Итоги отдельных ошибок смотрите в журнале; отсутствие разбора не
				|означает успешный запрос к модели.'");
	КонецЕсли;
	Если Не ПустаяСтрока(АдресРезультата) Тогда
		УдалитьИзВременногоХранилища(АдресРезультата);
	КонецЕсли;
	АдресРезультатаАнализа = "";

КонецПроцедуры

#КонецОбласти

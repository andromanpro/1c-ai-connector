#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ПустаяСтрока(URLKroki) Тогда
		URLKroki = "http://localhost:8000";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Тест 1: ПроверитьНаличиеИИконы()
// Проверяет доступность подсистемы ИИкона (наличие модуля КИИ_КоннекторИИ).
//
&НаКлиенте
// ПроверитьИИкону.
Процедура ПроверитьИИкону(Команда)

	Найдена = ПроверитьИИконуНаСервере();

	Если Найдена Тогда
		РезультатСтатус = НСтр("ru = '✅ ПроверитьНаличиеИИконы() = Истина - подсистема ИИкона доступна'");
	Иначе
		РезультатСтатус = НСтр("ru = '❌ ПроверитьНаличиеИИконы() = Ложь - подсистема ИИкона не найдена'");
	КонецЕсли;

КонецПроцедуры

// Тест 2: ОпределитьВидДиаграммы(КодДиаграммы)
// Автоматически определяет вид диаграммы по маркерам первых строк.
// Поддерживает 26 типов: mermaid, plantuml, graphviz, d2, bpmn, erd и др.
// Требует: поле «Описание или код диаграммы» заполнено кодом диаграммы.
//
&НаКлиенте
// ОпределитьТип.
Процедура ОпределитьТип(Команда)

	Если ПустаяСтрока(ВходнойТекст) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите код диаграммы в поле «Описание или код диаграммы»'"));
		Возврат;
	КонецЕсли;

	ВидДиаграммы    = ОпределитьТипНаСервере(ВходнойТекст);
	РезультатСтатус = СтрШаблон(НСтр("ru = '✅ ОпределитьВидДиаграммы() = %1'"), ВидДиаграммы);

КонецПроцедуры

// Тест 3: ПроверитьДоступностьKroki(URLKroki, Таймаут)
// Проверяет подключение к kroki через GET /healthcheck → ожидает 200 OK.
// Использует URLKroki из поля формы.
//
&НаКлиенте
// ПроверитьKroki.
Процедура ПроверитьKroki(Команда)

	Рез = ПроверитьKrokiНаСервере(URLKroki);

	Если Рез.Доступен Тогда
		РезультатСтатус = "✅ " + Рез.Сообщение;
	Иначе
		РезультатСтатус = "❌ " + Рез.Сообщение;
	КонецЕсли;

КонецПроцедуры

// Тест 4: РендеритьЧерезKroki(КодДиаграммы, ВидДиаграммы, ПараметрыРендеринга)
// Рендерит готовый код диаграммы через kroki JSON POST API → SVG.
// ПараметрыРендеринга - структура из НовыеПараметрыРендеринга() (URLKroki, Тема, Формат, Таймаут).
// SVG оборачивается в HTML через ПостроитьHTMLДляПросмотра() и отображается в поле предпросмотра.
// Требует: поле «Описание или код диаграммы» заполнено готовым кодом диаграммы.
//
&НаКлиенте
// НарисоватьКод.
Процедура НарисоватьКод(Команда)

	Если ПустаяСтрока(ВходнойТекст) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите код диаграммы'"));
		Возврат;
	КонецЕсли;

	РезультатКодДиаграммы = "";

	Рез = НарисоватьКодНаСервере(ВходнойТекст, URLKroki);

	Если Рез.ЭтоОшибка Тогда
		РезультатСтатус = "❌ " + Рез.ТекстОшибки;
	Иначе
		РезультатСтатус = СтрШаблон(
			НСтр("ru = '✅ РендеритьЧерезKroki() - SVG получен, вид: %1'"), Рез.ВидДиаграммы);
		РезультатКодДиаграммы = ВходнойТекст;
		РезультатHTMLДокумент = Рез.HTML;
	КонецЕсли;

КонецПроцедуры

// Тест 5: СгенерироватьДиаграмму(ОписаниеИлиКод, НастройкиОформления, Эксперт)
// Единая точка входа - автоматически определяет тип входа:
//   • Готовый код диаграммы → ИИ не вызывается, сразу рендеринг через kroki.
//   • Текстовое описание   → вызов ИИ (требует Эксперт), затем рендеринг через kroki.
// Результат (код + SVG) отображается в полях формы.
//
&НаКлиенте
// СгенерироватьДиаграмму.
Процедура СгенерироватьДиаграмму(Команда)

	Если ПустаяСтрока(ВходнойТекст) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите описание или код диаграммы'"));
		Возврат;
	КонецЕсли;

	РезультатКодДиаграммы = "";

	Рез = СгенерироватьДиаграммуНаСервере(ВходнойТекст, URLKroki, Эксперт);

	Если Рез.ЭтоОшибка Тогда
		РезультатСтатус = "❌ " + Рез.ТекстОшибки;
	Иначе
		РезультатСтатус       = СтрШаблон(НСтр("ru = '✅ СгенерироватьДиаграмму() - вид: %1'"), Рез.ВидДиаграммы);
		РезультатКодДиаграммы = Рез.КодДиаграммы;
		РезультатHTMLДокумент = Рез.HTML;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	ВходнойТекст          = "";
	РезультатСтатус       = "";
	РезультатКодДиаграммы = "";
	РезультатHTMLДокумент = "";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызывает КИИ_ГенераторДиаграмм.ПроверитьНаличиеИИконы()
//
&НаСервереБезКонтекста
// ПроверитьИИконуНаСервере.
Функция ПроверитьИИконуНаСервере()

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();
	Возврат Обработка.ПроверитьНаличиеИИконы();

КонецФункции

// Вызывает КИИ_ГенераторДиаграмм.ОпределитьВидДиаграммы(КодДиаграммы)
// Возвращает строку с именем вида: "mermaid", "plantuml", "graphviz" и т.д.
//
&НаСервереБезКонтекста
// ОпределитьТипНаСервере.
Функция ОпределитьТипНаСервере(Знач КодДиаграммы)

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();
	Возврат Обработка.ОпределитьВидДиаграммы(КодДиаграммы);

КонецФункции

// Вызывает КИИ_ГенераторДиаграмм.ПроверитьДоступностьKroki(URLKroki, Таймаут)
// Возвращает структуру: Доступен, Сообщение
//
&НаСервереБезКонтекста
// ПроверитьKrokiНаСервере.
Функция ПроверитьKrokiНаСервере(Знач URLKroki)

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	URLKrokiЧистый = СокрЛП(URLKroki);
	Если ПустаяСтрока(URLKrokiЧистый) Тогда
		URLKrokiЧистый = "http://localhost:8000";
	КонецЕсли;

	Если Не КИИ_МаркдаунПарсерКлиентСервер.URLИспользуетСхемуHTTP(URLKrokiЧистый) Тогда
		Возврат Новый Структура("Доступен, Сообщение", Ложь,
			НСтр("ru = 'Недопустимый URL Kroki: разрешены только http:// и https://'"));
	КонецЕсли;

	Возврат Обработка.ПроверитьДоступностьKroki(URLKrokiЧистый, 5);

КонецФункции

// Вызывает КИИ_ГенераторДиаграмм:
//   1. ОпределитьВидДиаграммы(КодДиаграммы)
//   2. РендеритьЧерезKroki(Код, Вид, ПараметрыРендеринга)
//   3. ПостроитьHTMLДляПросмотра(SVGТекст)
// Возвращает структуру: ЭтоОшибка, ТекстОшибки, ВидДиаграммы, HTML
//
&НаСервереБезКонтекста
// НарисоватьКодНаСервере.
Функция НарисоватьКодНаСервере(Знач КодДиаграммы, Знач URLKroki)

	Рез = Новый Структура("ЭтоОшибка, ТекстОшибки, ВидДиаграммы", Ложь, "", "");
	Рез.Вставить("HTML", "");

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	URLKrokiЧистый = СокрЛП(URLKroki);
	Если ПустаяСтрока(URLKrokiЧистый) Тогда
		URLKrokiЧистый = "http://localhost:8000";
	КонецЕсли;

	Рез.ВидДиаграммы = Обработка.ОпределитьВидДиаграммы(КодДиаграммы);

	ПараметрыKroki = Обработка.НовыеПараметрыРендеринга();
	ПараметрыKroki.URLKroki = URLKrokiЧистый;
	Если Не КИИ_МаркдаунПарсерКлиентСервер.URLИспользуетСхемуHTTP(URLKrokiЧистый) Тогда
		Рез.ЭтоОшибка   = Истина;
		Рез.ТекстОшибки = НСтр("ru = 'Недопустимый URL Kroki: разрешены только http:// и https://'");
		Возврат Рез;
	КонецЕсли;

	РезультатKroki = Обработка.РендеритьЧерезKroki(КодДиаграммы, Рез.ВидДиаграммы, ПараметрыKroki);

	Если РезультатKroki.Успех Тогда
		Рез.HTML = Обработка.ПостроитьHTMLДляПросмотра(РезультатKroki.SVGТекст);
	Иначе
		Рез.ЭтоОшибка   = Истина;
		Рез.ТекстОшибки = РезультатKroki.ТекстОшибки;
	КонецЕсли;

	Возврат Рез;

КонецФункции

// Вызывает КИИ_ГенераторДиаграмм.СгенерироватьДиаграмму(ОписаниеИлиКод, НастройкиОформления, Эксперт)
// Возвращает структуру: ЭтоОшибка, ТекстОшибки, КодДиаграммы, ВидДиаграммы, HTML
//
&НаСервереБезКонтекста
// СгенерироватьДиаграммуНаСервере.
Функция СгенерироватьДиаграммуНаСервере(Знач ОписаниеИлиКод, Знач URLKroki, Знач Эксперт)

	Рез = Новый Структура("ЭтоОшибка, ТекстОшибки, КодДиаграммы", Ложь, "", "");
	Рез.Вставить("ВидДиаграммы", "");
	Рез.Вставить("HTML", "");

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	URLKrokiЧистый = СокрЛП(URLKroki);
	Если ПустаяСтрока(URLKrokiЧистый) Тогда
		URLKrokiЧистый = "http://localhost:8000";
	КонецЕсли;

	Настройки = Новый Структура;
	Настройки.Вставить("URLKroki", URLKrokiЧистый);

	Если Не КИИ_МаркдаунПарсерКлиентСервер.URLИспользуетСхемуHTTP(URLKrokiЧистый) Тогда
		Рез.ЭтоОшибка   = Истина;
		Рез.ТекстОшибки = НСтр("ru = 'Недопустимый URL Kroki: разрешены только http:// и https://'");
		Возврат Рез;
	КонецЕсли;

	РезультатГен = Обработка.СгенерироватьДиаграмму(ОписаниеИлиКод, Настройки, Эксперт);

	Если РезультатГен.ЭтоОшибка Тогда
		Рез.ЭтоОшибка   = Истина;
		Рез.ТекстОшибки = РезультатГен.ТекстОшибки;
	Иначе
		Рез.КодДиаграммы = РезультатГен.КодДиаграммы;
		Рез.ВидДиаграммы = РезультатГен.ВидДиаграммы;
		Рез.HTML         = РезультатГен.HTML;
	КонецЕсли;

	Возврат Рез;

КонецФункции

#КонецОбласти

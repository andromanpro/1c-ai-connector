&НаСервере
Функция ПустойHTML()

	Перем РезультатФункции;

	ШаблонСтраницы = "<!DOCTYPE html><html><head><meta charset=""UTF-8""></head>"
		+ "<body style=""margin:0;padding:16px;color:#888;font-family:sans-serif;""><p>%1</p></body></html>";
	ТекстПодсказки = НСтр("ru = 'Введите описание диаграммы и нажмите «Построить диаграмму»'");
	РезультатФункции = СтрШаблон(ШаблонСтраницы, ТекстПодсказки);
	Возврат РезультатФункции;

КонецФункции

&НаСервере
Функция ПредыдущаяОперацияЗавершена()

	Перем ИдентификаторЗначения;

	Если ПустаяСтрока(ЗаданиеДиаграммы) Тогда
		Возврат Истина;
	КонецЕсли;
	ИдентификаторЗначения = Новый УникальныйИдентификатор(ЗаданиеДиаграммы);
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗначения);
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ПустаяСтрока(АдресРезультатаДиаграммы) Тогда
		УдалитьИзВременногоХранилища(АдресРезультатаДиаграммы);
	КонецЕсли;
	АдресРезультатаДиаграммы = "";
	ЗаданиеДиаграммы = "";
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ЗапуститьОтрисовку(ФорматФайла)

	Перем ТекстСообщения2;
	Перем ДанныеОшибки;
	Перем ПредставлениеОшибки;

	Если Не ПредыдущаяОперацияЗавершена() Тогда
		ТекстСообщения2 = НСтр("ru = 'Предыдущая операция еще выполняется. Дождитесь ее завершения.'");
		ПоказатьПредупреждение(, ТекстСообщения2);
		Возврат;
	КонецЕсли;
	Попытка
		Операция = ЗапуститьОтрисовкуНаСервере(ФорматФайла);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
		ПоказатьПредупреждение(, ПредставлениеОшибки);
		Возврат;
	КонецПопытки;
	УстановитьДоступностьКнопок(Ложь);
	СостояниеДиаграммы = НСтр("ru = 'Построение диаграммы...'");
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Ложь;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Подготовка диаграммы...'");
	Оповещение = Новый ОписаниеОповещения("ПослеОтрисовки", ЭтотОбъект, ФорматФайла);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ЗапуститьОтрисовкуНаСервере(Знач ФорматФайла)

	ПараметрыРендеринга = Новый Структура;
	ПараметрыРендеринга.Вставить("Код", Объект.КодДиаграммы);
	ПараметрыРендеринга.Вставить("Вид", Объект.ВидДиаграммы);
	ПараметрыРендеринга.Вставить("Режим", Объект.РежимГенерации);
	ПараметрыРендеринга.Вставить("Тема", Объект.ТемаДиаграммы);
	ПараметрыРендеринга.Вставить("Фон", ФонСтраницы);
	ПараметрыРендеринга.Вставить("Адрес", Объект.URLKroki);
	ПараметрыРендеринга.Вставить("Таймаут", Объект.Таймаут);
	ПараметрыРендеринга.Вставить("Формат", ФорматФайла);
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Построение диаграммы'");
	Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Обработка.КИИ_ГенераторДиаграмм.МодульОбъекта.РезультатРендеринга", ПараметрыРендеринга);
	ЗаданиеДиаграммы = Строка(Операция.ИдентификаторЗадания);
	АдресРезультатаДиаграммы = Операция.АдресРезультата;
	Возврат Операция;

КонецФункции

&НаКлиенте
Процедура ПослеОтрисовки(Результат, ФорматФайла) Экспорт

	Перем ТекстСообщения;
	Перем ТекстОшибки;
	Перем ТекстПоШаблону;

	УстановитьДоступностьКнопок(Истина);
	Если Результат = Неопределено Тогда
		СостояниеДиаграммы = НСтр(
			"ru = 'Ожидание отменено. Обращение к серверу может продолжаться. Повторная операция доступна после
				|завершения задания.'");
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		СостояниеДиаграммы = Результат.КраткоеПредставлениеОшибки;
		Возврат;
	КонецЕсли;
	АдресФайла = ПрименитьРезультатРендеринга(Результат.АдресРезультата, ФорматФайла);
	Если Не ПустаяСтрока(АдресФайла) Тогда
		Попытка
			Оповещение = Новый ОписаниеОповещения("ПослеСохраненияДиаграммы", ЭтотОбъект, АдресФайла);
			ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, АдресФайла, "diagram." + ФорматФайла);
		Исключение
			ОсвободитьВременныйФайл(АдресФайла);
			ТекстСообщения = НСтр("ru = 'Ошибка сохранения файла: %1'");
			ТекстОшибки = ОписаниеОшибки();
			ТекстПоШаблону = СтрШаблон(ТекстСообщения, ТекстОшибки);
			ПоказатьПредупреждение(, ТекстПоШаблону);
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПрименитьРезультатРендеринга(Знач АдресРезультата, Знач ФорматФайла)

	Перем РезультатФункции;

	Рендеринг = ПолучитьИзВременногоХранилища(АдресРезультата);
	УдалитьИзВременногоХранилища(АдресРезультата);
	АдресРезультатаДиаграммы = "";
	Если Не Рендеринг.Успех Тогда
		СостояниеДиаграммы = Рендеринг.ТекстОшибки;
		Возврат "";
	КонецЕсли;
	Объект.ВидДиаграммы = Рендеринг.Вид;
	Если ФорматФайла = "svg" Тогда
		Объект.ТекущийSVG = Рендеринг.SVG;
		Объект.HTMLДокумент = Рендеринг.HTML;
		СостояниеДиаграммы = НСтр("ru = 'Диаграмма готова'");
		Возврат "";
	КонецЕсли;
	СостояниеДиаграммы = НСтр("ru = 'Файл подготовлен'");
	РезультатФункции = ПоместитьВоВременноеХранилище(Рендеринг.Данные, УникальныйИдентификатор);
	Возврат РезультатФункции;

КонецФункции

&НаСервереБезКонтекста
Процедура ОсвободитьВременныйФайл(Знач АдресФайла)

	УдалитьИзВременногоХранилища(АдресФайла);

КонецПроцедуры

// Освобождает файл в хранилище после завершения или отмены диалога скачивания БСП.
//
// Параметры:
//  СохраненныеФайлы - Массив из ОписаниеПереданногоФайла, Неопределено - результат диалога БСП; здесь не используется.
//  АдресФайла - Строка - адрес файла во временном хранилище для освобождения.
//
&НаКлиенте
Процедура ПослеСохраненияДиаграммы(СохраненныеФайлы, АдресФайла) Экспорт

	Если ЗначениеЗаполнено(АдресФайла) Тогда
		ОсвободитьВременныйФайл(АдресФайла);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

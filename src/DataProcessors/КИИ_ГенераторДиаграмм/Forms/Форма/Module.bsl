#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗагрузитьНастройкиФормы();

	Если ПустаяСтрока(Объект.РежимГенерации) Тогда
		Объект.РежимГенерации = "service";
	КонецЕсли;
	Если ПустаяСтрока(Объект.URLKroki) Тогда
		Объект.URLKroki = "http://localhost:8000";
	КонецЕсли;
	Если ПустаяСтрока(Объект.ТемаДиаграммы) Тогда
		Объект.ТемаДиаграммы = "default";
	КонецЕсли;
	Если ПустаяСтрока(ФонСтраницы) Тогда
		ФонСтраницы = "white";
	КонецЕсли;
	Если ПустаяСтрока(Объект.ИсточникKroki) Тогда
		Объект.ИсточникKroki = "local_docker";
	КонецЕсли;
	Если Объект.Таймаут = 0 Тогда
		Объект.Таймаут = 30;
	КонецЕсли;

	Элементы.СоздатьЭксперта.Видимость = НЕ ЗначениеЗаполнено(Объект.Эксперт);
	УстановитьВидимостьПолейОформленияНаСервере();

	Объект.HTMLДокумент = ПустойHTML();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура HTMLДокументДокументСформирован(Элемент)
	// Обработчик события завершения загрузки HTML-документа.
	// Зарезервирован для будущего использования.
КонецПроцедуры

&НаКлиенте
Процедура URLKrokiПриИзменении(Элемент)

	СохранитьНастройкиФормыНаСервере();

	СостояниеДиаграммы = НСтр("ru = 'Настройки изменены. Нажмите «Построить диаграмму», чтобы обновить результат.'");

КонецПроцедуры

&НаКлиенте
Процедура ТемаДиаграммыПриИзменении(Элемент)

	Если Объект.ТемаДиаграммы = "dark" Тогда
		ФонСтраницы = "#1e1e1e";
	Иначе
		ФонСтраницы = "white";
	КонецЕсли;

	СостояниеДиаграммы = НСтр("ru = 'Настройки изменены. Нажмите «Построить диаграмму», чтобы обновить результат.'");

	СохранитьНастройкиФормыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ФонСтраницыПриИзменении(Элемент)

	СохранитьНастройкиФормыНаСервере();
	СостояниеДиаграммы = НСтр("ru = 'Оформление изменено. Постройте диаграмму заново.'");

КонецПроцедуры

&НаКлиенте
Процедура ЭкспертПриИзменении(Элемент)

	Элементы.СоздатьЭксперта.Видимость = НЕ ЗначениеЗаполнено(Объект.Эксперт);
	СохранитьНастройкиФормыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ИсточникKrokiПриИзменении(Элемент)
	URLПоИсточнику = Новый Соответствие;
	URLПоИсточнику.Вставить("cloud", "https://kroki.io");
	URLПоИсточнику.Вставить("local_docker", "http://localhost:8000");
	НовыйURL = URLПоИсточнику.Получить(Объект.ИсточникKroki);
	Если НовыйURL <> Неопределено Тогда
		Объект.URLKroki = НовыйURL;
	КонецЕсли;
	СохранитьНастройкиФормыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТаймаутKrokiПриИзменении(Элемент)
	СохранитьНастройкиФормыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РежимГенерацииПриИзменении(Элемент)

	УстановитьВидимостьПолейОформления();
	СохранитьНастройкиФормыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТипДиаграммыПриИзменении(Элемент)

	СохранитьНастройкиФормыНаСервере();

	СостояниеДиаграммы = НСтр("ru = 'Настройки изменены. Нажмите «Построить диаграмму», чтобы обновить результат.'");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Нарисовать(Команда)

	Если Не ПредыдущаяОперацияЗавершена() Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Предыдущая операция еще выполняется. Отмена ожидания не гарантирует остановку запроса.'"));
		Возврат;
	КонецЕсли;

	Если Элементы.СтраницыДиаграммы.ТекущаяСтраница = Элементы.КодДиаграммыСтраница Тогда
		Если ПустаяСтрока(Объект.КодДиаграммы) Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Введите код диаграммы на этой странице.'"));
			Возврат;
		КонецЕсли;
		ЗапуститьОтрисовку("svg");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Объект.ОписаниеДиаграммы) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите описание или код диаграммы'"));
		Возврат;
	КонецЕсли;

	Если ЭтоКодДиаграммыНаСервере(Объект.ОписаниеДиаграммы) Тогда
		Объект.КодДиаграммы = СокрЛП(Объект.ОписаниеДиаграммы);
		ЗапуститьОтрисовку("svg");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Эксперт) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите эксперта ИИ или создайте его кнопкой «Создать эксперта»'"));
		Возврат;
	КонецЕсли;

	УстановитьДоступностьКнопок(Ложь);
	ЗапуститьГенерациюВФоне();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьKroki(Команда)
	Результат = ПроверитьKrokiНаСервере();
	Если Результат.Доступен Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Kroki'"), , Результат.Сообщение, БиблиотекаКартинок.Информация32);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.Сообщение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьSVG(Команда)

	Если ПустаяСтрока(Объект.ТекущийSVG) Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'SVG еще не получен. В режиме сервиса сначала постройте диаграмму; в локальном режиме SVG не выгружается.'"));
		Возврат;
	КонецЕсли;

	АдресФайла = "";
	Попытка
		АдресФайла = СохранитьSVGНаСервере();
		Оповещение = Новый ОписаниеОповещения("ПослеСохраненияДиаграммы", ЭтотОбъект, АдресФайла);
		ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, АдресФайла, "diagram.svg");
	Исключение
		Если ЗначениеЗаполнено(АдресФайла) Тогда
			ОсвободитьВременныйФайл(АдресФайла);
		КонецЕсли;
		СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Ошибка сохранения SVG: %1'"), ОписаниеОшибки());
		ПоказатьПредупреждение(, СообщениеОбОшибке);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьPNG(Команда)

	Если ПустаяСтрока(Объект.КодДиаграммы) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала постройте диаграмму.'"));
		Возврат;
	КонецЕсли;
	ЗапуститьОтрисовку("png");

КонецПроцедуры

&НаКлиенте
Процедура СохранитьPDF(Команда)

	Если ПустаяСтрока(Объект.КодДиаграммы) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала постройте диаграмму.'"));
		Возврат;
	КонецЕсли;
	ЗапуститьОтрисовку("pdf");

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	Если Не ПредыдущаяОперацияЗавершена() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Дождитесь завершения операции перед очисткой.'"));
		Возврат;
	КонецЕсли;
	СостояниеДиаграммы = "";

	Объект.ОписаниеДиаграммы = "";
	Объект.КодДиаграммы         = "";
	Объект.ТекущийSVG         = "";
	Объект.ВидДиаграммы       = "";
	Объект.HTMLДокумент       = ПустойHTML();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьЭксперта(Команда)

	ТекстВопроса = НСтр("ru = 'Создать предзаполненного эксперта ИИ для генерации диаграмм?'");
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодтвержденияСозданияЭксперта", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьKrokiНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	URLKroki = СокрЛП(ОбработкаОбъект.URLKroki);
	Если ПустаяСтрока(URLKroki) Тогда
		URLKroki = "http://localhost:8000";
	КонецЕсли;
	Таймаут = ОбработкаОбъект.Таймаут;
	Если Таймаут <= 0 Тогда
		Таймаут = 5;
	КонецЕсли;
	МаксТаймаут = Мин(Таймаут, 10);
	Возврат ОбработкаОбъект.ПроверитьДоступностьKroki(URLKroki, МаксТаймаут);
КонецФункции

&НаСервере
Функция СохранитьPDFНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КодДиаграммы = СокрЛП(ОбработкаОбъект.КодДиаграммы);
	Если ПустаяСтрока(КодДиаграммы) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Нет кода диаграммы для экспорта в PDF'"));
		Возврат "";
	КонецЕсли;
	ВидДиаграммы = СокрЛП(ОбработкаОбъект.ВидДиаграммы);
	Если ПустаяСтрока(ВидДиаграммы) Тогда
		ВидДиаграммы = ОбработкаОбъект.ОпределитьВидДиаграммы(КодДиаграммы);
	КонецЕсли;
	URLKroki = СокрЛП(ОбработкаОбъект.URLKroki);
	Если ПустаяСтрока(URLKroki) Тогда
		URLKroki = "http://localhost:8000";
	КонецЕсли;
	Таймаут = ОбработкаОбъект.Таймаут;
	Если Таймаут <= 0 Тогда
		Таймаут = 30;
	КонецЕсли;
	ПараметрыKroki = ОбработкаОбъект.НовыеПараметрыРендеринга();
	ПараметрыKroki.URLKroki = URLKroki;
	ПараметрыKroki.Тема     = ОбработкаОбъект.ТемаДиаграммы;
	ПараметрыKroki.Формат   = "pdf";
	ПараметрыKroki.Таймаут  = Таймаут;
	РезультатKroki = ОбработкаОбъект.РендеритьЧерезKroki(
		КодДиаграммы, ВидДиаграммы, ПараметрыKroki);
	Если НЕ РезультатKroki.Успех Тогда
		СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Ошибка экспорта PDF: %1'"), РезультатKroki.ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибке);
		Возврат "";
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(РезультатKroki.ДвоичныеДанные, УникальныйИдентификатор);
КонецФункции

&НаКлиенте
Процедура ПослеПодтвержденияСозданияЭксперта(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СоздатьЭкспертаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗавершениеГенерации(Результат, ДополнительныеПараметры) Экспорт

	УстановитьДоступностьКнопок(Истина);

	Если Результат = Неопределено Тогда
		СостояниеДиаграммы = НСтр(
			"ru = 'Ожидание отменено. Запрос может продолжаться. Повторная операция доступна после завершения задания.'");
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		Если Результат.ИнформацияОбОшибке <> Неопределено Тогда
			ДетальОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке);
		Иначе
			ДетальОшибки = Результат.КраткоеПредставлениеОшибки;
		КонецЕсли;
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка генерации:%1%2'"), Символы.ПС, ДетальОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Выполнено" Тогда
		Если ОбработатьРезультатГенерацииНаСервере(Результат.АдресРезультата) Тогда
			ЗапуститьОтрисовку("svg");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НарисоватьНаСервере(Знач ОпределятьТип = Истина)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Если ОпределятьТип Тогда
		Объект.ВидДиаграммы = ОбработкаОбъект.ОпределитьВидДиаграммы(Объект.КодДиаграммы);
	КонецЕсли;

	Если Объект.РежимГенерации = "local" Тогда
		Объект.ТекущийSVG   = "";
		Объект.HTMLДокумент = ОбработкаОбъект.HTMLДиаграммыMermaid(
			Объект.КодДиаграммы, Объект.ТемаДиаграммы, ФонСтраницы);
		Возврат;
	КонецЕсли;

	Таймаут = Объект.Таймаут;
	Если Таймаут <= 0 Тогда
		Таймаут = 30;
	КонецЕсли;
	ПараметрыKroki = ОбработкаОбъект.НовыеПараметрыРендеринга();
	ПараметрыKroki.URLKroki = Объект.URLKroki;
	ПараметрыKroki.Тема     = Объект.ТемаДиаграммы;
	ПараметрыKroki.Таймаут  = Таймаут;
	РезультатKroki = ОбработкаОбъект.РендеритьЧерезKroki(
		Объект.КодДиаграммы, Объект.ВидДиаграммы, ПараметрыKroki);

	Если РезультатKroki.Успех Тогда
		Объект.ТекущийSVG   = РезультатKroki.SVGТекст;
		Объект.HTMLДокумент = ОбработкаОбъект.ПостроитьHTMLДляПросмотра(
			РезультатKroki.SVGТекст, ФонСтраницы);
	Иначе
		СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Ошибка рендеринга: %1'"), РезультатKroki.ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибке);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтобразитьSVGНаСервере()

	Если ПустаяСтрока(Объект.ТекущийSVG) Тогда
		Возврат;
	КонецЕсли;

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Объект.HTMLДокумент = ОбработкаОбъект.ПостроитьHTMLДляПросмотра(
		Объект.ТекущийSVG, ФонСтраницы);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьГенерациюВФоне()

	Попытка
		ФоновоеЗадание = ЗапуститьГенерациюВФонеНаСервере(Объект.ОписаниеДиаграммы, Объект.Эксперт);
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка запуска генерации:%1%2'"),
			Символы.ПС,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПоказатьПредупреждение(, ТекстОшибки);
		УстановитьДоступностьКнопок(Истина);
		Возврат;
	КонецПопытки;

	Если ФоновоеЗадание = Неопределено Тогда
		УстановитьДоступностьКнопок(Истина);
		Возврат;
	КонецЕсли;

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания       = Истина;
	ПараметрыОжидания.ТекстСообщения             = НСтр("ru = 'Генерация диаграммы через ИИ...'");
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения          = Ложь;

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьЗавершениеГенерации", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ФоновоеЗадание, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ЗапуститьГенерациюВФонеНаСервере(Знач ОписаниеДиаграммы, Знач Эксперт)

	Если НЕ ЗначениеЗаполнено(Эксперт) Тогда
		ВызватьИсключение НСтр("ru = 'Не выбран эксперт ИИ'");
	КонецЕсли;

	// Тот же путь, что у программного СгенерироватьДиаграмму: модель с инструментами строит
	// диаграмму через петлю агент-анализа, остальные - обычным запросом.
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ОписаниеДиаграммы", ОписаниеДиаграммы);
	ПараметрыЗадания.Вставить("Эксперт",           Эксперт);

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Генерация диаграммы через ИИ'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;

	Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Обработка.КИИ_ГенераторДиаграмм.МодульОбъекта.СгенерироватьКодДиаграммыФоново", ПараметрыЗадания);
	ЗаданиеДиаграммы = Строка(Операция.ИдентификаторЗадания);
	АдресРезультатаДиаграммы = Операция.АдресРезультата;
	Возврат Операция;

КонецФункции

&НаСервере
Функция ОбработатьРезультатГенерацииНаСервере(Знач АдресРезультата)

	Попытка
		РезультатГенерации = ПолучитьИзВременногоХранилища(АдресРезультата);
		УдалитьИзВременногоХранилища(АдресРезультата);
		АдресРезультатаДиаграммы = "";
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'ИИКона.ГенераторДиаграмм'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не удалось получить результат генерации'"));
		Возврат Ложь;
	КонецПопытки;

	// Подстановки персональных данных фоновое задание уже вернуло к исходным значениям:
	// код диаграммы и текст ошибки читает человек.
	Если РезультатГенерации.ЭтоОшибка Тогда
		СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Ошибка генерации: %1'"), РезультатГенерации.ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибке);
		Возврат Ложь;
	КонецЕсли;

	Объект.КодДиаграммы = РезультатГенерации.КодДиаграммы;
	Возврат Истина;

КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкиФормы()

	КлючОбъекта = "Обработка.КИИ_ГенераторДиаграмм";

	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		КлючОбъекта, "НастройкиФормы");

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если Настройки.Свойство("РежимГенерации") И НЕ ПустаяСтрока(Настройки.РежимГенерации) Тогда
		Объект.РежимГенерации = Настройки.РежимГенерации;
	КонецЕсли;

	Если Настройки.Свойство("ПоследнийЭксперт") И ЗначениеЗаполнено(Настройки.ПоследнийЭксперт) Тогда
		Объект.Эксперт = Настройки.ПоследнийЭксперт;
	КонецЕсли;

	Если Настройки.Свойство("URLKroki") И НЕ ПустаяСтрока(Настройки.URLKroki) Тогда
		Объект.URLKroki = Настройки.URLKroki;
	КонецЕсли;

	Если Настройки.Свойство("ТемаДиаграммы") И НЕ ПустаяСтрока(Настройки.ТемаДиаграммы) Тогда
		Объект.ТемаДиаграммы = Настройки.ТемаДиаграммы;
	КонецЕсли;

	Если Настройки.Свойство("ФонСтраницы") И НЕ ПустаяСтрока(Настройки.ФонСтраницы) Тогда
		ФонСтраницы = Настройки.ФонСтраницы;
	КонецЕсли;

	Если Настройки.Свойство("Таймаут") И Настройки.Таймаут > 0 Тогда
		Объект.Таймаут = Настройки.Таймаут;
	КонецЕсли;

	Если Настройки.Свойство("ИсточникKroki") И НЕ ПустаяСтрока(Настройки.ИсточникKroki) Тогда
		Объект.ИсточникKroki = Настройки.ИсточникKroki;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиФормыНаСервере()

	КлючОбъекта = "Обработка.КИИ_ГенераторДиаграмм";

	Настройки = Новый Структура;
	Настройки.Вставить("РежимГенерации",   Объект.РежимГенерации);
	Настройки.Вставить("ПоследнийЭксперт", Объект.Эксперт);
	Настройки.Вставить("URLKroki",         Объект.URLKroki);
	Настройки.Вставить("ТемаДиаграммы",    Объект.ТемаДиаграммы);
	Настройки.Вставить("ФонСтраницы",      ФонСтраницы);
	Настройки.Вставить("Таймаут",     Объект.Таймаут);
	Настройки.Вставить("ИсточникKroki",    Объект.ИсточникKroki);

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		КлючОбъекта, "НастройкиФормы", Настройки);

КонецПроцедуры


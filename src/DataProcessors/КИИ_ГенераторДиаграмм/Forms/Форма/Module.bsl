#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗагрузитьНастройкиФормы();

	Если ПустаяСтрока(Объект.РежимГенерации) Тогда
		Объект.РежимГенерации = "service";
	КонецЕсли;
	Если ПустаяСтрока(Объект.URLKroki) Тогда
		Объект.URLKroki = "http://localhost:8000";
	КонецЕсли;
	Если ПустаяСтрока(Объект.ТемаДиаграммы) Тогда
		Объект.ТемаДиаграммы = "default";
	КонецЕсли;
	Если ПустаяСтрока(ФонСтраницы) Тогда
		ФонСтраницы = "white";
	КонецЕсли;
	Если ПустаяСтрока(Объект.ИсточникKroki) Тогда
		Объект.ИсточникKroki = "local_docker";
	КонецЕсли;
	Если Объект.Таймаут = 0 Тогда
		Объект.Таймаут = 30;
	КонецЕсли;

	Элементы.СоздатьЭксперта.Видимость = НЕ ЗначениеЗаполнено(Объект.Эксперт);
	УстановитьВидимостьПолейОформленияНаСервере();

	Объект.HTMLДокумент = ПустойHTML();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура HTMLДокументДокументСформирован(Элемент)
	// Обработчик события завершения загрузки HTML-документа.
	// Зарезервирован для будущего использования.
КонецПроцедуры

&НаКлиенте
Процедура URLKrokiПриИзменении(Элемент)

	СохранитьНастройкиФормыНаСервере();

	СостояниеДиаграммы = НСтр("ru = 'Настройки изменены. Нажмите «Построить диаграмму», чтобы обновить результат.'");

КонецПроцедуры

&НаКлиенте
Процедура ТемаДиаграммыПриИзменении(Элемент)

	Если Объект.ТемаДиаграммы = "dark" Тогда
		ФонСтраницы = "#1e1e1e";
	Иначе
		ФонСтраницы = "white";
	КонецЕсли;

	СостояниеДиаграммы = НСтр("ru = 'Настройки изменены. Нажмите «Построить диаграмму», чтобы обновить результат.'");

	СохранитьНастройкиФормыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ФонСтраницыПриИзменении(Элемент)

	СохранитьНастройкиФормыНаСервере();
	СостояниеДиаграммы = НСтр("ru = 'Оформление изменено. Постройте диаграмму заново.'");

КонецПроцедуры

&НаКлиенте
Процедура ЭкспертПриИзменении(Элемент)

	Элементы.СоздатьЭксперта.Видимость = НЕ ЗначениеЗаполнено(Объект.Эксперт);
	СохранитьНастройкиФормыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ИсточникKrokiПриИзменении(Элемент)
	URLПоИсточнику = Новый Соответствие;
	URLПоИсточнику.Вставить("cloud", "https://kroki.io");
	URLПоИсточнику.Вставить("local_docker", "http://localhost:8000");
	НовыйURL = URLПоИсточнику.Получить(Объект.ИсточникKroki);
	Если НовыйURL <> Неопределено Тогда
		Объект.URLKroki = НовыйURL;
	КонецЕсли;
	СохранитьНастройкиФормыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТаймаутKrokiПриИзменении(Элемент)
	СохранитьНастройкиФормыНаСервере();
КонецПроцедуры


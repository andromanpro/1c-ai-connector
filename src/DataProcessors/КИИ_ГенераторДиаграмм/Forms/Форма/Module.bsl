Функция СохранитьSVGНаСервере()

	Данные = ПолучитьДвоичныеДанныеИзСтроки(Объект.ТекущийSVG, КодировкаТекста.UTF8);
	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Функция СохранитьPNGНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	КодДиаграммы = СокрЛП(ОбработкаОбъект.КодДиаграммы);
	Если ПустаяСтрока(КодДиаграммы) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Нет кода диаграммы для экспорта в PNG'"));
		Возврат "";
	КонецЕсли;

	ВидДиаграммы = СокрЛП(ОбработкаОбъект.ВидДиаграммы);
	Если ПустаяСтрока(ВидДиаграммы) Тогда
		ВидДиаграммы = ОбработкаОбъект.ОпределитьВидДиаграммы(КодДиаграммы);
	КонецЕсли;

	URLKroki = СокрЛП(ОбработкаОбъект.URLKroki);
	Если ПустаяСтрока(URLKroki) Тогда
		URLKroki = "http://localhost:8000";
	КонецЕсли;

	Таймаут = ОбработкаОбъект.Таймаут;
	Если Таймаут <= 0 Тогда
		Таймаут = 30;
	КонецЕсли;

	ПараметрыKroki = ОбработкаОбъект.НовыеПараметрыРендеринга();
	ПараметрыKroki.URLKroki = URLKroki;
	ПараметрыKroki.Тема     = ОбработкаОбъект.ТемаДиаграммы;
	ПараметрыKroki.Формат   = "png";
	ПараметрыKroki.Таймаут  = Таймаут;
	РезультатKroki = ОбработкаОбъект.РендеритьЧерезKroki(
		КодДиаграммы, ВидДиаграммы, ПараметрыKroki);

	Если НЕ РезультатKroki.Успех Тогда
		СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Ошибка экспорта PNG: %1'"), РезультатKroki.ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибке);
		Возврат "";
	КонецЕсли;

	Возврат ПоместитьВоВременноеХранилище(РезультатKroki.ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура СоздатьЭкспертаНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.СоздатьПредзаполненногоЭксперта();

	Если Результат.Успех Тогда
		Объект.Эксперт = Результат.Эксперт;
		СохранитьНастройкиФормыНаСервере();
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Эксперт успешно создан. Укажите модель ИИ в карточке эксперта.'"));
	Иначе
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка создания эксперта:%1%2'"),
			Символы.ПС, Результат.ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;

КонецПроцедуры


#Область ПрограммныйИнтерфейс

// Возвращает сведения о внешней обработке для регистрации в подсистеме БСП.
//
// Возвращаемое значение:
//   Структура - сведения о внешней обработке:
//     * Вид             - Строка
//     * Наименование    - Строка
//     * Версия          - Строка
//     * БезопасныйРежим - Булево
//     * Информация      - Строка
//     * Команды         - ТаблицаЗначений
//
Функция СведенияОВнешнейОбработке() Экспорт

	Перем ТекстСообщения;

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ТекстСообщения = НСтр("ru = 'Генератор диаграмм'");
	ПараметрыРегистрации.Вставить("Наименование", ТекстСообщения);
	ПараметрыРегистрации.Вставить("Версия", "2.0.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ТекстСообщения = НСтр("ru = 'Генератор диаграмм (Mermaid, PlantUML, GraphViz и др.) с помощью ИИ
			|или по готовому коду. Рендеринг через kroki.'");
	ПараметрыРегистрации.Вставить("Информация", ТекстСообщения);

	Команды = НоваяТаблицаКоманд();
	ТекстСообщения = НСтр("ru = 'Генератор диаграмм'");
	ДобавитьКоманду(Команды, ТекстСообщения, "ОткрытьФорму", "ОткрытиеФормы", Истина);
	ПараметрыРегистрации.Вставить("Команды", Команды);

	Возврат ПараметрыРегистрации;

КонецФункции

// Проверяет доступность подсистемы ИИкона (наличие модуля КИИ_КоннекторИИ).
//
// Возвращаемое значение:
//   Булево - Истина, если подсистема доступна
//
Функция ПроверитьНаличиеИИконы() Экспорт

	Если Метаданные.ОбщиеМодули.Найти("КИИ_КоннекторИИ") <> Неопределено Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Определяет вид диаграммы по первым строкам кода.
// Поддерживаемые виды: mermaid, plantuml, graphviz, bpmn.
// При неопределенном виде возвращает "mermaid" (по умолчанию).
//
// Параметры:
//   КодДиаграммы - Строка - код диаграммы
//
// Возвращаемое значение:
//   Строка - "mermaid" | "plantuml" | "graphviz" | "bpmn"
//
Функция ОпределитьВидДиаграммы(КодДиаграммы) Экспорт

	Перем ЗначениеБезПробелов;

	ЗначениеБезПробелов = СокрЛП(КодДиаграммы);
	Текст = НРег(ЗначениеБезПробелов);

	// PlantUML
	Если СтрНачинаетсяС(Текст, "@startuml") Тогда
		Возврат "plantuml";
	КонецЕсли;

	// GraphViz (DOT): digraph или graph с фигурной скобкой
	// "graph TD" - это Mermaid, "graph {" - это GraphViz
	ЭтоGraphViz = НачинаетсяСодним(Текст, "digraph", "strict digraph", "strict graph", "graph {", "graph{");
	Если ЭтоGraphViz Тогда
		Возврат "graphviz";
	КонецЕсли;

	// BPMN (XML-формат)
	Если СтрНайти(Текст, "<definitions") > 0 Или СтрНайти(Текст, "<bpmn:definitions") > 0 Тогда
		Возврат "bpmn";
	КонецЕсли;

	// Mermaid - проверяем ключевые слова
	МаркерыMermaid = "graph td,graph lr,graph tb,graph bt,graph rl,"
		+ "flowchart td,flowchart lr,flowchart tb,flowchart bt,flowchart rl,"
		+ "sequencediagram,classdiagram,statediagram,erdiagram,"
		+ "gantt,pie,journey,gitgraph,mindmap,timeline,%%{init";
	МассивМаркеров = СтрРазделить(МаркерыMermaid, ",");
	Для Каждого Маркер Из МассивМаркеров Цикл
		Если СтрНачинаетсяС(Текст, Маркер) Тогда
			Возврат "mermaid";
		КонецЕсли;
	КонецЦикла;

	Возврат "mermaid"; // По умолчанию

КонецФункции

// Создает структуру параметров рендеринга со значениями по умолчанию.
//
// Возвращаемое значение:
//   Структура - параметры рендеринга:
//     * URLKroki - Строка - базовый URL kroki (умолч. "http://localhost:8000")
//     * Тема     - Строка - тема оформления (для mermaid: "default"/"dark"/"forest"/"neutral")
//     * Формат   - Строка - формат вывода: "svg" | "png" | "pdf" (умолч. "svg")
//     * Таймаут  - Число  - таймаут соединения в секундах (умолч. 30)
//
Функция НовыеПараметрыРендеринга() Экспорт

	Перем АдресСервераKrokiЗначение;

	Параметры = Новый Структура;
	// Адрес сервера рендеринга: из константы (напр. NAS), пусто - локальный дефолт.
	АдресСервераKrokiЗначение = Константы.КИИ_АдресСервераKroki.Получить();
	АдресКонстанты = СокрЛП(АдресСервераKrokiЗначение);
	Если ПустаяСтрока(АдресКонстанты) Тогда
		АдресКонстанты = "http://localhost:8000";
	КонецЕсли;
	Параметры.Вставить("URLKroki", АдресКонстанты);
	Параметры.Вставить("Тема", "default");
	Параметры.Вставить("Формат", "svg");
	Параметры.Вставить("Таймаут", 30);

	Возврат Параметры;

КонецФункции

// Рендерит диаграмму через kroki и возвращает результат.
// Использует plain text POST API kroki для передачи исходного кода диаграммы.
//
// Параметры:
//   КодДиаграммы        - Строка - исходный код диаграммы
//   ВидДиаграммы        - Строка - "mermaid" | "plantuml" | "graphviz" | ...
//   ПараметрыРендеринга - Структура, Неопределено - параметры из НовыеПараметрыРендеринга():
//     * URLKroki - Строка - базовый URL kroki
//     * Тема     - Строка - тема оформления
//     * Формат   - Строка - формат вывода: "svg" | "png" | "pdf"
//     * Таймаут  - Число  - таймаут соединения в секундах
//
// Возвращаемое значение:
//   Структура:
//     * Успех          - Булево
//     * SVGТекст       - Строка - SVG-текст (только для Формат = "svg")
//     * ДвоичныеДанные - ДвоичныеДанные, Неопределено - для Формат = "png" или "pdf"
//     * Формат         - Строка - формат вывода: "svg" | "png" | "pdf"
//     * ТекстОшибки    - Строка
//
Функция РендеритьЧерезKroki(КодДиаграммы, ВидДиаграммы, ПараметрыРендеринга = Неопределено) Экспорт

	Перем ЗначениеВНижнемРегистре;
	Перем РезультатКаналРендерДиаграмм;
	Перем ТекстСообщения;
	Перем ДанныеОшибки;
	Перем ПодробностиОшибки;
	Перем КодЯзыка;

	НастройкиKroki = НовыеПараметрыРендеринга();
	ОбъединитьПараметрыРендеринга(НастройкиKroki, ПараметрыРендеринга);

	Результат = Новый Структура("Успех, SVGТекст, ДвоичныеДанные", Ложь, "", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	ЗначениеВНижнемРегистре = НРег(НастройкиKroki.Формат);
	Результат.Вставить("Формат", ЗначениеВНижнемРегистре);

	// Подготавливаем код (для mermaid добавляет директиву темы)
	КодЧистый = ПодготовитьКодДляKroki(КодДиаграммы, ВидДиаграммы, НастройкиKroki.Тема);
	ИмяТипа = ИмяТипаДляKroki(ВидДиаграммы);

	// Код уходит на сервер рендера, а подписи узлов бывают с именами и реквизитами контрагентов.
	РезультатКаналРендерДиаграмм = КИИ_КонтрольПерсональныхДанных.КаналРендерДиаграмм();
	Контроль = КИИ_КонтрольПерсональныхДанных.ПодготовитьТекстКанала(РезультатКаналРендерДиаграмм, КодЧистый);
	Если Не Контроль.Разрешено Тогда
		Результат.ТекстОшибки = Контроль.ТекстОтказа;
		Возврат Результат;
	КонецЕсли;
	КодЧистый = Контроль.Текст;

	ПараметрыURL = РазобратьURL(НастройкиKroki.URLKroki);

	// Endpoint: POST /{type}/{format} с plain text телом - корректно передает UTF-8
	ПутьЗапроса = "/" + ИмяТипа + "/" + НРег(НастройкиKroki.Формат);

	Попытка
		Соединение = СоздатьСоединениеKroki(ПараметрыURL, НастройкиKroki.Таймаут);
		Запрос = СоздатьЗапросKroki(ПутьЗапроса, КодЧистый, НастройкиKroki.Формат);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		ЗаполнитьРезультатОтветаKroki(Ответ, НастройкиKroki.Формат, Результат);
		// В SVG подписи - текст, и человек видит исходные значения. В PNG и PDF остаются подстановки.
		Если Результат.Успех И Результат.Формат = "svg" Тогда
			Результат.SVGТекст = КИИ_КонтрольПерсональныхДанных.ВосстановитьДляЧеловека(
				Результат.SVGТекст, Контроль.Контекст).Текст;
		КонецЕсли;
	Исключение
		ТекстСообщения = НСтр("ru = 'Ошибка соединения с kroki: %1'");
		ДанныеОшибки = ИнформацияОбОшибке();
		ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		ТекстОшибки = СтрШаблон(ТекстСообщения, ПодробностиОшибки);
		Результат.ТекстОшибки = ТекстОшибки;
		КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ТекстСообщения = НСтр("ru = 'ИИКона.ГенераторДиаграмм'", КодЯзыка);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Строит HTML-страницу для отображения SVG через HTMLДокументПоле.
// SVG встраивается через data URI (base64), что исключает проблемы с CORS.
//
// Параметры:
//   SVGТекст    - Строка - SVG-текст, полученный от kroki
//   ФонСтраницы - Строка - CSS-цвет фона (умолч. "white")
//
// Возвращаемое значение:
//   Строка - HTML-документ
//
Функция ПостроитьHTMLДляПросмотра(SVGТекст, ФонСтраницы = "white") Экспорт

	Перем СимволТекста;

	SVGДанные = ПолучитьДвоичныеДанныеИзСтроки(SVGТекст, КодировкаТекста.UTF8);
	SVGBase64 = Base64Строка(SVGДанные);
	// Убираем переносы строк из base64 (платформа добавляет их каждые 76 символов)
	SVGBase64 = СтрЗаменить(SVGBase64, Символы.ПС, "");
	СимволТекста = Символ(13);
	SVGBase64 = СтрЗаменить(SVGBase64, СимволТекста, "");

	HTML = "<!DOCTYPE html>"
		+ "<html><head><meta charset=""UTF-8""><style>"
		+ "body{margin:0;padding:8px;background:"
		+ ФонСтраницы
		+ ";display:flex;justify-content:center;align-items:flex-start;}"
		+ "img{max-width:100%;height:auto;}"
		+ "</style></head><body>"
		+ "<img src=""data:image/svg+xml;base64,"
		+ SVGBase64
		+ """ alt=""diagram"">"
		+ "</body></html>";

	Возврат HTML;

КонецФункции

// Строит HTML-страницу для отображения бинарного результата рендеринга (png/pdf)
// через data URI. PNG встраивается тегом img, PDF - тегом embed (best-effort).
//
// Параметры:
//   ДвоичныеДанные - ДвоичныеДанные, Неопределено - бинарный результат рендеринга kroki
//   Формат         - Строка - "png" | "pdf"
//   ФонСтраницы    - Строка - CSS-цвет фона (умолч. "white")
//
// Возвращаемое значение:
//   Строка - HTML-документ
//
Функция ПостроитьHTMLДляПросмотраБинарного(Знач ДвоичныеДанные, Знач Формат, ФонСтраницы = "white") Экспорт

	Перем РезультатФункции;
	Перем СимволТекста;

	Заголовок = "<!DOCTYPE html>"
		+ "<html><head><meta charset=""UTF-8""><style>"
		+ "body{margin:0;padding:8px;background:"
		+ ФонСтраницы
		+ ";display:flex;justify-content:center;align-items:flex-start;}"
		+ "img{max-width:100%;height:auto;}embed{width:100%;height:95vh;}"
		+ "</style></head><body>";
	Подвал = "</body></html>";

	Если ДвоичныеДанные = Неопределено Тогда
		РезультатФункции = Заголовок + Подвал;
		Возврат РезультатФункции;
	КонецЕсли;

	Base64 = Base64Строка(ДвоичныеДанные);
	Base64 = СтрЗаменить(Base64, Символы.ПС, "");
	СимволТекста = Символ(13);
	Base64 = СтрЗаменить(Base64, СимволТекста, "");

	Если НРег(Формат) = "pdf" Тогда
		Встраивание = "<embed src=""data:application/pdf;base64," + Base64 + """ type=""application/pdf"">";
	Иначе
		Встраивание = "<img src=""data:image/png;base64," + Base64 + """ alt=""diagram"">";
	КонецЕсли;

	РезультатФункции = Заголовок + Встраивание + Подвал;
	Возврат РезультатФункции;

КонецФункции

// Универсальная точка входа для внешних вызовов.
// Принимает текстовое описание (→ ИИ) или готовый код диаграммы любого типа.
// Рендерит через kroki, возвращает SVG + HTML.
//
// Параметры:
//   ОписаниеИлиКод      - Строка    - описание или готовый код
//   НастройкиОформления - Структура - необязательно:
//     * URLKroki    - Строка - URL kroki (умолч. "http://localhost:8000")
//     * Тема        - Строка - тема Mermaid (умолч. "default")
//     * ФонСтраницы - Строка - фон (умолч. "white")
//     * Таймаут     - Число  - таймаут HTTP запроса в секундах (умолч. 30)
//   Эксперт             - СправочникСсылка.КИИ_ЭкспертыИИ - нужен при генерации по описанию
//
// Возвращаемое значение:
//   Структура:
//     * КодДиаграммы - Строка
//     * ВидДиаграммы - Строка
//     * SVGТекст     - Строка
//     * HTML         - Строка
//     * ЭтоОшибка   - Булево
//     * ТекстОшибки  - Строка
//
Функция СгенерироватьДиаграмму(ОписаниеИлиКод, НастройкиОформления = Неопределено, Эксперт = Неопределено) Экспорт

	Результат = НовыйРезультатГенерации();
	Оформление = РазобратьНастройкиОформления(НастройкиОформления);

	Если Не ЗаполнитьКодДиаграммыВРезультате(Результат, ОписаниеИлиКод, Эксперт) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ВидДиаграммы = ОпределитьВидДиаграммы(Результат.КодДиаграммы);

	ПараметрыKroki = НовыеПараметрыРендеринга();
	ПараметрыKroki.URLKroki = Оформление.URLKroki;
	ПараметрыKroki.Тема     = Оформление.Тема;
	ПараметрыKroki.Таймаут  = Оформление.Таймаут;
	РезультатKroki = РендеритьЧерезKroki(Результат.КодДиаграммы, Результат.ВидДиаграммы, ПараметрыKroki);

	ПрименитьРезультатРендеринга(Результат, РезультатKroki, Оформление);

	Возврат Результат;

КонецФункции

// Точка входа для фонового задания генерации кода диаграммы через ИИ.
// Вызывается через ДлительныеОперации.ВыполнитьФункцию по имени:
//   "Обработки.КИИ_ГенераторДиаграмм.МодульОбъекта.СгенерироватьКодДиаграммыФоново"
//
// Параметры:
//   ПараметрыЗадания - Структура:
//     * ОписаниеДиаграммы - Строка
//     * Эксперт           - СправочникСсылка.КИИ_ЭкспертыИИ
//
// Возвращаемое значение:
//   Структура:
//     * КодДиаграммы - Строка
//     * ВидДиаграммы - Строка
//     * SVGТекст     - Строка
//     * HTML         - Строка
//     * ЭтоОшибка   - Булево
//     * ТекстОшибки  - Строка
//
Функция СгенерироватьКодДиаграммыФоново(ПараметрыЗадания) Экспорт

	Перем РезультатФункции;

	РезультатФункции = СгенерироватьКодДиаграммы(ПараметрыЗадания.ОписаниеДиаграммы, ПараметрыЗадания.Эксперт);
	Возврат РезультатФункции;

КонецФункции

// Загружает настройки обработки из хранилища (Эксперт, URLKroki, ТемаДиаграммы).
//
Процедура ЗагрузитьНастройки() Экспорт

	КлючОбъекта = "Обработка.КИИ_ГенераторДиаграмм";

	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		КлючОбъекта, "НастройкиФормы");

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если Настройки.Свойство("ПоследнийЭксперт") И ЗначениеЗаполнено(Настройки.ПоследнийЭксперт) Тогда
		Эксперт = Настройки.ПоследнийЭксперт;
	КонецЕсли;

	Если Настройки.Свойство("URLKroki") И НЕ ПустаяСтрока(Настройки.URLKroki) Тогда
		URLKroki = Настройки.URLKroki;
	КонецЕсли;

	Если Настройки.Свойство("ТемаДиаграммы") И НЕ ПустаяСтрока(Настройки.ТемаДиаграммы) Тогда
		ТемаДиаграммы = Настройки.ТемаДиаграммы;
	КонецЕсли;

	Если Настройки.Свойство("Таймаут") И НЕ Настройки.Таймаут = 0 Тогда
		Таймаут = Настройки.Таймаут;
	КонецЕсли;

	Если Настройки.Свойство("ИсточникKroki") И НЕ ПустаяСтрока(Настройки.ИсточникKroki) Тогда
		ИсточникKroki = Настройки.ИсточникKroki;
	КонецЕсли;

КонецПроцедуры

// Сохраняет настройки обработки в хранилище (Эксперт, URLKroki, ТемаДиаграммы).
//
Процедура СохранитьНастройки() Экспорт

	КлючОбъекта = "Обработка.КИИ_ГенераторДиаграмм";

	Настройки = Новый Структура;
	Настройки.Вставить("ПоследнийЭксперт", Эксперт);
	Настройки.Вставить("URLKroki",         URLKroki);
	Настройки.Вставить("ТемаДиаграммы",    ТемаДиаграммы);
	Настройки.Вставить("Таймаут",     Таймаут);
	Настройки.Вставить("ИсточникKroki",    ИсточникKroki);

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		КлючОбъекта, "НастройкиФормы", Настройки);

КонецПроцедуры

// Создает предзаполненного эксперта ИИ для генерации диаграмм.
//
// Возвращаемое значение:
//   Структура:
//     * Успех       - Булево
//     * Эксперт     - СправочникСсылка.КИИ_ЭкспертыИИ
//     * ТекстОшибки - Строка
//
Функция СоздатьПредзаполненногоЭксперта() Экспорт

	Перем РезультатПустаяСсылка;

	Перем ДанныеОшибки;
	Перем КодЯзыка;
	Перем ТекстСообщения;

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	РезультатПустаяСсылка = Справочники.КИИ_ЭкспертыИИ.ПустаяСсылка();
	Результат.Вставить("Эксперт", РезультатПустаяСсылка);
	Результат.Вставить("ТекстОшибки", "");

	Попытка

		МакетПромпта = ПолучитьМакет("ПромптДиаграммы");
		ТекстПромпта = МакетПромпта.ПолучитьТекст();

		НовыйЭксперт = Справочники.КИИ_ЭкспертыИИ.СоздатьЭлемент();
		НовыйЭксперт.Наименование = НСтр("ru = 'Генератор диаграмм'");
		НовыйЭксперт.ОписаниеЭксперта = ТекстПромпта;
		НовыйЭксперт.Записать();

		Результат.Успех = Истина;
		Результат.Эксперт = НовыйЭксперт.Ссылка;

	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		Результат.ТекстОшибки = ТекстОшибки;
		КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ТекстСообщения = НСтр("ru = 'ИИКона.ГенераторДиаграмм'", КодЯзыка);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Строит диаграмму или файл по снимку настроек без обращения к форме.
// Параметры:
//  Параметры - Структура - Код, Вид, Режим, Тема, Фон, Адрес, Таймаут, Формат.
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - построение выполнено.
//   * ТекстОшибки - Строка - причина отказа.
//   * SVG - Строка - результат сервисного построения SVG.
//   * HTML - Строка - документ для просмотра.
//   * Данные - ДвоичныеДанные, Неопределено - файл PNG/PDF.
//   * Вид - Строка - язык диаграммы.
Функция РезультатРендеринга(Параметры) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("SVG", "");
	Результат.Вставить("HTML", "");
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("Вид", "");
	Результат.Вид = ОпределитьВидДиаграммы(Параметры.Код);
	Если Параметры.Режим = "local" И Параметры.Формат = "svg" Тогда
		Результат.HTML = HTMLДиаграммыMermaid(Параметры.Код, Параметры.Тема, Параметры.Фон);
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;
	Настройки = НовыеПараметрыРендеринга();
	Настройки.URLKroki = Параметры.Адрес;
	Настройки.Тема = Параметры.Тема;
	Настройки.Формат = Параметры.Формат;
	Настройки.Таймаут = ?(Параметры.Таймаут > 0, Параметры.Таймаут, 30);
	Рендеринг = РендеритьЧерезKroki(Параметры.Код, Результат.Вид, Настройки);
	Результат.Успех = Рендеринг.Успех;
	Результат.ТекстОшибки = Рендеринг.ТекстОшибки;
	Если Рендеринг.Успех Тогда
		Если Параметры.Формат = "svg" Тогда
			Результат.SVG = Рендеринг.SVGТекст;
			Результат.HTML = ПостроитьHTMLДляПросмотра(Результат.SVG, Параметры.Фон);
		Иначе
			Результат.Данные = Рендеринг.ДвоичныеДанные;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции


КонецФункции
// Подготавливает код диаграммы перед отправкой в kroki.
// Для Mermaid с не-default темой добавляет директиву %%{init}%% перед кодом.
//
// Параметры:
//   КодДиаграммы - Строка - исходный код диаграммы
//   ВидДиаграммы - Строка - вид диаграммы (mermaid, plantuml и т.д.)
//   Тема         - Строка - тема оформления (умолч. "default")
//
// Возвращаемое значение:
//   Строка - подготовленный код диаграммы
//
Функция ПодготовитьКодДляKroki(КодДиаграммы, ВидДиаграммы, Тема = "default") Экспорт

	Код = СокрЛП(КодДиаграммы);

	ЭтоMermaidСТемой = НРег(ВидДиаграммы) = "mermaid"
		И НЕ ПустаяСтрока(Тема)
		И Тема <> "default"
		И НЕ СтрНачинаетсяС(Код, "%%");
	Если ЭтоMermaidСТемой Тогда
		ДирективаТемы = "%%" + "{init: {'theme': '" + Тема + "'}}" + "%%";
		Код = ДирективаТемы + Символы.ПС + Код;
	КонецЕсли;

	Возврат Код;

КонецФункции
// Проверяет, является ли текст готовым кодом диаграммы любого поддерживаемого типа.
//
// Параметры:
//   Текст - Строка - текст для анализа
//
// Возвращаемое значение:
//   Булево - Истина, если текст является кодом поддерживаемого типа диаграммы
//
Функция ЭтоГотовыйКодДиаграммы(Текст) Экспорт

	Перем ЗначениеБезПробелов;

	ЗначениеБезПробелов = СокрЛП(Текст);
	ТекстНорм = НРег(ЗначениеБезПробелов);

	Если СтрНачинаетсяС(ТекстНорм, "@startuml") Тогда
		Возврат Истина;
	КонецЕсли;

	ЭтоGraphViz = НачинаетсяСодним(ТекстНорм, "digraph", "strict digraph", "strict graph", "graph {", "graph{");
	Если ЭтоGraphViz Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрНайти(ТекстНорм, "<definitions") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	МаркерыMermaid = "graph td,graph lr,graph tb,graph bt,graph rl,"
		+ "flowchart td,flowchart lr,flowchart tb,flowchart bt,flowchart rl,"
		+ "sequencediagram,classdiagram,statediagram,erdiagram,"
		+ "gantt,pie,journey,gitgraph,mindmap,timeline,%%{init";
	МассивМаркеров = СтрРазделить(МаркерыMermaid, ",");
	Для Каждого Маркер Из МассивМаркеров Цикл
		Если СтрНачинаетсяС(ТекстНорм, Маркер) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

// Структура объектов конфигурации, упомянутых в описании диаграммы: измерения, ресурсы, реквизиты и
// табличные части. Блок подставляется в промпт, чтобы модель рисовала настоящие поля, а не выдуманные.
//
// Параметры:
//  ОписаниеДиаграммы - Строка - текст запроса пользователя.
//
// Возвращаемое значение:
//  Строка - блок со структурой найденных объектов; пустая строка, если объекты не упомянуты.
//
Функция СтруктураУпомянутыхОбъектов(Знач ОписаниеДиаграммы) Экспорт

	Перем РезультатФункции;

	ПолныеИмена = ПолныеИменаОбъектовИзТекста(ОписаниеДиаграммы);
	Если ПолныеИмена.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поля = ПоляОбъектаМетаданных(ОбъектМетаданных);
		Строки.Добавить(ПолноеИмя + ": " + Поля);
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	РезультатФункции = НСтр("ru = 'Структура объектов этой конфигурации, используй только эти имена полей:'")
		+ Символы.ПС
		+ СтрСоединить(Строки, Символы.ПС);
	Возврат РезультатФункции;

КонецФункции

// Полные имена объектов конфигурации, упомянутые в тексте: «РегистрСведений.Имя», «Справочник.Имя» и подобные.
//
// Параметры:
//  Текст - Строка - текст запроса пользователя.
//
// Возвращаемое значение:
//  Массив из Строка - полные имена без повторов.
//
Функция ПолныеИменаОбъектовИзТекста(Знач Текст)

	Перем ТекстПослеЗамены;
	Перем ТекстПослеЗамены2;
	Перем ДлинаТекста;

	ВидыОбъектов = СтрРазделить(
		"Справочник,Документ,РегистрСведений,РегистрНакопления,РегистрБухгалтерии,"
			+ "РегистрРасчета,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета,Перечисление,БизнесПроцесс,Задача,"
			+ "Обработка,Отчет,ПланОбмена,Константа",
		",",
		Ложь);

	Найденные = Новый Массив;
	ТекстПослеЗамены = СтрЗаменить(Текст, ",", " ");
	ТекстПослеЗамены2 = СтрЗаменить(ТекстПослеЗамены, ";", " ");
	Лексемы = СтрРазделить(ТекстПослеЗамены2, " ", Ложь);
	Для Каждого Лексема Из Лексемы Цикл
		ТекстПослеЗамены = СтрЗаменить(Лексема, ".", ".");
		ТекстПослеЗамены2 = СтрЗаменить(ТекстПослеЗамены, Символы.ПС, "");
		Очищенная = СокрЛП(ТекстПослеЗамены2);
		Пока СтрЗаканчиваетсяНа(Очищенная, ".") Или СтрЗаканчиваетсяНа(Очищенная, ":") Цикл
			ДлинаТекста = СтрДлина(Очищенная);
			Очищенная = Лев(Очищенная, ДлинаТекста - 1);
		КонецЦикла;
		Части = СтрРазделить(Очищенная, ".", Ложь);
		Если Части.Количество() <> 2 Тогда
			Продолжить;
		КонецЕсли;
		Если ВидыОбъектов.Найти(Части[0]) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Найденные.Найти(Очищенная) = Неопределено Тогда
			Найденные.Добавить(Очищенная);
		КонецЕсли;
	КонецЦикла;

	Возврат Найденные;

КонецФункции

// Поля объекта метаданных одной строкой: измерения, ресурсы, реквизиты и табличные части.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - найденный объект конфигурации.
//
// Возвращаемое значение:
//  Строка - перечисление полей.
//
Функция ПоляОбъектаМетаданных(Знач ОбъектМетаданных)

	Перем ТекстСообщения;
	Перем РезультатФункции;

	Части = Новый Массив;
	ТекстСообщения = НСтр("ru = 'измерения'");
	ДобавитьПеречислениеПолей(Части, ОбъектМетаданных, "Измерения", ТекстСообщения);
	ТекстСообщения = НСтр("ru = 'ресурсы'");
	ДобавитьПеречислениеПолей(Части, ОбъектМетаданных, "Ресурсы", ТекстСообщения);
	ТекстСообщения = НСтр("ru = 'реквизиты'");
	ДобавитьПеречислениеПолей(Части, ОбъектМетаданных, "Реквизиты", ТекстСообщения);
	ТекстСообщения = НСтр("ru = 'табличные части'");
	ДобавитьПеречислениеПолей(Части, ОбъектМетаданных, "ТабличныеЧасти", ТекстСообщения);

	Если Части.Количество() = 0 Тогда
		РезультатФункции = НСтр("ru = 'полей нет'");
		Возврат РезультатФункции;
	КонецЕсли;

	РезультатФункции = СтрСоединить(Части, "; ");
	Возврат РезультатФункции;

КонецФункции

// Добавляет в массив частей описание одной коллекции метаданных, если она есть и непустая.
//
// Параметры:
//  Части           - Массив из Строка - куда добавлять.
//  ОбъектМетаданных - ОбъектМетаданных - объект конфигурации.
//  ИмяКоллекции    - Строка - «Измерения», «Ресурсы», «Реквизиты» или «ТабличныеЧасти».
//  Подпись         - Строка - как назвать коллекцию в тексте.
//
Процедура ДобавитьПеречислениеПолей(Части, Знач ОбъектМетаданных, Знач ИмяКоллекции, Знач Подпись)

	Коллекция = Неопределено;
	Попытка
		Коллекция = ОбъектМетаданных[ИмяКоллекции];
	Исключение
		Возврат;
	КонецПопытки;

	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Имена = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Имена.Добавить(Элемент.Имя);
	КонецЦикла;

	Если Имена.Количество() > 0 Тогда
		Перечисление = СтрСоединить(Имена, ", ");
		Части.Добавить(Подпись + " " + Перечисление);
	КонецЕсли;

КонецПроцедуры

#Область KrokiHTTP

// Проверяет доступность kroki через /healthcheck.
//
// Параметры:
//   URLKroki - Строка - базовый URL kroki
//   Таймаут  - Число  - таймаут соединения в секундах (умолч. 5)
//
// Возвращаемое значение:
//   Структура:
//     * Доступен  - Булево
//     * Сообщение - Строка
//
Функция ПроверитьДоступностьKroki(URLKroki, Таймаут = 5) Экспорт

	Перем РезультатНовоеЗащищенноеСоединение;

	Перем ТекстСообщения;
	Перем ДанныеОшибки;
	Перем ПредставлениеОшибки;

	Результат = Новый Структура("Доступен, Сообщение", Ложь, "");

	ПараметрыURL = РазобратьURL(URLKroki);

	Попытка

		Прокси = КИИ_HTTPКлиент.ПроксиПоУмолчанию();
		Если ПараметрыURL.Защищенное Тогда
			РезультатНовоеЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
			Соединение = Новый HTTPСоединение(
				ПараметрыURL.Хост, ПараметрыURL.Порт, , , Прокси, Таймаут, РезультатНовоеЗащищенноеСоединение);
		Иначе
			Соединение = Новый HTTPСоединение(ПараметрыURL.Хост, ПараметрыURL.Порт, , , Прокси, Таймаут);
		КонецЕсли;

		Запрос = Новый HTTPЗапрос("/health");
		Ответ = Соединение.Получить(Запрос);

		Если Ответ.КодСостояния = 200 Тогда
			Результат.Доступен = Истина;
			Результат.Сообщение = НСтр("ru = 'Kroki доступен'");
		Иначе
			Результат.Сообщение = СтрШаблон(НСтр("ru = 'Kroki вернул код %1'"), Ответ.КодСостояния);
		КонецЕсли;

	Исключение
		ТекстСообщения = НСтр("ru = 'Kroki недоступен: %1'");
		ДанныеОшибки = ИнформацияОбОшибке();
		ПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
		Результат.Сообщение = СтрШаблон(ТекстСообщения, ПредставлениеОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Разбирает URL на составляющие (хост, порт, признак защищенности).
//
// Параметры:
//   URL - Строка - например "http://localhost:8000" или "https://kroki.io"
//
// Возвращаемое значение:
//   Структура:
//     * Хост       - Строка
//     * Порт       - Число
//     * Защищенное - Булево
//
Функция РазобратьURL(URL) Экспорт

	УRI = ОбщегоНазначенияКлиентСервер.СтруктураURI(URL);

	Результат = Новый Структура("Хост, Порт, Защищенное", "", 0, Ложь);
	Результат.Хост       = УRI.Хост;
	Результат.Защищенное = (НРег(УRI.Схема) = "https");

	Если НЕ ПустаяСтрока(УRI.Порт) Тогда
		Результат.Порт = Число(УRI.Порт);
	ИначеЕсли Результат.Защищенное Тогда
		Результат.Порт = 443;
	Иначе
		Результат.Порт = 80;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ГенерацияЧерезИИ

Функция СгенерироватьКодДиаграммы(ОписаниеДиаграммы, Эксперт) Экспорт

	Перем ПараметрыВызова;

	Результат = НовыйРезультатГенерации();

	Если ПустаяСтрока(ОписаниеДиаграммы) Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнено описание диаграммы'");
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Эксперт) Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнен Эксперт ИИ'");
		Возврат Результат;
	КонецЕсли;

	Если Не ПроверитьНаличиеИИконы() Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Подсистема ИИкона не найдена. Установите расширение ИИкона.'");
		Возврат Результат;
	КонецЕсли;

	Модель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эксперт, "Модель");
	Промпт = СформироватьПромпт(Эксперт, ОписаниеДиаграммы);

	// Модель с function-calling строит диаграмму по реальной базе: петля агент-анализа
	// дает ей инструменты структуры конфигурации и данных (get_metadata_tree, execute_query и др.).
	// Код диаграммы читает и правит человек: подстановки из ответа модели возвращаются к исходным значениям.
	КонтекстКонтроля = КИИ_КонтрольПерсональныхДанных.НовыйКонтекст();
	Если КИИ_АгентАнализа.МодельПоддерживаетИнструменты(Модель) Тогда
		ПараметрыВызова = Новый Структура("КонтекстКонтроля", КонтекстКонтроля);
		РезультатИИ = КИИ_АгентАнализа.ВыполнитьАнализСИнструментами(Модель, Промпт, ПараметрыВызова);
	Иначе
		РезультатИИ = КИИ_КоннекторИИ.ЗапросКМодели(Модель, Промпт, КонтекстКонтроля);
	КонецЕсли;

	Если РезультатИИ.ЭтоОшибка Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = РезультатИИ.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	ТекстДляЧеловека = КИИ_КонтрольПерсональныхДанных.ВосстановитьДляЧеловека(
		РезультатИИ.ТекстОтвета, КонтекстКонтроля).Текст;
	ИзвлеченныйКод = ИзвлечьКодИзОтветаИИ(ТекстДляЧеловека);
	Если ПустаяСтрока(ИзвлеченныйКод) Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'ИИ не вернул распознаваемый код диаграммы.%1Ответ ИИ:%1%2'"), Символы.ПС, ТекстДляЧеловека);
	Иначе
		Результат.КодДиаграммы = ИзвлеченныйКод;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Извлекает код диаграммы из текстового ответа ИИ.
// Порядок поиска:
//   1. Именованные блоки ```mermaid, ```plantuml, ```dot, ```graphviz, ```bpmn
//   2. Любой блок ``` с распознаваемым содержимым
//   3. Первая строка с маркером диаграммы - берется весь текст с нее
//
// Параметры:
//   ТекстОтвета - Строка - полный текст ответа ИИ
//
// Возвращаемое значение:
//   Строка - извлеченный код; пустая строка, если не распознан
//
Функция ИзвлечьКодИзОтветаИИ(ТекстОтвета) Экспорт

	Перем РезультатФункции;

	Текст = СокрЛП(ТекстОтвета);

	Код = ИзвлечьКодИзИменованногоБлока(Текст);
	Если ЗначениеЗаполнено(Код) Тогда
		Возврат Код;
	КонецЕсли;

	Код = ИзвлечьКодИзБезымянногоБлока(Текст);
	Если ЗначениеЗаполнено(Код) Тогда
		Возврат Код;
	КонецЕсли;

	РезультатФункции = ИзвлечьКодПоМаркеруДиаграммы(Текст);
	Возврат РезультатФункции;

КонецФункции

// Стратегия 1: именованный блок ```mermaid/plantuml/dot/graphviz/bpmn.
Функция ИзвлечьКодИзИменованногоБлока(Знач Текст)

	Перем ЗначениеВНижнемРегистре;
	Перем ДлинаТекста;
	Перем ФрагментТекста;
	Перем НачалоТекста;
	Перем РезультатФункции;

	МаркерыЯзыков = СтрРазделить("mermaid,plantuml,dot,graphviz,bpmn", ",");
	Для Каждого Язык Из МаркерыЯзыков Цикл
		Маркер = "```" + Язык;
		ЗначениеВНижнемРегистре = НРег(Текст);
		Поз = СтрНайти(ЗначениеВНижнемРегистре, Маркер);
		Если Поз = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДлинаТекста = СтрДлина(Маркер);
		ФрагментТекста = Сред(Текст, Поз + ДлинаТекста);
		ТекстПосле = СокрЛ(ФрагментТекста);
		Если СтрНачинаетсяС(ТекстПосле, Символы.ПС) Тогда
			ТекстПосле = Сред(ТекстПосле, 2);
		КонецЕсли;
		ПозКонца = СтрНайти(ТекстПосле, "```");
		Если ПозКонца > 0 Тогда
			НачалоТекста = Лев(ТекстПосле, ПозКонца - 1);
			РезультатФункции = СокрЛП(НачалоТекста);
			Возврат РезультатФункции;
		Иначе
			РезультатФункции = СокрЛП(ТекстПосле);
			Возврат РезультатФункции;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Стратегия 2: любой блок ``` с содержимым, похожим на код диаграммы.
Функция ИзвлечьКодИзБезымянногоБлока(Знач Текст)

	Перем ФрагментТекста;
	Перем НачалоТекста;

	Поз = СтрНайти(Текст, "```");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	ФрагментТекста = Сред(Текст, Поз + 3);
	ТекстПосле = СокрЛ(ФрагментТекста);
	ПервыйПС = СтрНайти(ТекстПосле, Символы.ПС);
	Если ПервыйПС > 0 Тогда
		ТекстПосле = Сред(ТекстПосле, ПервыйПС + 1);
	КонецЕсли;

	ПозКонца = СтрНайти(ТекстПосле, "```");
	Если ПозКонца > 0 Тогда
		НачалоТекста = Лев(ТекстПосле, ПозКонца - 1);
		КодИзБлока = СокрЛП(НачалоТекста);
	Иначе
		КодИзБлока = СокрЛП(ТекстПосле);
	КонецЕсли;

	Если ЭтоГотовыйКодДиаграммы(КодИзБлока) Тогда
		Возврат КодИзБлока;
	КонецЕсли;

	Возврат "";

КонецФункции

// Стратегия 3: маркер диаграммы в обычной строке - берется весь текст с нее.
Функция ИзвлечьКодПоМаркеруДиаграммы(Знач Текст)

	Перем СоединенныйТекст;
	Перем РезультатФункции;

	МаркерыДиаграмм = "graph td,graph lr,graph tb,graph bt,graph rl,"
		+ "flowchart,sequencediagram,classdiagram,statediagram,erdiagram,"
		+ "gantt,pie,journey,gitgraph,mindmap,timeline,@startuml,digraph,strict digraph";
	МассивМаркеров = СтрРазделить(МаркерыДиаграмм, ",");
	Строки = СтрРазделить(Текст, Символы.ПС);

	НачалоКода = НайтиСтрокуСМаркеромДиаграммы(Строки, МассивМаркеров);
	Если НачалоКода < 0 Тогда
		Возврат "";
	КонецЕсли;

	КодСтроки = Новый Массив;
	ОткрытыхБлоков = 0;
	Для Инд = НачалоКода По Строки.ВГраница() Цикл
		СтрокаОтвета = Строки[Инд];
		// Пояснение, которое модель дописала после кода, в диаграмму не берем: сервис рендеринга
		// отвечает на такой текст ошибкой синтаксиса. Внутри блока полей (фигурные скобки) строки
		// берем целиком: там перечислены типы и имена реквизитов без знаков связей.
		ОборватьСбор = КодСтроки.Количество() > 0 И ОткрытыхБлоков = 0 И Не СтрокаПродолжаетКодДиаграммы(СтрокаОтвета);
		Если ОборватьСбор Тогда
			Прервать;
		КонецЕсли;
		КодСтроки.Добавить(СтрокаОтвета);
		ОткрытыхБлоков = ОткрытыхБлоков + СтрЧислоВхождений(СтрокаОтвета, "{") - СтрЧислоВхождений(СтрокаОтвета, "}");
		Если ОткрытыхБлоков < 0 Тогда
			ОткрытыхБлоков = 0;
		КонецЕсли;
	КонецЦикла;
	СоединенныйТекст = СтрСоединить(КодСтроки, Символы.ПС);
	РезультатФункции = СокрЛП(СоединенныйТекст);
	Возврат РезультатФункции;

КонецФункции

// Похожа ли строка на продолжение кода диаграммы: пустая строка, строка со знаками связей и скобок
// либо строка, начинающаяся с ключевого слова языка диаграмм. Обычная фраза на русском - не похожа.
//
// Параметры:
//  СтрокаОтвета - Строка - очередная строка ответа модели.
//
// Возвращаемое значение:
//  Булево - Истина, если строку можно оставить в коде диаграммы.
//
Функция СтрокаПродолжаетКодДиаграммы(Знач СтрокаОтвета)

	Перем ЧастиТекста;
	Перем РезультатФункции;

	ТекстСтроки = СокрЛП(СтрокаОтвета);
	Если ПустаяСтрока(ТекстСтроки) Тогда
		Возврат Истина;
	КонецЕсли;

	ЗнакиКода = СтрРазделить("-->,---,-.,==>,==,[,],{,},|,:,;,(,),<,>,""", ",", Ложь);
	Для Каждого Знак Из ЗнакиКода Цикл
		Если СтрНайти(ТекстСтроки, Знак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	КлючевыеСлова = СтрРазделить(
		"subgraph,end,class,classdef,style,linkstyle,click,direction,title,section,"
			+ "participant,actor,note,loop,alt,opt,par,rect,state,graph,flowchart,@enduml,}",
		",",
		Ложь);
	ЧастиТекста = СтрРазделить(ТекстСтроки, " ", Ложь);
	ПерваяЛексема = НРег(ЧастиТекста[0]);
	РезультатФункции = КлючевыеСлова.Найти(ПерваяЛексема) <> Неопределено;
	Возврат РезультатФункции;

КонецФункции

// Найти индекс первой строки, начинающейся с одного из маркеров диаграммы.
Функция НайтиСтрокуСМаркеромДиаграммы(Знач Строки, Знач МассивМаркеров)

	Перем ЗначениеБезПробелов;

	Для Инд = 0 По Строки.ВГраница() Цикл
		ЗначениеБезПробелов = СокрЛП(Строки[Инд]);
		СтрокаНорм = НРег(ЗначениеБезПробелов);
		Для Каждого Маркер Из МассивМаркеров Цикл
			Если СтрНачинаетсяС(СтрокаНорм, Маркер) Тогда
				Возврат Инд;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат -1;

КонецФункции

Функция НовыйРезультатГенерации()

	Результат = Новый Структура;
	Результат.Вставить("КодДиаграммы", "");
	Результат.Вставить("ВидДиаграммы", "");
	Результат.Вставить("SVGТекст",     "");
	Результат.Вставить("HTML",         "");
	Результат.Вставить("ЭтоОшибка",   Ложь);
	Результат.Вставить("ТекстОшибки",  "");

	Возврат Результат;

КонецФункции

Функция СформироватьПромпт(Эксперт, ТекстПромпта)

	СистемныйПромпт = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эксперт, "ОписаниеЭксперта");

	// Если в описании названы объекты конфигурации, их состав кладем в промпт: иначе модель рисует
	// правдоподобные, но выдуманные реквизиты. Модели с инструментами это экономит раунды петли.
	СтруктураОбъектов = СтруктураУпомянутыхОбъектов(ТекстПромпта);
	Если ЗначениеЗаполнено(СтруктураОбъектов) Тогда
		СистемныйПромпт = СистемныйПромпт + Символы.ПС + Символы.ПС + СтруктураОбъектов;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("СистемныйПромпт",        СистемныйПромпт);
	Результат.Вставить("ПользовательскийПромпт", ТекстПромпта);
	Результат.Вставить("ИсторияСообщений",       Новый Массив);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область MermaidJS
// Резервный HTML для рендеринга через встроенный mermaid.js.
// Используется когда kroki недоступен (только для Mermaid-диаграмм).
//
// Параметры:
//   КодДиаграммы - Строка - код Mermaid-диаграммы
//   Тема         - Строка - тема оформления Mermaid (умолч. "default")
//   ФонСтраницы  - Строка - CSS-цвет фона (умолч. "white")
//
// Возвращаемое значение:
//   Строка - HTML-документ для отображения в HTMLДокументПоле
//
Функция HTMLДиаграммыMermaid(КодДиаграммы, Тема = "default", ФонСтраницы = "white") Экспорт

	Перем СимволТекста;
	Перем СимволТекста2;
	Перем СимволТекста3;

	МакетHTML = ПолучитьМакет("ШаблонMermaid");
	HTMLТекст = МакетHTML.ПолучитьТекст();

	СимволТекста = Символ(92);
	СимволТекста2 = Символ(92);
	СимволТекста3 = Символ(92);
	КодДиаграммыJS = СтрЗаменить(КодДиаграммы, СимволТекста, СимволТекста2 + СимволТекста3);
	СимволТекста = Символ(39);
	СимволТекста2 = Символ(92);
	СимволТекста3 = Символ(39);
	КодДиаграммыJS = СтрЗаменить(КодДиаграммыJS, СимволТекста, СимволТекста2 + СимволТекста3);
	СимволТекста = Символ(13);
	КодДиаграммыJS = СтрЗаменить(КодДиаграммыJS, СимволТекста, "");
	СимволТекста = Символ(10);
	СимволТекста2 = Символ(92);
	КодДиаграммыJS = СтрЗаменить(КодДиаграммыJS, СимволТекста, СимволТекста2 + "n");

	// HTML-парсер завершает script даже внутри строки JavaScript.
	СимволТекста = Символ(92);
	ЭкранированнаяСкобка = СимволТекста + "u003C";
	КодДиаграммыJS = СтрЗаменить(КодДиаграммыJS, "<", ЭкранированнаяСкобка);

	HTMLТекст = СтрЗаменить(HTMLТекст, "%MERMAID_CODE%", КодДиаграммыJS);
	ТемаДляHTML = Тема;
	Если ПустаяСтрока(ТемаДляHTML) Тогда
		ТемаДляHTML = "default";
	КонецЕсли;
	HTMLТекст = СтрЗаменить(HTMLТекст, "%MERMAID_THEME%", ТемаДляHTML);
	HTMLТекст = СтрЗаменить(HTMLТекст, "%MERMAID_FONTSIZE%", "14px");
	HTMLТекст = СтрЗаменить(HTMLТекст, "%MERMAID_CURVE%", "basis");
	HTMLТекст = СтрЗаменить(HTMLТекст, "%MERMAID_BGPAGE%", ФонСтраницы);

	МакетJS = ПолучитьМакет("mermaid_js");
	ПотокJS = МакетJS.ОткрытьПотокДляЧтения();
	ЧтениеJS = Новый ЧтениеТекста(ПотокJS, КодировкаТекста.UTF8);
	КодJS = ЧтениеJS.Прочитать();
	ЧтениеJS.Закрыть();

	Для КодСимвола = 0 По 31 Цикл
		Если КодСимвола = 9 Или КодСимвола = 10 Или КодСимвола = 13 Тогда
			Продолжить;
		КонецЕсли;
		СимволТекста = Символ(КодСимвола);
		КодJS = СтрЗаменить(КодJS, СимволТекста, "");
	КонецЦикла;

	HTMLТекст = СтрЗаменить(HTMLТекст, "%MERMAID_JS_LIBRARY%", КодJS);

	Возврат HTMLТекст;

КонецФункции

#КонецОбласти

#Область ВспомогательныеМетодыРендеринга

// Проверить, начинается ли текст с одного из перечисленных префиксов.
//
//
// BSLLS:NumberOfOptionalParams-off
Функция НачинаетсяСодним(
	Знач Текст, Знач Префикс1, Знач Префикс2 = "", Знач Префикс3 = "", Знач Префикс4 = "", Знач Префикс5 = "")

	Перем РезультатФункции;
// BSLLS:NumberOfOptionalParams-on

	РезультатФункции = СтрНачинаетсяС(Текст, Префикс1)
		Или (Не ПустаяСтрока(Префикс2) И СтрНачинаетсяС(Текст, Префикс2))
		Или (Не ПустаяСтрока(Префикс3) И СтрНачинаетсяС(Текст, Префикс3))
		Или (Не ПустаяСтрока(Префикс4) И СтрНачинаетсяС(Текст, Префикс4))
		Или (Не ПустаяСтрока(Префикс5) И СтрНачинаетсяС(Текст, Префикс5));
	Возврат РезультатФункции;

КонецФункции

// Скопировать непустые поля из ПараметрыРендеринга в НастройкиKroki.
Процедура ОбъединитьПараметрыРендеринга(НастройкиKroki, Знач ПараметрыРендеринга)

	Если ТипЗнч(ПараметрыРендеринга) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если ПараметрыРендеринга.Свойство("URLKroki") И НЕ ПустаяСтрока(ПараметрыРендеринга.URLKroki) Тогда
		НастройкиKroki.URLKroki = ПараметрыРендеринга.URLKroki;
	КонецЕсли;
	Если ПараметрыРендеринга.Свойство("Тема") Тогда
		НастройкиKroki.Тема = ПараметрыРендеринга.Тема;
	КонецЕсли;
	Если ПараметрыРендеринга.Свойство("Формат") И НЕ ПустаяСтрока(ПараметрыРендеринга.Формат) Тогда
		НастройкиKroki.Формат = ПараметрыРендеринга.Формат;
	КонецЕсли;
	Если ПараметрыРендеринга.Свойство("Таймаут") И ПараметрыРендеринга.Таймаут > 0 Тогда
		НастройкиKroki.Таймаут = ПараметрыРендеринга.Таймаут;
	КонецЕсли;

КонецПроцедуры

// Создать HTTP-соединение с kroki (http/https).
Функция СоздатьСоединениеKroki(Знач ПараметрыURL, Знач Таймаут)

	Перем РезультатНовоеЗащищенноеСоединение;

	Перем РезультатФункции;

	// Прокси тот же, что у запросов к моделям (константа КИИ_АдресПроксиИнтернет): публичный kroki.io
	// из локальной сети напрямую может не отвечать.
	Прокси = КИИ_HTTPКлиент.ПроксиПоУмолчанию();
	Если ПараметрыURL.Защищенное Тогда
		РезультатНовоеЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
		РезультатФункции = Новый HTTPСоединение(
			ПараметрыURL.Хост, ПараметрыURL.Порт, , , Прокси, Таймаут, РезультатНовоеЗащищенноеСоединение);
		Возврат РезультатФункции;
	КонецЕсли;

	РезультатФункции = Новый HTTPСоединение(ПараметрыURL.Хост, ПараметрыURL.Порт, , , Прокси, Таймаут);
	Возврат РезультатФункции;

КонецФункции

// Создать HTTP-запрос к kroki с кодом диаграммы и нужными заголовками.
Функция СоздатьЗапросKroki(Знач ПутьЗапроса, Знач КодЧистый, Знач Формат)

	Запрос = Новый HTTPЗапрос(ПутьЗапроса);
	Запрос.УстановитьТелоИзСтроки(КодЧистый, КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);
	Запрос.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Запрос.Заголовки["Accept"] = ЗаголовокAcceptПоФормату(Формат);
	Возврат Запрос;

КонецФункции

// Получить значение заголовка Accept по формату kroki.
Функция ЗаголовокAcceptПоФормату(Знач Формат)

	Перем ЗначениеВНижнемРегистре;
	Перем РезультатФункции;

	Карта = Новый Соответствие;
	Карта.Вставить("svg", "image/svg+xml");
	Карта.Вставить("png", "image/png");
	Карта.Вставить("pdf", "application/pdf");

	ЗначениеВНижнемРегистре = НРег(Формат);
	РезультатФункции = Карта.Получить(ЗначениеВНижнемРегистре);
	Возврат РезультатФункции;

КонецФункции

// Заполнить Результат на основании ответа kroki.
Процедура ЗаполнитьРезультатОтветаKroki(Знач Ответ, Знач Формат, Результат)

	Перем РезультатБезопасноПрочитатьТелоКакСтроку;

	Если Ответ.КодСостояния <> 200 Тогда
		РезультатБезопасноПрочитатьТелоКакСтроку = БезопасноПрочитатьТелоКакСтроку(Ответ);
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'kroki вернул код %1: %2'"), Ответ.КодСостояния, РезультатБезопасноПрочитатьТелоКакСтроку);
		Возврат;
	КонецЕсли;

	Если НРег(Формат) = "svg" Тогда
		Результат.SVGТекст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Иначе
		Результат.ДвоичныеДанные = Ответ.ПолучитьТелоКакДвоичныеДанные();
	КонецЕсли;
	Результат.Успех = Истина;

КонецПроцедуры

// Безопасно прочитать тело ответа как строку; при ошибке декодирования - пустая строка.
Функция БезопасноПрочитатьТелоКакСтроку(Знач Ответ)

	Перем РезультатФункции;

	Попытка
		РезультатФункции = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Возврат РезультатФункции;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Разобрать настройки оформления, вернуть структуру с дефолтами.
Функция РазобратьНастройкиОформления(Знач НастройкиОформления)

	Оформление = Новый Структура;
	Оформление.Вставить("URLKroki",    "http://localhost:8000");
	Оформление.Вставить("Тема",        "default");
	Оформление.Вставить("ФонСтраницы", "white");
	Оформление.Вставить("Таймаут",     30);

	Если ТипЗнч(НастройкиОформления) <> Тип("Структура") Тогда
		Возврат Оформление;
	КонецЕсли;

	Если НастройкиОформления.Свойство("URLKroki") И НЕ ПустаяСтрока(НастройкиОформления.URLKroki) Тогда
		Оформление.URLKroki = НастройкиОформления.URLKroki;
	КонецЕсли;
	Если НастройкиОформления.Свойство("Тема") И НЕ ПустаяСтрока(НастройкиОформления.Тема) Тогда
		Оформление.Тема = НастройкиОформления.Тема;
	КонецЕсли;
	Если НастройкиОформления.Свойство("ФонСтраницы") И НЕ ПустаяСтрока(НастройкиОформления.ФонСтраницы) Тогда
		Оформление.ФонСтраницы = НастройкиОформления.ФонСтраницы;
	КонецЕсли;
	Если НастройкиОформления.Свойство("Таймаут") И НастройкиОформления.Таймаут > 0 Тогда
		Оформление.Таймаут = НастройкиОформления.Таймаут;
	КонецЕсли;

	Возврат Оформление;

КонецФункции

// Заполнить Результат.КодДиаграммы из готового кода или вызвав ИИ. Возвращает Ложь при ошибке.
Функция ЗаполнитьКодДиаграммыВРезультате(Результат, Знач ОписаниеИлиКод, Знач Эксперт)

	Если ЭтоГотовыйКодДиаграммы(ОписаниеИлиКод) Тогда
		Результат.КодДиаграммы = СокрЛП(ОписаниеИлиКод);
		Возврат Истина;
	КонецЕсли;

	РезультатКода = СгенерироватьКодДиаграммы(ОписаниеИлиКод, Эксперт);
	Если РезультатКода.ЭтоОшибка Тогда
		Результат.ЭтоОшибка   = Истина;
		Результат.ТекстОшибки = РезультатКода.ТекстОшибки;
		Возврат Ложь;
	КонецЕсли;

	Результат.КодДиаграммы = РезультатКода.КодДиаграммы;
	Возврат Истина;

КонецФункции

// Применить результат рендеринга kroki к итоговому Результату (с fallback на mermaid.js).
Процедура ПрименитьРезультатРендеринга(Результат, Знач РезультатKroki, Знач Оформление)

	Перем КодЯзыка;
	Перем ТекстСообщения;

	Если РезультатKroki.Успех Тогда
		Если Не ПустаяСтрока(РезультатKroki.SVGТекст) Тогда
			Результат.SVGТекст = РезультатKroki.SVGТекст;
			Результат.HTML = ПостроитьHTMLДляПросмотра(Результат.SVGТекст, Оформление.ФонСтраницы);
		Иначе
			Формат = "png";
			Если РезультатKroki.Свойство("Формат") Тогда
				Формат = РезультатKroki.Формат;
			КонецЕсли;
			Результат.HTML = ПостроитьHTMLДляПросмотраБинарного(
				РезультатKroki.ДвоичныеДанные, Формат, Оформление.ФонСтраницы);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Результат.ВидДиаграммы = "mermaid" Тогда
		Результат.HTML = HTMLДиаграммыMermaid(Результат.КодДиаграммы, Оформление.Тема, Оформление.ФонСтраницы);
		СообщениеЖурнала = СтрШаблон(
			НСтр("ru = 'kroki недоступен, используется mermaid.js: %1'"), РезультатKroki.ТекстОшибки);
		КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ТекстСообщения = НСтр("ru = 'ИИКона.ГенераторДиаграмм'", КодЯзыка);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Предупреждение, , , СообщениеЖурнала);
		Возврат;
	КонецЕсли;

	Результат.ЭтоОшибка = Истина;
	Результат.ТекстОшибки = РезультатKroki.ТекстОшибки;

КонецПроцедуры


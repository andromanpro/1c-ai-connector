	СоответствиеТипов.Вставить("graphviz",    "graphviz");
	СоответствиеТипов.Вставить("d2",          "d2");
	СоответствиеТипов.Вставить("structurizr", "structurizr");
	СоответствиеТипов.Вставить("bpmn",        "bpmn");
	СоответствиеТипов.Вставить("erd",         "erd");
	СоответствиеТипов.Вставить("nomnoml",     "nomnoml");
	СоответствиеТипов.Вставить("ditaa",       "ditaa");
	СоответствиеТипов.Вставить("svgbob",      "svgbob");
	СоответствиеТипов.Вставить("blockdiag",   "blockdiag");
	СоответствиеТипов.Вставить("seqdiag",     "seqdiag");
	СоответствиеТипов.Вставить("actdiag",     "actdiag");
	СоответствиеТипов.Вставить("nwdiag",      "nwdiag");
	СоответствиеТипов.Вставить("packetdiag",  "packetdiag");
	СоответствиеТипов.Вставить("rackdiag",    "rackdiag");
	СоответствиеТипов.Вставить("wavedrom",    "wavedrom");
	СоответствиеТипов.Вставить("pikchr",      "pikchr");
	СоответствиеТипов.Вставить("vega",        "vega");
	СоответствиеТипов.Вставить("vegalite",    "vega-lite");
	СоответствиеТипов.Вставить("excalidraw",  "excalidraw");
	СоответствиеТипов.Вставить("wireviz",     "wireviz");
	СоответствиеТипов.Вставить("bytefield",   "bytefield");
	СоответствиеТипов.Вставить("umlet",       "umlet");
	СоответствиеТипов.Вставить("dbml",        "dbml");

	ИмяТипа = СоответствиеТипов[НРег(ВидДиаграммы)];

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗагрузитьНастройки();
	ГраницыКонтроля = НСтр(
		"ru = 'Проверяется передаваемый текст. Содержимое изображений и документов текстовая маскировка не очищает;
			|в режиме блокировки такие вложения блокируются. Настройки этих каналов не означают контроль
			|произвольных обращений к серверу MCP.'");
	ОбластьПроверки = НСтр(
		"ru = 'Проверка использует сохраненные правила и адрес сервиса, стиль замены - из этой формы. Измененные
			|правила сначала сохраните. Текст не передается модели и не записывается в журнал контроля.'");
	Если ЗначениеЗаполнено(АдресСервисаИмен) Тогда
		ОбластьПроверки = ОбластьПроверки + Символы.ПС + НСтр(
			"ru = 'Настроенный сервис распознавания имен получает исходный текст.'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)

	ТекстОшибки = СохранитьНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки контроля персональных данных сохранены'"));

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьТекст(Команда)

	Если ПустаяСтрока(СокрЛП(ПроверяемыйТекст)) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите исходный текст для проверки.'"));
		Возврат;
	КонецЕсли;
	Если ИспользуетсяСервисИмен() Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияПроверкиТекста", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр(
			"ru = 'Проверить текст? Исходный текст будет передан настроенному сервису распознавания имен. Модель ИИ не
				|вызывается.'"),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	Иначе
		ЗапуститьПроверку("Текст");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСервис(Команда)

	ЗапуститьПроверку("Сервис");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЖурнал(Команда)

	ОткрытьФорму("РегистрСведений.КИИ_ЖурналКонтроляПерсональныхДанных.ФормаСписка");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьНастройки()

	Режимы = Перечисления.КИИ_РежимыКонтроляПерсональныхДанных;

	// Пустая константа означает режим канала по умолчанию: форма показывает его явно.
	РежимЗапросовКМоделям = ЗначениеИлиПоУмолчанию(
		Константы.КИИ_РежимКонтроляЗапросовКМоделям.Получить(), Режимы.Маскировать);
	РежимУведомленийТелеграм = ЗначениеИлиПоУмолчанию(
		Константы.КИИ_РежимКонтроляУведомленийТелеграм.Получить(), Режимы.Маскировать);
	РежимРендераДиаграмм = ЗначениеИлиПоУмолчанию(
		Константы.КИИ_РежимКонтроляРендераДиаграмм.Получить(), Режимы.Логировать);
	РендерДиаграммДоверенный = Константы.КИИ_РендерДиаграммДоверенный.Получить();
	СтильПодстановок = ЗначениеИлиПоУмолчанию(Константы.КИИ_СтильПодстановокПерсональныхДанных.Получить(),
		Перечисления.КИИ_СтилиПодстановок.Правдоподобные);

	АдресСервисаИмен = Константы.КИИ_АдресСервисаРаспознаванияИмен.Получить();
	ТаймаутСервисаИмен = Константы.КИИ_ТаймаутСервисаРаспознаванияИмен.Получить();
	// Пустая настройка - 5 секунд, как в КИИ_КонтрольПерсональныхДанных: форма показывает то, что работает.
	Если ТаймаутСервисаИмен <= 0 Тогда
		ТаймаутСервисаИмен = 5;
	КонецЕсли;
	СервисИменОбязателен = Константы.КИИ_СервисРаспознаванияИменОбязателен.Получить();

	СрокХраненияСобытий = Константы.КИИ_СрокХраненияСобытийКонтроля.Получить();
	Если СрокХраненияСобытий <= 0 Тогда
		СрокХраненияСобытий = 30;
	КонецЕсли;

	Включенные = Новый Массив;
	Для Каждого Элемент Из СтрРазделить(ВРег(Константы.КИИ_ВключенныеПравилаПерсональныхДанных.Получить()), ",", Ложь) Цикл
		Включенные.Добавить(СокрЛП(Элемент));
	КонецЦикла;

	// Пустая настройка включает все правила, как и в модуле контроля.
	Для Каждого Правило Из РеквизитыПравил() Цикл
		ЭтотОбъект[Правило.Значение] = Включенные.Количество() = 0 Или Включенные.Найти(Правило.Ключ) <> Неопределено;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СохранитьНаСервере()

	Включенные = Новый Массив;
	Для Каждого Правило Из РеквизитыПравил() Цикл
		Если ЭтотОбъект[Правило.Значение] Тогда
			Включенные.Добавить(Правило.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если СервисИменОбязателен И Не ЗначениеЗаполнено(СокрЛП(АдресСервисаИмен)) Тогда
		Возврат НСтр("ru = 'Для флажка «Без сервиса не отправлять» укажите адрес сервиса распознавания имен.'");
	КонецЕсли;

	Если Включенные.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Нельзя выключить все правила: пустой список означает «все включены».
			|Чтобы не проверять канал, выберите для него режим «Выключен».'");
	КонецЕсли;

	// Все правила включены - хранится пустая строка: новые правила следующих версий включатся сами.
	СтрокаПравил = ?(Включенные.Количество() = РеквизитыПравил().Количество(), "", СтрСоединить(Включенные, ","));

	НачатьТранзакцию();
	Попытка
		Константы.КИИ_РежимКонтроляЗапросовКМоделям.Установить(РежимЗапросовКМоделям);
		Константы.КИИ_РежимКонтроляУведомленийТелеграм.Установить(РежимУведомленийТелеграм);
		Константы.КИИ_РежимКонтроляРендераДиаграмм.Установить(РежимРендераДиаграмм);
		Константы.КИИ_РендерДиаграммДоверенный.Установить(РендерДиаграммДоверенный);
		Константы.КИИ_СтильПодстановокПерсональныхДанных.Установить(СтильПодстановок);
		Константы.КИИ_СрокХраненияСобытийКонтроля.Установить(СрокХраненияСобытий);
		Константы.КИИ_АдресСервисаРаспознаванияИмен.Установить(СокрЛП(АдресСервисаИмен));
		Константы.КИИ_ТаймаутСервисаРаспознаванияИмен.Установить(ТаймаутСервисаИмен);
		Константы.КИИ_СервисРаспознаванияИменОбязателен.Установить(СервисИменОбязателен);
		Константы.КИИ_ВключенныеПравилаПерсональныхДанных.Установить(СтрокаПравил);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	// Срок хранения журнала контроля соблюдает регламентное задание очистки: создаем, если его нет.
	КИИ_КоннекторИИ.ОбеспечитьРегламентыОчистки();

	Возврат "";

КонецФункции

// Показывает, что найдут сохраненные правила и как текст уйдет при замене подстановками.
// В модель и журнал контроля ничего не уходит; настроенный сервис распознавания имен текст получает.
&НаСервере
Процедура ПоказатьРезультатПроверкиТекста(Проверка)

	Строки = Новый Массив;
	Если Проверка.Находки.Количество() = 0 Тогда
		Строки.Добавить(НСтр("ru = 'Персональных данных не найдено.'"));
	КонецЕсли;
	Для Каждого Находка Из Проверка.Находки Цикл
		Шаблон = НСтр("ru = '%1: %2 → %3 (уверенность: %4)'");
		Уверенность = НРег(Находка.Уверенность);
		Строки.Добавить(СтрШаблон(Шаблон, Находка.Тип, Находка.Значение, Находка.Подстановка, Уверенность));
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить(НСтр("ru = 'При замене подстановками уйдет:'"));
	Строки.Добавить(Проверка.ТекстПослеЗамены);

	РезультатПроверки = СтрСоединить(Строки, Символы.ПС);

КонецПроцедуры

// Сервис проверяется по введенному адресу, сохранять перед проверкой не нужно.
&НаСервереБезКонтекста
Функция ПроверитьСервисНаСервере(Знач Адрес, Знач Таймаут)

	Возврат КИИ_КонтрольПерсональныхДанных.ПроверитьСервисИмен(Адрес, Таймаут);

КонецФункции

// Код правила -> имя реквизита формы с флажком.
&НаСервереБезКонтекста
Функция РеквизитыПравил()

	Правила = Новый Соответствие;
	Правила.Вставить("ФИО", "ПравилоФИО");
	Правила.Вставить("ИНН", "ПравилоИНН");
	Правила.Вставить("СНИЛС", "ПравилоСНИЛС");
	Правила.Вставить("КАРТА", "ПравилоКарта");
	Правила.Вставить("ПАСПОРТ", "ПравилоПаспорт");
	Правила.Вставить("EMAIL", "ПравилоПочта");
	Правила.Вставить("ТЕЛЕФОН", "ПравилоТелефон");
	Правила.Вставить("ОРГАНИЗАЦИЯ", "ПравилоОрганизация");
	Правила.Вставить("АДРЕС", "ПравилоАдрес");
	Правила.Вставить("ДАТАРОЖДЕНИЯ", "ПравилоДатаРождения");

	Возврат Правила;

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеИлиПоУмолчанию(Знач Значение, Знач ПоУмолчанию)

	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);

КонецФункции

&НаКлиенте
Процедура ПослеПодтвержденияПроверкиТекста(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗапуститьПроверку("Текст");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИспользуетсяСервисИмен()

	Возврат ЗначениеЗаполнено(СокрЛП(Константы.КИИ_АдресСервисаРаспознаванияИмен.Получить()));

КонецФункции

&НаКлиенте
Процедура ЗапуститьПроверку(ВидПроверки)

	Попытка
		Операция = ЗапуститьПроверкуНаСервере(ВидПроверки);
	Исключение
		ПоказатьПредупреждение(, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Если Операция = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Предыдущая проверка еще выполняется. Отмена ожидания не гарантирует остановку обращения к сервису.'"));
		Возврат;
	КонецЕсли;
	УстановитьДоступностьПроверки(Ложь);
	РезультатПроверки = НСтр("ru = 'Проверка выполняется...'");
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Ложь;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Проверка персональных данных...'");
	Оповещение = Новый ОписаниеОповещения("ПослеЗавершенияПроверки", ЭтотОбъект, ВидПроверки);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьПроверки(Доступность)

	Элементы.ПроверитьТекстКнопка.Доступность = Доступность;
	Элементы.ПроверитьСервисКнопка.Доступность = Доступность;

КонецПроцедуры

&НаСервере
Функция ЗапуститьПроверкуНаСервере(Знач ВидПроверки)

	Если Не ПустаяСтрока(ЗаданиеПроверки) Тогда
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ЗаданиеПроверки));
		Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Не ПустаяСтрока(АдресРезультатаПроверки) Тогда
			УдалитьИзВременногоХранилища(АдресРезультатаПроверки);
		КонецЕсли;
	КонецЕсли;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Проверка персональных данных'");
	Если ВидПроверки = "Текст" Тогда
		Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"КИИ_КонтрольПерсональныхДанных.ПроверитьТекст", ПроверяемыйТекст, СтильПодстановок);
	Иначе
		Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"КИИ_КонтрольПерсональныхДанных.ПроверитьСервисИмен", АдресСервисаИмен, ТаймаутСервисаИмен);
	КонецЕсли;
	ЗаданиеПроверки = Строка(Операция.ИдентификаторЗадания);
	АдресРезультатаПроверки = Операция.АдресРезультата;
	Возврат Операция;

КонецФункции

&НаКлиенте
Процедура ПослеЗавершенияПроверки(Результат, ВидПроверки) Экспорт

	УстановитьДоступностьПроверки(Истина);
	Если Результат = Неопределено Тогда
		РезультатПроверки = НСтр(
			"ru = 'Ожидание отменено. Обращение к сервису может продолжаться; повторная проверка доступна после
				|завершения задания.'");
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		РезультатПроверки = Результат.КраткоеПредставлениеОшибки;
		Возврат;
	КонецЕсли;
	ПоказатьРезультатФоновойПроверки(Результат.АдресРезультата, ВидПроверки);

КонецПроцедуры

&НаСервере
Процедура ПоказатьРезультатФоновойПроверки(Знач Адрес, Знач ВидПроверки)

	Проверка = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	АдресРезультатаПроверки = "";
	Если ВидПроверки = "Текст" Тогда
		ПоказатьРезультатПроверкиТекста(Проверка);
	Иначе
		РезультатПроверки = Проверка.Текст;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

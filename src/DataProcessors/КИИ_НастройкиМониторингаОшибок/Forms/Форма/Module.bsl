#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗагрузитьНастройки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьТелеграм(Команда)

	Перем ОбработчикОповещения;
	Перем ТекстСообщения;

	ОбработчикОповещения = Новый ОписаниеОповещения("ПослеПодтвержденияТестовогоСообщения", ЭтотОбъект);
	ТекстСообщения = НСтр("ru = 'Отправить реальное тестовое сообщение в Telegram по сохраненным настройкам?'");
	ПоказатьВопрос(ОбработчикОповещения, ТекстСообщения, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)

	Перем ТекстСообщения;

	ТекстОшибки = СохранитьНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;

	ТекстСообщения = НСтр("ru = 'Настройки мониторинга ошибок сохранены'");
	ПоказатьОповещениеПользователя(ТекстСообщения);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьТокенБота(Команда)

	УдалитьТокен = Истина;
	НовыйТокенБота = "";
	ВключитьОтправкуВТелеграм = Ложь;
	СостояниеМониторинга = НСтр("ru = 'Токен будет удален после сохранения. Автоматическая отправка выключена.'");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьНастройки()

	Перем ШаблонСостоянияМониторинга;
	Перем ПредставлениеМоделиМониторинга;
	Перем ПредставлениеОтправкиТелеграм;
	Перем ИменаНастроек;
	Перем СоединенныйТекст;

	Настройки = КИИ_МониторингОшибок.ПолучитьНастройкиМониторинга();

	ИменаНастроек = ИменаПростыхНастроек();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки, ИменаНастроек);
	МодельДляАнализа = ?(
		ТипЗнч(Настройки.МодельДляАнализа) = Тип("СправочникСсылка.КИИ_МоделиИИ"),
		Настройки.МодельДляАнализа,
		Справочники.КИИ_МоделиИИ.ПустаяСсылка());

	// Токен на клиент не отдается: форма показывает только факт, что он задан.
	ТокенЗадан = ЗначениеЗаполнено(Настройки.ТокенБотаТелеграм);
	НовыйТокенБота = "";
	УдалитьТокен = Ложь;
	ШаблонСостоянияМониторинга = НСтр("ru = 'Модель анализа: %1. Telegram: %2.'");
	ПредставлениеМоделиМониторинга = ?(
		ЗначениеЗаполнено(МодельДляАнализа), Строка(МодельДляАнализа), НСтр("ru = 'не выбрана'"));
	ПредставлениеОтправкиТелеграм = ?(ВключитьОтправкуВТелеграм, НСтр("ru = 'включен'"), НСтр("ru = 'выключен'"));
	СостояниеМониторинга = СтрШаблон(
		ШаблонСостоянияМониторинга, ПредставлениеМоделиМониторинга, ПредставлениеОтправкиТелеграм);

	СоединенныйТекст = СтрСоединить(Настройки.УровниОшибокЖР, ",");
	Уровни = ВРег(СоединенныйТекст);
	СобиратьОшибки = СтрНайти("," + Уровни + ",", ",ОШИБКА,") > 0;
	СобиратьПредупреждения = СтрНайти("," + Уровни + ",", ",ПРЕДУПРЕЖДЕНИЕ,") > 0;

	МаркерыТестовыхПрогонов = СтрСоединить(Настройки.МаркерыТестовыхПрогонов, Символы.ПС);

КонецПроцедуры

&НаСервере
Функция СохранитьНаСервере()

	Перем НовыйТокенДляСохранения;
	Перем ИменаНастроек;
	Перем ЗначениеБезПробелов;

	ТекстОшибки = ОшибкаЗаполнения();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;

	// Берем сохраненные настройки целиком: поля, которых нет на форме, сохраняются как были.
	Настройки = КИИ_МониторингОшибок.ПолучитьНастройкиМониторинга();
	ИменаНастроек = ИменаПростыхНастроек();
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект, ИменаНастроек);
	Настройки.МодельДляАнализа = МодельДляАнализа;
	Настройки.ChatIDТелеграм = СокрЛП(ChatIDТелеграм);

	Уровни = Новый Массив;
	Если СобиратьОшибки Тогда
		Уровни.Добавить("Ошибка");
	КонецЕсли;
	Если СобиратьПредупреждения Тогда
		Уровни.Добавить("Предупреждение");
	КонецЕсли;
	Настройки.УровниОшибокЖР = Уровни;

	Маркеры = Новый Массив;
	Для Каждого Маркер Из СтрРазделить(МаркерыТестовыхПрогонов, Символы.ПС, Ложь) Цикл
		ЗначениеБезПробелов = СокрЛП(Маркер);
		Если ЗначениеЗаполнено(ЗначениеБезПробелов) Тогда
			ЗначениеБезПробелов = СокрЛП(Маркер);
			Маркеры.Добавить(ЗначениеБезПробелов);
		КонецЕсли;
	КонецЦикла;
	Настройки.МаркерыТестовыхПрогонов = Маркеры;

	// Ключ токена в структуре - команда хранилищу: пустое значение удаляет токен.
	// Нет ни нового токена, ни флажка удаления - ключ убираем, и сохраненный токен остается.
	Если УдалитьТокен Тогда
		Настройки.ТокенБотаТелеграм = "";
	Иначе
		НовыйТокенДляСохранения = СокрЛП(НовыйТокенБота);
		Если ЗначениеЗаполнено(НовыйТокенДляСохранения) Тогда
			Настройки.ТокенБотаТелеграм = СокрЛП(НовыйТокенБота);
		Иначе
			Настройки.Удалить("ТокенБотаТелеграм");
		КонецЕсли;
	КонецЕсли;

	КИИ_МониторингОшибок.СохранитьНастройкиМониторинга(Настройки);
	КИИ_КоннекторИИ.ОбеспечитьРегламентыОчистки();

	ЗагрузитьНастройки();
	Возврат "";

КонецФункции

&НаСервере
Функция ОшибкаЗаполнения()

	Перем НовыйТокенБезПробелов;
	Перем ЕстьНовыйТокенБота;
	Перем ChatIDБезКрайнихПробелов;
	Перем ТокенДляПроверкиЗаполнения;
	Перем РезультатФункции;

	Если Не СобиратьОшибки И Не СобиратьПредупреждения Тогда
		РезультатФункции = НСтр(
			"ru = 'Отметьте хотя бы один вид записей журнала регистрации: ошибки или предупреждения.'");
		Возврат РезультатФункции;
	КонецЕсли;

	Если Не ЛимитыБольшеНуля() Тогда
		РезультатФункции = НСтр("ru = 'Лимиты анализа, размер страницы, срок хранения и порог повторного
					|уведомления должны быть больше нуля.'");
		Возврат РезультатФункции;
	КонецЕсли;

	НовыйТокенБезПробелов = СокрЛП(НовыйТокенБота);
	ЕстьНовыйТокенБота = ЗначениеЗаполнено(НовыйТокенБезПробелов);
	Если ЕстьНовыйТокенБота И УдалитьТокен Тогда
		РезультатФункции = НСтр("ru = 'Введен новый токен и отмечено удаление токена - оставьте что-то одно.'");
		Возврат РезультатФункции;
	КонецЕсли;

	Если ВключитьОтправкуВТелеграм Тогда
		НеЗаданыДанныеТелеграм = УдалитьТокен;
		Если Не НеЗаданыДанныеТелеграм Тогда
			ChatIDБезКрайнихПробелов = СокрЛП(ChatIDТелеграм);
			НеЗаданыДанныеТелеграм = Не ЗначениеЗаполнено(ChatIDБезКрайнихПробелов);
		КонецЕсли;
		Если Не НеЗаданыДанныеТелеграм И Не ТокенЗадан Тогда
			ТокенДляПроверкиЗаполнения = СокрЛП(НовыйТокенБота);
			НеЗаданыДанныеТелеграм = Не ЗначениеЗаполнено(ТокенДляПроверкиЗаполнения);
		КонецЕсли;
		Если НеЗаданыДанныеТелеграм Тогда
			РезультатФункции = НСтр(
				"ru = 'Для включения Telegram задайте токен бота и Chat ID. Для удаления токена выключите отправку.'");
			Возврат РезультатФункции;
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция ЛимитыБольшеНуля()

	Лимиты = Новый Массив;
	Лимиты.Добавить(МаксимальноОшибокНаАнализ);
	Лимиты.Добавить(РазмерПакетаАнализаИИ);
	Лимиты.Добавить(РазмерСтраницыЖурнала);
	Лимиты.Добавить(СрокХраненияДней);
	Лимиты.Добавить(ПорогОтправкиВТелеграм);
	Для Каждого Лимит Из Лимиты Цикл
		Если Лимит < 1 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаСервере
Функция ПроверитьТелеграмНаСервере()

	Перем ИменаНастроек;
	Перем ЧастиТекста;

	Перем РезультатФункции;
	Перем ТекстСообщения2;
	Перем ДанныеОшибки;
	Перем ПредставлениеОшибки;

	Настройки = КИИ_МониторингОшибок.ПолучитьНастройкиМониторинга();
	Если Не Настройки.ВключитьОтправкуВТелеграм Тогда
		РезультатФункции = НСтр("ru = 'Отправка в Telegram выключена. Включите ее и сохраните настройки.'");
		Возврат РезультатФункции;
	КонецЕсли;
	НастройкиАнализаИзменены = МодельДляАнализа <> Настройки.МодельДляАнализа
		Или СобиратьОшибки <> (Настройки.УровниОшибокЖР.Найти("Ошибка") <> Неопределено)
		Или СобиратьПредупреждения <> (Настройки.УровниОшибокЖР.Найти("Предупреждение") <> Неопределено)
		Или МаркерыТестовыхПрогонов <> СтрСоединить(Настройки.МаркерыТестовыхПрогонов, Символы.ПС);
	Если НастройкиАнализаИзменены Тогда
		РезультатФункции = НСтр(
			"ru = 'Настройки на форме изменены. Сначала сохраните их, затем отправьте тестовое сообщение.'");
		Возврат РезультатФункции;
	КонецЕсли;
	Если ЗначениеЗаполнено(НовыйТокенБота) Или УдалитьТокен Тогда
		РезультатФункции = НСтр("ru = 'Сначала сохраните изменения токена.'");
		Возврат РезультатФункции;
	КонецЕсли;
	ИменаНастроек = ИменаПростыхНастроек();
	ЧастиТекста = СтрРазделить(ИменаНастроек, ",", Ложь);
	Для Каждого ИмяНастройки Из ЧастиТекста Цикл
		ИмяНастройки = СокрЛП(ИмяНастройки);
		Если ЭтотОбъект[ИмяНастройки] <> Настройки[ИмяНастройки] Тогда
			РезультатФункции = НСтр(
				"ru = 'Настройки на форме изменены. Сначала сохраните их, затем отправьте тестовое сообщение.'");
			Возврат РезультатФункции;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Настройки.ТокенБотаТелеграм) Или Не ЗначениеЗаполнено(Настройки.ChatIDТелеграм) Тогда
		РезультатФункции = НСтр("ru = 'Сначала сохраните токен бота и Chat ID.'");
		Возврат РезультатФункции;
	КонецЕсли;

	ТекстСообщения = НСтр("ru = 'ИИкона: проверка уведомлений мониторинга ошибок.'");
	Попытка
		Отправлено = КИИ_МониторингОшибокTelegram.ОтправитьСообщениеВТелеграм(
			Настройки.ТокенБотаТелеграм, Настройки.ChatIDТелеграм, ТекстСообщения);
	Исключение
		ТекстСообщения2 = НСтр("ru = 'Сообщение не отправлено: %1'");
		ДанныеОшибки = ИнформацияОбОшибке();
		ПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
		РезультатФункции = СтрШаблон(ТекстСообщения2, ПредставлениеОшибки);
		Возврат РезультатФункции;
	КонецПопытки;

	Если Отправлено Тогда
		РезультатФункции = НСтр("ru = 'Тестовое сообщение отправлено - проверьте чат.'");
		Возврат РезультатФункции;
	КонецЕсли;
	РезультатФункции = НСтр(
		"ru = 'Telegram не принял сообщение. Проверьте токен бота, Chat ID и что бот добавлен в чат.'");
	Возврат РезультатФункции;

КонецФункции

// Настройки, которые форма показывает как есть, без преобразования.
&НаСервереБезКонтекста
Функция ИменаПростыхНастроек()

	Перем РезультатФункции;

	РезультатФункции = "ВключитьОтправкуВТелеграм, РазрешитьЗапросыКДанным, МаксимальноОшибокНаАнализ, "
		+ "РазмерПакетаАнализаИИ, РазмерСтраницыЖурнала, "
		+ "СрокХраненияДней, ChatIDТелеграм, ПорогОтправкиВТелеграм, ПериодПорогаМинуты, МаксимумОтправокВТелеграм, "
		+ "РежимДайджеста, ШаблонПромптаСистемный, ШаблонПромптаПользовательский";
	Возврат РезультатФункции;

КонецФункции

&НаКлиенте
Процедура ПослеПодтвержденияТестовогоСообщения(Ответ, ДополнительныеПараметры) Экспорт

	Перем РезультатПроверитьТелеграмНаСервере;

	Если Ответ = КодВозвратаДиалога.Да Тогда
		РезультатПроверитьТелеграмНаСервере = ПроверитьТелеграмНаСервере();
		ПоказатьПредупреждение(, РезультатПроверитьТелеграмНаСервере);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗагрузитьНастройки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьТелеграм(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияТестовогоСообщения", ЭтотОбъект),
		НСтр("ru = 'Отправить реальное тестовое сообщение в Telegram по сохраненным настройкам?'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)

	ТекстОшибки = СохранитьНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки мониторинга ошибок сохранены'"));

КонецПроцедуры

&НаКлиенте
Процедура УдалитьТокенБота(Команда)

	УдалитьТокен = Истина;
	НовыйТокенБота = "";
	ВключитьОтправкуВТелеграм = Ложь;
	СостояниеМониторинга = НСтр("ru = 'Токен будет удален после сохранения. Автоматическая отправка выключена.'");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьНастройки()

	Настройки = КИИ_МониторингОшибок.ПолучитьНастройкиМониторинга();

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки, ИменаПростыхНастроек());
	МодельДляАнализа = ?(ТипЗнч(Настройки.МодельДляАнализа) = Тип("СправочникСсылка.КИИ_МоделиИИ"),
		Настройки.МодельДляАнализа, Справочники.КИИ_МоделиИИ.ПустаяСсылка());

	// Токен на клиент не отдается: форма показывает только факт, что он задан.
	ТокенЗадан = ЗначениеЗаполнено(Настройки.ТокенБотаТелеграм);
	НовыйТокенБота = "";
	УдалитьТокен = Ложь;
	СостояниеМониторинга = СтрШаблон(НСтр("ru = 'Модель анализа: %1. Telegram: %2.'"),
		?(ЗначениеЗаполнено(МодельДляАнализа), Строка(МодельДляАнализа), НСтр("ru = 'не выбрана'")),
		?(ВключитьОтправкуВТелеграм, НСтр("ru = 'включен'"), НСтр("ru = 'выключен'")));

	Уровни = ВРег(СтрСоединить(Настройки.УровниОшибокЖР, ","));
	СобиратьОшибки = СтрНайти("," + Уровни + ",", ",ОШИБКА,") > 0;
	СобиратьПредупреждения = СтрНайти("," + Уровни + ",", ",ПРЕДУПРЕЖДЕНИЕ,") > 0;

	МаркерыТестовыхПрогонов = СтрСоединить(Настройки.МаркерыТестовыхПрогонов, Символы.ПС);

КонецПроцедуры

&НаСервере
Функция СохранитьНаСервере()

	ТекстОшибки = ОшибкаЗаполнения();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;

	// Берем сохраненные настройки целиком: поля, которых нет на форме, сохраняются как были.
	Настройки = КИИ_МониторингОшибок.ПолучитьНастройкиМониторинга();
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект, ИменаПростыхНастроек());
	Настройки.МодельДляАнализа = МодельДляАнализа;
	Настройки.ChatIDТелеграм = СокрЛП(ChatIDТелеграм);

	Уровни = Новый Массив;
	Если СобиратьОшибки Тогда
		Уровни.Добавить("Ошибка");
	КонецЕсли;
	Если СобиратьПредупреждения Тогда
		Уровни.Добавить("Предупреждение");
	КонецЕсли;
	Настройки.УровниОшибокЖР = Уровни;

	Маркеры = Новый Массив;
	Для Каждого Маркер Из СтрРазделить(МаркерыТестовыхПрогонов, Символы.ПС, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Маркер)) Тогда
			Маркеры.Добавить(СокрЛП(Маркер));
		КонецЕсли;
	КонецЦикла;
	Настройки.МаркерыТестовыхПрогонов = Маркеры;

	// Ключ токена в структуре - команда хранилищу: пустое значение удаляет токен.
	// Нет ни нового токена, ни флажка удаления - ключ убираем, и сохраненный токен остается.
	Если УдалитьТокен Тогда
		Настройки.ТокенБотаТелеграм = "";
	ИначеЕсли ЗначениеЗаполнено(СокрЛП(НовыйТокенБота)) Тогда
		Настройки.ТокенБотаТелеграм = СокрЛП(НовыйТокенБота);
	Иначе
		Настройки.Удалить("ТокенБотаТелеграм");
	КонецЕсли;

	КИИ_МониторингОшибок.СохранитьНастройкиМониторинга(Настройки);
	КИИ_КоннекторИИ.ОбеспечитьРегламентыОчистки();

	ЗагрузитьНастройки();
	Возврат "";

КонецФункции

&НаСервере
Функция ОшибкаЗаполнения()

	Если Не СобиратьОшибки И Не СобиратьПредупреждения Тогда
		Возврат НСтр("ru = 'Отметьте хотя бы один вид записей журнала регистрации: ошибки или предупреждения.'");
	КонецЕсли;

	Если Не ЛимитыБольшеНуля() Тогда
		Возврат НСтр("ru = 'Лимиты анализа, размер страницы, срок хранения и порог повторного
			|уведомления должны быть больше нуля.'");
	КонецЕсли;

	Если ЗначениеЗаполнено(СокрЛП(НовыйТокенБота)) И УдалитьТокен Тогда
		Возврат НСтр("ru = 'Введен новый токен и отмечено удаление токена - оставьте что-то одно.'");
	КонецЕсли;

	Если ВключитьОтправкуВТелеграм Тогда
		НеЗаданыДанныеТелеграм = УдалитьТокен Или Не ЗначениеЗаполнено(СокрЛП(ChatIDТелеграм))
			Или (Не ТокенЗадан И Не ЗначениеЗаполнено(СокрЛП(НовыйТокенБота)));
		Если НеЗаданыДанныеТелеграм Тогда
			Возврат НСтр("ru = 'Для включения Telegram задайте токен бота и Chat ID. Для удаления токена выключите отправку.'");
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция ЛимитыБольшеНуля()

	Лимиты = Новый Массив;
	Лимиты.Добавить(МаксимальноОшибокНаАнализ);
	Лимиты.Добавить(РазмерПакетаАнализаИИ);
	Лимиты.Добавить(РазмерСтраницыЖурнала);
	Лимиты.Добавить(СрокХраненияДней);
	Лимиты.Добавить(ПорогОтправкиВТелеграм);
	Для Каждого Лимит Из Лимиты Цикл
		Если Лимит < 1 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаСервере
Функция ПроверитьТелеграмНаСервере()

	Настройки = КИИ_МониторингОшибок.ПолучитьНастройкиМониторинга();
	Если Не Настройки.ВключитьОтправкуВТелеграм Тогда
		Возврат НСтр("ru = 'Отправка в Telegram выключена. Включите ее и сохраните настройки.'");
	КонецЕсли;
	НастройкиАнализаИзменены = МодельДляАнализа <> Настройки.МодельДляАнализа
		Или СобиратьОшибки <> (Настройки.УровниОшибокЖР.Найти("Ошибка") <> Неопределено)
		Или СобиратьПредупреждения <> (Настройки.УровниОшибокЖР.Найти("Предупреждение") <> Неопределено)
		Или МаркерыТестовыхПрогонов <> СтрСоединить(Настройки.МаркерыТестовыхПрогонов, Символы.ПС);
	Если НастройкиАнализаИзменены Тогда
		Возврат НСтр("ru = 'Настройки на форме изменены. Сначала сохраните их, затем отправьте тестовое сообщение.'");
	КонецЕсли;
	Если ЗначениеЗаполнено(НовыйТокенБота) Или УдалитьТокен Тогда
		Возврат НСтр("ru = 'Сначала сохраните изменения токена.'");
	КонецЕсли;
	Для Каждого ИмяНастройки Из СтрРазделить(ИменаПростыхНастроек(), ",", Ложь) Цикл
		ИмяНастройки = СокрЛП(ИмяНастройки);
		Если ЭтотОбъект[ИмяНастройки] <> Настройки[ИмяНастройки] Тогда
			Возврат НСтр("ru = 'Настройки на форме изменены. Сначала сохраните их, затем отправьте тестовое сообщение.'");
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Настройки.ТокенБотаТелеграм) Или Не ЗначениеЗаполнено(Настройки.ChatIDТелеграм) Тогда
		Возврат НСтр("ru = 'Сначала сохраните токен бота и Chat ID.'");
	КонецЕсли;

	ТекстСообщения = НСтр("ru = 'ИИкона: проверка уведомлений мониторинга ошибок.'");
	Попытка
		Отправлено = КИИ_МониторингОшибокTelegram.ОтправитьСообщениеВТелеграм(
			Настройки.ТокенБотаТелеграм, Настройки.ChatIDТелеграм, ТекстСообщения);
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'Сообщение не отправлено: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Отправлено Тогда
		Возврат НСтр("ru = 'Тестовое сообщение отправлено - проверьте чат.'");
	КонецЕсли;
	Возврат НСтр("ru = 'Telegram не принял сообщение. Проверьте токен бота, Chat ID и что бот добавлен в чат.'");

КонецФункции

// Настройки, которые форма показывает как есть, без преобразования.
&НаСервереБезКонтекста
Функция ИменаПростыхНастроек()

	Возврат "ВключитьОтправкуВТелеграм, РазрешитьЗапросыКДанным, МаксимальноОшибокНаАнализ, "
		+ "РазмерПакетаАнализаИИ, РазмерСтраницыЖурнала, "
		+ "СрокХраненияДней, ChatIDТелеграм, ПорогОтправкиВТелеграм, ПериодПорогаМинуты, МаксимумОтправокВТелеграм, "
		+ "РежимДайджеста, ШаблонПромптаСистемный, ШаблонПромптаПользовательский";

КонецФункции

&НаКлиенте
Процедура ПослеПодтвержденияТестовогоСообщения(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПоказатьПредупреждение(, ПроверитьТелеграмНаСервере());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

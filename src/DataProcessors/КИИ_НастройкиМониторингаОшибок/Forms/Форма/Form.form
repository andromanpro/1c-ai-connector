  <items xsi:type="form:FormGroup">
    <name>ГруппаАнализ</name>
    <id>1</id>
    <items xsi:type="form:FormField">
      <name>МодельДляАнализа</name>
      <id>3</id>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>МодельДляАнализа</segments>
      </dataPath>
      <toolTip>
        <key>ru</key>
        <value>Модель для автоанализа, глубокого анализа и аудитора кода. Для глубокого анализа у нее должен стоять флажок «Поддерживает инструменты».</value>
      </toolTip>
      <toolTipRepresentation>Button</toolTipRepresentation>
      <extendedTooltip>
        <name>МодельДляАнализаРасширеннаяПодсказка</name>
        <id>5</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>МодельДляАнализаКонтекстноеМеню</name>
        <id>4</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <type>InputField</type>
      <editMode>Enter</editMode>
      <showInHeader>true</showInHeader>
      <headerHorizontalAlign>Left</headerHorizontalAlign>
      <showInFooter>true</showInFooter>
      <extInfo xsi:type="form:InputFieldExtInfo">
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <wrap>true</wrap>
        <chooseType>true</chooseType>
        <typeDomainEnabled>true</typeDomainEnabled>
        <textEdit>true</textEdit>
      </extInfo>
    </items>
    <items xsi:type="form:FormField">
      <name>РазрешитьЗапросыКДанным</name>
      <id>6</id>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>РазрешитьЗапросыКДанным</segments>
      </dataPath>
      <toolTip>
        <key>ru</key>
        <value>Глубокий анализ сможет читать данные базы запросами - только чтение, с правами пользователя, который запустил анализ. Выключено - модель видит только метаданные.</value>
      </toolTip>
      <toolTipRepresentation>Button</toolTipRepresentation>
      <extendedTooltip>
        <name>РазрешитьЗапросыКДаннымРасширеннаяПодсказка</name>

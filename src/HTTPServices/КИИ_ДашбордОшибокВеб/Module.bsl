// Веб-доступ к дашборду ошибок: GET /iikona-dashboard/page (страница), /echarts (ECharts) и /script (скрипт).
// Шаблон страницы не «/»: голый корень ломает маршрутизацию всего сервиса (500 на любом пути).
// Вход проверяет публикация базы (пользователь 1С), право просмотра проверяет общий модуль
// КИИ_МониторингОшибокДашборд. Публикацию открывать наружу только по HTTPS.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

// Обработчик GET /iikona-dashboard/page - страница дашборда.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос к HTTP-сервису.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - страница или ответ об ошибке.
//
Функция ПолучитьСтраницу(Запрос)

	Возврат ОтветСервиса(Запрос, "page");

КонецФункции

// Обработчик GET /iikona-dashboard/echarts - библиотека графиков.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос к HTTP-сервису.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - файл библиотеки или ответ об ошибке.
//
Функция ПолучитьБиблиотеку(Запрос)

	Возврат ОтветСервиса(Запрос, "library");

КонецФункции

// Обработчик GET /iikona-dashboard/script - скрипт дашборда.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос к HTTP-сервису.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - файл скрипта или ответ об ошибке.
//
Функция ПолучитьСкрипт(Запрос)

	Возврат ОтветСервиса(Запрос, "script");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтветСервиса(Знач Запрос, Знач Ресурс)

	Попытка
		Результат = КИИ_МониторингОшибокДашборд.ОтветВеб(Ресурс, Запрос.БазовыйURL, Запрос.ПараметрыЗапроса,
			КИИ_МониторингОшибокДашборд.ПросмотрРазрешен());
	Исключение
		// Сбой построения - настоящая ошибка дашборда: уровень Ошибка, мониторинг ее соберет.
		ЗаписьЖурналаРегистрации(НСтр("ru = 'КИИ.ДашбордОшибок.Веб'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат = Новый Структура("КодСостояния, Заголовки, Тело", 500, Новый Соответствие,
			НСтр("ru = 'Не удалось построить дашборд ошибок.
				|Подробности - в журнале регистрации, событие КИИ.ДашбордОшибок.Веб.'"));
		Результат.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Результат.Заголовки.Вставить("Cache-Control", "no-store");
	КонецПопытки;

	Ответ = Новый HTTPСервисОтвет(Результат.КодСостояния);
	Для Каждого Заголовок Из Результат.Заголовки Цикл
		Ответ.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;

	Если ТипЗнч(Результат.Тело) = Тип("ДвоичныеДанные") Тогда
		Ответ.УстановитьТелоИзДвоичныхДанных(Результат.Тело);
	Иначе
		Ответ.УстановитьТелоИзСтроки(Результат.Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Обработчик GET /iikona-mcp/health - health-check без аутентификации.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция GET(Запрос)
	
	Попытка
		
		ТелоОтвета = Новый Структура;
		ТелоОтвета.Вставить("ok", Истина);
		ТелоОтвета.Вставить("service", "iikona-runtime-mcp");
		ТелоОтвета.Вставить("version", "0.1.0");
		
		Возврат СформироватьHTTPОтвет(200, ОбщегоНазначения.ЗначениеВJSON(ТелоОтвета));
		
	Исключение
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДанныеОшибки = КИИ_СерверMCPДиспетчер.СформироватьДанныеОшибкиСКорреляцией(
			ТекстОшибки, "КИИ.СерверMCP.HTTPService");
		ТелоОшибки = Новый Структура;
		ТелоОшибки.Вставить("ok", Ложь);
		ТелоОшибки.Вставить("service", "iikona-runtime-mcp");
		ТелоОшибки.Вставить("version", "0.1.0");
		ТелоОшибки.Вставить("correlation_id", ДанныеОшибки.correlation_id);
		Возврат СформироватьHTTPОтвет(500, ОбщегоНазначения.ЗначениеВJSON(ТелоОшибки));
		
	КонецПопытки;
	
КонецФункции

// Обработчик POST /iikona-mcp/rpc - MCP JSON-RPC с HTTP Basic auth.
// Делегирует обработку payload на КИИ_СерверMCPДиспетчер.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция POST(Запрос)
	
	ТелоЗапроса = "";
	
	ЗаголовокAuth = КИИ_СерверMCPAuth.ПолучитьЗаголовокЗапроса(Запрос.Заголовки, "Authorization");
	
	РезультатAuth = КИИ_СерверMCPAuth.ПроверитьBasicAuth(ЗаголовокAuth);
	// Вызывающий для АУДИТА - заявленный идентификатор (username/XFF), нужен для форензики.
	Вызывающий = КИИ_СерверMCPАудит.ИзвлечьВызывающего(Запрос, РезультатAuth.Пользователь);
	// Ключ ЛИМИТЕРА - НЕспуфабельный (D8): аутентифицированный юзер → свой бакет,
	// неаутентифицированный → единый глобальный. Заявленный username / сырой XFF как ключ
	// НЕЛЬЗЯ - атакующий их ротирует, получает свежий бакет и обходит лимит перебора пароля.
	КлючЛимита = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(РезультатAuth);

	// Rate-limit ДО проверки auth - иначе перебор пароля не троттлится (D3).
	// Атомарные check+increment: слот резервируется ДО dispatch, гонки check→increment нет.
	ПроверкаЛимита = КИИ_СерверMCPОграничения.ПроверитьИЗафиксироватьЛимит(КлючЛимита);
	Если Не ПроверкаЛимита.Разрешено Тогда
		КИИ_СерверMCPАудит.ЗаписатьВызов(Вызывающий, "", "", "rate_limited", "");
		Возврат СформироватьОтвет429(ПроверкаЛимита.ПовторитьЧерез);
	КонецЕсли;

	Если Не РезультатAuth.Авторизован Тогда
		КИИ_СерверMCPАудит.ЗаписатьВызов(Вызывающий, "", "", "auth_failed", "");
		Возврат СформироватьОтвет401(РезультатAuth.Причина);
	КонецЕсли;
	
	// Тело читается ИЗОЛИРОВАННО; сбой чтения → пустое тело → диспетчер вернет
	// -32700. Адаптер БОЛЬШЕ НЕ парсит JSON-RPC сам (ADR-0024, дефекты D1/D4/D7).
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		ТелоЗапроса = "";
	КонецПопытки;
	
	Попытка
		
		РезультатЯдра = КИИ_СерверMCPДиспетчер.ОбработатьЗапросMCPСАудитом(ТелоЗапроса);
		ОтветMCP = РезультатЯдра.Ответ;
		АудитМета = РезультатЯдра.АудитМета;

		КИИ_СерверMCPАудит.ЗаписатьВызов(
			Вызывающий,
			АудитМета.Метод,
			АудитМета.ПараметрыJSON,
			АудитМета.КодРезультата,
			АудитМета.Идентификатор);
		Возврат СформироватьHTTPОтвет(200, ОбщегоНазначения.ЗначениеВJSON(ОтветMCP));
		
	Исключение
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДанныеОшибки = КИИ_СерверMCPДиспетчер.СформироватьДанныеОшибкиСКорреляцией(
			ТекстОшибки, "КИИ.СерверMCP.HTTPService");
		КИИ_СерверMCPАудит.ЗаписатьВызов(Вызывающий, "", "", "error", "");
		ОтветОшибки = СформироватьОшибкуJSONRPC(
			Неопределено,
			-32603,
			НСтр("ru = 'Internal error'"),
			ДанныеОшибки);
		Возврат СформироватьHTTPОтвет(200, ОбщегоНазначения.ЗначениеВJSON(ОтветОшибки));
		
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьОтвет401(Знач Причина)
	
	Ответ = Новый HTTPСервисОтвет(401);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("WWW-Authenticate", "Basic realm=""iikona-mcp""");
	
	Ошибка = Новый Структура;
	Ошибка.Вставить("code", -32001);
	Ошибка.Вставить("message", НСтр("ru = 'Unauthorized'"));
	Ошибка.Вставить("data", Причина);
	
	Тело = Новый Структура;
	Тело.Вставить("jsonrpc", "2.0");
	Тело.Вставить("id", Неопределено);
	Тело.Вставить("error", Ошибка);
	
	Ответ.УстановитьТелоИзСтроки(ОбщегоНазначения.ЗначениеВJSON(Тело), КодировкаТекста.UTF8);
	Возврат Ответ;
	
КонецФункции

Функция СформироватьОтвет429(Знач ПовторитьЧерез)
	
	Ответ = Новый HTTPСервисОтвет(429);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Retry-After", Формат(Макс(1, ПовторитьЧерез), "ЧГ=0"));
	
	Ошибка = Новый Структура;
	Ошибка.Вставить("code", -32004);
	Ошибка.Вставить("message", НСтр("ru = 'Rate limit exceeded'"));
	Ошибка.Вставить("data", Новый Структура("retry_after", ПовторитьЧерез));
	
	Тело = Новый Структура;
	Тело.Вставить("jsonrpc", "2.0");
	Тело.Вставить("id", Неопределено);
	Тело.Вставить("error", Ошибка);
	
	Ответ.УстановитьТелоИзСтроки(ОбщегоНазначения.ЗначениеВJSON(Тело), КодировкаТекста.UTF8);
	Возврат Ответ;
	
КонецФункции

Функция СформироватьHTTPОтвет(Знач КодСостояния, Знач ТелоJSON)
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);
	Возврат Ответ;
	
КонецФункции

Функция СформироватьОшибкуJSONRPC(Знач Идентификатор, Знач Код, Знач Сообщение, Знач ДополнительныеДанные)
	
	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	
	Если ДополнительныеДанные <> Неопределено Тогда
		Ошибка.Вставить("data", ДополнительныеДанные);
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("error", Ошибка);
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

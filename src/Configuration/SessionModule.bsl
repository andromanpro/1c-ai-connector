#Область ОбработчикиСобытий

// Заполняет только идентичность текущего пользователя, по запросу платформы.
&После("УстановкаПараметровСеанса")
Процедура КИИ_УстановкаПользователяЖурналаИИ(ИменаПараметровСеанса)
	Если ИменаПараметровСеанса = Неопределено
		Или ИменаПараметровСеанса.Найти("КИИ_ПользовательЖурналаИИ") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	ИдентификаторПользователя = "00000000-0000-0000-0000-000000000000";
	Если ПользовательИБ <> Неопределено Тогда
		ИдентификаторПользователя = Строка(ПользовательИБ.УникальныйИдентификатор);
	КонецЕсли;
	ПараметрыСеанса.КИИ_ПользовательЖурналаИИ = ИдентификаторПользователя;
КонецПроцедуры

#КонецОбласти
